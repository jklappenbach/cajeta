package tour;

import cajeta.collection.ltm.LtmBPlusTree;
import cajeta.wire.Encoder;

// Larger-than-memory B+ tree. Same ordered-map surface as the
// in-memory BPlusTree, but every node lives on disk and is paged
// through a fixed-size buffer pool (an Encoder<K>/Encoder<V> handles
// the byte layout). Here the pool holds only 8 frames while the tree
// spans dozens of pages, so most accesses serialize / deserialize
// against the file — the data set genuinely exceeds resident memory.
//
// Construction:
//   new LtmBPlusTree(path, keyEnc, valEnc, order, poolCapacity)
//
// `flush()` writes dirty pages + header; `close()` flushes and
// releases the fd. Reopening the same path recovers the tree from
// disk — demonstrated by the second tree below reading back what the
// first wrote.
public class LtmBPlusTreeDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- LtmBPlusTree (disk-backed) --");

        String path = "/tmp/cajeta_tour_ltm_bplus.idx";

        Encoder<int32> ke = heap Int32Encoder();
        Encoder<int32> ve = heap Int32Encoder();
        LtmBPlusTree<int32, int32> t = heap LtmBPlusTree<int32, int32>(path, ke, ve, 4, 8);
        int32 i = 0;
        while (i < 200) {
            t.put(i, i * 3);
            i = i + 1;
        }
        t.flush();
        System.stdout.println("  wrote 200 entries; count = " + (int32) t.count());
        System.stdout.println("  get(150) = " + t.get(150));
        t.close();

        // Reopen from a cold pool — every lookup pages in from disk.
        Encoder<int32> ke2 = heap Int32Encoder();
        Encoder<int32> ve2 = heap Int32Encoder();
        LtmBPlusTree<int32, int32> t2 = heap LtmBPlusTree<int32, int32>(path, ke2, ve2, 4, 8);
        System.stdout.println("  reopened; count = " + (int32) t2.count());
        System.stdout.println("  get(75) after reopen = " + t2.get(75));
        System.stdout.println("  min = " + t2.min());
        t2.close();
    }
}
