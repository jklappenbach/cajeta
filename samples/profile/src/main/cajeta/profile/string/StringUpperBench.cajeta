package profile.string;

import profile.Benchmark;

// Case folding: toUpperCase over a ~360 KB ASCII text. Cross-check: the result
// has the same length as the input (ASCII case-fold is length-preserving).
public class StringUpperBench extends Benchmark {

    public String text;
    public int64 textLen;
    public int64 outLen;

    public String name() {
        return "string-uppercase";
    }

    public String area() {
        return "string";
    }

    public int32 warmupIters() {
        return 10;
    }

    public int32 measuredIters() {
        return 50;
    }

    public void setup() {
        this.text = "the quick brown fox jumps over the lazy dog ";
        int32 k = 0;
        while (k < 13) {
            this.text = this.text + this.text;
            k = k + 1;
        }
        this.textLen = (int64) this.text.count();
    }

    public int64 inputSize() {
        return this.textLen;
    }

    public void run(int32 iterations) {
        String out = this.text.toUpperCase();
        this.outLen = (int64) out.count();
    }

    public boolean checkResult() {
        return this.outLen == this.textLen;
    }
}
