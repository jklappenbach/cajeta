package profile.string;

import cajeta.lang.StringBuilder;

import profile.Benchmark;

// String build: append an 8-char piece N times via StringBuilder (amortized O(N)),
// matching the competitors' builder pattern (Rust String::push_str, Java
// StringBuilder, Go strings.Builder, C++ std::string +=). Materialize once with
// toString(). Cross-check: final length == 8*N AND the builder output is bit-for-bit
// identical to naive concatenation on a small input.
public class StringBuildBench extends Benchmark {

    public int32 n;
    public int64 finalLen;

    public String name() {
        return "string-build-concat";
    }

    public String area() {
        return "string";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        // 500 appends of the 8-byte piece = 4000 bytes built, matching the
        // competitors' BUILD_ITERS=500 (cpp/rust/go/java/python). Was 4000
        // appends (32000 bytes) — an unfair 8x more work than the others.
        this.n = 500;
    }

    public int64 inputSize() {
        // Bytes built (n * 8), the figure every competitor reports as
        // input_size (=4000). Reporting `n` would understate the workload and
        // mismatch the competitors' byte-count column.
        return (int64) (this.n * 8);
    }

    public void run(int32 iterations) {
        StringBuilder sb = heap StringBuilder();
        int32 i = 0;
        while (i < this.n) {
            sb.append("abcdefgh");
            i = i + 1;
        }
        String s = sb.toString();
        // size() is the O(1) byte length (== n*8). Use it, not count(), which
        // does an O(N) UTF-8 codepoint walk the competitor builders don't do
        // (Go Len() / Rust len() / Java length() are all O(1)) — measuring count()
        // here would charge Cajeta for a full UTF-8 decode the others skip.
        this.finalLen = s.size();
    }

    public boolean checkResult() {
        if (this.finalLen != (int64) (this.n * 8)) {
            return false;
        }
        // Bit-for-bit: StringBuilder output must equal naive concatenation.
        StringBuilder sb = heap StringBuilder();
        String naive = "";
        int32 i = 0;
        while (i < 50) {
            sb.append("abcdefgh");
            naive = naive + "abcdefgh";
            i = i + 1;
        }
        String built = sb.toString();
        return built.equals(naive);
    }
}
