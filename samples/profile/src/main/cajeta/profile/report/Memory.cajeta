package profile.report;

import cajeta.io.file.File;
import cajeta.io.file.FileReader;

// In-process memory measurement for the Cajeta harness rows. Peak resident set
// (high-water mark) is read from /proc/self/status' VmHWM line — always present
// on Linux and equal to ru_maxrss. The cross-language common-denominator peak
// (cgroup memory.peak / `/usr/bin/time -v`) is captured EXTERNALLY by the shell
// driver, because a Cajeta program has no subprocess API (see the env/process
// reference) — those land in the cgroup_peak_kb / working_set_kb columns from
// the driver, not here.
public class Memory {

    // Peak RSS in KiB from /proc/self/status (VmHWM). Returns -1 if unreadable.
    public static int64 peakRssKb() {
        return Memory.parseIntAfterFile("/proc/self/status", "VmHWM:");
    }

    // Current RSS in KiB from /proc/self/status (VmRSS). The measurement loop
    // (Unit 3) samples this as the empty-runtime baseline and reports
    // working_set_kb = (peak during workload) - (this baseline), the in-process
    // analogue of the overhead-subtraction the driver does for managed runtimes.
    public static int64 currentRssKb() {
        return Memory.parseIntAfterFile("/proc/self/status", "VmRSS:");
    }

    // Read `path` as text and return the first run of decimal digits after the
    // first occurrence of `key`. -1 if the file or key is absent / no digits.
    public static int64 parseIntAfterFile(String path, String key) {
        FileReader r #= File.openRead(path);
        if (r == null) {
            return (int64) -1;
        }
        String text #= r.readString(16384);
        r.close();
        if (text == null) {
            return (int64) -1;
        }
        return Memory.parseIntAfter(text, key);
    }

    public static int64 parseIntAfter(String text, String key) {
        int64 at = text.indexOf(key);
        if (at < 0) {
            return (int64) -1;
        }
        int32 n = (int32) text.count();
        int32 i = (int32) at + (int32) key.count();
        // Skip to the first digit.
        while (i < n) {
            int8 c = text.byteAt(i);
            if (c >= 48 && c <= 57) {
                break;
            }
            i = i + 1;
        }
        int64 val = 0;
        boolean any = false;
        while (i < n) {
            int8 c = text.byteAt(i);
            if (c < 48 || c > 57) {
                break;
            }
            val = val * 10 + (int64) (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) {
            return (int64) -1;
        }
        return val;
    }
}
