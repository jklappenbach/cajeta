package profile.collection;

import cajeta.collection.HashSet;

import profile.Benchmark;

// HashSet dedup: insert N values where each distinct value appears twice
// (i % (N/2)), so the set must absorb the duplicates. Cross-check: the final
// distinct count == N/2.
public class HashSetDedupBench extends Benchmark {

    public int32 n;
    public int64 distinct;

    public String name() {
        return "hashset-dedup";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = 100000;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public void run(int32 iterations) {
        HashSet<int32> s = heap HashSet<int32>(64);
        int32 half = this.n / 2;
        int32 i = 0;
        while (i < this.n) {
            s.add(i % half);
            i = i + 1;
        }
        this.distinct = s.count();
    }

    public boolean checkResult() {
        return this.distinct == (int64) (this.n / 2);
    }
}
