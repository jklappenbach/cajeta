package profile.sort;

import cajeta.collection.Sort;
import cajeta.time.Clock;

import profile.Benchmark;

// Unstable sort of N random float64. Each trial copies the source and sorts it
// (copy subtracted). Cross-check: non-decreasing.
public class SortF64Bench extends Benchmark {

    public int32 n;
    public float64[] src;
    public int64 baseNs;
    public int32 sortedOk;
    // Verified outside the timed region (see SortInt64Bench.out) so the reported
    // number is sort-only, matching the Rust runner.
    public float64[] out;

    public String name() {
        return "sort-f64";
    }

    public String area() {
        return "sort";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = 50000;
        this.src = heap float64[this.n];
        int64 x = 88172645;
        int32 i = 0;
        while (i < this.n) {
            x = (x * 1103515245 + 12345) & 0x7FFFFFFF;
            this.src[i] = (float64) x;
            i = i + 1;
        }
        int64 r0 = Clock.nanoTime();
        int32 k = 0;
        while (k < 3) {
            float64[] w = heap float64[this.n];
            int32 j = 0;
            while (j < this.n) {
                w[j] = this.src[j];
                j = j + 1;
            }
            k = k + 1;
        }
        this.baseNs = (Clock.nanoTime() - r0) / 3;
    }

    public int64 baselineNanos() {
        return this.baseNs;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public void run(int32 iterations) {
        float64[] w = heap float64[this.n];
        int32 i = 0;
        while (i < this.n) {
            w[i] = this.src[i];
            i = i + 1;
        }
        Sort.sort<float64>(w, this.n);
        this.out = w;
    }

    public boolean checkResult() {
        if (this.out == null) {
            return false;
        }
        boolean ok = true;
        int32 j = 1;
        while (j < this.n) {
            if (this.out[j] < this.out[j - 1]) {
                ok = false;
            }
            j = j + 1;
        }
        return ok;
    }
}
