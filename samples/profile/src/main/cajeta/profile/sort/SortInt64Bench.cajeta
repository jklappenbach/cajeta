package profile.sort;

import cajeta.collection.ArrayList;
import cajeta.collection.Sort;
import cajeta.time.Clock;

import profile.Benchmark;

// Unstable sort of N int64 across input PATTERNS (the sort-research-rs matrix's
// pattern dimension, which also stands in for branch-predictor predictability):
// random / ascending / descending / dups. Each trial copies the unsorted source
// into a fresh array and sorts it; the copy is the subtracted baseline.
// Cross-check: the sorted array is non-decreasing.
public class SortInt64Bench extends Benchmark {

    public int32 n;
    public int64[] src;
    public int64 baseNs;
    public int32 sortedOk;
    // Last sorted output, retained so the non-decreasing cross-check runs in
    // checkResult() — OUTSIDE the timed region — matching the Rust runner, which
    // verifies after `Instant::elapsed()`. Keeping the verify inside runVariant
    // would charge cajeta a 50K-element scan that Rust's number never pays.
    public int64[] out;

    public String name() {
        return "sort-int64";
    }

    public String area() {
        return "sort";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("random");
        v.add("ascending");
        v.add("descending");
        v.add("dups");
        return v;
    }

    // Cajeta's Sort.sort uses a middle-element pivot and an explicit range stack
    // that recurses the smaller partition and loops the larger, bounding the
    // stack to O(log n) (~17 deep at n=50000) — so all four patterns sort
    // correctly without overflow. All variants are measured.
    public boolean supportsVariant(String variant) {
        return true;
    }

    public void prepare(String variant) {
        this.n = 50000;
        this.src = heap int64[this.n];
        int32 i = 0;
        if (variant.equals("ascending")) {
            while (i < this.n) {
                this.src[i] = (int64) i;
                i = i + 1;
            }
        } else if (variant.equals("descending")) {
            while (i < this.n) {
                this.src[i] = (int64) (this.n - 1 - i);
                i = i + 1;
            }
        } else if (variant.equals("dups")) {
            while (i < this.n) {
                // i % 16 — 16 unique values, matching every competitor runner's
                // dups generator (rust/cpp/go/java all use i % 16) so the
                // high-duplication case is sorted on identical data.
                this.src[i] = (int64) (i % 16);
                i = i + 1;
            }
        } else {
            int64 x = 88172645;
            while (i < this.n) {
                x = (x * 1103515245 + 12345) & 0x7FFFFFFF;
                this.src[i] = x;
                i = i + 1;
            }
        }

        // Baseline: array copy (subtracted to isolate the sort).
        int64 r0 = Clock.nanoTime();
        int32 k = 0;
        while (k < 3) {
            int64[] w = heap int64[this.n];
            int32 j = 0;
            while (j < this.n) {
                w[j] = this.src[j];
                j = j + 1;
            }
            k = k + 1;
        }
        this.baseNs = (Clock.nanoTime() - r0) / 3;
    }

    public int64 baselineNanos() {
        return this.baseNs;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public void runVariant(String variant, int32 iterations) {
        int64[] w = heap int64[this.n];
        int32 i = 0;
        while (i < this.n) {
            w[i] = this.src[i];
            i = i + 1;
        }
        // No explicit type arg: resolves to the concrete Sort.sort(int64[],
        // int32) overload — the AVX-512 vqsort (vpcompressq) fast path.
        Sort.sort(w, this.n);
        // Retain for verification outside the timed region (see `out`).
        this.out = w;
    }

    public boolean checkResult() {
        if (this.out == null) {
            return false;
        }
        boolean ok = true;
        int32 j = 1;
        while (j < this.n) {
            if (this.out[j] < this.out[j - 1]) {
                ok = false;
            }
            j = j + 1;
        }
        return ok;
    }
}
