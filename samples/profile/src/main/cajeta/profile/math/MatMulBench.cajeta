package profile.math;

import profile.Benchmark;

// Dense N×N matrix multiply C = A·B (scalar, flat row-major float64 arrays). A is
// the identity, so C == B — a cheap, exact cross-check (checksum of C == checksum
// of B) while still doing the full N^3 multiply-add work.
public class MatMulBench extends Benchmark {

    public float64[] a;
    public float64[] b;
    public float64[] c;
    public int32 nDim;
    public float64 bSum;
    public float64 cSum;

    public String name() {
        return "matmul";
    }

    public String area() {
        return "math";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 20;
    }

    public void setup() {
        this.nDim = 200;
        int32 sz = this.nDim * this.nDim;
        this.a = heap float64[sz];
        this.b = heap float64[sz];
        this.c = heap float64[sz];
        int32 i = 0;
        while (i < this.nDim) {
            int32 j = 0;
            while (j < this.nDim) {
                int32 idx = i * this.nDim + j;
                if (i == j) {
                    this.a[idx] = 1.0;
                } else {
                    this.a[idx] = 0.0;
                }
                this.b[idx] = (float64) (idx % 100);
                j = j + 1;
            }
            i = i + 1;
        }
        float64 s = 0.0;
        int32 k = 0;
        while (k < sz) {
            s = s + this.b[k];
            k = k + 1;
        }
        this.bSum = s;
    }

    public int64 inputSize() {
        return (int64) (this.nDim * this.nDim);
    }

    public void run(int32 iterations) {
        int32 nd = this.nDim;
        int32 sz = nd * nd;
        // ikj loop order (was ijk). The inner j loop now updates C[i, :] and reads
        // B[k, :] CONTIGUOUSLY (stride 1) -- a row SAXPY -- instead of striding B
        // column-wise (stride n) on every multiply. Cache-friendly + autovectorizable.
        // Bit-exact: for each (i,j) the k-contributions still accumulate in k order.
        // C is accumulated into, so zero it first.
        int32 z = 0;
        while (z < sz) {
            this.c[z] = 0.0;
            z = z + 1;
        }
        int32 i = 0;
        while (i < nd) {
            int32 iBase = i * nd;
            int32 k = 0;
            while (k < nd) {
                float64 aik = this.a[iBase + k];
                int32 kBase = k * nd;
                int32 j = 0;
                while (j < nd) {
                    this.c[iBase + j] = this.c[iBase + j] + aik * this.b[kBase + j];
                    j = j + 1;
                }
                k = k + 1;
            }
            i = i + 1;
        }
        float64 s = 0.0;
        int32 m = 0;
        while (m < sz) {
            s = s + this.c[m];
            m = m + 1;
        }
        this.cSum = s;
    }

    public boolean checkResult() {
        return this.cSum == this.bSum;
    }
}
