package profile.codec;

import cajeta.collection.ArrayList;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.time.Clock;

import profile.Benchmark;

// JSON DOM-build throughput: Json.parse(bytes,len) materializes the full
// JsonValue tree (Tier-3). Each trial reads a fresh buffer and parses; the
// read-only baseline (measured in prepare) is subtracted to isolate parsing.
// Cross-check: the corpus roots are all JSON objects, so kind() == OBJECT.
//
// Builds the whole tree, so it stresses allocation — measured --release
// (--live-set=bounded) which degrades gracefully past the tracking cap; the
// debug build would stack-overflow on the large buffers.
public class JsonDomBench extends Benchmark {

    public String path;
    public int64 fileBytes;
    public int64 baseNs;
    public int32 lastKind;

    public String name() {
        return "json-dom";
    }

    public String area() {
        return "codec";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public boolean available() {
        return System.env.get("PROFILE_DATA_DIR") != null;
    }

    // v1 DOM throws "non-integer number" on float-bearing inputs; only the
    // integer-only file (citm_catalog) is DOM-parseable today. twitter/canada
    // are recorded as skips with the reason — surfacing the gap in the data.
    public boolean supportsVariant(String variant) {
        return variant.equals("citm_catalog");
    }

    public String skipReason() {
        return "v1 JSON DOM doesn't parse floats (integer-only inputs only)";
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("twitter");
        v.add("citm_catalog");
        v.add("canada");
        return v;
    }

    public void prepare(String variant) {
        String dir = System.env.get("PROFILE_DATA_DIR");
        if (dir == null) {
            dir = "datasets/cache";
        }
        this.path = dir + "/" + variant + ".json";

        int8[] probe = File.readAllBytes(this.path);
        this.fileBytes = (int64) probe.count();

        int64 r0 = Clock.nanoTime();
        int32 k = 0;
        while (k < 5) {
            int8[] b2 = File.readAllBytes(this.path);
            k = k + 1;
        }
        this.baseNs = (Clock.nanoTime() - r0) / 5;
    }

    public int64 baselineNanos() {
        return this.baseNs;
    }

    public int64 inputSize() {
        return this.fileBytes;
    }

    public void runVariant(String variant, int32 iterations) {
        int8[] bytes = File.readAllBytes(this.path);
        int64 len = (int64) bytes.count();
        JsonValue v = Json.parse(bytes, len);
        this.lastKind = v.kind();
    }

    public boolean checkResult() {
        return this.lastKind == JsonValue.OBJECT;
    }
}
