package profile.codec;

import cajeta.collection.ArrayList;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.time.Clock;

import profile.Benchmark;

// JSON serialize throughput: parse the corpus to a DOM, then Json.toBytes back
// to a byte buffer. Each trial reads + parses + serializes; the read+parse
// baseline (measured in prepare) is subtracted to isolate serialization.
// Cross-check: the serialized output is non-empty.
public class JsonSerializeBench extends Benchmark {

    public String path;
    public int64 fileBytes;
    public int64 baseNs;
    public int64 outLen;

    public String name() {
        return "json-serialize";
    }

    public String area() {
        return "codec";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public boolean available() {
        return System.env.get("PROFILE_DATA_DIR") != null;
    }

    // Floats now DOM-parse (Unit 2): all three corpus files serialize.

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("twitter");
        v.add("citm_catalog");
        v.add("canada");
        return v;
    }

    public void prepare(String variant) {
        String dir = System.env.get("PROFILE_DATA_DIR");
        if (dir == null) {
            dir = "datasets/cache";
        }
        this.path = dir + "/" + variant + ".json";

        int8[] probe = File.readAllBytes(this.path);
        this.fileBytes = (int64) probe.count();

        // Baseline = read + parse (subtracted to isolate serialize).
        int64 r0 = Clock.nanoTime();
        int32 k = 0;
        while (k < 3) {
            int8[] b2 = File.readAllBytes(this.path);
            JsonValue v2 = Json.parse(b2, (int64) b2.count());
            k = k + 1;
        }
        this.baseNs = (Clock.nanoTime() - r0) / 3;
    }

    public int64 baselineNanos() {
        return this.baseNs;
    }

    public int64 inputSize() {
        return this.fileBytes;
    }

    public void runVariant(String variant, int32 iterations) {
        int8[] bytes = File.readAllBytes(this.path);
        int64 len = (int64) bytes.count();
        JsonValue v = Json.parse(bytes, len);
        int8[] out = Json.toBytes(v);
        this.outLen = (int64) out.count();
    }

    public boolean checkResult() {
        return this.outLen > 0;
    }
}
