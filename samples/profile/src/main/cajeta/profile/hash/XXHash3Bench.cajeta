package profile.hash;

import cajeta.hash.XXHash3;

import profile.Benchmark;

// XXHash3 bulk throughput over a 1 MiB buffer (SMHasher's bulk-throughput metric).
// Cross-check: the digest of a non-trivial 1 MiB buffer is non-zero.
public class XXHash3Bench extends Benchmark {

    public int8[] data;
    public int64 len;
    public int64 lastHash;

    public String name() {
        return "xxhash3";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 20;
    }

    public int32 measuredIters() {
        return 100;
    }

    public void setup() {
        this.len = 1048576;
        this.data = heap int8[(int32) this.len];
        int32 i = 0;
        int32 n = (int32) this.len;
        while (i < n) {
            this.data[i] = (int8) ((i * 31 + 7) & 0xFF);
            i = i + 1;
        }
    }

    public int64 inputSize() {
        return this.len;
    }

    public void run(int32 iterations) {
        // Measure the pure-Cajeta SIMD long path directly (hash() currently
        // routes long inputs to it in production, but the conditional-call branch
        // is dropped by the optimizer when hashLong isn't inlined — tracked
        // separately; here we exercise the SIMD path under test).
        this.lastHash = XXHash3.hashLong(this.data, this.len, 0xABCDEF01L);
    }

    public boolean checkResult() {
        // Prove the timed SIMD result is the CANONICAL XXH3: re-hash the exact
        // timed input (1 MiB, same seed) with both the pure-Cajeta SIMD long path
        // and the @Native C xxHash 0.8.3 reference, and require bit-for-bit
        // agreement. Done outside the timed loop, so it doesn't contaminate the
        // measurement; this also keeps hashLong reachable for the tree-shaker.
        int64 simd = XXHash3.hashLong(this.data, this.len, 0xABCDEF01L);
        int64 ref = XXHash3.hashSeeded(this.data, this.len, 0xABCDEF01L);
        return this.lastHash != 0 && simd == ref && this.lastHash == ref;
    }
}
