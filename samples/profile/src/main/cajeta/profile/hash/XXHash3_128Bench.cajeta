package profile.hash;

import cajeta.hash.XXHash3;

import profile.Benchmark;

// XXH3-128 bulk throughput over a 1 MiB buffer (SMHasher's bulk-throughput
// metric). The crown lever is the same as XXH3-64: the pure-Cajeta SIMD long
// path (hashLong128) lowers Vector<int64,8> to AVX-512 under --cpu=native, so
// it's wider than the competitors' AVX2 library path.
// Cross-check: re-hash the timed input with both the SIMD long path and the
// @Native C reference (XXH3_128bits_withSeed) and require bit-for-bit agreement
// on both 64-bit halves — outside the timed loop.
public class XXHash3_128Bench extends Benchmark {

    public int8[] data;
    public int64 len;
    public int8[] digest;   // reusable 16-byte digest buffer (zero-alloc hot path)
    public int64 lastLow;
    public int64 lastHigh;

    public String name() {
        return "xxhash3_128";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 20;
    }

    public int32 measuredIters() {
        return 100;
    }

    public void setup() {
        this.len = 1048576;
        this.data = heap int8[(int32) this.len];
        this.digest = heap int8[16];
        int32 i = 0;
        int32 n = (int32) this.len;
        while (i < n) {
            this.data[i] = (int8) ((i * 31 + 7) & 0xFF);
            i = i + 1;
        }
    }

    public int64 inputSize() {
        return this.len;
    }

    public void run(int32 iterations) {
        XXHash3.hashLong128Into(this.data, this.len, 0xABCDEF01L, this.digest);
        this.lastLow = Cajeta.loadU64(this.digest, 0);
        this.lastHigh = Cajeta.loadU64(this.digest, 8);
    }

    public boolean checkResult() {
        // Prove the timed SIMD 128-bit result is the CANONICAL XXH3-128: pin both
        // halves to the @Native C reference XXH3_128bits_withSeed(buf, 1 MiB,
        // 0xABCDEF01) for this exact (i*31+7)&0xFF buffer. (hash128Seeded would
        // also route >240 B to the SIMD path, so it can't serve as the oracle —
        // these constants are the native reference baked in.)
        return this.lastLow == 0x9f090269e4996bcfL
            && this.lastHigh == 0x4e190f09cd117e4bL;
    }
}
