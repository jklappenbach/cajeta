package profile.hash;

import cajeta.hash.Blake3;
import cajeta.lang.String;

import profile.Benchmark;

// BLAKE3 bulk throughput over a 1 MiB buffer (SMHasher's bulk-throughput metric).
// The buffer uses the official BLAKE3 test pattern (buf[i] = i % 251) so the
// digest can be cross-checked bit-for-bit against the canonical 1 MiB vector.
public class Blake3Bench extends Benchmark {

    public int8[] data;
    public int64 len;
    public int8[] digest;   // reusable 32-byte digest buffer (zero-alloc hot path)

    public String name() {
        return "blake3";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 20;
    }

    public int32 measuredIters() {
        return 100;
    }

    public void setup() {
        this.len = 1048576;
        this.data = heap int8[(int32) this.len];
        this.digest = heap int8[32];
        int32 i = 0;
        int32 n = (int32) this.len;
        while (i < n) {
            this.data[i] = (int8) (i % 251);
            i = i + 1;
        }
    }

    public int64 inputSize() {
        return this.len;
    }

    public void run(int32 iterations) {
        Blake3.hashInto(this.data, this.len, this.digest);
    }

    public boolean checkResult() {
        // Pin to the official BLAKE3 vector for the 1 MiB i%251 buffer.
        String hex = Blake3.hashHex(this.data, this.len);
        return hex == "74cb441fd087764ca9c3694da742ebe30cbeb3060a17009ca81825c7a8d10343";
    }
}
