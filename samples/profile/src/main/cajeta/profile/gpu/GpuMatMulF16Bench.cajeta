package profile.gpu;

import cajeta.collection.ArrayList;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Workgroup;
import cajeta.xpu.Barrier;
import cajeta.xpu.Shared;
import cajeta.xpu.CooperativeMatrix;

import profile.Benchmark;

// Torch-recipe f16 WMMA GEMM (gpu-f16-torch-recipe) — implements torch's VERIFIED gfx1151
// kernel shape: MT 96x128, depthU 64, MIWT 3x4 = 12 accumulators/wave, 4 waves (128 threads).
// Wide 128-bit global loads on BOTH operands (GRVWA8/GRVWB8, vload<8>); B stored TRANSPOSED in
// LDS so its WMMA fragment reads wide (ds_read_b128). BOTH A and B LDS tiles are PADDED to an
// ODD half-stride (stride 66 = 64+2; 66/2=33 coprime with the 32 LDS banks) — THE lever:
// rocprof showed unpadded/even-pad gives 84% LDS bank conflicts (every lane same bank), padding
// both odd drops it to ~38% and lifts 11.9 -> 26.2 TFLOP/s @ n2048 (beats variant B's ~20). The
// next-panel staging is interleaved one slice per K-substep (load->WMMA->commit, ~4 vectors
// live). torch hits 38.2 with this shape + PGR2 + LRVW16; this build = wide-loads + transposed
// + bank-conflict-free reads. A = identity ⇒ C == B. n % 128 == 0 (N); M (96-tile) bounds-checked.
public class GpuMatMulF16Bench extends Benchmark {

    public float16[] a;
    public float16[] b;
    public float32[] c;
    public KernelBuffer<float16> ka;
    public KernelBuffer<float16> kb;
    public KernelBuffer<float32> kc;
    public KernelStream stream;
    public int32 nDim;
    public uint32 nU;
    public uint32 gridX;
    public uint32 gridM;
    public float64 bSum;
    public float64 cSum;

    @Kernel
    public static void gemmF16(KernelBuffer<float32> c, KernelBuffer<float16> a,
                               KernelBuffer<float16> b, uint32 n) {
        uint32 blockRow = Workgroup.y();
        uint32 blockCol = Workgroup.x();
        uint32 tid = KernelThread.x();
        uint32 wave = tid / 32;
        uint32 wm = wave / 2;
        uint32 wn = wave % 2;
        uint32 rb = blockRow * 96;
        uint32 cb = blockCol * 128;
        Shared<float16> sa = shared float16[2 * 6336];   // A [96(M)][64(K)] x2
        Shared<float16> sb = shared float16[2 * 8448];   // B [128(N)][66(Kpad)] x2 transposed
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a20; a20.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a21; a21.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a22; a22.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a23; a23.splat(0.0f);
        CooperativeMatrix<float16,16,16,0> wa0;
        CooperativeMatrix<float16,16,16,0> wa1;
        CooperativeMatrix<float16,16,16,0> wa2;
        CooperativeMatrix<float16,16,16,1> wb0;
        CooperativeMatrix<float16,16,16,1> wb1;
        CooperativeMatrix<float16,16,16,1> wb2;
        CooperativeMatrix<float16,16,16,1> wb3;
        uint32 ca = tid;
        while (ca < 768) {
            uint32 m = ca / 8; uint32 kk = (ca % 8) * 8;
            if (rb + m < n) {
                Vector<float16,8> va = a.vload<8>((rb + m) * n + kk);
                sa.vstore(m * 66 + kk, va);
            }
            ca = ca + 128;
        }
        uint32 cbk = tid;
        while (cbk < 1024) {
            uint32 k2 = cbk / 16; uint32 nb = (cbk % 16) * 8;
            Vector<float16,8> vb = b.vload<8>(k2 * n + cb + nb);
            sb[(nb + 0) * 66 + k2] = vb[0]; sb[(nb + 1) * 66 + k2] = vb[1];
            sb[(nb + 2) * 66 + k2] = vb[2]; sb[(nb + 3) * 66 + k2] = vb[3];
            sb[(nb + 4) * 66 + k2] = vb[4]; sb[(nb + 5) * 66 + k2] = vb[5];
            sb[(nb + 6) * 66 + k2] = vb[6]; sb[(nb + 7) * 66 + k2] = vb[7];
            cbk = cbk + 128;
        }
        Barrier.workgroup();
        uint32 npanels = n / 64;
        uint32 ph = 0;
        uint32 p = 0;
        while (p < npanels) {
            // PGR2-style interleave: stage one slice of the NEXT panel per K-substep (wide
            // load at top -> WMMA -> commit at bottom), so the wide global loads overlap the
            // matrix-core compute with only ~4 vectors live (no spill). 6 A + 8 B chunks/thread
            // spread over 4 substeps: A vec at ks (+ks+4 for ks<2); B vecs at ks and ks+4.
            boolean pf = p + 1 < npanels;
            uint32 ko = (p + 1) * 64;
            uint32 sbA = (1 - ph) * 6336;
            uint32 sbB = (1 - ph) * 8448;
            uint32 dbA = ph * 6336;
            uint32 dbB = ph * 8448;
            uint32 ao0 = dbA + (wm * 48 + 0) * 66;
            uint32 ao1 = dbA + (wm * 48 + 16) * 66;
            uint32 ao2 = dbA + (wm * 48 + 32) * 66;
            uint32 cn0 = (wn * 64 + 0) * 66; uint32 cn1 = (wn * 64 + 16) * 66;
            uint32 cn2 = (wn * 64 + 32) * 66; uint32 cn3 = (wn * 64 + 48) * 66;
            uint32 ks = 0;
            while (ks < 4) {
                uint32 ka = ks * 16;
                uint32 ea0 = tid + ks * 128; uint32 ma0 = ea0 / 8; uint32 ak0 = (ea0 % 8) * 8;
                uint32 ea1 = tid + (ks + 4) * 128; uint32 ma1 = ea1 / 8; uint32 ak1 = (ea1 % 8) * 8;
                uint32 fb0 = tid + ks * 128; uint32 bk0 = fb0 / 16; uint32 bn0 = (fb0 % 16) * 8;
                uint32 fb1 = tid + (ks + 4) * 128; uint32 bk1 = fb1 / 16; uint32 bn1 = (fb1 % 16) * 8;
                Vector<float16,8> pa0; Vector<float16,8> pa1;
                Vector<float16,8> pb0; Vector<float16,8> pb1;
                if (pf) {
                    if (rb + ma0 < n) { pa0 = a.vload<8>((rb + ma0) * n + ko + ak0); }
                    if (ks < 2) { if (rb + ma1 < n) { pa1 = a.vload<8>((rb + ma1) * n + ko + ak1); } }
                    pb0 = b.vload<8>((ko + bk0) * n + cb + bn0);
                    pb1 = b.vload<8>((ko + bk1) * n + cb + bn1);
                }
                wa0.load(sa, ao0 + ka, 0, 66);
                wa1.load(sa, ao1 + ka, 0, 66);
                wa2.load(sa, ao2 + ka, 0, 66);
                wb0.load(sb, dbB + cn0 + ka, 1, 66);
                wb1.load(sb, dbB + cn1 + ka, 1, 66);
                wb2.load(sb, dbB + cn2 + ka, 1, 66);
                wb3.load(sb, dbB + cn3 + ka, 1, 66);
                a00.mma(wa0, wb0); a01.mma(wa0, wb1); a02.mma(wa0, wb2); a03.mma(wa0, wb3);
                a10.mma(wa1, wb0); a11.mma(wa1, wb1); a12.mma(wa1, wb2); a13.mma(wa1, wb3);
                a20.mma(wa2, wb0); a21.mma(wa2, wb1); a22.mma(wa2, wb2); a23.mma(wa2, wb3);
                if (pf) {
                    if (rb + ma0 < n) { sa.vstore(sbA + ma0 * 66 + ak0, pa0); }
                    if (ks < 2) { if (rb + ma1 < n) { sa.vstore(sbA + ma1 * 66 + ak1, pa1); } }
                    sb[sbB + (bn0 + 0) * 66 + bk0] = pb0[0]; sb[sbB + (bn0 + 1) * 66 + bk0] = pb0[1];
                    sb[sbB + (bn0 + 2) * 66 + bk0] = pb0[2]; sb[sbB + (bn0 + 3) * 66 + bk0] = pb0[3];
                    sb[sbB + (bn0 + 4) * 66 + bk0] = pb0[4]; sb[sbB + (bn0 + 5) * 66 + bk0] = pb0[5];
                    sb[sbB + (bn0 + 6) * 66 + bk0] = pb0[6]; sb[sbB + (bn0 + 7) * 66 + bk0] = pb0[7];
                    sb[sbB + (bn1 + 0) * 66 + bk1] = pb1[0]; sb[sbB + (bn1 + 1) * 66 + bk1] = pb1[1];
                    sb[sbB + (bn1 + 2) * 66 + bk1] = pb1[2]; sb[sbB + (bn1 + 3) * 66 + bk1] = pb1[3];
                    sb[sbB + (bn1 + 4) * 66 + bk1] = pb1[4]; sb[sbB + (bn1 + 5) * 66 + bk1] = pb1[5];
                    sb[sbB + (bn1 + 6) * 66 + bk1] = pb1[6]; sb[sbB + (bn1 + 7) * 66 + bk1] = pb1[7];
                }
                ks = ks + 1;
            }
            Barrier.workgroup();
            ph = 1 - ph;
            p = p + 1;
        }
        uint32 r0 = rb + wm * 48;
        uint32 c0 = cb + wn * 64;
        if (r0 + 0 < n) {
            a00.store(c, (r0 + 0) * n + c0 + 0, 0, n); a01.store(c, (r0 + 0) * n + c0 + 16, 0, n);
            a02.store(c, (r0 + 0) * n + c0 + 32, 0, n); a03.store(c, (r0 + 0) * n + c0 + 48, 0, n);
        }
        if (r0 + 16 < n) {
            a10.store(c, (r0 + 16) * n + c0 + 0, 0, n); a11.store(c, (r0 + 16) * n + c0 + 16, 0, n);
            a12.store(c, (r0 + 16) * n + c0 + 32, 0, n); a13.store(c, (r0 + 16) * n + c0 + 48, 0, n);
        }
        if (r0 + 32 < n) {
            a20.store(c, (r0 + 32) * n + c0 + 0, 0, n); a21.store(c, (r0 + 32) * n + c0 + 16, 0, n);
            a22.store(c, (r0 + 32) * n + c0 + 32, 0, n); a23.store(c, (r0 + 32) * n + c0 + 48, 0, n);
        }
    }

    public String name() {
        return "matmul-f16";
    }

    public String area() {
        return "gpu";
    }

    public String backend() {
        String bk = System.env.get("CAJETA_XPU_BACKEND");
        if (bk == null) {
            return "cpu";
        }
        if (bk.equals("hip")) {
            return "hip";
        }
        if (bk.equals("vulkan")) {
            return "vulkan";
        }
        if (bk.equals("amdgpu")) {
            return "amdgpu";
        }
        if (bk.equals("cpu")) {
            return "cpu";
        }
        return "cpu";
    }

    public boolean available() {
        String bk = System.env.get("CAJETA_XPU_BACKEND");
        if (bk == null) {
            return true;
        }
        if (bk.equals("hip") || bk.equals("amdgpu") || bk.equals("vulkan")
                || bk.equals("cpu")) {
            return true;
        }
        return false;
    }

    public String skipReason() {
        return "xpu backend not available in this build (CAJETA_XPU_BACKEND)";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("n256");
        v.add("n512");
        v.add("n1024");
        v.add("n2048");
        return v;
    }

    private int32 sizeFor(String variant) {
        if (variant.equals("n256")) {
            return 256;
        }
        if (variant.equals("n512")) {
            return 512;
        }
        if (variant.equals("n1024")) {
            return 1024;
        }
        if (variant.equals("n2048")) {
            return 2048;
        }
        return 256;
    }

    public void setup() {
        this.stream = KernelStream.current();
    }

    // A = identity, B[idx]=idx%100 (exact in f16) ⇒ C == B exactly. f32 accumulate
    // holds the f16 product without loss for these inputs — exact cross-check.
    public void prepare(String variant) {
        this.nDim = this.sizeFor(variant);
        int32 sz = this.nDim * this.nDim;
        this.a = heap float16[sz];
        this.b = heap float16[sz];
        this.c = heap float32[sz];
        int32 i = 0;
        while (i < this.nDim) {
            int32 j = 0;
            while (j < this.nDim) {
                int32 idx = i * this.nDim + j;
                if (i == j) {
                    this.a[idx] = (float16) 1.0;
                } else {
                    this.a[idx] = (float16) 0.0;
                }
                this.b[idx] = (float16) (idx % 100);
                this.c[idx] = 0.0f;
                j = j + 1;
            }
            i = i + 1;
        }
        float64 s = 0.0;
        int32 k = 0;
        while (k < sz) {
            s = s + (float64) this.b[k];
            k = k + 1;
        }
        this.bSum = s;

        this.ka = heap KernelBuffer<float16>(sz);
        this.kb = heap KernelBuffer<float16>(sz);
        this.kc = heap KernelBuffer<float32>(sz);
        this.ka.upload(this.a);
        this.kb.upload(this.b);
        this.kc.upload(this.c);

        this.nU = (uint32) this.nDim;
        this.gridX = this.nU / 128;          // N blocks: one workgroup per 128 cols
        this.gridM = (this.nU + 95) / 96;    // M blocks: 96-row tiles (ceil; bounds-checked)
    }

    public int64 inputSize() {
        return (int64) (this.nDim * this.nDim);   // N² → report derives 2·N³ GFLOP
    }

    public void run(int32 iterations) {
        gemmF16.launch(this.stream, grid: [this.gridX, this.gridM], block: [128])(
            this.kc, this.ka, this.kb, this.nU);
        this.stream.sync();
    }

    public boolean checkResult() {
        this.kc.download(this.c);
        int32 sz = this.nDim * this.nDim;
        float64 s = 0.0;
        int32 m = 0;
        while (m < sz) {
            s = s + (float64) this.c[m];
            m = m + 1;
        }
        this.cSum = s;
        return this.cSum == this.bSum;
    }
}
