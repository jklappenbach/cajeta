package profile.gpu;

import cajeta.collection.ArrayList;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Workgroup;
import cajeta.xpu.Barrier;
import cajeta.xpu.Shared;

import profile.Benchmark;

// GPU dense N×N matrix multiply C = A·B (flat row-major float64), run as a real
// device @Kernel — the first of the suite's GPU compute benchmarks. Built once
// for amdgpu+vulkan+cpu (the `gpu` flavor); the active backend is chosen at run
// time via CAJETA_XPU_BACKEND, so the SAME binary produces one labeled row per
// backend. A is the identity, so C == B — a cheap exact cross-check at every
// swept size (checksum of C == checksum of B) while doing the full N^3 work.
//
// Double-buffered LDS-tiled, register-blocked fp64 GEMM. A 64x64 output tile per
// workgroup, K stepped by 8, each of the 256 threads computing a 4x4 micro-tile
// (16 register accumulators). Two ping-pong LDS panels: the next K-panel is
// prefetched into registers and stored to the alternate buffer WHILE the current
// buffer is computed, so one barrier per K-step and global latency hides under
// compute. @FastMath fuses the 16 a*b+c into v_fma_f64 (the single biggest lever).
// 2x the naive single-accumulator kernel: 423 GFLOP/s at n=1024 on gfx1151/HIP
// (~94% of rocBLAS/PyTorch's 449) and WINS at n=256 (253 vs 247). The last ~6% is
// vendor-BLAS fp64-VALU scheduling. Assumes n % 64 == 0 (all swept sizes are).
public class GpuMatMulBench extends Benchmark {

    public float64[] a;
    public float64[] b;
    public float64[] c;
    public KernelBuffer<float64> ka;
    public KernelBuffer<float64> kb;
    public KernelBuffer<float64> kc;
    public KernelStream stream;
    public int32 nDim;
    public uint32 nU;
    public uint32 gridX;
    public uint32 blockX;
    public float64 bSum;
    public float64 cSum;

    @Kernel
    @FastMath
    public static void gpuMatmul(KernelBuffer<float64> c, KernelBuffer<float64> a,
                              KernelBuffer<float64> b, uint32 n) {
        Shared<float64> as = shared float64[2 * 512];
        Shared<float64> bs = shared float64[2 * 512];
        uint32 tid = KernelThread.x();
        uint32 bm = Workgroup.y();
        uint32 bn = Workgroup.x();
        uint32 threadRow = tid / 16;
        uint32 threadCol = tid % 16;
        uint32 rowBase = bm * 64;
        uint32 colBase = bn * 64;
        uint32 liA0 = tid + 0; uint32 mA0 = liA0 / 8; uint32 kA0 = liA0 % 8;
        uint32 liA1 = tid + 256; uint32 mA1 = liA1 / 8; uint32 kA1 = liA1 % 8;
        uint32 liB0 = tid + 0; uint32 kB0 = liB0 / 64; uint32 nB0 = liB0 % 64;
        uint32 liB1 = tid + 256; uint32 kB1 = liB1 / 64; uint32 nB1 = liB1 % 64;
        float64 c0_0 = 0.0; float64 c0_1 = 0.0; float64 c0_2 = 0.0; float64 c0_3 = 0.0;
        float64 c1_0 = 0.0; float64 c1_1 = 0.0; float64 c1_2 = 0.0; float64 c1_3 = 0.0;
        float64 c2_0 = 0.0; float64 c2_1 = 0.0; float64 c2_2 = 0.0; float64 c2_3 = 0.0;
        float64 c3_0 = 0.0; float64 c3_1 = 0.0; float64 c3_2 = 0.0; float64 c3_3 = 0.0;
        as[0 + kA0 * 64 + mA0] = a[(rowBase + mA0) * n + 0 + kA0];
        as[0 + kA1 * 64 + mA1] = a[(rowBase + mA1) * n + 0 + kA1];
        bs[0 + kB0 * 64 + nB0] = b[(0 + kB0) * n + colBase + nB0];
        bs[0 + kB1 * 64 + nB1] = b[(0 + kB1) * n + colBase + nB1];
        Barrier.workgroup();
        uint32 ph = 0;
        uint32 k0 = 0;
        while (k0 < n) {
            uint32 knext = k0 + 8;
            float64 ra0 = 0.0; float64 ra1 = 0.0;
            float64 rb0 = 0.0; float64 rb1 = 0.0;
            if (knext < n) {
                ra0 = a[(rowBase + mA0) * n + knext + kA0];
                ra1 = a[(rowBase + mA1) * n + knext + kA1];
                rb0 = b[(knext + kB0) * n + colBase + nB0];
                rb1 = b[(knext + kB1) * n + colBase + nB1];
            }
            uint32 base = ph * 512;
            uint32 kk = 0;
            while (kk < 8) {
                uint32 aB = base + kk * 64 + threadRow * 4;
                float64 a0 = as[aB + 0]; float64 a1 = as[aB + 1];
                float64 a2 = as[aB + 2]; float64 a3 = as[aB + 3];
                uint32 bB = base + kk * 64 + threadCol * 4;
                float64 b0 = bs[bB + 0]; float64 b1 = bs[bB + 1];
                float64 b2 = bs[bB + 2]; float64 b3 = bs[bB + 3];
                c0_0 = c0_0 + a0 * b0; c0_1 = c0_1 + a0 * b1; c0_2 = c0_2 + a0 * b2; c0_3 = c0_3 + a0 * b3;
                c1_0 = c1_0 + a1 * b0; c1_1 = c1_1 + a1 * b1; c1_2 = c1_2 + a1 * b2; c1_3 = c1_3 + a1 * b3;
                c2_0 = c2_0 + a2 * b0; c2_1 = c2_1 + a2 * b1; c2_2 = c2_2 + a2 * b2; c2_3 = c2_3 + a2 * b3;
                c3_0 = c3_0 + a3 * b0; c3_1 = c3_1 + a3 * b1; c3_2 = c3_2 + a3 * b2; c3_3 = c3_3 + a3 * b3;
                kk = kk + 1;
            }
            if (knext < n) {
                uint32 nb = (1 - ph) * 512;
                as[nb + kA0 * 64 + mA0] = ra0;
                as[nb + kA1 * 64 + mA1] = ra1;
                bs[nb + kB0 * 64 + nB0] = rb0;
                bs[nb + kB1 * 64 + nB1] = rb1;
            }
            Barrier.workgroup();
            ph = 1 - ph;
            k0 = knext;
        }
        uint32 r0 = rowBase + threadRow * 4;
        uint32 cc = colBase + threadCol * 4;
        c[(r0 + 0) * n + cc + 0] = c0_0; c[(r0 + 0) * n + cc + 1] = c0_1; c[(r0 + 0) * n + cc + 2] = c0_2; c[(r0 + 0) * n + cc + 3] = c0_3;
        c[(r0 + 1) * n + cc + 0] = c1_0; c[(r0 + 1) * n + cc + 1] = c1_1; c[(r0 + 1) * n + cc + 2] = c1_2; c[(r0 + 1) * n + cc + 3] = c1_3;
        c[(r0 + 2) * n + cc + 0] = c2_0; c[(r0 + 2) * n + cc + 1] = c2_1; c[(r0 + 2) * n + cc + 2] = c2_2; c[(r0 + 2) * n + cc + 3] = c2_3;
        c[(r0 + 3) * n + cc + 0] = c3_0; c[(r0 + 3) * n + cc + 1] = c3_1; c[(r0 + 3) * n + cc + 2] = c3_2; c[(r0 + 3) * n + cc + 3] = c3_3;
    }

    public String name() {
        return "matmul";
    }

    public String area() {
        return "gpu";
    }

    // The runtime-selected device backend, reported on the result row. The gpu
    // build bundles amdgpu+vulkan+cpu; the driver forces one per run via
    // CAJETA_XPU_BACKEND, so echoing it labels the row accurately. Unset → cpu.
    public String backend() {
        String bk = System.env.get("CAJETA_XPU_BACKEND");
        if (bk == null) {
            return "cpu";
        }
        // Return a literal (borrow) — matches the base non-`#` signature and
        // avoids transferring the owned env string out of scope.
        if (bk.equals("hip")) {
            return "hip";
        }
        if (bk.equals("vulkan")) {
            return "vulkan";
        }
        if (bk.equals("amdgpu")) {
            return "amdgpu";
        }
        if (bk.equals("cpu")) {
            return "cpu";
        }
        return "cpu";
    }

    // Device-availability gate: skip cleanly (recorded, never a crash) when the
    // selected backend is not one this build can target. A CPU-only host that
    // forces an absent GPU backend gets a skip row instead of a failed suite.
    public boolean available() {
        String bk = System.env.get("CAJETA_XPU_BACKEND");
        if (bk == null) {
            return true;
        }
        if (bk.equals("hip") || bk.equals("amdgpu") || bk.equals("vulkan")
                || bk.equals("cpu")) {
            return true;
        }
        return false;
    }

    public String skipReason() {
        return "xpu backend not available in this build (CAJETA_XPU_BACKEND)";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    // Problem-size sweep: one labeled row per size. All are % 8 == 0. The sweep
    // exposes the overhead→compute crossover (small N: GPU launch-bound; large N:
    // compute-bound, GPU wins).
    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("n256");
        v.add("n512");
        v.add("n1024");
        v.add("n2048");
        return v;
    }

    private int32 sizeFor(String variant) {
        if (variant.equals("n256")) {
            return 256;
        }
        if (variant.equals("n512")) {
            return 512;
        }
        if (variant.equals("n1024")) {
            return 1024;
        }
        if (variant.equals("n2048")) {
            return 2048;
        }
        return 256;
    }

    public void setup() {
        this.stream #= KernelStream.current();
    }

    // Build the per-variant inputs and upload them: A = identity, B[idx]=idx%100
    // ⇒ C == B. Reallocating the fields drops the prior variant's buffers.
    public void prepare(String variant) {
        this.nDim = this.sizeFor(variant);
        int32 sz = this.nDim * this.nDim;
        this.a = heap float64[sz];
        this.b = heap float64[sz];
        this.c = heap float64[sz];
        int32 i = 0;
        while (i < this.nDim) {
            int32 j = 0;
            while (j < this.nDim) {
                int32 idx = i * this.nDim + j;
                if (i == j) {
                    this.a[idx] = 1.0;
                } else {
                    this.a[idx] = 0.0;
                }
                this.b[idx] = (float64) (idx % 100);
                this.c[idx] = 0.0;
                j = j + 1;
            }
            i = i + 1;
        }
        float64 s = 0.0;
        int32 k = 0;
        while (k < sz) {
            s = s + this.b[k];
            k = k + 1;
        }
        this.bSum = s;

        this.ka = heap KernelBuffer<float64>(sz);
        this.kb = heap KernelBuffer<float64>(sz);
        this.kc = heap KernelBuffer<float64>(sz);
        this.ka.upload(this.a);
        this.kb.upload(this.b);
        this.kc.upload(this.c);

        this.nU = (uint32) this.nDim;
        this.blockX = 256;            // 256 threads/workgroup, each a 4x4 micro-tile
        this.gridX = this.nU / 64;    // one workgroup per 64x64 output tile (square)
    }

    public int64 inputSize() {
        return (int64) (this.nDim * this.nDim);   // N² → report derives 2·N³ GFLOP
    }

    public void run(int32 iterations) {
        gpuMatmul.launch(this.stream, grid: [this.gridX, this.gridX], block: [this.blockX])(
            this.kc, this.ka, this.kb, this.nU);
        this.stream.sync();
    }

    public boolean checkResult() {
        this.kc.download(this.c);
        int32 sz = this.nDim * this.nDim;
        float64 s = 0.0;
        int32 m = 0;
        while (m < sz) {
            s = s + this.c[m];
            m = m + 1;
        }
        this.cSum = s;
        return this.cSum == this.bSum;
    }
}
