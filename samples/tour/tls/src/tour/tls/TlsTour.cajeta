package tour.tls;

import cajeta.lang.String;
import cajeta.io.file.File;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.tls.TlsListener;
import cajeta.io.net.tls.TlsStream;
import cajeta.concurrent.Tasks;

// Cajeta TLS tour — a REAL TLS handshake + echo over loopback, no external
// network. The OpenSSL-backed cajeta.io.net.tls surface:
//
//   - TlsListener.bind(addr, cert, key)  — server-side termination: bind a
//     TCP listener and hold the certificate/key; accept() performs the TCP
//     accept AND the server side of the handshake, returning a ready
//     TlsStream.
//   - TlsStream.client(#tcp, host, trust) — verifying client: the self-signed
//     server cert is passed as the client's TRUST ANCHOR (there is no
//     insecure skip-verify mode), and `host` ("localhost", matching the
//     cert's SAN) drives both SNI and hostname verification.
//
// accept() and handshake() both block their fiber, so the two ends overlap
// via structured concurrency: the server side is `spawn`ed as an async fiber,
// the client handshakes on the current one, and `await` joins the two. A
// plain (non-async) main() enters fiber-land with Tasks.runBlocking.
//
// The certificate is generated by run-tls.sh (openssl req -x509, CN/SAN
// localhost) into build/certs/; the demo reads the PEM bytes with
// File.readAllBytes. Without certs it skips gracefully (exit 0).
public final class TlsTour {

    static int32 checks = 0;
    static int32 failures = 0;

    // Assert `cond`; quiet when it holds, loud when it doesn't.
    static void check(boolean cond, String what) {
        TlsTour.checks = TlsTour.checks + 1;
        if (!cond) {
            TlsTour.failures = TlsTour.failures + 1;
            System.stdout.println("  FAIL: " + what);
        }
    }

    // Server fiber: accept one connection (TCP accept + TLS server handshake
    // in one call), echo one record back, report the byte count.
    public static async int32 serveOne(#TlsListener listener) {
        TlsStream s = listener.accept();
        int8[] buf = heap int8[256];
        int32 n = s.read(buf, 256);
        s.write(buf, n);
        return n;
    }

    public static int32 main(String[] args) {
        System.stdout.println("=== Cajeta TLS tour ===");
        System.stdout.println("  TlsListener/TlsStream: handshake + echo over 127.0.0.1,");
        System.stdout.println("  self-signed cert as the client's trust anchor.");
        System.stdout.println("");
        int8[] cert = File.readAllBytes("build/certs/cert.pem");
        int8[] key = File.readAllBytes("build/certs/key.pem");
        if (cert == null || key == null
                || (int32) cert.count() == 0 || (int32) key.count() == 0) {
            System.stdout.println("skip: no certificate at build/certs/{cert,key}.pem");
            System.stdout.println("      run ./run-tls.sh (it generates one with openssl)");
            return 0;
        }
        System.stdout.println("-- certs: cert.pem " + (int32) cert.count()
                            + " bytes, key.pem " + (int32) key.count() + " bytes --");
        () -> int32 body = () -> {
            int32 cl = (int32) cert.count();
            int32 kl = (int32) key.count();
            // "localhost" — the SNI + verification name; matches the cert SAN.
            int8[] host = heap int8[9];
            host[0] = (int8) 108; host[1] = (int8) 111; host[2] = (int8) 99;
            host[3] = (int8) 97;  host[4] = (int8) 108; host[5] = (int8) 104;
            host[6] = (int8) 111; host[7] = (int8) 115; host[8] = (int8) 116;

            // Server: bind loopback on an OS-assigned port, cert+key held.
            IpAddress la = IpAddress.loopbackV4();
            SocketAddress bindAddr = SocketAddress.of(#la, 0);
            TlsListener listener = TlsListener.bind(bindAddr, cert, cl, key, kl);
            int32 port = listener.boundPort();
            System.stdout.println("");
            System.stdout.println("-- listener bound on 127.0.0.1:" + port + " (OS-assigned) --");
            TlsTour.check(port > 0, "tls: listener bound a real port");

            // Client TCP connect first, THEN spawn the accept fiber, so the
            // two handshake ends overlap deadlock-free.
            IpAddress ca = IpAddress.loopbackV4();
            SocketAddress connAddr = SocketAddress.of(#ca, port);
            TcpStream client = TcpStream.connect(#connAddr);
            Task<int32> serverTask = spawn serveOne(#listener);

            // Client handshake: the self-signed cert IS the trust anchor.
            TlsStream ct = TlsStream.client(#client, host, 9, cert, cl);
            ct.handshake();
            System.stdout.println("-- handshake complete (TLS 1.2+; hostname 'localhost' verified) --");

            // Echo: write "ping", read it back through the encrypted channel.
            int8[] ping = heap int8[4];
            ping[0] = (int8) 112; ping[1] = (int8) 105;   // p i
            ping[2] = (int8) 110; ping[3] = (int8) 103;   // n g
            ct.write(ping, 4);
            int8[] echo = heap int8[256];
            int32 got = ct.read(echo, 256);
            int32 sret = await serverTask;
            ct.closeNotify();
            ct.close();
            TlsTour.check(sret == 4, "tls: server read 4 plaintext bytes");
            TlsTour.check(got == 4, "tls: client read 4 echoed bytes");
            boolean same = true;
            int32 i = 0;
            while (i < 4) {
                if (echo[i] != ping[i]) { same = false; }
                i = i + 1;
            }
            TlsTour.check(same, "tls: echo payload matches");
            System.stdout.println("-- echo: sent 'ping' (4 bytes), got " + got
                                + " bytes back, payload match = " + same + " --");
            return 0;
        };
        int32 rc = Tasks.runBlocking<int32>(body);
        System.stdout.println("");
        if (rc != 0 || TlsTour.failures > 0) {
            System.stdout.println("=== tls tour FAILED: " + TlsTour.failures
                + " of " + TlsTour.checks + " self-checks ===");
            return 1;
        }
        System.stdout.println("=== tls tour complete: " + TlsTour.checks
            + " self-checks passed ===");
        return 0;
    }
}
