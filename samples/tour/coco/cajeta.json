{
    // Cajeta coverage tour — one class per finding cajeta-coco can report,
    // and the manifest that produces them.
    //
    //   cajeta.json                    ← this manifest
    //   src/tour/coco/*.cajeta         ← the MEASURED code (package tour.coco)
    //   src/tour/coco/tests/*.cajeta   ← the suite (package tour.coco.tests)
    //   build/coco/                    ← coco's artifacts (gitignored)
    //
    // From this directory:
    //   cajeta test        → build + run the suite (no instrumentation)
    //   cajeta cover       → instrument, run, report          ← the tour
    //   ./run-coco.sh      → cajeta cover, then a summary of every finding
    //   cajeta clean       → wipe build/
    //
    // See README.md for what each finding is and where it appears in the IDE,
    // and docs/guide/23-code-coverage.md for the full configuration reference.

    // `${...}` substitution is eager and textual (BuildTool.md "Properties").
    // It reaches `settings` and `plugins` at manifest load, and a task's action
    // params at run time — so the version below is written once and the
    // dependency picks it up.
    "properties": {
        "unit-version": "0.2.3"
    },

    "details": {
        "name":                "coco-tour",
        "version":             "0.1.0",
        "description":         "Cajeta coverage tour — every finding cajeta-coco can report, one class each",
        "license":             "Apache-2.0",
        "authors":             ["cajeta"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The measured program itself needs nothing: no files, no sockets, no
        // subprocesses. The coverage PLUGIN needs `process` and `filesystem`
        // (it drives the compiler and writes reports), which is why they are
        // granted to it below rather than to this project.
        "capabilities": [],

        // The coverage plugin declares `process` and `filesystem`. A plugin
        // cannot widen its own reach: the CONSUMER allowlists what plugins may
        // hold, and a plugin declaring anything outside it is refused at load
        // time rather than sandboxed at run time.
        "plugins-allowed-capabilities": ["process", "filesystem"],

        "dependencies": {
            // The test framework. It is also what makes PER-TEST ATTRIBUTION
            // possible: coco patches `dev.cajeta.unit`'s Runner in the bitcode
            // it links, so each test dumps its own probe delta. Without a
            // recognised runner on the classpath the run still works, and the
            // Tests tab says the data was not collected rather than showing an
            // empty result (spec 6.2.4).
            "dev.cajeta.unit": "${unit-version}"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev", "priority": 0 }
        ],

        "build": {
            "source-root":  "src",
            "target":       "host",
            "entry-method": "tour.coco.CocoTour::main"
        }
    },

    // ── The coverage plugin ────────────────────────────────────────────────
    //
    // `dev.cajeta.coverage` adapts cajeta-coco to the build tool's action
    // contracts. It ships two actions:
    //
    //   cajeta.coverage.instrument — the whole measured pipeline: compile,
    //       instrument, link, run the suite, merge per-test profiles.
    //       Fails the task if the suite fails.
    //   cajeta.coverage.report     — render HTML + lcov + SARIF + crap.tsv
    //       from the run's artifacts, then apply the `min` gate. Re-rendering
    //       never re-runs anything (spec 7.2).
    //
    // Everything in `config` is a default for both actions; a task may
    // override any of it per-action.
    "plugins": {
        "dev.cajeta.coverage": {
            "version": "0.5.*",

            "config": {
                // What to measure, and the method whose return dumps the
                // profile. `entry` is dotted (pkg.Class.method), NOT the
                // `::` form used by settings.build.entry-method.
                "src":   "src",
                "entry": "tour.coco.CocoTour.main",

                // `classpath` is NOT set. The build tool sends the project's
                // resolved dependency archives as `context.classpath` — the
                // same string it gives the compiler as `--classpath` — and the
                // plugin uses it when the task names none. Set `classpath`
                // explicitly only to override that.

                // Where every artifact lands, relative to this directory.
                // The IDE reads this same path (see README).
                "out":   "build/coco",

                // Path fragments left UNINSTRUMENTED. The tests are excluded
                // for two reasons: their own lines would otherwise inflate the
                // percentage with code that is by definition executed, and —
                // less obvious — instrumented test bodies each own unique
                // lines, which would make every test look like it contributes
                // unique coverage and destroy the redundancy signal the Tests
                // tab exists to give (see CouponTests).
                //
                // An exclusion removes code from BOTH numerator and
                // denominator: it opts out of measurement, it does not round
                // the number up.
                //
                // The framework itself is excluded for the same reason every
                // coverage tool excludes its own harness: `dev.cajeta.unit` is
                // somebody else's tested code, and leaving it in measures the
                // library instead of the project.
                "exclude": ["tour/coco/tests/", "dev/cajeta/unit/"],

                // The gate. Below this, `cajeta.coverage.report` fails the
                // task — JaCoCo `check` semantics, so 35.9% fails a min of 36.
                // Set just under this project's real 36.0%: the tour is
                // SUPPOSED to have gaps, and one that cannot be run is not a
                // tour. Raise it to 40 and re-run to watch the gate fire. A
                // real project starts at its current number and ratchets up.
                "min": 30
            }
        }
    },

    "tasks": {

        "build": {
            "description": "Build the tour to a native binary (build/coco-tour)",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "output-path": "build/coco-tour", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Run the suite with no instrumentation (the fast loop)",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "output-path": "build/coco-tour", "id": "art" },
                { "action": "test", "input": "${art.path}", "id": "tr" }
            ],
            "outputs": { "passed": "${tr.passed}", "failed": "${tr.failed}" }
        },

        // NOT named "coverage": `cajeta coverage` is a built-in subcommand
        // (it manages the exclude list), so a task by that name would need
        // `cajeta -- coverage` to reach. `cover` needs no disambiguation.
        "cover": {
            "description": "Instrument, run the suite, and render the coverage report",
            "actions": [
                { "action": "cajeta.coverage.instrument", "id": "ci" },
                { "action": "cajeta.coverage.report",     "id": "cov" }
            ],
            "outputs": {
                "percent": "${cov.percent}",
                "html":    "${cov.html-path}",
                "lcov":    "${cov.lcov-path}",
                "sarif":   "${cov.sarif-path}"
            }
        },

        // Mutation runs OVER a completed `cover`, never instead of one: it
        // needs that run's site table, profile and recorded link line. One
        // mutant is one llc + one relink + one suite run, which is why this is
        // a separate task rather than another action on `cover` — an ordinary
        // coverage run should not pay it.
        "mutate": {
            "description": "Mutation-test the last cover run (execution is not verification)",
            "actions": [
                { "action": "cajeta.coverage.mutate", "id": "mut" }
            ],
            "outputs": {
                "score":    "${mut.score}",
                "killed":   "${mut.killed}",
                "survived": "${mut.survived}",
                "skipped":  "${mut.skipped}",
                "results":  "${mut.mutation-path}"
            }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
