package tour.io;

import tour.DemoClass;
import cajeta.io.file.File;
import cajeta.io.file.FileReader;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import cajeta.io.file.Path;

// File I/O — `cajeta.io.file` ships three layers:
//
//   1. One-shot helpers — `File.readAllBytes(path)` /
//      `File.writeAllBytes(path, bytes, len)`. Best for small
//      files where allocating the whole content at once is fine.
//   2. Streaming reader / writer — `File.openRead(path)` returns a
//      `#FileReader` carrying its own fd; `r.read(buf, max)` pulls
//      up to `max` bytes into a caller-owned buffer and returns
//      the count actually read (0 at EOF — ALWAYS loop; a single
//      read is not a contract for the whole file).
//      `File.openWrite(path, mode)` mirrors the shape, with
//      `OpenMode.WRITE` (truncate-or-create) vs `APPEND`.
//   3. Random-access — `File.open(path, mode)` returns a `#File`
//      with `read / write / seek / position / size`; used for
//      memory-mapped-record style access. (Not exercised here;
//      see test/expression/FileIoTests.cpp for the full surface.)
//
// Ownership: every File* class returned with `#` is owned by the
// caller. The drop chain reclaims them at scope exit — including
// closing the fd through the user-defined destructor. Forgetting
// `close()` doesn't leak: leaving scope IS close-and-free.
//
// The scenario is a little service log: write it, append to it,
// stream it back in chunks, handle the file that isn't there, and
// leave /tmp exactly as we found it.

public class FileIoDemo extends DemoClass {

    static String LOG = "/tmp/cajeta_tour_service.log";

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- File I/O --");

        this.oneShotRoundTrip();
        this.writeThenAppend();
        this.streamingReaderEofLoop();
        this.missingFile();
        this.cleanup();
    }

    // 1. One-shot write + read: the whole payload in one call each way,
    //    verified byte-for-byte.
    public void oneShotRoundTrip() {
        int8[] data = heap int8[5];
        data[0] = (int8) 72;   // 'H'
        data[1] = (int8) 101;  // 'e'
        data[2] = (int8) 108;  // 'l'
        data[3] = (int8) 108;  // 'l'
        data[4] = (int8) 111;  // 'o'

        File.writeAllBytes(FileIoDemo.LOG, data, 5);
        int8[] back #= File.readAllBytes(FileIoDemo.LOG);
        boolean same = (int32) back.count() == 5;
        int32 i = 0;
        while (same && i < 5) {
            if (back[i] != data[i]) { same = false; }
            i = i + 1;
        }
        System.stdout.println("  oneShot: wrote 5 bytes, read " + back.count());
        this.check(same, "one-shot round trip is byte-identical");
    }

    // 2. WRITE truncates-or-creates; APPEND adds at EOF. A log file is the
    //    canonical APPEND customer — reopening with WRITE would erase it.
    public void writeThenAppend() {
        FileWriter w #= File.openWrite(FileIoDemo.LOG, OpenMode.WRITE);
        w.writeString("INFO  service started\n");     // 22 bytes
        w.flush();
        w.close();

        FileWriter a #= File.openWrite(FileIoDemo.LOG, OpenMode.APPEND);
        a.writeString("WARN  disk 87% full\n");       // 20 bytes
        a.flush();
        a.close();

        int8[] back #= File.readAllBytes(FileIoDemo.LOG);
        System.stdout.println("  writeThenAppend: " + back.count()
            + " bytes after WRITE + APPEND");
        this.check((int32) back.count() == 42,
            "APPEND added to the file instead of truncating it");
    }

    // 3. The streaming reader's REAL contract: read(buf, max) returns up to
    //    max bytes and 0 at EOF — so the loop, not one call, is the idiom.
    //    A 16-byte buffer over a 42-byte file must take 3 reads.
    public void streamingReaderEofLoop() {
        FileReader r #= File.openRead(FileIoDemo.LOG);
        int8[] buf = heap int8[16];
        int64 total = 0;
        int32 reads = 0;
        int32 n = r.read(buf, 16);
        while (n > 0) {
            total = total + (int64) n;         // consume buf[0..n) here
            reads = reads + 1;
            n = r.read(buf, 16);
        }
        int64 pos = r.position();
        r.close();
        System.stdout.println("  streamingReader: " + total + " bytes in "
            + reads + " chunked reads (buffer 16)");
        this.check(total == 42 && reads == 3,
            "EOF loop drains the file across multiple reads");
        this.check(pos == 42, "position() tracks cumulative bytes");
    }

    // 4. The file that isn't there: readAllBytes yields null-or-empty —
    //    guard BOTH before trusting the bytes (the TlsTour idiom). No
    //    exception on this path; absence is a normal case for a reader.
    public void missingFile() {
        int8[] ghost #= File.readAllBytes("/tmp/cajeta_tour_no_such_file");
        boolean absent = ghost == null || (int32) ghost.count() == 0;
        this.check(absent, "missing file reads as null-or-empty, not garbage");
    }

    // 5. The tour leaves no droppings (the NpyDemo pattern).
    public void cleanup() {
        Path p #= Path.of(FileIoDemo.LOG);
        p.delete();
        this.check(!p.exists(), "temp log deleted");
    }
}
