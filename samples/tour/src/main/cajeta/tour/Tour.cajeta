package tour;

import cajeta.collection.ArrayList;

// Demos now live in topic subpackages (mirroring the stdlib layout);
// wildcard-import each so the demos[] initializer below can name them
// by their simple class name. DemoClass and the shared support classes
// (Point, Counter) stay in this root `tour` package.
import tour.lang.*;
import tour.collection.*;
import tour.concurrent.*;
import tour.math.*;
import tour.error.*;
import tour.wire.*;
import tour.time.*;
import tour.net.*;
import tour.io.*;
import tour.codec.*;
import tour.hash.*;
import tour.process.*;
import tour.search.*;

// Cajeta language tour. Every load-bearing feature of the language
// has a demo class extending DemoClass; this entry point puts one
// instance of every demo into a list, then walks the list calling
// execute() on each. Adding a new demo means:
//
//   1. Write a new DemoClass subclass in this package.
//   2. Add one `demos.add(heap NewDemo());` line.
//
// Build with samples/Tour/build-bin.sh (native binary) or
// build-cja.sh (single .cja archive).
//
// The demo list is `ArrayList<DemoClass>` — a class-typed template
// instantiation. Cross-file `ArrayList<UserClass>` works through the
// forward-reference placeholder mechanism: Tour parses before
// DemoClass (alphabetical order), so DemoClass is a placeholder
// when this file references it; the placeholder is filled in place
// during DemoClass's body walk and the instantiation's references
// auto-upgrade. Stream `forEach((T) -> void)` dispatches through
// each element's vtable so the correct subclass `execute` runs.
public final class Tour {

    // Entry point. Walks every demo and returns 0. The C `main` shim
    // (synthesized by --emit=obj/exe/uber when this method is the entry)
    // wires this up as the program's C `main`; argv arrives as `args`.
    public static int32 main(String[] args) {
        System.stdout.println("=== Cajeta language tour ===");

        // Heap-allocate one instance of every demo. The list owns
        // each element; the drop chain releases them at scope exit.
        ArrayList<DemoClass> demos = heap ArrayList<DemoClass>();
        demos.add(heap AllocationDemo());
        demos.add(heap OwnershipDemo());
        demos.add(heap ClassesDemo());
        demos.add(heap NamedArgsDemo());
        demos.add(heap InheritanceDemo());
        demos.add(heap MultiInheritanceDemo());
        demos.add(heap TemplatesDemo());
        demos.add(heap NumericTemplatesDemo());
        demos.add(heap StreamsDemo());
        demos.add(heap ArrayListDemo());
        demos.add(heap HashMapDemo());
        demos.add(heap HashSetDemo());
        demos.add(heap LinkedListDemo());
        demos.add(heap LambdasDemo());
        demos.add(heap ErrorsDemo());
        demos.add(heap AnnotationsDemo());
        demos.add(heap ReflectionDemo());
        demos.add(heap PrimitivesDemo());
        demos.add(heap GuidDemo());
        demos.add(heap StringDemo());
        demos.add(heap ControlFlowDemo());
        demos.add(heap MathDemo());
        demos.add(heap AutogradDemo());
        demos.add(heap TrainingLoopDemo());
        demos.add(heap JsonTiersDemo());
        demos.add(heap FormatStringDemo());
        demos.add(heap ViewsDemo());
        demos.add(heap ParallelStreamsDemo());
        demos.add(heap AsyncDemo());
        demos.add(heap ConcurrentDemo());
        demos.add(heap TimeDemo());
        demos.add(heap NetDemo());
        demos.add(heap JsonDemo());
        demos.add(heap AspectsDiDemo());
        demos.add(heap FactoryDemo());
        demos.add(heap WildcardsDemo());
        demos.add(heap SwitchTernaryDemo());
        demos.add(heap InterfacesDemo());
        demos.add(heap EncodingDemo());
        demos.add(heap StaticNestedDemo());
        demos.add(heap StaticFieldsDemo());
        demos.add(heap OptionalDemo());
        demos.add(heap PairDemo());
        demos.add(heap CollectDemo());
        demos.add(heap ProcessDemo());
        demos.add(heap SearchDemo());
        demos.add(heap BufferDemo());
        demos.add(heap FileIoDemo());
        demos.add(heap PathDemo());
        demos.add(heap UdpDemo());
        demos.add(heap ServerDemo());
        demos.add(heap UriDemo());
        demos.add(heap DnsDemo());
        demos.add(heap OperatorOverloadDemo());
        demos.add(heap LinearAlgebraDemo());
        demos.add(heap QuaternionDemo());
        demos.add(heap TensorDemo());
        demos.add(heap GeometryDemo());
        demos.add(heap FftDemo());
        demos.add(heap RandomDemo());
        demos.add(heap StatsDemo());
        demos.add(heap PolyDemo());
        demos.add(heap LinAlgDemo());
        demos.add(heap NpyDemo());
        demos.add(heap ImmutableListDemo());
        demos.add(heap ImmutableSetDemo());
        demos.add(heap ImmutableMapDemo());
        demos.add(heap HeapDemo());
        demos.add(heap RedBlackTreeDemo());
        demos.add(heap BPlusTreeDemo());
        demos.add(heap CacheDemo());
        demos.add(heap CollectorsDemo());
        demos.add(heap SortDemo());
        demos.add(heap LtmBPlusTreeDemo());
        demos.add(heap HashDemo());
        demos.add(heap Base64Demo());
        demos.add(heap CsvDemo());
        demos.add(heap SchemaDemo());

        // Stream over the list — virtual dispatch lands each
        // subclass's execute() override.
        demos.stream().forEach((d) -> d.execute());

        System.stdout.println("");
        if (DemoClass.failures > 0) {
            System.stdout.println("=== tour FAILED: " + DemoClass.failures
                + " of " + DemoClass.checks + " self-checks ===");
            return 1;
        }
        System.stdout.println("=== tour complete: " + DemoClass.checks
            + " self-checks passed ===");
        System.stdout.println("separate tours: samples/tour/xpu (GPU kernels), "
            + "samples/tour/ifx (windowing, headless), samples/tour/tls (TLS loopback)");
        return 0;
    }
}
