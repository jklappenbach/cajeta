package tour;

// Classic control flow: if/else, while, for, enhanced-for. The grammar
// is C-family; bodies require braces.
public class ControlFlowDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Control flow --");

        // if / else chain — sum of [1..5] partitioned by parity.
        int32 evenSum = 0;
        int32 oddSum  = 0;
        int32 i = 1;
        while (i <= 5) {
            if (i % 2 == 0) {
                evenSum = evenSum + i;
            } else {
                oddSum = oddSum + i;
            }
            i = i + 1;
        }
        System.stdout.println("  while: evenSum [1..5] = " + evenSum);
        System.stdout.println("  while: oddSum  [1..5] = " + oddSum);

        // C-style for — factorial of 5.
        int32 fact = 1;
        for (int32 k = 1; k <= 5; k = k + 1) {
            fact = fact * k;
        }
        System.stdout.println("  for:   5! = " + fact);

        // Enhanced-for over an int32[]: sum of squares.
        int32[] xs = {1, 2, 3, 4};
        int32 sqSum = 0;
        for (int32 x : xs) {
            sqSum = sqSum + x * x;
        }
        System.stdout.println("  for-each: sum of squares = " + sqSum);
    }
}
