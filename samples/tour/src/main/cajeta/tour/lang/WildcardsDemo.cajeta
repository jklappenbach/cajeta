package tour.lang;

import tour.DemoClass;

// Template wildcards (`<? extends T>` / `<? super T>` / `<?>`) +
// capture conversion. The standard PECS (Producer Extends, Consumer
// Super) shape: covariant reads through an `extends`-bounded
// receiver, contravariant writes through a `super`-bounded
// receiver, and capture-identity-aware read-back through the same
// receiver.
//
// `Box<? extends Animal>` is a Box whose element type is SOME
// subtype of Animal — unknown which one. The compiler:
//   - Accepts `Box<Dog>` / `Box<Cat>` etc. as values (covariant
//     subtype: `Box<Dog> <: Box<? extends Animal>`).
//   - PROJECTS reads through the upper bound — `b.value.tag()`
//     resolves to `Animal::tag` even when no specific T is known.
//   - REJECTS foreign writes (`b.set(otherAnimal)`) because the
//     concrete T could be a strict subtype.
//
// `Box<? super Dog>` is a Box whose element type is SOME supertype
// of Dog. The compiler:
//   - Accepts `Box<Animal>` (Animal is a supertype of Dog) and
//     `Box<Dog>` itself.
//   - ACCEPTS writes of Dog (or any Dog subtype) — every supertype
//     of Dog can hold a Dog.
//   - Doesn't project on reads (the upper type is unknown).
//
// Capture conversion (Java-style `capture#N`) tracks "this value
// came from this receiver" — so `b.set(b.get())` is legal even on
// `Box<? extends Animal>` (the value's origin proves it's the
// receiver's exact T, just not nameable in source).
//
// See docs/TemplateWildcard.md and
// docs/CaptureConversion.md.

// Class hierarchy: Animal -> { Dog, Cat }. Each carries a `tag`
// method overriding the parent — virtual dispatch confirms which
// concrete subtype the box actually held.
public class Animal {
    public int32 tag() { return 1; }
    public Animal() { return; }
}
public class Dog extends Animal {
    public int32 tag() { return 2; }
    public Dog() { return; }
}
public class Cat extends Animal {
    public int32 tag() { return 3; }
    public Cat() { return; }
}

// Generic container — used as the receiver for every wildcard shape
// below. Field is the simple T value; the methods are T-parametric.
public class WildBox<T> {
    public T value;
    public WildBox(T v) { this.value = v; }
    public T get() { return this.value; }
    public void set(T v) { this.value = v; }
}

public class WildcardsDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Template wildcards & capture conversion --");

        this.extendsProducerReads();
        this.superConsumerWrites();
        this.captureReadBack();
        this.wildcardParameterPolymorphism();
    }

    // 1. `? extends Animal` — producer side (read-covariant).
    // Box<Dog> is a covariant subtype of Box<? extends Animal>, so
    // the assignment is accepted; field reads project through the
    // upper bound so `.tag()` resolves on Animal even though the
    // box's actual T is Dog. Runtime dispatch lands on Dog::tag.
    public void extendsProducerReads() {
        Dog d = heap Dog();
        WildBox<Dog> bDog = heap WildBox<Dog>(d);
        WildBox<? extends Animal> b = bDog;
        int32 tag = b.value.tag();
        System.stdout.println("  ? extends Animal . value.tag() = "
            + tag + "  (Dog::tag overrides at runtime)");

        // Same shape, different concrete T — Box<Cat> ALSO fits the
        // upper bound. The static type is identical (`WildBox<? extends Animal>`);
        // virtual dispatch resolves the override at runtime.
        Cat c = heap Cat();
        WildBox<Cat> bCat = heap WildBox<Cat>(c);
        WildBox<? extends Animal> b2 = bCat;
        System.stdout.println("  ? extends Animal . value.tag() = "
            + b2.value.tag() + "  (Cat::tag at runtime)");
    }

    // 2. `? super Dog` — consumer side (write-contravariant).
    // Box<Animal> fits because Animal is a supertype of Dog;
    // writing a Dog into the box is sound (every Dog-supertype slot
    // can hold a Dog). After the write the underlying Box<Animal>'s
    // value field carries the Dog — observable through the original
    // bAnimal reference.
    public void superConsumerWrites() {
        Animal seed = heap Animal();
        WildBox<Animal> bAnimal = heap WildBox<Animal>(seed);
        // Before the write: bAnimal.value is the seed Animal (tag 1).
        System.stdout.println("  before super write: bAnimal.value.tag() = "
            + bAnimal.value.tag());

        WildBox<? super Dog> b = bAnimal;
        Dog d = heap Dog();
        b.value = d;
        System.stdout.println("  after  super write: bAnimal.value.tag() = "
            + bAnimal.value.tag() + "  (Dog landed in Animal slot)");
    }

    // 3. Capture conversion. `b.set(b.get())` on a Box<? extends Animal>
    // is legal — the value flowing through the chain came FROM this
    // receiver, so its origin (capture#N of the receiver's unknown T)
    // is exactly what set(T) wants. The compiler tracks per-receiver
    // capture identity to permit this read-back pattern. A foreign
    // Animal value would be rejected with CAJETA_ERROR_PECS_WRITE_VIOLATION.
    public void captureReadBack() {
        Dog d = heap Dog();
        WildBox<? extends Animal> b = heap WildBox<Dog>(d);
        // Read-back: the value passed to set() came from get() on
        // the same receiver — same capture identity, so the write
        // is sound.
        b.set(b.get());
        System.stdout.println("  capture read-back: b.set(b.get()) accepted; "
            + "b.value.tag() = " + b.value.tag());
    }

    // 4. Wildcard parameter polymorphism. A static method declared
    // `inspect(WildBox<? extends Animal>)` accepts any Box<X>
    // where X is an Animal subtype — without forcing the caller to
    // upcast through a bespoke base class. The body uses field-read
    // projection to call `.tag()` against the Animal bound.
    public void wildcardParameterPolymorphism() {
        WildBox<Dog> bDog = heap WildBox<Dog>(heap Dog());
        WildBox<Cat> bCat = heap WildBox<Cat>(heap Cat());
        int32 dogTag = WildcardsDemo.inspect(bDog);
        int32 catTag = WildcardsDemo.inspect(bCat);
        System.stdout.println("  inspect(WildBox<Dog>) = " + dogTag
            + "; inspect(WildBox<Cat>) = " + catTag);
    }

    public static int32 inspect(WildBox<? extends Animal> b) {
        return b.value.tag();
    }
}
