package tour.lang;

import tour.DemoClass;
import tour.Point;

// Ownership is decided per POSITION, not by one spelling. Between NAMES,
// plain `=` lends and `#=` transfers. At a CALL the caller chooses:
// `f(x)` lends, `f(#x)` transfers — and `#x` on a binding whose title has
// already moved is CAJETA_ERROR_MOVE_OF_BORROW, since `#` forwards the mode
// it was handed rather than minting a title. At a RESULT the callee decides:
// a `#T` return hands you a title and must be received with `#=` (a plain `=`
// is CAJETA_ERROR_OWNED_RESULT_NEEDS_TRANSFER), while a plain `T` return
// carries whatever the callee's frame held. The borrow checker also catches
// escape-on-return, alias-mutation, and definite-assignment violations.
public class OwnershipDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Ownership --");
        Point owner = heap Point(7, 24);
        // `consume` takes ownership of its argument; `#owner` is the
        // syntactic transfer marker. After this line `owner` is DEMOTED to a
        // borrow — still readable, since `#` moves the title and not the
        // binding — but transferring it again would be
        // CAJETA_ERROR_MOVE_OF_BORROW.
        int32 hypoSq = this.consume(#owner);
        System.stdout.println("  consume(#Point(7,24)).distSq() = " + hypoSq);
        this.check(hypoSq == 625, "ownership transferred, value computed");

        // Keeping a value in a field. `keep` stores with `#=`, so the caller
        // chooses: `keep(#p)` hands the title to the holder and `keep(p)` lends.
        // `watch` takes a `^Point`, which is only ever borrowed, so it may store
        // with plain `=` and a caller cannot pass `#p`. A `T` or `#T` parameter
        // stored with plain `=` is CAJETA_ERROR_KEEP_NEEDS_SHARP_STORE.
        Point seen = heap Point(6, 8);
        Holder h = heap Holder();
        Point kept = heap Point(3, 4);
        h.keep(#kept);
        h.watch(seen);
        System.stdout.println("  holder kept " + h.kept.distSq() + ", watched " + h.seen.distSq());
        this.check(h.kept.distSq() == 25 && h.seen.distSq() == 100, "field stores keep their values");
    }

    // Helper that takes ownership of `p` (it's destroyed when this
    // method returns).
    public int32 consume(Point p) {
        return p.distSq();
    }
}

class Holder {
    public Point kept;
    public Point seen;

    public Holder() { }

    public void keep(Point p) { this.kept #= p; }

    public void watch(^Point p) { this.seen = p; }
}
