package tour.lang;

import tour.DemoClass;

// Cajeta's primitive surface: int8/16/32/64 (+ uint variants), float32
// and float64, boolean, char. Literals follow Java-ish syntax (hex,
// binary, underscores, type suffixes). Arithmetic stays in the source
// type — explicit casts to widen across types.
public class PrimitivesDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Primitives --");
        // Different integer widths — same arithmetic surface, different
        // wrap behavior. The compiler issues the right LLVM IR per type.
        int8  i8  = 7;
        int16 i16 = 30000;
        int32 i32 = 1_000_000;          // underscores allowed in literals
        int64 i64 = 9_000_000_000L;     // L suffix for int64
        // Different float widths.
        float32 f32 = 3.14f;            // f suffix for float32
        float64 f64 = 2.71828;
        // Hex and binary literals.
        int32 hex = 0xCAFE_BABE;
        int32 bin = 0b1010_0101;
        // Boolean + char.
        boolean t = true;
        char c = 'Z';

        System.stdout.println("  int8  = " + (int32) i8);
        System.stdout.println("  int16 = " + (int32) i16);
        System.stdout.println("  int32 = " + i32);
        System.stdout.println("  int64 = " + (int32) (i64 / 1_000_000L) + "M");
        System.stdout.println("  float32 ~ " + (int32) (f32 * 100.0f) + "/100");
        System.stdout.println("  float64 ~ " + (int32) (f64 * 100.0) + "/100");
        System.stdout.println("  0xCAFE_BABE (low 16) = " + (hex & 0xFFFF));
        System.stdout.println("  0b1010_0101          = " + bin);
        System.stdout.println("  boolean = " + t);
        System.stdout.println("  char    = " + (int32) c);
        this.check((int32) i8 == 7 && (int32) i16 == 30000 && i32 == 1000000
            && i64 / 1_000_000L == 9000L, "integer widths hold their values");
        this.check((int32)(f32 * 100.0f) == 314 && (int32)(f64 * 100.0) == 271,
            "float widths hold their values");
        this.check((hex & 0xFFFF) == 0xBABE && bin == 165 && t
            && (int32) c == 90, "hex/binary literals, boolean, char");
    }
}
