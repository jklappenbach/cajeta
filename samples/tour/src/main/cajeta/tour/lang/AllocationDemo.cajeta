package tour.lang;

import tour.DemoClass;
import tour.Point;

// `stack` and `heap` are mandatory at every allocation; `new` is
// removed. The type `Point` is the same regardless of storage — the
// borrow checker tracks lifetime as metadata, not the type. Pass
// either to a function taking `Point` and it just works.
public class AllocationDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Allocation --");
        Point onStack = stack Point(3, 4);      // current frame; dropped on scope exit
        Point onHeap  = heap  Point(5, 12);     // malloc'd; freed by drop chain
        System.stdout.println("  stack Point(3,4).distSq() = " + onStack.distSq());
        System.stdout.println("  heap  Point(5,12).distSq() = " + onHeap.distSq());
    }
}
