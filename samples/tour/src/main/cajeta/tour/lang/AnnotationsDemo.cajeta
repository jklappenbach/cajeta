package tour.lang;

import tour.DemoClass;

// Lombok-style synthesis. @Builder produces a fluent builder per class;
// @Builder.Default fills in per-field defaults; @ToString synthesizes
// a printable view.
public class AnnotationsDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Annotations --");
        // Build a Book via the synthesized builder. All fields set.
        Book b #= Book.builder()
            .title("The Mythical Man-Month")
            .pages(322)
            .build();
        System.stdout.println("  Book.title    = " + b.title);
        System.stdout.println("  Book.pages    = " + b.pages);
        // Defaults case — only title set; `pages` falls back to 100
        // because of @Builder.Default on the field.
        Book d #= Book.builder().title("Untitled").build();
        System.stdout.println("  default pages = " + d.pages);
        this.check(b.title.equals("The Mythical Man-Month") && b.pages == 322,
            "builder sets every field");
        this.check(d.pages == 100, "@Builder.Default fills the unset field");
    }
}
