package tour.lang;

import tour.DemoClass;

// Single inheritance + polymorphic dispatch: a Shape ref to a Square/Circle
// calls the subclass override through the vtable. Overriding is by signature
// (re-declare the method — there is no `override` keyword). Multiple inheritance
// is its own demo — see MultiInheritanceDemo.
public class InheritanceDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Inheritance --");
        Shape sq = stack Square(5);
        Shape ci = stack Circle(3);
        // Polymorphic call through the Shape ref — vtable picks the override.
        System.stdout.println("  Square(5).area() = " + sq.area());
        System.stdout.println("  Circle(3).area() = " + ci.area());
        this.check(sq.area() == 25 && ci.area() == 27,
            "vtable dispatch picks each override");
    }
}
