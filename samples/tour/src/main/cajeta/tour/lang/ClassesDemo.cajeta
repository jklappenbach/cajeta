package tour.lang;

import tour.DemoClass;
import tour.Counter;

// Fields, constructors, methods. All classes implicitly derive from
// Object. Methods are virtual by default; @Final on a class or method
// disables overriding.
public class ClassesDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Classes --");
        Counter c = stack Counter();
        c.bump();
        c.bump();
        c.bump();
        System.stdout.println("  Counter after 3 bumps = " + c.value());
    }
}
