package tour.net;

import tour.DemoClass;

// cajeta.io.net.http — the HTTP/1.1 stack. Two layers walk here:
//
//   Router      — pure (method, path) -> handler dispatch with
//                 /users/{id} path params and the 404/405 defaults.
//                 No socket: dispatch is plain logic over the
//                 HttpRequest/HttpResponse data types.
//   HttpServer  — the live loop: HttpServer.builder().bind(...)
//                 .handler(...).build() binds the NET-4 Server core on
//                 127.0.0.1:0; an HttpClient runs a GET and a POST
//                 against it over loopback (each exchange stamps
//                 Connection: close — one socket per request in v1).
//
// In production the server runs autonomously:
//
//   spawn srv.runAsync();                    // accept loop on a fiber
//   ... srv.shutdown(Duration.ofSeconds(30)); // stop + drain
//
// The demo instead drives each accept iteration by hand through the
// core's public seams — acceptNext() + dispatch() — exactly like
// tour/net/ServerDemo.cajeta, because Server.shutdown() cannot yet
// wake a fiber parked inside acceptAsync (plan 15.6): a spawned
// runAsync() would leave the tour hanging on that parked fiber. The
// per-connection HTTP loop that dispatch() spawns is the same one
// runAsync would drive.

import cajeta.io.net.Server;
import cajeta.io.net.TcpStream;
import cajeta.io.net.http.HttpClient;
import cajeta.io.net.http.HttpRequest;
import cajeta.io.net.http.HttpResponse;
import cajeta.io.net.http.HttpServer;
import cajeta.io.net.http.HttpServerBuilder;
import cajeta.io.net.http.Router;
import cajeta.io.net.uri.Uri;
import cajeta.time.Duration;

public class HttpDemo extends DemoClass {

    // The live server's request handler: GET answers a fixed 5-byte
    // "hello" body; POST echoes the request body back. Handlers are
    // (HttpRequest) -> #HttpResponse; a throw inside one maps to a 500
    // without tearing the connection down.
    public static #HttpResponse handle(HttpRequest req) {
        if (req.getMethod().equals("POST")) {
            return HttpResponse.ok().body(req.body, req.bodyLength());
        }
        String hello = "hello";
        return HttpResponse.ok().body(hello.toBytes(), hello.byteLength());
    }

    // Client fiber: GET /hello, expect 200 + "hello". Runs on its own
    // fiber so the main fiber is free to drive the server's accept
    // iteration; returns 1 on success, a distinct negative per failure.
    public static async int32 clientGet(int32 port) {
        HttpClient client = heap HttpClient();
        Uri uri = Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path("/hello")
            .build();
        HttpRequest req = HttpRequest.fromUri("GET", uri);
        HttpResponse resp = client.send(uri, req);
        if (resp.statusCode() != 200) {
            return -1;
        }
        if (resp.bodyLength() != 5) {
            return -2;
        }
        int8[] b = resp.body;
        if (b[0] != (int8) 104 || b[4] != (int8) 111) {   // 'h' .. 'o'
            return -3;
        }
        return 1;
    }

    // Client fiber: POST /echo with a 4-byte "ping" body; the handler
    // echoes it, so the response body must match byte-for-byte.
    public static async int32 clientPost(int32 port) {
        HttpClient client = heap HttpClient();
        Uri uri = Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path("/echo")
            .build();
        HttpRequest req = HttpRequest.fromUri("POST", uri);
        int8[] ping = heap int8[4];
        ping[0] = (int8) 112;   // 'p'
        ping[1] = (int8) 105;   // 'i'
        ping[2] = (int8) 110;   // 'n'
        ping[3] = (int8) 103;   // 'g'
        req.body(ping, 4);
        HttpResponse resp = client.send(uri, req);
        if (resp.statusCode() != 200) {
            return -1;
        }
        if (resp.bodyLength() != 4) {
            return -2;
        }
        int8[] b = resp.body;
        if (b[0] != (int8) 112 || b[3] != (int8) 103) {
            return -3;
        }
        return 2;
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Networking: HTTP router + server + client (cajeta.io.net.http) --");

        // 1. The router, pure. Register a param route and a literal
        // route; dispatch hand-built requests. The {id} segment binds
        // onto the request before its handler runs.
        (HttpRequest) -> #HttpResponse userRoute = (req) -> {
            String id = req.pathParam("id");
            if (id == null) {
                return HttpResponse.of(500);
            }
            if (!id.equals("42")) {
                return HttpResponse.of(400);
            }
            return HttpResponse.of(200);
        };
        Router router = heap Router();
        router.route("GET", "/users/{id}", userRoute);
        router.route("GET", "/health", (req) -> HttpResponse.of(204));

        HttpResponse hit = router.dispatch(HttpRequest.of("GET", "/users/42"));
        this.check(hit.statusCode() == 200,
            "router: /users/{id} matched and bound id = \"42\"");
        HttpResponse miss = router.dispatch(HttpRequest.of("GET", "/nope"));
        this.check(miss.statusCode() == 404,
            "router: unknown path -> 404");
        HttpResponse wrong = router.dispatch(HttpRequest.of("POST", "/health"));
        String allow = wrong.getHeaders().get("Allow");
        this.check(wrong.statusCode() == 405
            && allow != null && allow.equals("GET"),
            "router: wrong method -> 405 with Allow: GET");
        System.stdout.println("  router: param hit 200, unknown 404, wrong method 405");

        // 2. The live loopback server. The builder records bind address
        // + accept model + handler; build() binds the socket. :0 asks
        // the kernel for an ephemeral port, read back off the listener
        // via boundPort(). (srv.localAddress() is a placeholder until
        // TcpListener grows a real SocketAddress accessor — it reports
        // 0.0.0.0:0 today, so the port must come from boundPort().)
        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h = (req) -> HttpDemo.handle(req);
            b.handler(h);
            HttpServer srv = b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            this.check(port > 0, "server bound 127.0.0.1:0 -> ephemeral port");

            // One accept iteration per request (the client stamps
            // Connection: close). The client fiber parks in its read;
            // acceptNext() pulls its connection; dispatch() spawns the
            // HTTP keep-alive loop on a connection fiber.
            Task<int32> tg = spawn clientGet(port);
            TcpStream c1 = core.acceptNext();
            core.dispatch(#c1);
            int32 gotGet = await tg;
            this.check(gotGet == 1, "GET /hello -> 200 + \"hello\"");

            Task<int32> tp = spawn clientPost(port);
            TcpStream c2 = core.acceptNext();
            core.dispatch(#c2);
            int32 gotPost = await tp;
            this.check(gotPost == 2, "POST /echo round-tripped the 4-byte body");
            System.stdout.println("  live: GET -> " + gotGet
                + ", POST -> " + gotPost + " (1/2 = success codes)");

            // The tail of shutdown(deadline): wait for the dispatched
            // connection fibers to finish, then release the listener.
            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            this.check(drained, "connection fibers drained clean");
            core.listener.close();
        }
    }
}
