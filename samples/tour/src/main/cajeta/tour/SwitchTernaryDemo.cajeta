package tour;

// Switch statements, switch expressions, ternary, and instanceof —
// the four "branching as a value" surfaces from Java 17. All are
// shipped by the cajeta compiler; none require any runtime support.
//
//   - `switch (expr) { case L: ... break; }` is the classic statement
//     form. Fall-through is allowed (drop the `break`); multiple
//     case labels per arm collapse to one body.
//   - `switch (expr) { case L -> value; default -> v; }` is the
//     Java-17 arrow form. Each arm is a single expression; the
//     switch itself is an expression and can be assigned, returned,
//     or embedded in an arithmetic expression.
//   - `cond ? then : else` is the classic ternary; both branches
//     are full expressions, only the selected side's side-effects
//     run, and type coercion (int → float) follows the wider
//     branch.
//   - `v instanceof T` is a static-type match against `v`'s
//     resolved type — `true` when the static type IS T, `false`
//     otherwise. v1 doesn't yet walk the runtime class hierarchy
//     for class types; the test suite pins the current semantics.

public class SwitchTernaryDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Switch / ternary / instanceof --");

        this.switchStatement();
        this.switchExpression();
        this.ternary();
        this.instanceOf();
    }

    // 1. Classic switch statement. Cases with no body fall through
    // to the next case's body — `case 1: case 2:` runs the same
    // arm. The default catches everything not enumerated above.
    public void switchStatement() {
        int32 result = 0;
        int32 day = 3;
        switch (day) {
            case 1:
                result = 10;
                break;
            case 2: case 3:    // multi-label fall-through
                result = 23;
                break;
            case 4:
                result = 40;
                break;
            default:
                result = 99;
                break;
        }
        System.stdout.println("  statement switch(3) = " + result
            + "  (case 2/3 fall-through arm)");
    }

    // 2. Switch expression — arrow form. Each arm is a single
    // expression; the switch is itself an expression and can be
    // assigned, returned, or embedded.
    public void switchExpression() {
        int32 code = 2;

        // Direct assignment.
        int32 r = switch (code) {
            case 1 -> 100;
            case 2 -> 200;
            case 3 -> 300;
            default -> -1;
        };
        System.stdout.println("  expr switch(2) = " + r);

        // Multi-label single arm.
        int32 grouped = switch (code) {
            case 1, 2, 3 -> 50;
            default -> 0;
        };
        System.stdout.println("  expr switch(2) via case 1,2,3 = " + grouped);

        // Embedded — the switch result participates in surrounding
        // arithmetic. The compiler tracks the phi-node value type so
        // this composes cleanly.
        int32 sum = 1000 + switch (code) {
            case 1 -> 5;
            case 2 -> 7;
            default -> 0;
        };
        System.stdout.println("  1000 + expr switch(2) = " + sum);
    }

    // 3. Ternary expression. Only the selected branch's side
    // effects run; type coercion picks the wider of the two branch
    // types.
    public void ternary() {
        // Simple selection.
        int32 a = 5;
        int32 b = 10;
        int32 minAb = a < b ? a : b;
        System.stdout.println("  min(5, 10) via ternary  = " + minAb);

        // Nested — min of three values.
        int32 c = 3;
        int32 d = 8;
        int32 e = 6;
        int32 minThree = c < d ? (c < e ? c : e) : (d < e ? d : e);
        System.stdout.println("  min(3, 8, 6) via nested ternary = " + minThree);

        // Side-effect on selected branch only. Both arms here are
        // assignments; pick = true so only the first runs.
        int32 x = 0;
        boolean pick = true;
        int32 dummy = pick ? (x = 100) : (x = 200);
        System.stdout.println("  side-effect on true branch: x = " + x);

        // Mixed-type branches — the wider type wins.
        boolean cond = false;
        float64 mixed = cond ? 1.5 : 2;
        System.stdout.println("  cond=false ? 1.5 : 2 (coerced f64) = " + mixed);
    }

    // 4. instanceof — static-type match against the operand's
    // resolved type. Returns a boolean usable in any boolean
    // context.
    public void instanceOf() {
        int32 i = 5;
        boolean isInt32 = i instanceof int32;
        boolean isFloat64 = i instanceof float64;
        System.stdout.println("  (int32 5) instanceof int32   = " + isInt32);
        System.stdout.println("  (int32 5) instanceof float64 = " + isFloat64);

        // Composable with ternary.
        float64 pi = 3.14;
        String tag = pi instanceof float64 ? "f64" : "other";
        System.stdout.println("  pi instanceof float64 ? \"f64\" : \"other\" = "
            + tag);
    }
}
