package tour.math;

import tour.DemoClass;
import cajeta.lang.Math;
import cajeta.math.Tensor;
import cajeta.math.linalg.LinAlg;

// cajeta.math.linalg.LinAlg — factorizations and solvers, NATIVE cajeta over
// the Tensor core (no foreign BLAS/LAPACK). Matrices are 2-D row-major
// Tensor<E> with E Floating. This demo verifies each factorization by its
// defining property on a tiny matrix:
//
//   * solve/det — Gaussian elimination with partial pivoting.
//   * lu        — A == P.L.U (L unit lower, U upper, P a permutation).
//   * qr        — A == Q.R with Q's columns orthonormal (Qt.Q == I).
//
// Reconstruction uses Tensor.matmul and an elementwise tolerance sweep.
public class LinAlgDemo extends DemoClass {
    static boolean close(float32 a, float32 b) {
        float32 d = Math.abs(a - b);
        return d < 0.001f;
    }

    // Every element of x equals the corresponding element of y (2-D, same shape).
    static boolean sameMatrix(Tensor<float32> x, Tensor<float32> y) {
        int64 rows = x.shapeAt(0);
        int64 cols = x.shapeAt(1);
        boolean ok = true;
        int64 r = 0;
        while (r < rows) {
            int64 c = 0;
            while (c < cols) {
                if (!close(x.get2(r, c), y.get2(r, c))) { ok = false; }
                c = c + 1;
            }
            r = r + 1;
        }
        return ok;
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- cajeta.math.linalg (solve / LU / QR, reconstruction) --");

        // A = [[3,1],[1,2]] — well-conditioned, det = 5.
        float32[] ad = [3.0f, 1.0f, 1.0f, 2.0f];
        int64[] s22 = heap int64[2];
        s22[0] = 2;
        s22[1] = 2;
        Tensor<float32> a = Tensor.of<float32>(ad, s22);

        // solve: 3x + y = 9, x + 2y = 8  ->  x = 2, y = 3.
        float32[] bd = [9.0f, 8.0f];
        int64[] s2 = heap int64[1];
        s2[0] = 2;
        Tensor<float32> b = Tensor.of<float32>(bd, s2);
        Tensor<float32> x = LinAlg.solve<float32>(a, b);
        System.stdout.println("  solve([[3,1],[1,2]], [9,8]) = ("
            + (int32)(x.get1(0) + 0.5f) + ", " + (int32)(x.get1(1) + 0.5f)
            + ")   (expect (2, 3))");
        this.check(close(x.get1(0), 2.0f) && close(x.get1(1), 3.0f),
            "solve(A, [9,8]) == [2, 3]");
        float32 det = LinAlg.det<float32>(a);
        this.check(close(det, 5.0f), "det(A) == 5");

        // LU with partial pivoting: reconstruct A = P.L.U.
        Tensor<float32>[] plu = LinAlg.lu<float32>(a);
        Tensor<float32> pl = Tensor.matmul<float32>(plu[0], plu[1]);
        Tensor<float32> luRec = Tensor.matmul<float32>(pl, plu[2]);
        this.check(sameMatrix(luRec, a), "LU: P.L.U reconstructs A");
        this.check(close(plu[1].get2(0, 0), 1.0f) && close(plu[1].get2(1, 1), 1.0f)
            && close(plu[1].get2(0, 1), 0.0f), "LU: L is unit lower-triangular");
        this.check(close(plu[2].get2(1, 0), 0.0f), "LU: U is upper-triangular");

        // QR (modified Gram-Schmidt): reconstruct A = Q.R, and Qt.Q == I.
        Tensor<float32>[] qr = LinAlg.qr<float32>(a);
        Tensor<float32> qrRec = Tensor.matmul<float32>(qr[0], qr[1]);
        this.check(sameMatrix(qrRec, a), "QR: Q.R reconstructs A");
        Tensor<float32> qtView = qr[0].transpose();
        Tensor<float32> qt = qtView.copy();
        Tensor<float32> qtq = Tensor.matmul<float32>(qt, qr[0]);
        Tensor<float32> eye = Tensor.eye<float32>(2);
        this.check(sameMatrix(qtq, eye), "QR: Qt.Q == I (orthonormal columns)");

        // inv: A.inv(A) == I closes the loop through the same machinery.
        Tensor<float32> ai = LinAlg.inv<float32>(a);
        Tensor<float32> aai = Tensor.matmul<float32>(a, ai);
        this.check(sameMatrix(aai, eye), "inv: A.inv(A) == I");
    }
}
