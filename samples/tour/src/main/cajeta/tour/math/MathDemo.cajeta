package tour.math;

import tour.DemoClass;
import cajeta.lang.Math;

// `Math.max` / `min` / `clamp` are method-level templates — each
// monomorphizes per T at the call site with zero dispatch cost.
// `Math.max(3, 7)` produces a max<int32>; `Math.max(1.5, 2.5)` a
// max<float64>. Primitives only for v1.
//
// The values are real ones: clamping an audio gain into its legal range
// and capping a retry backoff — the two places clamp shows up first in
// any service.
public class MathDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Math --");

        // A user-supplied gain slider must land in [0, 100] percent.
        int32 tooLoud = Math.clamp(150, 0, 100);
        int32 tooQuiet = Math.clamp(-20, 0, 100);
        int32 fine = Math.clamp(65, 0, 100);
        System.stdout.println("  gain 150% -> " + tooLoud
            + ", -20% -> " + tooQuiet + ", 65% -> " + fine);
        this.check(tooLoud == 100 && tooQuiet == 0 && fine == 65,
            "clamp pins both bounds, passes in-range through");

        // Exponential backoff capped at 30 s: min(2^attempt, 30).
        int32 attempt4 = Math.min(16, 30);      // 2^4
        int32 attempt6 = Math.min(64, 30);      // 2^6 hits the cap
        this.check(attempt4 == 16 && attempt6 == 30,
            "min caps the backoff curve");

        // Same templates at float64 — a fresh monomorphization, same code.
        float64 worst = Math.max(0.87, 0.91);
        this.check(worst == 0.91, "max<float64> picks the worse p99");
    }
}
