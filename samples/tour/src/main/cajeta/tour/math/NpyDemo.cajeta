package tour.math;

import tour.DemoClass;
import cajeta.math.Tensor;
import cajeta.math.npio.Npy;
import cajeta.io.file.Path;

// cajeta.math.npio.Npy — NumPy .npy binary array I/O (format v1.0: the
// \x93NUMPY magic, an ASCII dict header padded to a 64-byte boundary, then
// raw little-endian element bytes in C-order). Statically typed, so each
// dtype has its own save/load pair: saveF32/loadF32 ('<f4'), plus f64/i32/
// i64. Float bytes are bit-exact reinterpretations (no value conversion),
// so a write/read round-trip reproduces every element EXACTLY — the file
// is directly np.load-able from Python and vice versa.
public class NpyDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- cajeta.math.npio (.npy write / read-back) --");

        String path = "/tmp/tour-npy-demo.npy";

        // A (2,3) float32 tensor with awkward (exactly representable) values.
        float32[] data = [1.5f, -2.25f, 3.0f, 0.5f, 7.75f, -0.125f];
        int64[] s23 = heap int64[2];
        s23[0] = 2;
        s23[1] = 3;
        Tensor<float32> t #= Tensor.of<float32>(data, s23);

        // Write, then confirm the file landed.
        Npy.saveF32(path, t);
        Path p #= Path.of(path);
        this.check(p.exists(), ".npy file written under /tmp");

        // Read it back: shape and dtype come from the parsed header.
        Tensor<float32> r #= Npy.loadF32(path);
        this.check(r.ndim() == 2 && r.shapeAt(0) == 2 && r.shapeAt(1) == 3,
            "loaded shape == (2, 3)");

        // Bit-exact round-trip: every element identical, no tolerance needed.
        boolean same = true;
        int64 i = 0;
        while (i < 2) {
            int64 j = 0;
            while (j < 3) {
                if (r.get2(i, j) != t.get2(i, j)) { same = false; }
                j = j + 1;
            }
            i = i + 1;
        }
        this.check(same, "float32 round-trip is bit-exact");
        System.stdout.println("  saved (2,3) f32 -> " + path
            + " -> loaded back, elements identical");

        // int64 pair too: a 1-D '<i8' round-trip.
        String ipath = "/tmp/tour-npy-demo-i64.npy";
        int64[] s4 = heap int64[1];
        s4[0] = 4;
        Tensor<int64> it #= Tensor.zeros<int64>(s4);
        it.set1(0, -1);
        it.set1(1, 0);
        it.set1(2, 123456789012345);
        it.set1(3, 42);
        Npy.saveI64(ipath, it);
        Tensor<int64> ir #= Npy.loadI64(ipath);
        this.check(ir.size() == 4 && ir.get1(0) == -1
            && ir.get1(2) == 123456789012345 && ir.get1(3) == 42,
            "int64 round-trip preserves 8-byte values");

        // Clean up both files; the tour leaves no droppings.
        p.delete();
        Path ip #= Path.of(ipath);
        ip.delete();
        this.check(!p.exists() && !ip.exists(), "temp .npy files deleted");
    }
}
