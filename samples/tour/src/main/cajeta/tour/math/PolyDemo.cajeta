package tour.math;

import tour.DemoClass;
import cajeta.math.Tensor;
import cajeta.math.poly.Poly;

// cajeta.math.poly.Poly — polynomial operations over 1-D coefficient
// tensors in NUMPY ORDER: highest degree first, so [2, 3, 1] is
// 2x^2 + 3x + 1. The shipped surface is polyval (Horner evaluation),
// polyadd (degree-aligned sum) and polymul (coefficient convolution);
// root-finding/fitting build on the linalg tier and are deferred.
public class PolyDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- cajeta.math.poly (polyval / polyadd / polymul) --");

        // polyval via Horner: p(x) = 2x^2 + 3x + 1 at x = 2 is 8+6+1 = 15,
        // and p(0) is the constant term.
        int32[] pc = {2, 3, 1};
        int64[] s3 = heap int64[1];
        s3[0] = 3;
        Tensor<int32> p = Tensor.of<int32>(pc, s3);
        int32 at2 = Poly.polyval<int32>(p, 2);
        int32 at0 = Poly.polyval<int32>(p, 0);
        System.stdout.println("  p(x) = 2x^2+3x+1:  p(2) = " + at2
            + "  p(0) = " + at0 + "   (expect 15, 1)");
        this.check(at2 == 15, "polyval(2x^2+3x+1, 2) == 15");
        this.check(at0 == 1, "polyval at 0 is the constant term");

        // polyadd aligns by DEGREE (the shorter is padded on the high end):
        // (x^2 + 2x + 3) + (x + 1) = x^2 + 3x + 4.
        int32[] ac = {1, 2, 3};
        Tensor<int32> a = Tensor.of<int32>(ac, s3);
        int32[] bc = {1, 1};
        int64[] s2 = heap int64[1];
        s2[0] = 2;
        Tensor<int32> b = Tensor.of<int32>(bc, s2);
        Tensor<int32> sum = Poly.polyadd<int32>(a, b);
        this.check(sum.size() == 3, "polyadd result has max(deg) + 1 coefficients");
        this.check(sum.get1(0) == 1 && sum.get1(1) == 3 && sum.get1(2) == 4,
            "(x^2+2x+3) + (x+1) == x^2+3x+4");

        // polymul is convolution: (x + 1)(x - 1) = x^2 - 1.
        int32[] cc = {1, 1};
        Tensor<int32> c = Tensor.of<int32>(cc, s2);
        int32[] dc = {1, -1};
        Tensor<int32> d = Tensor.of<int32>(dc, s2);
        Tensor<int32> prod = Poly.polymul<int32>(c, d);
        this.check(prod.size() == 3, "polymul result length == la + lb - 1");
        this.check(prod.get1(0) == 1 && prod.get1(1) == 0 && prod.get1(2) == -1,
            "(x+1)(x-1) == x^2 - 1");

        // The identities agree through polyval: evaluating the product at
        // x = 3 matches (3+1)*(3-1) = 8.
        int32 pv = Poly.polyval<int32>(prod, 3);
        this.check(pv == 8, "polyval(polymul(c, d), 3) == polyval(c,3)*polyval(d,3)");
    }
}
