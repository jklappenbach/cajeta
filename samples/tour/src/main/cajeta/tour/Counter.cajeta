package tour;

// Simple mutable counter — captured by closures in demoLambdas, used
// directly in demoClasses to show field state survives method calls.
//
// Carries a couple of neutral annotations (`@Tracked`, `@Metric`, `@Mutates`)
// purely so ReflectionDemo has something to read back at runtime — they have
// no compiler behavior; any identifier is a valid annotation. Some carry
// arguments (`@Tracked(2)`, `@Metric("count")`) so the demo can show REFL-6b
// reading annotation argument VALUES, not just names.
@Tracked(2)
public class Counter {
    @Metric("count") int32 v;

    public Counter() {
        this.v = 0;
    }

    public void bump() {
        this.v = this.v + 1;
    }

    @Mutates
    public void bumpBy(int32 n) {
        this.v = this.v + n;
    }

    public int32 value() {
        return this.v;
    }
}
