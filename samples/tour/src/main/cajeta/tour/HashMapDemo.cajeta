package tour;

import cajeta.collection.HashMap;

// Open-addressing hash map. Primitive-typed keys lower their `.hash()`
// to a runtime intrinsic — no boxing required. `count()` returns the
// live-entry count (int64).
public class HashMapDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- HashMap --");
        HashMap<int32, int32> map = heap HashMap<int32, int32>(16);
        map.put(1, 100);
        map.put(2, 200);
        map.put(3, 300);
        int32 v2 = map.get(2);
        System.stdout.println("  count    = " + (int32) map.count());
        System.stdout.println("  get(2)   = " + v2);
    }
}
