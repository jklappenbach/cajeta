package tour.collection;

import tour.DemoClass;
import cajeta.collection.ArrayList;
import cajeta.collection.ImmutableList;

// Immutable, index-addressable list. Built once from a mutable
// ArrayList SNAPSHOT; afterwards it has no mutators, so it can be
// shared freely without defensive copies. `get(i)` is O(1).
//
// The scenario: a service freezes its fallback-endpoint order at
// startup. The frozen copy is what makes sharing safe — later edits to
// the source list must NOT reach it, and that property is the check.
public class ImmutableListDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- ImmutableList --");

        ArrayList<int32> ports = heap ArrayList<int32>();
        ports.add(8080);
        ports.add(8081);
        ports.add(9090);

        ImmutableList<int32> frozen = heap ImmutableList<int32>(ports);
        System.stdout.println("  frozen " + (int32) frozen.count()
            + " fallback ports; first = " + frozen.get(0));
        this.check((int32) frozen.count() == 3 && frozen.get(0) == 8080
            && frozen.contains(9090), "snapshot captures the startup order");

        // The property that earns the name: mutating the SOURCE after the
        // freeze changes nothing in the snapshot.
        ports.add(6666);
        ports[0] = 1;
        this.check((int32) frozen.count() == 3 && frozen.get(0) == 8080
            && !frozen.contains(6666),
            "source edits never reach the frozen copy");
    }
}
