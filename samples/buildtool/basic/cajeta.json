{
    // Single-package starter — what `cajeta init` writes by default
    // (per BuildTool.md "Default cajeta init manifest").

    "details": {
        "name":               "com.example.basic",
        "version":            "0.1.0",
        "description":        "Single-package buildtool sample",
        "license":            "Apache-2.0",
        "authors":            ["sample"],
        "cajeta-lang-version": "1.0"
    },

    "properties": {
        // Centralize repeated values here. ${stack-version} below
        // demonstrates the substitution mechanism.
        "stack-version": "1.0.0"
    },

    "settings": {
        "capabilities": ["filesystem", "clock"],

        // First-party plugins (`cajeta.*`) get a wider default
        // allowlist; user plugins fall back to ["filesystem"].
        // Override here when a project pulls in plugins that need
        // additional capabilities.
        "plugins-allowed-capabilities": ["filesystem"],

        // Third-party runtime dependencies go here. The core standard
        // library (cajeta.lang, cajeta.io, cajeta.codec, …, cajeta.xpu) is
        // built into the toolchain — neither declared nor fetched — and only
        // the parts your code actually uses are linked into the binary
        // (dead-code elimination). The stdlib API level is pinned by
        // `details.cajeta-lang-version` above.
        "dependencies": {},

        "dev-dependencies": {
            "cajeta.testkit": "1.0.*"
        },

        // First-party lint + coverage plugins. Optional — comment
        // out when not in use; `lint` + `test` tasks fall back to
        // native-only actions.
        "plugins": {
            "cajeta.lint.security": "1.0.*",
            "cajeta.coverage":      "1.0.*"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "target":       "host",
            "entry-method": "com.example.basic.Main::main"
        }
    },

    "tasks": {

        // ─── Starter build tasks ────────────────────────────────────
        // Each task carries its own profile + flavor literals.
        // Profile names are arbitrary; rename to match your envs.

        "build": {
            "description": "Local development build",
            "params": {
                "profile": { "type": "string", "default": "dev" }
            },
            "actions": [
                { "action":  "build",
                  "flavor":  "debug",
                  "profile": "${params.profile}",
                  "id":      "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Unit tests with coverage instrumentation",
            "actions": [
                { "action":  "build",
                  "flavor":  "debug",
                  "profile": "test",
                  "id":      "art" },

                // Instrument the build for coverage. The plugin
                // emits a probed binary + records the map file path
                // its `collect` action will write to.
                { "action":  "cajeta.coverage.instrument",
                  "params":  { "input": "${art.path}" },
                  "id":      "instr" },

                // Run the (probed) tests; on success the coverage
                // map is read + gated by `min` / `min-per-file`.
                // Reports land in build/reports/.
                { "action":  "test",
                  "params": {
                      "input": "${instr.path}",
                      "coverage": {
                          "map":          "${workdir}/build/cov.map",
                          "min":           80,
                          "min-per-file":  50,
                          "exclude":       ["test/**", "**/fixtures/**"],
                          "report": {
                              "console": "${workdir}/build/reports/cov.txt",
                              "html":    "${workdir}/build/reports/cov.html",
                              "sarif":   "${workdir}/build/reports/cov.sarif"
                          }
                      }
                  } }
            ]
        },

        "release": {
            "description": "Release build + ship",
            "actions": [
                { "action":  "build",
                  "flavor":  "release",
                  "profile": "release",
                  "id":      "art" },
                { "action": "exec", "command": "echo",
                  "args":   ["[release] would sign + publish ${art.path}"] }
            ]
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        },

        // ─── Default `lint` task ────────────────────────────────────
        // Wires native + plugin actions into one task. Findings from
        // every action stream into ActionResult.findings; the task
        // runner aggregates them across actions into one unified
        // report. Native actions for the language-level lint live
        // alongside `cajeta.lint.security` (banned-imports +
        // secret-pattern scan).
        //
        // Override at the project level to add custom rule sets, or
        // delete + replace if you only want one of the two pillars.
        "lint": {
            "description": "Run native + plugin lint actions",
            "actions": [
                // Native compiler lint pass — shape pinned by the
                // language; here we just route to the `exec` action
                // with the lint subcommand so projects without the
                // plugin still get a useful baseline.
                { "action":  "exec",
                  "command": "cajeta",
                  "args":    ["lint", "--manifest", "${cajeta.json}"],
                  "id":      "native" },

                // First-party security plugin — banned-imports +
                // secret-pattern scan. Findings carry through the
                // typed ActionResult.findings channel.
                { "action":  "cajeta.lint.security.scan",
                  "params":  { "target-dir": "${workdir}/src" },
                  "id":      "sec" }
            ]
        }
    }
}
