{
    // The benchmark reference's harness project for the language + stdlib
    // catalog (specs/benchmark-reference-spec.md §2.1), built with the cajeta
    // build tool. Formerly samples/profile.
    //   cajeta.json                                 ← this manifest
    //   src/main/cajeta/bench/<package>/*Bench.cajeta ← one directory per catalog package
    //   src/main/cajeta/bench/Bench.cajeta          ← entry: registers every benchmark
    //   build/bench                                 ← built binary (gitignored)
    //
    // The compiler is <repo>/build/src/cajeta (scripts default to it; override
    // with CAJETA=). Build + run from this directory:
    //   cajeta release   → build/bench (what bench.sh and the smokes use)
    //   cajeta run       → debug build + execute (what run.sh does)
    //   cajeta clean     → wipe build/

    "details": {
        "name":                "bench",
        "version":             "0.1.0",
        "description":         "Cajeta benchmark reference — language and stdlib catalog",
        "license":             "Apache-2.0",
        "authors":             ["cajeta"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The four capabilities are dev.cajeta.bench's own: it times trials
        // (clock), writes the CSVs and reads /proc and /etc/os-release
        // (filesystem), reads CAJETA_BENCH_* and the benchmarks' PROFILE_DATA_DIR
        // (env), and runs nvidia-smi / hipconfig / vulkaninfo to record the
        // driver (process). The core stdlib is built into the toolchain and
        // dead-code-eliminated to what the benchmarks use.
        "capabilities": ["filesystem", "clock", "env", "process"],
        // The harness: Benchmark, Harness, the CSV schema (v2) and BenchMain,
        // the shared --list / --run / --area / --bench / --out command line.
        // dev.cajeta.codec: the pure-cajeta DEFLATE stream that wire/
        // compressstream-roundtrip measures cajeta.wire.CompressStream through
        // (the stdlib ships the interface only).
        "dependencies": { "dev.cajeta.bench": "0.1.5", "dev.cajeta.codec": "0.9.1" },

        "build": {
            "source-root":  "src/main/cajeta",
            "target":       "host",
            "entry-method": "bench.Bench::main"
        }
    },

    "tasks": {

        // output-path puts the binary at build/bench rather than the
        // default build/exe/<name>: the project name `bench` matches the
        // top-level package `bench`, so the default would collide with the
        // build/exe/bench/ object directory (same reasoning as the tour).
        "build": {
            "description": "Build the bench harness to a native binary (build/bench)",
            "actions": [
                // xpu-backend=cpu so the MatMulBench @Kernel matmul compiles +
                // registers for the CPU kernel-pool dispatcher (else .launch
                // finds no registered kernel and silently skips).
                { "action": "build",
                  "flavor": { "base": "debug", "xpu-backend": "cpu" },
                  "output-path": "build/bench", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "run": {
            "description": "Build the bench harness and run it",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "debug", "xpu-backend": "cpu" },
                  "output-path": "build/bench", "id": "art" },
                // exec does not split its command string: arguments go in args.
                { "action": "exec", "command": "${art.path}",
                  "args": ["--run", "--out", "build/results.csv"] }
            ]
        },

        "release": {
            "description": "Optimized release build of the bench harness",
            "actions": [
                // O3 + host-native CPU (AVX2/FMA on this machine) so the Cajeta
                // benchmarks compete on the same footing as the competitors'
                // `-O3 -march=native` / `target-cpu=native` builds, instead of
                // the default release flavor's O2 + generic-baseline x86-64.
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "cpu" },
                  "output-path": "build/bench", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        // bench/lang/Loops.md, lang/loop-counted-nobounds: the release build
        // above has bounds-check off (the release flavor's default), so its
        // row is the bounds-off variant; this build is the same program with
        // the compiler's bounds checks on, and its binary name is what
        // LoopsBench reads to label the bounds-on variant.
        "release-bounds-on": {
            "description": "Release build with bounds-check on (build/bench-bounds-on): the bounds-on variant of lang/loop-counted-nobounds",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "cpu", "bounds-check": "on" },
                  "output-path": "build/bench-bounds-on", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        // bench/lang/Allocation.md, lang/alloc-live-set-on and -off: the same
        // program under the two live-allocation-set modes. "on" is bounded,
        // the release mode's set; "off" registers nothing. AllocBench measures
        // which one it was built with (Cajeta.liveCount() across one heap
        // allocation) and names its row from that. The flavor key needs a
        // compiler with `live-set` in its flavor vocabulary.
        "release-live-set-on": {
            "description": "Release build with --live-set=bounded (build/bench-live-set-on): lang/alloc-live-set-on",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "cpu", "live-set": "bounded" },
                  "output-path": "build/bench-live-set-on", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "release-live-set-off": {
            "description": "Release build with --live-set=off (build/bench-live-set-off): lang/alloc-live-set-off",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "cpu", "live-set": "off" },
                  "output-path": "build/bench-live-set-off", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        // Proton (Radeon 8060S, gfx1151, ROCm). amdgpu + cpu in one binary,
        // like gpu-nvptx and gpu-vulkan; the backend is chosen at run time with
        // CAJETA_XPU_BACKEND=hip (or =cpu). Replaces the retired `gpu` task
        // (amdgpu only, output build/bench-gpu), which predates the xpu/
        // catalog. Output build/bench-amdgpu.
        "gpu-amdgpu": {
            "description": "Release build with the amdgpu (gfx1151, Proton) and cpu XPU backends for the xpu/ and gfx/ @Kernel benchmarks; run with CAJETA_XPU_BACKEND=hip (or cpu). Output build/bench-amdgpu.",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "amdgpu,cpu", "xpu-arch": "gfx1151" },
                  "output-path": "build/bench-amdgpu", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        // Phoenix (RTX 4090, sm_89, CUDA 13.3 under WSL2). nvptx + cpu in one
        // binary; the backend is chosen at run time with CAJETA_XPU_BACKEND=cuda
        // or =cpu. ptxas comes from $CUDA_PATH/bin (set CUDA_PATH=/usr/local/cuda:
        // CUDA 12.0's ptxas miscompiles spilled cooperative-matrix tiles, and the
        // compiler refuses anything below 12.1). Output build/bench-nvptx.
        "gpu-nvptx": {
            "description": "Release build with the nvptx (sm_89, Phoenix) and cpu XPU backends for the xpu/ and gfx/ @Kernel benchmarks; run with CAJETA_XPU_BACKEND=cuda (or cpu). Needs CUDA_PATH=/usr/local/cuda for ptxas >= 12.1. Output build/bench-nvptx.",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "nvptx,cpu", "xpu-arch": "sm_89" },
                  "output-path": "build/bench-nvptx", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        // Vulkan through the cajeta-llvm fork's SPIR-V path (vulkan1.3 env, the
        // vulkan default), plus cpu. Run with CAJETA_XPU_BACKEND=vulkan (or cpu).
        // Phoenix (NVIDIA under WSL2's dozen/NVIDIA ICD) and Proton (RADV).
        "gpu-vulkan": {
            "description": "Release build with the vulkan (SPIR-V, vulkan1.3) and cpu XPU backends for the xpu/ and gfx/ @Kernel benchmarks; run with CAJETA_XPU_BACKEND=vulkan (or cpu). Output build/bench-vulkan.",
            "actions": [
                { "action": "build",
                  "flavor": { "base": "release", "opt": "O3", "cpu": "native",
                              "xpu-backend": "vulkan,cpu" },
                  "output-path": "build/bench-vulkan", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
