# Build output (also covered by the repo-root .gitignore).
build/
# Fetched datasets (content-addressed cache). Local run outputs land in
# build/results/; results/<machine>/<run-id>/ is committed (spec §4).
datasets/cache/
# Vendored suite clones (cloned on demand; the .lock + manifest stay tracked).
competitors/vendor/*/
# Competitor build artifacts (toolchain-local; regenerated by competitors/<area>.sh).
competitors/python/.venv/
competitors/**/target/
competitors/**/go.sum
competitors/**/*.class
competitors/.build/
cajeta.lock
