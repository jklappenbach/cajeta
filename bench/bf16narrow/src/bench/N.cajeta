package bench;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;

// The cost of an exact float32-to-bf16 narrowing on the cpu backend
// (bf16-cast-denormals 1.3.2). Built by a compiler on cajeta-llvm r12 (v0.53.11), an
// AVX512-BF16 CPU narrows with vcvtneps2bf16, which flushes denormals; on r13 (main)
// it rounds exactly with integer instructions, and only the @FastMath kernel keeps
// the instruction. Prints the best time per element of each kernel at two sizes:
// one that fits in L2 (the narrowing's own cost) and one that streams from memory.
public class N {
    @Kernel @Occupancy(maxThreads = 256)
    public static void scalar(KernelBuffer<bfloat16> y, KernelBuffer<float32> x, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { y[i] = (bfloat16) x[i]; }
    }
    @Kernel @Occupancy(maxThreads = 256)
    public static void vec(KernelBuffer<bfloat16> y, KernelBuffer<float32> x, uint32 n) {
        uint32 g = KernelThread.globalIdX();
        if (g * 8 < n) {
            Vector<float32,8> v = x.vload<8>((int64) g * 8L);
            y.vstore((int64) g * 8L, v.toBF16());
        }
    }
    @Kernel @FastMath @Occupancy(maxThreads = 256)
    public static void vecFast(KernelBuffer<bfloat16> y, KernelBuffer<float32> x, uint32 n) {
        uint32 g = KernelThread.globalIdX();
        if (g * 8 < n) {
            Vector<float32,8> v = x.vload<8>((int64) g * 8L);
            y.vstore((int64) g * 8L, v.toBF16());
        }
    }

    // The best of `reps` launches of kernel `which` over n elements, in nanoseconds.
    static int64 best(int32 which, uint32 n, int32 reps) {
        float32[] h = heap float32[n];
        for (uint32 i = 0; i < n; i = i + 1) { h[i] = (float32) i * 0.37109375f - 1000.0f; }
        KernelBuffer<float32> x = heap KernelBuffer<float32>((uint64) n);
        KernelBuffer<bfloat16> y = heap KernelBuffer<bfloat16>((uint64) n);
        x.upload(h);
        KernelStream s #= KernelStream.current();
        int64 bestNs = 0L;
        int32 r = 0;
        while (r < reps) {
            int64 t0 = Clock.nanoTime();
            if (which == 0) { scalar.launch(s, grid: [(n + 255) / 256], block: [256])(y, x, n); }
            if (which == 1) { vec.launch(s, grid: [(n / 8 + 255) / 256], block: [256])(y, x, n); }
            if (which == 2) { vecFast.launch(s, grid: [(n / 8 + 255) / 256], block: [256])(y, x, n); }
            s.sync();
            int64 dt = Clock.nanoTime() - t0;
            if (bestNs == 0L || dt < bestNs) { bestNs = dt; }
            r = r + 1;
        }
        return bestNs;
    }

    static void row(String name, int32 which, uint32 n, int32 reps) {
        N.best(which, n, 3);   // warm
        int64 ns = N.best(which, n, reps);
        float64 per = (float64) ns / (float64) n;
        System.stdout.println(name + " n=" + n + " best=" + ns + " ns, " + per + " ns/elem");
    }

    public static int32 main() {
        N.row("scalar ", 0, 262144, 200);
        N.row("vec    ", 1, 262144, 200);
        N.row("vecFast", 2, 262144, 200);
        N.row("scalar ", 0, 16777216, 20);
        N.row("vec    ", 1, 16777216, 20);
        N.row("vecFast", 2, 16777216, 20);
        return 0;
    }
}
