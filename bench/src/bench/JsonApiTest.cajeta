package bench;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import cajeta.codec.json.JsonReader;
import cajeta.codec.json.JsonHandler;
import cajeta.codec.json.JsonSax;
import cajeta.codec.json.JsonLinesWriter;

// Handler that pulls only what it needs (lazy): counts keys and sums numbers.
class SumHandler extends JsonHandler {
    public int64 keys; public int64 sum;
    public SumHandler() { this.keys = 0; this.sum = 0; }
    public void onKey(JsonReader r) { this.keys = this.keys + 1; }
    public void onNumber(JsonReader r) { this.sum = this.sum + 1; }
}

public final class JsonApiTest {
    public static int32 run() {
        // 1) SAX parse via the stdlib JsonHandler/JsonSax
        int8[] b = File.readAllBytes("/tmp/jsonbench/twitter.json");
        int64 n = (int64) b.count();
        SumHandler h = heap SumHandler();
        JsonSax.parse(b, n, h);
        System.stdout.println("SAX: keys=" + h.keys + " (expect 13345)");

        // 2) JSONL round-trip via JsonLinesWriter
        FileWriter fw = File.openWrite("/tmp/jsonbench/out.jsonl", OpenMode.WRITE);
        JsonLinesWriter jl = heap JsonLinesWriter(fw);
        jl.beginObject().key("level").writeString("INFO").key("seq").writeNumber((int64) 1).endObject().endLine();
        jl.beginObject().key("level").writeString("WARN").key("seq").writeNumber((int64) 2).endObject().endLine();
        jl.flush();
        fw.close();

        int8[] rb = File.readAllBytes("/tmp/jsonbench/out.jsonl");
        System.stdout.println("JSONL bytes read back: " + rb.count());
        return 0;
    }
}
