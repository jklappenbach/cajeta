package bench;
import cajeta.io.file.File;
import cajeta.codec.json.JsonReader;
import cajeta.codec.json.JsonToken;
public final class Emit {
    // counts[0..8] = SO EO SA EA KEY STRING NUMBER BOOL NULL
    static void scalarEmit(int8[] b, int64 n, int64[] counts) {
        int8[] frame = heap int8[1024];
        int8[] expectKey = heap int8[1024];
        int32 depth = 0; boolean inStr = false; boolean prevVal = false; int64 i = 0;
        while (i < n) {
            int8 c = b[i];
            if (inStr) {
                if (c == (int8)92) { i = i + 2; continue; }
                if (c == (int8)34) { inStr = false; }
                i = i + 1; continue;
            }
            boolean isWs = c==(int8)32||c==(int8)9||c==(int8)10||c==(int8)13;
            if (c == (int8)34) {
                boolean isKey = depth > 0 && frame[depth-1]==(int8)1 && expectKey[depth-1]==(int8)1;
                if (isKey) { counts[4]=counts[4]+1; expectKey[depth-1]=(int8)0; }
                else { counts[5]=counts[5]+1; }
                inStr = true; prevVal = false;
            } else if (c == (int8)123) { counts[0]=counts[0]+1; frame[depth]=(int8)1; expectKey[depth]=(int8)1; depth=depth+1; prevVal=false; }
            else if (c == (int8)91) { counts[2]=counts[2]+1; frame[depth]=(int8)0; depth=depth+1; prevVal=false; }
            else if (c == (int8)125) { counts[1]=counts[1]+1; depth=depth-1; prevVal=false; }
            else if (c == (int8)93) { counts[3]=counts[3]+1; depth=depth-1; prevVal=false; }
            else if (c == (int8)58) { prevVal=false; }
            else if (c == (int8)44) { if (depth>0 && frame[depth-1]==(int8)1) { expectKey[depth-1]=(int8)1; } prevVal=false; }
            else if (isWs) { prevVal=false; }
            else {
                if (!prevVal) {
                    if (c==(int8)116 || c==(int8)102) { counts[7]=counts[7]+1; }
                    else if (c==(int8)110) { counts[8]=counts[8]+1; }
                    else { counts[6]=counts[6]+1; }
                }
                prevVal=true;
            }
            i = i + 1;
        }
    }
    static void readerCounts(int8[] b, int64 n, int64[] counts) {
        JsonReader r = heap JsonReader(b, n);
        JsonToken t = r.next();
        while (t != JsonToken.END) {
            if (t == JsonToken.START_OBJECT) { counts[0]=counts[0]+1; }
            else if (t == JsonToken.END_OBJECT) { counts[1]=counts[1]+1; }
            else if (t == JsonToken.START_ARRAY) { counts[2]=counts[2]+1; }
            else if (t == JsonToken.END_ARRAY) { counts[3]=counts[3]+1; }
            else if (t == JsonToken.KEY) { counts[4]=counts[4]+1; }
            else if (t == JsonToken.STRING) { counts[5]=counts[5]+1; }
            else if (t == JsonToken.NUMBER) { counts[6]=counts[6]+1; }
            else if (t == JsonToken.BOOLEAN) { counts[7]=counts[7]+1; }
            else if (t == JsonToken.NULL) { counts[8]=counts[8]+1; }
            t = r.next();
        }
    }
    static void check(String path, String name) {
        int8[] b = File.readAllBytes(path);
        int64 n = (int64) b.count();
        int64[] e = heap int64[9]; int64[] r = heap int64[9];
        scalarEmit(b, n, e); readerCounts(b, n, r);
        boolean ok = true; int32 i = 0;
        while (i < 9) { if (e[i] != r[i]) { ok = false; } i = i + 1; }
        System.stdout.println(name + ": SO=" + e[0] + " EO=" + e[1] + " SA=" + e[2] + " EA=" + e[3]
            + " KEY=" + e[4] + " STR=" + e[5] + " NUM=" + e[6] + " BOOL=" + e[7] + " NULL=" + e[8]
            + (ok ? "  == reader" : "  MISMATCH reader(KEY=" + r[4] + " STR=" + r[5] + " NUM=" + r[6] + ")"));
    }
    public static int32 run() {
        check("/tmp/jsonbench/twitter.json", "twitter");
        check("/tmp/jsonbench/citm_catalog.json", "citm");
        check("/tmp/jsonbench/canada.json", "canada");
        return 0;
    }
}
