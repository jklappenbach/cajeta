package bench.toolchain;

// toolchain/compile-tour-cold (bench/toolchain/Compile.md): `cajeta build` of
// samples/tour with an empty compile cache. Each execution builds its own
// fresh copy of the tour (copied without build/ and .cajeta/, so neither the
// IR cache nor the artifact cache exists); the repo's own tour cache is never
// read or cleared. Check: the built tour runs to "tour complete".
public class CompileTourColdBench extends ToolchainExternal {
    public String root;

    public CompileTourColdBench() {
        super();
        this.root = "";
        this.iterations(1, 5);
        this.timeoutMillis((int64) 3600000);
        this.addNote("cajeta build of samples/tour (its build task: the debug flavor) from a copy with no build/ and no .cajeta/ cache; one fresh copy per execution");
        this.addNote("the release flavor does not link the tour on v0.46.3 (undefined __cajeta_stack_*_drop symbols); so debug");
    }

    public String name() {
        return "compile-tour-cold";
    }

    public String area() {
        return "toolchain";
    }

    public String datasetInfo() {
        return "samples/tour";
    }

    public void prepare(String variant) {
        this.used = 0;
        int32 n = ToolchainSupport.executions(this.warmupIters(), this.measuredIters());
        ToolchainSupport.prep("tour-copies", "" + n);
        String w #= ToolchainSupport.work();
        this.root = w + "/tour-cold";
    }

    public #String[] argvFor(String variant) {
        String c #= ToolchainSupport.cajeta();
        String[] inner = heap String[2];
        inner[0] = "" + c;
        inner[1] = "build";
        return ToolchainSupport.withTime(inner, ".maxrss");
    }

    public void runVariant(String variant, int32 iterations) {
        int32 i = 0;
        while (i < iterations) {
            this.cmdCwd = this.root + "/" + this.used;
            this.execute(variant);
            this.takeRss(this.cmdCwd + "/.maxrss");
            this.used = this.used + 1;
            i = i + 1;
        }
    }

    public int64 measuredPeakRssKb() {
        return this.maxRss;
    }

    public boolean checkResult() {
        if (this.lastExitCode != 0 || this.used == 0) {
            return false;
        }
        String bin = this.root + "/" + (this.used - 1) + "/build/tour";
        String out #= ToolchainSupport.output1(bin, (int64) 300000);
        return out.contains("tour complete");
    }
}
