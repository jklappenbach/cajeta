package bench.hash;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every hash/ benchmark, in catalog order. A unit adds a hash/
// benchmark by writing the class in this directory and one `b.add(heap X());`
// line here; Bench.cajeta calls this and is never edited for it.
public final class HashRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap XXHash3Bench());
        b.add(heap XXHash3_256kBench());
        b.add(heap XXHash3_128Bench());
        b.add(heap XXHash3_128_256kBench());
        b.add(heap SipHashBench());
    }
}
