package bench.hash;

import cajeta.hash.XXHash3;

import dev.cajeta.bench.Benchmark;

// hash/xxhash3_128-256k (bench/hash/XXHash3.md): XXH3-128 of a 256 KB buffer,
// 1e4 times per trial; the buffer and per-hash key are xxhash3-256k's.
// Timed path: XXHash3.hash128Into, which routes > 240 B to the pure-Cajeta
// SIMD long path (hashLong128Into). Check: the XOR of the low and of the high
// halves equal the reference xxHash 0.8.3 values every competitor checks
// (0x4f52c915522f9fe0, 0x3c843c6da63e2dc3; seed 0).
public class XXHash3_128_256kBench extends Benchmark {

    public int8[] data;
    public int8[] digest;
    public int64 len;
    public int32 n;
    public int64 accLow;
    public int64 accHigh;

    public String name() {
        return "xxhash3_128-256k";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 20;
    }

    public String unit() {
        return "MB/s";
    }

    public void setup() {
        this.n = 10000;
        this.len = 262144;
        this.data = heap int8[(int32) this.len];
        this.digest = heap int8[16];
        int32 j = 0;
        int32 m = (int32) this.len;
        while (j < m) {
            this.data[j] = (int8) ((j * 31 + 7) & 0xFF);
            j = j + 1;
        }
    }

    public int64 inputSize() {
        return (int64) this.n * this.len;
    }

    public String competitorNote() {
        return "XXHash3.hash128Into at seed 0 (> 240 B: the pure-Cajeta Vector<int64> long path)";
    }

    public void run(int32 iterations) {
        int64 lo = 0;
        int64 hi = 0;
        int32 i = 0;
        while (i < this.n) {
            Cajeta.storeU64(this.data, 0, (int64) i);
            XXHash3.hash128Into(this.data, this.len, 0, this.digest);
            lo = lo ^ Cajeta.loadU64(this.digest, 0);
            hi = hi ^ Cajeta.loadU64(this.digest, 8);
            i = i + 1;
        }
        this.accLow = lo;
        this.accHigh = hi;
    }

    public boolean checkResult() {
        return this.accLow == 0x4f52c915522f9fe0L && this.accHigh == 0x3c843c6da63e2dc3L;
    }
}
