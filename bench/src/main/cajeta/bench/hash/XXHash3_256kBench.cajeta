package bench.hash;

import cajeta.hash.XXHash3;

import dev.cajeta.bench.Benchmark;

// hash/xxhash3-256k (bench/hash/XXHash3.md): XXH3-64 of a 256 KB buffer, 1e4
// times per trial — L2-resident bandwidth. Byte j = (j*31+7) & 0xFF; before
// hash i the first 8 bytes are set to i little-endian, so no hash can be
// hoisted. Timed path: the pure-Cajeta SIMD long path (XXHash3.hashLong;
// hash() routes > 240 B there but uses the process seed, and hashSeeded
// always takes the @Native reference). Check: the XOR of the 1e4 digests
// equals the reference xxHash 0.8.3 value every competitor checks,
// 0x4f52c915522f9fe0 (seed 0), and the last digest equals the @Native
// reference's.
public class XXHash3_256kBench extends Benchmark {

    public int8[] data;
    public int64 len;
    public int32 n;
    public int64 acc;

    public String name() {
        return "xxhash3-256k";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 20;
    }

    public String unit() {
        return "MB/s";
    }

    public void setup() {
        this.n = 10000;
        this.len = 262144;
        this.data = heap int8[(int32) this.len];
        int32 j = 0;
        int32 m = (int32) this.len;
        while (j < m) {
            this.data[j] = (int8) ((j * 31 + 7) & 0xFF);
            j = j + 1;
        }
    }

    public int64 inputSize() {
        return (int64) this.n * this.len;
    }

    public String competitorNote() {
        return "XXHash3.hashLong (pure-Cajeta Vector<int64> long path) at seed 0";
    }

    public void run(int32 iterations) {
        int64 a = 0;
        int32 i = 0;
        while (i < this.n) {
            Cajeta.storeU64(this.data, 0, (int64) i);
            a = a ^ XXHash3.hashLong(this.data, this.len, 0);
            i = i + 1;
        }
        this.acc = a;
    }

    public boolean checkResult() {
        // data still holds key n-1: the SIMD path must agree with the reference.
        int64 simd = XXHash3.hashLong(this.data, this.len, 0);
        int64 ref = XXHash3.hashSeeded(this.data, this.len, 0);
        return simd == ref && this.acc == 0x4f52c915522f9fe0L;
    }
}
