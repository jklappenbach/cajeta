package bench.hash;

import cajeta.hash.XXHash3;

import dev.cajeta.bench.Benchmark;

// hash/xxhash3_128 (bench/hash/XXHash3.md): XXH3-128 of 32-byte keys, 1e7 per
// trial; the keys are xxhash3's (first 8 bytes = i little-endian). Each
// digest's low and high halves are XORed into two accumulators. Check: both
// equal the reference xxHash 0.8.3 values every competitor checks
// (0x7f4adb2d9f387c7f, 0xb318fb3ec50537ef; seed 0).
public class XXHash3_128Bench extends Benchmark {

    public int8[] key;
    public int8[] digest;   // reused 16-byte digest buffer (no allocation per hash)
    public int32 n;
    public int64 accLow;
    public int64 accHigh;

    public String name() {
        return "xxhash3_128";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public String unit() {
        return "MB/s";
    }

    public void setup() {
        this.n = 10000000;
        this.key = heap int8[32];
        this.digest = heap int8[16];
        int32 j = 0;
        while (j < 32) {
            this.key[j] = (int8) ((j * 31 + 7) & 0xFF);
            j = j + 1;
        }
    }

    public int64 inputSize() {
        return (int64) this.n * 32;
    }

    public String competitorNote() {
        return "XXHash3.hash128Into(key 32 0 out16): inputs <= 240 B go to the @Native xxHash reference";
    }

    public void run(int32 iterations) {
        int64 lo = 0;
        int64 hi = 0;
        int32 i = 0;
        while (i < this.n) {
            Cajeta.storeU64(this.key, 0, (int64) i);
            XXHash3.hash128Into(this.key, 32, 0, this.digest);
            lo = lo ^ Cajeta.loadU64(this.digest, 0);
            hi = hi ^ Cajeta.loadU64(this.digest, 8);
            i = i + 1;
        }
        this.accLow = lo;
        this.accHigh = hi;
    }

    public boolean checkResult() {
        return this.accLow == 0x7f4adb2d9f387c7fL && this.accHigh == 0xb318fb3ec50537efL;
    }
}
