package bench.hash;

import cajeta.hash.XXHash3;

import dev.cajeta.bench.Benchmark;

// hash/xxhash3 (bench/hash/XXHash3.md): XXH3-64 of 32-byte keys, 1e7 per
// trial — the per-key cost a hash map pays. Key i is a 32-byte buffer
// (byte j = (j*31+7) & 0xFF) whose first 8 bytes are i little-endian, so no
// two hashes share an input and none can be hoisted. Every digest is XORed
// into `acc`. Check: acc equals the reference xxHash 0.8.3 value every
// competitor checks, 0x15ae4a024a0e82de (seed 0).
public class XXHash3Bench extends Benchmark {

    public int8[] key;
    public int32 n;
    public int64 acc;

    public String name() {
        return "xxhash3";
    }

    public String area() {
        return "hash";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public String unit() {
        return "MB/s";
    }

    public void setup() {
        this.n = 10000000;
        this.key = heap int8[32];
        int32 j = 0;
        while (j < 32) {
            this.key[j] = (int8) ((j * 31 + 7) & 0xFF);
            j = j + 1;
        }
    }

    public int64 inputSize() {
        return (int64) this.n * 32;
    }

    public String competitorNote() {
        return "XXHash3.hashSeeded(key 32 0): inputs <= 240 B go to the @Native xxHash reference";
    }

    public void run(int32 iterations) {
        int64 a = 0;
        int32 i = 0;
        while (i < this.n) {
            Cajeta.storeU64(this.key, 0, (int64) i);
            a = a ^ XXHash3.hashSeeded(this.key, 32, 0);
            i = i + 1;
        }
        this.acc = a;
    }

    public boolean checkResult() {
        return this.acc == 0x15ae4a024a0e82deL;
    }
}
