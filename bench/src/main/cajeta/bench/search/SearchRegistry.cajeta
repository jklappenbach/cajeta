package bench.search;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every search/ benchmark, in catalog order (the pages of
// bench/search/: distance/Distance, fuzzy/Matcher, ngram/Index). A unit adds a
// search/ benchmark by writing the class in this directory and one
// `b.add(heap X());` line here; Bench.cajeta calls this and is never edited for it.
public final class SearchRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap DistanceBench(false));
        b.add(heap DistanceBench(true));
        b.add(heap FuzzyTopkBench());
        b.add(heap NgramBench(false));
        b.add(heap NgramBench(true));
    }
}
