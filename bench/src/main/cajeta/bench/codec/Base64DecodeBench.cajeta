package bench.codec;

import cajeta.codec.Base64;

import dev.cajeta.bench.Benchmark;

// Base64 decode throughput, 1e3 trials. setup() encodes a 1 MiB buffer once;
// each trial decodes that string. The page's check is equality: after the
// trials one untimed decode is compared byte for byte with the original.
// Self-generating, so it needs no dataset.
public class Base64DecodeBench extends Benchmark {

    public String encoded;
    public int64 origLen;
    public int64 decLen;
    public int8[] orig;

    public String name() {
        return "base64-decode";
    }

    public String area() {
        return "codec";
    }

    public int32 warmupIters() {
        return 20;
    }

    public int32 measuredIters() {
        return 1000;
    }

    public void setup() {
        this.origLen = 1048576;
        int8[] d = heap int8[(int32) this.origLen];
        int32 i = 0;
        int32 n = (int32) this.origLen;
        while (i < n) {
            d[i] = (int8) ((i * 31 + 7) & 0xFF);
            i = i + 1;
        }
        this.encoded #= Base64.encode(d, this.origLen);
        this.orig #= d;
    }

    public int64 inputSize() {
        return this.origLen;
    }

    public void run(int32 iterations) {
        int8[] dec #= Base64.decode(this.encoded);
        this.decLen = (int64) dec.count();
    }

    public String unit() {
        return "MB/s";
    }

    public boolean checkResult() {
        int8[] dec #= Base64.decode(this.encoded);
        return this.decLen == this.origLen && BaseNData.sameBytes(dec, this.orig, this.origLen);
    }
}
