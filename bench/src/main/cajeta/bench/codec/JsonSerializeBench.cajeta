package bench.codec;

import cajeta.collection.ArrayList;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;

import dev.cajeta.bench.Benchmark;

// JSON serialize throughput: the corpus file is parsed to a DOM once, untimed,
// in prepare(); each trial writes that tree back out with Json.toBytes. The
// page's check: after the trials one untimed serialization is re-parsed and
// must carry the corpus's node count (JsonCheck), and the notes record the
// output byte count.
public class JsonSerializeBench extends Benchmark {

    public String path;
    public String variantName;
    public int64 fileBytes;
    public JsonValue tree;
    public int64 outLen;
    public int64 nodes;

    public String name() {
        return "json-serialize";
    }

    public String area() {
        return "codec";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public boolean available() {
        return System.env.get("PROFILE_DATA_DIR") != null;
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("twitter");
        v.add("citm_catalog");
        v.add("canada");
        return v;
    }

    public void prepare(String variant) {
        String dir = System.env.get("PROFILE_DATA_DIR");
        if (dir == null) {
            dir = "datasets/cache";
        }
        this.path = dir + "/" + variant + ".json";
        this.variantName = "" + variant;
        int8[] bytes #= File.readAllBytes(this.path);
        this.fileBytes = (int64) bytes.count();
        JsonValue v #= Json.parse(#bytes, this.fileBytes);
        this.tree #= v;
    }

    public int64 inputSize() {
        return this.fileBytes;
    }

    public String unit() {
        return "MB/s";
    }

    public void runVariant(String variant, int32 iterations) {
        int8[] out #= Json.toBytes(this.tree);
        this.outLen = (int64) out.count();
    }

    public boolean checkResult() {
        int8[] out #= Json.toBytes(this.tree);
        int64 n = (int64) out.count();
        JsonValue back #= Json.parse(#out, n);
        this.nodes = JsonCheck.countNodes(back);
        return this.outLen == n && this.nodes == JsonCheck.expectedNodes(this.variantName);
    }

    public String competitorNote() {
        return "out=" + this.outLen + " bytes; reparsed nodes=" + this.nodes;
    }
}
