package bench.process;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every process/ benchmark, in catalog order (the pages of
// bench/process/: Command, Process). A unit adds a process/ benchmark by
// writing the class in this directory and one `b.add(heap X());` line here;
// Bench.cajeta calls this and is never edited for it.
public final class ProcessRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap CommandSpawnWaitBench());
        b.add(heap ProcessPipeBench());
    }
}
