package bench;

import cajeta.collection.ArrayList;

import bench.harness.Benchmark;
import bench.harness.Harness;
import bench.harness.Result;
import bench.harness.Report;
import bench.harness.Memory;
import bench.selftest.ExampleBenchmark;
import bench.selftest.SumBench;
import bench.selftest.VariantBench;
import bench.lang.StringBuildBench;
import bench.lang.StringSearchBench;
import bench.lang.StringReplaceBench;
import bench.lang.StringUpperBench;
import bench.lang.StreamPipelineBench;
import bench.lang.StreamParallelReduceBench;
import bench.lang.SaxpyBench;
import bench.lang.DotProductBench;
import bench.lang.MandelbrotBench;
import bench.lang.FannkuchBench;
import bench.lang.SpectralNormBench;
import bench.collection.ArrayListAppendBench;
import bench.collection.HashMapIntBench;
import bench.collection.HashMapStringBench;
import bench.collection.HashSetDedupBench;
import bench.collection.LinkedListBench;
import bench.collection.HeapSortBench;
import bench.collection.RedBlackTreeBench;
import bench.collection.SortInt64Bench;
import bench.collection.SortF64Bench;
import bench.collection.SortStableBench;
import bench.collection.BinarySearchBench;
import bench.concurrent.AtomicBench;
import bench.concurrent.TaskSpawnBench;
import bench.time.InstantArithmeticBench;
import bench.time.LocalDateArithmeticBench;
import bench.hash.XXHash3Bench;
import bench.hash.XXHash3_256kBench;
import bench.hash.XXHash3_128Bench;
import bench.hash.XXHash3_128_256kBench;
import bench.hash.SipHashBench;
import bench.codec.JsonTokenizeBench;
import bench.codec.JsonBindBench;
import bench.codec.JsonDomBench;
import bench.codec.JsonSerializeBench;
import bench.codec.JsonRoundtripBench;
import bench.codec.JsonConformanceBench;
import bench.codec.Base64EncodeBench;
import bench.codec.Base64DecodeBench;
import bench.math.ElementAccessBench;
import bench.math.ElementSetBench;
import bench.math.NpyLoadBench;
import bench.math.MatMulBench;
import bench.xpu.GpuMatMulBench;
import bench.xpu.GpuMatMulF16Bench;

// Entry point for the benchmark reference's language + stdlib catalog
// (specs/benchmark-reference-spec.md §2.1). Every benchmark lives under
// bench/<package>/ and its area() is the catalog path "<package>/<slug>", the
// page under bench/<package>/ that carries it.
//
// Adding a benchmark: write a Benchmark subclass in
// src/main/cajeta/bench/<package>/, give it area() = "<package>/<slug>", and
// add one import + one `benchmarks.add(heap X());` line below.
// test/layout_smoke.sh checks all three.
//
// Flags: --list, --run, --selftest, --out <path>, --area <package|package/slug>,
// --bench <name>. Env: CAJETA_BENCH_SMOKE=1 (warmup 1, trials 3, rows tagged
// `smoke`), CAJETA_BENCH_SCAFFOLD=1 (also register the harness's own selftest/
// benchmarks), CAJETA_BENCH_MACHINE (recorded by bench.sh), PROFILE_DATA_DIR,
// PROFILE_RUN_ID.
public final class Bench {

    public static int32 main(String[] args) {
        System.stdout.println("=== Cajeta bench — the benchmark reference ===");

        // Register every benchmark. The list owns each element; the drop
        // chain releases them at scope exit.
        ArrayList<Benchmark> benchmarks = heap ArrayList<Benchmark>();
        // The harness's own scaffold benchmarks (lifecycle order, trial count,
        // variant rows) are not catalog entries; only the harness smokes see them.
        String scaffold = System.env.get("CAJETA_BENCH_SCAFFOLD");
        if (scaffold != null && scaffold.equals("1")) {
            benchmarks.add(heap ExampleBenchmark());
            benchmarks.add(heap SumBench());
            benchmarks.add(heap VariantBench());
        }
        // -- lang/ --
        benchmarks.add(heap StringBuildBench());
        benchmarks.add(heap StringSearchBench());
        benchmarks.add(heap StringReplaceBench());
        benchmarks.add(heap StringUpperBench());
        benchmarks.add(heap StreamPipelineBench());
        benchmarks.add(heap StreamParallelReduceBench());
        benchmarks.add(heap SaxpyBench());
        benchmarks.add(heap DotProductBench());
        benchmarks.add(heap MandelbrotBench());
        benchmarks.add(heap FannkuchBench());
        benchmarks.add(heap SpectralNormBench());
        // -- collection/ --
        benchmarks.add(heap ArrayListAppendBench());
        benchmarks.add(heap HashMapIntBench());
        benchmarks.add(heap HashMapStringBench());
        benchmarks.add(heap HashSetDedupBench());
        benchmarks.add(heap LinkedListBench());
        benchmarks.add(heap HeapSortBench());
        benchmarks.add(heap RedBlackTreeBench());
        benchmarks.add(heap SortInt64Bench());
        benchmarks.add(heap SortF64Bench());
        benchmarks.add(heap SortStableBench());
        benchmarks.add(heap BinarySearchBench());
        // -- concurrent/ --
        benchmarks.add(heap AtomicBench());
        benchmarks.add(heap TaskSpawnBench());
        // -- time/ --
        benchmarks.add(heap InstantArithmeticBench());
        benchmarks.add(heap LocalDateArithmeticBench());
        // -- hash/ --
        benchmarks.add(heap XXHash3Bench());
        benchmarks.add(heap XXHash3_256kBench());
        benchmarks.add(heap XXHash3_128Bench());
        benchmarks.add(heap XXHash3_128_256kBench());
        benchmarks.add(heap SipHashBench());
        // -- codec/ --
        benchmarks.add(heap JsonTokenizeBench());
        benchmarks.add(heap JsonBindBench());
        benchmarks.add(heap JsonDomBench());
        benchmarks.add(heap JsonSerializeBench());
        benchmarks.add(heap JsonRoundtripBench());
        benchmarks.add(heap JsonConformanceBench());
        benchmarks.add(heap Base64EncodeBench());
        benchmarks.add(heap Base64DecodeBench());
        // -- math/ --
        benchmarks.add(heap ElementAccessBench());
        benchmarks.add(heap ElementSetBench());
        benchmarks.add(heap NpyLoadBench());
        benchmarks.add(heap MatMulBench());
        // -- xpu/ --
        benchmarks.add(heap GpuMatMulBench());
        benchmarks.add(heap GpuMatMulF16Bench());

        // Flags: --list, --selftest, --run, --out <path>, and selection by
        // --area <area> / --bench <name> (Unit 17). Language selection is a
        // driver concern (the Cajeta harness only emits cajeta rows).
        boolean listMode = false;
        boolean selfTest = false;
        boolean runMode = false;
        String outPath = null;
        String areaFilter = null;
        String benchFilter = null;
        int32 i = 0;
        while (i < args.count()) {
            if (args[i].equals("--list")) {
                listMode = true;
            }
            if (args[i].equals("--selftest")) {
                selfTest = true;
            }
            if (args[i].equals("--run")) {
                runMode = true;
            }
            if (args[i].equals("--out")) {
                if (i + 1 < args.count()) {
                    outPath = args[i + 1];
                }
            }
            if (args[i].equals("--area")) {
                if (i + 1 < args.count()) {
                    areaFilter = args[i + 1];
                }
            }
            if (args[i].equals("--bench")) {
                if (i + 1 < args.count()) {
                    benchFilter = args[i + 1];
                }
            }
            i = i + 1;
        }

        // --selftest: exercise the reporting schema + memory capture end-to-end
        // (Unit 2). Writes a results CSV (with a real /proc peak-RSS read) and a
        // sibling env CSV, then exits.
        if (selfTest) {
            return Bench.runSelfTest(outPath);
        }

        // --run: measure every registered benchmark through the Harness loop
        // (Unit 3) and write the results CSV. (Selection by area/lang/bench
        // lands in Unit 17; for now it runs all registered benchmarks.)
        if (runMode) {
            return Bench.runMeasured(benchmarks, outPath, areaFilter, benchFilter);
        }

        int32 n = benchmarks.count();

        // `--list`: print each benchmark's name + area, then exit.
        if (listMode) {
            System.stdout.println("-- registered benchmarks --");
            int32 k = 0;
            while (k < n) {
                Benchmark b = benchmarks.get(k);
                System.stdout.println("  " + b.name() + " [" + b.area() + "]");
                k = k + 1;
            }
            System.stdout.println("=== bench complete ===");
            return 0;
        }

        // Default: drive each selected benchmark through its lifecycle once, in order.
        int32 j = 0;
        while (j < n) {
            Benchmark b = benchmarks.get(j);
            if (!Bench.selected(b, areaFilter, benchFilter)) {
                j = j + 1;
                continue;
            }
            System.stdout.println("");
            System.stdout.println("-- " + b.name() + " [" + b.area() + "] --");
            b.setup();
            b.run(1);
            b.teardown();
            boolean ok = b.checkResult();
            if (!ok) {
                System.stdout.println("  FAILED checkResult: " + b.name());
            }
            j = j + 1;
        }

        System.stdout.println("");
        System.stdout.println("=== bench complete ===");
        return 0;
    }

    // Unit 3: measure every registered benchmark through the Harness loop and
    // write one results CSV row per benchmark. Competitor rows (other languages)
    // are appended by their own runners + the driver later.
    public static int32 runMeasured(ArrayList<Benchmark> benchmarks, String outPath,
                                    String areaFilter, String benchFilter) {
        String results = outPath;
        if (results == null) {
            results = "/tmp/cajeta-bench-results.csv";
        }
        String runId = System.env.get("PROFILE_RUN_ID");
        if (runId == null) {
            runId = "local-run";
        }

        ArrayList<Result> rows = heap ArrayList<Result>();
        int32 i = 0;
        int32 n = benchmarks.count();
        while (i < n) {
            Benchmark b = benchmarks.get(i);
            if (Bench.selected(b, areaFilter, benchFilter)) {
                // measureInto appends one row per variant (the owned Results go
                // straight into the list — add stores a reference, so a named
                // owning local would drop and dangle it).
                Harness.measureInto(b, runId, rows);
            }
            i = i + 1;
        }

        // Progress lines (read back from the list as borrows).
        int32 k = 0;
        int32 rn = rows.count();
        while (k < rn) {
            Result r = rows.get(k);
            System.stdout.println("  measured " + r.benchmark + " [" + r.area
                + "] variant='" + r.variant + "'  min_ns=" + r.minNs
                + "  median_ns=" + r.medianNs + "  ws_kb=" + r.workingSetKb
                + "  " + r.status);
            k = k + 1;
        }

        Report.writeResults(results, rows);
        System.stdout.println("run: wrote " + results);
        return 0;
    }

    // Selection by --area (package or catalog path) and --bench (name).
    public static boolean selected(Benchmark b, String areaFilter, String benchFilter) {
        if (areaFilter != null) {
            if (!Bench.areaMatches(b.area(), areaFilter)) {
                return false;
            }
        }
        if (benchFilter != null) {
            if (!b.name().equals(benchFilter)) {
                return false;
            }
        }
        return true;
    }

    // --area selects a whole package ("collection") or one catalog path
    // ("collection/hashmap-int"): an exact match, or the area under the package.
    public static boolean areaMatches(String area, String filter) {
        if (area.equals(filter)) {
            return true;
        }
        int32 fn = (int32) filter.count();
        if ((int32) area.count() <= fn) {
            return false;
        }
        if (area.byteAt(fn) != 47) {
            return false;
        }
        return area.startsWith(filter);
    }

    // Unit 2 self-test: emit the reporting CSVs using the real schema, a real
    // /proc peak-RSS read, and env values pulled via System.env.get. Proves the
    // schema, memory capture, env capture, and skip-row shape before the
    // measurement loop (Unit 3) and real benchmarks (Unit 5+) are wired in.
    public static int32 runSelfTest(String outPath) {
        String results = outPath;
        if (results == null) {
            results = "/tmp/cajeta-bench-selftest.csv";
        }
        String envPath = results + ".env";

        String runId = System.env.get("PROFILE_RUN_ID");
        if (runId == null) {
            runId = "selftest-run";
        }
        String cajVer = System.env.get("PROFILE_CAJETA_VERSION");
        if (cajVer == null) {
            cajVer = "unknown";
        }

        ArrayList<Result> rows = heap ArrayList<Result>();

        // An OK row with a genuine peak-RSS reading.
        Result ok = heap Result();
        ok.runId #= runId;
        ok.benchmark = "example";
        ok.area = "selftest/example";
        ok.language = "cajeta";
        ok.languageVersion #= cajVer;
        ok.library = "stdlib";
        ok.flags = "--release -O3 -march=native";
        ok.warmup = 20;
        ok.trials = 200;
        ok.minNs = 1000;
        ok.medianNs = 1100;
        ok.meanNs = 1150;
        ok.p95Ns = 1300;
        ok.peakRssKb = Memory.peakRssKb();
        ok.status = "ok";
        ok.checkOk = true;
        rows.add(#ok);      // the list owns its rows; `ok` stays readable

        // A skipped row (missing-toolchain shape) — recorded, never silent.
        Result skip = heap Result();
        skip.runId #= runId;
        skip.benchmark = "example";
        skip.area = "selftest/example";
        skip.language = "rust";
        skip.status = "skipped";
        skip.checkOk = false;
        skip.notes = "toolchain not found: cargo";
        rows.add(#skip);

        Report.writeResults(results, rows);
        Report.writeEnv(envPath, runId);

        System.stdout.println("selftest: wrote " + results);
        System.stdout.println("selftest: peak_rss_kb = " + ok.peakRssKb);
        return 0;
    }
}
