package bench;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.BenchMain;
import bench.selftest.SelftestRegistry;
import bench.lang.LangRegistry;
import bench.collection.CollectionRegistry;
import bench.concurrent.ConcurrentRegistry;
import bench.time.TimeRegistry;
import bench.hash.HashRegistry;
import bench.codec.CodecRegistry;
import bench.io.IoRegistry;
import bench.math.MathRegistry;
import bench.nucleo.NucleoRegistry;
import bench.wire.WireRegistry;
import bench.search.SearchRegistry;
import bench.process.ProcessRegistry;
import bench.reflect.ReflectRegistry;
import bench.aot.AotRegistry;
import bench.xpu.XpuRegistry;
import bench.gfx.GfxRegistry;
import bench.toolchain.ToolchainRegistry;

// Entry point for the benchmark reference's language + stdlib catalog
// (specs/benchmark-reference-spec.md §2.1). Every benchmark lives under
// bench/<package>/; its id <area>/<name> is the one a page under
// bench/<package>/ carries.
//
// Adding a benchmark: write a dev.cajeta.bench.Benchmark subclass in
// src/main/cajeta/bench/<package>/ with area() = "<package>" and name() =
// "<slug>", and add one `b.add(heap X());` line to that directory's
// <Package>Registry. This file only calls the registries (the selftest/
// scaffold's, then the seventeen catalog packages' in catalog order) and is
// never edited to add a benchmark. test/layout_smoke.sh checks all of it.
// (The registries have distinct names because cajeta does not resolve a
// fully-qualified static call such as bench.lang.Registry.register(...).)
//
// The command line is dev.cajeta.bench's BenchMain: --list | --run
// [--area <package>] [--bench <name>] [--out <results.csv>].
// Env: CAJETA_BENCH_SMOKE=1 (warmup 1, trials 3, rows tagged `smoke`),
// CAJETA_BENCH_MACHINE, CAJETA_BENCH_SCAFFOLD=1 (also register the harness's
// own selftest/ benchmarks), PROFILE_DATA_DIR (the dataset cache).
public final class Bench {

    public static int32 main(String[] args) {
        // The list owns each element; the drop chain releases them at scope exit.
        ArrayList<Benchmark> benchmarks = heap ArrayList<Benchmark>();
        SelftestRegistry.register(benchmarks);
        LangRegistry.register(benchmarks);
        CollectionRegistry.register(benchmarks);
        ConcurrentRegistry.register(benchmarks);
        TimeRegistry.register(benchmarks);
        HashRegistry.register(benchmarks);
        CodecRegistry.register(benchmarks);
        IoRegistry.register(benchmarks);
        MathRegistry.register(benchmarks);
        NucleoRegistry.register(benchmarks);
        WireRegistry.register(benchmarks);
        SearchRegistry.register(benchmarks);
        ProcessRegistry.register(benchmarks);
        ReflectRegistry.register(benchmarks);
        AotRegistry.register(benchmarks);
        XpuRegistry.register(benchmarks);
        GfxRegistry.register(benchmarks);
        ToolchainRegistry.register(benchmarks);

        return BenchMain.run(args, benchmarks);
    }
}
