package bench.math;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;

import dev.cajeta.bench.Benchmark;

// Per-element read cost of a 1-D Tensor<float64> (tensor-element-access 1.2.1,
// from the old flat bench/src/bench/ElementAccessBench): read through flatGet,
// against a plain float64[] of the same values and the tensor's host buffer
// from hostBase (the variants). Each read narrows to float32 and back, as the
// xgboost binner does. 1M elements per trial; ns/element = min_ns / 1e6.
// Cross-check: every read path sums to the same value. The write side is
// ElementSetBench (math/tensor-element-set).
public class ElementAccessBench extends Benchmark {

    public Tensor<float64> t;
    public float64[] a;
    public int64 n;
    public float64 expected;
    public float64 last;
    public boolean ok;

    public String name() {
        return "tensor-element-get";
    }

    public String area() {
        return "math";
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 20;
    }

    public int64 inputSize() {
        return this.n;
    }

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("flat-get");
        v.add("array");
        v.add("host-buffer");
        return v;
    }

    public void setup() {
        this.n = (int64) 1000000;
        int64[] shape = heap int64[1];
        shape[0] = this.n;
        this.t #= Tensor.zeros<float64>(shape);
        this.a = heap float64[this.n];
        int64 i = 0;
        while (i < this.n) {
            this.t.flatSet(i, (float64) i * 0.5);
            this.a[i] = (float64) i * 0.5;
            i = i + 1;
        }
        this.expected = ElementAccessBench.sumArray(this.a, this.n);
        this.ok = true;
    }

    public void runVariant(String variant, int32 iterations) {
        if (variant.equals("flat-get")) {
            this.last = ElementAccessBench.sumGet(this.t, this.n);
        } else if (variant.equals("array")) {
            this.last = ElementAccessBench.sumArray(this.a, this.n);
        } else {
            this.last = ElementAccessBench.sumView(this.t, this.n);
        }
        if (this.last != this.expected) {
            this.ok = false;
        }
    }

    public boolean checkResult() {
        return this.ok;
    }

    // Sums `n` elements of `t` read through flatGet, narrowed as the xgboost binner does.
    static float64 sumGet(Tensor<float64> t, int64 n) {
        float64 s = 0.0;
        int64 i = 0;
        while (i < n) { s = s + (float64)(float32) t.flatGet(i); i = i + 1; }
        return s;
    }

    // Sums `n` elements of a plain array.
    static float64 sumArray(float64[] a, int64 n) {
        float64 s = 0.0;
        int64 i = 0;
        while (i < n) { s = s + (float64)(float32) a[i]; i = i + 1; }
        return s;
    }

    // Sums `n` elements of `t` through its host buffer from hostBase.
    static float64 sumView(Tensor<float64> t, int64 n) {
        float64[] hb = t.hostBuffer();
        int64 base = t.hostBase();
        float64 s = 0.0;
        int64 i = 0;
        while (i < n) { s = s + (float64)(float32) hb[base + i]; i = i + 1; }
        return s;
    }
}
