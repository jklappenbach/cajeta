package bench.math;

import cajeta.math.Tensor;
import cajeta.math.fft.Fft;

import dev.cajeta.bench.Benchmark;

// math/fft-2d (bench/math/fft/Fft.md): forward 2-D complex FFT of 2048 x 2048
// through Fft.fft2 (row-major interleaved float32, complex64 layout).
// Element (r, c) = x[r*cols + c] with x[k] = (u(2k) - 0.5, u(2k+1) - 0.5).
// Smoke: 512 x 512. Check: Fft.ifft2 of the last spectrum against the input,
// max abs err <= 1e-4.
public class Fft2dBench extends Benchmark {

    public Tensor<float32> x;
    public Tensor<float32> y;
    public int64 side;

    public String name() { return "fft-2d"; }
    public String area() { return "math"; }
    public int32 warmupIters() { return 1; }
    public int32 measuredIters() { return 5; }
    public int64 inputSize() { return this.side * this.side; }

    public String competitorNote() {
        String s = "Fft.fft2 float32 interleaved (complex64); check: round trip max abs err <= 1e-4";
        if (MathData.smoke()) {
            return s + "; smoke size 512 x 512 in place of 2048 x 2048";
        }
        return s;
    }

    public void setup() {
        this.side = (int64) 2048;
        if (MathData.smoke()) {
            this.side = (int64) 512;
        }
        this.x #= Fft1dBench.signal(this.side * this.side);
    }

    public void run(int32 iterations) {
        this.y #= Fft.fft2(this.x, this.side, this.side);
    }

    public boolean checkResult() {
        int64 len = (int64) 2 * this.side * this.side;
        if (this.y.size() != len) {
            return false;
        }
        Tensor<float32> back #= Fft.ifft2(this.y, this.side, this.side);
        int64 k = 0;
        while (k < len) {
            if (MathData.absf((float64) back.flatGet(k) - (float64) this.x.flatGet(k)) > 0.0001) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }
}
