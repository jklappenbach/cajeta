package bench.math;

import cajeta.math.Tensor;

import dev.cajeta.bench.Benchmark;

// math/tensor-elementwise (bench/math/Tensor.md): r = a * b + c over float32
// tensors through the library ops Tensor.mul and Tensor.add, a fresh result per
// trial (numpy's `a*b + c` allocates the same way). a[i]=u(i), b[i]=u(i+1),
// c[i]=u(i+2) (MathData). 1e7 elements; smoke 1e6. Check: the float64 sum of r
// within rel 1e-5 of the float64 reference.
public class TensorElementwiseBench extends Benchmark {

    public Tensor<float32> a;
    public Tensor<float32> b;
    public Tensor<float32> c;
    public Tensor<float32> r;
    public int64 n;
    public float64 ref;

    public String name() { return "tensor-elementwise"; }
    public String area() { return "math"; }
    public int32 warmupIters() { return 3; }
    public int32 measuredIters() { return 20; }
    public int64 inputSize() { return this.n; }

    public String competitorNote() {
        if (MathData.smoke()) {
            return "Tensor.mul then Tensor.add (float32); check: rel err <= 1e-5; smoke size n=1e6 in place of 1e7";
        }
        return "Tensor.mul then Tensor.add (float32); check: rel err <= 1e-5";
    }

    public void setup() {
        this.n = (int64) 10000000;
        if (MathData.smoke()) {
            this.n = (int64) 1000000;
        }
        int64[] shp = heap int64[1];
        shp[0] = this.n;
        this.a #= Tensor.zeros<float32>(shp);
        this.b #= Tensor.zeros<float32>(shp);
        this.c #= Tensor.zeros<float32>(shp);
        float64 s = 0.0;
        int64 i = 0;
        while (i < this.n) {
            float32 x = (float32) MathData.u(i);
            float32 y = (float32) MathData.u(i + (int64) 1);
            float32 z = (float32) MathData.u(i + (int64) 2);
            this.a.flatSet(i, x);
            this.b.flatSet(i, y);
            this.c.flatSet(i, z);
            s = s + (float64) x * (float64) y + (float64) z;
            i = i + 1;
        }
        this.ref = s;
    }

    public void run(int32 iterations) {
        Tensor<float32> m #= Tensor.mul<float32>(this.a, this.b);
        this.r #= Tensor.add<float32>(m, this.c);
    }

    public boolean checkResult() {
        float32[] hb = this.r.hostBuffer();
        int64 base = this.r.hostBase();
        float64 s = 0.0;
        int64 i = 0;
        while (i < this.n) {
            s = s + (float64) hb[base + i];
            i = i + 1;
        }
        return this.r.size() == this.n && MathData.relErr(s, this.ref) <= 0.00001;
    }
}
