package bench.wire;

import cajeta.collection.ArrayList;
import cajeta.wire.Schema;
import cajeta.wire.SchemaEncoder;

import dev.cajeta.bench.Benchmark;

// wire/encoder-encode (bench/wire/Encoder.md): encode 1e6 100-field records
// through cajeta.wire.Encoder<WireRecord> (WireRecordPb, the protobuf wire
// format, generated by bench/scripts/gen_wire.py), each call returning a fresh
// owned buffer. Record i is pool[i % 1024]. Check: the bytes produced equal
// the protobuf size of those records computed by the generator from the
// record description (WireExpect.avroTotal*), which is also what protobuf's own
// serialization of record.proto produces.
public class SchemaEncoderEncodeBench extends Benchmark {

    public ArrayList<WireRecord> pool;
    public SchemaEncoder<WireRecord> codec;
    public Schema schema;
    public int32 n;
    public int64 total;
    public int64 sink;

    public String name() { return "schemaencoder-encode"; }
    public String area() { return "wire"; }
    public int32 warmupIters() { return 1; }
    public int32 measuredIters() { return 5; }
    public int64 inputSize() { return (int64) this.n; }
    public String unit() { return "records/s"; }

    public String competitorNote() {
        String s #= WireData.sizeNote();
        return "SchemaEncoder<WireRecord> = WireRecordAvro (Avro binary under record.avsc; bench-local: the stdlib ships the interface and an opaque Schema only); check: bytes == Avro size of the records from the description" + s;
    }

    public void setup() {
        this.n = WireData.records();
        this.pool #= WireData.pool();
        this.codec = heap WireRecordAvro();
        this.schema #= WireRecordAvro.schema();
    }

    public void run(int32 iterations) {
        int64 t = 0;
        int64 k = 0;
        int32 i = 0;
        while (i < this.n) {
            int8[] b #= this.codec.encode(this.pool.get(i & 1023), this.schema);
            int32 c = (int32) b.count();
            t = t + (int64) c;
            k = k + (int64) b[c - 1];
            i = i + 1;
        }
        this.total = t;
        this.sink = k;
    }

    public boolean checkResult() {
        if (WireData.smoke()) {
            return this.total == WireExpect.avroTotalSmoke();
        }
        return this.total == WireExpect.avroTotalFull();
    }
}
