package bench.concurrent;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every concurrent/ benchmark, in catalog order. A unit adds a concurrent/
// benchmark by writing the class in this directory and one `b.add(heap X());`
// line here; Bench.cajeta calls this and is never edited for it.
public final class ConcurrentRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap AtomicBench());
        b.add(heap TaskSpawnBench());
    }
}
