package bench.concurrent;

import dev.cajeta.bench.Benchmark;

// concurrent/task-spawn-await: spawn and await 1e5 trivial tasks, sequentially
// (Tasks.md). Each spawn allocates a stackful fiber; spawning then awaiting
// immediately keeps only one live at a time. The 1M-live-task footprint is
// concurrent/tasks-1m-footprint (TasksFootprintBench).
// Cross-check: sum of (i+1) == N*(N+1)/2.
public class TaskSpawnBench extends Benchmark {

    public int32 n;
    public int64 result;

    public static async int32 leaf(int32 x) {
        return x + 1;
    }

    // The spawning loop runs as a fiber itself, so spawn and await are the
    // fiber-to-fiber path (the competitors spawn from a task, a goroutine or an
    // event loop); the main thread is not a fiber.
    public static async int64 spawner(int32 n) {
        int64 acc = 0;
        int32 i = 0;
        while (i < n) {
            int32 r = await spawn leaf(i);
            acc = acc + (int64) r;
            i = i + 1;
        }
        return acc;
    }

    public String name() {
        return "task-spawn-await";
    }

    public String area() {
        return "concurrent";
    }

    // ~200 us a spawn+await on Phoenix (2026-10-25): a 1e5 trial is ~20 s.
    public int32 warmupIters() {
        return 1;
    }

    public int32 measuredIters() {
        return 3;
    }

    public void setup() {
        this.n = ConcSize.pick(100000, 10000);
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String unit() {
        return "Mop/s";
    }

    public String competitorNote() {
        return ConcSize.join("spawn then await each from inside a fiber", ConcSize.smokeNote("1e4 tasks"));
    }

    public void run(int32 iterations) {
        this.result = await spawn spawner(this.n);
    }

    public boolean checkResult() {
        int64 nn = (int64) this.n;
        return this.result == nn * (nn + 1) / 2;
    }
}
