package bench.concurrent;

import cajeta.concurrent.Mutex;

import dev.cajeta.bench.Benchmark;

// concurrent/mutex-contended-4 and concurrent/mutex-contended-16: F fibers each
// doing 1e6 Mutex<int64>.withLock increments on one shared mutex (Mutex.md).
// Fibers on the Cajeta side, OS threads on the competitor side. Cross-check: the
// protected value equals F x 1e6.
public class MutexContendedBench extends Benchmark {

    public int32 fibers;
    public int32 per;
    public int64 result;

    public MutexContendedBench(int32 fibers) {
        this.fibers = fibers;
        this.per = 0;
        this.result = 0;
    }

    public static async int32 worker(Mutex<int64> m, int32 n) {
        int32 i = 0;
        while (i < n) {
            m.withLock((v) -> v + 1L);
            i = i + 1;
        }
        return 0;
    }

    public String name() {
        if (this.fibers == 4) {
            return "mutex-contended-4";
        }
        return "mutex-contended-16";
    }

    public String area() {
        return "concurrent";
    }

    public int32 warmupIters() {
        return 1;
    }

    public int32 measuredIters() {
        return 5;
    }

    public void setup() {
        this.per = ConcSize.pick(1000000, 10000);
    }

    public int64 inputSize() {
        return (int64) this.fibers * (int64) this.per;
    }

    public String unit() {
        return "Mop/s";
    }

    public String competitorNote() {
        return ConcSize.join("fibers on the carrier pool (CAJETA_CARRIERS); competitors use OS threads",
            ConcSize.smokeNote("1e4 ops per fiber"));
    }

    public void run(int32 iterations) {
        Mutex<int64> m = heap Mutex<int64>(0L);
        scope {
            int32 k = 0;
            while (k < this.fibers) {
                spawn worker(m, this.per);
                k = k + 1;
            }
        }
        this.result = m.get();
    }

    public boolean checkResult() {
        return this.result == (int64) this.fibers * (int64) this.per;
    }
}
