package bench.concurrent;

import cajeta.concurrent.AtomicInt32;

import dev.cajeta.bench.Benchmark;

// concurrent/atomic-fetchadd-32: 1e8 fetchAdd(1) on one AtomicInt32, one thread
// (AtomicInt32.md). Cross-check: the final load() equals N.
public class Atomic32Bench extends Benchmark {

    public int32 n;
    public int32 result;

    public String name() {
        return "atomic-fetchadd-32";
    }

    public String area() {
        return "concurrent";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public void setup() {
        this.n = ConcSize.pick(100000000, 1000000);
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String unit() {
        return "Mop/s";
    }

    public String competitorNote() {
        return ConcSize.join("seq_cst fetchAdd", ConcSize.smokeNote("1e6 ops"));
    }

    public void run(int32 iterations) {
        AtomicInt32 a = heap AtomicInt32(0);
        int32 n = this.n;
        int32 i = 0;
        while (i < n) {
            a.fetchAdd(1);
            i = i + 1;
        }
        this.result = a.load();
    }

    public boolean checkResult() {
        return this.result == this.n;
    }
}
