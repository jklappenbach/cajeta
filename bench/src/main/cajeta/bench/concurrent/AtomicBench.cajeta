package bench.concurrent;

import cajeta.concurrent.AtomicInt64;

import dev.cajeta.bench.Benchmark;

// concurrent/atomic-fetchadd: 1e8 fetchAdd(1) on one AtomicInt64, one thread
// (AtomicInt64.md). The single-threaded loop is the hardware `lock xadd` floor.
// Cross-check: the final load() equals N (every increment landed).
public class AtomicBench extends Benchmark {

    public int32 n;
    public int64 result;

    public String name() {
        return "atomic-fetchadd";
    }

    public String area() {
        return "concurrent";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public void setup() {
        this.n = ConcSize.pick(100000000, 1000000);
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String unit() {
        return "Mop/s";
    }

    public String competitorNote() {
        return ConcSize.join("seq_cst fetchAdd (lock xadd on x86 in every language)",
            ConcSize.smokeNote("1e6 ops"));
    }

    public void run(int32 iterations) {
        AtomicInt64 a = heap AtomicInt64(0);
        int32 n = this.n;
        int32 i = 0;
        while (i < n) {
            a.fetchAdd(1);
            i = i + 1;
        }
        this.result = a.load();
    }

    public boolean checkResult() {
        return this.result == (int64) this.n;
    }
}
