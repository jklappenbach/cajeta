package bench.time;

import cajeta.time.Duration;
import cajeta.time.Instant;

import dev.cajeta.bench.Benchmark;

// time/time-instant-arith (bench/time/Instant.md): 1e7 plusNanos, minus and
// comparisons per trial. Per i: t0 = ofEpochSecond(1704067200 + i);
// t1 = t0.plusNanos(((i*7919) % 1000000) * 1000) (0 .. 999999000 ns, a
// multiple of 1000 so a microsecond library can run the same integers);
// t2 = t1.minus(500 ms); acc += t2.epochSecond + t2.nano; count t2 < t0
// (exactly half the steps). Check: the constant computed with plain integer
// arithmetic and checked by every competitor, 22090666990000000 + 5000000.
public class InstantArithmeticBench extends Benchmark {

    public int32 n;
    public int64 result;

    public String name() {
        return "time-instant-arith";
    }

    public String area() {
        return "time";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = 10000000;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String competitorNote() {
        return "a fresh value per step like the other time rows (a loop-carried t = t.plusSeconds(7) is correct for Instant on v0.46.3; LocalDate Duration and LocalDateTime are not: specs/localdate-loop-reassign-spec.md)";
    }

    public void run(int32 iterations) {
        Duration half = Duration.ofMillis(500);
        int64 acc = 0;
        int64 cnt = 0;
        int32 i = 0;
        while (i < this.n) {
            int64 ii = (int64) i;
            Instant t0 = Instant.ofEpochSecond(1704067200 + ii);
            Instant t1 = t0.plusNanos(((ii * 7919) % 1000000) * 1000);
            Instant t2 = t1.minus(half);
            acc = acc + t2.getEpochSecond() + (int64) t2.getNano();
            if (t2.isBefore(t0)) {
                cnt = cnt + 1;
            }
            i = i + 1;
        }
        this.result = acc + cnt;
    }

    public boolean checkResult() {
        return this.result == 22090666995000000;
    }
}
