package bench.time;

import cajeta.time.LocalDate;

import dev.cajeta.bench.Benchmark;

// time/time-localdate-arith (bench/time/LocalDate.md): 1e7 plusDays,
// plusMonths and day-of-week per trial. Per i: d = ofEpochDay(i % 100000)
// (1970 .. 2243); e = d.plusDays(37).plusMonths(i % 25) (end-of-month
// clamped, as java.time does); acc += e.toEpochDay() + e.getDayOfWeek() (ISO,
// Monday = 1). Check: the constant every competitor checks, 504057395700
// (computed with Python datetime.date and an explicit clamp).
public class LocalDateArithmeticBench extends Benchmark {

    public int32 n;
    public int64 result;

    public String name() {
        return "time-localdate-arith";
    }

    public String area() {
        return "time";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = 10000000;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String competitorNote() {
        return "a fresh value per step: a loop-carried d = d.plusDays(1) 366 times from 2000-01-01 ends at 1970-01-02 on v0.46.3 (specs/localdate-loop-reassign-spec.md)";
    }

    public void run(int32 iterations) {
        int64 acc = 0;
        int32 i = 0;
        while (i < this.n) {
            LocalDate d = LocalDate.ofEpochDay((int64) (i % 100000));
            LocalDate a = d.plusDays(37);
            LocalDate e = a.plusMonths((int64) (i % 25));
            acc = acc + e.toEpochDay() + (int64) e.getDayOfWeek();
            i = i + 1;
        }
        this.result = acc;
    }

    public boolean checkResult() {
        return this.result == 504057395700;
    }
}
