package bench.time;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every time/ benchmark, in catalog order. A unit adds a time/
// benchmark by writing the class in this directory and one `b.add(heap X());`
// line here; Bench.cajeta calls this and is never edited for it.
public final class TimeRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap ClockNowBench());
        b.add(heap InstantArithmeticBench());
        b.add(heap DurationArithmeticBench());
        b.add(heap LocalDateArithmeticBench());
        b.add(heap LocalTimeArithmeticBench());
        b.add(heap LocalDateTimeArithmeticBench());
        b.add(heap ZonedDateTimeRegionBench());
        b.add(heap DateTimeFormatIsoBench());
        b.add(heap DateTimeParseIsoBench());
    }
}
