package bench.time;

import dev.cajeta.bench.Benchmark;

// time/datetime-parse-iso (bench/time/DateTimeFormatter.md): parse 1e6
// ISO-8601 strings back to instants, round-trip equality. cajeta.time has no
// parse API today (DateTimeFormatter formats only; no Instant.parse,
// LocalDate.parse or DateTimeFormatter.parse, although DateTimeParseException
// and its doc example exist), so the row is a recorded skip. The competitors
// run the full workload (competitors/drivers/time/datetime.sh), so the chart
// has them the day a parser lands: implement run() as parse(format(i)) == i
// over the inputs DateTimeFormatIsoBench formats, and drop the skip.
public class DateTimeParseIsoBench extends Benchmark {

    public String name() {
        return "datetime-parse-iso";
    }

    public String area() {
        return "time";
    }

    public int64 inputSize() {
        return (int64) 1000000;
    }

    public boolean supportsVariant(String variant) {
        return false;
    }

    public String skipReason() {
        return "cajeta.time has no parse API (DateTimeFormatter formats only; no Instant.parse or LocalDate.parse)";
    }

    public boolean checkResult() {
        return false;
    }
}
