package bench.io;

import dev.cajeta.bench.Benchmark;

// io/tcp-accept-rate (bench/io/net/TcpListener.md): accept 1e5 short
// connections (1e4 under CAJETA_BENCH_SMOKE=1). A connector fiber opens each
// connection with connectAsync and closes it with SO_LINGER 0 (a reset, so
// 1e5 connections leave no TIME_WAIT to exhaust the ephemeral ports); the
// trial's fiber accepts each with acceptAsync and closes it. The check is
// the accepted count, equal to the connected count.
public class TcpAcceptRateBench extends Benchmark {

    public int32 count;
    public int64 accepted;

    public String name() {
        return "tcp-accept-rate";
    }

    public String area() {
        return "io";
    }

    public int32 warmupIters() {
        return 1;
    }

    public int32 measuredIters() {
        return 5;
    }

    public void prepare(String variant) {
        this.count = (int32) IoEnv.pick((int64) 100000, (int64) 10000);
    }

    public int64 inputSize() {
        return (int64) this.count;
    }

    public String unit() {
        return "connections/s";
    }

    // The trial body on its own fiber (spawn takes a bare class-method call).
    public static async int64 trial(int32 port, int32 n) {
        return IoNet.acceptMany(port, n);
    }

    public void runVariant(String variant, int32 iterations) {
        this.accepted = await spawn trial(IoEnv.port(2), this.count);
    }

    public boolean checkResult() {
        return this.accepted == (int64) this.count;
    }

    public String competitorNote() {
        return "check=" + this.accepted + "; " + this.count + " connections"
            + (IoEnv.smoke() ? " (smoke; the page's 1e5 is the full run)" : "")
            + "; port " + IoEnv.port(2) + "; pid " + IoEnv.pid()
            + "; connector on another fiber; client close with SO_LINGER 0";
    }
}
