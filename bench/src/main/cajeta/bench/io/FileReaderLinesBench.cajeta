package bench.io;

import cajeta.io.file.File;
import cajeta.io.file.FileReader;

import dev.cajeta.bench.Benchmark;

// io/filereader-lines (bench/io/file/FileReader.md): read the generated
// 1e7-line, 500 MB file (1e6 lines, 50 MB under CAJETA_BENCH_SMOKE=1). The
// check is the line count. FileReader has no line API today (the page calls
// it "buffered line and token reading"; the stdlib reader is the raw
// read(buf, max) loop), so the row reads 1 MiB chunks and counts the '\n'
// bytes in them: the line splitting the competitors' getline / lines() /
// Scanner do is a byte scan here, with no per-line string.
public class FileReaderLinesBench extends Benchmark {

    public String path;
    public int8[] buf;
    public int64 lines;

    public String name() {
        return "filereader-lines";
    }

    public String area() {
        return "io";
    }

    public int32 warmupIters() {
        return 1;
    }

    public int32 measuredIters() {
        return 5;
    }

    public boolean supportsVariant(String variant) {
        return IoEnv.fileRowsAvailable();
    }

    public String skipReason() {
        return IoEnv.fileSkipReason();
    }

    public void prepare(String variant) {
        this.path #= IoData.linesFile();
        this.buf #= heap int8[1048576];
    }

    public int64 inputSize() {
        return IoData.lineCount();
    }

    public String unit() {
        return "lines/s";
    }

    public void runVariant(String variant, int32 iterations) {
        FileReader r #= File.openRead(this.path);
        int8[] b = this.buf;
        int64 c = 0;
        int32 n = r.read(b, 1048576);
        while (n > 0) {
            int32 i = 0;
            while (i < n) {
                if (b[i] == (int8) 10) {
                    c = c + 1;
                }
                i = i + 1;
            }
            n = r.read(b, 1048576);
        }
        r.close();
        this.lines = c;
    }

    public boolean checkResult() {
        return this.lines == IoData.lineCount();
    }

    public String competitorNote() {
        if (!IoEnv.fileRowsAvailable()) {
            return "";   // a skipped row: the reason says it all
        }
        String dv #= IoEnv.device();
        return "check=" + this.lines + "; device " + dv + "; " + IoData.lineCount() + " lines of 50 bytes"
            + (IoEnv.smoke() ? " (smoke; the page's 1e7 is the full run)" : "")
            + "; FileReader has no line API: 1 MiB reads + newline count";
    }
}
