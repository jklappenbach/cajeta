package bench.reflect;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every reflect/ benchmark, in catalog order (bench/reflect/Class.md).
// A unit adds a reflect/ benchmark by writing the class in this directory and
// one `b.add(heap X());` line here; Bench.cajeta calls this and is never edited for it.
public final class ReflectRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap ClassLookupBench());
        b.add(heap FieldEnumerateBench());
    }
}
