package profile.string;

import profile.Benchmark;

// Substring search: indexOf a needle that doesn't occur in a ~360 KB text (a
// full scan). Cross-check: returns -1 (not found). The text is built by doubling
// a base sentence directly in the field (O(n), avoids a named-local drop).
public class StringSearchBench extends Benchmark {

    public String text;
    public int64 textLen;
    public int64 lastIdx;

    public String name() {
        return "string-search";
    }

    public String area() {
        return "string";
    }

    public int32 warmupIters() {
        return 10;
    }

    public int32 measuredIters() {
        return 50;
    }

    public void setup() {
        this.text = "the quick brown fox jumps over the lazy dog ";
        int32 k = 0;
        while (k < 13) {
            this.text = this.text + this.text;
            k = k + 1;
        }
        this.textLen = (int64) this.text.count();
    }

    public int64 inputSize() {
        return this.textLen;
    }

    public void run(int32 iterations) {
        this.lastIdx = this.text.indexOf("zzzzqx-not-present");
    }

    public boolean checkResult() {
        if (this.lastIdx >= 0) {
            return false;
        }
        // Parity: the SWAR indexOf must agree with naive byte-search across
        // start / middle / end / absent / whole-string / past-the-8-byte-window.
        String h = "hello world, the quick brown fox";
        boolean ok = true;
        ok = ok && h.indexOf("hello") == 0L;          // start
        ok = ok && h.indexOf("world") == 6L;          // middle
        ok = ok && h.indexOf("fox") == 29L;           // end (past first 8-byte window)
        ok = ok && h.indexOf("quick") == 17L;         // beyond window 2
        ok = ok && h.indexOf("xyz") == -1L;           // absent
        ok = ok && h.indexOf("") == 0L;               // empty needle
        ok = ok && h.indexOf(h) == 0L;                // needle == haystack
        ok = ok && "ab".indexOf("b") == 1L;           // short haystack (< 8 bytes)
        ok = ok && "aaaab".indexOf("aab") == 2L;      // repeated first-byte candidates
        return ok;
    }
}
