package bench.lang;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// lang/string-codepoint-walk, bench/lang/String.md and StringBuilder.md. The workload, its size and its check are
// TextCase kind 0; this class gives the id and hands the lifecycle over.
public class StringCodepointWalkBench extends Benchmark {

    public TextCase c;

    public StringCodepointWalkBench() {
        this.c = heap TextCase(0);
    }

    public String name() {
        return "string-codepoint-walk";
    }

    public String area() {
        return "lang";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public #ArrayList<String> variants() {
        return this.c.variants();
    }

    public String competitorNote() {
        return this.c.competitorNote();
    }

    public void setup() {
        this.c.setup();
    }

    public int64 inputSize() {
        return this.c.inputSize();
    }

    public void runVariant(String variant, int32 iterations) {
        this.c.runVariant(variant, iterations);
    }

    public boolean checkResult() {
        return this.c.checkResult();
    }
}
