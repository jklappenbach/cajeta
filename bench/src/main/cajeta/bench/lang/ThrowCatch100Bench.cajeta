package bench.lang;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// lang/throw-catch-100, bench/lang/Exceptions.md. The workload, its size and its check are
// ExceptionsCase kind 3; this class gives the id and hands the lifecycle over.
public class ThrowCatch100Bench extends Benchmark {

    public ExceptionsCase c;

    public ThrowCatch100Bench() {
        this.c = heap ExceptionsCase(3);
    }

    public String name() {
        return "throw-catch-100";
    }

    public String area() {
        return "lang";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public #ArrayList<String> variants() {
        return this.c.variants();
    }

    public String competitorNote() {
        return this.c.competitorNote();
    }

    public void setup() {
        this.c.setup();
    }

    public int64 inputSize() {
        return this.c.inputSize();
    }

    public void runVariant(String variant, int32 iterations) {
        this.c.runVariant(variant, iterations);
    }

    public boolean checkResult() {
        return this.c.checkResult();
    }
}
