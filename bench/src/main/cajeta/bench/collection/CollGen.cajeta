package bench.collection;

import dev.cajeta.bench.BenchConfig;

// The deterministic inputs every collection/ benchmark added in unit 6 shares
// with its competitors (bench/competitors/<lang>/collection/{lists,maps,ordered,
// cache,ltm}): the same draws in the same order give the same keys, queries and
// expected checks in all six languages. Shifts and xors only, so no step can
// overflow (int64 `*` traps on signed overflow in cajeta).
//
//   next():  s ^= s << 13; s ^= s >>> 7; s ^= s << 17; return s >>> 33
//            (xorshift64, seed 88172645463325252; a 31-bit draw)
//   key(i):  three xorshift64 rounds of i ^ 0x5851F42D4C957F2D, as a signed
//            int64. Each round is a bijection, so distinct i give distinct keys.
public final class CollGen {

    public int64 s;

    public CollGen() {
        this.s = 88172645463325252;
    }

    public static int64 xs(int64 x0) {
        int64 x = x0;
        x = x ^ (x << 13);
        x = x ^ (x >>> 7);
        x = x ^ (x << 17);
        return x;
    }

    public static int64 key(int64 i) {
        int64 x = i ^ 0x5851F42D4C957F2D;
        x = CollGen.xs(x);
        x = CollGen.xs(x);
        x = CollGen.xs(x);
        return x;
    }

    // One 31-bit draw.
    public int32 next() {
        this.s = CollGen.xs(this.s);
        return (int32) (this.s >>> 33);
    }

    // `count` draws reduced into [0, range).
    public #int32[] indices(int32 count, int32 range) {
        int32[] out = heap int32[count];
        int32 i = 0;
        while (i < count) {
            out[i] = this.next() % range;
            i = i + 1;
        }
        return #out;
    }

    // key(i) for i in [0, n).
    public static #int64[] keys(int32 n) {
        int64[] out = heap int64[n];
        int32 i = 0;
        while (i < n) {
            out[i] = CollGen.key((int64) i);
            i = i + 1;
        }
        return #out;
    }

    // key(offset + idx[j]) for every j.
    public static #int64[] keysAt(int32[] idx, int32 offset) {
        int32 n = (int32) idx.count();
        int64[] out = heap int64[n];
        int32 i = 0;
        while (i < n) {
            out[i] = CollGen.key((int64) (offset + idx[i]));
            i = i + 1;
        }
        return #out;
    }

    public static int64 sum(int32[] a) {
        int32 n = (int32) a.count();
        int64 s = 0;
        int32 i = 0;
        while (i < n) {
            s = s + (int64) a[i];
            i = i + 1;
        }
        return s;
    }

    // How many of `idx` fall below `bound` (the present half of a half-present query set).
    public static int64 below(int32[] idx, int32 bound) {
        int32 n = (int32) idx.count();
        int64 c = 0;
        int32 i = 0;
        while (i < n) {
            if (idx[i] < bound) {
                c = c + 1;
            }
            i = i + 1;
        }
        return c;
    }

    // A decimal environment integer, or `dflt` when unset or not a number.
    public static int64 envInt(String name, int64 dflt) {
        String v = System.env.get(name);
        if (v == null) {
            return dflt;
        }
        int32 n = v.byteLength();
        if (n == 0) {
            return dflt;
        }
        int64 r = 0;
        int32 i = 0;
        while (i < n) {
            int32 c = ((int32) v.byteAt(i)) & 0xFF;
            if (c < 48 || c > 57) {
                return dflt;
            }
            r = r * 10 + (int64) (c - 48);
            i = i + 1;
        }
        return r;
    }
    // The first-suite rows' size: `full` (the page shape), or full / 100 under
    // CAJETA_BENCH_SMOKE=1 so the smoke stays short. CAJETA_BENCH_FULL_SIZE=1
    // keeps the page shape in a smoke (how the run plan's estimates were taken).
    // The competitors apply the same rule (their collgen), so the rows line up.
    public static boolean smallSmoke() {
        // BenchConfig.parseSmoke is the harness's own reading (1/true/yes). The
        // same test written inline here (s.equals("1") on the env string)
        // answered false in the bench binary while a standalone probe of the
        // identical code answered true; not chased further.
        if (!BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_SMOKE"))) {
            return false;
        }
        return !BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_FULL_SIZE"));
    }

    public static int32 sized(int32 full) {
        if (CollGen.smallSmoke()) {
            return full / 100;
        }
        return full;
    }

    // The row note for a sized benchmark: "" at the page shape.
    public static #String sizeNote(int32 full) {
        if (CollGen.smallSmoke()) {
            return "smoke size n/100 (page shape " + full + ")";
        }
        return "";
    }

    // 16 lowercase hex digits of v (the 16-byte string keys).
    public static #String hex16(int64 v) {
        int8[] b = heap int8[16];
        int32 i = 0;
        while (i < 16) {
            int64 d = (v >>> (60 - 4 * i)) & 15;
            if (d < 10) {
                b[i] = (int8) (48 + d);
            } else {
                b[i] = (int8) (87 + d);
            }
            i = i + 1;
        }
        return heap String(#b, 16);
    }

    // sort-stable-int64's comparator: the value field (bits 20 and up) only.
    public static int32 cmpValue(int64 a, int64 b) {
        int64 va = a >> 20;
        int64 vb = b >> 20;
        if (va < vb) {
            return -1;
        }
        if (va > vb) {
            return 1;
        }
        return 0;
    }
}
