package bench.collection;

import cajeta.collection.Sort;
import cajeta.time.Clock;

import dev.cajeta.bench.Benchmark;

// collection/sort-stable-int64: Sort.sortStable of 1e6 (value, index) pairs
// packed into int64 with a comparator on the value (smoke: n/100). Each trial
// copies the source and sorts; the copy is the subtracted baseline. Check: the
// packed array is non-decreasing, which holds exactly when the values are
// sorted and equal values keep index order (stable).
public class SortStableBench extends Benchmark {

    public int32 n;
    public int64[] src;
    public int64 baseNs;
    public int32 sortedOk;
    // Verified outside the timed region (see SortInt64Bench.out) so the reported
    // number is sort-only, matching the Rust runner.
    public int64[] out;

    public String name() {
        return "sort-stable-int64";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = CollGen.sized(1000000);
        this.src = heap int64[this.n];
        // (value, index) pairs packed value << 20 | index: value = draw % 1e5
        // (about ten equal values each), index = i (< 2^20). Sorting compares
        // the value only, so stability is what keeps equal values in index order.
        CollGen g = heap CollGen();
        int32 i = 0;
        while (i < this.n) {
            this.src[i] = ((int64) (g.next() % 100000) << 20) | (int64) i;
            i = i + 1;
        }
        int64 r0 = Clock.nanoTime();
        int32 k = 0;
        while (k < 3) {
            int64[] w = heap int64[this.n];
            int32 j = 0;
            while (j < this.n) {
                w[j] = this.src[j];
                j = j + 1;
            }
            k = k + 1;
        }
        this.baseNs = (Clock.nanoTime() - r0) / 3;
    }

    public int64 baselineNanos() {
        return this.baseNs;
    }

    public String competitorNote() {
        String s #= CollGen.sizeNote(1000000);
        return "(value index) pairs packed in an int64; comparator on the value" + (s.isEmpty() ? "" : "; " + s);
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public void run(int32 iterations) {
        int64[] w = heap int64[this.n];
        int32 i = 0;
        while (i < this.n) {
            w[i] = this.src[i];
            i = i + 1;
        }
        Sort.sortStable<int64>(w, this.n, (a, b) -> CollGen.cmpValue(a, b));
        this.out #= w;
    }

    public boolean checkResult() {
        if (this.out == null) {
            return false;
        }
        boolean ok = true;
        int32 j = 1;
        while (j < this.n) {
            if (this.out[j] < this.out[j - 1]) {
                ok = false;
            }
            j = j + 1;
        }
        return ok;
    }
}
