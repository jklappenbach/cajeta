package bench.collection;

import cajeta.collection.Sort;

import dev.cajeta.bench.Benchmark;

// collection/binary-search: 1e7 Sort.binarySearch calls in a sorted 1e6-element
// int64 array a[i] = 2i, for the keys 2 * (draw % 1e6), all present (queries
// precomputed untimed). Check: every search found its key. Smoke: n/100
// searches in n/100 / 10 elements.
public class BinarySearchBench extends Benchmark {

    public int32 n;
    public int32 m;
    public int64[] a;
    public int64[] q;
    public int64 found;

    public String name() {
        return "binary-search";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 20;
    }

    public void setup() {
        this.n = CollGen.sized(10000000);
        this.m = this.n / 10;
        int64[] arr = heap int64[this.m];
        int32 i = 0;
        while (i < this.m) {
            arr[i] = (int64) i * 2;
            i = i + 1;
        }
        this.a #= arr;
        CollGen g = heap CollGen();
        int32[] idx #= g.indices(this.n, this.m);
        int64[] qs = heap int64[this.n];
        int32 j = 0;
        while (j < this.n) {
            qs[j] = (int64) idx[j] * 2;
            j = j + 1;
        }
        this.q #= qs;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String competitorNote() {
        return CollGen.sizeNote(10000000);
    }

    public void run(int32 iterations) {
        int64[] arr = this.a;
        int64[] qs = this.q;
        int64 hits = 0;
        int32 j = 0;
        while (j < this.n) {
            if (Sort.binarySearch<int64>(arr, this.m, qs[j]) >= 0) {
                hits = hits + 1;
            }
            j = j + 1;
        }
        this.found = hits;
    }

    public boolean checkResult() {
        return this.found == (int64) this.n;
    }
}
