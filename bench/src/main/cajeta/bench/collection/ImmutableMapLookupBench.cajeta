package bench.collection;

import cajeta.collection.ArrayList;
import cajeta.collection.ImmutableMap;
import cajeta.lang.Pair;

import dev.cajeta.bench.Benchmark;

// collection/immutablemap-lookup: 1e7 get() that hit on a 1e6-entry
// ImmutableMap<int64,int64> (key(i) -> i), the hashmap-lookup-hit queries.
// Check: the value sum equals the sum of the drawn indices.
public class ImmutableMapLookupBench extends Benchmark {

    public ImmutableMap<int64, int64> map;
    public int64[] q;
    public int64 expected;
    public int64 sum;

    public String name() {
        return "immutablemap-lookup";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public int64 inputSize() {
        return (int64) 10000000;
    }

    public void setup() {
        ArrayList<Pair<int64, int64>> ps = heap ArrayList<Pair<int64, int64>>();
        int32 i = 0;
        while (i < 1000000) {
            ps.add(heap Pair<int64, int64>(CollGen.key((int64) i), (int64) i));
            i = i + 1;
        }
        ImmutableMap<int64, int64> im = heap ImmutableMap<int64, int64>(#ps);
        this.map #= im;
        CollGen g = heap CollGen();
        int32[] idx #= g.indices(10000000, 1000000);
        this.expected = CollGen.sum(idx);
        int64[] qs #= CollGen.keysAt(idx, 0);
        this.q #= qs;
    }

    public void run(int32 iterations) {
        ImmutableMap<int64, int64> m = this.map;
        int64[] qs = this.q;
        int64 s = 0;
        int32 j = 0;
        while (j < 10000000) {
            s = s + m.get(qs[j]);
            j = j + 1;
        }
        this.sum = s;
    }

    public boolean checkResult() {
        return this.sum == this.expected;
    }
}
