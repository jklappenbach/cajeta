package bench.collection;

import cajeta.collection.RedBlackTree;

import dev.cajeta.bench.Benchmark;

// collection/redblacktree-insert-lookup: put() 1e6 random int64 keys
// key(i) -> i into an empty RedBlackTree<int64,int64>, then get() each in
// insertion order, summing. Keys precomputed untimed. Check: n(n-1)/2.
// Smoke: n/100.
public class RedBlackTreeBench extends Benchmark {

    public int32 n;
    public int64[] keys;
    public int64 checksum;

    public String name() {
        return "redblacktree-insert-lookup";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public void setup() {
        this.n = CollGen.sized(1000000);
        int64[] k #= CollGen.keys(this.n);
        this.keys #= k;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String competitorNote() {
        return CollGen.sizeNote(1000000);
    }

    public void run(int32 iterations) {
        int64[] ks = this.keys;
        RedBlackTree<int64, int64> t = heap RedBlackTree<int64, int64>();
        int32 i = 0;
        while (i < this.n) {
            t.put(ks[i], (int64) i);
            i = i + 1;
        }
        int64 sum = 0;
        int32 j = 0;
        while (j < this.n) {
            sum = sum + t.get(ks[j]);
            j = j + 1;
        }
        this.checksum = sum;
    }

    public boolean checkResult() {
        int64 nn = (int64) this.n;
        return this.checksum == nn * (nn - 1) / 2;
    }
}
