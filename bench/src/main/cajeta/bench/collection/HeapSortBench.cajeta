package bench.collection;

import cajeta.collection.Heap;

import dev.cajeta.bench.Benchmark;

// collection/heap-sort: push 1e6 random int32 (CollGen draws, precomputed
// untimed) into an empty min-Heap, then pop all of them in order. Check
// (untimed): the n popped values are non-decreasing. Smoke: n/100.
public class HeapSortBench extends Benchmark {

    public int32 n;
    public int32[] vals;
    public int32[] out;

    public String name() {
        return "heap-sort";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 3;
    }

    public int32 measuredIters() {
        return 20;
    }

    public void setup() {
        this.n = CollGen.sized(1000000);
        CollGen g = heap CollGen();
        int32[] v = heap int32[this.n];
        int32 i = 0;
        while (i < this.n) {
            v[i] = g.next();
            i = i + 1;
        }
        this.vals #= v;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public String competitorNote() {
        return CollGen.sizeNote(1000000);
    }

    public void run(int32 iterations) {
        int32[] v = this.vals;
        Heap<int32> h = heap Heap<int32>();
        int32 i = 0;
        while (i < this.n) {
            h.push(v[i]);
            i = i + 1;
        }
        int32[] o = heap int32[this.n];
        int32 j = 0;
        while (j < this.n) {
            o[j] = h.pop();
            j = j + 1;
        }
        this.out #= o;
    }

    public boolean checkResult() {
        int32[] o = this.out;
        int32 j = 1;
        while (j < this.n) {
            if (o[j] < o[j - 1]) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }
}
