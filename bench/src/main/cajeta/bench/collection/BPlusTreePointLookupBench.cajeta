package bench.collection;

import cajeta.collection.BPlusTree;

import dev.cajeta.bench.Benchmark;

// collection/bplustree-point-lookup: 1e7 get() on a BPlusTree<int64,int64>
// holding key(i) -> i for i < 1e6, built untimed. Queries are
// key(draw % 1e6). Check: the value sum equals the sum of the drawn indices.
public class BPlusTreePointLookupBench extends Benchmark {

    public BPlusTree<int64, int64> tree;
    public int64[] q;
    public int64 expected;
    public int64 sum;

    public String name() {
        return "bplustree-point-lookup";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 2;
    }

    public int32 measuredIters() {
        return 10;
    }

    public int64 inputSize() {
        return (int64) 10000000;
    }

    public void setup() {
        BPlusTree<int64, int64> t = heap BPlusTree<int64, int64>();
        int32 i = 0;
        while (i < 1000000) {
            t.put(CollGen.key((int64) i), (int64) i);
            i = i + 1;
        }
        this.tree #= t;
        CollGen g = heap CollGen();
        int32[] idx #= g.indices(10000000, 1000000);
        this.expected = CollGen.sum(idx);
        int64[] qs #= CollGen.keysAt(idx, 0);
        this.q #= qs;
    }

    public void run(int32 iterations) {
        BPlusTree<int64, int64> t = this.tree;
        int64[] qs = this.q;
        int64 s = 0;
        int32 j = 0;
        while (j < 10000000) {
            s = s + t.get(qs[j]);
            j = j + 1;
        }
        this.sum = s;
    }

    public boolean checkResult() {
        return this.sum == this.expected;
    }
}
