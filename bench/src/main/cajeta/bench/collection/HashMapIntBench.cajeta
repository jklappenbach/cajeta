package profile.collection;

import cajeta.collection.HashMap;

import profile.Benchmark;

// HashMap<int32,int32> build + lookup: insert N entries, then N successful
// lookups summing the values. Cross-check: the value sum is the closed form
// (sum of 2*i for i in 0..N-1 == N*(N-1)). Mirrors the Ankerl insert+find shape.
public class HashMapIntBench extends Benchmark {

    public int32 n;
    public int64 checksum;

    public String name() {
        return "hashmap-int";
    }

    public String area() {
        return "collection";
    }

    public int32 warmupIters() {
        return 5;
    }

    public int32 measuredIters() {
        return 30;
    }

    public void setup() {
        this.n = 50000;
    }

    public int64 inputSize() {
        return (int64) this.n;
    }

    public void run(int32 iterations) {
        HashMap<int32, int32> m = heap HashMap<int32, int32>(131072);
        int32 i = 0;
        while (i < this.n) {
            m.put(i, i * 2);
            i = i + 1;
        }
        int64 sum = 0;
        int32 j = 0;
        while (j < this.n) {
            sum = sum + (int64) m.get(j);
            j = j + 1;
        }
        this.checksum = sum;
    }

    public boolean checkResult() {
        int64 nn = (int64) this.n;
        return this.checksum == nn * (nn - 1);
    }
}
