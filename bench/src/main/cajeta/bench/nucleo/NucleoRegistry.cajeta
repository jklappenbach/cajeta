package bench.nucleo;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;

// Registers every nucleo/ benchmark, in catalog order (the pages of
// bench/nucleo/: Table, Column, Tape, Fuse, Transforms). A unit adds a nucleo/
// benchmark by writing the class in this directory and one `b.add(heap X());`
// line here; Bench.cajeta calls this and is never edited for it.
public final class NucleoRegistry {

    public static void register(ArrayList<Benchmark> b) {
        b.add(heap TableGroupByBench());
        b.add(heap TableJoinBench());
        b.add(heap TableSortBench());
        b.add(heap TableFilterBench());
        b.add(heap ColumnFilterBench());
        b.add(heap ColumnArithBench());
        b.add(heap TapeBench());
        b.add(heap FuseBench());
        b.add(heap TransformsGradBench());
        b.add(heap TransformsVmapBench());
        b.add(heap TransformsJitBench());
    }
}
