package bench.xpu;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Workgroup;
import cajeta.xpu.Barrier;
import cajeta.xpu.Shared;
import cajeta.xpu.Wave;
import cajeta.xpu.GroupOp;
import cajeta.xpu.MemoryOrder;
import cajeta.xpu.CooperativeMatrix;

// Every @Kernel of the xpu/ catalog that more than one benchmark launches, and
// the one launcher per kernel (a launch stays in the kernel's own class). The
// cross-backend showcase launches exactly these, so "one source on every
// backend" is literal: the saxpy, reduce and GEMM a page row measures are the
// ones the showcase compares.
//
// Block sizes are literals and each kernel declares the block it is built for
// (@Occupancy), as the compiler's kernel gate requires.
public final class XpuKernels {

    public XpuKernels() {
        return;
    }

    // ---- BabelStream v5.0 (src/cuda/CUDAStream.cu), float64, TBSIZE 1024 ----

    @Kernel
    @Occupancy(maxThreads = 1024)
    public static void bsCopy(KernelBuffer<float64> a, KernelBuffer<float64> c, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            c[i] = a[i];
        }
    }

    @Kernel
    @Occupancy(maxThreads = 1024)
    public static void bsMul(KernelBuffer<float64> b, KernelBuffer<float64> c, float64 scalar, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            b[i] = scalar * c[i];
        }
    }

    @Kernel
    @Occupancy(maxThreads = 1024)
    public static void bsAdd(KernelBuffer<float64> a, KernelBuffer<float64> b, KernelBuffer<float64> c, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            c[i] = a[i] + b[i];
        }
    }

    @Kernel
    @Occupancy(maxThreads = 1024)
    public static void bsTriad(KernelBuffer<float64> a, KernelBuffer<float64> b, KernelBuffer<float64> c,
                               float64 scalar, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            a[i] = b[i] + scalar * c[i];
        }
    }

    // BabelStream's dot: a grid-stride partial per thread, a shared-memory tree
    // to one value per block (the tree unrolled: TBSIZE is 1024), the block
    // partials summed on the host as BabelStream does.
    @Kernel
    @Occupancy(maxThreads = 1024)
    public static void bsDot(KernelBuffer<float64> a, KernelBuffer<float64> b, KernelBuffer<float64> sums,
                             uint32 n, uint32 nblocks) {
        Shared<float64> tb = shared float64[1024];
        uint32 lid = KernelThread.x();
        uint32 i = Workgroup.x() * 1024 + lid;
        uint32 step = nblocks * 1024;
        float64 acc = 0.0;
        while (i < n) {
            acc = acc + a[i] * b[i];
            i = i + step;
        }
        tb[lid] = acc;
        Barrier.workgroup();
        if (lid < 512) { tb[lid] = tb[lid] + tb[lid + 512]; }
        Barrier.workgroup();
        if (lid < 256) { tb[lid] = tb[lid] + tb[lid + 256]; }
        Barrier.workgroup();
        if (lid < 128) { tb[lid] = tb[lid] + tb[lid + 128]; }
        Barrier.workgroup();
        if (lid < 64) { tb[lid] = tb[lid] + tb[lid + 64]; }
        Barrier.workgroup();
        if (lid < 32) { tb[lid] = tb[lid] + tb[lid + 32]; }
        Barrier.workgroup();
        if (lid < 16) { tb[lid] = tb[lid] + tb[lid + 16]; }
        Barrier.workgroup();
        if (lid < 8) { tb[lid] = tb[lid] + tb[lid + 8]; }
        Barrier.workgroup();
        if (lid < 4) { tb[lid] = tb[lid] + tb[lid + 4]; }
        Barrier.workgroup();
        if (lid < 2) { tb[lid] = tb[lid] + tb[lid + 2]; }
        Barrier.workgroup();
        if (lid == 0) {
            sums[Workgroup.x()] = tb[0] + tb[1];
        }
    }

    public static void copy(KernelStream s, KernelBuffer<float64> a, KernelBuffer<float64> c, uint32 n) {
        bsCopy.launch(s, grid: [(n + 1023) / 1024], block: [1024])(a, c, n);
    }

    public static void mul(KernelStream s, KernelBuffer<float64> b, KernelBuffer<float64> c, float64 k, uint32 n) {
        bsMul.launch(s, grid: [(n + 1023) / 1024], block: [1024])(b, c, k, n);
    }

    public static void add(KernelStream s, KernelBuffer<float64> a, KernelBuffer<float64> b,
                           KernelBuffer<float64> c, uint32 n) {
        bsAdd.launch(s, grid: [(n + 1023) / 1024], block: [1024])(a, b, c, n);
    }

    public static void triad(KernelStream s, KernelBuffer<float64> a, KernelBuffer<float64> b,
                             KernelBuffer<float64> c, float64 k, uint32 n) {
        bsTriad.launch(s, grid: [(n + 1023) / 1024], block: [1024])(a, b, c, k, n);
    }

    public static void dot(KernelStream s, KernelBuffer<float64> a, KernelBuffer<float64> b,
                           KernelBuffer<float64> sums, uint32 n, uint32 nblocks) {
        bsDot.launch(s, grid: [nblocks], block: [1024])(a, b, sums, n, nblocks);
    }

    // ---- saxpy, float32: y = a*x + y ----------------------------------------

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void saxpyK(KernelBuffer<float32> y, KernelBuffer<float32> x, float32 a, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            y[i] = a * x[i] + y[i];
        }
    }

    public static void saxpy(KernelStream s, KernelBuffer<float32> y, KernelBuffer<float32> x, float32 a, uint32 n) {
        saxpyK.launch(s, grid: [(n + 255) / 256], block: [256])(y, x, a, n);
    }

    // ---- wave reduce, float32 -------------------------------------------------
    // Pass 1: each thread sums a grid-stride slice four floats at a time (one
    // 16-byte load, four independent accumulators), Wave.reduceSumF32 folds the
    // wave, and the wave's first lane writes the wave's partial (slot = global
    // wave index; slots a narrower wave never reaches stay at the zero they were
    // uploaded with). Pass 2: one workgroup folds the partials with
    // Workgroup.reduce (waves, then one barrier) into out[0]. n a multiple of 4.

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void reduceWaves(KernelBuffer<float32> partials, KernelBuffer<float32> x,
                                   uint32 n, uint32 stride) {
        uint32 g = KernelThread.globalIdX();
        float32 a0 = 0.0f;
        float32 a1 = 0.0f;
        float32 a2 = 0.0f;
        float32 a3 = 0.0f;
        uint32 i = g * 4;
        uint32 step = stride * 4;
        while (i < n) {
            Vector<float32,4> v = x.vload<4>(i);
            a0 = a0 + v.x;
            a1 = a1 + v.y;
            a2 = a2 + v.z;
            a3 = a3 + v.w;
            i = i + step;
        }
        float32 acc = (a0 + a1) + (a2 + a3);
        float32 w = Wave.reduceSumF32(acc);
        if (Wave.isFirstLane()) {
            partials[g / Wave.width()] = w;
        }
    }

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void reduceFinal(KernelBuffer<float32> out, KernelBuffer<float32> partials, uint32 m) {
        uint32 t = KernelThread.x();
        float32 acc = 0.0f;
        uint32 i = t;
        while (i < m) {
            acc = acc + partials[i];
            i = i + 256;
        }
        float32 total = Workgroup.reduce(GroupOp.Add, acc);
        if (t == 0) {
            out[0] = total;
        }
    }

    // blocks * 256 threads stride over x; partials holds blocks * 256 / 4 slots
    // (enough for any wave of 4 lanes or more).
    public static void reduce(KernelStream s, KernelBuffer<float32> out, KernelBuffer<float32> partials,
                              KernelBuffer<float32> x, uint32 n, uint32 blocks) {
        uint32 stride = blocks * 256;
        reduceWaves.launch(s, grid: [blocks], block: [256])(partials, x, n, stride);
        uint32 m = stride / 4;
        reduceFinal.launch(s, grid: [1], block: [256])(out, partials, m);
    }

    // ---- inclusive scan, int32: one pass, decoupled look-back -----------------
    // Tiles of 4096 (256 threads x 16 items, four 16-byte loads a thread) are
    // taken in order from an atomic counter, so every predecessor of a tile is
    // already running. A tile publishes its aggregate (flag 1) before it looks
    // back, then its inclusive prefix (flag 2); the look-back walks predecessors
    // from tile - 1, adding aggregates until it meets a prefix. x is read once
    // and out written once (the reduce-then-scan before 2026-11-09 read x twice
    // and ran three launches: 0.24x rocPRIM, cajeta-ml-gpu 18.2.2). The spin is
    // capped, so a fault ends the launch with a wrong result, not a hung GPU.

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void scanReset(KernelBuffer<int32> flag, KernelBuffer<int32> counter, uint32 tiles) {
        uint32 i = KernelThread.globalIdX();
        if (i < tiles) {
            flag[i] = 0;
        }
        if (i == 0) {
            counter[0] = 0;
        }
    }

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void scanLookback(KernelBuffer<int32> out, KernelBuffer<int32> x, KernelBuffer<int32> agg,
                                    KernelBuffer<int32> inc, KernelBuffer<int32> flag, KernelBuffer<int32> counter) {
        Shared<int32> bc = shared int32[2];
        uint32 t = KernelThread.x();
        if (t == 0) {
            bc[0] = counter.atomicAdd(0, 1, MemoryOrder.Relaxed);
        }
        Barrier.workgroup();
        uint32 tile = (uint32) bc[0];
        uint32 base = tile * 4096 + t * 16;
        Vector<int32,4> q0 = x.vload<4>(base);
        Vector<int32,4> q1 = x.vload<4>(base + 4);
        Vector<int32,4> q2 = x.vload<4>(base + 8);
        Vector<int32,4> q3 = x.vload<4>(base + 12);
        int32 local = ((q0.x + q0.y) + (q0.z + q0.w)) + ((q1.x + q1.y) + (q1.z + q1.w))
                    + ((q2.x + q2.y) + (q2.z + q2.w)) + ((q3.x + q3.y) + (q3.z + q3.w));
        int32 before = Workgroup.scan(GroupOp.Add, local);
        if (t == 255) {
            int32 a = before + local;
            agg.atomicExchange(tile, a, MemoryOrder.Relaxed);
            flag.atomicExchange(tile, 1, MemoryOrder.Release);
            bc[1] = a;
        }
        Barrier.workgroup();
        if (t == 0) {
            int32 run = 0;
            if (tile > 0) {
                uint32 p = tile - 1;
                uint32 spins = 0;
                boolean done = false;
                while (!done) {
                    int32 f = flag.atomicAdd(p, 0, MemoryOrder.Acquire);
                    if (f == 2) {
                        run = run + inc.atomicAdd(p, 0, MemoryOrder.Relaxed);
                        done = true;
                    } else if (f == 1) {
                        run = run + agg.atomicAdd(p, 0, MemoryOrder.Relaxed);
                        if (p == 0) {
                            done = true;
                        } else {
                            p = p - 1;
                        }
                    } else {
                        spins = spins + 1;
                        if (spins > 1000000) {
                            done = true;
                        }
                    }
                }
            }
            inc.atomicExchange(tile, run + bc[1], MemoryOrder.Relaxed);
            flag.atomicExchange(tile, 2, MemoryOrder.Release);
            bc[0] = run;
        }
        Barrier.workgroup();
        int32 r = bc[0] + before;
        r = r + q0.x; out[base] = r;
        r = r + q0.y; out[base + 1] = r;
        r = r + q0.z; out[base + 2] = r;
        r = r + q0.w; out[base + 3] = r;
        r = r + q1.x; out[base + 4] = r;
        r = r + q1.y; out[base + 5] = r;
        r = r + q1.z; out[base + 6] = r;
        r = r + q1.w; out[base + 7] = r;
        r = r + q2.x; out[base + 8] = r;
        r = r + q2.y; out[base + 9] = r;
        r = r + q2.z; out[base + 10] = r;
        r = r + q2.w; out[base + 11] = r;
        r = r + q3.x; out[base + 12] = r;
        r = r + q3.y; out[base + 13] = r;
        r = r + q3.z; out[base + 14] = r;
        r = r + q3.w; out[base + 15] = r;
    }

    // n a multiple of 4096; agg, inc and flag hold n / 4096 slots, counter one.
    public static void scan(KernelStream s, KernelBuffer<int32> out, KernelBuffer<int32> x,
                            KernelBuffer<int32> agg, KernelBuffer<int32> inc, KernelBuffer<int32> flag,
                            KernelBuffer<int32> counter, uint32 n) {
        uint32 tiles = n / 4096;
        scanReset.launch(s, grid: [(tiles + 255) / 256], block: [256])(flag, counter, tiles);
        scanLookback.launch(s, grid: [tiles], block: [256])(out, x, agg, inc, flag, counter);
    }

    // ---- GEMM through CooperativeMatrix ---------------------------------------
    // C[MxN] = A[MxK] . B[KxN], row-major, every dimension a multiple of 64.
    // The f32 GEMM is the kernel package's wide register tile (dev.cajeta.ml.kernels
    // Gemm.gemmTiled128 at float32, cajeta-ml-gpu 19.2.2): workgroup (mi, nj) owns a 128x128
    // tile, each of 256 lanes an 8x8 block read as four 4-wide shared loads per K step, K
    // slabs of 16 with the next slab prefetched, fused multiply-adds. float32 has no native
    // matrix core on any backend, so this replaced a one-wave 16x64 strip on the software
    // tile (5.38 ms at n4096 on sm_89, 0.38x cuBLAS). It runs on every backend, vulkan too.

    @Kernel
    @Occupancy(maxThreads = 256)
    public static void gemmF32K(KernelBuffer<float32> c, KernelBuffer<float32> a, KernelBuffer<float32> b,
                                uint32 n) {
        uint32 m = n;
        uint32 k = n;
        Shared<float32> sa = shared float32[2112];
        Shared<float32> sb = shared float32[2112];
        uint32 t = KernelThread.x();
        uint32 tx = t % 16;
        uint32 ty = t / 16;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        float32 c00 = 0.0f;
        float32 c01 = 0.0f;
        float32 c02 = 0.0f;
        float32 c03 = 0.0f;
        float32 c04 = 0.0f;
        float32 c05 = 0.0f;
        float32 c06 = 0.0f;
        float32 c07 = 0.0f;
        float32 c10 = 0.0f;
        float32 c11 = 0.0f;
        float32 c12 = 0.0f;
        float32 c13 = 0.0f;
        float32 c14 = 0.0f;
        float32 c15 = 0.0f;
        float32 c16 = 0.0f;
        float32 c17 = 0.0f;
        float32 c20 = 0.0f;
        float32 c21 = 0.0f;
        float32 c22 = 0.0f;
        float32 c23 = 0.0f;
        float32 c24 = 0.0f;
        float32 c25 = 0.0f;
        float32 c26 = 0.0f;
        float32 c27 = 0.0f;
        float32 c30 = 0.0f;
        float32 c31 = 0.0f;
        float32 c32 = 0.0f;
        float32 c33 = 0.0f;
        float32 c34 = 0.0f;
        float32 c35 = 0.0f;
        float32 c36 = 0.0f;
        float32 c37 = 0.0f;
        float32 c40 = 0.0f;
        float32 c41 = 0.0f;
        float32 c42 = 0.0f;
        float32 c43 = 0.0f;
        float32 c44 = 0.0f;
        float32 c45 = 0.0f;
        float32 c46 = 0.0f;
        float32 c47 = 0.0f;
        float32 c50 = 0.0f;
        float32 c51 = 0.0f;
        float32 c52 = 0.0f;
        float32 c53 = 0.0f;
        float32 c54 = 0.0f;
        float32 c55 = 0.0f;
        float32 c56 = 0.0f;
        float32 c57 = 0.0f;
        float32 c60 = 0.0f;
        float32 c61 = 0.0f;
        float32 c62 = 0.0f;
        float32 c63 = 0.0f;
        float32 c64 = 0.0f;
        float32 c65 = 0.0f;
        float32 c66 = 0.0f;
        float32 c67 = 0.0f;
        float32 c70 = 0.0f;
        float32 c71 = 0.0f;
        float32 c72 = 0.0f;
        float32 c73 = 0.0f;
        float32 c74 = 0.0f;
        float32 c75 = 0.0f;
        float32 c76 = 0.0f;
        float32 c77 = 0.0f;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 4) == 0 && (n % 4) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 16) * 16; }
        uint32 ar0 = t / 4;
        uint32 ac0 = (t - ar0 * 4) * 4;
        uint32 ar1 = ar0 + 64;
        uint32 br0 = t / 32;
        uint32 bc0 = (t - br0 * 32) * 4;
        uint32 br1 = br0 + 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<float32,4> pa0 = a.vload<4>((m0 + ar0) * k + ac0);
            Vector<float32,4> pa1 = a.vload<4>((m0 + ar1) * k + ac0);
            Vector<float32,4> pb0 = b.vload<4>(br0 * n + n0 + bc0);
            Vector<float32,4> pb1 = b.vload<4>(br1 * n + n0 + bc0);
            sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
            sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
            sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
            sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
            sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
            sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
            sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
            sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
            sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
            sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
            sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
            sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
            sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
            sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
            sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
            sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 16;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<4>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<4>((m0 + ar1) * k + next + ac0);
                    pb0 = b.vload<4>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<4>((next + br1) * n + n0 + bc0);
                }
                uint32 kk = 0;
                while (kk < 16) {
                    Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                    Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                    Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                    Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                    float32 a0 = av0.x;
                    float32 a1 = av0.y;
                    float32 a2 = av0.z;
                    float32 a3 = av0.w;
                    float32 a4 = av1.x;
                    float32 a5 = av1.y;
                    float32 a6 = av1.z;
                    float32 a7 = av1.w;
                    float32 b0 = bv0.x;
                    float32 b1 = bv0.y;
                    float32 b2 = bv0.z;
                    float32 b3 = bv0.w;
                    float32 b4 = bv1.x;
                    float32 b5 = bv1.y;
                    float32 b6 = bv1.z;
                    float32 b7 = bv1.w;
                    c00 = Math.fma(a0, b0, c00);
                    c01 = Math.fma(a0, b1, c01);
                    c02 = Math.fma(a0, b2, c02);
                    c03 = Math.fma(a0, b3, c03);
                    c04 = Math.fma(a0, b4, c04);
                    c05 = Math.fma(a0, b5, c05);
                    c06 = Math.fma(a0, b6, c06);
                    c07 = Math.fma(a0, b7, c07);
                    c10 = Math.fma(a1, b0, c10);
                    c11 = Math.fma(a1, b1, c11);
                    c12 = Math.fma(a1, b2, c12);
                    c13 = Math.fma(a1, b3, c13);
                    c14 = Math.fma(a1, b4, c14);
                    c15 = Math.fma(a1, b5, c15);
                    c16 = Math.fma(a1, b6, c16);
                    c17 = Math.fma(a1, b7, c17);
                    c20 = Math.fma(a2, b0, c20);
                    c21 = Math.fma(a2, b1, c21);
                    c22 = Math.fma(a2, b2, c22);
                    c23 = Math.fma(a2, b3, c23);
                    c24 = Math.fma(a2, b4, c24);
                    c25 = Math.fma(a2, b5, c25);
                    c26 = Math.fma(a2, b6, c26);
                    c27 = Math.fma(a2, b7, c27);
                    c30 = Math.fma(a3, b0, c30);
                    c31 = Math.fma(a3, b1, c31);
                    c32 = Math.fma(a3, b2, c32);
                    c33 = Math.fma(a3, b3, c33);
                    c34 = Math.fma(a3, b4, c34);
                    c35 = Math.fma(a3, b5, c35);
                    c36 = Math.fma(a3, b6, c36);
                    c37 = Math.fma(a3, b7, c37);
                    c40 = Math.fma(a4, b0, c40);
                    c41 = Math.fma(a4, b1, c41);
                    c42 = Math.fma(a4, b2, c42);
                    c43 = Math.fma(a4, b3, c43);
                    c44 = Math.fma(a4, b4, c44);
                    c45 = Math.fma(a4, b5, c45);
                    c46 = Math.fma(a4, b6, c46);
                    c47 = Math.fma(a4, b7, c47);
                    c50 = Math.fma(a5, b0, c50);
                    c51 = Math.fma(a5, b1, c51);
                    c52 = Math.fma(a5, b2, c52);
                    c53 = Math.fma(a5, b3, c53);
                    c54 = Math.fma(a5, b4, c54);
                    c55 = Math.fma(a5, b5, c55);
                    c56 = Math.fma(a5, b6, c56);
                    c57 = Math.fma(a5, b7, c57);
                    c60 = Math.fma(a6, b0, c60);
                    c61 = Math.fma(a6, b1, c61);
                    c62 = Math.fma(a6, b2, c62);
                    c63 = Math.fma(a6, b3, c63);
                    c64 = Math.fma(a6, b4, c64);
                    c65 = Math.fma(a6, b5, c65);
                    c66 = Math.fma(a6, b6, c66);
                    c67 = Math.fma(a6, b7, c67);
                    c70 = Math.fma(a7, b0, c70);
                    c71 = Math.fma(a7, b1, c71);
                    c72 = Math.fma(a7, b2, c72);
                    c73 = Math.fma(a7, b3, c73);
                    c74 = Math.fma(a7, b4, c74);
                    c75 = Math.fma(a7, b5, c75);
                    c76 = Math.fma(a7, b6, c76);
                    c77 = Math.fma(a7, b7, c77);
                    kk = kk + 1;
                }
                Barrier.workgroup();
                if (more) {
                    sa[(ac0 + 0) * 132 + ar0] = (float32) pa0.x;
                    sa[(ac0 + 1) * 132 + ar0] = (float32) pa0.y;
                    sa[(ac0 + 2) * 132 + ar0] = (float32) pa0.z;
                    sa[(ac0 + 3) * 132 + ar0] = (float32) pa0.w;
                    sa[(ac0 + 0) * 132 + ar1] = (float32) pa1.x;
                    sa[(ac0 + 1) * 132 + ar1] = (float32) pa1.y;
                    sa[(ac0 + 2) * 132 + ar1] = (float32) pa1.z;
                    sa[(ac0 + 3) * 132 + ar1] = (float32) pa1.w;
                    sb[br0 * 132 + bc0 + 0] = (float32) pb0.x;
                    sb[br0 * 132 + bc0 + 1] = (float32) pb0.y;
                    sb[br0 * 132 + bc0 + 2] = (float32) pb0.z;
                    sb[br0 * 132 + bc0 + 3] = (float32) pb0.w;
                    sb[br1 * 132 + bc0 + 0] = (float32) pb1.x;
                    sb[br1 * 132 + bc0 + 1] = (float32) pb1.y;
                    sb[br1 * 132 + bc0 + 2] = (float32) pb1.z;
                    sb[br1 * 132 + bc0 + 3] = (float32) pb1.w;
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 2048) {
                uint32 ar = idx / 16;
                uint32 ak = idx - ar * 16;
                float32 va = 0.0f;
                if (m0 + ar < m && k0 + ak < k) { va = (float32) a[(m0 + ar) * k + k0 + ak]; }
                sa[ak * 132 + ar] = va;
                uint32 bk = idx / 128;
                uint32 bc = idx - bk * 128;
                float32 vb = 0.0f;
                if (k0 + bk < k && n0 + bc < n) { vb = (float32) b[(k0 + bk) * n + n0 + bc]; }
                sb[bk * 132 + bc] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            uint32 kk = 0;
            while (kk < 16) {
                Vector<float32,4> av0 = sa.vload<4>(kk * 132 + ty * 4);
                Vector<float32,4> av1 = sa.vload<4>(kk * 132 + 64 + ty * 4);
                Vector<float32,4> bv0 = sb.vload<4>(kk * 132 + tx * 4);
                Vector<float32,4> bv1 = sb.vload<4>(kk * 132 + 64 + tx * 4);
                float32 a0 = av0.x;
                float32 a1 = av0.y;
                float32 a2 = av0.z;
                float32 a3 = av0.w;
                float32 a4 = av1.x;
                float32 a5 = av1.y;
                float32 a6 = av1.z;
                float32 a7 = av1.w;
                float32 b0 = bv0.x;
                float32 b1 = bv0.y;
                float32 b2 = bv0.z;
                float32 b3 = bv0.w;
                float32 b4 = bv1.x;
                float32 b5 = bv1.y;
                float32 b6 = bv1.z;
                float32 b7 = bv1.w;
                c00 = Math.fma(a0, b0, c00);
                c01 = Math.fma(a0, b1, c01);
                c02 = Math.fma(a0, b2, c02);
                c03 = Math.fma(a0, b3, c03);
                c04 = Math.fma(a0, b4, c04);
                c05 = Math.fma(a0, b5, c05);
                c06 = Math.fma(a0, b6, c06);
                c07 = Math.fma(a0, b7, c07);
                c10 = Math.fma(a1, b0, c10);
                c11 = Math.fma(a1, b1, c11);
                c12 = Math.fma(a1, b2, c12);
                c13 = Math.fma(a1, b3, c13);
                c14 = Math.fma(a1, b4, c14);
                c15 = Math.fma(a1, b5, c15);
                c16 = Math.fma(a1, b6, c16);
                c17 = Math.fma(a1, b7, c17);
                c20 = Math.fma(a2, b0, c20);
                c21 = Math.fma(a2, b1, c21);
                c22 = Math.fma(a2, b2, c22);
                c23 = Math.fma(a2, b3, c23);
                c24 = Math.fma(a2, b4, c24);
                c25 = Math.fma(a2, b5, c25);
                c26 = Math.fma(a2, b6, c26);
                c27 = Math.fma(a2, b7, c27);
                c30 = Math.fma(a3, b0, c30);
                c31 = Math.fma(a3, b1, c31);
                c32 = Math.fma(a3, b2, c32);
                c33 = Math.fma(a3, b3, c33);
                c34 = Math.fma(a3, b4, c34);
                c35 = Math.fma(a3, b5, c35);
                c36 = Math.fma(a3, b6, c36);
                c37 = Math.fma(a3, b7, c37);
                c40 = Math.fma(a4, b0, c40);
                c41 = Math.fma(a4, b1, c41);
                c42 = Math.fma(a4, b2, c42);
                c43 = Math.fma(a4, b3, c43);
                c44 = Math.fma(a4, b4, c44);
                c45 = Math.fma(a4, b5, c45);
                c46 = Math.fma(a4, b6, c46);
                c47 = Math.fma(a4, b7, c47);
                c50 = Math.fma(a5, b0, c50);
                c51 = Math.fma(a5, b1, c51);
                c52 = Math.fma(a5, b2, c52);
                c53 = Math.fma(a5, b3, c53);
                c54 = Math.fma(a5, b4, c54);
                c55 = Math.fma(a5, b5, c55);
                c56 = Math.fma(a5, b6, c56);
                c57 = Math.fma(a5, b7, c57);
                c60 = Math.fma(a6, b0, c60);
                c61 = Math.fma(a6, b1, c61);
                c62 = Math.fma(a6, b2, c62);
                c63 = Math.fma(a6, b3, c63);
                c64 = Math.fma(a6, b4, c64);
                c65 = Math.fma(a6, b5, c65);
                c66 = Math.fma(a6, b6, c66);
                c67 = Math.fma(a6, b7, c67);
                c70 = Math.fma(a7, b0, c70);
                c71 = Math.fma(a7, b1, c71);
                c72 = Math.fma(a7, b2, c72);
                c73 = Math.fma(a7, b3, c73);
                c74 = Math.fma(a7, b4, c74);
                c75 = Math.fma(a7, b5, c75);
                c76 = Math.fma(a7, b6, c76);
                c77 = Math.fma(a7, b7, c77);
                kk = kk + 1;
            }
            Barrier.workgroup();
            k0 = k0 + 16;
        }
        uint32 r0 = m0 + ty * 4 + 0;
        uint32 r1 = m0 + ty * 4 + 1;
        uint32 r2 = m0 + ty * 4 + 2;
        uint32 r3 = m0 + ty * 4 + 3;
        uint32 r4 = m0 + 64 + ty * 4 + 0;
        uint32 r5 = m0 + 64 + ty * 4 + 1;
        uint32 r6 = m0 + 64 + ty * 4 + 2;
        uint32 r7 = m0 + 64 + ty * 4 + 3;
        uint32 q0 = n0 + tx * 4 + 0;
        uint32 q1 = n0 + tx * 4 + 1;
        uint32 q2 = n0 + tx * 4 + 2;
        uint32 q3 = n0 + tx * 4 + 3;
        uint32 q4 = n0 + 64 + tx * 4 + 0;
        uint32 q5 = n0 + 64 + tx * 4 + 1;
        uint32 q6 = n0 + 64 + tx * 4 + 2;
        uint32 q7 = n0 + 64 + tx * 4 + 3;
        if (r0 < m && q0 < n) { c[r0 * n + q0] = (float32) c00; }
        if (r0 < m && q1 < n) { c[r0 * n + q1] = (float32) c01; }
        if (r0 < m && q2 < n) { c[r0 * n + q2] = (float32) c02; }
        if (r0 < m && q3 < n) { c[r0 * n + q3] = (float32) c03; }
        if (r0 < m && q4 < n) { c[r0 * n + q4] = (float32) c04; }
        if (r0 < m && q5 < n) { c[r0 * n + q5] = (float32) c05; }
        if (r0 < m && q6 < n) { c[r0 * n + q6] = (float32) c06; }
        if (r0 < m && q7 < n) { c[r0 * n + q7] = (float32) c07; }
        if (r1 < m && q0 < n) { c[r1 * n + q0] = (float32) c10; }
        if (r1 < m && q1 < n) { c[r1 * n + q1] = (float32) c11; }
        if (r1 < m && q2 < n) { c[r1 * n + q2] = (float32) c12; }
        if (r1 < m && q3 < n) { c[r1 * n + q3] = (float32) c13; }
        if (r1 < m && q4 < n) { c[r1 * n + q4] = (float32) c14; }
        if (r1 < m && q5 < n) { c[r1 * n + q5] = (float32) c15; }
        if (r1 < m && q6 < n) { c[r1 * n + q6] = (float32) c16; }
        if (r1 < m && q7 < n) { c[r1 * n + q7] = (float32) c17; }
        if (r2 < m && q0 < n) { c[r2 * n + q0] = (float32) c20; }
        if (r2 < m && q1 < n) { c[r2 * n + q1] = (float32) c21; }
        if (r2 < m && q2 < n) { c[r2 * n + q2] = (float32) c22; }
        if (r2 < m && q3 < n) { c[r2 * n + q3] = (float32) c23; }
        if (r2 < m && q4 < n) { c[r2 * n + q4] = (float32) c24; }
        if (r2 < m && q5 < n) { c[r2 * n + q5] = (float32) c25; }
        if (r2 < m && q6 < n) { c[r2 * n + q6] = (float32) c26; }
        if (r2 < m && q7 < n) { c[r2 * n + q7] = (float32) c27; }
        if (r3 < m && q0 < n) { c[r3 * n + q0] = (float32) c30; }
        if (r3 < m && q1 < n) { c[r3 * n + q1] = (float32) c31; }
        if (r3 < m && q2 < n) { c[r3 * n + q2] = (float32) c32; }
        if (r3 < m && q3 < n) { c[r3 * n + q3] = (float32) c33; }
        if (r3 < m && q4 < n) { c[r3 * n + q4] = (float32) c34; }
        if (r3 < m && q5 < n) { c[r3 * n + q5] = (float32) c35; }
        if (r3 < m && q6 < n) { c[r3 * n + q6] = (float32) c36; }
        if (r3 < m && q7 < n) { c[r3 * n + q7] = (float32) c37; }
        if (r4 < m && q0 < n) { c[r4 * n + q0] = (float32) c40; }
        if (r4 < m && q1 < n) { c[r4 * n + q1] = (float32) c41; }
        if (r4 < m && q2 < n) { c[r4 * n + q2] = (float32) c42; }
        if (r4 < m && q3 < n) { c[r4 * n + q3] = (float32) c43; }
        if (r4 < m && q4 < n) { c[r4 * n + q4] = (float32) c44; }
        if (r4 < m && q5 < n) { c[r4 * n + q5] = (float32) c45; }
        if (r4 < m && q6 < n) { c[r4 * n + q6] = (float32) c46; }
        if (r4 < m && q7 < n) { c[r4 * n + q7] = (float32) c47; }
        if (r5 < m && q0 < n) { c[r5 * n + q0] = (float32) c50; }
        if (r5 < m && q1 < n) { c[r5 * n + q1] = (float32) c51; }
        if (r5 < m && q2 < n) { c[r5 * n + q2] = (float32) c52; }
        if (r5 < m && q3 < n) { c[r5 * n + q3] = (float32) c53; }
        if (r5 < m && q4 < n) { c[r5 * n + q4] = (float32) c54; }
        if (r5 < m && q5 < n) { c[r5 * n + q5] = (float32) c55; }
        if (r5 < m && q6 < n) { c[r5 * n + q6] = (float32) c56; }
        if (r5 < m && q7 < n) { c[r5 * n + q7] = (float32) c57; }
        if (r6 < m && q0 < n) { c[r6 * n + q0] = (float32) c60; }
        if (r6 < m && q1 < n) { c[r6 * n + q1] = (float32) c61; }
        if (r6 < m && q2 < n) { c[r6 * n + q2] = (float32) c62; }
        if (r6 < m && q3 < n) { c[r6 * n + q3] = (float32) c63; }
        if (r6 < m && q4 < n) { c[r6 * n + q4] = (float32) c64; }
        if (r6 < m && q5 < n) { c[r6 * n + q5] = (float32) c65; }
        if (r6 < m && q6 < n) { c[r6 * n + q6] = (float32) c66; }
        if (r6 < m && q7 < n) { c[r6 * n + q7] = (float32) c67; }
        if (r7 < m && q0 < n) { c[r7 * n + q0] = (float32) c70; }
        if (r7 < m && q1 < n) { c[r7 * n + q1] = (float32) c71; }
        if (r7 < m && q2 < n) { c[r7 * n + q2] = (float32) c72; }
        if (r7 < m && q3 < n) { c[r7 * n + q3] = (float32) c73; }
        if (r7 < m && q4 < n) { c[r7 * n + q4] = (float32) c74; }
        if (r7 < m && q5 < n) { c[r7 * n + q5] = (float32) c75; }
        if (r7 < m && q6 < n) { c[r7 * n + q6] = (float32) c76; }
        if (r7 < m && q7 < n) { c[r7 * n + q7] = (float32) c77; }
    }

    public static void gemmF32(KernelStream s, KernelBuffer<float32> c, KernelBuffer<float32> a,
                               KernelBuffer<float32> b, uint32 n) {
        uint32 t = (n + 127) / 128;
        gemmF32K.launch(s, grid: [t * t], block: [256])(c, a, b, n);
    }

    // A fixed-kernel codegen row: the kernel package's 128x128 member (Gemm.gemm128, cajeta-ml-gpu
    // 19.2.2) at bfloat16, one kernel on every backend. The per-device choice of tile is the
    // kernel package's large-GEMM family, measured by cajeta-ml's ml/op-gemm-bf16 row.
    @Kernel(targets = {"cpu", "nvptx", "amdgpu"}) @Wave(width = 32)
    @Occupancy(maxThreads = 256)
    public static void gemmBf16K(KernelBuffer<float32> c, KernelBuffer<bfloat16> a, KernelBuffer<bfloat16> b,
                                 uint32 n) {
        uint32 m = n;
        uint32 k = n;
        Shared<bfloat16> sa = shared bfloat16[9216];
        Shared<bfloat16> sb = shared bfloat16[8704];
        Shared<float32> sc = shared float32[2048];
        uint32 t = KernelThread.x();
        uint32 wave = t / 32;
        uint32 lane = t - wave * 32;
        uint32 wm = wave % 4;
        uint32 wn = wave / 4;
        uint32 ntiles = (n + 127) / 128;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid - mi * ntiles;
        uint32 m0 = mi * 128;
        uint32 n0 = nj * 128;
        CooperativeMatrix<float32,16,16,2> a00; a00.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a01; a01.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a02; a02.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a03; a03.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a10; a10.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a11; a11.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a12; a12.splat(0.0f);
        CooperativeMatrix<float32,16,16,2> a13; a13.splat(0.0f);
        CooperativeMatrix<bfloat16,16,16,0> ma;
        CooperativeMatrix<bfloat16,16,16,1> mb0;
        CooperativeMatrix<bfloat16,16,16,1> mb1;
        CooperativeMatrix<bfloat16,16,16,1> mb2;
        CooperativeMatrix<bfloat16,16,16,1> mb3;
        boolean wide = m0 + 128 <= m && n0 + 128 <= n && (k % 8) == 0 && (n % 8) == 0;
        uint32 kFull = 0;
        if (wide) { kFull = (k / 64) * 64; }
        uint32 ar0 = t / 8 + 0;
        uint32 ar1 = t / 8 + 32;
        uint32 ar2 = t / 8 + 64;
        uint32 ar3 = t / 8 + 96;
        uint32 ac0 = (t % 8) * 8;
        uint32 br0 = t / 16 + 0;
        uint32 br1 = t / 16 + 16;
        uint32 br2 = t / 16 + 32;
        uint32 br3 = t / 16 + 48;
        uint32 bc0 = (t % 16) * 8;
        uint32 k0 = 0;
        if (kFull > 0) {
            Vector<bfloat16,8> pa0 = a.vload<8>((m0 + ar0) * k + ac0);
            Vector<bfloat16,8> pa1 = a.vload<8>((m0 + ar1) * k + ac0);
            Vector<bfloat16,8> pa2 = a.vload<8>((m0 + ar2) * k + ac0);
            Vector<bfloat16,8> pa3 = a.vload<8>((m0 + ar3) * k + ac0);
            Vector<bfloat16,8> pb0 = b.vload<8>(br0 * n + n0 + bc0);
            Vector<bfloat16,8> pb1 = b.vload<8>(br1 * n + n0 + bc0);
            Vector<bfloat16,8> pb2 = b.vload<8>(br2 * n + n0 + bc0);
            Vector<bfloat16,8> pb3 = b.vload<8>(br3 * n + n0 + bc0);
            sa.vstore(ar0 * 72 + ac0, pa0);
            sa.vstore(ar1 * 72 + ac0, pa1);
            sa.vstore(ar2 * 72 + ac0, pa2);
            sa.vstore(ar3 * 72 + ac0, pa3);
            sb.vstore(br0 * 136 + bc0, pb0);
            sb.vstore(br1 * 136 + bc0, pb1);
            sb.vstore(br2 * 136 + bc0, pb2);
            sb.vstore(br3 * 136 + bc0, pb3);
            Barrier.workgroup();
            while (k0 < kFull) {
                uint32 next = k0 + 64;
                boolean more = next < kFull;
                if (more) {
                    pa0 = a.vload<8>((m0 + ar0) * k + next + ac0);
                    pa1 = a.vload<8>((m0 + ar1) * k + next + ac0);
                    pa2 = a.vload<8>((m0 + ar2) * k + next + ac0);
                    pa3 = a.vload<8>((m0 + ar3) * k + next + ac0);
                    pb0 = b.vload<8>((next + br0) * n + n0 + bc0);
                    pb1 = b.vload<8>((next + br1) * n + n0 + bc0);
                    pb2 = b.vload<8>((next + br2) * n + n0 + bc0);
                    pb3 = b.vload<8>((next + br3) * n + n0 + bc0);
                }
                for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                    mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                    mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                    mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                    mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                    ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                    a00.mma(ma, mb0);
                    a01.mma(ma, mb1);
                    a02.mma(ma, mb2);
                    a03.mma(ma, mb3);
                    ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                    a10.mma(ma, mb0);
                    a11.mma(ma, mb1);
                    a12.mma(ma, mb2);
                    a13.mma(ma, mb3);
                }

                Barrier.workgroup();
                if (more) {
                    sa.vstore(ar0 * 72 + ac0, pa0);
                    sa.vstore(ar1 * 72 + ac0, pa1);
                    sa.vstore(ar2 * 72 + ac0, pa2);
                    sa.vstore(ar3 * 72 + ac0, pa3);
                    sb.vstore(br0 * 136 + bc0, pb0);
                    sb.vstore(br1 * 136 + bc0, pb1);
                    sb.vstore(br2 * 136 + bc0, pb2);
                    sb.vstore(br3 * 136 + bc0, pb3);
                    Barrier.workgroup();
                }
                k0 = next;
            }
        }
        while (k0 < k) {
            uint32 idx = t;
            while (idx < 8192) {
                uint32 r = idx / 64;
                uint32 cc = idx - r * 64;
                uint32 gm = m0 + r;
                uint32 gk = k0 + cc;
                bfloat16 va = (bfloat16) 0;
                if (gm < m && gk < k) { va = a[gm * k + gk]; }
                sa[r * 72 + cc] = va;
                uint32 rb = idx / 128;
                uint32 cb = idx - rb * 128;
                uint32 gk2 = k0 + rb;
                uint32 gn = n0 + cb;
                bfloat16 vb = (bfloat16) 0;
                if (gk2 < k && gn < n) { vb = b[gk2 * n + gn]; }
                sb[rb * 136 + cb] = vb;
                idx = idx + 256;
            }
            Barrier.workgroup();
            for (uint32 ks = 0; ks < 4; ks = ks + 1) {
                mb0.load(sb, ks * 16 * 136 + wn * 64 + 0, 0, 136);
                mb1.load(sb, ks * 16 * 136 + wn * 64 + 16, 0, 136);
                mb2.load(sb, ks * 16 * 136 + wn * 64 + 32, 0, 136);
                mb3.load(sb, ks * 16 * 136 + wn * 64 + 48, 0, 136);
                ma.load(sa, (wm * 32 + 0) * 72 + ks * 16, 0, 72);
                a00.mma(ma, mb0);
                a01.mma(ma, mb1);
                a02.mma(ma, mb2);
                a03.mma(ma, mb3);
                ma.load(sa, (wm * 32 + 16) * 72 + ks * 16, 0, 72);
                a10.mma(ma, mb0);
                a11.mma(ma, mb1);
                a12.mma(ma, mb2);
                a13.mma(ma, mb3);
            }

            Barrier.workgroup();
            k0 = k0 + 64;
        }
        boolean interior = m0 + 128 <= m && n0 + 128 <= n && (n % 8) == 0;
        if (interior) {
            a00.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 0, 0, n);
            a01.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 16, 0, n);
            a02.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 32, 0, n);
            a03.store(c, (m0 + wm * 32 + 0) * n + n0 + wn * 64 + 48, 0, n);
            a10.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 0, 0, n);
            a11.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 16, 0, n);
            a12.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 32, 0, n);
            a13.store(c, (m0 + wm * 32 + 16) * n + n0 + wn * 64 + 48, 0, n);
        } else {
            a00.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r00 = m0 + wm * 32 + 0;
            uint32 c00 = n0 + wn * 64 + 0;
            uint32 e00 = lane;
            while (e00 < 256) {
                uint32 er = e00 / 16;
                uint32 ec = e00 - er * 16;
                if (r00 + er < m && c00 + ec < n) { c[(r00 + er) * n + c00 + ec] = sc[wave * 256 + e00]; }
                e00 = e00 + 32;
            }
            Barrier.workgroup();
            a01.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r01 = m0 + wm * 32 + 0;
            uint32 c01 = n0 + wn * 64 + 16;
            uint32 e01 = lane;
            while (e01 < 256) {
                uint32 er = e01 / 16;
                uint32 ec = e01 - er * 16;
                if (r01 + er < m && c01 + ec < n) { c[(r01 + er) * n + c01 + ec] = sc[wave * 256 + e01]; }
                e01 = e01 + 32;
            }
            Barrier.workgroup();
            a02.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r02 = m0 + wm * 32 + 0;
            uint32 c02 = n0 + wn * 64 + 32;
            uint32 e02 = lane;
            while (e02 < 256) {
                uint32 er = e02 / 16;
                uint32 ec = e02 - er * 16;
                if (r02 + er < m && c02 + ec < n) { c[(r02 + er) * n + c02 + ec] = sc[wave * 256 + e02]; }
                e02 = e02 + 32;
            }
            Barrier.workgroup();
            a03.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r03 = m0 + wm * 32 + 0;
            uint32 c03 = n0 + wn * 64 + 48;
            uint32 e03 = lane;
            while (e03 < 256) {
                uint32 er = e03 / 16;
                uint32 ec = e03 - er * 16;
                if (r03 + er < m && c03 + ec < n) { c[(r03 + er) * n + c03 + ec] = sc[wave * 256 + e03]; }
                e03 = e03 + 32;
            }
            Barrier.workgroup();
            a10.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r10 = m0 + wm * 32 + 16;
            uint32 c10 = n0 + wn * 64 + 0;
            uint32 e10 = lane;
            while (e10 < 256) {
                uint32 er = e10 / 16;
                uint32 ec = e10 - er * 16;
                if (r10 + er < m && c10 + ec < n) { c[(r10 + er) * n + c10 + ec] = sc[wave * 256 + e10]; }
                e10 = e10 + 32;
            }
            Barrier.workgroup();
            a11.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r11 = m0 + wm * 32 + 16;
            uint32 c11 = n0 + wn * 64 + 16;
            uint32 e11 = lane;
            while (e11 < 256) {
                uint32 er = e11 / 16;
                uint32 ec = e11 - er * 16;
                if (r11 + er < m && c11 + ec < n) { c[(r11 + er) * n + c11 + ec] = sc[wave * 256 + e11]; }
                e11 = e11 + 32;
            }
            Barrier.workgroup();
            a12.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r12 = m0 + wm * 32 + 16;
            uint32 c12 = n0 + wn * 64 + 32;
            uint32 e12 = lane;
            while (e12 < 256) {
                uint32 er = e12 / 16;
                uint32 ec = e12 - er * 16;
                if (r12 + er < m && c12 + ec < n) { c[(r12 + er) * n + c12 + ec] = sc[wave * 256 + e12]; }
                e12 = e12 + 32;
            }
            Barrier.workgroup();
            a13.store(sc, wave * 256, 0, 16);
            Barrier.workgroup();
            uint32 r13 = m0 + wm * 32 + 16;
            uint32 c13 = n0 + wn * 64 + 48;
            uint32 e13 = lane;
            while (e13 < 256) {
                uint32 er = e13 / 16;
                uint32 ec = e13 - er * 16;
                if (r13 + er < m && c13 + ec < n) { c[(r13 + er) * n + c13 + ec] = sc[wave * 256 + e13]; }
                e13 = e13 + 32;
            }
            Barrier.workgroup();
        }
    }

    public static void gemmBf16(KernelStream s, KernelBuffer<float32> c, KernelBuffer<bfloat16> a,
                                KernelBuffer<bfloat16> b, uint32 n) {
        uint32 t = (n + 127) / 128;
        gemmBf16K.launch(s, grid: [t * t], block: [256])(c, a, b, n);
    }

    // ---- the empty kernel (launch overhead, timer resolution) ------------------

    @Kernel
    @Occupancy(maxThreads = 32)
    public static void emptyK(KernelBuffer<int32> sink, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            sink[i] = sink[i];
        }
    }

    public static void empty(KernelStream s, KernelBuffer<int32> sink) {
        emptyK.launch(s, grid: [1], block: [32])(sink, 0);
    }
}
