package bench.xpu;

import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelTimer;

import bench.xpu.XpuBench;
import bench.xpu.XpuEnv;
import bench.xpu.XpuKernels;

// xpu/kerneltimer-resolution: 1e3 KernelTimer brackets of one empty-kernel
// launch per trial (begin, launch, end, elapsedNanos). The row's time is the
// 1e3 brackets; its notes carry the minimum interval the timer read, the mean,
// the tier (device on CUDA/HIP, host on cpu) and KernelTimer.clockScale(), the
// once-measured factor the driver's event clock runs fast by (4.56% on Phoenix
// under WSL2), already divided out. Check, the page's "scale within 1%": the
// timer around a busy bracket (64 saxpy launches over 2^24 float32; 16 over 2^22
// under CAJETA_BENCH_SMOKE=1 on cpu) agrees with the host clock around the same
// submissions and sync within 1%, and the scale is in [0.5, 2]. Vulkan has no
// event clock (TIER_UNAVAILABLE): that row is skipped with the reason.
public class KernelTimerBench extends XpuBench {

    public int32 brackets;
    public int64 minNs;
    public int64 sumNs;
    public int64 reads;
    public float64 agree;
    public uint32 busyN;
    public int32 busyLaunches;
    public KernelBuffer<int32> sink;
    public KernelBuffer<float32> bx;
    public KernelBuffer<float32> by;
    public KernelTimer timer;

    public KernelTimerBench() {
        this.brackets = 1000;
        this.minNs = -1;
        this.sumNs = 0;
        this.reads = 0;
        this.agree = 0.0;
        this.busyN = (uint32) 16777216;
        this.busyLaunches = 64;
    }

    public String name() {
        return "kerneltimer-resolution";
    }

    public String unit() {
        return "brackets/s";
    }

    public int64 inputSize() {
        return (int64) this.brackets;
    }

    public static #String fixed(float64 v, int32 places) {
        float64 m = 1.0;
        int32 p = 0;
        while (p < places) { m = m * 10.0; p = p + 1; }
        int64 s = (int64) (v * m + 0.5);
        int64 whole = (int64) ((float64) s / m);
        int64 frac = s - (int64) ((float64) whole * m);
        String f = "" + frac;
        while (f.byteLength() < places) { f = "0" + f; }
        return "" + whole + "." + f;
    }

    public String competitorNote() {
        if (!this.live) {
            return "1e3 brackets of an empty kernel; competitors: CUDA events, HIP events (devserver), Vulkan timestamp queries (not built)";
        }
        int64 mean = -1;
        if (this.reads > 0) {
            mean = this.sumNs / this.reads;
        }
        String sc #= KernelTimerBench.fixed(KernelTimer.clockScale(), 4);
        String ag #= KernelTimerBench.fixed(this.agree, 4);
        return "min interval " + this.minNs + " ns, mean " + mean + " ns, tier " + KernelTimer.tierName()
            + ", clockScale " + sc + ", timer/host on a busy bracket " + ag
            + "; competitors: CUDA events, HIP events (devserver), Vulkan timestamp queries (not built)";
    }

    public void setupDevice() {
        if (KernelTimer.tier() == KernelTimer.TIER_UNAVAILABLE) {
            this.live = false;
            this.why = "KernelTimer tier unavailable on this backend (no event clock; docs/stdlib/xpu/KernelTimer.md)";
            return;
        }
        if (XpuEnv.reduced()) {
            this.busyN = (uint32) 4194304;
            this.busyLaunches = 16;
        }
        this.sink = heap KernelBuffer<int32>((uint64) 32);
        this.bx = heap KernelBuffer<float32>((uint64) this.busyN);
        this.by = heap KernelBuffer<float32>((uint64) this.busyN);
        float32[] h = heap float32[(int32) this.busyN];
        this.bx.upload(h);
        this.by.upload(h);
        this.timer #= KernelTimer.create();
    }

    public void teardown() {
        if (this.live) {
            this.timer.destroy();
        }
        if (this.comp != null) {
            this.comp.close();
        }
    }

    public void prepare(String variant) {
        if (!this.live) {
            return;
        }
        this.minNs = -1;
        this.sumNs = 0;
        this.reads = 0;
        if (this.comp != null) {
            this.comp.prepare(variant);
        }
    }

    public void runVariant(String variant, int32 iterations) {
        int32 i = 0;
        while (i < this.brackets) {
            this.timer.begin(this.stream);
            XpuKernels.empty(this.stream, this.sink);
            this.timer.end(this.stream);
            int64 ns = this.timer.elapsedNanos();
            if (ns >= 0) {
                if (this.minNs < 0 || ns < this.minNs) {
                    this.minNs = ns;
                }
                this.sumNs = this.sumNs + ns;
                this.reads = this.reads + 1;
            }
            i = i + 1;
        }
    }

    public boolean checkResult() {
        float64 scale = KernelTimer.clockScale();
        if (scale < 0.5 || scale > 2.0) {
            return false;
        }
        int64 h0 = Clock.nanoTime();
        this.timer.begin(this.stream);
        int32 i = 0;
        while (i < this.busyLaunches) {
            XpuKernels.saxpy(this.stream, this.by, this.bx, 2.0f, this.busyN);
            i = i + 1;
        }
        this.timer.end(this.stream);
        this.stream.sync();
        int64 h1 = Clock.nanoTime();
        int64 t = this.timer.elapsedNanos();
        if (t <= 0) {
            return false;
        }
        this.agree = (float64) t / (float64) (h1 - h0);
        return this.agree >= 0.99 && this.agree <= 1.01 && this.reads > 0;
    }
}
