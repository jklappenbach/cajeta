package tour;

// Class template demo. Box<T> is one of the simplest cajeta generics:
// a wrapper holding a single T. Useful in the tour as a self-contained
// proof that monomorphization works — Box<int32>, Box<String>, Box<MyClass>
// each materialize as distinct runtime types with their own vtables.
public class Box<T> {
    public T value;

    public Box(T v) {
        this.value = v;
    }

    public T get() {
        return this.value;
    }
}
