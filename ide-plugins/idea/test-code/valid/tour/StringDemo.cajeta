package tour;

// String surface: equals, contains, substring, trim, replace, length-
// like ops. Methods that return a heap String (substring / trim /
// replace) return an owned `#String` — bind to a local to take it.
public class StringDemo extends DemoClass {
    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Strings --");
        String s = "  Hello, Cajeta!  ";
        String trimmed = s.trim();
        boolean hasCajeta = trimmed.contains("Cajeta");
        String sub = trimmed.substring(7, 13);          // "Cajeta"
        String swapped = trimmed.replace("Cajeta", "World");

        System.stdout.println("  original   = '" + s + "'");
        System.stdout.println("  trim()     = '" + trimmed + "'");
        System.stdout.println("  contains   = " + hasCajeta);
        System.stdout.println("  substring  = '" + sub + "'");
        System.stdout.println("  replace    = '" + swapped + "'");
    }
}
