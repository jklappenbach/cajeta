package tour;

// Async / scope / spawn — structured concurrency over stackful fibers.
//
// Three primitives:
//
//   - `async T method() { ... }` marks a function as suspendable. Its
//     callable result type is `Task<T>`; `await` unwraps to T, parking
//     the current fiber until the awaited task completes.
//   - `spawn method(args)` enqueues the call as a child fiber. Args
//     evaluate at the spawn site (on the spawning fiber) and capture
//     into the worker's context struct. Returns a `Task<T>`.
//   - `scope { ... }` is a block whose closing `}` waits for every
//     `spawn` declared inside before letting control past. No leaked
//     tasks; structured concurrency by default. Every function body is
//     also an implicit scope, so top-level `spawn` calls join at
//     function return without an explicit `scope` block.
//   - `detach method(args)` is fire-and-forget: enqueues the call but
//     does NOT register with any scope. Captures must be `#`-
//     transferred values or primitives — no borrow capture (there's no
//     scope to anchor lifetimes to).
//
// Under the hood each spawn allocates a stackful fiber (~64 KB initial
// stack + saved ucontext). A single carrier OS thread runs many fibers
// cooperatively — `await` parks the running fiber and the carrier
// picks another ready one. No `async fn` codegen rewrite; from the
// compiler's perspective `async` is a marker that the body may park.
//
// Sendability is derived from the existing ownership model: borrows
// captured into a `spawn` are valid for the enclosing scope's
// lifetime; `#`-transferred values move into the worker; primitives
// pass by value. No `Send` trait, no `Sync` trait.
//
// See cajeta-docs/stdlib/Thread.md for the full design.
public class AsyncDemo extends DemoClass {

    // Async leaf returning a constant — exercised by the await/spawn
    // patterns below. Single-statement async bodies look like ordinary
    // methods; the `async` keyword is the only diff.
    public static async int32 leaf() {
        return 21;
    }

    // Async leaf taking primitive args. Args evaluate at the spawn
    // site and capture into the worker's ctx struct (per-field copy).
    public static async int32 add(int32 a, int32 b) {
        return a + b;
    }

    // Nested async — `outer` awaits `inner`. Under the cooperative
    // scheduler the outer fiber parks at the inner spawn's await; the
    // carrier picks up the inner fiber, runs it to completion, and the
    // outer wakes back up to consume the result.
    public static async int32 nested() {
        int32 inner = await spawn leaf();
        return inner * 2;
    }

    // Worker that mutates a shared Counter captured by borrow. The
    // enclosing scope keeps the counter alive past every worker's
    // lifetime — borrow checker is satisfied because scope joins
    // before the borrow expires.
    public static async int32 bumpWorker(Counter c, int32 by) {
        c.bumpBy(by);
        return 0;
    }

    // Fire-and-forget detach target. Captures only primitives — no
    // borrow capture allowed under detach (no scope to anchor to).
    // Any return value is discarded by the runtime.
    public static async void announce(int32 ticket) {
        // In a real program this would log / publish; the demo just
        // exits — proving the runtime accepted the detach. Output
        // ordering relative to the orchestrator is unspecified.
        return;
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Async / scope / spawn --");

        // 1. await on a bare async call — runs as an ordinary call;
        // proves the async-fn surface compiles end-to-end.
        int32 bareAwait = await leaf();
        System.stdout.println("  await leaf()                    = " + bareAwait);

        // 2. await spawn — enqueues the call as a fiber, parks the
        // caller fiber until done, returns the unwrapped result.
        int32 viaSpawn = await spawn leaf();
        System.stdout.println("  await spawn leaf()              = " + viaSpawn);

        // 3. spawn with primitive args. Args evaluate at the call
        // site (so x, y read locally) and capture into the worker.
        int32 x = 17;
        int32 y = 25;
        int32 sum = await spawn add(x, y);
        System.stdout.println("  await spawn add(17, 25)         = " + sum);

        // 4. Nested async/await — outer awaits inner. Cooperative
        // scheduler handles the parking dance; both fibers complete.
        int32 nestedVal = await spawn nested();
        System.stdout.println("  await spawn nested() = leaf()*2 = " + nestedVal);

        // 5. Three independent spawn-awaits. Each fiber has its own
        // Task<int32> with its own done flag; the awaits pair each
        // local to its specific task (not a global "any done" signal).
        int32 a = await spawn leaf();
        int32 b = await spawn add(10, 20);
        int32 c = await spawn add(40, 2);
        System.stdout.println("  three independent spawn-awaits  = "
            + a + ", " + b + ", " + c);

        // 6. Explicit `scope { }` block. Three bare spawns share a
        // mutable Counter via borrow capture; the scope's closing
        // `}` waits for every child before control passes — so the
        // counter's final value is deterministic at the read below.
        Counter tally = heap Counter();
        scope {
            spawn bumpWorker(tally, 1);
            spawn bumpWorker(tally, 10);
            spawn bumpWorker(tally, 100);
        }
        System.stdout.println("  scope { 3 bumpWorkers } tally   = " + tally.value());

        // 7. Implicit function-body scope. Even WITHOUT a `scope { }`
        // block, the surrounding function body is itself a scope —
        // every spawn registered here joins at the function's return.
        // This is what makes "spawn without a visible scope" sound by
        // default; there's always at least the enclosing function-
        // body scope.
        Counter implicit = heap Counter();
        spawn bumpWorker(implicit, 7);
        // (The spawn ABOVE joins at execute()'s `}` — but we'd like
        // to observe its effect WITHIN execute(). Wrapping the spawn
        // in an inner explicit scope gives us a join checkpoint
        // without needing to return from execute().)
        Counter probe = heap Counter();
        scope {
            spawn bumpWorker(probe, 999);
        }
        System.stdout.println("  inner scope join — probe        = " + probe.value());

        // 8. detach — fire-and-forget. The detached call enqueues a
        // fiber that is NOT registered with execute()'s scope, so
        // execute() can return without waiting. Captures are
        // primitive-only here.
        detach announce(42);
        System.stdout.println("  detach announce(42) — fire+forget");
    }
}
