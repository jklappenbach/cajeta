<idea-plugin>
    <id>dev.cajeta.idea</id>
    <name>Cajeta</name>
    <!-- Marketplace requires a vendor with a real email + url; a bare
         <vendor>cajeta</vendor> is rejected at upload. (plan §8 / D6) -->
    <vendor email="jklappenbach@gmail.com"
            url="https://github.com/jklappenbach/cajeta">Julian Klappenbach</vendor>

    <!-- NOTE: <version>, <idea-version since-build/until-build> are intentionally
         omitted — the IntelliJ Platform Gradle plugin patches them at build time
         from gradle.properties (pluginVersion / pluginSinceBuild / pluginUntilBuild),
         which keeps the plugin version synced to the repo VERSION (D9). -->

    <description><![CDATA[
        <p><b>Cajeta language support for IntelliJ IDEA.</b></p>
        <p>First-class editing for the <a href="https://github.com/jklappenbach/cajeta">Cajeta</a>
        compiled language:</p>
        <ul>
            <li>Syntax highlighting and a parser-driven PSI (full ANTLR4 grammar).</li>
            <li>Compiler-driven linting / annotations surfaced inline in the editor.</li>
            <li>Brace matching, commenter, and a structure view.</li>
            <li>Obsidian-style rendered Markdown inside source comments.</li>
            <li>Run/debug integration over the Debug Adapter Protocol (line and
                exception breakpoints) backed by the <code>cajeta dap</code> server.</li>
            <li>New-project wizard for Cajeta projects.</li>
        </ul>
        <p>Requires the <code>cajeta</code> compiler on your system; install it from
        the project's releases, or via your package manager. The compiler can also
        install this plugin for you with <code>cajeta ide install</code>.</p>
    ]]></description>

    <change-notes><![CDATA[
        <p>See the <a href="https://github.com/jklappenbach/cajeta/releases">GitHub
        releases page</a> for the full, per-version changelog. The plugin version
        tracks the Cajeta compiler version.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <!-- Code coverage (ide-coverage §3). The coverageEngine/coverageRunner
         extension points, the Coverage tool window and the gutter rendering all
         live in this PLATFORM module, so they are present in IDEA Community —
         the java-coverage plugin is a separate, Java-specific thing we do not
         depend on. -->
    <depends>com.intellij.modules.coverage</depends>

    <!-- W4a: pluggable markdown engines. Third-party plugins implement
         MarkdownEngine and register under this EP from their own plugin.xml. -->
    <extensionPoints>
        <extensionPoint
            name="markdownEngine"
            interface="dev.cajeta.idea.markdown.MarkdownEngine"
            dynamic="true"/>
    </extensionPoints>

    <!-- The built-in engine, registered through our own EP like any other. -->
    <extensions defaultExtensionNs="dev.cajeta.idea">
        <markdownEngine implementation="dev.cajeta.idea.markdown.engines.JetBrainsMarkdownEngine"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Code coverage, ide-coverage Unit 3. Registering these two is what
             gives Cajeta the platform's whole coverage UI: gutter markers, the
             Coverage tool window with its per-directory rollups, suite switching
             and Hide Coverage. None of that is reimplemented. -->
        <coverageEngine implementation="dev.cajeta.idea.coverage.CajetaCoverageEngine"/>
        <coverageRunner implementation="dev.cajeta.idea.coverage.CajetaCoverageRunner"/>
        <!-- Unit 4: Run with Coverage on a Cajeta task. The task's argv is
             UNCHANGED — measuring is declared in the manifest as a
             cajeta.coverage.instrument action, not injected by the IDE, so the
             IDE run and the CI run are the same run. -->
        <programRunner implementation="dev.cajeta.idea.coverage.CajetaCoverageProgramRunner"/>
        <notificationGroup id="Cajeta Coverage" displayType="BALLOON"/>
        <!-- Unit 5: saving a measured file invalidates its coverage. Saving is
             the trigger because freshness compares content ON DISK — an unsaved
             edit has invalidated nothing yet. -->
        <fileDocumentManagerListener
            implementation="dev.cajeta.idea.coverage.CocoStalenessWatcher"/>
        <!-- Unit 6, resolving spec §9.1: ONE window, a tab per capability.
             The four views are one subject looked at four ways, so they share a
             place and an open/closed state; Units 7-8 add tabs here. -->
        <toolWindow
            id="Cajeta Coverage"
            anchor="right"
            secondary="true"
            factoryClass="dev.cajeta.idea.coverage.CocoToolWindowFactory"/>

        <!-- Find Usages (ide-features §2.0.4). Registering these turns on the
             platform's own usage machinery — right-click Find Usages, the
             Ctrl+Click usages popup, and the docked Find window with its file
             tree and source preview. The search itself answers from the
             compiler's resolved reference export, not a text scan. -->
        <!-- Type Hierarchy (Ctrl+H), ide-features Unit 3. Walks the
             compiler's exported extends/implements edges; the three views are
             three walks over the same relation. -->
        <!-- Rename + Safe Delete (ide-features Unit 5). The rewrite is the
             platform's; ours is the reference set it rewrites, and the refusal
             when the index is not FRESH — a partial set renames the
             declaration, misses a use site, and leaves code broken for a
             reason the developer did not cause. -->
        <lang.refactoringSupport language="Cajeta"
            implementationClass="dev.cajeta.idea.refactor.CajetaRefactoringSupportProvider"/>
        <renamePsiElementProcessor
            implementation="dev.cajeta.idea.refactor.CajetaRenameProcessor"/>
        <refactoring.safeDeleteProcessor
            implementation="dev.cajeta.idea.refactor.CajetaSafeDeleteProcessor"/>
        <typeHierarchyProvider language="Cajeta"
            implementationClass="dev.cajeta.idea.hierarchy.CajetaTypeHierarchyProvider"/>
        <lang.findUsagesProvider language="Cajeta"
            implementationClass="dev.cajeta.idea.usages.CajetaFindUsagesProvider"/>
        <referencesSearch
            implementation="dev.cajeta.idea.usages.CajetaUsagesSearch"/>
        <usageTypeProvider
            implementation="dev.cajeta.idea.usages.CajetaUsageTypeProvider"/>
        <!-- W-buildtool: the Gradle-style build-tool tool window, available only
             when the project has a cajeta.json (spec §2.2). -->
        <toolWindow
            id="Cajeta Build"
            anchor="right"
            secondary="true"
            factoryClass="dev.cajeta.idea.buildtool.CajetaBuildToolWindowFactory"/>
        <notificationGroup id="Cajeta Build Tool" displayType="BALLOON"/>

        <fileType
            name="Cajeta"
            implementationClass="dev.cajeta.idea.CajetaFileType"
            fieldName="INSTANCE"
            language="Cajeta"
            extensions="cajeta"/>

        <!-- W-buildtool unit 10: structured JSONL viewer (spec §8). The file type
             is text-based so the plain text editor still opens; the provider adds
             a structured tab alongside it. -->
        <fileType
            name="JSONL"
            implementationClass="dev.cajeta.idea.jsonl.JsonlFileType"
            fieldName="INSTANCE"
            extensions="jsonl;ndjson;jsonlines"/>
        <fileEditorProvider
            implementation="dev.cajeta.idea.jsonl.JsonlFileEditorProvider"/>
        <!-- json-viewer unit 4: structured document tab for .json/.jsonc,
             beside the platform text editor (spec 4.1.1). -->
        <fileEditorProvider
            implementation="dev.cajeta.idea.jsonl.JsonDocFileEditorProvider"/>

        <!-- ide-symbol-index Unit 6: compiler-authoritative xref cache. Shards
             (.cjxref, one per source file, written under .cajeta/xref/) feed a
             FileBasedIndex; the index is cache, not authority. -->
        <fileType
            name="Cajeta Xref Shard"
            implementationClass="dev.cajeta.idea.xref.CajetaXrefFileType"
            fieldName="INSTANCE"
            extensions="cjxref"/>
        <fileBasedIndex
            implementation="dev.cajeta.idea.xref.CajetaXrefIndex"/>
        <!-- Unit 9: visible degradation — freshness state + reason. -->
        <statusBarWidgetFactory
            id="CajetaXrefStatus"
            implementation="dev.cajeta.idea.xref.CajetaXrefStatusWidgetFactory"/>
        <!-- Unit 8 §8.3: expose the mounted stdlib/dependency source as read-only
             library source roots so Ctrl-click into stdlib types resolves.
             The mount itself runs in the background startup activity below. -->
        <additionalLibraryRootsProvider
            implementation="dev.cajeta.idea.xref.CajetaXrefLibraryRootsProvider"/>

        <lang.parserDefinition
            language="Cajeta"
            implementationClass="dev.cajeta.idea.parser.CajetaParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Cajeta"
            implementationClass="dev.cajeta.idea.highlighting.CajetaSyntaxHighlighterFactory"/>

        <lang.braceMatcher
            language="Cajeta"
            implementationClass="dev.cajeta.idea.editor.CajetaBraceMatcher"/>

        <lang.commenter
            language="Cajeta"
            implementationClass="dev.cajeta.idea.editor.CajetaCommenter"/>

        <lang.psiStructureViewFactory
            language="Cajeta"
            implementationClass="dev.cajeta.idea.editor.CajetaStructureViewFactory"/>

        <externalAnnotator
            language="Cajeta"
            implementationClass="dev.cajeta.idea.lint.CajetaLintAnnotator"/>

        <applicationService
            serviceImplementation="dev.cajeta.idea.settings.CajetaSettings"/>

        <applicationConfigurable
            parentId="language"
            id="dev.cajeta.idea.settings"
            displayName="Cajeta"
            instance="dev.cajeta.idea.settings.CajetaConfigurable"/>

        <applicationService
            serviceImplementation="dev.cajeta.idea.markdown.MarkdownEngineRegistry"/>

        <postStartupActivity
            implementation="dev.cajeta.idea.xref.CajetaSourceMountStartup"/>
        <!-- Index on project open, so rename/hierarchy/usages are usable
             without the developer first running Rebuild by hand. -->
        <postStartupActivity
            implementation="dev.cajeta.idea.xref.CajetaXrefStartup"/>
        <postStartupActivity
            implementation="dev.cajeta.idea.markdown.InstallCommentCaretListener"/>

        <postStartupActivity
            implementation="dev.cajeta.idea.markdown.InstallMarkdownFoldManager"/>

        <!-- Copy takes the highlighted text of a rendered markdown block when one
             is selected; delegates to the platform handler otherwise. A folded
             block is invisible to the editor's selection model, so without this
             Ctrl+C would copy the caret's line instead. -->
        <editorActionHandler
            action="EditorCopy"
            implementationClass="dev.cajeta.idea.markdown.MarkdownCopyHandler"/>

        <newProjectWizard.languageGenerator
            implementation="dev.cajeta.idea.wizard.CajetaNewProjectWizard"/>

        <!-- Debugging (Phase 2): run config + program runner driving cajeta dap. -->
        <configurationType
            implementation="dev.cajeta.idea.debugger.CajetaConfigurationType"/>
        <configurationType
            implementation="dev.cajeta.idea.buildtool.CajetaTaskConfigurationType"/>
        <programRunner
            implementation="dev.cajeta.idea.debugger.CajetaProgramRunner"/>
        <xdebugger.breakpointType
            implementation="dev.cajeta.idea.debugger.CajetaLineBreakpointType"/>
        <xdebugger.breakpointType
            implementation="dev.cajeta.idea.debugger.CajetaExceptionBreakpointType"/>
    </extensions>

    <actions>
        <!-- ide-coverage 4.2.c: load a previous coco run without re-running it.
             The platform's Import Coverage exists but asks the user to find
             build/coco/run/coco.profile by hand; the manifest already says
             where it is. Sits in the platform's own Coverage menu. -->
        <action id="Cajeta.LoadCoverage"
                class="dev.cajeta.idea.coverage.LoadCajetaCoverageAction"
                text="Load Cajeta Coverage"
                description="Load the last coco run's results without running it again">
            <add-to-group group-id="CoverageMenu" anchor="first"/>
        </action>
        <!-- Julian, 2026-08-02: hierarchy from the right-click menu, beside
             Find Usages. These REFERENCE the platform's own actions rather
             than defining new ones, so they keep their keymap bindings
             (Ctrl+H, Alt+F7) and their enable/disable logic. -->
        <reference ref="TypeHierarchy">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                relative-to-action="FindUsages"/>
        </reference>
        <reference ref="FindUsages">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </reference>
        <group id="dev.cajeta.idea.toolsGroup" text="Cajeta" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                id="dev.cajeta.idea.xref.RebuildIndex"
                class="dev.cajeta.idea.xref.CajetaXrefRebuildAction"
                text="Rebuild Cajeta Index"
                description="Whole-root compiler export, ingested into the xref index in the background."/>
            <action
                id="dev.cajeta.idea.TypeFixtureAction"
                class="dev.cajeta.idea.harness.TypeFixtureAction"
                text="Type Fixture into Editor"
                description="Run the typing-simulator harness against a fixture file."/>
            <action
                id="dev.cajeta.idea.ToggleMarkdownRendering"
                class="dev.cajeta.idea.markdown.ToggleMarkdownRenderingAction"
                text="Render Markdown in Comments"
                description="Toggle Obsidian-style Markdown rendering in Cajeta comments globally."/>
        </group>
    </actions>
</idea-plugin>
