# Large research PDFs (many bundle embedded video / high-res supplements and
# run to hundreds of MB) are tracked with Git LFS and stored on GitHub's LFS.
# CI skips the smudge filter (GIT_LFS_SKIP_SMUDGE=1 in .github/workflows) so
# build/test jobs don't download them.
research/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Shell scripts must stay LF even on Windows checkouts (a CRLF shebang/`read`
# breaks bash); Windows batch files want CRLF (labels/goto misbehave on LF).
*.sh  text eol=lf
*.cmd text eol=crlf
