package cajeta.wire;

/**
 * The decompress stage of a byte-to-byte codec, the inverse of `Compressor`.
 * A block container knows each block's decompressed length and passes it.
 * A transport that does not (HTTP content coding) passes a cap instead.
 *
 * ```cajeta
 * Decompressor d = Snappy();
 * int8[] plain #= d.decompress(block, expandedLen);
 * ```
 */
public interface Decompressor {
    /**
     * Decompresses `src` into a fresh, caller-owned buffer of exactly
     * `expandedLen` bytes (the decompressed length carried by the block header).
     *
     * @EntryPoint
     */
    #int8[] decompress(int8[] src, int64 expandedLen);

    /**
     * Decompresses `src[0 .. len)`, whose decompressed length is unknown, into a
     * fresh, caller-owned buffer. Raises `DecompressionLimitException` rather
     * than produce more than `maxOut` bytes.
     *
     * @EntryPoint
     */
    #int8[] decompress(int8[] src, int64 len, int64 maxOut);
}
