package cajeta.wire;

/**
 * The compress stage of a byte-to-byte codec, the inverse of `Decompressor`.
 * It carries no `T`, so it stays separate from `Encoder<T>`. Block containers
 * (Parquet, ORC, Avro) use `compress(src)`. HTTP content coding picks a level
 * and streams a body through `stream(level)`.
 *
 * ```cajeta
 * Compressor c = Snappy();
 * int8[] block #= c.compress(plain);
 * ```
 */
public interface Compressor {
    /**
     * Compresses `src` into a fresh, caller-owned block buffer.
     *
     * @EntryPoint
     */
    #int8[] compress(int8[] src);

    /**
     * Compresses `src[0 .. len)` at `level` (1 fastest to 9 smallest for DEFLATE
     * codecs) into a fresh, caller-owned buffer. A codec without levels ignores it.
     *
     * @EntryPoint
     */
    #int8[] compress(int8[] src, int64 len, int32 level);

    /**
     * A stream that compresses what is written to it at `level`, handing out
     * compressed bytes as it goes.
     *
     * @EntryPoint
     */
    #CompressStream stream(int32 level);
}
