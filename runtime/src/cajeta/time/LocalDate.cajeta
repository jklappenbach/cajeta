package cajeta.time;

import cajeta.lang.Comparable;

/**
 * An immutable calendar date (`yyyy-MM-dd`) with no time-of-day and no
 * time-zone, on the proleptic Gregorian calendar. Modeled on
 * `java.time.LocalDate`.
 *
 * Stored canonically as a single `int64` epoch-day count (days since
 * 1970-01-01; negative before it), so comparison and hashing are trivial and
 * the year/month/day parts are derived on access via the civil-from-days
 * algorithm. A pure stack value type (every return is an inline `stack`
 * literal). Out-of-range or non-existent dates throw `DateTimeException`.
 *
 * Day-of-week follows ISO-8601: Monday = 1 … Sunday = 7.
 *
 * Build one with the `of`/`ofEpochDay` static factories; never with the raw
 * constructor unless you already hold an epoch-day. Implements
 * `Comparable`, so dates order naturally; calendar arithmetic accepts a
 * `Period`, and pairing a `LocalDate` with a `LocalTime` yields a
 * `LocalDateTime` (add a zone for a `ZonedDateTime`).
 *
 * ```cajeta
 * stack LocalDate d = LocalDate.of(2026, 6, 5);    // throws `DateTimeException` if invalid
 * int32 y = d.getYear();                            // 2026
 * boolean weekend = d.getDayOfWeek() >= 6;          // Sat (6) or Sun (7)?
 *
 * stack LocalDate due = d.plusMonths(1).plusDays(10);
 * if (due.isAfter(d)) {
 *     #String s = due.iso();                        // "2026-07-15"
 * }
 * ```
 */
public final class LocalDate implements Comparable<LocalDate> {
    int64 epochDay;

    /**
     * Wraps a raw epoch-day directly (no validation). Prefer the `of` /
     * `ofEpochDay` factories; reach for this only when you already hold a
     * days-since-1970 count.
     *
     * ```cajeta
     * stack LocalDate epoch = LocalDate(0);   // 1970-01-01
     * ```
     */
    public LocalDate(int64 epochDay) {
        this.epochDay = epochDay;
    }

    /** True iff `year` is a Gregorian leap year. */
    @Inline
    public static boolean isLeapYear(int32 year) {
        if (year % 4 != 0) {
            return false;
        }
        if (year % 100 != 0) {
            return true;
        }
        return year % 400 == 0;
    }

    /** Number of days in `month` (1..12) of `year`. */
    @Inline
    public static int32 lengthOfMonth(int32 year, int32 month) {
        if (month == 2) {
            if (LocalDate.isLeapYear(year)) {
                return 29;
            }
            return 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) {
            return 30;
        }
        return 31;
    }

    // Howard Hinnant's days_from_civil: epoch-day for a y/m/d (truncated
    // integer division throughout; the era adjustment makes it correct for
    // negative years).
    static int64 daysFromCivil(int32 year, int32 month, int32 day) {
        int64 y = (int64) year;
        if (month <= 2) {
            y = y - 1;
        }
        int64 era;
        if (y >= 0) {
            era = y / 400;
        } else {
            era = (y - 399) / 400;
        }
        int64 yoe = y - era * 400;
        int64 mp;
        if (month > 2) {
            mp = (int64) month - 3;
        } else {
            mp = (int64) month + 9;
        }
        int64 doy = (153 * mp + 2) / 5 + (int64) day - 1;
        int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        return era * 146097 + doe - 719468;
    }

    // civil_from_days, split across three accessors (cajeta has no tuple
    // return); each recomputes the shared prologue. Truncated division.
    static int32 civilYear(int64 z) {
        int64 zz = z + 719468;
        int64 era;
        if (zz >= 0) {
            era = zz / 146097;
        } else {
            era = (zz - 146096) / 146097;
        }
        int64 doe = zz - era * 146097;
        int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int64 y = yoe + era * 400;
        int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int64 mp = (5 * doy + 2) / 153;
        int64 m;
        if (mp < 10) {
            m = mp + 3;
        } else {
            m = mp - 9;
        }
        if (m <= 2) {
            y = y + 1;
        }
        return (int32) y;
    }

    static int32 civilMonth(int64 z) {
        int64 zz = z + 719468;
        int64 era;
        if (zz >= 0) {
            era = zz / 146097;
        } else {
            era = (zz - 146096) / 146097;
        }
        int64 doe = zz - era * 146097;
        int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int64 mp = (5 * doy + 2) / 153;
        if (mp < 10) {
            return (int32) (mp + 3);
        }
        return (int32) (mp - 9);
    }

    static int32 civilDay(int64 z) {
        int64 zz = z + 719468;
        int64 era;
        if (zz >= 0) {
            era = zz / 146097;
        } else {
            era = (zz - 146096) / 146097;
        }
        int64 doe = zz - era * 146097;
        int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int64 mp = (5 * doy + 2) / 153;
        return (int32) (doy - (153 * mp + 2) / 5 + 1);
    }

    /**
     * A validated date. Throws `DateTimeException` on an out-of-range month
     * or a non-existent day (e.g. February 30).
     *
     * ```cajeta
     * stack LocalDate d = LocalDate.of(2026, 2, 28);   // ok
     * stack LocalDate bad = LocalDate.of(2026, 2, 30); // throws `DateTimeException`
     * ```
     */
    @NoInline
    public static LocalDate of(int32 year, int32 month, int32 day) {
        if (month < 1 || month > 12) {
            throw heap DateTimeException("LocalDate: month out of range 1..12");
        }
        if (day < 1 || day > LocalDate.lengthOfMonth(year, month)) {
            throw heap DateTimeException("LocalDate: day out of range for month");
        }
        int64 ed = LocalDate.daysFromCivil(year, month, day);
        return stack LocalDate(ed);
    }

    /**
     * The date `epochDay` days after 1970-01-01 (negative for earlier).
     *
     * ```cajeta
     * stack LocalDate d = LocalDate.ofEpochDay(20609);   // 2026-06-05
     * stack LocalDate epoch = LocalDate.ofEpochDay(0);    // 1970-01-01
     * ```
     */
    @Inline
    public static LocalDate ofEpochDay(int64 epochDay) {
        return stack LocalDate(epochDay);
    }

    public int32 getYear() {
        return LocalDate.civilYear(this.epochDay);
    }

    public int32 getMonthValue() {
        return LocalDate.civilMonth(this.epochDay);
    }

    public int32 getDayOfMonth() {
        return LocalDate.civilDay(this.epochDay);
    }

    /** ISO day-of-week: Monday = 1 … Sunday = 7. */
    public int32 getDayOfWeek() {
        int64 dow = (this.epochDay + 3) % 7;
        if (dow < 0) {
            dow = dow + 7;
        }
        return (int32) (dow + 1);
    }

    /** Days since 1970-01-01. */
    @Inline
    public int64 toEpochDay() {
        return this.epochDay;
    }

    /** True iff this date is in a leap year. */
    @Inline
    public boolean isLeap() {
        return LocalDate.isLeapYear(this.getYear());
    }

    /** This date plus `days` days. */
    @Inline
    public LocalDate plusDays(int64 days) {
        return stack LocalDate(this.epochDay + days);
    }

    /** This date plus `weeks` weeks. */
    @Inline
    public LocalDate plusWeeks(int64 weeks) {
        return stack LocalDate(this.epochDay + weeks * 7);
    }

    /**
     * This date plus `months` months. The day-of-month is clamped to the end of
     * the target month (2026-01-31 + 1 month = 2026-02-28).
     */
    public LocalDate plusMonths(int64 months) {
        int32 y = this.getYear();
        int32 m = this.getMonthValue();
        int32 d = this.getDayOfMonth();
        int64 mi = (int64) (m - 1) + months;
        int64 ny = (int64) y + mi / 12;
        int64 nm = mi % 12;
        if (nm < 0) {
            nm = nm + 12;
            ny = ny - 1;
        }
        int32 nmo = (int32) (nm + 1);
        int32 maxD = LocalDate.lengthOfMonth((int32) ny, nmo);
        int32 nd = d;
        if (nd > maxD) {
            nd = maxD;
        }
        int64 ed = LocalDate.daysFromCivil((int32) ny, nmo, nd);
        return stack LocalDate(ed);
    }

    /** This date plus `years` years (Feb 29 clamps to Feb 28 off leap years). */
    public LocalDate plusYears(int64 years) {
        int32 m = this.getMonthValue();
        int32 d = this.getDayOfMonth();
        int64 ny = (int64) this.getYear() + years;
        int32 maxD = LocalDate.lengthOfMonth((int32) ny, m);
        int32 nd = d;
        if (nd > maxD) {
            nd = maxD;
        }
        int64 ed = LocalDate.daysFromCivil((int32) ny, m, nd);
        return stack LocalDate(ed);
    }

    /**
     * This date plus a calendar `Period`: years and months are applied
     * together (clamping the day to the resulting month), then days are added.
     */
    public LocalDate plus(Period p) {
        int32 y = this.getYear();
        int32 m = this.getMonthValue();
        int32 d = this.getDayOfMonth();
        int64 totalMonths = (int64) y * 12 + (int64) (m - 1) + p.toTotalMonths();
        int64 ny = totalMonths / 12;
        int64 nm = totalMonths % 12;
        if (nm < 0) {
            nm = nm + 12;
            ny = ny - 1;
        }
        int32 nmo = (int32) (nm + 1);
        int32 maxD = LocalDate.lengthOfMonth((int32) ny, nmo);
        int32 nd = d;
        if (nd > maxD) {
            nd = maxD;
        }
        int64 ed = LocalDate.daysFromCivil((int32) ny, nmo, nd) + (int64) p.getDays();
        return stack LocalDate(ed);
    }

    /**
     * Total order: negative if this is earlier than `other`, zero if equal,
     * positive if later.
     */
    @Inline
    public int32 compareTo(LocalDate other) {
        if (this.epochDay < other.epochDay) {
            return -1;
        }
        if (this.epochDay > other.epochDay) {
            return 1;
        }
        return 0;
    }

    /** True iff this date is strictly before `other`. */
    @Inline
    public boolean isBefore(LocalDate other) {
        return this.epochDay < other.epochDay;
    }

    /** True iff this date is strictly after `other`. */
    @Inline
    public boolean isAfter(LocalDate other) {
        return this.epochDay > other.epochDay;
    }

    /** Structural equality by epoch-day. */
    public static boolean operator== (LocalDate a, LocalDate b) {
        return a.epochDay == b.epochDay;
    }

    /** Content hash of the epoch-day. */
    public int64 hash() {
        return this.epochDay;
    }

    /**
     * ISO-8601 `yyyy-MM-dd` (year padded to at least 4 digits; a leading `-`
     * for negative years). Returns an owned `#String`.
     *
     * ```cajeta
     * #String s = LocalDate.of(2026, 6, 5).iso();   // "2026-06-05"
     * ```
     */
    public #String iso() {
        int32 y = this.getYear();
        int32 mo = this.getMonthValue();
        int32 d = this.getDayOfMonth();
        boolean neg = y < 0;
        int32 ay = y;
        if (neg) {
            ay = -y;
        }
        int32 yw = Fmt.width((int64) ay);
        if (yw < 4) {
            yw = 4;
        }
        int32 len = yw + 6;
        if (neg) {
            len = len + 1;
        }
        int8[] buf = heap int8[len];
        int32 p = 0;
        if (neg) {
            p = Fmt.writeChar(buf, p, 45); // '-'
        }
        p = Fmt.writeUint(buf, p, (int64) ay, 4);
        p = Fmt.writeChar(buf, p, 45); // '-'
        p = Fmt.writeUint(buf, p, (int64) mo, 2);
        p = Fmt.writeChar(buf, p, 45); // '-'
        p = Fmt.writeUint(buf, p, (int64) d, 2);
        return heap String(#buf, len);
    }
}
