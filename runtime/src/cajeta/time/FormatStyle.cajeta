package cajeta.time;

/**
 * Standardized, ready-made date/time formats for
 * `DateTimeFormatter.ofStandard(...)`, so the common shapes are one call away.
 *
 *  - `ISO_LOCAL_DATE`       `2026-06-05`
 *  - `ISO_LOCAL_TIME`       `14:03:09`
 *  - `ISO_LOCAL_DATE_TIME`  `2026-06-05T14:03:09`
 *  - `ISO_OFFSET_DATE_TIME` `2026-06-05T14:03:09+02:00`
 *  - `ISO_INSTANT`          `2026-06-05T14:03:09Z` (render a zoned/offset value)
 *  - `BASIC_ISO_DATE`       `20260605`
 *  - `RFC_1123_DATE_TIME`   `Fri, 05 Jun 2026 14:03:09 GMT`
 *  - `US_DATE`              `06/05/2026`
 *  - `EURO_DATE`            `05.06.2026`
 *  - `SQL_TIMESTAMP`        `2026-06-05 14:03:09`
 */
public enum FormatStyle {
    ISO_LOCAL_DATE,
    ISO_LOCAL_TIME,
    ISO_LOCAL_DATE_TIME,
    ISO_OFFSET_DATE_TIME,
    ISO_INSTANT,
    BASIC_ISO_DATE,
    RFC_1123_DATE_TIME,
    US_DATE,
    EURO_DATE,
    SQL_TIMESTAMP
}
