package cajeta.time;

import cajeta.lang.Comparable;

/**
 * A fixed offset from UTC, e.g. `+05:30`, `-08:00`, or `Z` (UTC). Modeled on
 * `java.time.ZoneOffset`. Stored as a single `int32` total-seconds value in
 * `[-64800, 64800]` (±18 hours). A pure stack value type: every factory returns
 * a fresh `stack` value by copy.
 *
 * This is the v1 backbone for zoned date-times: region `ZoneId` lookups against
 * the system tz database are deferred, but fixed offsets fully support
 * `Instant` ↔ `ZonedDateTime` conversion. Implements `Comparable`, so
 * offsets sort by their second count.
 *
 * Build one through the `of*`/`utc` factories rather than the raw constructor;
 * they range-check the result and throw `DateTimeException` on bad input.
 *
 * ```cajeta
 * stack ZoneOffset ist = ZoneOffset.ofHoursMinutes(5, 30);  // +05:30
 * stack ZoneOffset pst = ZoneOffset.ofHours(-8);            // -08:00
 * boolean east = ist.compareTo(pst) > 0;                    // true
 * #String id = ist.iso();                                   // "+05:30"
 * ```
 */
public final class ZoneOffset implements Comparable<ZoneOffset> {
    int32 totalSeconds;

    /**
     * A raw offset from a `totalSeconds` value; performs no range check. Prefer
     * the `of*`/`utc` factories, which validate the ±18h bound for you.
     *
     * ```cajeta
     * stack ZoneOffset z = stack ZoneOffset(19800);  // +05:30
     * ```
     */
    public ZoneOffset(int32 totalSeconds) {
        this.totalSeconds = totalSeconds;
    }

    /**
     * Offset of `totalSeconds` seconds from UTC (±18h); throws
     * `DateTimeException` outside `[-64800, 64800]`.
     *
     * ```cajeta
     * stack ZoneOffset z = ZoneOffset.ofTotalSeconds(-28800);  // -08:00
     * ```
     */
    @NoInline
    public static ZoneOffset ofTotalSeconds(int32 totalSeconds) {
        if (totalSeconds < -64800 || totalSeconds > 64800) {
            throw heap DateTimeException("ZoneOffset: out of range +/-18:00");
        }
        return stack ZoneOffset(totalSeconds);
    }

    /**
     * Offset of a whole number of hours from UTC; throws `DateTimeException`
     * if `hours` is outside ±18.
     *
     * ```cajeta
     * stack ZoneOffset z = ZoneOffset.ofHours(2);  // +02:00
     * ```
     */
    @NoInline
    public static ZoneOffset ofHours(int32 hours) {
        if (hours < -18 || hours > 18) {
            throw heap DateTimeException("ZoneOffset: hours out of range +/-18");
        }
        return stack ZoneOffset(hours * 3600);
    }

    /**
     * Offset of hours and minutes; both parts must share the offset's sign.
     * Throws `DateTimeException` on out-of-range parts, a sign mismatch, or a
     * total beyond ±18h.
     *
     * ```cajeta
     * stack ZoneOffset z = ZoneOffset.ofHoursMinutes(-3, -30);  // -03:30
     * ```
     */
    @NoInline
    public static ZoneOffset ofHoursMinutes(int32 hours, int32 minutes) {
        if (hours < -18 || hours > 18) {
            throw heap DateTimeException("ZoneOffset: hours out of range +/-18");
        }
        if (minutes < -59 || minutes > 59) {
            throw heap DateTimeException("ZoneOffset: minutes out of range");
        }
        if (hours < 0 && minutes > 0) {
            throw heap DateTimeException("ZoneOffset: sign mismatch between hours and minutes");
        }
        if (hours > 0 && minutes < 0) {
            throw heap DateTimeException("ZoneOffset: sign mismatch between hours and minutes");
        }
        int32 total = hours * 3600 + minutes * 60;
        if (total < -64800 || total > 64800) {
            throw heap DateTimeException("ZoneOffset: out of range +/-18:00");
        }
        return stack ZoneOffset(total);
    }

    /**
     * The UTC offset (zero), the `Z` of `+00:00`.
     *
     * ```cajeta
     * stack ZoneOffset z = ZoneOffset.utc();  // iso() == "Z"
     * ```
     */
    @Inline
    public static ZoneOffset utc() {
        return stack ZoneOffset(0);
    }

    /** Total offset in seconds from UTC (may be negative). */
    @Inline
    public int32 getTotalSeconds() {
        return this.totalSeconds;
    }

    /** Total order by offset seconds (java.time orders larger offsets first;
        we use natural ascending order on the second count). */
    @Inline
    public int32 compareTo(ZoneOffset other) {
        if (this.totalSeconds < other.totalSeconds) {
            return -1;
        }
        if (this.totalSeconds > other.totalSeconds) {
            return 1;
        }
        return 0;
    }

    /** Structural equality by offset seconds. */
    public static boolean operator== (ZoneOffset a, ZoneOffset b) {
        return a.totalSeconds == b.totalSeconds;
    }

    /** Content hash of the offset seconds. */
    public int64 hash() {
        return (int64) this.totalSeconds;
    }

    /**
     * The ISO offset id: `Z` for UTC, else `+HH:mm` / `-HH:mm` (`:ss` appended
     * only when the offset has a nonzero seconds part).
     *
     * ```cajeta
     * #String s = ZoneOffset.ofHoursMinutes(5, 30).iso();  // "+05:30"
     * ```
     */
    public #String iso() {
        if (this.totalSeconds == 0) {
            int8[] z = heap int8[1];
            z[0] = (int8) 90; // 'Z'
            return heap String(#z, 1);
        }
        int32 t = this.totalSeconds;
        int32 sign = 43; // '+'
        if (t < 0) {
            sign = 45; // '-'
            t = -t;
        }
        int32 hh = t / 3600;
        int32 mm = (t % 3600) / 60;
        int32 ss = t % 60;
        int32 len = 6;
        if (ss > 0) {
            len = 9;
        }
        int8[] buf = heap int8[len];
        int32 p = 0;
        p = Fmt.writeChar(buf, p, sign);
        p = Fmt.writeUint(buf, p, (int64) hh, 2);
        p = Fmt.writeChar(buf, p, 58); // ':'
        p = Fmt.writeUint(buf, p, (int64) mm, 2);
        if (ss > 0) {
            p = Fmt.writeChar(buf, p, 58); // ':'
            p = Fmt.writeUint(buf, p, (int64) ss, 2);
        }
        return heap String(#buf, len);
    }
}
