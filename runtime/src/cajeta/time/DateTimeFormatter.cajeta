package cajeta.time;

/**
 * Formats temporal values to text, modeled on `java.time.format.DateTimeFormatter`,
 * built so you never have to reverse-engineer a pattern letter:
 *
 *  1. **Standard formats** — `DateTimeFormatter.ofStandard(FormatStyle.ISO_LOCAL_DATE_TIME)`,
 *     `FormatStyle.RFC_1123_DATE_TIME`, etc. (see `FormatStyle`).
 *  2. **printf/strftime-style patterns** —
 *     `DateTimeFormatter.ofPattern("%Y-%m-%d %H:%M:%S")` — full control over the
 *     exact format with a one-liner (the codes are listed below).
 *
 * (A fluent step-builder decorator was prototyped but is deferred: cajeta's
 * codegen for self-returning fluent methods on a heap object isn't sound yet —
 * see plans/time. `ofPattern` covers the same need concisely.)
 *
 * Render with `formatDate` / `formatTime` / `formatDateTime` / `formatZoned`, or
 * `format(`DateTimeFields`)`. Output is an owned `#String`; text is English.
 *
 * The formatter is **immutable** — it holds only its strftime pattern string and
 * parses it on each `format` call. (Cajeta's borrow/ABI rules make a mutable
 * step-list builder object impractical, so the canonical internal form is the
 * pattern string; the fluent builder simply assembles one.)
 *
 * **strftime codes**: `%Y` year, `%y` 2-digit year, `%m` month, `%d` day,
 * `%H` hour24, `%I` hour12, `%M` minute, `%S` second, `%p` AM/PM, `%j` day-of-year,
 * `%b`/`%h` short month, `%B` full month, `%a` short weekday, `%A` full weekday,
 * `%z` offset `±HHMM`, `%Z` offset `Z`/`±HH:MM`, `%f` 9-digit fraction,
 * `%L` 3-digit (milli) fraction, `%%` literal `%`, `%n` newline, `%t` tab.
 */
public final class DateTimeFormatter {
    String pattern;

    /**
     * Wraps a raw strftime `pattern`. Prefer the `FormatStyle`-aware
     * `ofStandard` or the explicit `ofPattern` factory over calling this directly —
     * they return an owned `#DateTimeFormatter`:
     *
     * ```cajeta
     * DateTimeFormatter fmt #= DateTimeFormatter.ofPattern("%Y-%m-%d %H:%M:%S");
     * DateTimeFormatter iso #= DateTimeFormatter.ofStandard(FormatStyle.ISO_LOCAL_DATE_TIME);
     * ```
     */
    public DateTimeFormatter(String pattern) {
        // Copies (§2.5): the formatter keeps the pattern for its life;
        // a borrowed pattern from a dropped builder would dangle.
        this.pattern = "" + pattern;
    }

    /**
     * A formatter for a strftime-style pattern (see class docs for codes).
     *
     * ```cajeta
     * DateTimeFormatter fmt #= DateTimeFormatter.ofPattern("%a, %d %b %Y %H:%M");
     * String out #= fmt.formatDateTime(dt);   // "Fri, 05 Jun 2026 13:07"
     * ```
     *
     * @EntryPoint
     */
    public static #DateTimeFormatter ofPattern(String pattern) {
        return heap DateTimeFormatter(pattern);
    }

    /**
     * A formatter for a standard `FormatStyle`.
     *
     * ```cajeta
     * DateTimeFormatter iso #= DateTimeFormatter.ofStandard(FormatStyle.ISO_LOCAL_DATE_TIME);
     * String out #= iso.formatDateTime(dt);    // "2026-06-05T13:07:00"
     * ```
     *
     * @EntryPoint
     */
    public static #DateTimeFormatter ofStandard(FormatStyle style) {
        String p = "%Y-%m-%d";
        if (style == FormatStyle.ISO_LOCAL_TIME) {
            p = "%H:%M:%S";
        } else if (style == FormatStyle.ISO_LOCAL_DATE_TIME) {
            p = "%Y-%m-%dT%H:%M:%S";
        } else if (style == FormatStyle.ISO_OFFSET_DATE_TIME) {
            p = "%Y-%m-%dT%H:%M:%S%Z";
        } else if (style == FormatStyle.ISO_INSTANT) {
            p = "%Y-%m-%dT%H:%M:%S%Z";
        } else if (style == FormatStyle.BASIC_ISO_DATE) {
            p = "%Y%m%d";
        } else if (style == FormatStyle.RFC_1123_DATE_TIME) {
            p = "%a, %d %b %Y %H:%M:%S GMT";
        } else if (style == FormatStyle.US_DATE) {
            p = "%m/%d/%Y";
        } else if (style == FormatStyle.EURO_DATE) {
            p = "%d.%m.%Y";
        } else if (style == FormatStyle.SQL_TIMESTAMP) {
            p = "%Y-%m-%d %H:%M:%S";
        }
        return heap DateTimeFormatter(p);
    }

    /** VIEW of the stored pattern — borrow, valid while this DateTimeFormatter lives. */
    @Inline
    public String getPattern() {
        return this.pattern;
    }

    /**
     * Render the `DateTimeFields` `f` by parsing this formatter's pattern.
     * Returns an owned `#String`. Unknown `%` codes emit a literal `%` rather
     * than throwing.
     *
     * ```cajeta
     * DateTimeFormatter fmt #= DateTimeFormatter.ofPattern("%Y-%m-%d");
     * String out #= fmt.format(DateTimeFields.ofDate(d));
     * ```
     */
    public #String format(DateTimeFields f) {
        int32 n = this.pattern.byteLength();
        // Generous upper bound: each '%X' can expand to a name/year (<=16),
        // each literal byte is itself. Oversized; the String length is exact.
        int32 cap = n * 16 + 16;
        int8[] buf = heap int8[cap];
        int32 p = 0;
        int32 i = 0;
        while (i < n) {
            int32 c = ((int32) this.pattern.byteAt(i)) & 0xff;
            if (c == 37 && i + 1 < n) { // '%'
                int32 code = ((int32) this.pattern.byteAt(i + 1)) & 0xff;
                p = DateTimeFormatter.emit(buf, p, code, f);
                i = i + 2;
            } else {
                buf[p] = this.pattern.byteAt(i);
                p = p + 1;
                i = i + 1;
            }
        }
        return heap String(#buf, p);
    }

    /**
     * Format a `LocalDate` (date fields only).
     *
     * ```cajeta
     * String out #= DateTimeFormatter.ofStandard(FormatStyle.US_DATE).formatDate(d);
     * ```
     */
    @Inline
    public #String formatDate(LocalDate d) {
        DateTimeFields f #= DateTimeFields.ofDate(d);
        return this.format(f);
    }

    /**
     * Format a `LocalTime` (time-of-day fields only).
     *
     * ```cajeta
     * String out #= DateTimeFormatter.ofPattern("%H:%M:%S").formatTime(t);
     * ```
     */
    @Inline
    public #String formatTime(LocalTime t) {
        DateTimeFields f #= DateTimeFields.ofTime(t);
        return this.format(f);
    }

    /**
     * Format a zone-naive `LocalDateTime` (date and time fields, no offset).
     *
     * ```cajeta
     * String out #= DateTimeFormatter.ofStandard(FormatStyle.SQL_TIMESTAMP).formatDateTime(t);
     * ```
     */
    @Inline
    public #String formatDateTime(LocalDateTime t) {
        DateTimeFields f #= DateTimeFields.ofDateTime(t);
        return this.format(f);
    }

    /**
     * Format a `ZonedDateTime` — the offset codes `%z` / `%Z` become available.
     *
     * ```cajeta
     * String out #= DateTimeFormatter.ofPattern("%Y-%m-%dT%H:%M:%S%Z").formatZoned(z);
     * ```
     */
    @Inline
    public #String formatZoned(ZonedDateTime z) {
        DateTimeFields f #= DateTimeFields.ofZoned(z);
        return this.format(f);
    }

    /** Render one strftime `code` into `buf` at `p`; returns the new write position. */
    @NoInline
    static int32 emit(int8[] buf, int32 p, int32 code, DateTimeFields f) {
        if (code == 89) { // Y
            return DateTimeFormatter.writeYear(buf, p, f.year, 4);
        }
        if (code == 121) { // y
            int32 yy = f.year % 100;
            if (yy < 0) {
                yy = yy + 100;
            }
            return Fmt.writeUint(buf, p, (int64) yy, 2);
        }
        if (code == 109) { // m
            return Fmt.writeUint(buf, p, (int64) f.month, 2);
        }
        if (code == 100) { // d
            return Fmt.writeUint(buf, p, (int64) f.day, 2);
        }
        if (code == 72) { // H
            return Fmt.writeUint(buf, p, (int64) f.hour, 2);
        }
        if (code == 73) { // I
            int32 h = f.hour % 12;
            if (h == 0) {
                h = 12;
            }
            return Fmt.writeUint(buf, p, (int64) h, 2);
        }
        if (code == 77) { // M
            return Fmt.writeUint(buf, p, (int64) f.minute, 2);
        }
        if (code == 83) { // S
            return Fmt.writeUint(buf, p, (int64) f.second, 2);
        }
        if (code == 112) { // p
            int32 ap = 65; // 'A'
            if (f.hour >= 12) {
                ap = 80; // 'P'
            }
            int32 q = Fmt.writeChar(buf, p, ap);
            return Fmt.writeChar(buf, q, 77); // 'M'
        }
        if (code == 106) { // j  day-of-year
            int64 ed = LocalDate.daysFromCivil(f.year, f.month, f.day);
            int64 jan1 = LocalDate.daysFromCivil(f.year, 1, 1);
            int32 doy = (int32) (ed - jan1) + 1;
            return Fmt.writeUint(buf, p, (int64) doy, 3);
        }
        if (code == 98 || code == 104) { // b / h short month
            // 6.2.2: short names are Inline literals (no root array) —
            // materialize the window for the bulk write.
            String mn = DateTimeFormatter.monthShort(f.month);
            int8[] mb #= mn.toBytes();
            return Fmt.writeBytes(buf, p, mb, mn.byteLength());
        }
        if (code == 66) { // B full month
            String mn = DateTimeFormatter.monthLong(f.month);
            int8[] mb #= mn.toBytes();
            return Fmt.writeBytes(buf, p, mb, mn.byteLength());
        }
        if (code == 97) { // a short weekday
            String dn = DateTimeFormatter.dowShort(f.dayOfWeek);
            int8[] db #= dn.toBytes();
            return Fmt.writeBytes(buf, p, db, dn.byteLength());
        }
        if (code == 65) { // A full weekday
            String dn = DateTimeFormatter.dowLong(f.dayOfWeek);
            int8[] db #= dn.toBytes();
            return Fmt.writeBytes(buf, p, db, dn.byteLength());
        }
        if (code == 122) { // z  +HHMM
            return DateTimeFormatter.writeOffset(buf, p, f.offsetSeconds, false);
        }
        if (code == 90) { // Z  Z / +HH:MM
            return DateTimeFormatter.writeOffset(buf, p, f.offsetSeconds, true);
        }
        if (code == 102) { // f  9-digit fraction
            return DateTimeFormatter.writeFraction(buf, p, f.nano, 9);
        }
        if (code == 76) { // L  3-digit fraction
            return DateTimeFormatter.writeFraction(buf, p, f.nano, 3);
        }
        if (code == 110) { // n
            return Fmt.writeChar(buf, p, 10);
        }
        if (code == 116) { // t
            return Fmt.writeChar(buf, p, 9);
        }
        if (code == 37) { // %
            return Fmt.writeChar(buf, p, 37);
        }
        // Unknown: emit a literal '%' so the input isn't silently dropped.
        return Fmt.writeChar(buf, p, 37);
    }

    /** Write `year` zero-padded to `width`, prefixing `-` for negative (proleptic) years. */
    @NoInline
    static int32 writeYear(int8[] buf, int32 p, int32 year, int32 width) {
        int32 w = width;
        if (w < 1) {
            w = 1;
        }
        int32 q = p;
        int32 ay = year;
        if (year < 0) {
            q = Fmt.writeChar(buf, q, 45);
            ay = -year;
        }
        return Fmt.writeUint(buf, q, (int64) ay, w);
    }

    /** Write the `nano` sub-second fraction truncated to `digits` (clamped to 1..9). */
    @NoInline
    static int32 writeFraction(int8[] buf, int32 p, int32 nano, int32 digits) {
        int32 d = digits;
        if (d < 1) {
            d = 1;
        }
        if (d > 9) {
            d = 9;
        }
        int64 div = 1;
        int32 k = 0;
        while (k < 9 - d) {
            div = div * 10;
            k = k + 1;
        }
        return Fmt.writeUint(buf, p, (int64) nano / div, d);
    }

    /**
     * Write a UTC offset. `withColon` selects `±HH:MM` (and `Z` for zero) for `%Z`;
     * otherwise `±HHMM` (zero renders `+0000`) for `%z`.
     */
    @NoInline
    static int32 writeOffset(int8[] buf, int32 p, int32 offsetSeconds, boolean withColon) {
        if (offsetSeconds == 0) {
            if (withColon) {
                return Fmt.writeChar(buf, p, 90); // 'Z'
            }
            int32 r = Fmt.writeChar(buf, p, 43);
            return Fmt.writeUint(buf, r, 0, 4);
        }
        int32 q = p;
        int32 sign = 43;
        int32 t = offsetSeconds;
        if (t < 0) {
            sign = 45;
            t = -t;
        }
        int32 oh = t / 3600;
        int32 om = (t % 3600) / 60;
        q = Fmt.writeChar(buf, q, sign);
        q = Fmt.writeUint(buf, q, (int64) oh, 2);
        if (withColon) {
            q = Fmt.writeChar(buf, q, 58);
        }
        q = Fmt.writeUint(buf, q, (int64) om, 2);
        return q;
    }

    /** English 3-letter month name for `m` (1..12); `"???"` if out of range. */
    static String monthShort(int32 m) {
        if (m == 1) { return "Jan"; }
        if (m == 2) { return "Feb"; }
        if (m == 3) { return "Mar"; }
        if (m == 4) { return "Apr"; }
        if (m == 5) { return "May"; }
        if (m == 6) { return "Jun"; }
        if (m == 7) { return "Jul"; }
        if (m == 8) { return "Aug"; }
        if (m == 9) { return "Sep"; }
        if (m == 10) { return "Oct"; }
        if (m == 11) { return "Nov"; }
        if (m == 12) { return "Dec"; }
        return "???";
    }

    /** Full English month name for `m` (1..12); `"???"` if out of range. */
    static String monthLong(int32 m) {
        if (m == 1) { return "January"; }
        if (m == 2) { return "February"; }
        if (m == 3) { return "March"; }
        if (m == 4) { return "April"; }
        if (m == 5) { return "May"; }
        if (m == 6) { return "June"; }
        if (m == 7) { return "July"; }
        if (m == 8) { return "August"; }
        if (m == 9) { return "September"; }
        if (m == 10) { return "October"; }
        if (m == 11) { return "November"; }
        if (m == 12) { return "December"; }
        return "???";
    }

    /** English 3-letter weekday for `d` (1=Mon..7=Sun); `"???"` if out of range. */
    static String dowShort(int32 d) {
        if (d == 1) { return "Mon"; }
        if (d == 2) { return "Tue"; }
        if (d == 3) { return "Wed"; }
        if (d == 4) { return "Thu"; }
        if (d == 5) { return "Fri"; }
        if (d == 6) { return "Sat"; }
        if (d == 7) { return "Sun"; }
        return "???";
    }

    /** Full English weekday name for `d` (1=Mon..7=Sun); `"???"` if out of range. */
    static String dowLong(int32 d) {
        if (d == 1) { return "Monday"; }
        if (d == 2) { return "Tuesday"; }
        if (d == 3) { return "Wednesday"; }
        if (d == 4) { return "Thursday"; }
        if (d == 5) { return "Friday"; }
        if (d == 6) { return "Saturday"; }
        if (d == 7) { return "Sunday"; }
        return "???";
    }
}
