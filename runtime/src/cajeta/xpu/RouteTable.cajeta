package cajeta.xpu;

import cajeta.collection.ArrayList;
import cajeta.lang.String;

/**
 * The rows a package registers and the selector that resolves among them.
 *
 * It replaces the per-route predicates that restate, once per file, which
 * format may take which kernel. Those drift: a predicate written when a route
 * was added names the formats that existed then, and the next format is
 * refused silently by a route nobody thought to look at.
 *
 * Resolution is a BIND-time call. A weight asks {@link #pick} once and stores
 * the row it got, the way it stores the booleans that row replaces; the launch
 * is then one virtual call and not a table walk.
 *
 * Rows are BORROWED — the registrant owns them and outlives the table — so a
 * table is a view of a registration, not a container of routes.
 */
public final class RouteTable {
    ArrayList<Route> rows;

    public RouteTable() {
        this.rows = heap ArrayList<Route>();
    }

    /** Add a row. Registration order does not reach the answer. */
    public void register(Route r) {
        this.rows.add(r);
        return;
    }

    /**
     * The static half, and what the audit walks: the highest-priority row
     * serving `q`'s format and regime whose shape fits and whose capabilities
     * the device has — with nothing bound and no receiver in hand.
     */
    public Route admissible(RouteQuery q) {
        Route best = null;
        int32 bestPri = 0;
        int32 i = 0;
        while (i < this.rows.count()) {
            Route r = this.rows.get(i);
            if (this.staticAdmits(r, q)) {
                if (best == null || r.priority() > bestPri) {
                    best = r;
                    bestPri = r.priority();
                }
            }
            i = i + 1;
        }
        return best;
    }

    /**
     * {@link #admissible} and READY for this call — the bind-time resolution.
     * A row that fits but whose slab has not bound is skipped here and still
     * reported by the audit, which is the distinction `idReady` loses.
     */
    public Route pick(RouteCall c) {
        Route best = null;
        int32 bestPri = 0;
        int32 i = 0;
        while (i < this.rows.count()) {
            Route r = this.rows.get(i);
            if (this.staticAdmits(r, c.query) && r.readyRefusal(c) == null) {
                if (best == null || r.priority() > bestPri) {
                    best = r;
                    bestPri = r.priority();
                }
            }
            i = i + 1;
        }
        return best;
    }

    /**
     * How many rows are statically admissible. More than one means a shadowed
     * row: the seed of measured selection, reported rather than acted on.
     */
    public int32 admitCount(RouteQuery q) {
        int32 n = 0;
        int32 i = 0;
        while (i < this.rows.count()) {
            if (this.staticAdmits(this.rows.get(i), q)) {
                n = n + 1;
            }
            i = i + 1;
        }
        return n;
    }

    /**
     * Every statically admissible row for `q`, highest `priority` first,
     * written into `out`; the return is the TOTAL found, so a caller whose
     * buffer was short can tell.
     *
     * This is the candidate set, and it is the seam measured selection needs:
     * `priority` is a DECLARED default, and on hardware nobody has measured it
     * is a guess. A selector that ranks these by the tile manifest's footprint
     * or by what the `Autotune` store recorded on this device ranks within a
     * set that is already correct, because admissibility and readiness have
     * both been answered. Fast and wrong is not on the table.
     */
    public int32 candidates(RouteQuery q, Route[] out) {
        int32 cap = (int32) out.count();
        int32 n = 0;
        int32 i = 0;
        while (i < this.rows.count()) {
            if (this.staticAdmits(this.rows.get(i), q)) { n = n + 1; }
            i = i + 1;
        }
        // Ordered by SELECTION over indices, never by moving rows through a
        // temporary: an interface array element is stored inline and a local
        // bound to one aliases the slot, so a three-way swap writes the same
        // row into both.
        int32 filled = 0;
        int32 prevPri = 0;
        int32 prevIdx = 0 - 1;
        boolean havePrev = false;
        while (filled < cap) {
            int32 bestIdx = 0 - 1;
            int32 bestPri = 0;
            int32 j = 0;
            while (j < this.rows.count()) {
                Route r = this.rows.get(j);
                if (this.staticAdmits(r, q)) {
                    int32 p = r.priority();
                    boolean after = !havePrev || p < prevPri
                        || (p == prevPri && j > prevIdx);
                    boolean better = bestIdx < 0 || p > bestPri
                        || (p == bestPri && j < bestIdx);
                    if (after && better) {
                        bestIdx = j;
                        bestPri = p;
                    }
                }
                j = j + 1;
            }
            if (bestIdx < 0) { break; }
            out[filled] = this.rows.get(bestIdx);
            filled = filled + 1;
            prevPri = bestPri;
            prevIdx = bestIdx;
            havePrev = true;
        }
        return n;
    }

    /** How many rows are registered. */
    public int32 count() {
        return this.rows.count();
    }

    /** Row `i`, for the audit's walk. */
    public Route rowAt(int32 i) {
        return this.rows.get(i);
    }

    /**
     * The ONE static test, and the clause it stopped at. `admissible`, `pick`,
     * the refusal and the audit all read this, so what the selector decides
     * and what the diagnostic says cannot drift apart.
     */
    public RouteClause clauseOf(Route r, RouteQuery q) {
        if (r.format() != q.ty) { return RouteClause.Format; }
        if (r.regime() != q.regime) { return RouteClause.Regime; }
        if (r.shapeRefusal(q) != null) { return RouteClause.Shape; }
        if (this.missingNeed(r) >= 0) { return RouteClause.Unsupported; }
        return RouteClause.Taken;
    }

    boolean staticAdmits(Route r, RouteQuery q) {
        return this.clauseOf(r, q) == RouteClause.Taken;
    }

    /** Index into `r.needs()` of the first capability this device lacks. */
    int32 missingNeed(Route r) {
        Capability[] n = r.needs();
        if (n == null) { return 0 - 1; }
        int32 k = 0;
        while (k < (int32) n.count()) {
            if (!Device.supports(n[k])) { return k; }
            k = k + 1;
        }
        return 0 - 1;
    }

    /**
     * Why nothing was admissible for `q`, or null when something was.
     *
     * Asked on the refusal path only: resolution itself stays the
     * allocation-free bind-time call it is, and the cost of naming a refusal
     * is paid where something is about to be printed.
     */
    public #RouteRefusal whyNotAdmissible(RouteQuery q) {
        if (this.admissible(q) != null) { return null; }
        return this.refusalFor(q, null);
    }

    /** Why nothing was picked for `c`, or null when something was. */
    public #RouteRefusal whyNotPicked(RouteCall c) {
        if (this.pick(c) != null) { return null; }
        return this.refusalFor(c.query, c);
    }

    /**
     * The row that got FURTHEST, and the clause that stopped it. `c` null asks
     * the static half alone; with a call, a row that passes the static half
     * has been refused by its own `readyRefusal`.
     */
    #RouteRefusal refusalFor(RouteQuery q, RouteCall c) {
        if (this.rows.count() == 0) {
            return heap RouteRefusal(null, RouteClause.Empty, q.regime, q.ty,
                null, 0 - 1);
        }
        Route best = null;
        RouteClause bestClause = RouteClause.Empty;
        int32 bestRank = 0 - 1;
        int32 bestPri = 0;
        int32 i = 0;
        while (i < this.rows.count()) {
            Route r = this.rows.get(i);
            RouteClause cl = this.clauseOf(r, q);
            if (cl == RouteClause.Taken) { cl = RouteClause.Ready; }
            int32 rank = RouteTable.rankOf(cl);
            boolean better = rank > bestRank
                || (rank == bestRank && r.priority() > bestPri);
            if (better) {
                best = r;
                bestClause = cl;
                bestRank = rank;
                bestPri = r.priority();
            }
            i = i + 1;
        }
        if (bestClause == RouteClause.Shape) {
            return heap RouteRefusal(best, bestClause, q.regime, q.ty,
                best.shapeRefusal(q), 0 - 1);
        }
        if (bestClause == RouteClause.Unsupported) {
            return heap RouteRefusal(best, bestClause, q.regime, q.ty,
                null, this.missingNeed(best));
        }
        if (bestClause == RouteClause.Ready) {
            String gate = null;
            if (c != null) { gate = best.readyRefusal(c); }
            return heap RouteRefusal(best, bestClause, q.regime, q.ty,
                gate, 0 - 1);
        }
        return heap RouteRefusal(best, bestClause, q.regime, q.ty, null, 0 - 1);
    }

    /** How far a clause got. The refusal names the row that got furthest. */
    static int32 rankOf(RouteClause c) {
        if (c == RouteClause.Format) { return 1; }
        if (c == RouteClause.Regime) { return 2; }
        if (c == RouteClause.Shape) { return 3; }
        if (c == RouteClause.Unsupported) { return 4; }
        if (c == RouteClause.Ready) { return 5; }
        return 0;
    }
}
