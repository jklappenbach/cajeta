package cajeta.xpu;

/**
 * Workgroup — per-workgroup coordinate builtins. Only meaningful
 * inside @Kernel / @Device functions. See CajetaXPU.md §3.2.
 *
 * `x()/y()/z()` is the workgroup's position within the grid;
 * `dimX()/dimY()/dimZ()` is the workgroup's size in threads (the
 * `block` argument passed to launch). Both are constant across all
 * threads in the workgroup.
 *
 *   NVPTX:  llvm.nvvm.read.ptx.sreg.ctaid.{x,y,z}
 *           llvm.nvvm.read.ptx.sreg.ntid.{x,y,z}
 *   AMDGPU: llvm.amdgcn.workgroup.id.{x,y,z}
 *   SPIR-V: OpLoad WorkgroupId / WorkgroupSize
 */
public final class Workgroup {

    @Native("__cajeta_xpu_workgroup_x")
    public static uint32 x();

    @Native("__cajeta_xpu_workgroup_y")
    public static uint32 y();

    @Native("__cajeta_xpu_workgroup_z")
    public static uint32 z();

    @Native("__cajeta_xpu_workgroup_dim_x")
    public static uint32 dimX();

    @Native("__cajeta_xpu_workgroup_dim_y")
    public static uint32 dimY();

    @Native("__cajeta_xpu_workgroup_dim_z")
    public static uint32 dimZ();

    /**
     * Combine `value` from every lane of the workgroup with `op`; every lane receives the
     * result. A barrier: every lane reaches it. Each wave reduces, then the partials combine
     * from wave 0 upward, so a result is the same on every backend at one wave width. Called
     * from host code it acts as a workgroup of one lane and returns `value`.
     */
    @Native("__cajeta_xpu_workgroup_reduce_f32")
    public static float32 reduce(GroupOp op, float32 value);

    /** {@link #reduce} over int32: the sum (wrapping as int32 does), or the signed max or min. */
    @Native("__cajeta_xpu_workgroup_reduce_i32")
    public static int32 reduce(GroupOp op, int32 value);

    /**
     * {@link #reduce} over int64: the sum (wrapping as int64 does), or the signed max or
     * min. An int32 or literal argument still resolves to the int32 form.
     */
    @Native("__cajeta_xpu_workgroup_reduce_i64")
    public static int64 reduce(GroupOp op, int64 value);

    /**
     * EXCLUSIVE scan of `value` over the workgroup's linear order (x, then y, then z): each
     * lane receives `op` combined over every lane before it, and lane 0 the identity (0 for
     * Add, the type's minimum for Max, its maximum for Min). A barrier like {@link #reduce}.
     * Each wave scans its lanes, the wave's last lane stores the wave's total, and each lane
     * combines the totals of the waves before its own with its in-wave prefix. Exact on every
     * backend. Called from host code it acts as a workgroup of one lane and returns the
     * identity.
     */
    @Native("__cajeta_xpu_workgroup_scan_i32")
    public static int32 scan(GroupOp op, int32 value);

    /** {@link #scan} over int64. */
    @Native("__cajeta_xpu_workgroup_scan_i64")
    public static int64 scan(GroupOp op, int64 value);
}
