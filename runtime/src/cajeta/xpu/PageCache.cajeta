package cajeta.xpu;

import cajeta.collection.HashMap;

/**
 * PageCache — generic feedback-driven residency cache with LRU eviction
 * (cajeta-gfx §3, the acceleration/sampling/residency foundation; spec §250).
 * The shared streaming floor under both the virtual-geometry tile streamer and
 * the virtual-texture page cache: a capacity-bounded set of resident tiles where
 * the consumer reports the tiles it needs each frame ({@link #touch}), loads the
 * misses ({@link #admit}), and the cache evicts the least-recently-used tile when
 * it overflows — reporting the victim key ({@link #evictedKey}) so the consumer
 * can release that tile's GPU page.
 *
 * ## Storage (and why it is array-backed)
 *
 * The cache is **borrowed-key**: {@link #admit} takes its key/value by borrow and
 * the consumer keeps reusing the same key objects across `admit`/`touch`/
 * `isResident`. So the cache must never free a key or value it was lent. Storage
 * is therefore parallel **cache-owned arrays** indexed by slot — `slotKey`,
 * `slotVal`, plus `slotPrev`/`slotNext` for an index-linked LRU list (head =
 * most-recently-used, tail = least) and a free list threading unused slots. Array
 * buffers don't recurse into their elements on free, so the borrowed keys/values
 * in `slotKey`/`slotVal` are never dropped — eviction just rewires indices and
 * overwrites a slot. A `HashMap<K,int32>` maps key → slot for O(1) lookup (the map
 * borrows its keys via a plain `put`, so it never frees them either).
 *
 * An intrusive `CacheNode` doubly-linked list (as `cajeta.collection.Cache` uses)
 * was rejected here: a `CacheNode` owns its `key`/`value` fields, and dropping the
 * evicted node mid-frame frees the consumer's still-live key — a use-after-free.
 * See `docs/specification/lang/FieldOwnership.md` (Solution B live-set).
 *
 * {@link #touch} / {@link #admit} splice the slot to the head; an overflowing
 * {@link #admit} drops the tail and publishes its key via {@link #evictedKey}.
 * The RESIDENCY-feedback surface — `touch` returns hit/miss, an eviction publishes
 * the victim key — is what distinguishes it from `Cache`'s memoization surface.
 * There is no TTL: a page is resident until it is the LRU victim.
 *
 * v1: K must be a CLASS type (HashMap keys on `hash()`/`equals()`, which
 * primitives lack) and keys match by identity unless K overrides them; the
 * natural TileKey is a small packed-id class. Not thread-safe (same posture as
 * `HashMap`/`Cache`); a frame's feedback pass is single-threaded.
 */
public final class PageCache<K, V> {

    K[] slotKey;
    V[] slotVal;
    int32[] slotPrev;
    int32[] slotNext;
    HashMap<K, int32> index;
    int32 mruHead;
    int32 lruTail;
    int32 freeHead;
    int32 capacity;
    int32 size;
    /** The key dropped by the most recent overflowing {@link #admit}, or null. */
    K evicted;

    /**
     * Build a residency cache that keeps at most `capacity` tiles. `capacity`
     * must be positive — a cache of size 0 evicts every tile on admit.
     */
    public PageCache(int32 capacity) {
        this.capacity = capacity;
        this.size = 0;
        this.mruHead = -1;
        this.lruTail = -1;
        this.index = heap HashMap<K, int32>(16);
        this.evicted = null;
        int32 cap = capacity;
        if (cap < 1) {
            cap = 1;
        }
        this.slotKey = heap K[cap];
        this.slotVal = heap V[cap];
        this.slotPrev = heap int32[cap];
        this.slotNext = heap int32[cap];
        int32 i = 0;
        while (i < cap) {
            if (i + 1 < cap) {
                this.slotNext[i] = i + 1;
            } else {
                this.slotNext[i] = -1;
            }
            i = i + 1;
        }
        this.freeHead = 0;
    }

    /** Number of resident tiles. */
    @Inline
    public int32 count() {
        return this.size;
    }

    /** The configured residency bound. */
    @Inline
    public int32 capacity() {
        return this.capacity;
    }

    /** True when `key`'s tile is resident. Does NOT promote it (a pure query). */
    public boolean isResident(K key) {
        return this.index.containsKey(key);
    }

    /**
     * Feedback that the consumer needs `key`'s tile this frame. Returns true and
     * promotes the tile to MRU when it is resident (a hit); returns false when it
     * is a miss — the consumer should then load the tile and {@link #admit} it.
     */
    public boolean touch(K key) {
        if (this.index.containsKey(key) == false) {
            return false;
        }
        int32 s = this.index.get(key);
        this.moveToHead(s);
        return true;
    }

    /**
     * Value of a resident tile, or `fallback` on a miss. Promotes the tile on a
     * hit. Takes an explicit fallback so it stays generic over any V (there is no
     * null/zero sentinel for an arbitrary value type).
     *
     * VIEW either way — borrow, valid while the tile stays resident (or, for
     * `fallback`, while the caller's value lives); copy it to retain.
     */
    public V getOrDefault(K key, V fallback) {
        if (this.index.containsKey(key) == false) {
            return fallback;
        }
        int32 s = this.index.get(key);
        this.moveToHead(s);
        return this.slotVal[s];
    }

    /**
     * Bring `key`'s tile into residency with `value` (the consumer loaded it).
     * If the tile is already resident its value is replaced and it is promoted —
     * no eviction. Otherwise it is inserted at the MRU head; if that pushes the
     * cache over `capacity` the LRU tail is evicted and its key is published via
     * {@link #evictedKey}. Returns true exactly when a tile was evicted.
     */
    public boolean admit(K key, V value) {
        // borrow-alias: the cache is an INDEX over consumer-owned tiles —
        // slots hold lends only (eviction publishes the key back via
        // evictedKey, so an owning slot would dangle it). See the
        // eviction-UAF note in the class doc.
        K k = key;
        V v = value;
        if (this.index.containsKey(k)) {
            int32 ex = this.index.get(k);
            this.slotVal[ex] = v;
            this.moveToHead(ex);
            return false;
        }
        boolean evict = false;
        int32 slot = -1;
        if (this.size < this.capacity) {
            slot = this.freeHead;
            this.freeHead = this.slotNext[slot];
            this.size = this.size + 1;
        } else {
            int32 victim = this.lruTail;
            K vkey = this.slotKey[victim];
            this.evicted = vkey;
            this.index.remove(vkey);
            this.unlink(victim);
            slot = victim;
            evict = true;
        }
        this.slotKey[slot] = k;
        this.slotVal[slot] = v;
        this.index.put(k, slot);
        this.linkAtHead(slot);
        return evict;
    }

    /**
     * The key dropped by the most recent overflowing {@link #admit} (valid only
     * when that admit returned true) — the tile whose GPU page the consumer
     * should now free. Null before any eviction.
     *
     * VIEW of the consumer's key — borrow, valid only until the next {@link #admit}.
     */
    @Inline
    public K evictedKey() {
        return this.evicted;
    }

    /** Splice `slot` in as the new MRU head, seeding the tail if the list is empty. */
    void linkAtHead(int32 slot) {
        this.slotPrev[slot] = -1;
        this.slotNext[slot] = this.mruHead;
        if (this.mruHead != -1) {
            this.slotPrev[this.mruHead] = slot;
        }
        this.mruHead = slot;
        if (this.lruTail == -1) {
            this.lruTail = slot;
        }
    }

    /** Promote `slot` to MRU head; no-op when it is already the head. */
    void moveToHead(int32 slot) {
        if (slot == this.mruHead) {
            return;
        }
        this.unlink(slot);
        this.linkAtHead(slot);
    }

    /** Detach `slot` from the LRU list, mending head/tail and its neighbours. */
    void unlink(int32 slot) {
        int32 p = this.slotPrev[slot];
        int32 n = this.slotNext[slot];
        if (p != -1) {
            this.slotNext[p] = n;
        } else {
            this.mruHead = n;
        }
        if (n != -1) {
            this.slotPrev[n] = p;
        } else {
            this.lruTail = p;
        }
        this.slotPrev[slot] = -1;
        this.slotNext[slot] = -1;
    }
}
