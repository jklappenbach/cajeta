package cajeta.xpu;

/**
 * KernelResourceDescriptor — the resource footprint of a submitted kernel
 * (xpu-cooperative-tile §7.1). {@link Scheduler#submit} fills the register count
 * and LDS from the kernel's manifest (xpu-tile-manifest §12.2); 0 means unknown.
 */
public final class KernelResourceDescriptor {
    // Per-work-item vector registers, from the manifest.
    public int32 vgprCount;
    // Per-block LDS bytes: the manifest's static bytes plus the launch's dynamic bytes.
    public int32 ldsBytes;
    // Waves (subgroups) the launch dispatches: ceil(gridX*blockX / waveWidth).
    public int32 waveCount;
    public int32 gridX;
    public int32 gridY;
    public int32 gridZ;
    public int32 blockX;
    public int32 blockY;
    public int32 blockZ;
    // Compute-bound vs memory-bound (§7.4).
    public ArithmeticCharacter character;

    public KernelResourceDescriptor(int32 waveCount, int32 gridX, int32 gridY,
            int32 gridZ, int32 blockX, int32 blockY, int32 blockZ,
            ArithmeticCharacter character) {
        this.vgprCount = 0;
        this.ldsBytes = 0;
        this.waveCount = waveCount;
        this.gridX = gridX;
        this.gridY = gridY;
        this.gridZ = gridZ;
        this.blockX = blockX;
        this.blockY = blockY;
        this.blockZ = blockZ;
        this.character = character;
    }
}
