package cajeta.xpu;

import cajeta.collection.ArrayList;
import cajeta.error.RecoverableException;
import cajeta.xpu.Device;
import cajeta.xpu.KernelManifest;
import cajeta.lang.Optional;

/**
 * Scheduler — the scheduler seam (xpu-tile-scheduling §2). Every launch is a
 * submission: `k.launch(s, grid:, block:)(args)` reaches the runtime as a
 * default-policy submission whose access sets come from the kernel's
 * manifest, and a {@link KernelSubmission} in the stream's place carries what
 * a default cannot know (policy, deadline window, protection, a compute-unit
 * budget, a capture identity, an energy budget):
 *
 *     KernelSubmission sub = heap KernelSubmission(gridBlocks, blockThreads);
 *     sub.policy = SchedulePolicy.Latency;
 *     sub.latestNs = Clock.nanoTime() + 2000000L;
 *     k.launch(sub, grid: [sub.gridX], block: [sub.blockX])(a, b, c);
 *
 * {@link #submit} is the explicit form of the same path: it fills the
 * submission's sets from the manifest and returns the kernel's {@link
 * KernelResourceDescriptor}. The runtime records each scheduled launch;
 * {@link #last}, {@link #submissionCount}, {@link #bypassedCount} and {@link
 * #rejectedCount} read the record back. Nothing reorders or defers a launch
 * yet. The {@link #bypass} switch takes the raw launch ABI for A/B measurement
 * and is the only unscheduled path (§2.1a).
 */
public final class Scheduler {

    private Scheduler() { }

    /** Launches scheduled in this process (every launch not bypassed or rejected). */
    public static int64 submissionCount() { return Scheduler.nativeCount(0); }

    /** Launches that took the raw ABI under the bypass switch (§2.1a). */
    public static int64 bypassedCount() { return Scheduler.nativeCount(1); }

    /** Submissions rejected with a reason (§2.9). */
    public static int64 rejectedCount() { return Scheduler.nativeCount(2); }

    /**
     * The bypass switch (§2.1a): on, every launch takes the raw ABI and the
     * scheduler sees nothing. For A/B measurement only. `CAJETA_XPU_SCHEDULER=bypass`
     * sets it at startup.
     */
    public static void bypass(boolean on) { Scheduler.nativeBypass(on ? 1 : 0); }

    public static boolean bypassed() { return Scheduler.nativeBypassed() != 0; }

    /** Replace the default calibration store (§12.4a); false once a record has been read or written. */
    public static boolean calibrationStore(#CalibrationStore module) { return Calibration.install(#module); }

    /** A copy of the most recent scheduled launch, or null before the first. */
    public static #SubmissionRecord last() {
        if (Scheduler.submissionCount() == 0L) { return null; }
        SubmissionRecord r = heap SubmissionRecord();
        int8[] buf = heap int8[256];
        int64 n = Scheduler.nativeLastName(buf, 256L);
        r.kernel #= heap String(#buf, (int32) n);
        r.gridX = (int32) Scheduler.nativeLastField(0);
        r.gridY = (int32) Scheduler.nativeLastField(1);
        r.gridZ = (int32) Scheduler.nativeLastField(2);
        r.blockX = (int32) Scheduler.nativeLastField(3);
        r.blockY = (int32) Scheduler.nativeLastField(4);
        r.blockZ = (int32) Scheduler.nativeLastField(5);
        r.sharedBytes = (int32) Scheduler.nativeLastField(6);
        r.streamHandle = Scheduler.nativeLastField(7);
        int32 p = (int32) Scheduler.nativeLastField(8);
        if (p == 1) { r.policy = SchedulePolicy.Latency; }
        if (p == 2) { r.policy = SchedulePolicy.FrameBudget; }
        if (p == 3) { r.policy = SchedulePolicy.Energy; }
        r.protectedLaunch = Scheduler.nativeLastField(9) != 0L;
        r.earliestNs = Scheduler.nativeLastField(10);
        r.latestNs = Scheduler.nativeLastField(11);
        r.cuBudget = (int32) Scheduler.nativeLastField(12);
        r.captureId = Scheduler.nativeLastField(13);
        r.energyJoules = Scheduler.nativeLastEnergy();
        r.classified = Scheduler.nativeLastField(15) != 0L;
        r.poolHandle = Scheduler.nativeLastField(19);
        r.poolReserve = Scheduler.nativeLastField(20);
        Scheduler.fillSet(r.readSet, 0, (int32) Scheduler.nativeLastField(16));
        Scheduler.fillSet(r.writeSet, 1, (int32) Scheduler.nativeLastField(17));
        Scheduler.fillSet(r.accumulateSet, 2, (int32) Scheduler.nativeLastField(18));
        return #r;
    }

    private static void fillSet(ArrayList<int64> dst, int32 set, int32 n) {
        int32 i = 0;
        while (i < n) {
            dst.add(Scheduler.nativeLastHandle(set, i));
            i = i + 1;
        }
    }

    @Native("__cajeta_xpu_submission_count")
    private static int64 nativeCount(int32 which);

    @Native("__cajeta_xpu_scheduler_bypass")
    private static void nativeBypass(int32 on);

    @Native("__cajeta_xpu_scheduler_bypassed")
    private static int32 nativeBypassed();

    @Native("__cajeta_xpu_last_submission_field")
    private static int64 nativeLastField(int32 key);

    @Native("__cajeta_xpu_last_submission_energy")
    private static float64 nativeLastEnergy();

    @Native("__cajeta_xpu_last_submission_name")
    private static int64 nativeLastName(int8[] buf, int64 cap);

    @Native("__cajeta_xpu_last_submission_handle")
    private static int64 nativeLastHandle(int32 set, int32 i);

    /**
     * Record `sub` for the future scheduler and emit its resource descriptor
     * (§7.1). With `sub.kernel` named, the register count and static LDS come from
     * its manifest and, with its buffers bound, the access sets too (manifest §6.6, §12.2).
     */
    public static #KernelResourceDescriptor submit(KernelSubmission sub) {
        int32 waveW = 1;
        if (!Device.activeBackend().equals("cpu")) {
            int32 w = Device.waveSize();
            if (w > 0) {
                waveW = w;
            }
        }
        int64 threads = (int64) sub.gridX * (int64) sub.blockX;
        int64 waves = (threads + (int64) waveW - 1) / (int64) waveW;
        KernelResourceDescriptor d = heap KernelResourceDescriptor(
            (int32) waves,
            sub.gridX, sub.gridY, sub.gridZ,
            sub.blockX, sub.blockY, sub.blockZ,
            sub.character);
        d.ldsBytes = sub.sharedBytes;
        if (sub.kernel != null) {
            KernelManifest m #= KernelManifest.of(sub.kernel);
            if (m != null) {
                Optional<int32> vgpr = m.vgpr();
                if (vgpr.isPresent()) { d.vgprCount = vgpr.get(); }
                Optional<int32> lds = m.ldsStaticBytes();
                if (lds.isPresent()) { d.ldsBytes = d.ldsBytes + lds.get(); }
                if (sub.bound.count() > 0) { Scheduler.deriveSets(sub, m); }
            }
        }
        return #d;
    }

    // Fill `sub`'s sets from the manifest's access modes, refusing a restated set
    // that disagrees with the body (manifest §6.6).
    private static void deriveSets(KernelSubmission sub, KernelManifest m) {
        ArrayList<int64> reads #= heap ArrayList<int64>();
        ArrayList<int64> writes #= heap ArrayList<int64>();
        ArrayList<int64> accs #= heap ArrayList<int64>();
        int32 n = m.accessCount();
        if (sub.bound.count() < n) { n = sub.bound.count(); }
        int32 i = 0;
        while (i < n) {
            int64 h = sub.bound.get(i);
            String mode = m.accessMode(i);
            if (mode.equals("read")) {
                reads.add(h);
            } else if (mode.equals("write")) {
                writes.add(h);
            } else if (mode.equals("readwrite")) {
                reads.add(h);
                writes.add(h);
            } else if (mode.equals("accumulate")) {
                writes.add(h);
                accs.add(h);
            }
            i = i + 1;
        }
        if (sub.readSet.count() > 0 && !Scheduler.sameSet(sub.readSet, reads)) {
            throw heap RecoverableException("Scheduler.submit: the restated "
                + "read set of `" + sub.kernel + "` disagrees with what its "
                + "body does (xpu-tile-manifest §6.6); drop the reads() calls "
                + "or fix them");
        }
        if (sub.writeSet.count() > 0 && !Scheduler.sameSet(sub.writeSet, writes)) {
            throw heap RecoverableException("Scheduler.submit: the restated "
                + "write set of `" + sub.kernel + "` disagrees with what its "
                + "body does (xpu-tile-manifest §6.6); drop the writes() calls "
                + "or fix them");
        }
        Scheduler.copyInto(sub.readSet, reads);
        Scheduler.copyInto(sub.writeSet, writes);
        Scheduler.copyInto(sub.accumulateSet, accs);
    }

    // Same handles, any order, no multiplicity: the set comparison behind the
    // §6.6 refusal.
    private static boolean sameSet(ArrayList<int64> a, ArrayList<int64> b) {
        if (a.count() != b.count()) { return false; }
        int32 i = 0;
        while (i < a.count()) {
            int64 h = a.get(i);
            boolean found = false;
            int32 j = 0;
            while (j < b.count()) {
                if (b.get(j) == h) { found = true; }
                j = j + 1;
            }
            if (!found) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Replace `dst`'s contents with `src`'s (the submission owns its lists).
    private static void copyInto(ArrayList<int64> dst, ArrayList<int64> src) {
        dst.clear();
        int32 i = 0;
        while (i < src.count()) {
            dst.add(src.get(i));
            i = i + 1;
        }
    }
}
