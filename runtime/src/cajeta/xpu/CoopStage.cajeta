package cajeta.xpu;

import cajeta.xpu.KernelBuffer;

/**
 * CoopStage — the cooperative global→LDS staging copy for tiled GEMM (the
 * ergonomic layer over `CooperativeMatrix.load(Shared<T>, ...)`).
 *
 * In a tiled GEMM each input tile is re-read once per output row/column. Loading
 * it straight from global every time wastes that bandwidth and starves the matrix
 * cores. The fix is to stage a *panel* of the input into workgroup-shared memory
 * (`Shared<T>`, i.e. LDS) ONCE per K-step, then have every wave read its operand
 * tiles out of the shared panel — converting N redundant global reads into one
 * global read plus N cheap LDS reads.
 *
 * `panel` is that staging copy. The whole workgroup cooperates: the threads
 * stride over the `rows`x`cols` panel and copy it from a row-major source matrix
 * (leading dimension `ld`, the source's full row width) into a contiguous
 * row-major LDS tile (stride = `cols`). It is a device-only intrinsic, lowered at
 * the `@Kernel` call site to a strided copy over `KernelThread.x()` / `Workgroup.dimX()`
 * — there is no real call. Use it inside a K-loop, paired with a barrier:
 *
 *     Shared<float16> sa = shared float16[32 * 16];
 *     Shared<float16> sb = shared float16[16 * 32];
 *     // ... per K-step kt ...
 *     CoopStage.panel(sa, a, bi * 32, kt * 16, 32, 16, K);  // A row-band → LDS
 *     CoopStage.panel(sb, b, kt * 16, bj * 32, 16, 32, N);  // B col-band → LDS
 *     Barrier.workgroup();                                  // writes visible
 *     wa.load(sa, ti * 16 * 16, 0, 16);                     // this wave's A tile
 *     wb.load(sb, tj * 16,      0, 32);                     // this wave's B tile
 *     acc.mma(wa, wb);
 *     Barrier.workgroup();                                  // before next overwrite
 *
 * The caller owns the barriers (a barrier after the stage so the writes are
 * visible to all waves, and a barrier after the MMAs before the next K-step
 * overwrites the panel). Using CoopStage on the host is unsupported.
 */
public final class CoopStage {

    /**
     * Cooperatively copy a `rows`x`cols` sub-tile of the row-major matrix `src`
     * — its top-left corner at `(rowBase, colBase)`, the matrix's leading
     * dimension (full row width) `ld` — into the contiguous LDS tile `dst`. All
     * threads of the workgroup participate (strided by the block size). The
     * destination is packed row-major with stride `cols`, so a subsequent
     * `CooperativeMatrix.load(dst, subOffset, 0, cols)` addresses tiles within it.
     */
    public static void panel<T>(Shared<T> dst, KernelBuffer<T> src,
                                uint32 rowBase, uint32 colBase,
                                uint32 rows, uint32 cols, uint32 ld) {
    }
}
