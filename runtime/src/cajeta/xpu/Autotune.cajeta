package cajeta.xpu;

import cajeta.io.file.File;
import cajeta.io.file.Path;
import cajeta.error.Exception;
import cajeta.lang.Optional;
import cajeta.lang.String;
import cajeta.xpu.Device;

/**
 * A per-device store of tuned integers, so a kernel discovers its geometry on
 * hardware the toolchain has never met instead of inheriting a constant that
 * was measured somewhere else.
 *
 * The pattern is: recall a value; if absent, sweep the candidates, keep the
 * winner, remember it. The sweep belongs to the caller, which is the only code
 * that knows what a candidate costs and how to check it is still CORRECT --
 * a tuner that can select a fast wrong answer is worse than a constant.
 *
 * Entries are keyed by {@link #deviceKey}, a fingerprint of the machine shape
 * that tuning actually depends on, so a store copied between machines is
 * ignored rather than believed. One small file per (device, name): no parser,
 * nothing to corrupt, and a stale entry is removed by deleting a file.
 *
 * `dir` is supplied by the caller rather than discovered, because the runtime
 * exposes no environment access and an application knows where its cache
 * belongs. Nothing here writes outside `dir`.
 */
public final class Autotune {
    private Autotune() { }

    /**
     * The active device's tuning fingerprint: the backend plus the geometry
     * that changes what the right answer IS. Two parts reporting the same
     * shape tune the same way, so they share an entry; a part that reports
     * nothing (0 everywhere) still gets a stable key, and its entries simply
     * carry no information about which device wrote them, so they are keyed
     * as "unknown" and not shared with a profiled device.
     */
    public static #String deviceKey() {
        String be #= Device.activeBackend();
        int32 mps = Device.multiprocessorCount();
        if (mps <= 0) {
            String u #= be + "-unknown";
            return #u;
        }
        String k #= be + "-" + mps
            + "x" + Device.simdsPerMultiprocessor()
            + "w" + Device.waveSize()
            + "r" + Device.registersPerMultiprocessor()
            + "l" + Device.sharedBytesPerMultiprocessor()
            + "t" + Device.threadsPerMultiprocessor();
        return #k;
    }

    // ---- this execution's answers ------------------------------------- //
    // A box with no writable store still tunes ONCE PER EXECUTION: every
    // value recorded here is remembered in memory whether or not it reaches
    // disk, and recall prefers memory, so a lazy calibration at first kernel
    // use runs once and is reused for the life of the process.
    static String[] memName;
    static int32[] memVal;
    static int32 memN = 0;
    static int32 memCap = 0;
    // Names already claimed by claimOnce, so a once-per-execution job cannot
    // run twice even when its result is not a single integer.
    static String[] claimed;
    static int32 claimN = 0;
    static int32 claimCap = 0;
    // 0 unknown, 1 the store took a write, 2 it refused one.
    static int32 persistState = 0;

    static int32 findMem(String name) {
        int32 i = 0;
        while (i < Autotune.memN) {
            if (Autotune.memName[i].equals(name)) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static void putMem(String name, int32 value) {
        int32 at = Autotune.findMem(name);
        if (at >= 0) { Autotune.memVal[at] = value; return; }
        if (Autotune.memN == Autotune.memCap) {
            int32 cap = Autotune.memCap * 2;
            if (cap < 8) { cap = 8; }
            String[] nn #= heap String[cap];
            int32[] nv #= heap int32[cap];
            int32 i = 0;
            while (i < Autotune.memN) {
                nn[i] #= Autotune.memName[i];
                nv[i] = Autotune.memVal[i];
                i = i + 1;
            }
            Autotune.memName #= nn;
            Autotune.memVal #= nv;
            Autotune.memCap = cap;
        }
        // A COPY of the name: the caller's String may be a temporary, and a
        // static holding a borrow of one outlives it.
        String c #= "" + name;
        Autotune.memName[Autotune.memN] #= c;
        Autotune.memVal[Autotune.memN] = value;
        Autotune.memN = Autotune.memN + 1;
        return;
    }

    /**
     * True exactly once per execution for `name`, so a lazy calibration
     * triggered at first kernel use runs once however many callers race to
     * it. Independent of the store: a job whose result is not a single
     * integer still gets the once-per-execution guarantee.
     */
    public static boolean claimOnce(String name) {
        int32 i = 0;
        while (i < Autotune.claimN) {
            if (Autotune.claimed[i].equals(name)) { return false; }
            i = i + 1;
        }
        if (Autotune.claimN == Autotune.claimCap) {
            int32 cap = Autotune.claimCap * 2;
            if (cap < 8) { cap = 8; }
            String[] nn #= heap String[cap];
            int32 j = 0;
            while (j < Autotune.claimN) { nn[j] #= Autotune.claimed[j]; j = j + 1; }
            Autotune.claimed #= nn;
            Autotune.claimCap = cap;
        }
        String c #= "" + name;
        Autotune.claimed[Autotune.claimN] #= c;
        Autotune.claimN = Autotune.claimN + 1;
        return true;
    }

    /**
     * Whether tuned values are surviving this execution: `false` means the
     * store refused a write, so everything recorded is in memory only and the
     * next run calibrates again. Report it rather than hiding it -- a silently
     * unpersisted tune looks like a slow startup nobody can explain.
     */
    public static boolean persists() {
        return Autotune.persistState != 2;
    }
    /** The tuned value for `name` on this device, or absent. */
    public static Optional<int32> recall(String dir, String name) {
        // This execution's answer first: it is the one that is certainly for
        // this device, and it is all there is on a box with no writable store.
        int32 m = Autotune.findMem(name);
        if (m >= 0) { return stack Optional<int32>(true, Autotune.memVal[m]); }
        if (dir.byteLength() == 0) { return stack Optional<int32>(false, 0); }
        String key #= Autotune.deviceKey();
        String p #= dir + "/" + key + "/" + name;
        Path f #= Path.of(p);
        if (!f.exists()) { return stack Optional<int32>(false, 0); }
        int8[] b #= File.readAllBytes(p);
        if (b == null) { return stack Optional<int32>(false, 0); }
        int32 v = Autotune.parseInt(b, (int64) b.count());
        if (v < 0) { return stack Optional<int32>(false, 0); }
        Autotune.putMem(name, v);
        return stack Optional<int32>(true, v);
    }

    /**
     * Record `value` for `name` on this device, replacing any previous entry.
     * Creates `dir` and the device directory. Negative values are refused:
     * absent and "tuned to a negative" would otherwise be indistinguishable
     * to a caller that treats absent as "use the default".
     */
    public static void remember(String dir, String name, int32 value) {
        if (value < 0) { return; }
        // Memory ALWAYS, disk only if it will have us. A box with no writable
        // store still tunes ONCE PER EXECUTION rather than repeating the work.
        Autotune.putMem(name, value);
        if (dir.byteLength() == 0) { return; }
        String key #= Autotune.deviceKey();
        String d #= dir + "/" + key;
        String p #= d + "/" + name;
        String text #= "" + value;
        int8[] b #= text.toBytes();
        try {
            Path dp #= Path.of(d);
            dp.mkdirs();
            File.writeAllBytes(p, b, (int64) b.count());
        } catch (Exception e) {
            // No store is not an error: the value stands for this execution.
        }
        // VERIFY rather than trust: a write to an unwritable path neither
        // throws nor lands, so "it did not throw" says nothing about whether
        // the next run will find this value.
        Path chk #= Path.of(p);
        if (chk.exists()) { Autotune.persistState = 1; }
        else { Autotune.persistState = 2; }
        return;
    }

    // Decimal digits only; -1 for anything else, so a truncated or hand-edited
    // file reads as absent rather than as a number that happens to parse.
    static int32 parseInt(int8[] b, int64 len) {
        if (len <= 0L || len > 9L) { return 0 - 1; }
        int32 v = 0;
        int64 i = 0;
        while (i < len) {
            int32 c = (int32) b[i] & 255;
            if (c == 10 || c == 13) { i = len; }
            else {
                if (c < 48 || c > 57) { return 0 - 1; }
                v = v * 10 + (c - 48);
                i = i + 1;
            }
        }
        return v;
    }
}
