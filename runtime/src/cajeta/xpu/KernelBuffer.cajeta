package cajeta.xpu;

/**
 * KernelBuffer<T> — unified handle to device memory.
 *
 * The cross-cutting type higher-level libraries (cajeta.math,
 * Caramelo, Torch, cajeta.render) write against. Backends tag the
 * underlying storage handle (CUdeviceptr / hipDeviceptr_t /
 * VkBuffer); from the user's perspective it's one opaque type
 * with a length and the standard upload/download/free operations.
 *
 * Indexing `buf[i]` is only legal inside @Kernel or @Device
 * functions and produces a borrow of the element type. On the
 * host, callers use the explicit upload/download paths.
 *
 * MEMORY MODEL (CajetaXPU.md §3.5/§3.6). A KernelBuffer is a small host-side
 * handle (deviceHandle + elementCount) over device memory that lives in
 * VRAM. The device memory is an *owned resource*, tied to the handle's
 * lifetime via RAII (the same convention as FileReader/File/Path):
 *
 *   - the *handle* (this 16-byte struct) lives on the stack or heap and is
 *     governed by the drop chain. `heap KernelBuffer<T>(n)` is the common form;
 *     `KernelBuffer<T>.alloc(n)` returns a `heap` handle for factory-style escape.
 *   - the *device memory* is acquired by the constructor and released by
 *     `~KernelBuffer()` at scope exit — forgetting to free() can no longer leak
 *     VRAM. The launch-borrow checker guards the timing: a launch borrows each
 *     KernelBuffer argument until the next `KernelStream.sync()`, and letting a buffer
 *     reach its drop (or an explicit `free()`) while a launch still references
 *     it is a compile error (XPU-K02). Move-out (`#buf`) transfers ownership;
 *     the moved-from handle's destructor no-ops.
 *
 * Element byte size is supplied by the compiler — `elementBytes()` lowers
 * to the target DataLayout size of T — so the runtime primitives speak
 * only int64 handles and byte counts and stay independent of T.
 */
public final class KernelBuffer<T> {
    int64 deviceHandle;
    uint64 elementCount;
    // Ownership of the underlying device storage. An allocating KernelBuffer owns it
    // (true) and releases it at drop; a *view* produced by `slice()` borrows a
    // sub-range of a parent's storage (false) and never frees — so the drop
    // chain can't double-free a parent's memory through a view. See `slice()`.
    boolean owned;
    // Memory residency (a MemoryKind ordinal): Device (0, default), Pinned (1),
    // or Unified (2). Selected at construction; threaded to the native
    // allocator/deallocator (the right per-backend alloc + matching free) and to
    // the zero-copy host-access path. See MemoryKind.
    int32 kind;

    KernelBuffer(int64 deviceHandle, uint64 elementCount) {
        this.deviceHandle = deviceHandle;
        this.elementCount = elementCount;
        this.owned = true;
        this.kind = 0;       // MemoryKind.Device
    }

    /**
     * RAII constructor: allocate device storage for `elementCount` elements.
     * The constructor acquires the device memory and `~KernelBuffer()` releases it,
     * so a KernelBuffer cleans up through the drop chain like any other owning handle
     * (the same shape as FileReader/File/Path). This is the idiomatic form —
     * prefer it over the 2-arg ctor + `allocate()`:
     *
     *     KernelBuffer<float32> x = heap KernelBuffer<float32>(n);   // allocates here
     *     x.upload(hx);
     *     kernel.launch(s, ...)(x, ...);
     *     s.sync();
     *     x.download(hx);
     *     // device memory freed automatically when x leaves scope
     *
     * @EntryPoint
     */
    public KernelBuffer(uint64 elementCount) {
        this.elementCount = elementCount;
        this.owned = true;
        this.kind = 0;       // MemoryKind.Device
        this.deviceHandle = this.deviceAlloc(elementCount * elementBytes(), 0);
    }

    /**
     * Destructor — release the device memory. Runs via the drop chain at scope
     * exit, so device VRAM is never leaked by forgetting to free(). Null-
     * guarded and idempotent: a prior explicit free(), or a moved-from handle
     * (`#buf`), makes this a no-op — the move marks the source's drop entry
     * inactive, so this never double-frees. A launch-borrowed buffer may not
     * reach its drop before `KernelStream.sync()`; doing so is a compile error
     * (XPU-K02), the same rule that guards an explicit free().
     */
    ~KernelBuffer() {
        if (this.owned && this.deviceHandle != 0) {
            this.deviceFree(this.deviceHandle, this.kind);
            this.deviceHandle = 0;
        }
    }

    public uint64 length() {
        return this.elementCount;
    }

    /**
     * Compiler intrinsic: lowered at each call site to the target
     * DataLayout byte size of the enclosing KernelBuffer<T>'s element type T.
     * The body here is a resolution placeholder — it is never emitted as
     * a real call (CallExpression / MethodCallExpression intercepts it).
     */
    private static uint64 elementBytes() {
        return 0;
    }

    // Device-memory primitives. These are *instance* @Native methods rather
    // than statics: a static call qualified by the generic class name
    // (`KernelBuffer.foo()`) resolves to the uninstantiated template and lowers to
    // null, whereas instance dispatch (`this.foo()`) resolves against the
    // runtime instantiation. The leading `this` the forwarder passes is
    // ignored by the C side. Pointer-shaped at the ABI boundary, so one C
    // symbol per name serves every KernelBuffer<T>; the element size is folded into
    // the byte counts the callers pass.
    @Native("__cajeta_xpu_buffer_alloc")
    private int64 deviceAlloc(uint64 byteCount, int32 kind);

    @Native("__cajeta_xpu_buffer_upload")
    private void deviceUpload(int64 handle, T[] host, uint64 byteCount);

    @Native("__cajeta_xpu_buffer_download")
    private void deviceDownload(int64 handle, T[] host, uint64 byteCount);

    @Native("__cajeta_xpu_buffer_upload_async")
    private void deviceUploadAsync(int64 handle, T[] host, uint64 byteCount,
                                  int64 stream);

    @Native("__cajeta_xpu_buffer_download_async")
    private void deviceDownloadAsync(int64 handle, T[] host, uint64 byteCount,
                                    int64 stream);

    @Native("__cajeta_xpu_buffer_free")
    private void deviceFree(int64 handle, int32 kind);

    // Zero-copy host access for a host-accessible buffer (Pinned/Unified, or the
    // CPU/Vulkan-mapped storage): a plain memcpy in the shared address space, no
    // device-transfer API. dir != 0 stores host[]→buffer; dir == 0 loads
    // buffer→host[]. No-ops for a Device buffer on a discrete GPU.
    @Native("__cajeta_xpu_buffer_host_copy")
    private void deviceHostCopy(int64 handle, T[] host, uint64 byteCount,
                               int32 dir, int32 kind);

    /**
     * Allocate a device buffer of `n` elements and return a heap handle.
     * Heap is mandatory here: the result escapes this frame, so a stack
     * handle would be rejected by the escape checker. For same-scope
     * allocations prefer `stack KernelBuffer<T>(...)` + `allocate()` at the use
     * site.
     *
     * @EntryPoint
     */
    public static #KernelBuffer<T> alloc(uint64 n) {
        KernelBuffer<T> buf = heap KernelBuffer<T>(n);   // RAII ctor allocates device memory
        return #buf;                          // move out: source dtor no-ops
    }

    /**
     * Allocate device storage for this buffer's `length()` elements. Use with
     * direct construction when a `heap`/`stack` handle is preferred over the
     * `alloc` factory:
     *
     *     KernelBuffer<float32> x = stack KernelBuffer<float32>(0, n);
     *     x.allocate();
     *
     * Replaces any previously held handle (call once per buffer).
     */
    public void allocate() {
        if (this.deviceHandle != 0) {
            this.deviceFree(this.deviceHandle, this.kind);   // free before re-alloc; no leak
        }
        uint64 bytes = this.elementCount * elementBytes();
        this.deviceHandle = this.deviceAlloc(bytes, this.kind);
    }

    /**
     * Allocate storage with a chosen memory residency (a {@link MemoryKind}).
     * Mirrors the `KernelBuffer(0, n)` + `allocate()` idiom, adding the kind:
     *
     *     KernelBuffer<float32> u = heap KernelBuffer<float32>(0, n);
     *     u.allocate(MemoryKind.Unified);          // managed, host-accessible
     *     u.hostStore(hx);                         // zero-copy on an APU
     *     kernel.launch(s, ...)(u, ...);           // kernel reads the same memory
     *     s.sync();
     *     u.hostLoad(hx);                          // zero-copy read-back
     *
     * `Unified` (managed) and `Pinned` (page-locked) storage is host-accessible:
     * write/read it directly with {@link #hostStore}/{@link #hostLoad} (no device
     * transfer). `Device` keeps the explicit `upload`/`download` model. `kind` is
     * a `MemoryKind` ordinal (the enum constant resolves to its i32 ordinal); it
     * is taken as a separate overload (not a 2-arg constructor) to stay distinct
     * from the `KernelBuffer(int64 deviceHandle, uint64 elementCount)` form. See {@link
     * MemoryKind}.
     */
    public void allocate(int32 kind) {
        this.kind = kind;
        this.allocate();
    }

    /**
     * Host → device transfer of `host` into this buffer. The host array's
     * element count must equal `length()`. Issued on the default stream;
     * for stream-ordered uploads, see the vendor namespace.
     */
    public void upload(T[] host) {
        uint64 bytes = this.elementCount * elementBytes();
        int64 h = this.deviceHandle;
        this.deviceUpload(h, host, bytes);
    }

    public void download(T[] host) {
        uint64 bytes = this.elementCount * elementBytes();
        int64 h = this.deviceHandle;
        this.deviceDownload(h, host, bytes);
    }

    /**
     * Asynchronous host → device upload, enqueued on `stream`. Unlike {@link
     * #upload} (which uses the default stream), the copy is ordered on `stream`
     * and returns without blocking — it completes by the next `stream.sync()`,
     * so it overlaps work queued elsewhere. Best paired with `MemoryKind.Pinned`
     * host memory (the precondition for true async DMA). The host array must
     * equal `length()` and must stay alive until the stream syncs. CUDA/HIP
     * issue the real async copy; CPU and the Vulkan coherent map copy
     * synchronously (semantically identical — done by the time sync returns).
     */
    public void uploadAsync(T[] host, KernelStream stream) {
        uint64 bytes = this.elementCount * elementBytes();
        // Bind the param's field to a local before passing it (reading a
        // class-typed param's field inline as a call arg lowers to null — the
        // documented idiom, as KernelStream.waitFor does with e.handle).
        int64 sh = stream.handle;
        this.deviceUploadAsync(this.deviceHandle, host, bytes, sh);
    }

    /**
     * Asynchronous device → host download, the twin of {@link #uploadAsync}:
     * enqueued on `stream`, completing by the next `stream.sync()`.
     */
    public void downloadAsync(T[] host, KernelStream stream) {
        uint64 bytes = this.elementCount * elementBytes();
        int64 sh = stream.handle;   // see uploadAsync: bind before passing
        this.deviceDownloadAsync(this.deviceHandle, host, bytes, sh);
    }

    /**
     * Explicit early release — an idempotent escape hatch (the FileReader
     * `close()` pattern). Rarely needed now that `~KernelBuffer()` releases at scope
     * exit; use it to free device memory before the handle's scope ends.
     * Null-guards + clears the handle so the destructor then no-ops.
     */
    public void free() {
        if (this.owned && this.deviceHandle != 0) {
            this.deviceFree(this.deviceHandle, this.kind);
            this.deviceHandle = 0;
        }
    }

    /**
     * Zero-copy host → buffer write for a host-accessible buffer (constructed
     * with `MemoryKind.Unified` or `.Pinned`). Copies `host` directly into this
     * buffer's shared storage with NO device transfer — a plain memcpy in the
     * unified address space (genuine zero-copy on an APU). The kernel then reads
     * the same memory; pair with {@link #hostLoad} to read results back. The
     * host array's element count must equal `length()`. For a `Device` buffer on
     * a discrete GPU (no host mapping) this no-ops — use {@link #upload} there.
     */
    public void hostStore(T[] host) {
        uint64 bytes = this.elementCount * elementBytes();
        this.deviceHostCopy(this.deviceHandle, host, bytes, 1, this.kind);
    }

    /**
     * Zero-copy buffer → host read, the twin of {@link #hostStore}: copies this
     * buffer's shared storage directly into `host` with no device transfer.
     * No-ops for a `Device` buffer on a discrete GPU — use {@link #download}.
     */
    public void hostLoad(T[] host) {
        uint64 bytes = this.elementCount * elementBytes();
        this.deviceHostCopy(this.deviceHandle, host, bytes, 0, this.kind);
    }

    /**
     * Sub-buffer view: a non-owning KernelBuffer over `count` elements of this
     * buffer starting at element `offset`. The view shares this buffer's
     * device storage — it allocates nothing and frees nothing — so it can be
     * uploaded/downloaded through and passed to a kernel as a sub-range:
     *
     *     KernelBuffer<float32> all = heap KernelBuffer<float32>(n);
     *     all.upload(host);
     *     KernelBuffer<float32> tail = all.slice(n / 2, n / 2);   // second half
     *     kernel.launch(s, n / 2)(tail, ...);               // touches the tail
     *     s.sync();
     *
     * The offset is folded into the device address at the backend boundary
     * (`deviceSlice`): pointer backends (CPU / HIP / CUDA) advance the device
     * pointer by `offset * elementBytes()`; the Vulkan path resolves the byte
     * offset into the bound descriptor (a view of the parent's `VkBuffer`).
     *
     * BORROW / LIFETIME: a view borrows the parent's storage — the parent must
     * outlive every view of it (a view dangles if the parent drops first). The
     * view itself is non-owning (`owned = false`), so `~KernelBuffer()`/`free()` on
     * the view no-op and the parent's memory is released exactly once, by the
     * parent. The launch-borrow rule (XPU-K02) still applies to the view value
     * passed at a launch site. Parent-outlives-view is interim lint / debug-
     * runtime territory (the same borrow-soundness deferral as field-stored /
     * captured borrows), not a hard compile error yet.
     *
     * v1: contiguous sub-range only (no stride / gather), no bounds check
     * (matches in-kernel `buf[i]`), and `offset + count <= length()` is the
     * caller's responsibility.
     */
    public #KernelBuffer<T> slice(uint64 offset, uint64 count) {
        int64 base = this.deviceSlice(this.deviceHandle, offset * elementBytes());
        KernelBuffer<T> sub = heap KernelBuffer<T>(base, count);
        sub.owned = false;           // non-owning: shares the parent's storage
        sub.kind = this.kind;        // inherit residency (host-accessible if parent is)
        return #sub;                 // move out; the source dtor no-ops
    }

    // Backend-aware sub-range address resolution. Pointer backends fold the
    // byte offset into the device pointer; Vulkan (handle = buffer-table index)
    // resolves it into a view record carrying the descriptor offset. byteOffset
    // is `offset * elementBytes()`, computed caller-side.
    @Native("__cajeta_xpu_buffer_slice")
    private int64 deviceSlice(int64 handle, uint64 byteOffset);
}
