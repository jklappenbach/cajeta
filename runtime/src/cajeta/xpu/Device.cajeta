package cajeta.xpu;

import cajeta.error.RecoverableException;
import cajeta.xpu.Capability;

/**
 * Device — the active XPU device, and host-side queries about it. The runtime
 * selects one backend at the first device touch (CUDA → HIP → Vulkan → CPU,
 * honoring `CAJETA_XPU_BACKEND`); `Device` answers questions about whatever it
 * got, so an app can pick a path at run time.
 *
 * v1 surfaces the capability heuristic's entry point, {@link #supports}. It is a
 * HOST query (you call it before launching, to choose which kernel / which build
 * to dispatch) — not a device-side op.
 */
public final class Device {

    private Device() { }

    /**
     * Whether the active device advertises `cap` natively. The capability
     * heuristic of the GPU model: when true, take the hardware fast path; when
     * false, fall to core (which floors to the portable software path). For
     * example, `supports(Capability.RayQueryNative)` is true on a GPU with
     * hardware inline ray query and false on the CPU backend — where a `RayQuery`
     * still runs, via the software BVH walk.
     *
     * @EntryPoint
     */
    public static boolean supports(Capability cap) {
        // The enum constant resolves to its i32 ordinal (the stable Capability
        // contract the runtime switches on), as MemoryKind does for KernelBuffer.
        return Device.nativeSupports(cap) != 0;
    }

    /**
     * Force the backend BEFORE the first device touch (cajeta-llama 11.2 —
     * the CLI's `--device`): "cuda", "hip", "vulkan" or "cpu". Equivalent to
     * launching with `CAJETA_XPU_BACKEND=<name>` but settable in-process;
     * after the first touch the selection is already cached and this throws.
     * A forced backend that is not available at selection time degrades
     * exactly like the env route (the precise once-only stderr note).
     */
    public static void force(String name) {
        int32 id = -1;
        if (name.equals("cuda")) { id = 0; }
        else if (name.equals("hip")) { id = 1; }
        else if (name.equals("vulkan")) { id = 2; }
        else if (name.equals("cpu")) { id = 3; }
        if (id < 0) {
            throw heap RecoverableException("Device.force: unknown "
                + "backend '" + name + "' (cuda, hip, vulkan, cpu)");
        }
        if (Device.nativeForce(id) == 0) {
            throw heap RecoverableException("Device.force: the backend is "
                + "already selected - force before the first device touch");
        }
    }

    // The active backend probes its device features by capability ordinal (the
    // stable Capability contract). Returns 0 / 1.
    @Native("__cajeta_xpu_device_supports")
    private static int32 nativeSupports(int32 capability);

    // Sets the forced backend id; returns 0 when selection already ran.
    @Native("__cajeta_xpu_force_backend")
    private static int32 nativeForce(int32 id);
}
