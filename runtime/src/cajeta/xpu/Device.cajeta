package cajeta.xpu;

import cajeta.lang.String;
import cajeta.error.RecoverableException;
import cajeta.xpu.Capability;

/**
 * Device — the active XPU device, and host-side queries about it. The runtime
 * selects one backend at the first device touch (CUDA → HIP → Vulkan → CPU,
 * honoring `CAJETA_XPU_BACKEND`); `Device` answers questions about whatever it
 * got, so an app can pick a path at run time.
 *
 * v1 surfaces the capability heuristic's entry point, {@link #supports}. It is a
 * HOST query (you call it before launching, to choose which kernel / which build
 * to dispatch) — not a device-side op.
 */
public final class Device {

    private Device() { }

    /**
     * Whether the active device advertises `cap` natively. The capability
     * heuristic of the GPU model: when true, take the hardware fast path; when
     * false, fall to core (which floors to the portable software path). For
     * example, `supports(Capability.RayQueryNative)` is true on a GPU with
     * hardware inline ray query and false on the CPU backend — where a `RayQuery`
     * still runs, via the software BVH walk.
     *
     * @EntryPoint
     */
    public static boolean supports(Capability cap) {
        // The enum constant resolves to its i32 ordinal (the stable Capability
        // contract the runtime switches on), as MemoryKind does for KernelBuffer.
        return Device.nativeSupports(cap) != 0;
    }

    /**
     * Force the backend BEFORE the first device touch (cajeta-llama 11.2 —
     * the CLI's `--device`): "cuda", "hip", "vulkan" or "cpu". Equivalent to
     * launching with `CAJETA_XPU_BACKEND=<name>` but settable in-process;
     * after the first touch the selection is already cached and this throws.
     * A forced backend that is not available at selection time degrades
     * exactly like the env route (the precise once-only stderr note).
     */
    public static void force(String name) {
        int32 id = -1;
        if (name.equals("cuda")) { id = 0; }
        else if (name.equals("hip")) { id = 1; }
        else if (name.equals("vulkan")) { id = 2; }
        else if (name.equals("cpu")) { id = 3; }
        if (id < 0) {
            throw heap RecoverableException("Device.force: unknown "
                + "backend '" + name + "' (cuda, hip, vulkan, cpu)");
        }
        if (Device.nativeForce(id) == 0) {
            throw heap RecoverableException("Device.force: the backend is "
                + "already selected - force before the first device touch");
        }
    }

    /**
     * The backend the runtime selected: `"cuda"`, `"hip"`, `"vulkan"`,
     * `"cpu"`, or `"none"` when nothing bundled was available. The vocabulary
     * is exactly {@link #force}'s, so a value read here can be handed back
     * there.
     *
     * This is a DEVICE TOUCH: asking selects the backend if the selection has
     * not happened yet, and a later {@link #force} will then throw. Ask after
     * you have forced, not before.
     *
     * `"none"` is the answer for a program that declares NO `@Kernel`, even
     * one built with `--xpu-backend=cpu`: a backend's registration ctor is
     * emitted alongside the kernels the compiler found, so a program with no
     * kernels bundles nothing to select.
     *
     * It exists because launch geometry is a device property. A packed
     * mat-vec on this part peaks at 80 workgroups per dispatch — one wave per
     * SIMD — and splitting a large weight into that many rows is worth 1.7x
     * on the GPU and MINUS 6% on the CPU backend, whose persistent worker
     * pool pays per dispatch and has no occupancy cliff to avoid. A caller
     * that cannot ask which backend it got has to choose one of those.
     *
     * @EntryPoint
     */
    public static String activeBackend() {
        int32 id = Device.nativeActiveBackend();
        if (id == 0) { return "cuda"; }
        if (id == 1) { return "hip"; }
        if (id == 2) { return "vulkan"; }
        if (id == 3) { return "cpu"; }
        return "none";
    }

    /**
     * Bound how many worker threads a CPU-backend kernel launch may use.
     * 0 (the default) means unlimited — `min(gridBlocks, cores)`.
     *
     * Settable in-process as well as through `CAJETA_XPU_CPU_WORKERS`,
     * because a scaling measurement has to alternate its arms inside one
     * run: a fixed arm order lets a drifting background load read as a
     * speedup. Setting it back to 0 restores unlimited — the cap is not
     * one-way.
     *
     * No effect on any other backend, and none on the fiber carrier pool
     * (`CAJETA_CARRIERS`), which schedules ordinary cajeta concurrency
     * rather than kernel grids.
     *
     * @EntryPoint
     */
    public static void setCpuWorkerCap(int32 n) {
        Device.nativeSetWorkerCap(n);
    }

    /** The current cap, 0 for unlimited. */
    public static int32 cpuWorkerCap() {
        return Device.nativeWorkerCap();
    }

    /**
     * How many worker threads the LAST CPU-backend launch actually used —
     * 1 whenever it ran serially (forced, single block, or under the
     * parallel threshold).
     *
     * Report it next to any timing. A number without its worker count
     * cannot be read.
     *
     * @EntryPoint
     */
    public static int32 lastLaunchWorkers() {
        return Device.nativeLastWorkers();
    }

    /**
     * The active device's total visible memory, in bytes — the number a
     * residency or working-set budget derives from. Per backend: CUDA
     * reports the device's total memory; HIP reports `hipMemGetInfo`'s
     * total, which on a UMA part is the GTT-visible pool (Strix Halo:
     * ~96 GiB of 122 GiB RAM — the honest device-visible figure, shared
     * with the host); Vulkan sums the DEVICE_LOCAL heaps; the CPU
     * backend reports total physical RAM (the device IS the host).
     *
     * Returns 0 when the answer is unavailable — an older driver
     * missing the query, a failed call, or no backend. 0 means
     * UNKNOWN, never "no memory": derive nothing from it. Heap sizes
     * are capacities, not budgets — allocation can still fail earlier
     * under pressure, and on UMA this pool is shared with the host
     * page cache.
     *
     * A DEVICE TOUCH, like {@link #activeBackend}: asking selects the
     * backend if selection has not happened yet.
     *
     * @EntryPoint
     */
    public static int64 memoryBytes() {
        return Device.nativeMemoryBytes();
    }

    /**
     * What the active device says it can still hand out, in bytes — 0 when
     * the backend cannot answer.
     *
     * The counterpart to {@link #memoryBytes}, and the one a residency
     * policy wants. `memoryBytes` is a CAPACITY: on a UMA part it reports
     * the whole GTT pool, which is shared with the host page cache, so an
     * allocator that budgets against it finds the ceiling by failing.
     * This is the driver's own free-space accounting, from the same single
     * call (`hipMemGetInfo` / `cuMemGetInfo`) that answers the total.
     *
     * A LEVEL, NOT AN EVENT. Neither runtime offers a pressure
     * notification, so a policy built on this polls a watermark; there is
     * nothing to wake on.
     *
     * A DEVICE TOUCH, like {@link #memoryBytes}: asking selects the
     * backend if selection has not happened yet.
     *
     * @EntryPoint
     */
    public static int64 freeMemoryBytes() {
        return Device.nativeFreeMemoryBytes();
    }

    // The active backend probes its device features by capability ordinal (the
    // stable Capability contract). Returns 0 / 1.
    @Native("__cajeta_xpu_device_supports")
    private static int32 nativeSupports(int32 capability);

    @Native("__cajeta_xpu_cpu_set_worker_cap")
    private static void nativeSetWorkerCap(int32 n);

    @Native("__cajeta_xpu_cpu_worker_cap")
    private static int32 nativeWorkerCap();

    @Native("__cajeta_xpu_cpu_last_workers")
    private static int32 nativeLastWorkers();

    // Sets the forced backend id; returns 0 when selection already ran.
    @Native("__cajeta_xpu_force_backend")
    private static int32 nativeForce(int32 id);

    @Native("__cajeta_xpu_active_backend_id")
    private static int32 nativeActiveBackend();

    @Native("__cajeta_xpu_device_memory_bytes")
    private static int64 nativeMemoryBytes();

    @Native("__cajeta_xpu_device_free_memory_bytes")
    private static int64 nativeFreeMemoryBytes();

    /**
     * Is `name`'s device code actually REGISTERED for the active backend?
     *
     * A backend may skip a kernel at build (a NATIVE-only construct on the
     * shader tier is the standing example); launching a skipped kernel is a
     * loud no-op the caller cannot distinguish from success. A routing layer
     * choosing between kernel variants asks this and degrades to one that
     * exists, rather than assuming the build shipped everything.
     */
    public static boolean kernelAvailable(String name) {
        int8[] b #= name.toBytes();
        return Device.nativeKernelAvailable(b, (int64) b.count()) != 0;
    }

    @Native("__cajeta_xpu_kernel_available")
    private static int32 nativeKernelAvailable(int8[] name, int64 len);

    /**
     * Process-wide count of kernel dispatches that FAILED to run —
     * refused by the driver, or skipped because a binding would not
     * marshal. Monotonic; it never resets.
     *
     * A failed launch prints one line to stderr and the program keeps
     * going with whatever the output buffer already held, which reads
     * as a plausible answer. Anything that must not silently compute on
     * garbage snapshots this before a run and asserts the delta is zero
     * after.
     *
     * @EntryPoint
     */
    public static int64 launchFailures() {
        return Device.nativeLaunchFailures();
    }

    @Native("__cajeta_xpu_launch_failures")
    private static int64 nativeLaunchFailures();

    /**
     * Raise {@link XpuLaunchException} if the most recent launch on this thread
     * was REFUSED — no device code registered for the kernel on the active
     * backend, or a binding that would not marshal. The compiler emits a call
     * to this immediately after every `.launch()`, so a launch that would
     * otherwise silently no-op and leave the caller reading a stale output
     * buffer instead throws, naming the kernel and backend.
     *
     * A routing layer catches it and falls through to a route that exists; a
     * direct launch with no fallback lets it propagate and abort, rather than
     * computing on garbage. A launch that RAN clears the record (every launch
     * resets it on entry), so this is a no-op after a successful launch, and it
     * consumes the record it reads so a second call without an intervening
     * launch does not re-raise.
     *
     * @EntryPoint
     */
    public static void checkLaunch() {
        if (Device.nativeLastLaunchFailed() == 0) { return; }
        int32 be = Device.nativeLastLaunchBackend();
        Device.nativeConsumeLaunchRefusal();
        int8[] buf = heap int8[256];
        int64 n = Device.nativeLastLaunchName(buf, (int64) 256);
        String kernel #= heap String(#buf, (int32) n);
        String backend = "none";
        if (be == 0) { backend = "cuda"; }
        if (be == 1) { backend = "hip"; }
        if (be == 2) { backend = "vulkan"; }
        if (be == 3) { backend = "cpu"; }
        String msg #= "cajeta.xpu: launch refused for kernel '" + kernel
                    + "' on backend '" + backend
                    + "' (no device code registered)";
        throw heap XpuLaunchException(#msg);
    }

    @Native("__cajeta_xpu_last_launch_failed")
    private static int32 nativeLastLaunchFailed();

    @Native("__cajeta_xpu_last_launch_backend")
    private static int32 nativeLastLaunchBackend();

    @Native("__cajeta_xpu_last_launch_name")
    private static int64 nativeLastLaunchName(int8[] buf, int64 cap);

    @Native("__cajeta_xpu_consume_launch_refusal")
    private static void nativeConsumeLaunchRefusal();

    // ---- device geometry -------------------------------------------- //
    //
    // The queried machine shape, so a kernel can SIZE ITSELF instead of
    // carrying a constant measured on somebody else's part. Every accessor
    // returns 0 when the fact is unknown -- no device, profiling disabled,
    // or a runtime that does not report it. 0 is UNKNOWN and never a
    // budget: a caller branches on it, and MUST NOT substitute the value
    // another vendor would have given. Silently inheriting one part's
    // constants is precisely the defect this surface exists to undo (an
    // RTX 4090 spent months reporting gfx1151's register file).
    //
    // These are keys into one native accessor rather than a symbol each;
    // the key enum in cajeta_xpu_abi.h is append-only.

    static final int32 GEO_MP_COUNT              = 0;
    static final int32 GEO_SIMDS_PER_MP          = 1;
    static final int32 GEO_WAVE_SIZE             = 2;
    static final int32 GEO_MAX_THREADS_PER_BLOCK = 3;
    static final int32 GEO_LDS_PER_BLOCK         = 4;
    static final int32 GEO_LDS_PER_BLOCK_OPTIN   = 5;
    static final int32 GEO_LDS_PER_MP            = 6;
    static final int32 GEO_MAX_BLOCKS_PER_MP     = 7;
    static final int32 GEO_L2_CACHE_BYTES        = 8;
    static final int32 GEO_TOTAL_VRAM_BYTES      = 9;
    static final int32 GEO_INTEGRATED            = 10;
    static final int32 GEO_REGS_PER_MP           = 11;
    static final int32 GEO_THREADS_PER_MP        = 12;
    static final int32 GEO_MAX_GRID_DIM_X        = 13;
    static final int32 GEO_MAX_BLOCK_DIM_X       = 14;
    static final int32 GEO_WAVES_PER_SIMD_TARGET = 15;
    static final int32 GEO_CLOCK_KHZ             = 16;
    static final int32 GEO_MEMORY_CLOCK_KHZ      = 17;
    static final int32 GEO_MEMORY_BUS_WIDTH_BITS = 18;

    /**
     * Multiprocessors the driver reports: SMs on NVIDIA, WGPs on RDNA
     * (which is half the physical CU count -- the driver's unit, not the
     * marketing one). 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 multiprocessorCount() {
        return (int32) Device.nativeGeometry(Device.GEO_MP_COUNT);
    }

    /**
     * Scheduler partitions per multiprocessor. An ARCH constant, not a
     * driver attribute: an RDNA WGP is 2 CUs x 4 SIMD32 = 8, an NVIDIA SM
     * has 4. Deriving it from the thread cap would give 1.5 on Ada, which
     * is a residency limit and not a count of schedulers. 0 = unknown arch.
     *
     * @EntryPoint
     */
    public static int32 simdsPerMultiprocessor() {
        return (int32) Device.nativeGeometry(Device.GEO_SIMDS_PER_MP);
    }

    /**
     * Every SIMD on the part -- multiprocessors times partitions. This is
     * the DEVICE half of a dispatch decision; see {@link #dispatchBlocks}.
     * 0 when either factor is unknown.
     *
     * @EntryPoint
     */
    /**
     * Waves per SIMD the dispatch law aims for. EMPIRICAL, not a hardware
     * fact: 1 saturates an NVIDIA SM partition and the measured AMD target
     * is 2. It is stated separately because it used to hide inside a
     * doubled { #simdsPerMultiprocessor}, where a tuning choice read
     * as physics. 1 when the device is unknown, so the law degrades to
     * "one block's worth of waves per SIMD" rather than to zero.
     *
     * 
     */
    public static int32 wavesPerSimdTarget() {
        int32 t = (int32) Device.nativeGeometry(Device.GEO_WAVES_PER_SIMD_TARGET);
        if (t <= 0) { return 1; }
        return t;
    }

    public static int32 simdCount() {
        return Device.multiprocessorCount() * Device.simdsPerMultiprocessor();
    }

    /**
     * How many workgroups to dispatch so that every SIMD gets exactly one
     * block's worth of waves, given a kernel that puts `wavesPerBlock`
     * waves on a SIMD.
     *
     *   blocks = (multiprocessors x SIMDs per MP x waves per SIMD target)
     *            / wavesPerBlock
     *
     * A FLOOR, not a maximum, and a caller is right to tune above it.
     *
     * This used to say it was a saturation point past which extra waves
     * evict each other from L1/L2 and throughput falls on both sides. That
     * was measured on gfx1151 and it does NOT hold generally. Measured on
     * sm_89, 2026-09-19, sweeping the interleaved Q4_K mat-vec over a
     * 288 MB weight (past both parts' last-level cache):
     *
     *    80 workgroups (gfx1151's answer)     84.8 GB/s
     *   256 workgroups (what this returns)   260.4
     *  2048 workgroups (the whole problem)   654.7   -- still climbing
     *
     * The two parts do not merely want different numbers, their curves
     * have different SHAPES: gfx1151 has a genuine interior peak, because
     * extra waves thrash a 32 MB MALL on LPDDR5X; Ada is monotonic to the
     * whole problem, because 72 MB of L2 on ~1 TB/s GDDR6X needs many
     * waves in flight to cover latency. No formula over reported
     * attributes covers both.
     *
     * So treat this as the starting point of a sweep, not its result. The
     * measured answer belongs in {@link cajeta.xpu.Autotune}, keyed per
     * machine -- which is what the spec's third tier is for, and what
     * {@link #l2CacheBytes} sitting beside it was always hinting at.
     *
     * Returns 0 when the device is unknown or `wavesPerBlock` is 0 -- a
     * caller keeps its own measured constant in that case rather than
     * dispatching a guess.
     *
     * @EntryPoint
     */
    public static int32 dispatchBlocks(int32 wavesPerBlock) {
        if (wavesPerBlock <= 0) {
            return 0;
        }
        int32 simds = Device.simdCount();
        if (simds <= 0) {
            return 0;
        }
        return simds * Device.wavesPerSimdTarget() / wavesPerBlock;
    }

    /**
     * Shared memory ONE BLOCK may use, in bytes -- the ceiling a static
     * tile is actually checked against.
     *
     * Not the same as {@link #sharedBytesPerMultiprocessor}, and the
     * difference is load-bearing: an RTX 4090's SM holds 102400 bytes but
     * caps a block at 49152 unless the launch opts in, while on RDNA the
     * two figures are equal. A 55296-byte tile sized against the per-MP
     * number therefore assembles on gfx1151 and fails on Ada with
     * `ptxas error: uses too much shared data`. Size tiles against THIS.
     *
     * Falls back to the per-multiprocessor budget when a runtime reports
     * no per-block figure (which is what AMD has always effectively used).
     * 0 = unknown.
     *
     * @EntryPoint
     */
    public static int64 sharedBytesPerBlock() {
        return Device.nativeGeometry(Device.GEO_LDS_PER_BLOCK);
    }

    /**
     * The RAISED per-block shared ceiling, reachable only by opting in at
     * launch (101376 bytes on an RTX 4090 against a 49152 default). A
     * static tile never gets it -- the allocation has to be dynamic. 0
     * when the runtime reports no separate opt-in ceiling, which is the
     * AMD case and means "no opt-in exists", not "none available".
     *
     * @EntryPoint
     */
    public static int64 sharedBytesPerBlockOptIn() {
        return Device.nativeGeometry(Device.GEO_LDS_PER_BLOCK_OPTIN);
    }

    /**
     * Shared memory per multiprocessor -- the budget resident blocks share,
     * and an occupancy input. NOT the ceiling for one block: see
     * {@link #sharedBytesPerBlock}. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int64 sharedBytesPerMultiprocessor() {
        return Device.nativeGeometry(Device.GEO_LDS_PER_MP);
    }

    /**
     * Resident blocks one multiprocessor will hold (24 on Ada), a limiter
     * independent of registers and shared memory. 0 = not reported.
     *
     * @EntryPoint
     */
    public static int32 maxBlocksPerMultiprocessor() {
        return (int32) Device.nativeGeometry(Device.GEO_MAX_BLOCKS_PER_MP);
    }

    /**
     * L2 cache size in bytes. The limiter a saturation target is really
     * bound by, and it varies by an order of magnitude across parts an
     * identical kernel runs on. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int64 l2CacheBytes() {
        return Device.nativeGeometry(Device.GEO_L2_CACHE_BYTES);
    }

    /**
     * Total device memory in bytes, as the driver reports it. 0 = unknown.
     * A capacity, not a budget.
     *
     * @EntryPoint
     */
    public static int64 vramBytes() {
        return Device.nativeGeometry(Device.GEO_TOTAL_VRAM_BYTES);
    }

    /**
     * Is the device INTEGRATED -- an APU sharing the host's memory?
     *
     * Decides whether a host-to-device copy is a real transfer or a
     * pointer hand-off, which changes where a residency decision lands
     * rather than merely how fast it is. False on an unknown device: a
     * discrete part is the assumption that costs a copy, not correctness.
     *
     * @EntryPoint
     */
    public static boolean integrated() {
        return Device.nativeGeometry(Device.GEO_INTEGRATED) != 0;
    }

    /**
     * 32-bit registers per multiprocessor -- the occupancy denominator.
     * 0 = unknown.
     *
     * @EntryPoint
     */
    public static int64 registersPerMultiprocessor() {
        return Device.nativeGeometry(Device.GEO_REGS_PER_MP);
    }

    /**
     * Threads resident per multiprocessor. Divided by {@link #waveSize}
     * this is the wave-residency cap. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 threadsPerMultiprocessor() {
        return (int32) Device.nativeGeometry(Device.GEO_THREADS_PER_MP);
    }

    /**
     * Threads per wave/warp: 32 on RDNA wave32 and on every NVIDIA part,
     * 64 on GCN and on RDNA in wave64. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 waveSize() {
        return (int32) Device.nativeGeometry(Device.GEO_WAVE_SIZE);
    }

    /**
     * The largest block the device will launch. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 maxThreadsPerBlock() {
        return (int32) Device.nativeGeometry(Device.GEO_MAX_THREADS_PER_BLOCK);
    }

    /**
     * Largest grid extent in X -- the clamp a stepped dispatch checks
     * before splitting a launch. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int64 maxGridDimX() {
        return Device.nativeGeometry(Device.GEO_MAX_GRID_DIM_X);
    }

    /**
     * Largest block extent in X. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 maxBlockDimX() {
        return (int32) Device.nativeGeometry(Device.GEO_MAX_BLOCK_DIM_X);
    }

    /**
     * Core clock the driver reports, kHz. It is the MAXIMUM (boost) clock,
     * so a cycle count divided by it is the SHORTEST a kernel can take: the
     * calibration KernelTimer is checked against. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 clockKHz() {
        return (int32) Device.nativeGeometry(Device.GEO_CLOCK_KHZ);
    }

    /**
     * Memory clock the driver reports, kHz. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 memoryClockKHz() {
        return (int32) Device.nativeGeometry(Device.GEO_MEMORY_CLOCK_KHZ);
    }

    /**
     * Width of the memory bus, bits. 0 = unknown.
     *
     * @EntryPoint
     */
    public static int32 memoryBusWidthBits() {
        return (int32) Device.nativeGeometry(Device.GEO_MEMORY_BUS_WIDTH_BITS);
    }

    /**
     * THEORETICAL peak memory bandwidth, GB/s: two transfers per memory
     * clock across the bus (double data rate). The RTX 4090 reports
     * 10501000 kHz over 384 bits, which is 1008 GB/s; its MEASURED roofline
     * is lower (859 GB/s, spec xpu-kernel-adaptor §7). This is the ceiling
     * {@link KernelTimer#withinPeak} rejects a bandwidth claim above, never
     * a rate to expect. 0.0 when the driver reports no clock or no bus.
     *
     * @EntryPoint
     */
    public static float64 peakBandwidthGBps() {
        int64 khz  = Device.nativeGeometry(Device.GEO_MEMORY_CLOCK_KHZ);
        int64 bits = Device.nativeGeometry(Device.GEO_MEMORY_BUS_WIDTH_BITS);
        if (khz <= 0L || bits <= 0L) {
            return 0.0;
        }
        return 2.0 * (float64) khz * 1000.0 * ((float64) bits / 8.0) / 1.0e9;
    }

    // One native symbol, keyed. The key enum in cajeta_xpu_abi.h is
    // append-only; an unknown key answers 0 rather than trapping, so an
    // older runtime paired with a newer stdlib degrades to "unknown"
    // instead of failing to link.
    @Native("__cajeta_xpu_device_geometry")
    private static int64 nativeGeometry(int32 key);
}
