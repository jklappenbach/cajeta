package cajeta.xpu;

/**
 * The RUNTIME question, and what a row is dispatched with: the static query
 * plus whatever the registrant extends this with — the receiver, the operands,
 * the slice being launched.
 *
 * It HOLDS a query rather than extending one, so a registrant's call type can
 * extend this and still carry its own query subclass; the static facts are
 * declared once and read by both halves.
 */
public class RouteCall {
    public RouteQuery query;

    public RouteCall(RouteQuery q) {
        this.query #= q;
    }
}
