package cajeta.xpu.core;

/**
 * Buffer<T> — unified handle to device memory.
 *
 * The cross-cutting type higher-level libraries (cajeta.math,
 * Prism, Torch, cajeta.render) write against. Backends tag the
 * underlying storage handle (CUdeviceptr / hipDeviceptr_t /
 * VkBuffer); from the user's perspective it's one opaque type
 * with a length and the standard upload/download/free operations.
 *
 * Indexing `buf[i]` is only legal inside @Kernel or @Device
 * functions and produces a borrow of the element type. On the
 * host, callers use the explicit upload/download paths.
 *
 * Per CajetaXPU.md §3.6. The allocator path is intentionally not
 * exposed here in v1 — `alloc(count)` lands once generic static
 * factories are wired in the compiler (the Optional Some/None
 * factories block the same item). Until then, Buffer instances are
 * constructed by the launch-site machinery and surfaced to the user
 * through helpers in the vendor namespaces.
 */
public final class Buffer<T> {
    int64 deviceHandle;
    uint64 elementCount;

    Buffer(int64 deviceHandle, uint64 elementCount) {
        this.deviceHandle = deviceHandle;
        this.elementCount = elementCount;
    }

    public uint64 length() {
        return this.elementCount;
    }

    /**
     * Host → device transfer of `host` into this buffer. The host
     * array's element count must equal `length()`. Issued on the
     * default stream; for stream-ordered uploads, see the vendor
     * namespace.
     */
    @Native("__cajeta_xpu_buffer_upload")
    public void upload(T[] host);

    @Native("__cajeta_xpu_buffer_download")
    public void download(T[] host);

    @Native("__cajeta_xpu_buffer_free")
    public void free();
}
