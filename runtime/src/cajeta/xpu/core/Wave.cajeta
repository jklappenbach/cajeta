package cajeta.xpu.core;

/**
 * Wave — wave-level (warp / wavefront / subgroup) primitives.
 *
 * Per CajetaXPU.md §3.2, the wave width is queryable at compile and
 * run time. The width is a `const` expression per *target* (not
 * per-launch): NVIDIA = 32 fixed, AMD CDNA = 64, AMD RDNA = 32 or
 * 64 (build-flag selected), Vulkan = runtime query at pipeline-
 * create. This is row 1 of CajetaXPU-Variance.md — by the time
 * `width()` returns, the value is target-known.
 *
 * Shuffle/ballot lower to wave-level intrinsics:
 *   NVPTX:  llvm.nvvm.shfl.sync.*, llvm.nvvm.vote.sync.ballot
 *   AMDGPU: llvm.amdgcn.ds.bpermute / permlane*, llvm.amdgcn.ballot
 *   SPIR-V: GroupNonUniformShuffle, GroupNonUniformBallot
 */
public final class Wave {

    @Native("__cajeta_xpu_wave_width")
    public static uint32 width();

    /**
     * Read `value` from the lane identified by `srcLane`. All lanes
     * in the wave participate; `srcLane` may be uniform or
     * divergent. The .sync suffix on NVPTX is implicit — Cajeta's
     * borrow + barrier rules require a wave-uniform precondition
     * that the lowering checks.
     */
    @Native("__cajeta_xpu_wave_shuffle_sync_u32")
    public static uint32 shuffleSync(uint32 value, uint32 srcLane);

    /**
     * Bitmask of lanes in the wave for which `predicate` is true.
     * Bit `i` corresponds to lane `i`.
     */
    @Native("__cajeta_xpu_wave_ballot_sync")
    public static uint64 ballotSync(boolean predicate);

    /**
     * Wave-wide reduction: the sum of `value` across all active lanes
     * of the wave. Every lane receives the same total.
     *
     * Maps to a single hardware wave-reduce intrinsic on every backend:
     *   NVPTX:  llvm.nvvm.redux.sync.add  (requires sm_80+ / Ampere)
     *   AMDGPU: llvm.amdgcn.wave.reduce.add
     *   SPIR-V: llvm.spv.wave.reduce.sum  (→ OpGroupNonUniformIAdd Reduce)
     */
    @Native("__cajeta_xpu_wave_reduce_sum_u32")
    public static uint32 reduceSum(uint32 value);
}
