package cajeta.xpu.core;

/**
 * Capability traits — compile-time feature gates per CajetaXPU.md
 * §3.3 and §4.
 *
 * A kernel that needs a capability bounds it as a template
 * constraint:
 *
 *     @Kernel
 *     void gemmMma<Target: TensorCoreF16>(...) {
 *         Tensor.mmaF16F32<16, 16, 16>(...);
 *     }
 *
 * The `Target` parameter is resolved at codegen — each backend
 * registers its own set of capability-trait implementers based on
 * the configured device family.
 *
 * v1 declares the trait shells. The implementations live in the
 * vendor namespaces (cajeta.xpu.nvidia for NV-specific, etc.) and
 * register against these traits at compiler startup based on
 * `--xpu-backend` and `--xpu-arch`.
 *
 * Empty bodies — these are marker interfaces only.
 */

public interface TensorCoreF16 { }

public interface TensorCoreBF16 { }

public interface TensorCoreFP8 { }

public interface WaveBallot { }

public interface WaveShuffle { }

public interface AsyncCopy { }

public interface AtomicFloatAdd { }
