package cajeta.xpu.core;

/**
 * Image2D — a writable 2-D image of float32 texels, the write twin of
 * {@link Texture2D}. A kernel WRITES texels with `img.store(x, y, value)`
 * (lowered to a storage-image write, the GPU's OpImageWrite), and the host
 * reads the result back with `img.download(out)`.
 *
 * Where Texture2D binds a read-only SAMPLED_IMAGE sampled through a
 * {@link Sampler} with hardware filtering, Image2D binds a writable
 * STORAGE_IMAGE: no sampler, integer (x, y) texel coordinates, and a kernel may
 * store to any texel. It is the "gfx bridge" surface — compute kernels that
 * produce an image (procedural fills, rasterization, image-to-image passes).
 *
 * Like {@link Buffer} and Texture2D, this is a small host-side handle
 * (deviceHandle + width/height) over a device image resource governed by the
 * drop chain: the constructor acquires the device image and ~Image2D() releases
 * it at scope exit. A launch borrows each Image2D argument until the next
 * Stream.sync().
 *
 *     Image2D img = heap Image2D(w, h);
 *     kernel.launch(s, ...)(img, ...);          // kernel writes img.store(x,y,v)
 *     s.sync();
 *     float32[] out = new float32[w * h];
 *     img.download(out);                        // row-major width*height
 *     // device image freed automatically at scope exit
 *
 * v1 LIMITS: 2-D, single-channel float32 texels, Vulkan-only (the gfx bridge);
 * other backends reject `store` at lowering. Generic Image2D<T>, 3-D, integer
 * formats, and in-kernel reads (load) are follow-ups.
 */
public final class Image2D {
    int64 deviceHandle;
    uint32 width;
    uint32 height;

    Image2D(int64 deviceHandle, uint32 width, uint32 height) {
        this.deviceHandle = deviceHandle;
        this.width = width;
        this.height = height;
    }

    /**
     * RAII constructor: allocate a `width` x `height` float32 writable device
     * image. The constructor acquires the device image and ~Image2D() releases it.
     */
    public Image2D(uint32 width, uint32 height) {
        this.width = width;
        this.height = height;
        this.deviceHandle = this.deviceAlloc(width, height);
    }

    /**
     * Destructor — release the device image. Runs via the drop chain at scope
     * exit. Null-guarded and idempotent.
     */
    ~Image2D() {
        if (this.deviceHandle != 0) {
            this.deviceFree(this.deviceHandle);
            this.deviceHandle = 0;
        }
    }

    public uint32 imageWidth() {
        return this.width;
    }

    public uint32 imageHeight() {
        return this.height;
    }

    /**
     * Device-only intrinsic: store `value` into this image at INTEGER texel
     * coordinate (x, y). Lowered at the call site inside an @Kernel / @Device
     * function to the backend's image-write op (Vulkan OpImageWrite via
     * llvm.spv.resource.store.2d). The body here is a resolution placeholder — it
     * is never emitted as a real call. Storing on the host (outside a kernel) is
     * unsupported.
     */
    public void store(uint32 x, uint32 y, float32 value) {
    }

    /**
     * Host <- device transfer of `width`*`height` row-major float32 texels into
     * `out` (the texels a kernel wrote). `out` must hold at least width*height.
     */
    public void download(float32[] out) {
        this.deviceDownload(this.deviceHandle, out, this.width, this.height);
    }

    // Device-image primitives. Instance @Native methods (the Buffer convention):
    // pointer-shaped at the ABI boundary, so one C symbol per name serves the
    // type. The leading `this` the forwarder passes is ignored by the C side.
    @Native("__cajeta_xpu_image_alloc")
    private int64 deviceAlloc(uint32 width, uint32 height);

    @Native("__cajeta_xpu_image_download")
    private void deviceDownload(int64 handle, float32[] out, uint32 width, uint32 height);

    @Native("__cajeta_xpu_image_free")
    private void deviceFree(int64 handle);
}
