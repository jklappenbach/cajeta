package cajeta.xpu.core;

/**
 * Quad — quad-level (2x2) cross-lane primitives.
 *
 * A *quad* is the four work-items with consecutive lane indices
 * `[laneId() & ~3 .. +3]` — the 2x2 group the hardware uses for
 * screen-space derivatives and small-tile cooperation. Quad ops are
 * a finer-grained sibling of {@link Wave}: where a wave op spans the
 * whole subgroup (32/64 lanes), a quad op spans exactly four, which
 * makes them the natural primitive for 2x2 stencils, tiny transposes,
 * and per-quad voting.
 *
 * The lane layout matches across backends — Vulkan defines a quad as
 * four consecutive `SubgroupLocalInvocationId`s, and the portable
 * lowering (NVIDIA / AMD / CPU) uses the same `laneId() & ~3` base —
 * so the same source is bit-identical everywhere.
 *
 * Lowering (per CajetaXPU.md §3.3):
 *   Vulkan:  OpGroupNonUniformQuadBroadcast / QuadSwap (core), and
 *            OpGroupNonUniformQuadAllKHR / QuadAnyKHR
 *            (SPV_KHR_quad_control), via the fork llvm.spv.quad.*
 *            intrinsics.
 *   AMDGPU / NVPTX / CPU: the width-agnostic shuffle / ballot form
 *            built on the Wave seams (no native quad op needed).
 *
 * Quad ops are cross-lane, so a kernel that uses one is flagged for
 * maximal reconvergence (the same guarantee as the Wave cross-lane ops).
 */
public final class Quad {

    /**
     * Read `value` from quad lane `index` (`0..3`); every lane of the
     * quad receives that lane's value — the per-quad broadcast.
     *
     *   Vulkan: OpGroupNonUniformQuadBroadcast
     *   other:  shuffle from lane `(laneId() & ~3) + index`
     */
    @Native("__cajeta_xpu_quad_broadcast")
    public static uint32 broadcast(uint32 value, uint32 index);

    /**
     * Exchange `value` horizontally across the quad (lanes 0<->1,
     * 2<->3) — the partner lane is `laneId() ^ 1`.
     *
     *   Vulkan: OpGroupNonUniformQuadSwap Direction 0
     *   other:  shuffle from lane `laneId() ^ 1`
     */
    @Native("__cajeta_xpu_quad_swap_horizontal")
    public static uint32 swapHorizontal(uint32 value);

    /**
     * Exchange `value` vertically across the quad (lanes 0<->2,
     * 1<->3) — the partner lane is `laneId() ^ 2`. See
     * {@link #swapHorizontal}.
     */
    @Native("__cajeta_xpu_quad_swap_vertical")
    public static uint32 swapVertical(uint32 value);

    /**
     * Exchange `value` diagonally across the quad (lanes 0<->3,
     * 1<->2) — the partner lane is `laneId() ^ 3`. See
     * {@link #swapHorizontal}.
     */
    @Native("__cajeta_xpu_quad_swap_diagonal")
    public static uint32 swapDiagonal(uint32 value);

    /**
     * Quad-wide AND vote: true iff `predicate` is true for every lane
     * of the quad. The 2x2 analogue of a wave ballot reduced to a
     * single bool — e.g. "are all four texels in this quad inside the
     * mask?".
     *
     *   Vulkan: OpGroupNonUniformQuadAllKHR (SPV_KHR_quad_control)
     *   other:  ballot, then test this lane's quad nibble == 0xF
     */
    @Native("__cajeta_xpu_quad_all")
    public static boolean all(boolean predicate);

    /**
     * Quad-wide OR vote: true iff `predicate` is true for some lane of
     * the quad. See {@link #all}.
     *
     *   Vulkan: OpGroupNonUniformQuadAnyKHR (SPV_KHR_quad_control)
     *   other:  ballot, then test this lane's quad nibble != 0
     */
    @Native("__cajeta_xpu_quad_any")
    public static boolean any(boolean predicate);
}
