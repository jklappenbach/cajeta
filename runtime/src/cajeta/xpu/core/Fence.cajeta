package cajeta.xpu.core;

/**
 * Fence — host-observable signal.
 *
 * Where Event is device-side (cheap cross-stream dependency, can be
 * waited on by other streams), Fence is the host-side equivalent —
 * a signal the CPU can poll or block on without involving the
 * device beyond the initial submission.
 *
 * v1 implementation is a thin wrapper over `Stream.sync()` on the
 * native backends; on Vulkan it lowers to `VkFence` or a timeline-
 * semaphore host-wait. Per CajetaXPU.md §3.5.
 */
public final class Fence {
    int64 handle;

    Fence(int64 handle) {
        this.handle = handle;
    }

    @Native("__cajeta_xpu_fence_create")
    public static Fence create();

    /**
     * Signal this fence after every launch currently queued on
     * `stream` completes. The host can poll `query()` or block in
     * `waitHost()` to observe the signal.
     */
    @Native("__cajeta_xpu_fence_signal")
    public void signal(Stream stream);

    @Native("__cajeta_xpu_fence_wait")
    public void waitHost();

    @Native("__cajeta_xpu_fence_query")
    public boolean query();

    @Native("__cajeta_xpu_fence_destroy")
    public void destroy();
}
