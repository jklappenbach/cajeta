package cajeta.xpu;

import cajeta.lang.String;

/**
 * One row of the selection contract: ONE kernel variant, serving ONE format,
 * in one regime. Q4_K's wave variant and its packed variant are two rows, and
 * {@link #priority} orders them.
 *
 * One variant per row is what lets `dispatch` have no arms — and so no bare
 * `else` for a new format to fall through, which is the shape of defect this
 * contract exists to stop. It is also what a weight stores in place of the
 * sixteen booleans it resolves at bind today.
 *
 * A route is an interface a registrant implements, never a record of function
 * values: a dispatcher launches kernels, and a kernel launch inside a lambda
 * has unreachable captured buffers in launch codegen.
 *
 * Admission has two halves and they are different questions. {@link #fits} is
 * pure over declared facts and is what the audit walks with nothing bound;
 * {@link #ready} reads the receiver's state — a slab that did or did not bind,
 * a widen that was refused — and is a runtime refusal no audit can check.
 * Tangling them is the defect, not an incidental of it.
 */
public interface Route {

    /** What a refusal, a route record or the audit prints for this row. */
    String name();

    /** The call shape this row serves. */
    Regime regime();

    /** The one format this variant serves. */
    int32 format();

    /** Order among rows serving the same (format, regime); higher first. */
    int32 priority();

    /**
     * The static half: does this row serve `q`'s shape. Pure over `q`'s
     * declared facts — there is no receiver in a query to read.
     */
    boolean fits(RouteQuery q);

    /**
     * Capabilities the active device must have, or null for none. A STORED
     * list, so asking costs no allocation and a refusal can name which one
     * was missing.
     */
    Capability[] needs();

    /** The runtime half: is this receiver's state ready for the row. */
    boolean ready(RouteCall c);

    /** Launch. One variant, one kernel: nothing to choose here. */
    void dispatch(RouteCall c);
}
