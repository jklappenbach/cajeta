package cajeta.xpu;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/**
 * XpuLaunchException — raised at a kernel launch site when the launch was
 * REFUSED: no device code is registered for the kernel on the active backend,
 * or a binding would not marshal. The motivating failure (spec §2.1.3): a
 * skipped or never-declared kernel registers no module, so its launch prints
 * `no registered kernel` and no-ops — and the caller reads back whatever the
 * output buffer already held as a plausible answer, a false sense that the run
 * worked. {@link Device#checkLaunch}, which the compiler emits after every
 * `.launch()`, raises this instead — naming the kernel and the backend it was
 * refused on, so a route table can FALL THROUGH to a route that exists rather
 * than compute on garbage.
 *
 * Recoverable, not Unrecoverable: a routing layer must be able to CATCH it and
 * try another route (the acceptance criterion is "catchable, so a route table
 * can fall through rather than crash"). Left uncaught it propagates to the
 * top-level handler and aborts loudly — the intended behavior for a direct
 * launch with no fallback, where a silent zero-fill would be exactly the false
 * confidence this exists to undo. Mirrors {@link cajeta.ifx.IfxException}.
 */
public class XpuLaunchException extends RecoverableException {
    public XpuLaunchException(#String message) {
        this.message = message;
        this.cause = 0;
    }
}
