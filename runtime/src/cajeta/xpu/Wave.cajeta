package cajeta.xpu;

/**
 * Wave — wave-level (warp / wavefront / subgroup) primitives.
 *
 * Per CajetaXPU.md §3.2, the wave width is queryable at compile and
 * run time. The width is a `const` expression per *target* (not
 * per-launch): NVIDIA = 32 fixed, AMD CDNA = 64, AMD RDNA = 32 or
 * 64 (build-flag selected), Vulkan = runtime query at pipeline-
 * create. This is row 1 of CajetaXPU-Variance.md — by the time
 * `width()` returns, the value is target-known.
 *
 * Shuffle/ballot lower to wave-level intrinsics:
 *   NVPTX:  llvm.nvvm.shfl.sync.*, llvm.nvvm.vote.sync.ballot
 *   AMDGPU: llvm.amdgcn.ds.bpermute / permlane*, llvm.amdgcn.ballot
 *   SPIR-V: GroupNonUniformShuffle, GroupNonUniformBallot
 */
public final class Wave {

    @Native("__cajeta_xpu_wave_width")
    public static uint32 width();

    /**
     * This work-item's lane index within its wave, in `[0, width())`.
     * Together with `width()` this is the environment-interrogation
     * surface: write wave-cooperative kernels in terms of `laneId()`
     * and `width()` — never a hardcoded width — and the same source is
     * correct on NVIDIA (32), AMD (32/64), Vulkan (runtime), and CPU
     * (the host SIMD width, e.g. 16 on AVX-512 / 8 on AVX2).
     *
     *   NVPTX:  %laneid sreg
     *   AMDGPU: mbcnt.hi(~0, mbcnt.lo(~0, 0))
     *   SPIR-V: SubgroupLocalInvocationId
     *   CPU:    work-item index mod width
     */
    @Native("__cajeta_xpu_wave_lane_id")
    public static uint32 laneId();

    /**
     * True for exactly one lane of the wave — the lowest-indexed
     * (`laneId() == 0`). The canonical width-agnostic cooperation
     * guard: have one lane commit the wave's reduced/ballot result.
     * Built on `laneId()`, so it is correct at any wave width.
     */
    @Native("__cajeta_xpu_wave_is_first_lane")
    public static boolean isFirstLane();

    /**
     * Read `value` from the lane identified by `srcLane`. All lanes
     * in the wave participate; `srcLane` may be uniform or
     * divergent. The .sync suffix on NVPTX is implicit — Cajeta's
     * borrow + barrier rules require a wave-uniform precondition
     * that the lowering checks.
     */
    @Native("__cajeta_xpu_wave_shuffle_sync_u32")
    public static uint32 shuffleSync(uint32 value, uint32 srcLane);

    /**
     * Bitmask of lanes in the wave for which `predicate` is true.
     * Bit `i` corresponds to lane `i`.
     */
    @Native("__cajeta_xpu_wave_ballot_sync")
    public static uint64 ballotSync(boolean predicate);

    /**
     * Wave-wide reduction: the sum of `value` across all active lanes
     * of the wave. Every lane receives the same total.
     *
     * Maps to a single hardware wave-reduce intrinsic on every backend:
     *   NVPTX:  llvm.nvvm.redux.sync.add  (requires sm_80+ / Ampere)
     *   AMDGPU: llvm.amdgcn.wave.reduce.add
     *   SPIR-V: llvm.spv.wave.reduce.sum  (→ OpGroupNonUniformIAdd Reduce)
     */
    @Native("__cajeta_xpu_wave_reduce_sum_u32")
    public static uint32 reduceSum(uint32 value);

    /**
     * Wave-wide maximum of `value` across the active lanes (UNSIGNED); every
     * lane receives the same result. Native on every backend:
     *   NVPTX:  redux.sync.umax   (sm_80+)
     *   AMDGPU: wave.reduce.umax
     *   SPIR-V: OpGroupNonUniformUMax (Reduce)
     */
    @Native("__cajeta_xpu_wave_reduce_max_u32")
    public static uint32 reduceMax(uint32 value);

    /**
     * Wave-wide float SUM of `value` across the active lanes; every lane
     * receives the same total. The reduction tree's association is the
     * hardware's — callers must tolerate reassociation-level rounding.
     *   AMDGPU: llvm.amdgcn.wave.reduce.fadd
     *   SPIR-V: OpGroupNonUniformFAdd (Reduce)
     *   NVPTX:  shuffle butterfly (no float redux.sync before sm_100)
     *   CPU:    VFABI f32 reduce variant
     */
    @Native("__cajeta_xpu_wave_reduce_sum_f32")
    public static float32 reduceSumF32(float32 value);

    /**
     * Wave-wide float MAXIMUM across the active lanes (maxnum semantics);
     * every lane receives the same result. See {@link #reduceSumF32} for the
     * per-backend lowering shape.
     */
    @Native("__cajeta_xpu_wave_reduce_max_f32")
    public static float32 reduceMaxF32(float32 value);

    /** Wave-wide minimum (UNSIGNED). See {@link #reduceMax}. */
    @Native("__cajeta_xpu_wave_reduce_min_u32")
    public static uint32 reduceMin(uint32 value);

    /** Wave-wide bitwise AND across the active lanes. */
    @Native("__cajeta_xpu_wave_reduce_and_u32")
    public static uint32 reduceAnd(uint32 value);

    /** Wave-wide bitwise OR across the active lanes. */
    @Native("__cajeta_xpu_wave_reduce_or_u32")
    public static uint32 reduceOr(uint32 value);

    /** Wave-wide bitwise XOR across the active lanes. */
    @Native("__cajeta_xpu_wave_reduce_xor_u32")
    public static uint32 reduceXor(uint32 value);

    /**
     * EXCLUSIVE prefix sum across the lanes: lane `i` receives the sum of
     * `value` from lanes `0..i-1`; lane 0 receives 0. The building block of
     * stream compaction, per-wave offset assignment, and sorting.
     *
     *   Vulkan: OpGroupNonUniformIAdd (ExclusiveScan)
     *   AMD:    ds_bpermute Hillis-Steele scan
     *   NVPTX:  shfl Hillis-Steele scan
     *   CPU:    in-lane VFABI scan
     */
    @Native("__cajeta_xpu_wave_prefix_sum_u32")
    public static uint32 prefixSum(uint32 value);

    /**
     * EXCLUSIVE prefix product across the lanes: lane `i` receives the product
     * of `value` from lanes `0..i-1`; lane 0 receives 1. See {@link #prefixSum}.
     */
    @Native("__cajeta_xpu_wave_prefix_product_u32")
    public static uint32 prefixProduct(uint32 value);

    /**
     * Wave rotate: read `value` from the lane `delta` positions ahead within
     * the wave, modulo the wave width — i.e. from lane
     * `(laneId() + delta) mod width()`. A wave-uniform cyclic shift of values
     * across lanes (the stencil / neighbour-exchange primitive).
     *
     * Vulkan lowers to a single OpGroupNonUniformRotateKHR at Subgroup scope
     * (SPV_KHR_subgroup_rotate); NVIDIA/AMD/CPU get the width-agnostic shuffle
     * form `shuffleSync(value, (laneId() + delta) mod width())` for free.
     */
    @Native("__cajeta_xpu_wave_rotate_u32")
    public static uint32 rotate(uint32 value, uint32 delta);
}
