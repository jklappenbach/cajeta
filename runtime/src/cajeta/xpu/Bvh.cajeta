package cajeta.xpu;

import cajeta.xpu.Lbvh;
import cajeta.xpu.Strategy;

/**
 * Bvh — the strategy-based acceleration-structure facade (cajeta-accel; spec
 * specs/archive/cajeta-accel-spec.md §2). One logical handle over a frozen BVH block,
 * tagged with the encoding {@link Strategy} (Exact / Quantized) and the branching
 * WIDTH that produced it, so query code is identical regardless of how the
 * structure was built or which backend runs it. The strategy/width tag travels on
 * the handle, making the structure self-describing without decoding nodes.
 *
 * This slice is the CONTRACT + the Reference adapter (cajeta-accel-plan unit 1):
 * with no override, {@link #build} produces the REFERENCE structure — the `Exact`
 * strategy at width 2, today's binary full-float block from {@link Lbvh} — which
 * is the correctness ORACLE every other (strategy, width) cell is cross-checked
 * against. {@link #closestHit} drives the same stackless threaded walk the shipped
 * {@link SoftwareRayQuery} traverses on device (the host convenience over the
 * single device traversal). The wide Exact/Quantized strategies, capability-driven
 * width lowering, the `@Accel` override, and the GPU-side build are sibling slices.
 *
 * CODEGEN DISCIPLINE: float header words decode to int via {@link Lbvh#floorToInt}
 * (the float64->int64->int32 chain); block elements are loaded into locals before
 * being passed as call arguments (the subscript-as-arg gotcha).
 */
public final class Bvh {

    float32[] block;   // the frozen threaded-DFS block (owned)
    Strategy strat;    // encoding-strategy tag
    int32 widthVal;    // branching-width tag
    int32 prims;       // primitive count

    public Bvh(#float32[] block, Strategy strat, int32 widthVal, int32 prims) {
        // The Bvh OWNS its block — the caller transfers the freshly-built array
        // in (`#block`). Without ownership transfer, the build-site local drops
        // at scope exit and frees the array `this.block` still references — a
        // use-after-free on every later header/node read.
        this.block = block;
        this.strat = strat;
        this.widthVal = widthVal;
        this.prims = prims;
    }

    /**
     * Build the REFERENCE structure (`Exact` @ width 2) over `count` AABBs (6
     * floats each: min.xyz, max.xyz). The no-override default — delegates to
     * {@link Lbvh#build} (the binary full-float threaded-DFS block) and tags the
     * handle Exact/2. Capability-driven strategy/width selection, the wide
     * strategies, and the `@Accel` override are later slices.
     */
    public static #Bvh build(float32[] boxes, int32 count) {
        float32[] blk = Lbvh.build(boxes, count);
        Bvh b = heap Bvh(#blk, Strategy.Exact, 2, count);
        return #b;
    }

    /** The encoding strategy this structure was built with. */
    public Strategy strategy() {
        return this.strat;
    }

    /** The branching width this structure was built at. */
    public int32 width() {
        return this.widthVal;
    }

    /** The primitive count. */
    public int32 primCount() {
        return this.prims;
    }

    /** Node count, read from the block header (no node decode). */
    public int32 nodeCount() {
        return Lbvh.floorToInt(this.block[1]);
    }

    /** Raw block word read — header inspection and tests. */
    public float32 word(int32 i) {
        return this.block[i];
    }

    /**
     * Slab entry distance (tNear) of the ray against the AABB over [tMin, tMax],
     * or `tMax + 1` (a sentinel "miss") when the ray does not enter the box. An
     * axis whose direction component is ~0 degenerates to a containment test on
     * that axis. This is the nearest-hit metric the threaded walk minimizes.
     */
    private static float32 boxEntry(
            float32 ox, float32 oy, float32 oz,
            float32 dx, float32 dy, float32 dz,
            float32 tmin, float32 tmax,
            float32 minx, float32 miny, float32 minz,
            float32 maxx, float32 maxy, float32 maxz) {
        float32 miss = tmax + 1.0f;
        float32 tnear = tmin;
        float32 tfar = tmax;
        if (dx < 0.0001f && dx > 0.0f - 0.0001f) {
            if (ox < minx) { return miss; }
            if (ox > maxx) { return miss; }
        } else {
            float32 inv = 1.0f / dx;
            float32 t0 = (minx - ox) * inv;
            float32 t1 = (maxx - ox) * inv;
            if (t0 > t1) { float32 tmp = t0; t0 = t1; t1 = tmp; }
            if (t0 > tnear) { tnear = t0; }
            if (t1 < tfar) { tfar = t1; }
        }
        if (dy < 0.0001f && dy > 0.0f - 0.0001f) {
            if (oy < miny) { return miss; }
            if (oy > maxy) { return miss; }
        } else {
            float32 inv = 1.0f / dy;
            float32 t0 = (miny - oy) * inv;
            float32 t1 = (maxy - oy) * inv;
            if (t0 > t1) { float32 tmp = t0; t0 = t1; t1 = tmp; }
            if (t0 > tnear) { tnear = t0; }
            if (t1 < tfar) { tfar = t1; }
        }
        if (dz < 0.0001f && dz > 0.0f - 0.0001f) {
            if (oz < minz) { return miss; }
            if (oz > maxz) { return miss; }
        } else {
            float32 inv = 1.0f / dz;
            float32 t0 = (minz - oz) * inv;
            float32 t1 = (maxz - oz) * inv;
            if (t0 > t1) { float32 tmp = t0; t0 = t1; t1 = tmp; }
            if (t0 > tnear) { tnear = t0; }
            if (t1 < tfar) { tfar = t1; }
        }
        if (tnear <= tfar) { return tnear; }
        return miss;
    }

    /**
     * Closest-hit query: the original index of the nearest primitive whose AABB
     * the ray [tMin, tMax] enters, or -1 on a miss. Stackless threaded walk over
     * the frozen block — an interior hit descends to i+1, a miss (or a processed
     * leaf) jumps to the node's escape index — exactly the order
     * {@link SoftwareRayQuery#step} follows on device, here driven to completion as
     * the host nearest-hit convenience.
     */
    public int32 closestHit(float32 ox, float32 oy, float32 oz,
                            float32 dx, float32 dy, float32 dz,
                            float32 tmin, float32 tmax) {
        int32 nodeCnt = Lbvh.floorToInt(this.block[1]);
        int32 nodesOff = Lbvh.floorToInt(this.block[4]);
        int32 primRefOff = Lbvh.floorToInt(this.block[5]);
        float32 bestT = tmax;
        int32 bestPrim = 0 - 1;
        int32 i = 0;
        while (i < nodeCnt) {
            int32 base = nodesOff + i * 9;
            float32 nx = this.block[base + 0];
            float32 ny = this.block[base + 1];
            float32 nz = this.block[base + 2];
            float32 xx = this.block[base + 3];
            float32 xy = this.block[base + 4];
            float32 xz = this.block[base + 5];
            float32 e = Bvh.boxEntry(ox, oy, oz, dx, dy, dz, tmin, bestT,
                                     nx, ny, nz, xx, xy, xz);
            int32 escape = Lbvh.floorToInt(this.block[base + 6]);
            int32 primCount = Lbvh.floorToInt(this.block[base + 8]);
            boolean hit = e <= bestT;
            if (hit) {
                if (primCount > 0) {
                    int32 firstPrim = Lbvh.floorToInt(this.block[base + 7]);
                    int32 prim = Lbvh.floorToInt(this.block[primRefOff + firstPrim]);
                    if (e < bestT) { bestT = e; bestPrim = prim; }
                    i = escape;
                } else {
                    i = i + 1;
                }
            } else {
                i = escape;
            }
        }
        return bestPrim;
    }
}
