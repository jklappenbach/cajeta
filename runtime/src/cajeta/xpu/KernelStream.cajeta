package cajeta.xpu;

/**
 * KernelStream — ordered queue of XPU work.
 *
 * A backend-tagged handle to an in-order command stream. Kernel
 * launches submitted to the same KernelStream complete in submission
 * order; launches on different Streams run in parallel (subject to
 * cross-stream synchronization the user requests via Event/Fence).
 *
 * KernelStream is the borrow-scope anchor for launched buffers: a buffer
 * passed as a kernel argument is borrowed for the lifetime of the
 * launch, with the borrow released at the next `sync()` ordered
 * after the launch on this stream. See CajetaXPU.md §3.5.
 *
 * v1 storage is a single opaque handle; the backend resolves it
 * (CUstream / hipStream / VkQueue) via the runtime layer. Step 7
 * (CPU emulation) treats the handle as a host-side sequence number;
 * later steps map it to the real driver object.
 *
 * Per the spec, `KernelStream.default()` returns the per-thread default
 * stream — but `default` is a Cajeta keyword, so the spelling here
 * is `KernelStream.current()`. To be reconciled in CajetaXPU.md.
 */
public final class KernelStream {
    int64 handle;

    KernelStream(int64 handle) {
        this.handle = handle;
    }

    /**
     * The per-thread default stream (handle 0). Always names the same
     * stream for the same thread; safe to retain across launches.
     *
     * Returns a TITLE (`#KernelStream`) even though the stream it names is
     * shared, and the two facts do not conflict: what is shared is the
     * backend `handle`, and what the caller receives is a fresh wrapper
     * object minted per call. Receive it with `#=` and drop it whenever you
     * like — the wrapper's teardown frees its 8 bytes and nothing else,
     * because tearing down the STREAM is `destroy()`, which is explicit and a
     * no-op on handle 0. A borrow-shaped return would have to hand out an
     * object with no owner anywhere to name.
     *
     * @EntryPoint
     */
    public static #KernelStream current() {
        KernelStream s = heap KernelStream(nativeCurrent());
        return #s;                                 // move out; source dtor no-ops
    }

    /**
     * Create a fresh stream — a real backend stream object (CUstream /
     * hipStream) on CUDA/HIP, the default stream elsewhere. Async copies and
     * launches submitted to it queue independently of other streams; the caller
     * owns it and must `destroy()` it when done.
     *
     * @EntryPoint
     */
    public static #KernelStream create() {
        KernelStream s = heap KernelStream(nativeCreate());
        return #s;                                 // move out; source dtor no-ops
    }

    /**
     * Block until every operation submitted to this stream — async copies AND
     * kernel launches — has completed. Releases all deferred-borrow tokens held
     * by launches ordered before this point. The default stream (handle 0)
     * drains the whole context.
     */
    public void sync() {
        this.nativeSync(this.handle);
    }

    /**
     * Insert a wait on `e` into this stream. Future launches on
     * this stream will not start until `e` has been recorded on its
     * source stream and signaled.
     */
    public void waitFor(Event e) {
        int64 eh = e.handle;
        this.nativeWaitFor(this.handle, eh);
    }

    /**
     * Destroy this stream's backend object. No-op for the default stream
     * (handle 0). Idempotent via the runtime's null guard.
     */
    public void destroy() {
        this.nativeDestroy(this.handle);
    }

    /** {@link #deferStat} keys. */
    public static final int32 DEFER_QUEUED = 0;
    public static final int32 DEFER_REPLAYED = 1;
    public static final int32 DEFER_DIRECT = 2;
    public static final int32 DEFER_GRAPHS_BUILT = 3;
    public static final int32 DEFER_GRAPH_LAUNCHES = 4;
    public static final int32 DEFER_PATCHES = 5;
    public static final int32 DEFER_FLUSHES = 6;

    /**
     * Queue this stream's launches instead of submitting each one, and submit
     * the queue together at the next point where its results can be observed:
     * a `sync()`, a host transfer, an event, a buffer release, `flush()`, or
     * turning deferral off. The results a program can observe do not change.
     * What changes is the cost of submitting: a launch is a driver call, some
     * microseconds whatever the kernel does, and a program that launches the
     * same sequence of kernels again and again (one decode token, one solver
     * step) pays it per launch per repetition. A queue whose kernel sequence
     * this stream has submitted before is replayed as ONE recorded submission
     * with only the changed grids and arguments patched in.
     *
     * The recording is a CUDA graph on nvptx. A backend without such a thing
     * submits the queue launch by launch, and a synchronous backend (cpu)
     * queues nothing: there the switch is accepted and has no effect. A launch
     * that cannot be queued (a texture, an image, a buffer array, a launch-time
     * specialization) submits the queue ahead of itself and goes directly, so
     * order on the stream is always the order of the launch calls.
     *
     * One consequence to know: a queued launch has not started. Host work that
     * used to overlap the device now precedes it, so defer where the launches
     * are many and small, which is where the submit cost dominates.
     */
    public void setDeferred(boolean on) {
        KernelStream.nativeSetDeferred(this.handle, on ? 1 : 0);
    }

    /** Submit every launch this stream has queued. Does not wait for them. */
    public void flush() {
        KernelStream.nativeFlush(this.handle);
    }

    /** Launches queued on this stream and not yet submitted. */
    public int64 pendingLaunches() {
        return KernelStream.nativePending(this.handle);
    }

    /**
     * Process-wide deferral counters, by `DEFER_*` key: launches queued,
     * launches submitted through a replayed recording, launches submitted one
     * by one, recordings built, recordings launched, launches whose grid or
     * arguments were patched into a recording, and queue submissions.
     * Every queued launch is eventually either replayed or direct.
     */
    public static int64 deferStat(int32 which) {
        return KernelStream.nativeDeferStat(which);
    }

    @Native("__cajeta_xpu_stream_set_deferred")
    private static void nativeSetDeferred(int64 handle, int32 on);

    @Native("__cajeta_xpu_stream_flush")
    private static void nativeFlush(int64 handle);

    @Native("__cajeta_xpu_stream_pending")
    private static int64 nativePending(int64 handle);

    @Native("__cajeta_xpu_defer_stat")
    private static int64 nativeDeferStat(int32 which);

    // Native stream primitives. The handle (int64) IS the backend stream object
    // (0 = the default stream); current()/create() return it wrapped in a KernelStream
    // and the instance ops pass `this.handle` so the C side speaks only handles.
    @Native("__cajeta_xpu_stream_current")
    private static int64 nativeCurrent();

    @Native("__cajeta_xpu_stream_create")
    private static int64 nativeCreate();

    @Native("__cajeta_xpu_stream_sync")
    private void nativeSync(int64 handle);

    @Native("__cajeta_xpu_stream_destroy")
    private void nativeDestroy(int64 handle);

    @Native("__cajeta_xpu_stream_wait_for")
    private void nativeWaitFor(int64 streamHandle, int64 eventHandle);
}
