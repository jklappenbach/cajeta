package cajeta.xpu;

/**
 * Rng — a deterministic stream pseudo-random generator (xorshift64) plus
 * weighted reservoir sampling (cajeta-gfx §3, the acceleration/sampling/
 * residency foundation; spec §8.7). The stateful counterpart to
 * {@link LowDiscrepancy}: low-discrepancy sequences fill the domain evenly for
 * a KNOWN sample budget; a stream RNG produces an unbounded, per-seed-
 * reproducible sequence for online estimators (path tracing, RIS/ReSTIR,
 * stochastic LOD).
 *
 * The generator is xorshift64 (Marsaglia 2003) with the (13, 7, 17) shift
 * triple: full period 2^64-1 over any nonzero state. It is MULTIPLY-FREE on
 * purpose — only int64 xor and CONSTANT-amount shifts, the integer ops the
 * current JIT lowers correctly. (splitmix64/PCG would be higher quality but
 * need an int64 multiply by a sign-bit-set constant, which the codegen
 * mis-lowers to an illegal instruction; a variable-amount or int32 `>>>` is
 * also mis-lowered. xorshift64 sidesteps all three. Upgrade to splitmix64 once
 * those codegen bugs are fixed in the fork.) It is threaded FUNCTIONALLY (no
 * instance state, matching the pure-static stdlib style and making it
 * GPU-portable): `seedState(seed)` makes the initial state, `next(state)`
 * advances it (and, for xorshift, the advanced state IS the next output),
 * `output(state)` returns those bits, and `toUnitFloat(bits)` maps them to a
 * float in [0, 1). The same seed always replays the same stream (CPU == GPU);
 * the seed mixing decorrelates even adjacent seeds.
 *
 * {@link #weightedReservoirChoice} is reservoir sampling with a reservoir of
 * size 1 — equivalently Resampled Importance Sampling (RIS), the core of
 * ReSTIR: in a single streaming pass it selects one candidate index with
 * probability proportional to its weight, holding only a running weight sum and
 * the current pick. The reservoir value type + full RIS/MIS estimators are the
 * follow-on; this is the convergent primitive they build on.
 */
public class Rng {

    /**
     * Advance the 64-bit state one xorshift step. For xorshift64 the advanced
     * state is itself a well-mixed 64-bit output, so this doubles as the
     * generator: feed its result back in for the next draw.
     */
    public static int64 next(int64 state) {
        int64 x = state;
        x = x ^ (x << 13);
        x = x ^ (x >>> 7);
        x = x ^ (x << 17);
        return x;
    }

    /**
     * Seed a stream. xorshift64 requires a NONZERO state; adding a large odd
     * constant (proven-safe int64 add — multiply is avoided everywhere here)
     * and running one step mixes even small or zero seeds into a good start.
     */
    public static int64 seedState(int64 seed) {
        int64 s = seed + 0x9E3779B97F4A7C15L;   // add-by-constant is safe codegen
        return Rng.next(s);
    }

    /** The 64 random bits of a state (for xorshift64 the state already is them). */
    public static int64 output(int64 state) {
        return state;
    }

    /**
     * Map 64 random bits to a uniform float in [0, 1) using the top 24 bits
     * (>>> 40 is a constant unsigned shift; 24 bits is the float32 mantissa
     * width, so every representable value is hit exactly, and the high bits are
     * the best-mixed for xorshift64).
     */
    public static float32 toUnitFloat(int64 bits) {
        int64 hi = (bits >>> 40) & 0xFFFFFFL;   // top 24 bits, 0 .. 2^24-1
        int32 hiI = (int32) hi;
        float32 f = hiI;                         // int32 -> float32 (exact)
        return f / 16777216.0f;                  // / 2^24
    }

    /**
     * Weighted reservoir sampling with a reservoir of size 1 (a.k.a. RIS):
     * choose one index in [0, count) with probability proportional to
     * weights[i], in a single streaming pass. `seed` drives the internal
     * xorshift64 stream. The classic update keeps a running weight sum `wsum`
     * and accepts candidate i with probability weights[i] / wsum (tested as
     * u * wsum < weights[i] to avoid a divide). Returns -1 only when count <= 0
     * or every weight is 0 (nothing was ever accepted).
     */
    public static int32 weightedReservoirChoice(float32[] weights, int32 count, int64 seed) {
        int64 s = Rng.seedState(seed);
        float32 wsum = 0.0f;
        int32 chosen = -1;
        int32 i = 0;
        while (i < count) {
            float32 w = weights[i];
            wsum = wsum + w;
            s = Rng.next(s);
            float32 u = Rng.toUnitFloat(s);
            if (u * wsum < w) {
                chosen = i;
            }
            i = i + 1;
        }
        return chosen;
    }
}
