package cajeta.xpu;

import cajeta.collection.ArrayList;

/**
 * KernelSubmission — one kernel invocation described for the scheduler
 * (xpu-tile-scheduling §2): the launch geometry, the {@link SchedulePolicy}
 * and its deadline window, protection, a compute-unit budget, a capture
 * identity, an energy budget, the {@link ArithmeticCharacter}, and the READ,
 * WRITE and ACCUMULATE buffer sets by {@link KernelBuffer#handle} identity,
 * derived from the kernel's manifest. Pass it in the stream's place at a
 * launch; the plain stream form is the same submission at the kernel's
 * defaults:
 *
 *     KernelSubmission sub = heap KernelSubmission(gridBlocks, blockThreads);
 *     sub.policy = SchedulePolicy.Latency;
 *     sub.latestNs = Clock.nanoTime() + 2000000L;
 *     sub.stream = s;
 *     k.launch(sub, grid: [sub.gridX], block: [sub.blockX])(a, b, c);
 *
 * {@link Scheduler#submit} is the explicit form: name the kernel, bind its
 * buffers in parameter order, and read the descriptor it returns.
 */
public final class KernelSubmission {
    // Launch geometry (all three dims; y/z default to 1 for the 1-D common case).
    public int32 gridX;
    public int32 gridY;
    public int32 gridZ;
    public int32 blockX;
    public int32 blockY;
    public int32 blockZ;
    // Dynamic LDS bytes per block, the launch's `sharedBytes:` (0 if none).
    public int32 sharedBytes;
    // The scheduling objective (§6.3) and arithmetic character (§7.4). Defaulted;
    // the author may overwrite either before submit.
    public SchedulePolicy policy;
    public ArithmeticCharacter character;
    // The buffers this kernel READS and WRITES, by handle identity — the raw
    // material of the dependency DAG (§7.3). Owned lists, grown via reads/writes —
    // or DERIVED by Scheduler.submit from the kernel's manifest when `kernel` is
    // named and the buffers are bound in parameter order (xpu-tile-manifest
    // §6.6); a restated set that disagrees with the manifest is refused.
    public ArrayList<int64> readSet;
    public ArrayList<int64> writeSet;
    // Buffers the kernel accumulates into (atomics): never co-run with another
    // launch accumulating into the same buffer, order-dependent in float (§6.4).
    public ArrayList<int64> accumulateSet;
    // The @Kernel's simple name, when the sets should come from its manifest.
    public String kernel;
    // Buffer handles in the kernel's buffer-PARAMETER order (see bind).
    public ArrayList<int64> bound;
    // The deadline window in the host clock (Clock.nanoTime), 0 = none
    // (scheduling spec §2.3); a window that has closed at submit time is a
    // rejection (§2.9).
    public int64 earliestNs;
    public int64 latestNs;
    // Protected: no scheduling action may defer or throttle it (§2.4).
    public boolean protectedLaunch;
    // Compute-unit budget as a count, 0 = none (§2.5).
    public int32 cuBudget;
    // Capture identity for replay, 0 = none (§2.6).
    public int64 captureId;
    // Energy budget in joules per period, 0 = none (§2.3, §8.7).
    public float64 energyJoules;
    // Resident pool and per-item reservation, 0 = none (§2.7).
    public int64 poolHandle;
    public int64 poolReserve;
    // The target stream when the submission stands in the stream's place at a
    // launch; null = the default stream.
    public KernelStream stream;

    /** A 1-D submission: `gridBlocks` blocks of `blockThreads` threads. */
    public KernelSubmission(int32 gridBlocks, int32 blockThreads) {
        this.gridX = gridBlocks;
        this.gridY = 1;
        this.gridZ = 1;
        this.blockX = blockThreads;
        this.blockY = 1;
        this.blockZ = 1;
        this.sharedBytes = 0;
        this.policy = SchedulePolicy.Throughput;          // §6.3 default
        this.character = ArithmeticCharacter.MemoryBound;
        this.earliestNs = 0L;
        this.latestNs = 0L;
        this.protectedLaunch = false;
        this.cuBudget = 0;
        this.captureId = 0L;
        this.energyJoules = 0.0;
        this.poolHandle = 0L;
        this.poolReserve = 0L;
        this.stream = null;
        this.readSet #= heap ArrayList<int64>();
        this.writeSet #= heap ArrayList<int64>();
        this.accumulateSet #= heap ArrayList<int64>();
        this.bound #= heap ArrayList<int64>();
    }

    /**
     * Bind the next buffer-like PARAMETER of {@link #kernel} to `handle`, in
     * the kernel's declaration order (scalars are skipped). With the kernel
     * named, {@link Scheduler#submit} reads the manifest's mode for each bound
     * parameter and fills the read / write / accumulate sets — the author does
     * not restate what the body does (xpu-tile-manifest §6.6).
     */
    public void bind(int64 handle) {
        this.bound.add(handle);
    }

    /** Record a buffer this kernel reads (pass {@link KernelBuffer#handle}). */
    public void reads(int64 handle) {
        this.readSet.add(handle);
    }

    /** Record a buffer this kernel writes (pass {@link KernelBuffer#handle}). */
    public void writes(int64 handle) {
        this.writeSet.add(handle);
    }
}
