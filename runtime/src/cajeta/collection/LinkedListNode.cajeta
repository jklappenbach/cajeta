package cajeta.collection;

/**
 * Node in a doubly-linked list (`LinkedList``<T>`). Holds the value
 * plus prev/next pointers. v1 keeps this as a separate top-level
 * class (Cajeta doesn't have nested classes yet); future versions
 * may make it package-private or merge it into LinkedList's
 * file once nesting lands.
 *
 * The list owns the nodes — `LinkedList.add` heap-allocates a node
 * and links it in; `remove` unlinks and lets the dropped node fall
 * off the drop chain. The ctor takes a plain `T` and stores it with
 * `#=`, so the node owns its value only when the caller transferred it;
 * dropping a node drops the value only in that case.
 *
 * ## v1 surface
 *
 * Fields are public to keep the LinkedList code straightforward —
 * no node-side getters/setters yet (Cajeta's access modifiers are
 * loose enough today that this matches how the rest of the stdlib
 * exposes internal state). Future visibility refinement is a
 * stdlib-wide pass.
 */
public final class LinkedListNode<T> {
    public T value;
    // The value field's ownership BIT is the single truth, set by the
    // ctor's `#=` store from whatever mode the caller tendered; a pop's
    // single move (`T t #= node.value`) carries that bit back out.
    public LinkedListNode<T> prev;
    public LinkedListNode<T> next;

    /**
     * Creates a detached node wrapping `value`, with `prev` and `next`
     * set to `null`. Linking is the `LinkedList`'s job — callers rarely
     * construct nodes directly.
     *
     * ```cajeta
     * heap node = heap LinkedListNode<Int>(42);
     * // node.prev == null && node.next == null
     * ```
     */
    public LinkedListNode(T value) {
        // The formal is plain `T` and `#=` stores whichever mode the caller
        // tendered — a `#`-transferred value is owned by the node (and drops
        // with it), a lent one is not.
        this.value #= value;
        this.prev = null;
        this.next = null;
    }
}
