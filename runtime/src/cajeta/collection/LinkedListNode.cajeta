package cajeta.collection;

/**
 * Node in a doubly-linked list (`LinkedList``<T>`). Holds the value
 * plus prev/next pointers. v1 keeps this as a separate top-level
 * class (Cajeta doesn't have nested classes yet); future versions
 * may make it package-private or merge it into LinkedList's
 * file once nesting lands.
 *
 * The list owns the nodes — `LinkedList.add` heap-allocates a node
 * and links it in; `remove` unlinks and lets the dropped node fall
 * off the drop chain. The VALUE is owned by the node iff the list's
 * caller `#`-transferred it (the node's field bit + `owned` mirror);
 * dropping a node then drops an owned value with it.
 *
 * ## v1 surface
 *
 * Fields are public to keep the LinkedList code straightforward —
 * no node-side getters/setters yet (Cajeta's access modifiers are
 * loose enough today that this matches how the rest of the stdlib
 * exposes internal state). Future visibility refinement is a
 * stdlib-wide pass.
 */
public final class LinkedListNode<T> {
    public T value;
    // Mirror of the value field's ownership bit (title-tracking §6): 1 when
    // the list's caller `#`-transferred the value, 0 for a borrow. The field
    // BIT (set by the `#value` ctor store) is the drop authority; this byte
    // exists so LinkedList's flagged pops can READ the mode and guard the
    // `#node.value` extraction (extraction from a borrowed field panics).
    public int8 owned;
    public LinkedListNode<T> prev;
    public LinkedListNode<T> next;

    /**
     * Creates a detached node wrapping `value`, with `prev` and `next`
     * set to `null`. Linking is the `LinkedList`'s job — callers rarely
     * construct nodes directly.
     *
     * ```cajeta
     * heap node = heap LinkedListNode<Int>(42);
     * // node.prev == null && node.next == null
     * ```
     */
    public LinkedListNode(T value) {
        // Word read FIRST, before any store (title-tracking 6.2.3): bit0 =
        // what the list's caller actually did, forwarded by the list's
        // `#value` ctor arg.
        this.owned = (int8) (Cajeta.moveMask() & 1);
        // Consuming spelling — records the forwarded flag on the node's
        // field bit and deactivates the formal's entry so an owned value
        // isn't freed at ctor exit while the node still points at it (the
        // CacheNode treatment). A borrowed value stores plain-equivalent:
        // the bit records 0 and the node's drop walk skips it.
        this.value = #value;
        this.prev = null;
        this.next = null;
    }
}
