package cajeta.collection;

/**
 * The general-purpose host sorting facility — the missing stdlib sort
 * (`documents/cajeta-sorting/sorting-spec.md` §4a) and the shared comparison/
 * search **seam** (§4c) that the `Tensor` numeric sort (§4b) reuses rather than
 * forking.
 *
 * ## The comparator seam
 * A comparator is a **function value** `(T, T) -> int32` returning negative if
 * the first argument orders before the second, zero if equal, positive if after
 * — the same total/transitive/sign-symmetric contract as
 * {@link cajeta.lang.Comparable}. Function values are first-class in cajeta
 * (`Stream.filter`, `Collector`), so the seam is a function type rather than an
 * interface (templated-interface vtable dispatch is still maturing — see
 * `Comparable`'s toolchain note). Every algorithm here is implemented **once**
 * against a comparator; the natural-order entry points are thin wrappers that
 * pass a `<`/`>`-based comparator, so primitive `T` works today and class `T`
 * works once operator overloading flows through template specialization (the
 * same v1 limitation `Heap` / `RedBlackTree` note).
 *
 * ## `kind` (numpy parity)
 * - `sort` — **unstable**, fast: an in-place quicksort (middle-element pivot,
 *   insertion-sort cutoff for small runs, an explicit O(log n)-bounded range
 *   stack — no recursion). numpy `kind='quicksort'` (the default).
 * - `sortStable` — **stable**: a bottom-up (iterative) merge sort, O(n) aux.
 *   numpy `kind='stable'`/`'mergesort'`. Preserves input order of equal keys.
 *
 * ## Search
 * `lowerBound` / `upperBound` / `binarySearch` over a sorted `T[]`, parameterized
 * by the same comparator seam. This is also the engine for the Tensor
 * `searchsorted` (`side='left'`→`lowerBound`, `'right'`→`upperBound`) and for
 * histogram-edge lookup — one implementation, no duplication (§4c).
 *
 * ```cajeta
 * int32[] a = { 5, 3, 8, 1, 9, 2, 7 };
 * Sort.sort<int32>(a, 7);                 // [1,2,3,5,7,8,9] ascending
 * int32 at = Sort.binarySearch<int32>(a, 7, 8);   // 5
 * // descending via a comparator:
 * Sort.sort<int32>(a, 7, (x, y) -> { if (x > y) { return -1; } if (x < y) { return 1; } return 0; });
 * ```
 *
 * @See cajeta.lang.Comparable
 * @See cajeta.collection.Heap
 */
public class Sort {

    // ─────────────────────────────────────────────────────────────────────
    // Comparator-based core (the seam every other entry point routes through)
    // ─────────────────────────────────────────────────────────────────────

    /**
     * Unstable in-place sort of `a[0..n)` by `cmp` (numpy `kind='quicksort'`).
     * Median-of-3 pivot + a Hoare two-pointer partition (its stop-on-equal keeps
     * many-duplicate input balanced O(n log n) instead of Lomuto's O(n^2), and it
     * leaves already-/reverse-sorted input nearly untouched), an insertion-sort
     * cutoff for runs under 16, and a manual range stack that recurses the smaller
     * band and loops the larger — O(log n) depth, no recursion, no stack-overflow
     * on adversarial input.
     */
    public static void sort<T>(T[] a, int32 n, (T, T) -> int32 cmp) {
        if (n < 2) {
            return;
        }
        int32[] ranges = heap int32[128];
        int32 sp = 0;
        int32 lo = 0;
        int32 hi = n - 1;
        boolean run = true;
        while (run) {
            if (hi - lo < 16) {
                // Insertion-sort a[lo..hi] inline (the small-run engine). Kept
                // inline rather than a helper so the comparator function value
                // isn't threaded through a second templated-static call.
                int32 ii = lo + 1;
                while (ii <= hi) {
                    T key = a[ii];
                    int32 jj = ii;
                    boolean moving = true;
                    while (moving) {
                        if (jj > lo) {
                            T prev = a[jj - 1];
                            if (cmp(key, prev) < 0) {
                                a[jj] = prev;
                                jj = jj - 1;
                            } else {
                                moving = false;
                            }
                        } else {
                            moving = false;
                        }
                    }
                    a[jj] = key;
                    ii = ii + 1;
                }
                if (sp == 0) {
                    run = false;
                } else {
                    sp = sp - 1;
                    hi = ranges[sp];
                    sp = sp - 1;
                    lo = ranges[sp];
                }
            } else {
                // Median-of-3 pivot moved to a[lo], then a Hoare two-pointer
                // partition. Hoare's "stop on equal" splits keys equal to the
                // pivot EVENLY across both sides, so all-equal / many-duplicate
                // input stays balanced O(n log n) (Lomuto piled equals on one
                // side -> O(n^2)). It also touches already-/reverse-sorted input
                // with few swaps and no run reversal (a single-pointer 3-way flag
                // reverses the > band each level, wrecking sorted input).
                int32 mid = lo + (hi - lo) / 2;
                T x = a[lo];
                T y = a[mid];
                T z = a[hi];
                int32 mp;
                if (cmp(x, y) < 0) {
                    if (cmp(y, z) < 0) { mp = mid; }       // x < y < z
                    else if (cmp(x, z) < 0) { mp = hi; }   // x < z <= y
                    else { mp = lo; }                       // z <= x < y
                } else {
                    if (cmp(x, z) < 0) { mp = lo; }        // y <= x < z
                    else if (cmp(y, z) < 0) { mp = hi; }   // y < z <= x
                    else { mp = mid; }                      // z <= y <= x
                }
                T tlo = a[lo];
                a[lo] = a[mp];
                a[mp] = tlo;
                T pivot = a[lo];
                // Hoare partition around `pivot` (present at a[lo], so the
                // scans are bounded). Result: a[lo..j] <= pivot, a[j+1..hi] >= pivot.
                int32 i = lo - 1;
                int32 j = hi + 1;
                boolean part = true;
                while (part) {
                    boolean adv = true;
                    while (adv) {
                        i = i + 1;
                        if (cmp(a[i], pivot) >= 0) { adv = false; }
                    }
                    adv = true;
                    while (adv) {
                        j = j - 1;
                        if (cmp(a[j], pivot) <= 0) { adv = false; }
                    }
                    if (i >= j) {
                        part = false;
                    } else {
                        T ai = a[i];
                        T aj = a[j];
                        a[i] = aj;
                        a[j] = ai;
                    }
                }
                // Recurse both bands; loop the smaller and push the larger so the
                // explicit range stack stays O(log n) deep.
                int32 leftSize = j - lo;
                int32 rightSize = hi - j - 1;
                if (leftSize > rightSize) {
                    ranges[sp] = lo;
                    sp = sp + 1;
                    ranges[sp] = j;
                    sp = sp + 1;
                    lo = j + 1;
                } else {
                    ranges[sp] = j + 1;
                    sp = sp + 1;
                    ranges[sp] = hi;
                    sp = sp + 1;
                    hi = j;
                }
            }
        }
    }

    /**
     * Stable sort of `a[0..n)` by `cmp` (numpy `kind='stable'`/`'mergesort'`).
     * Bottom-up merge sort: O(n log n), O(n) auxiliary, equal keys keep their
     * input order (the merge takes the left run on ties).
     */
    public static void sortStable<T>(T[] a, int32 n, (T, T) -> int32 cmp) {
        if (n < 2) {
            return;
        }
        T[] buf = heap T[n];
        int32 width = 1;
        while (width < n) {
            int32 i = 0;
            while (i < n) {
                int32 left = i;
                int32 mid = i + width;
                if (mid > n) {
                    mid = n;
                }
                int32 right = i + width + width;
                if (right > n) {
                    right = n;
                }
                int32 li = left;
                int32 ri = mid;
                int32 k = left;
                while (li < mid && ri < right) {
                    T lv = a[li];
                    T rv = a[ri];
                    // Stable: take the right run only when it strictly orders
                    // before the left; ties keep the left element first.
                    if (cmp(rv, lv) < 0) {
                        buf[k] = rv;
                        ri = ri + 1;
                    } else {
                        buf[k] = lv;
                        li = li + 1;
                    }
                    k = k + 1;
                }
                while (li < mid) {
                    T lv = a[li];
                    buf[k] = lv;
                    li = li + 1;
                    k = k + 1;
                }
                while (ri < right) {
                    T rv = a[ri];
                    buf[k] = rv;
                    ri = ri + 1;
                    k = k + 1;
                }
                i = i + width + width;
            }
            int32 c = 0;
            while (c < n) {
                T v = buf[c];
                a[c] = v;
                c = c + 1;
            }
            width = width + width;
        }
    }

    /** First index in sorted `a[0..n)` whose element does not order before `key`
     *  (numpy `searchsorted` `side='left'`). In `[0, n]`. */
    public static int32 lowerBound<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 lo = 0;
        int32 hi = n;
        while (lo < hi) {
            int32 mid = lo + (hi - lo) / 2;
            T m = a[mid];
            if (cmp(m, key) < 0) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    /** First index in sorted `a[0..n)` whose element orders after `key`
     *  (numpy `searchsorted` `side='right'`). In `[0, n]`. */
    public static int32 upperBound<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 lo = 0;
        int32 hi = n;
        while (lo < hi) {
            int32 mid = lo + (hi - lo) / 2;
            T m = a[mid];
            if (cmp(key, m) < 0) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        return lo;
    }

    /** Index of `key` in sorted `a[0..n)`, or `-1` if absent (first match on
     *  duplicates). */
    public static int32 binarySearch<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 idx = lowerBound<T>(a, n, key, cmp);
        if (idx < n) {
            T m = a[idx];
            if (cmp(m, key) == 0) {
                return idx;
            }
        }
        return -1;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Natural-order entry points (by `<` / `>` on T) — thin seam wrappers
    // ─────────────────────────────────────────────────────────────────────

    // ─────────────────────────────────────────────────────────────────────
    // Natural-order pattern-defeating quicksort (pdqsort) — the hot path the
    // benchmarks and the numeric Tensor sort hit. This is a port of Orson
    // Peters' pdqsort: median-of-3 / pseudomedian-of-9 (ninther) pivots, a
    // BlockQuicksort-style *branchless* partition (no data-dependent branch in
    // the partition inner loop — the dominant win on random input), a
    // pattern-breaking shuffle on unbalanced splits, an introsort heapsort
    // fallback for O(n log n) worst case, and partial-insertion-sort on
    // already-partitioned runs (O(n) on sorted/structured input). Comparisons
    // are inlined `<` so a monomorphized `sort<int64>` lowers each to a native
    // `icmp`/`fcmp` (no comparator closure on this path).
    //
    // The helpers below are `public static` only because the toolchain has no
    // proven internal-visibility for templated statics yet; they are not part
    // of the intended Sort API. TODO: tighten to internal once available.
    // ─────────────────────────────────────────────────────────────────────

    public static void pdqSwap<T>(T[] a, int32 i, int32 j) {
        T t = a[i];
        a[i] = a[j];
        a[j] = t;
    }

    // Index (relative to begin) of the median of a[begin+i], a[begin+j],
    // a[begin+k]. Branchless-friendly (ipnsort/glidesort median3).
    public static int32 pdqMedian3<T>(T[] a, int32 begin, int32 i, int32 j, int32 k) {
        boolean x = a[begin + i] < a[begin + j];
        boolean y = a[begin + i] < a[begin + k];
        if (x == y) {
            // b, c both <= a (x=y=0) -> want max(b,c); a < b, c (x=y=1) -> want
            // min(b,c). XOR with x flips the b<c outcome to pick the right one.
            boolean z = a[begin + j] < a[begin + k];
            if (z != x) {
                return k;
            }
            return j;
        }
        return i;
    }

    // ipnsort/glidesort pivot: median of 3 well-spread samples (0, 4n/8, 7n/8),
    // upgraded to a median-of-9 pseudomedian for len >= 64 (one unrolled level;
    // the reference recurses deeper for ~median-of-sqrt(n), but self-recursion
    // can't be instantiated by the JIT and median-of-9 is an ample pivot for the
    // benchmarked range). Returns the pivot index relative to begin. len >= 8.
    public static int32 pdqChoosePivot<T>(T[] a, int32 begin, int32 end) {
        int32 len = end - begin;
        int32 d8 = len / 8;
        int32 ia = 0;
        int32 ib = 4 * d8;
        int32 ic = 7 * d8;
        if (len < 64) {
            return pdqMedian3<T>(a, begin, ia, ib, ic);
        }
        int32 d64 = d8 / 8;
        ia = pdqMedian3<T>(a, begin, ia, ia + 4 * d64, ia + 7 * d64);
        ib = pdqMedian3<T>(a, begin, ib, ib + 4 * d64, ib + 7 * d64);
        ic = pdqMedian3<T>(a, begin, ic, ic + 4 * d64, ic + 7 * d64);
        return pdqMedian3<T>(a, begin, ia, ib, ic);
    }

    // Guarded insertion sort of a[begin..end) (end exclusive).
    public static void pdqInsertion<T>(T[] a, int32 begin, int32 end) {
        if (begin >= end) {
            return;
        }
        int32 cur = begin + 1;
        while (cur < end) {
            int32 sift = cur;
            if (a[sift] < a[sift - 1]) {
                T tmp = a[sift];
                boolean go = true;
                while (go) {
                    a[sift] = a[sift - 1];
                    sift = sift - 1;
                    if (sift == begin) {
                        go = false;
                    } else if (!(tmp < a[sift - 1])) {
                        go = false;
                    }
                }
                a[sift] = tmp;
            }
            cur = cur + 1;
        }
    }

    // ipnsort find_existing_run: length of the already-sorted run at a[0..). If
    // the WHOLE array is one monotone run, leaves it ascending (reversing in
    // place if it was strictly descending) so the caller can early-out — the
    // cheap already-sorted / reverse-sorted fast path.
    public static int32 pdqFindRun<T>(T[] a, int32 n) {
        if (n < 2) {
            return n;
        }
        int32 runLen = 2;
        boolean desc = a[1] < a[0];
        boolean go = true;
        if (desc) {
            while (go) {
                if (runLen < n && a[runLen] < a[runLen - 1]) {
                    runLen = runLen + 1;
                } else {
                    go = false;
                }
            }
        } else {
            while (go) {
                if (runLen < n && !(a[runLen] < a[runLen - 1])) {
                    runLen = runLen + 1;
                } else {
                    go = false;
                }
            }
        }
        if (runLen == n && desc) {
            int32 i = 0;
            int32 j = n - 1;
            while (i < j) {
                pdqSwap<T>(a, i, j);
                i = i + 1;
                j = j - 1;
            }
        }
        return runLen;
    }

    // Sift a[begin+root] down a binary max-heap of `count` elements rooted at
    // a[begin].
    public static void pdqSiftDown<T>(T[] a, int32 begin, int32 root, int32 count) {
        boolean go = true;
        while (go) {
            int32 child = 2 * root + 1;
            if (child >= count) {
                go = false;
            } else {
                if (child + 1 < count) {
                    if (a[begin + child] < a[begin + child + 1]) {
                        child = child + 1;
                    }
                }
                if (a[begin + root] < a[begin + child]) {
                    pdqSwap<T>(a, begin + root, begin + child);
                    root = child;
                } else {
                    go = false;
                }
            }
        }
    }

    // In-place heapsort of a[begin..end) — the introsort fallback that caps the
    // worst case at O(n log n).
    public static void pdqHeapSort<T>(T[] a, int32 begin, int32 end) {
        int32 count = end - begin;
        if (count < 2) {
            return;
        }
        int32 start = count / 2;
        while (start > 0) {
            start = start - 1;
            pdqSiftDown<T>(a, begin, start, count);
        }
        int32 e = count;
        while (e > 1) {
            e = e - 1;
            pdqSwap<T>(a, begin, begin + e);
            pdqSiftDown<T>(a, begin, 0, e);
        }
    }

    // ipnsort's branchless Lomuto partition with a cyclic permutation
    // (Bergdoll & Peters' "lomcyc"). Partitions a[s..e) by `a[x] < pivot`,
    // returning the count of elements < pivot. A single forward scan: each step
    // is ~1 move (the gap chases the writes) and the only data-dependent op is
    // the branchless `numLt += (a[right] < pivot)` — no block buffers, no swaps.
    // This is ipnsort's edge over pdqsort's BlockQuicksort on cheap-to-copy T.
    public static int32 pdqLomCycLt<T>(T[] a, int32 s, int32 e, T pivot) {
        int32 len = e - s;
        if (len == 0) {
            return 0;
        }
        T gapValue = a[s];
        int32 gapPos = s;
        int32 numLt = 0;
        int32 right = s + 1;
        while (right < e) {
            boolean lt = a[right] < pivot;
            int32 left = s + numLt;
            a[gapPos] = a[left];
            a[left] = a[right];
            gapPos = right;
            numLt = numLt + (lt ? 1 : 0);
            right = right + 1;
        }
        // Close the cycle: the held-out first element re-enters at the gap.
        boolean lt2 = gapValue < pivot;
        int32 left2 = s + numLt;
        a[gapPos] = a[left2];
        a[left2] = gapValue;
        numLt = numLt + (lt2 ? 1 : 0);
        return numLt;
    }

    // As pdqLomCycLt but partitions by `a[x] <= pivot` (elements equal to the
    // pivot go LEFT) — ipnsort's duplicate-key path when the pivot is the
    // smallest element (equals the ancestor pivot).
    public static int32 pdqLomCycLe<T>(T[] a, int32 s, int32 e, T pivot) {
        int32 len = e - s;
        if (len == 0) {
            return 0;
        }
        T gapValue = a[s];
        int32 gapPos = s;
        int32 numLt = 0;
        int32 right = s + 1;
        while (right < e) {
            boolean le = !(pivot < a[right]);
            int32 left = s + numLt;
            a[gapPos] = a[left];
            a[left] = a[right];
            gapPos = right;
            numLt = numLt + (le ? 1 : 0);
            right = right + 1;
        }
        boolean le2 = !(pivot < gapValue);
        int32 left2 = s + numLt;
        a[gapPos] = a[left2];
        a[left2] = gapValue;
        numLt = numLt + (le2 ? 1 : 0);
        return numLt;
    }

    // Partition a[begin..end) around the pivot at index `pivotIdx` by `<`.
    // Moves the pivot to begin, lomcyc-partitions a[begin+1..end), then places
    // the pivot at begin+numLt. Returns numLt: afterwards a[begin..begin+numLt)
    // < pivot, a[begin+numLt] == pivot, a[begin+numLt+1..end) >= pivot.
    public static int32 pdqPartitionLt<T>(T[] a, int32 begin, int32 end, int32 pivotIdx) {
        pdqSwap<T>(a, begin, pivotIdx);
        T pivot = a[begin];
        int32 numLt = pdqLomCycLt<T>(a, begin + 1, end, pivot);
        pdqSwap<T>(a, begin, begin + numLt);
        return numLt;
    }

    // As pdqPartitionLt but by `<=` (equal keys go left of the pivot).
    public static int32 pdqPartitionLe<T>(T[] a, int32 begin, int32 end, int32 pivotIdx) {
        pdqSwap<T>(a, begin, pivotIdx);
        T pivot = a[begin];
        int32 numLt = pdqLomCycLe<T>(a, begin + 1, end, pivot);
        pdqSwap<T>(a, begin, begin + numLt);
        return numLt;
    }

    // The ipnsort quicksort driver over a[begin0..end0). Non-recursive: an
    // explicit work stack holds deferred partitions, and at each split we
    // *continue* the larger side and *push* the smaller — bounding the stack to
    // O(log n) frames (and dodging the JIT's self-recursive-generic instantiation
    // hang). `limit` counts partitions down to the heapsort fallback (O(n log n)
    // worst case). Instead of pdqsort's `leftmost`, ipnsort threads an
    // `ancestor` (the predecessor pivot): when the chosen pivot is not greater
    // than its ancestor it is the smallest element, so we partition by `<=`
    // (equal keys left) and skip them — the duplicate-key fast path.
    public static void pdqRun<T>(T[] a, int32 begin0, int32 end0, int32 limit0,
            int32[] stB, int32[] stE, int32[] stLim, int32[] stHasAnc, T[] stAnc) {
        int32 sp = 0;
        int32 begin = begin0;
        int32 end = end0;
        int32 limit = limit0;
        boolean hasAnc = false;
        T anc = a[begin0];
        boolean run = true;
        while (run) {
            boolean popNext = false;
            int32 len = end - begin;
            if (len <= 24) {
                pdqInsertion<T>(a, begin, end);
                popNext = true;
            } else if (limit == 0) {
                pdqHeapSort<T>(a, begin, end);
                popNext = true;
            } else {
                limit = limit - 1;
                int32 pivotRel = pdqChoosePivot<T>(a, begin, end);
                int32 pivotIdx = begin + pivotRel;
                boolean didLe = false;
                if (hasAnc) {
                    // Pivot not greater than ancestor => smallest element here.
                    if (!(anc < a[pivotIdx])) {
                        int32 numLe = pdqPartitionLe<T>(a, begin, end, pivotIdx);
                        begin = begin + numLe + 1;
                        hasAnc = false;
                        didLe = true;
                    }
                }
                if (!didLe) {
                    int32 numLt = pdqPartitionLt<T>(a, begin, end, pivotIdx);
                    int32 pIdx = begin + numLt;
                    T pivotVal = a[pIdx];
                    int32 lb = begin;
                    int32 le = pIdx;
                    int32 rb = pIdx + 1;
                    int32 re = end;
                    // Continue the larger side, push the smaller. Left keeps the
                    // current ancestor; right's ancestor is the pivot just placed.
                    if ((le - lb) > (re - rb)) {
                        stB[sp] = rb;
                        stE[sp] = re;
                        stLim[sp] = limit;
                        stHasAnc[sp] = 1;
                        stAnc[sp] = pivotVal;
                        sp = sp + 1;
                        end = le;
                    } else {
                        stB[sp] = lb;
                        stE[sp] = le;
                        stLim[sp] = limit;
                        stHasAnc[sp] = hasAnc ? 1 : 0;
                        stAnc[sp] = anc;
                        sp = sp + 1;
                        begin = rb;
                        anc = pivotVal;
                        hasAnc = true;
                    }
                }
            }
            if (popNext) {
                if (sp == 0) {
                    run = false;
                } else {
                    sp = sp - 1;
                    begin = stB[sp];
                    end = stE[sp];
                    limit = stLim[sp];
                    hasAnc = stHasAnc[sp] == 1;
                    anc = stAnc[sp];
                }
            }
        }
    }

    // Natural-order unstable sort (numpy `kind='quicksort'`): ipnsort — a
    // pattern-defeating quicksort with a branchless lomcyc partition. See the
    // helper block above.
    public static void sort<T>(T[] a, int32 n) {
        if (n < 2) {
            return;
        }
        // Already-sorted (or reverse-sorted) fast path.
        int32 runLen = pdqFindRun<T>(a, n);
        if (runLen == n) {
            return;
        }
        // limit = 2 * floor(log2(n | 1)) imbalanced partitions before heapsort.
        int32 limit = 0;
        int32 m = n | 1;
        while (m > 1) {
            m = m >> 1;
            limit = limit + 1;
        }
        limit = limit * 2;
        int32[] stB = heap int32[64];
        int32[] stE = heap int32[64];
        int32[] stLim = heap int32[64];
        int32[] stHasAnc = heap int32[64];
        T[] stAnc = heap T[64];
        pdqRun<T>(a, 0, n, limit, stB, stE, stLim, stHasAnc, stAnc);
    }

    public static void sortStable<T>(T[] a, int32 n) {
        sortStable<T>(a, n, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 lowerBound<T>(T[] a, int32 n, T key) {
        return lowerBound<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 upperBound<T>(T[] a, int32 n, T key) {
        return upperBound<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 binarySearch<T>(T[] a, int32 n, T key) {
        return binarySearch<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    // ArrayList sorting is exposed as the instance methods `ArrayList.sort()` /
    // `ArrayList.sortStable()` (which sort the backing array in place via the
    // (T[], int32) entry points above) — not as static overloads here, since
    // same-named templated `sort` overloads across `(T[], int32)` and
    // `(ArrayList<T>, …)` don't resolve reliably.
}
