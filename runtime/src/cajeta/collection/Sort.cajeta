package cajeta.collection;

/**
 * The general-purpose host sorting facility — the missing stdlib sort
 * (`documents/cajeta-sorting/sorting-spec.md` §4a) and the shared comparison/
 * search **seam** (§4c) that the `Tensor` numeric sort (§4b) reuses rather than
 * forking.
 *
 * ## The comparator seam
 * A comparator is a **function value** `(T, T) -> int32` returning negative if
 * the first argument orders before the second, zero if equal, positive if after
 * — the same total/transitive/sign-symmetric contract as
 * {@link cajeta.lang.Comparable}. Function values are first-class in cajeta
 * (`Stream.filter`, `Collector`), so the seam is a function type rather than an
 * interface (templated-interface vtable dispatch is still maturing — see
 * `Comparable`'s toolchain note). Every algorithm here is implemented **once**
 * against a comparator; the natural-order entry points are thin wrappers that
 * pass a `<`/`>`-based comparator, so primitive `T` works today and class `T`
 * works once operator overloading flows through template specialization (the
 * same v1 limitation `Heap` / `RedBlackTree` note).
 *
 * ## `kind` (numpy parity)
 * - `sort` — **unstable**, fast: an in-place quicksort (middle-element pivot,
 *   insertion-sort cutoff for small runs, an explicit O(log n)-bounded range
 *   stack — no recursion). numpy `kind='quicksort'` (the default).
 * - `sortStable` — **stable**: a bottom-up (iterative) merge sort, O(n) aux.
 *   numpy `kind='stable'`/`'mergesort'`. Preserves input order of equal keys.
 *
 * ## Search
 * `lowerBound` / `upperBound` / `binarySearch` over a sorted `T[]`, parameterized
 * by the same comparator seam. This is also the engine for the Tensor
 * `searchsorted` (`side='left'`→`lowerBound`, `'right'`→`upperBound`) and for
 * histogram-edge lookup — one implementation, no duplication (§4c).
 *
 * ```cajeta
 * int32[] a = { 5, 3, 8, 1, 9, 2, 7 };
 * Sort.sort<int32>(a, 7);                 // [1,2,3,5,7,8,9] ascending
 * int32 at = Sort.binarySearch<int32>(a, 7, 8);   // 5
 * // descending via a comparator:
 * Sort.sort<int32>(a, 7, (x, y) -> { if (x > y) { return -1; } if (x < y) { return 1; } return 0; });
 * ```
 *
 * @See cajeta.lang.Comparable
 * @See cajeta.collection.Heap
 */
public class Sort {

    // ─────────────────────────────────────────────────────────────────────
    // Comparator-based core (the seam every other entry point routes through)
    // ─────────────────────────────────────────────────────────────────────

    /**
     * Unstable in-place sort of `a[0..n)` by `cmp` (numpy `kind='quicksort'`).
     * Median-of-3 pivot + a Hoare two-pointer partition (its stop-on-equal keeps
     * many-duplicate input balanced O(n log n) instead of Lomuto's O(n^2), and it
     * leaves already-/reverse-sorted input nearly untouched), an insertion-sort
     * cutoff for runs under 16, and a manual range stack that recurses the smaller
     * band and loops the larger — O(log n) depth, no recursion, no stack-overflow
     * on adversarial input.
     */
    public static void sort<T>(T[] a, int32 n, (T, T) -> int32 cmp) {
        if (n < 2) {
            return;
        }
        int32[] ranges = heap int32[128];
        int32 sp = 0;
        int32 lo = 0;
        int32 hi = n - 1;
        boolean run = true;
        while (run) {
            if (hi - lo < 16) {
                // Insertion-sort a[lo..hi] inline (the small-run engine). Kept
                // inline rather than a helper so the comparator function value
                // isn't threaded through a second templated-static call.
                int32 ii = lo + 1;
                while (ii <= hi) {
                    T key = a[ii];
                    int32 jj = ii;
                    boolean moving = true;
                    while (moving) {
                        if (jj > lo) {
                            T prev = a[jj - 1];
                            if (cmp(key, prev) < 0) {
                                a[jj] = prev;
                                jj = jj - 1;
                            } else {
                                moving = false;
                            }
                        } else {
                            moving = false;
                        }
                    }
                    a[jj] = key;
                    ii = ii + 1;
                }
                if (sp == 0) {
                    run = false;
                } else {
                    sp = sp - 1;
                    hi = ranges[sp];
                    sp = sp - 1;
                    lo = ranges[sp];
                }
            } else {
                // Median-of-3 pivot moved to a[lo], then a Hoare two-pointer
                // partition. Hoare's "stop on equal" splits keys equal to the
                // pivot EVENLY across both sides, so all-equal / many-duplicate
                // input stays balanced O(n log n) (Lomuto piled equals on one
                // side -> O(n^2)). It also touches already-/reverse-sorted input
                // with few swaps and no run reversal (a single-pointer 3-way flag
                // reverses the > band each level, wrecking sorted input).
                int32 mid = lo + (hi - lo) / 2;
                T x = a[lo];
                T y = a[mid];
                T z = a[hi];
                int32 mp;
                if (cmp(x, y) < 0) {
                    if (cmp(y, z) < 0) { mp = mid; }       // x < y < z
                    else if (cmp(x, z) < 0) { mp = hi; }   // x < z <= y
                    else { mp = lo; }                       // z <= x < y
                } else {
                    if (cmp(x, z) < 0) { mp = lo; }        // y <= x < z
                    else if (cmp(y, z) < 0) { mp = hi; }   // y < z <= x
                    else { mp = mid; }                      // z <= y <= x
                }
                T tlo = a[lo];
                a[lo] = a[mp];
                a[mp] = tlo;
                T pivot = a[lo];
                // Hoare partition around `pivot` (present at a[lo], so the
                // scans are bounded). Result: a[lo..j] <= pivot, a[j+1..hi] >= pivot.
                int32 i = lo - 1;
                int32 j = hi + 1;
                boolean part = true;
                while (part) {
                    boolean adv = true;
                    while (adv) {
                        i = i + 1;
                        if (cmp(a[i], pivot) >= 0) { adv = false; }
                    }
                    adv = true;
                    while (adv) {
                        j = j - 1;
                        if (cmp(a[j], pivot) <= 0) { adv = false; }
                    }
                    if (i >= j) {
                        part = false;
                    } else {
                        T ai = a[i];
                        T aj = a[j];
                        a[i] = aj;
                        a[j] = ai;
                    }
                }
                // Recurse both bands; loop the smaller and push the larger so the
                // explicit range stack stays O(log n) deep.
                int32 leftSize = j - lo;
                int32 rightSize = hi - j - 1;
                if (leftSize > rightSize) {
                    ranges[sp] = lo;
                    sp = sp + 1;
                    ranges[sp] = j;
                    sp = sp + 1;
                    lo = j + 1;
                } else {
                    ranges[sp] = j + 1;
                    sp = sp + 1;
                    ranges[sp] = hi;
                    sp = sp + 1;
                    hi = j;
                }
            }
        }
    }

    /**
     * Stable sort of `a[0..n)` by `cmp` (numpy `kind='stable'`/`'mergesort'`).
     * Bottom-up merge sort: O(n log n), O(n) auxiliary, equal keys keep their
     * input order (the merge takes the left run on ties).
     */
    public static void sortStable<T>(T[] a, int32 n, (T, T) -> int32 cmp) {
        if (n < 2) {
            return;
        }
        T[] buf = heap T[n];
        int32 width = 1;
        while (width < n) {
            int32 i = 0;
            while (i < n) {
                int32 left = i;
                int32 mid = i + width;
                if (mid > n) {
                    mid = n;
                }
                int32 right = i + width + width;
                if (right > n) {
                    right = n;
                }
                int32 li = left;
                int32 ri = mid;
                int32 k = left;
                while (li < mid && ri < right) {
                    T lv = a[li];
                    T rv = a[ri];
                    // Stable: take the right run only when it strictly orders
                    // before the left; ties keep the left element first.
                    if (cmp(rv, lv) < 0) {
                        buf[k] = rv;
                        ri = ri + 1;
                    } else {
                        buf[k] = lv;
                        li = li + 1;
                    }
                    k = k + 1;
                }
                while (li < mid) {
                    T lv = a[li];
                    buf[k] = lv;
                    li = li + 1;
                    k = k + 1;
                }
                while (ri < right) {
                    T rv = a[ri];
                    buf[k] = rv;
                    ri = ri + 1;
                    k = k + 1;
                }
                i = i + width + width;
            }
            int32 c = 0;
            while (c < n) {
                T v = buf[c];
                a[c] = v;
                c = c + 1;
            }
            width = width + width;
        }
    }

    /** First index in sorted `a[0..n)` whose element does not order before `key`
     *  (numpy `searchsorted` `side='left'`). In `[0, n]`. */
    public static int32 lowerBound<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 lo = 0;
        int32 hi = n;
        while (lo < hi) {
            int32 mid = lo + (hi - lo) / 2;
            T m = a[mid];
            if (cmp(m, key) < 0) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    /** First index in sorted `a[0..n)` whose element orders after `key`
     *  (numpy `searchsorted` `side='right'`). In `[0, n]`. */
    public static int32 upperBound<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 lo = 0;
        int32 hi = n;
        while (lo < hi) {
            int32 mid = lo + (hi - lo) / 2;
            T m = a[mid];
            if (cmp(key, m) < 0) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        return lo;
    }

    /** Index of `key` in sorted `a[0..n)`, or `-1` if absent (first match on
     *  duplicates). */
    public static int32 binarySearch<T>(T[] a, int32 n, T key, (T, T) -> int32 cmp) {
        int32 idx = lowerBound<T>(a, n, key, cmp);
        if (idx < n) {
            T m = a[idx];
            if (cmp(m, key) == 0) {
                return idx;
            }
        }
        return -1;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Natural-order entry points (by `<` / `>` on T) — thin seam wrappers
    // ─────────────────────────────────────────────────────────────────────

    // ─────────────────────────────────────────────────────────────────────
    // Natural-order pattern-defeating quicksort (pdqsort) — the hot path the
    // benchmarks and the numeric Tensor sort hit. This is a port of Orson
    // Peters' pdqsort: median-of-3 / pseudomedian-of-9 (ninther) pivots, a
    // BlockQuicksort-style *branchless* partition (no data-dependent branch in
    // the partition inner loop — the dominant win on random input), a
    // pattern-breaking shuffle on unbalanced splits, an introsort heapsort
    // fallback for O(n log n) worst case, and partial-insertion-sort on
    // already-partitioned runs (O(n) on sorted/structured input). Comparisons
    // are inlined `<` so a monomorphized `sort<int64>` lowers each to a native
    // `icmp`/`fcmp` (no comparator closure on this path).
    //
    // The helpers below are `public static` only because the toolchain has no
    // proven internal-visibility for templated statics yet; they are not part
    // of the intended Sort API. TODO: tighten to internal once available.
    // ─────────────────────────────────────────────────────────────────────

    public static void pdqSwap<T>(T[] a, int32 i, int32 j) {
        T t = a[i];
        a[i] = a[j];
        a[j] = t;
    }

    // Order a[i] <= a[j].
    public static void pdqSort2<T>(T[] a, int32 i, int32 j) {
        if (a[j] < a[i]) {
            T t = a[i];
            a[i] = a[j];
            a[j] = t;
        }
    }

    // Order a[i] <= a[j] <= a[k].
    public static void pdqSort3<T>(T[] a, int32 i, int32 j, int32 k) {
        pdqSort2<T>(a, i, j);
        pdqSort2<T>(a, j, k);
        pdqSort2<T>(a, i, j);
    }

    // Guarded insertion sort of a[begin..end) (end exclusive).
    public static void pdqInsertion<T>(T[] a, int32 begin, int32 end) {
        if (begin >= end) {
            return;
        }
        int32 cur = begin + 1;
        while (cur < end) {
            int32 sift = cur;
            if (a[sift] < a[sift - 1]) {
                T tmp = a[sift];
                boolean go = true;
                while (go) {
                    a[sift] = a[sift - 1];
                    sift = sift - 1;
                    if (sift == begin) {
                        go = false;
                    } else if (!(tmp < a[sift - 1])) {
                        go = false;
                    }
                }
                a[sift] = tmp;
            }
            cur = cur + 1;
        }
    }

    // Insertion sort of a[begin..end) assuming a[begin-1] <= every element in
    // the range, so the inner shift never needs the `sift == begin` guard.
    public static void pdqUnguardedInsertion<T>(T[] a, int32 begin, int32 end) {
        if (begin >= end) {
            return;
        }
        int32 cur = begin + 1;
        while (cur < end) {
            int32 sift = cur;
            if (a[sift] < a[sift - 1]) {
                T tmp = a[sift];
                boolean go = true;
                while (go) {
                    a[sift] = a[sift - 1];
                    sift = sift - 1;
                    if (!(tmp < a[sift - 1])) {
                        go = false;
                    }
                }
                a[sift] = tmp;
            }
            cur = cur + 1;
        }
    }

    // Insertion sort of a[begin..end) that gives up (returns false) after more
    // than 8 element moves — the cheap "is this run already nearly sorted?" probe.
    public static boolean pdqPartialInsertion<T>(T[] a, int32 begin, int32 end) {
        if (begin >= end) {
            return true;
        }
        int32 limit = 0;
        int32 cur = begin + 1;
        while (cur < end) {
            int32 sift = cur;
            if (a[sift] < a[sift - 1]) {
                T tmp = a[sift];
                boolean go = true;
                while (go) {
                    a[sift] = a[sift - 1];
                    sift = sift - 1;
                    if (sift == begin) {
                        go = false;
                    } else if (!(tmp < a[sift - 1])) {
                        go = false;
                    }
                }
                a[sift] = tmp;
                limit = limit + (cur - sift);
            }
            if (limit > 8) {
                return false;
            }
            cur = cur + 1;
        }
        return true;
    }

    // Sift a[begin+root] down a binary max-heap of `count` elements rooted at
    // a[begin].
    public static void pdqSiftDown<T>(T[] a, int32 begin, int32 root, int32 count) {
        boolean go = true;
        while (go) {
            int32 child = 2 * root + 1;
            if (child >= count) {
                go = false;
            } else {
                if (child + 1 < count) {
                    if (a[begin + child] < a[begin + child + 1]) {
                        child = child + 1;
                    }
                }
                if (a[begin + root] < a[begin + child]) {
                    pdqSwap<T>(a, begin + root, begin + child);
                    root = child;
                } else {
                    go = false;
                }
            }
        }
    }

    // In-place heapsort of a[begin..end) — the introsort fallback that caps the
    // worst case at O(n log n).
    public static void pdqHeapSort<T>(T[] a, int32 begin, int32 end) {
        int32 count = end - begin;
        if (count < 2) {
            return;
        }
        int32 start = count / 2;
        while (start > 0) {
            start = start - 1;
            pdqSiftDown<T>(a, begin, start, count);
        }
        int32 e = count;
        while (e > 1) {
            e = e - 1;
            pdqSwap<T>(a, begin, begin + e);
            pdqSiftDown<T>(a, begin, 0, e);
        }
    }

    // The non-branchless swap step shared by the block partition: move `num`
    // pairs identified by the offset blocks to their correct sides.
    public static void pdqSwapOffsets<T>(T[] a, int32 firstBase, int32 lastBase,
            int32[] offL, int32 startL, int32[] offR, int32 startR,
            int32 num, boolean useSwaps) {
        if (useSwaps) {
            int32 i = 0;
            while (i < num) {
                pdqSwap<T>(a, firstBase + offL[startL + i], lastBase - offR[startR + i]);
                i = i + 1;
            }
        } else if (num > 0) {
            int32 l = firstBase + offL[startL];
            int32 r = lastBase - offR[startR];
            T tmp = a[l];
            a[l] = a[r];
            int32 i = 1;
            while (i < num) {
                l = firstBase + offL[startL + i];
                a[r] = a[l];
                r = lastBase - offR[startR + i];
                a[l] = a[r];
                i = i + 1;
            }
            a[r] = tmp;
        }
    }

    // Branchless partition of a[begin..end) around pivot a[begin] (elements
    // equal to the pivot go right). Writes 1/0 into apOut[0] for "was already
    // correctly partitioned" and returns the final pivot index. `offL`/`offR`
    // are caller-owned scratch of length >= 64 (reused across every call).
    public static int32 pdqPartitionRight<T>(T[] a, int32 begin, int32 end,
            int32[] offL, int32[] offR, int32[] apOut) {
        T pivot = a[begin];
        int32 first = begin;
        int32 last = end;

        boolean go = true;
        while (go) {
            first = first + 1;
            if (!(a[first] < pivot)) {
                go = false;
            }
        }

        if (first - 1 == begin) {
            go = true;
            while (go) {
                if (first < last) {
                    last = last - 1;
                    if (a[last] < pivot) {
                        go = false;
                    }
                } else {
                    go = false;
                }
            }
        } else {
            go = true;
            while (go) {
                last = last - 1;
                if (a[last] < pivot) {
                    go = false;
                }
            }
        }

        boolean alreadyPartitioned = first >= last;
        if (first < last) {
            pdqSwap<T>(a, first, last);
            first = first + 1;

            int32 offLBase = first;
            int32 offRBase = last;
            int32 numL = 0;
            int32 numR = 0;
            int32 startL = 0;
            int32 startR = 0;

            while (first < last) {
                int32 numUnknown = last - first;
                int32 leftSplit;
                int32 rightSplit;
                if (numL == 0) {
                    if (numR == 0) {
                        leftSplit = numUnknown / 2;
                    } else {
                        leftSplit = numUnknown;
                    }
                } else {
                    leftSplit = 0;
                }
                if (numR == 0) {
                    rightSplit = numUnknown - leftSplit;
                } else {
                    rightSplit = 0;
                }

                // Each iteration processes at most block_size (64) elements per
                // side — the split only says how many are *eligible*; the offset
                // buffers hold 64.
                int32 leftCount;
                if (leftSplit >= 64) {
                    leftCount = 64;
                } else {
                    leftCount = leftSplit;
                }
                int32 li = 0;
                while (li < leftCount) {
                    offL[numL] = li;
                    numL = numL + ((a[first] < pivot) ? 0 : 1);
                    first = first + 1;
                    li = li + 1;
                }

                int32 rightCount;
                if (rightSplit >= 64) {
                    rightCount = 64;
                } else {
                    rightCount = rightSplit;
                }
                int32 ri = 0;
                while (ri < rightCount) {
                    ri = ri + 1;
                    offR[numR] = ri;
                    last = last - 1;
                    numR = numR + ((a[last] < pivot) ? 1 : 0);
                }

                int32 num;
                if (numL < numR) {
                    num = numL;
                } else {
                    num = numR;
                }
                pdqSwapOffsets<T>(a, offLBase, offRBase, offL, startL, offR, startR, num, numL == numR);
                numL = numL - num;
                numR = numR - num;
                startL = startL + num;
                startR = startR + num;
                if (numL == 0) {
                    startL = 0;
                    offLBase = first;
                }
                if (numR == 0) {
                    startR = 0;
                    offRBase = last;
                }
            }

            if (numL > 0) {
                int32 k = numL;
                while (k > 0) {
                    k = k - 1;
                    last = last - 1;
                    pdqSwap<T>(a, offLBase + offL[startL + k], last);
                }
                first = last;
            }
            if (numR > 0) {
                int32 k = numR;
                while (k > 0) {
                    k = k - 1;
                    pdqSwap<T>(a, offRBase - offR[startR + k], first);
                    first = first + 1;
                }
                last = first;
            }
        }

        int32 pivotPos = first - 1;
        a[begin] = a[pivotPos];
        a[pivotPos] = pivot;
        if (alreadyPartitioned) {
            apOut[0] = 1;
        } else {
            apOut[0] = 0;
        }
        return pivotPos;
    }

    // Partition of a[begin..end) putting elements equal to the pivot to its
    // LEFT — used only when a partition is full of pivot-equal keys, where
    // pdqsort is already O(n) so a simple (non-block) partition suffices.
    public static int32 pdqPartitionLeft<T>(T[] a, int32 begin, int32 end) {
        T pivot = a[begin];
        int32 first = begin;
        int32 last = end;

        boolean go = true;
        while (go) {
            last = last - 1;
            if (!(pivot < a[last])) {
                go = false;
            }
        }

        if (last + 1 == end) {
            go = true;
            while (go) {
                if (first < last) {
                    first = first + 1;
                    if (pivot < a[first]) {
                        go = false;
                    }
                } else {
                    go = false;
                }
            }
        } else {
            go = true;
            while (go) {
                first = first + 1;
                if (pivot < a[first]) {
                    go = false;
                }
            }
        }

        while (first < last) {
            pdqSwap<T>(a, first, last);
            go = true;
            while (go) {
                last = last - 1;
                if (!(pivot < a[last])) {
                    go = false;
                }
            }
            go = true;
            while (go) {
                first = first + 1;
                if (pivot < a[first]) {
                    go = false;
                }
            }
        }

        int32 pivotPos = last;
        a[begin] = a[pivotPos];
        a[pivotPos] = pivot;
        return pivotPos;
    }

    // The pdqsort driver over a[begin0..end0). Non-recursive: an explicit work
    // stack (st*) holds deferred partitions, and at each split we *continue* the
    // larger side and *push* the smaller — bounding the stack to O(log n) frames.
    // `leftmost` is not threaded as state: a segment is leftmost exactly when
    // `begin == 0` (every right partition starts past a pivot known <= its
    // elements, so its unguarded small-sort is safe). `badAllowed` counts
    // unbalanced partitions down to the heapsort fallback (O(n log n) worst case).
    public static void pdqRun<T>(T[] a, int32 begin0, int32 end0, int32 bad0,
            int32[] offL, int32[] offR, int32[] apOut,
            int32[] stB, int32[] stE, int32[] stBad) {
        int32 sp = 0;
        int32 begin = begin0;
        int32 end = end0;
        int32 badAllowed = bad0;
        boolean run = true;
        while (run) {
            boolean popNext = false;
            int32 size = end - begin;
            if (size < 24) {
                if (begin == 0) {
                    pdqInsertion<T>(a, begin, end);
                } else {
                    pdqUnguardedInsertion<T>(a, begin, end);
                }
                popNext = true;
            } else {
                int32 s2 = size / 2;
                if (size > 128) {
                    pdqSort3<T>(a, begin, begin + s2, end - 1);
                    pdqSort3<T>(a, begin + 1, begin + (s2 - 1), end - 2);
                    pdqSort3<T>(a, begin + 2, begin + (s2 + 1), end - 3);
                    pdqSort3<T>(a, begin + (s2 - 1), begin + s2, begin + (s2 + 1));
                    pdqSwap<T>(a, begin, begin + s2);
                } else {
                    pdqSort3<T>(a, begin + s2, begin, end - 1);
                }

                boolean doLeft = false;
                if (begin != 0) {
                    if (!(a[begin - 1] < a[begin])) {
                        doLeft = true;
                    }
                }
                if (doLeft) {
                    begin = pdqPartitionLeft<T>(a, begin, end) + 1;
                } else {
                    int32 pivotPos = pdqPartitionRight<T>(a, begin, end, offL, offR, apOut);
                    boolean alreadyPartitioned = apOut[0] == 1;
                    int32 lSize = pivotPos - begin;
                    int32 rSize = end - (pivotPos + 1);
                    int32 eighth = size / 8;
                    boolean highlyUnbalanced = (lSize < eighth) || (rSize < eighth);

                    if (highlyUnbalanced) {
                        badAllowed = badAllowed - 1;
                        if (badAllowed == 0) {
                            pdqHeapSort<T>(a, begin, end);
                            popNext = true;
                        } else {
                            if (lSize >= 24) {
                                pdqSwap<T>(a, begin, begin + lSize / 4);
                                pdqSwap<T>(a, pivotPos - 1, pivotPos - lSize / 4);
                                if (lSize > 128) {
                                    pdqSwap<T>(a, begin + 1, begin + (lSize / 4 + 1));
                                    pdqSwap<T>(a, begin + 2, begin + (lSize / 4 + 2));
                                    pdqSwap<T>(a, pivotPos - 2, pivotPos - (lSize / 4 + 1));
                                    pdqSwap<T>(a, pivotPos - 3, pivotPos - (lSize / 4 + 2));
                                }
                            }
                            if (rSize >= 24) {
                                pdqSwap<T>(a, pivotPos + 1, pivotPos + (1 + rSize / 4));
                                pdqSwap<T>(a, end - 1, end - rSize / 4);
                                if (rSize > 128) {
                                    pdqSwap<T>(a, pivotPos + 2, pivotPos + (2 + rSize / 4));
                                    pdqSwap<T>(a, pivotPos + 3, pivotPos + (3 + rSize / 4));
                                    pdqSwap<T>(a, end - 2, end - (1 + rSize / 4));
                                    pdqSwap<T>(a, end - 3, end - (2 + rSize / 4));
                                }
                            }
                        }
                    } else {
                        if (alreadyPartitioned) {
                            if (pdqPartialInsertion<T>(a, begin, pivotPos)) {
                                if (pdqPartialInsertion<T>(a, pivotPos + 1, end)) {
                                    popNext = true;
                                }
                            }
                        }
                    }

                    if (!popNext) {
                        // Split: continue the larger partition, push the smaller.
                        int32 lb = begin;
                        int32 le = pivotPos;
                        int32 rb = pivotPos + 1;
                        int32 re = end;
                        if ((le - lb) > (re - rb)) {
                            stB[sp] = rb;
                            stE[sp] = re;
                            stBad[sp] = badAllowed;
                            sp = sp + 1;
                            end = le;
                        } else {
                            stB[sp] = lb;
                            stE[sp] = le;
                            stBad[sp] = badAllowed;
                            sp = sp + 1;
                            begin = rb;
                        }
                    }
                }
            }
            if (popNext) {
                if (sp == 0) {
                    run = false;
                } else {
                    sp = sp - 1;
                    begin = stB[sp];
                    end = stE[sp];
                    badAllowed = stBad[sp];
                }
            }
        }
    }

    // Natural-order unstable sort (numpy `kind='quicksort'`): pattern-defeating
    // quicksort. See the helper block above.
    public static void sort<T>(T[] a, int32 n) {
        if (n < 2) {
            return;
        }
        int32[] offL = heap int32[64];
        int32[] offR = heap int32[64];
        int32[] apOut = heap int32[1];
        int32[] stB = heap int32[64];
        int32[] stE = heap int32[64];
        int32[] stBad = heap int32[64];
        int32 badAllowed = 0;
        int32 m = n;
        while (m > 1) {
            m = m >> 1;
            badAllowed = badAllowed + 1;
        }
        pdqRun<T>(a, 0, n, badAllowed, offL, offR, apOut, stB, stE, stBad);
    }

    public static void sortStable<T>(T[] a, int32 n) {
        sortStable<T>(a, n, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 lowerBound<T>(T[] a, int32 n, T key) {
        return lowerBound<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 upperBound<T>(T[] a, int32 n, T key) {
        return upperBound<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    public static int32 binarySearch<T>(T[] a, int32 n, T key) {
        return binarySearch<T>(a, n, key, (x, y) -> {
            if (x < y) {
                return -1;
            }
            if (x > y) {
                return 1;
            }
            return 0;
        });
    }

    // ArrayList sorting is exposed as the instance methods `ArrayList.sort()` /
    // `ArrayList.sortStable()` (which sort the backing array in place via the
    // (T[], int32) entry points above) — not as static overloads here, since
    // same-named templated `sort` overloads across `(T[], int32)` and
    // `(ArrayList<T>, …)` don't resolve reliably.
}
