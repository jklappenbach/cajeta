package cajeta.collection;

import cajeta.lang.stream.ArrayStream;
import cajeta.lang.stream.Stream;

/**
 * Growable, index-addressable sequence of `T`, backed by a
 * heap-allocated `T[]` that doubles its capacity on demand. This is
 * the workhorse list of the collections package and the default
 * accumulator behind `Collectors.toList<T>()`.
 *
 * The list OWNS its elements (uniform-transfer 2.3): `add`, `set`,
 * and `insert` take `#T`, `removeAt` and the extracting subscript
 * hand the title back out, and teardown drops exactly the owned
 * slots via the backing array's tail bitmap.
 *
 * ```cajeta
 * ArrayList<int32> xs = heap ArrayList<int32>();
 * xs.add(10);
 * xs.add(20);
 * xs.add(30);
 * int32 n = xs.count();        // 3
 * int32 first = xs.get(0);     // 10
 * xs.set(1, 25);               // [10, 25, 30]
 * xs.insert(1, 15);            // [10, 15, 25, 30]
 * int32 gone = xs.removeAt(0); // 10 -> [15, 25, 30]
 * #ArrayStream<int32> s = xs.stream();
 * ```
 *
 * ## Surface
 * Ctors (empty / `#T[]` literal), `count` / `isEmpty`, `get` / `set`,
 * `add` / `insert` / `removeAt` / `clear`, `appendAll` (consuming
 * combiner), subscripts (`[]` borrow read, `[]=` transfer write,
 * `#[]` extraction), `stream`, `sort` / `sortStable`. Out-of-range
 * indexes on get/set/insert/removeAt throw a Recoverable Exception.
 */
public final class ArrayList<T> {
    T[] data;
    // title-stores Unit 5 — per-element ownership lives in data's tail
    // bitmap (stores write it, the field walk drops by it).
    // Field name aligned with HashMap/HashSet/LinkedList — `count` as a
    // bare field name conflicts with the public `count()` accessor at
    // method resolution sites (templated-class dispatch ambiguity).
    int32 sizeCount;
    int32 capacity;

    /**
     * Create an empty list with an initial backing capacity of 16;
     * the array grows automatically as elements are added.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(42);
     * ```
     *
     * @EntryPoint
     */
    public ArrayList() {
        this.capacity = 16;
        this.data = heap T[16];
        this.sizeCount = 0;
    }

    /**
     * Create a list holding every element of `items`, in order. Backs the
     * collection-literal form `ArrayList<int32> xs = heap ArrayList<int32>([1,2,3])`
     * (array-literals §6). The literal array is CONSUMED (`#T[]`) — the
     * list owns its elements, so each one moves out of the source. The
     * backing array is sized to the element count up front (one
     * allocation, no re-grow during the fill).
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>([1, 2, 3]);   // count() == 3
     * ```
     */
    public ArrayList(#T[] items) {
        int32 n = (int32) items.count();
        int32 cap = 16;
        while (cap < n) {
            cap = cap * 2;
        }
        this.capacity = cap;
        this.data = heap T[cap];
        int32 i = 0;
        while (i < n) {
            // title-stores §2.1 — forwarding move: the element's bit rides
            // out of the consumed literal into the backing slot.
            this.data[i] #= items[i];
            i = i + 1;
        }
        this.sizeCount = n;
    }

    public int32 count() {
        return this.sizeCount;
    }

    /** `true` when the list holds no elements (`count() == 0`). */
    public boolean isEmpty() {
        return this.sizeCount == 0;
    }

    /** Borrowing read of the element at `i`. Throws when out of range. */
    public T get(int32 i) {
        if (i < 0 || i >= this.sizeCount) {
            throw heap Exception("ArrayList.get: index out of range");
        }
        return this.data[i];
    }

    /**
     * Replace the element at `i`. The slot store's displaced release
     * (title-stores §3.2) drops the old occupant, which the list owns.
     * Throws when out of range.
     */
    public void set(int32 i, #T v) {
        if (i < 0 || i >= this.sizeCount) {
            throw heap Exception("ArrayList.set: index out of range");
        }
        this.data[i] #= v;
    }

    /**
     * Append `v` to the end of the list, doubling the backing array's
     * capacity first if it is full.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(1);
     * xs.add(2);   // count() == 2
     * ```
     */
    @Inline
    public void add(#T v) {
        // Hot path: the slot is already there. Kept tiny (a load, a compare, a
        // store, an increment) and free of the growth machinery so the optimizer
        // inlines it straight into the caller's append loop — matching the
        // inlined `push`/`push_back` of Rust `Vec` / C++ `std::vector`. The cold
        // doubling lives out-of-line in `reserve()`, so it never bloats this
        // body. One unconditional transfer — the hottest store in the language,
        // and it carries no runtime branch on ownership.
        if (this.sizeCount >= this.capacity) {
            this.reserve(this.sizeCount + 1);
        }
        this.data[this.sizeCount] #= v;
        this.sizeCount = this.sizeCount + 1;
    }

    /**
     * Insert `v` at index `i`, shifting `[i, count)` right by one.
     * `i == count()` appends. O(n - i). Throws when `i` is out of
     * `[0, count]`.
     */
    public void insert(int32 i, #T v) {
        if (i < 0 || i > this.sizeCount) {
            throw heap Exception("ArrayList.insert: index out of range");
        }
        if (this.sizeCount >= this.capacity) {
            this.reserve(this.sizeCount + 1);
        }
        // title-stores §2.1 — forwarding shifts: each bit rides right with
        // its element; the vacated slot's bit is clear, so the final store
        // fires no displaced release.
        int32 j = this.sizeCount;
        while (j > i) {
            this.data[j] #= this.data[j - 1];
            j = j - 1;
        }
        this.data[i] #= v;
        this.sizeCount = this.sizeCount + 1;
    }

    /**
     * Remove the element at `i`, shifting `(i, count)` left by one, and
     * hand it back OWNED — bind it (`String s = xs.removeAt(0)`) to keep
     * it, or discard the call and the drop fires at the statement end.
     * O(n - i). Throws when out of range; panics TITLE_MISS if the slot's
     * title was already `#[]`-extracted (extraction decays the slot, and
     * a decayed slot has no title left to hand out).
     */
    public #T removeAt(int32 i) {
        if (i < 0 || i >= this.sizeCount) {
            throw heap Exception("ArrayList.removeAt: index out of range");
        }
        // Guarded take (title-stores §3.2), then forwarding shifts close
        // the gap. The former last slot is left decayed (bit clear), so
        // teardown and later stores ignore it.
        T out #= this.data[i];
        int32 j = i;
        int32 last = this.sizeCount - 1;
        while (j < last) {
            this.data[j] #= this.data[j + 1];
            j = j + 1;
        }
        this.sizeCount = last;
        return #out;
    }

    /**
     * Drop every element and reset to the initial capacity. The old
     * backing array's teardown drops exactly the owned slots (tail
     * bitmap), so each element is released once. The list is empty and
     * immediately reusable.
     */
    public void clear() {
        T[] fresh = heap T[16];
        // `#fresh` publishes the new storage onto the field; the displaced
        // release frees the old array along with its owned elements.
        this.data #= fresh;
        this.capacity = 16;
        this.sizeCount = 0;
    }

    // Cold, out-of-line: grow the backing array to at least `needed`,
    // doubling from the current capacity. Split out of the mutators so
    // their hot paths stay branch-cold and inlinable. One copy pass
    // regardless of how far the target is (appendAll reserves the full
    // merged size in one call rather than re-doubling per element).
    @NoInline
    private void reserve(int32 needed) {
        if (needed <= this.capacity) {
            return;
        }
        int32 newCap = this.capacity * 2;
        while (newCap < needed) {
            newCap = newCap * 2;
        }
        T[] grown = heap T[newCap];
        int32 i = 0;
        while (i < this.sizeCount) {
            // title-stores §2.1 — forwarding move: the tail bit rides so
            // post-grow extraction/teardown stay honest.
            grown[i] #= this.data[i];
            i = i + 1;
        }
        // `#grown` transfers ownership of the fresh array storage into
        // `this.data` — without the marker, the local's scope-exit drop
        // would free the array we just installed. Same pattern as
        // HashMap.resize.
        this.data #= grown;
        this.capacity = newCap;
    }

    /**
     * Append every element of `other` onto this list, in order — and
     * CONSUME `other`: a list owns its elements, so the elements move
     * across and the right-hand list is dead at the call. This is the
     * combiner for `Collectors.toList<T>()` under a parallel collect —
     * per-worker partials are folded right-onto-left and discarded.
     * Reserves the merged size once (no re-doubling inside the loop).
     */
    public void appendAll(#ArrayList<T> other) {
        this.reserve(this.sizeCount + other.sizeCount);
        int32 i = 0;
        while (i < other.sizeCount) {
            this.data[this.sizeCount + i] #= other.data[i];
            i = i + 1;
        }
        this.sizeCount = this.sizeCount + other.sizeCount;
    }

    // title-stores Unit 5 — no bespoke destructor: data's tail-bit field
    // walk drops exactly the owned slots.

    // ----- Subscript-syntax sugar over get/set -------------------------

    /** Subscript read: `v = xs[i]` → `get(i)` (a borrow, §6.2). */
    public T operator[] (int32 i) {
        return this.get(i);
    }

    /** Subscript write: `xs[i] = v` → `set(i, v)`. Both the formal and the
     *  forward are `#` under uniform-transfer 2.3: the list owns its
     *  elements, so an indexed store is a transfer like any other. */
    public void operator[]= (int32 i, #T v) {
        this.set(i, #v);
    }

    /**
     * Title-extracting subscript — `T t #= xs[i]` (title-tracking §6.3).
     * TOTAL: either the slot holds a title and it moves to the caller — the
     * slot stays RESIDENT and readable, its bit decayed to borrowed
     * (membership is not ownership) — or this throws: extraction from an
     * out-of-range index or a slot holding no title (borrowed, or already
     * extracted) is a Recoverable panic, never a silent second title.
     */
    public #T operator#[] (int32 i) {
        if (i < 0 || i >= this.sizeCount) {
            throw heap Exception("#[] extraction: index out of range — extraction requires a resident owned element");
        }
        // Guarded take (title-stores §3.2): the title moves out and the
        // bit clears; a borrowed or already-extracted slot panics
        // TITLE_MISS.
        T out #= this.data[i];
        return #out;
    }

    /**
     * Open a heap-allocated `Stream` (an `ArrayStream`) over the
     * live elements `data[0..count-1]`. Ownership of the stream
     * transfers to the caller (`#ArrayStream<T>`).
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(1);
     * xs.add(2);
     * #ArrayStream<int32> s = xs.stream();
     * ```
     *
     * A stack-allocated variant follows once `stack ArrayStream<T>`
     * aggregate-init on a generic instantiation is verified.
     */
    public #ArrayStream<T> stream() {
        return heap ArrayStream<T>(this.data, this.sizeCount);
    }

    /**
     * Sort the live elements in place into ascending natural order (`<` on
     * `T`) — unstable/fast (quicksort). Sorts the backing array directly (no
     * copy); the trailing spare capacity is untouched. Delegates to
     * {@link cajeta.collection.Sort}.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(3);
     * xs.add(1);
     * xs.add(2);
     * xs.sort();                    // [1, 2, 3]
     * ```
     *
     * OWNERSHIP CAVEAT: sorting permutes elements WITHOUT their ownership
     * bits. Every resident element is owned (the list's stores all
     * transfer), so the bits are uniformly set and permutation is safe —
     * UNLESS a slot's title was `#[]`-extracted: that slot's bit is clear
     * while its neighbors' are set, and sorting would attach the bits to
     * the wrong slots (leak + double free). Do not sort after extraction.
     */
    public void sort() {
        Sort.sort<T>(this.data, this.sizeCount);
    }

    /**
     * Sort the live elements in place into ascending natural order, **stable**
     * (merge sort — equal elements keep their input order). Same extraction
     * caveat as `sort()`. See {@link cajeta.collection.Sort}.
     */
    public void sortStable() {
        Sort.sortStable<T>(this.data, this.sizeCount);
    }
}
