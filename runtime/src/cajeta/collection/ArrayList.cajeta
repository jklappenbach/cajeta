package cajeta.collection;

import cajeta.lang.stream.ArrayStream;
import cajeta.lang.stream.Stream;

/**
 * Growable, index-addressable sequence of `T`, backed by a
 * heap-allocated `T[]` that doubles its capacity on demand. This is
 * the workhorse list of the collections package and the default
 * accumulator behind `Collectors.toList<T>()`.
 *
 * Construct an empty list with the no-arg constructor, populate it
 * with `add`, read/write slots with `get`/`set`, and walk the live
 * elements as a `Stream` via `stream` (which yields an
 * `ArrayStream`):
 *
 * ```cajeta
 * ArrayList<int32> xs = heap ArrayList<int32>();
 * xs.add(10);
 * xs.add(20);
 * xs.add(30);
 * int32 n = xs.count();        // 3
 * int32 first = xs.get(0);     // 10
 * xs.set(1, 25);               // [10, 25, 30]
 * #ArrayStream<int32> s = xs.stream();
 * ```
 *
 * Merge two lists with `appendAll`, the combiner used when partial
 * lists from parallel workers are folded together.
 *
 * ## v1 surface
 * Minimal by design: ctor, `count`/`isEmpty`, `get`/`set`, `add`,
 * `appendAll`, and `stream`. No bounds checks yet (those land with
 * the error-model wiring) and no `insert`/`remove` yet.
 *
 * `stream` currently lands a heap-allocated `ArrayStream` walking
 * the backing array up to the current size. A stack-allocated variant
 * follows once `stack ArrayStream<T>` aggregate-init on a generic
 * instantiation is verified.
 */
public final class ArrayList<T> {
    T[] data;
    // title-stores Unit 5 — per-element ownership lives in data's tail
    // bitmap (stores write it, the field walk drops by it); owned[] gone.
    // Field name aligned with HashMap/HashSet/LinkedList — `count` as a
    // bare field name conflicts with the public `count()` accessor at
    // method resolution sites (templated-class dispatch ambiguity).
    int32 sizeCount;
    int32 capacity;

    /**
     * Create an empty list with an initial backing capacity of 16;
     * the array grows automatically as elements are added.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(42);
     * ```
     *
     * @EntryPoint
     */
    public ArrayList() {
        this.capacity = 16;
        this.data = heap T[16];
        this.sizeCount = 0;
    }

    public int32 count() {
        return this.sizeCount;
    }

    /** `true` when the list holds no elements (`count() == 0`). */
    public boolean isEmpty() {
        return this.sizeCount == 0;
    }

    public T get(int32 i) {
        return this.data[i];
    }

    public void set(int32 i, T v) {
        // Dual-capable store (title-tracking §6.1): the CALL SITE decides.
        // `v` is the second user arg → word bit 1. The spelling must MATCH
        // what the caller did (see HashMap.put): `#v` moves the title in;
        // the plain store keeps the shared-capable dual-role resolve.
        boolean vOwned = Cajeta.owned(v);
        // The slot store's displaced release (title-stores §3.2) drops an
        // owned old occupant; the bit records the spelling.
        if (vOwned) {
            this.data[i] = #v;
        } else {
            this.data[i] = v;
        }
    }

    /**
     * Append `v` to the end of the list, doubling the backing array's
     * capacity first if it is full.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(1);
     * xs.add(2);   // count() == 2
     * ```
     */
    @Inline
    public void add(T v) {
        // Hot path: the slot is already there. Kept tiny (a load, a compare, a
        // store, an increment) and free of the growth machinery so the optimizer
        // inlines it straight into the caller's append loop — matching the
        // inlined `push`/`push_back` of Rust `Vec` / C++ `std::vector`. The cold
        // doubling lives out-of-line in `grow()`, so it never bloats this body.
        boolean vOwned = Cajeta.owned(v);
        if (this.sizeCount >= this.capacity) {
            this.grow();
        }
        // Dual-capable store (title-tracking §6.1) — spelling matches the
        // caller's transfer, same as HashMap.put.
        if (vOwned) {
            this.data[this.sizeCount] = #v;
        } else {
            this.data[this.sizeCount] = v;
        }
        this.sizeCount = this.sizeCount + 1;
    }

    // Cold, out-of-line: double the backing array and copy the live elements
    // over. Split out of `add` so the full-capacity case stays branch-cold and
    // `add`'s hot path stays inlinable.
    @NoInline
    private void grow() {
        int32 newCap = this.capacity * 2;
        T[] grown = heap T[newCap];
        int32 i = 0;
        while (i < this.sizeCount) {
            // title-stores §2.1 — forwarding move: the tail bit rides so
            // post-grow extraction/teardown stay honest.
            grown[i] #= #this.data[i];
            i = i + 1;
        }
        // `#grown` transfers ownership of the fresh array storage
        // into `this.data` — without the marker, the local's
        // scope-exit drop would call __cajeta_free_array on the
        // array we just installed in the field, leaving `this.data`
        // pointing at freed storage. Subsequent `add`s would then
        // write into reclaimed memory. Same pattern HashMap.rehash
        // uses for `this.keys = #newKeys` et al.
        this.data = #grown;
        this.capacity = newCap;
    }

    /**
     * Append every element of `other` onto this list (in iteration
     * order). Used as the combiner for `Collectors.toList<T>()` under
     * a parallel collect: each worker produces its own `ArrayList<T>`
     * partial, and the orchestrator combines them by appending right
     * onto left. Does NOT consume / move-out of `other` — the caller
     * still owns its list.
     */
    public void appendAll(ArrayList<T> other) {
        // Bind each element through a named local — array element
        // reads currently lower to a slot l-value in some contexts
        // (see ParallelDriver.combine workaround comment), so a
        // direct `this.add(other.data[i])` mistypes the second arg.
        int32 i = 0;
        while (i < other.sizeCount) {
            T v = other.data[i];
            this.add(v);
            i = i + 1;
        }
    }

    // title-stores Unit 5 — no bespoke destructor: data's tail-bit field
    // walk drops exactly the owned slots.
    ~ArrayList() {
    }

    // ----- Subscript-syntax sugar over get/set -------------------------

    /** Subscript read: `v = xs[i]` → `get(i)` (a borrow, §6.2). */
    public T operator[] (int32 i) {
        return this.get(i);
    }

    /** Subscript write: `xs[i] = v` → `set(i, v)`. The `#v` forward is what
     *  threads the CALLER's transfer word through to set (a droppable class
     *  formal forwards its entry flag; an entry-less String/primitive formal
     *  forwards its incoming word bit) — a plain forward would record every
     *  indexed store as borrowed regardless of the caller's spelling. */
    public void operator[]= (int32 i, T v) {
        this.set(i, #v);
    }

    /**
     * Title-extracting subscript — `T t = #xs[i]` (title-tracking §6.3).
     * TOTAL: either the slot holds a title and it moves to the caller — the
     * slot stays RESIDENT and readable, its bit decayed to borrowed
     * (membership is not ownership) — or this throws: extraction from an
     * out-of-range index or a slot holding no title (borrowed, or already
     * extracted) is a Recoverable panic, never a silent second title.
     */
    public #T operator#[] (int32 i) {
        if (i < 0 || i >= this.sizeCount) {
            throw heap Exception("#[] extraction: index out of range — extraction requires a resident owned element");
        }
        // Guarded take (title-stores §3.2): the title moves out and the
        // bit clears; a borrowed or already-extracted slot panics
        // TITLE_MISS.
        T out = #this.data[i];
        return #out;
    }

    /**
     * Open a heap-allocated `Stream` (an `ArrayStream`) over the
     * live elements `data[0..count-1]`. Ownership of the stream
     * transfers to the caller (`#ArrayStream<T>`).
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(1);
     * xs.add(2);
     * #ArrayStream<int32> s = xs.stream();
     * ```
     *
     * A stack-allocated variant follows once `stack ArrayStream<T>`
     * aggregate-init on a generic instantiation is verified.
     */
    public #ArrayStream<T> stream() {
        return heap ArrayStream<T>(this.data, this.sizeCount);
    }

    /**
     * Sort the live elements in place into ascending natural order (`<` on
     * `T`) — unstable/fast (quicksort). Sorts the backing array directly (no
     * copy); the trailing spare capacity is untouched. Delegates to
     * {@link cajeta.collection.Sort}.
     *
     * ```cajeta
     * ArrayList<int32> xs = heap ArrayList<int32>();
     * xs.add(3);
     * xs.add(1);
     * xs.add(2);
     * xs.sort();                    // [1, 2, 3]
     * ```
     *
     * OWNERSHIP CAVEAT: sorting permutes elements WITHOUT their ownership
     * bits, so a list holding any `#`-taken (owned) elements must not be
     * sorted — the bits would attach to the wrong slots (leak + double
     * free). Borrow-only lists (and primitives) are unaffected.
     */
    public void sort() {
        Sort.sort<T>(this.data, this.sizeCount);
    }

    /**
     * Sort the live elements in place into ascending natural order, **stable**
     * (merge sort — equal elements keep their input order). See
     * {@link cajeta.collection.Sort}.
     */
    public void sortStable() {
        Sort.sortStable<T>(this.data, this.sizeCount);
    }
}
