package cajeta.collection;

import cajeta.lang.stream.ArrayStream;
import cajeta.lang.stream.Stream;

/**
 * Dynamic array. Backed by a heap-allocated T[] that grows on demand.
 * v1 minimal surface: ctor, size, get/set, add, stream(). No bounds
 * checks yet (lands with the error model wiring); no insert/remove
 * yet.
 *
 * stream() lands a heap-allocated ArrayStream<T> walking the backing
 * array up to the current size. Stack-allocated variant follows when
 * `stack ArrayStream<T>` aggregate-init on a generic instantiation
 * is verified.
 */
public class ArrayList<T> {
    T[] data;
    // Field name aligned with HashMap/HashSet/LinkedList — `count` as a
    // bare field name conflicts with the public `count()` accessor at
    // method resolution sites (templated-class dispatch ambiguity).
    int32 sizeCount;
    int32 capacity;

    public ArrayList() {
        this.capacity = 16;
        this.data = new T[16];
        this.sizeCount = 0;
    }

    public int32 count() {
        return this.sizeCount;
    }

    public boolean isEmpty() {
        return this.sizeCount == 0;
    }

    public T get(int32 i) {
        return this.data[i];
    }

    public void set(int32 i, T v) {
        this.data[i] = v;
    }

    public void add(T v) {
        if (this.sizeCount >= this.capacity) {
            int32 newCap = this.capacity * 2;
            T[] grown = new T[newCap];
            int32 i = 0;
            while (i < this.sizeCount) {
                grown[i] = this.data[i];
                i = i + 1;
            }
            // `#grown` transfers ownership of the fresh array storage
            // into `this.data` — without the marker, the local's
            // scope-exit drop would call __cajeta_free_array on the
            // array we just installed in the field, leaving `this.data`
            // pointing at freed storage. Subsequent `add`s would then
            // write into reclaimed memory. Same pattern HashMap.rehash
            // uses for `this.keys = #newKeys` et al.
            this.data = #grown;
            this.capacity = newCap;
        }
        this.data[this.sizeCount] = v;
        this.sizeCount = this.sizeCount + 1;
    }

    /**
     * Append every element of `other` onto this list (in iteration
     * order). Used as the combiner for `Collectors.toList<T>()` under
     * a parallel collect: each worker produces its own `ArrayList<T>`
     * partial, and the orchestrator combines them by appending right
     * onto left. Does NOT consume / move-out of `other` — the caller
     * still owns its list.
     */
    public void appendAll(ArrayList<T> other) {
        // Bind each element through a named local — array element
        // reads currently lower to a slot l-value in some contexts
        // (see ParallelDriver.combine workaround comment), so a
        // direct `this.add(other.data[i])` mistypes the second arg.
        int32 i = 0;
        while (i < other.sizeCount) {
            T v = other.data[i];
            this.add(v);
            i = i + 1;
        }
    }

    /**
     * Heap-allocated stream walking the live elements
     * (data[0..count-1]). Stack-allocated variant follows when
     * `stack ArrayStream<T>` aggregate-init on a generic
     * instantiation is verified.
     */
    public #ArrayStream<T> stream() {
        return heap ArrayStream<T>(this.data, this.sizeCount);
    }
}
