package cajeta.collection;

/**
 * Node in an in-memory `BPlusTree<K, V>`. A node is either a **leaf**
 * (holds keys + values + a `next` pointer to the following leaf) or an
 * **internal** node (holds separator keys + child pointers). All
 * user values live in leaves; internal nodes only route.
 *
 * Arrays are over-allocated by one slot (`order + 1` keys,
 * `order + 2` children) so an insert can temporarily overflow a full
 * node in place before `BPlusTree` splits it. `numKeys` is the live
 * key count; a leaf has `numKeys` values, an internal node has
 * `numKeys + 1` children.
 *
 * Separate top-level class (no nested classes yet), per the
 * `LinkedListNode` precedent; the tree owns its nodes and rewrites
 * these public fields directly during split/route. You rarely build
 * one by hand — `BPlusTree` allocates and links them for you — but
 * the shape is:
 *
 * ```cajeta
 * // A fresh, empty leaf root for an order-4 tree.
 * stack root = heap BPlusTreeNode<string, int32>(true, 4);
 * root.keys[0] = "alpha";
 * root.values[0] = 1;
 * root.numKeys = 1;
 *
 * // An internal router node holds separators + child links.
 * stack branch = heap BPlusTreeNode<string, int32>(false, 4);
 * branch.children[0] = root;
 * ```
 *
 * @See cajeta.collection.BPlusTree
 */
public final class BPlusTreeNode<K, V> {
    public boolean leaf;
    public int32 numKeys;
    public K[] keys;
    /** Leaf only: values parallel to `keys`. Null on internal nodes. */
    public V[] values;
    /** Leaf only: per-slot ownership bits (title-tracking §6) — bit0 = key
     *  owned, bit1 = value owned. Bits travel with their slots through
     *  shifts and splits; the node's teardown drops exactly the owned
     *  entries. Null on internal nodes (separators are routing BORROWS —
     *  a copy-up never takes a title). */
    public int8[] owned;
    /** Internal only: `numKeys + 1` child links. Null on leaves. */
    public BPlusTreeNode<K, V>[] children;
    /** Leaf only: next leaf in ascending order (range-scan thread). */
    public BPlusTreeNode<K, V> next;
    public BPlusTreeNode<K, V> parent;

    /**
     * Allocates an empty node sized for the tree's branching factor.
     * Pass `leaf = true` for a value-bearing leaf (allocates `values`,
     * leaves `children` null) or `false` for a router (allocates
     * `children`, leaves `values` null). Key/value/child arrays are
     * over-allocated by one slot so `BPlusTree` can overflow a full
     * node in place before splitting it; `numKeys` starts at `0`.
     *
     * ```cajeta
     * stack leaf = heap BPlusTreeNode<int32, string>(true, 4);   // holds up to 4 entries
     * stack branch = heap BPlusTreeNode<int32, string>(false, 4); // routes via child links
     * ```
     */
    public BPlusTreeNode(boolean leaf, int32 order) {
        this.leaf = leaf;
        this.numKeys = 0;
        this.keys = heap K[order + 1];
        if (leaf) {
            this.values = heap V[order + 1];
            this.owned = heap int8[order + 1];   // calloc 0 = all borrowed
            this.children = null;
        } else {
            this.values = null;
            this.owned = null;
            this.children = heap BPlusTreeNode<K, V>[order + 2];
        }
        this.next = null;
        this.parent = null;
    }

    // Drop the keys/values this leaf OWNS (took via `#`) before the auto
    // field-drops free the arrays. Borrowed slots are left alone. Internal
    // nodes hold only routing borrows — nothing to do.
    ~BPlusTreeNode() {
        if (this.leaf) {
            int32 k = 0;
            while (k < this.numKeys) {
                if ((this.owned[k] & 1) != 0) {
                    Cajeta.dropValue(this.keys[k]);
                }
                if ((this.owned[k] & 2) != 0) {
                    Cajeta.dropValue(this.values[k]);
                }
                k = k + 1;
            }
        }
    }
}
