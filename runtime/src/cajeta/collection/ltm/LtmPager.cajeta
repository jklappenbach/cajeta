package cajeta.collection.ltm;

import cajeta.error.RecoverableException;
import cajeta.lang.String;
import cajeta.wire.BufferEncoder;
import cajeta.wire.Encoder;
import cajeta.io.file.File;
import cajeta.io.file.OpenMode;

/**
 * Fixed-size, file-backed buffer pool for the disk-backed
 * `BPlusTree`. This is the piece that makes the
 * tree **larger-than-memory**: at most `capacity` node pages are
 * resident at once, no matter how big the tree grows on disk.
 *
 * ## Pages
 *
 * The file is a sequence of fixed-size pages. Page 0 is the header
 * (magic, order, root page id, allocation high-water, entry count);
 * pages >= 1 each hold one serialized node. A node references its
 * children by page id (`int64`), never by pointer, so a child stays on
 * disk while its parent is resident and vice-versa.
 *
 * ## Eviction and "freeing"
 *
 * Frames are looked up by page id. On a miss the pager picks a victim
 * (the least-recently-used *unpinned* frame), writes it back if dirty,
 * and **reassigns the frame slot to the freshly read node** — that
 * reassignment is the drop: Cajeta releases the evicted image by
 * overwriting its owning reference (no `delete`/`free`). Pinning keeps
 * the frames an in-flight operation is still touching (a B+ tree's
 * root-to-leaf path during a split) from being chosen as a victim.
 *
 * ## Serialization
 *
 * Keys and values are turned into bytes by caller-supplied
 * `Encoder``<K>` / `Encoder``<V>`, length-prefixed so variable-width
 * encodings round-trip. A node must serialize within one page; choose
 * `order` so `order + 1` max-size entries fit `pageSize`.
 *
 * ## Usage
 *
 * Open the page file, allocate a root node, descend through `fetch`, and
 * `flush` to persist dirty frames plus the header. Each resident page is
 * an `LtmBPlusTreeNode`.
 *
 * ```cajeta
 * // String -> int64 index: order 128, 4 KB pages, 64 resident frames.
 * LtmPager<String, int64> pager = heap LtmPager<String, int64>(
 *         "/var/db/index.ltm", keyEnc, valEnc, 128, 4096, 64);
 * LtmBPlusTreeNode<String, int64> root = pager.allocNode(true);
 * pager.setRoot(root.pageId);
 *
 * // Re-read the root frame, mark it dirty, and persist everything.
 * LtmBPlusTreeNode<String, int64> r = pager.fetch(pager.getRoot());
 * pager.markDirty(r.pageId);
 * pager.flush();
 * ```
 *
 * ## See also
 *
 * `BPlusTree`, `LtmBPlusTreeNode`, `Encoder`.
 */
public class LtmPager<K, V> {

    private File file;
    private Encoder<K> keyEnc;
    private Encoder<V> valEnc;
    /** Optional allocation-free encoders (plan 10.2.4); null → the
     *  allocating `Encoder` path. Set via {@link #setBufferEncoders}. */
    private BufferEncoder<K> keyFast;
    private BufferEncoder<V> valFast;

    private int32 order;
    private int32 pageSize;

    private int64 rootPageId;
    private int64 nextPageId;
    private int64 entryCount;

    // Buffer pool: parallel arrays indexed by frame. `framePageId[i] ==
    // -1` marks an empty frame; `frameNode[i]` is null until populated.
    private int32 capacity;
    private int64[] framePageId;
    private LtmBPlusTreeNode<K, V>[] frameNode;
    private boolean[] frameDirty;
    private int32[] framePins;
    private int64[] frameUsed;
    private int64 clock;

    /**
     * Open (or create) the page file at `path` and bring up a buffer
     * pool of `capacity` frames. An empty file is initialized with a
     * fresh header; an existing file's header supplies the live
     * `rootPageId`, `nextPageId`, and `entryCount`. Keys and values are
     * (de)serialized through the caller-supplied `Encoder`s, and the
     * opened `File` is moved into the pager so it stays open for the
     * pager's lifetime.
     *
     * ```cajeta
     * // String -> int64 index: order 128, 4 KB pages, 64 resident frames.
     * LtmPager<String, int64> pager = heap LtmPager<String, int64>(
     *         "/var/db/index.ltm", keyEnc, valEnc, 128, 4096, 64);
     * LtmBPlusTreeNode<String, int64> root = pager.allocNode(true);
     * pager.setRoot(root.pageId);
     * pager.flush();
     * ```
     */
    public LtmPager(String path, Encoder<K> keyEnc, Encoder<V> valEnc,
                    int32 order, int32 pageSize, int32 capacity) {
        // `#=`: the pager keeps its encoders for its life; the slot
        // records the caller's lend/transfer choice (§2.3).
        this.keyEnc #= keyEnc;
        this.valEnc #= valEnc;
        this.keyFast = null;
        this.valFast = null;
        this.pageSize = pageSize;
        this.capacity = capacity;
        this.clock = 0;

        // Move the opened File into the field: a plain `this.file = f`
        // leaves `f` owned by this ctor scope, so its drop fires at ctor
        // exit and closes the fd the pager still needs (use-after-free).
        File f #= File.open(path, OpenMode.READ_WRITE);
        this.file #= f;
        int64 sz = this.file.size();
        if (sz == 0) {
            this.order = order;
            this.rootPageId = -1;
            this.nextPageId = 1;
            this.entryCount = 0;
        } else {
            // order / root / next / entry come from the on-disk header.
            this.order = order;
            this.readHeader();
        }

        this.framePageId = heap int64[capacity];
        this.frameNode = heap LtmBPlusTreeNode<K, V>[capacity];
        this.frameDirty = heap boolean[capacity];
        this.framePins = heap int32[capacity];
        this.frameUsed = heap int64[capacity];
        int32 i = 0;
        while (i < capacity) {
            this.framePageId[i] = -1;
            this.frameNode[i] = null;
            this.frameDirty[i] = false;
            this.framePins[i] = 0;
            this.frameUsed[i] = 0;
            i = i + 1;
        }

        if (sz == 0) {
            this.writeHeader();
        }
    }

    // ----- public surface used by the tree -----------------------------

    public int32 getOrder() {
        return this.order;
    }

    public int64 getRoot() {
        return this.rootPageId;
    }

    public void setRoot(int64 pageId) {
        this.rootPageId = pageId;
    }

    public int64 getEntryCount() {
        return this.entryCount;
    }

    /** Bump the live entry count by one (call after inserting a new key). */
    public void incEntryCount() {
        this.entryCount = this.entryCount + 1;
    }

    /** Drop the live entry count by one (call after tombstoning a key). */
    public void decEntryCount() {
        this.entryCount = this.entryCount - 1;
    }

    /**
     * Install allocation-free encoders (plan 10.2.4): `serializeNode`
     * writes each entry with `encodeInto` — zero per-entry allocations —
     * instead of `Encoder.encode`'s fresh buffer per entry. The
     * allocating path stays for pagers without them (10.1.8).
     */
    public void setBufferEncoders(BufferEncoder<K> keyFast,
            BufferEncoder<V> valFast) {
        // `#=`: same slot model as the ctor's encoder holds (§2.3).
        this.keyFast #= keyFast;
        this.valFast #= valFast;
    }

    /**
     * Resident `LtmBPlusTreeNode` for `pageId`, reading +
     * deserializing on a miss (which may evict an unpinned LRU frame).
     * The returned frame is unpinned — `pin` it first if a multi-step
     * operation (a split) must keep it resident.
     *
     * ```cajeta
     * LtmBPlusTreeNode<K, V> n = pager.fetch(pager.getRoot());
     * pager.pin(n.pageId);
     * // ... descend / mutate / split ...
     * pager.markDirty(n.pageId);
     * pager.unpin(n.pageId);
     * ```
     */
    public LtmBPlusTreeNode<K, V> fetch(int64 pageId) {
        int32 hit = this.findFrame(pageId);
        if (hit >= 0) {
            this.touchFrame(hit);
            LtmBPlusTreeNode<K, V> n = this.frameNode[hit];
            return n;
        }
        int32 idx = this.acquireFrame();
        // Bind pageSize through a local before the (int64) cast: casting a
        // field read directly leaves the operand an l-value (slot pointer),
        // which lowers to `sext ptr` and fails verification.
        int32 psz = this.pageSize;
        int64 ps = (int64) psz;
        int8[] buf = heap int8[psz];
        int64 off = pageId * ps;
        this.file.seek(off);
        this.file.read(buf, 0, ps);
        LtmBPlusTreeNode<K, V> node #= this.deserializeNode(pageId, buf);
        this.frameNode[idx] #= node;
        this.framePageId[idx] = pageId;
        this.frameDirty[idx] = false;
        this.framePins[idx] = 0;
        this.touchFrame(idx);
        LtmBPlusTreeNode<K, V> ret = this.frameNode[idx];
        return ret;
    }

    /**
     * Allocate a brand-new page, resident and dirty, and return its
     * `LtmBPlusTreeNode`. The new node's `pageId` is drawn from
     * `nextPageId`; pass `true` for a leaf, `false` for an internal
     * node. Call `setRoot` after creating the first node.
     *
     * ```cajeta
     * LtmBPlusTreeNode<K, V> leaf = pager.allocNode(true);
     * pager.setRoot(leaf.pageId);
     * ```
     */
    public LtmBPlusTreeNode<K, V> allocNode(boolean leaf) {
        int64 pageId = this.nextPageId;
        this.nextPageId = this.nextPageId + 1;
        int32 idx = this.acquireFrame();
        LtmBPlusTreeNode<K, V> node = heap LtmBPlusTreeNode<K, V>(pageId, leaf, this.order);
        this.frameNode[idx] #= node;
        this.framePageId[idx] = pageId;
        this.frameDirty[idx] = true;
        this.framePins[idx] = 0;
        this.touchFrame(idx);
        LtmBPlusTreeNode<K, V> ret = this.frameNode[idx];
        return ret;
    }

    /** Mark the frame for `pageId` dirty so it is written back on eviction or `flush`. No-op if not resident. */
    public void markDirty(int64 pageId) {
        int32 idx = this.findFrame(pageId);
        if (idx >= 0) {
            this.frameDirty[idx] = true;
        }
    }

    /** Pin the frame for `pageId` so eviction will not choose it as a victim. No-op if not resident; balance each pin with `unpin`. */
    public void pin(int64 pageId) {
        int32 idx = this.findFrame(pageId);
        if (idx >= 0) {
            this.framePins[idx] = this.framePins[idx] + 1;
        }
    }

    /** Release one pin on the frame for `pageId`. No-op if not resident or already at zero pins. */
    public void unpin(int64 pageId) {
        int32 idx = this.findFrame(pageId);
        if (idx >= 0 && this.framePins[idx] > 0) {
            this.framePins[idx] = this.framePins[idx] - 1;
        }
    }

    /** Flush every dirty resident page plus the header to disk. */
    public void flush() {
        int32 i = 0;
        while (i < this.capacity) {
            if (this.framePageId[i] != -1 && this.frameDirty[i]) {
                this.writeFrame(i);
            }
            i = i + 1;
        }
        this.writeHeader();
        this.file.sync();
    }

    /** Flush all dirty pages and the header, then close the backing `File`. */
    public void close() {
        this.flush();
        this.file.close();
    }

    // ----- buffer-pool internals ---------------------------------------

    /** Frame index currently holding `pageId`, or `-1` if not resident. */
    private int32 findFrame(int64 pageId) {
        int32 i = 0;
        while (i < this.capacity) {
            if (this.framePageId[i] == pageId) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** Stamp frame `idx` as most-recently-used for LRU eviction. */
    private void touchFrame(int32 idx) {
        this.clock = this.clock + 1;
        this.frameUsed[idx] = this.clock;
    }

    /**
     * A free frame, or the LRU unpinned victim (written back if dirty).
     * The victim's node image is released when `fetch` / `allocNode`
     * reassigns `frameNode[idx]` to the replacement.
     */
    private int32 acquireFrame() {
        int32 i = 0;
        while (i < this.capacity) {
            if (this.framePageId[i] == -1) {
                return i;
            }
            i = i + 1;
        }
        int32 victim = -1;
        int64 best = 0;
        boolean haveBest = false;
        i = 0;
        while (i < this.capacity) {
            if (this.framePins[i] == 0) {
                if (haveBest == false || this.frameUsed[i] < best) {
                    best = this.frameUsed[i];
                    victim = i;
                    haveBest = true;
                }
            }
            i = i + 1;
        }
        if (victim == -1) {
            // Every frame is pinned: the pool is smaller than one
            // operation's working set (a put pins its whole root-to-leaf
            // path, so capacity must exceed the tree's depth). Fail
            // loudly — the -1 would otherwise corrupt the frame tables.
            throw heap RecoverableException("ltm pager: all " + this.capacity
                + " frames are pinned; capacity must exceed the tree depth");
        }
        if (this.frameDirty[victim]) {
            this.writeFrame(victim);
        }
        this.framePageId[victim] = -1;
        this.frameDirty[victim] = false;
        return victim;
    }

    /** Serialize frame `idx`'s node to its page offset and clear the dirty flag. */
    private void writeFrame(int32 idx) {
        LtmBPlusTreeNode<K, V> node = this.frameNode[idx];
        int8[] buf #= this.serializeNode(node);
        int32 psz = this.pageSize;
        int64 ps = (int64) psz;
        int64 off = node.pageId * ps;
        this.file.seek(off);
        this.file.write(buf, 0, ps);
        this.frameDirty[idx] = false;
    }

    // ----- header ------------------------------------------------------

    /** Write page 0: magic, `order`, root page id, next page id, and entry count. */
    private void writeHeader() {
        int32 psz = this.pageSize;
        int64 ps = (int64) psz;
        int8[] buf = heap int8[psz];
        this.putI32(buf, 0, 0x42504C54);
        this.putI32(buf, 4, this.order);
        this.putI64(buf, 8, this.rootPageId);
        this.putI64(buf, 16, this.nextPageId);
        this.putI64(buf, 24, this.entryCount);
        this.file.seek(0);
        this.file.write(buf, 0, ps);
    }

    /** Load `order`, root page id, next page id, and entry count from page 0. */
    private void readHeader() {
        int32 psz = this.pageSize;
        int64 ps = (int64) psz;
        int8[] buf = heap int8[psz];
        this.file.seek(0);
        this.file.read(buf, 0, ps);
        this.order = this.getI32(buf, 4);
        this.rootPageId = this.getI64(buf, 8);
        this.nextPageId = this.getI64(buf, 16);
        this.entryCount = this.getI64(buf, 24);
    }

    // ----- node (de)serialization --------------------------------------

    /**
     * Pack `node` into one `pageSize` page: leaf byte, key count,
     * next-leaf id, then length-prefixed keys, followed by length-prefixed
     * values (leaf) or `numKeys + 1` child page ids (internal). Keys and
     * values are encoded with the `Encoder`s; the node must fit one page.
     */
    private #int8[] serializeNode(LtmBPlusTreeNode<K, V> node) {
        int32 psz = this.pageSize;
        int8[] buf = heap int8[psz];
        // Leaf pages write format 2: tombstone bytes follow the values
        // (plan 10.2.1). Format-1 leaves (pre-tombstone files) are still
        // READ (all entries alive); everything writes the new format.
        int32 leafByte = 0;
        if (node.leaf) {
            leafByte = 2;
        }
        buf[0] = (int8) leafByte;
        this.putI32(buf, 1, node.numKeys);
        this.putI64(buf, 5, node.nextLeafId);
        int32 p = 13;
        int32 i = 0;
        while (i < node.numKeys) {
            int32 klen = 0;
            if (this.keyFast != null) {
                // Allocation-free per-entry path (plan 10.2.4).
                klen = this.keyFast.encodeInto(node.keys[i], buf, p + 4);
            } else {
                K k = node.keys[i];
                int8[] kb #= this.keyEnc.encode(k);
                klen = (int32) kb.count();
                int32 j = 0;
                while (j < klen) {
                    buf[p + 4 + j] = kb[j];
                    j = j + 1;
                }
            }
            this.putI32(buf, p, klen);
            p = p + 4 + klen;
            i = i + 1;
        }
        if (node.leaf) {
            i = 0;
            while (i < node.numKeys) {
                int32 vlen = 0;
                if (this.valFast != null) {
                    vlen = this.valFast.encodeInto(node.values[i], buf, p + 4);
                } else {
                    V v = node.values[i];
                    int8[] vb #= this.valEnc.encode(v);
                    vlen = (int32) vb.count();
                    int32 j = 0;
                    while (j < vlen) {
                        buf[p + 4 + j] = vb[j];
                        j = j + 1;
                    }
                }
                this.putI32(buf, p, vlen);
                p = p + 4 + vlen;
                i = i + 1;
            }
            i = 0;
            while (i < node.numKeys) {
                int32 db = 0;
                if (node.dead[i]) {
                    db = 1;
                }
                buf[p] = (int8) db;
                p = p + 1;
                i = i + 1;
            }
        } else {
            int32 nc = node.numKeys + 1;
            i = 0;
            while (i < nc) {
                int64 cid = node.childIds[i];
                this.putI64(buf, p, cid);
                p = p + 8;
                i = i + 1;
            }
        }
        return #buf;
    }

    /** Rebuild the `LtmBPlusTreeNode` stored in `buf` for `pageId`, mirroring `serializeNode`; the result is marked clean. */
    private #LtmBPlusTreeNode<K, V> deserializeNode(int64 pageId, int8[] buf) {
        int32 leafByte = (int32) buf[0];
        boolean leaf = false;
        if (leafByte == 1 || leafByte == 2) {
            leaf = true;
        }
        int32 numKeys = this.getI32(buf, 1);
        int64 nextLeafId = this.getI64(buf, 5);
        LtmBPlusTreeNode<K, V> node = heap LtmBPlusTreeNode<K, V>(pageId, leaf, this.order);
        node.numKeys = numKeys;
        node.nextLeafId = nextLeafId;
        int32 p = 13;
        int32 i = 0;
        while (i < numKeys) {
            int32 klen = this.getI32(buf, p);
            p = p + 4;
            int8[] kslice = heap int8[klen];
            int32 j = 0;
            while (j < klen) {
                kslice[j] = buf[p + j];
                j = j + 1;
            }
            p = p + klen;
            K k #= this.keyEnc.decode(kslice);
            node.keys[i] = k;
            i = i + 1;
        }
        if (leaf) {
            i = 0;
            while (i < numKeys) {
                int32 vlen = this.getI32(buf, p);
                p = p + 4;
                int8[] vslice = heap int8[vlen];
                int32 j = 0;
                while (j < vlen) {
                    vslice[j] = buf[p + j];
                    j = j + 1;
                }
                p = p + vlen;
                V v #= this.valEnc.decode(vslice);
                node.values[i] = v;
                i = i + 1;
            }
            if (leafByte == 2) {
                i = 0;
                while (i < numKeys) {
                    node.dead[i] = ((int32) buf[p]) == 1;
                    p = p + 1;
                    i = i + 1;
                }
            }
        } else {
            int32 nc = numKeys + 1;
            i = 0;
            while (i < nc) {
                int64 cid = this.getI64(buf, p);
                node.childIds[i] = cid;
                p = p + 8;
                i = i + 1;
            }
        }
        node.dirty = false;
        return #node;
    }

    // ----- little-endian byte codec ------------------------------------

    /** Write `v` little-endian into `b` at `off` (4 bytes). */
    private void putI32(int8[] b, int32 off, int32 v) {
        b[off] = (int8) (v & 0xFF);
        b[off + 1] = (int8) ((v >> 8) & 0xFF);
        b[off + 2] = (int8) ((v >> 16) & 0xFF);
        b[off + 3] = (int8) ((v >> 24) & 0xFF);
    }

    /** Read a 4-byte little-endian `int32` from `b` at `off`. */
    private int32 getI32(int8[] b, int32 off) {
        int32 b0 = ((int32) b[off]) & 0xFF;
        int32 b1 = ((int32) b[off + 1]) & 0xFF;
        int32 b2 = ((int32) b[off + 2]) & 0xFF;
        int32 b3 = ((int32) b[off + 3]) & 0xFF;
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    /** Write `v` little-endian into `b` at `off` (8 bytes). */
    private void putI64(int8[] b, int32 off, int64 v) {
        b[off] = (int8) (v & 0xFF);
        b[off + 1] = (int8) ((v >> 8) & 0xFF);
        b[off + 2] = (int8) ((v >> 16) & 0xFF);
        b[off + 3] = (int8) ((v >> 24) & 0xFF);
        b[off + 4] = (int8) ((v >> 32) & 0xFF);
        b[off + 5] = (int8) ((v >> 40) & 0xFF);
        b[off + 6] = (int8) ((v >> 48) & 0xFF);
        b[off + 7] = (int8) ((v >> 56) & 0xFF);
    }

    /** Read an 8-byte little-endian `int64` from `b` at `off`. */
    private int64 getI64(int8[] b, int32 off) {
        int64 r = 0;
        r = r | (((int64) b[off]) & 0xFF);
        r = r | ((((int64) b[off + 1]) & 0xFF) << 8);
        r = r | ((((int64) b[off + 2]) & 0xFF) << 16);
        r = r | ((((int64) b[off + 3]) & 0xFF) << 24);
        r = r | ((((int64) b[off + 4]) & 0xFF) << 32);
        r = r | ((((int64) b[off + 5]) & 0xFF) << 40);
        r = r | ((((int64) b[off + 6]) & 0xFF) << 48);
        r = r | ((((int64) b[off + 7]) & 0xFF) << 56);
        return r;
    }
}
