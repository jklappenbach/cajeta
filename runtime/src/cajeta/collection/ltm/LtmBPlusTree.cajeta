package cajeta.collection.ltm;

import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import cajeta.wire.BufferEncoder;
import cajeta.wire.Encoder;

/**
 * Disk-backed, **larger-than-memory** ordered map: the same B+ tree
 * shape as `cajeta.collection.BPlusTree`, but every node lives on disk
 * as a page and is paged in on demand by an `LtmPager`. Only `capacity`
 * pages are resident at once, so the map can far exceed RAM.
 *
 * ## Construction
 *
 * `heap LtmBPlusTree(path, keyEnc, valEnc, order, capacity)` opens (or
 * creates) the index file at `path`. A fresh file is initialized with
 * the given `order`; an existing one is reopened from its header (the
 * stored order wins). `keyEnc` / `valEnc` turn keys and values into
 * bytes — see `cajeta.wire.Encoder`. Always `close()` (or at least
 * `flush()`) to make writes durable.
 *
 * ## Ordering
 *
 * Keys are ordered by `<` / `>` on `K`, like `cajeta.collection.BPlusTree`
 * and `cajeta.lang.Math`. Primitive K works today; class K needs
 * `operator<` / `operator>` (the v1 limitation).
 *
 * ## Surface
 *
 * `put` / `get` / `containsKey` / `remove` / `min` / `count` /
 * `isEmpty` / `scan` / `scanFrom` / `compact` / `flush` / `close`.
 * Misses return the type's zero value.
 *
 * **Deletion** is tombstone-based (cajeta-llama plan 10.2.1; spec
 * 13.17): `remove` marks the entry dead in place — no page merging or
 * underflow rebalancing — and every read path skips dead entries.
 * Space comes back through {@link #compact}, which rewrites the index
 * without its tombstones. **Ordered iteration** walks the leaf chain
 * through the pager (`scan` / `scanFrom` return an {@link LtmCursor}),
 * so a scan far larger than the resident pool pages in and out as it
 * goes.
 *
 * ## Memory discipline
 *
 * `put` records the root-to-leaf path and pins those pages while it
 * works, so a split that allocates new pages can't evict the nodes it
 * is still editing. Reads hold no page across a `fetch`, so they need
 * no pinning. Eviction "frees" a page by reassigning its frame slot —
 * Cajeta's drop-by-assignment, no `delete`/`free`.
 *
 * @See cajeta.collection.ltm.LtmPager
 * @See cajeta.collection.BPlusTree
 */
public final class LtmBPlusTree<K, V> {

    private LtmPager<K, V> pager;
    // Retained for compact(): the encoders are borrows (caller keeps
    // ownership for the tree's lifetime); the path is an owned copy.
    private Encoder<K> keyEncB;
    private Encoder<V> valEncB;
    private BufferEncoder<K> keyFastB;
    private BufferEncoder<V> valFastB;
    private String pathStr;
    private int32 orderN;
    private int32 capacityN;

    /**
     * Open (or create) the disk index at `path`. A new file is laid out
     * with branching factor `order`; an existing file is reopened from
     * its header and the stored order wins. `keyEnc` / `valEnc` are the
     * `Encoder`s that serialize keys and values; `capacity` caps the
     * number of resident pages. Always `close()` to flush durably.
     *
     * ```cajeta
     * heap LtmBPlusTree<int64, String> idx =
     *     heap LtmBPlusTree<int64, String>("/data/users.idx", keyEnc, valEnc, 128, 256);
     * idx.put(42, "alice");
     * String name = idx.get(42);   // "alice"
     * idx.close();                 // durable
     * ```
     *
     * @EntryPoint
     */
    public LtmBPlusTree(String path, Encoder<K> keyEnc, Encoder<V> valEnc,
                        int32 order, int32 capacity) {
        this.pager = heap LtmPager<K, V>(path, keyEnc, valEnc, order, 4096, capacity);
        // `#=`: the tree keeps its encoders for its life; the slot
        // records the caller's lend/transfer choice (§2.3). The pager
        // above was handed a LEND of the same encoders and its own
        // slots record that — it never outlives this tree.
        this.keyEncB #= keyEnc;
        this.valEncB #= valEnc;
        this.keyFastB = null;
        this.valFastB = null;
        this.pathStr = "" + path;
        this.orderN = order;
        this.capacityN = capacity;
    }

    /**
     * The buffer-encoder form (plan 10.2.4): `keyFast` / `valFast` must
     * produce byte-identical encodings to `keyEnc` / `valEnc`; page
     * serialization then allocates nothing per entry. The allocating
     * constructor above is unchanged (10.1.8).
     */
    public LtmBPlusTree(String path, Encoder<K> keyEnc, Encoder<V> valEnc,
                        BufferEncoder<K> keyFast, BufferEncoder<V> valFast,
                        int32 order, int32 capacity) {
        this.pager = heap LtmPager<K, V>(path, keyEnc, valEnc, order, 4096, capacity);
        this.pager.setBufferEncoders(keyFast, valFast);
        // Same `#=` slot model as the allocating ctor above.
        this.keyEncB #= keyEnc;
        this.valEncB #= valEnc;
        this.keyFastB #= keyFast;
        this.valFastB #= valFast;
        this.pathStr = "" + path;
        this.orderN = order;
        this.capacityN = capacity;
    }

    @Inline
    public int64 count() {
        return this.pager.getEntryCount();
    }

    /** True when no entries have been inserted (the index has no root page yet). */
    @Inline
    public boolean isEmpty() {
        return this.pager.getRoot() == -1;
    }

    /** Write all dirty resident pages to disk without closing the file. */
    public void flush() {
        this.pager.flush();
    }

    /** Flush and release the underlying file; call before discarding the index. */
    public void close() {
        this.pager.close();
    }

    /**
     * Insert or update the entry for `key`. O(log n). Splits the leaf
     * (cascading up to a new root) when a node overflows.
     */
    public void put(K key, V value) {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            LtmBPlusTreeNode<K, V> r = this.pager.allocNode(true);
            r.keys[0] #= key;
            r.values[0] #= value;
            r.numKeys = 1;
            this.pager.markDirty(r.pageId);
            this.pager.setRoot(r.pageId);
            this.pager.incEntryCount();
            return;
        }

        // Descend to the target leaf, pinning each page on the path so a
        // later allocNode (split) can't evict the working set.
        int64[] path = heap int64[64];
        int32 depth = 0;
        int64 cur = rootId;
        boolean atLeaf = false;
        while (atLeaf == false) {
            LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
            this.pager.pin(cur);
            path[depth] = cur;
            depth = depth + 1;
            if (node.leaf) {
                atLeaf = true;
            } else {
                int32 i = 0;
                while (i < node.numKeys && (key < node.keys[i]) == false) {
                    i = i + 1;
                }
                cur = node.childIds[i];
            }
        }

        int64 leafId = path[depth - 1];
        LtmBPlusTreeNode<K, V> leaf = this.pager.fetch(leafId);
        int32 pos = 0;
        while (pos < leaf.numKeys && leaf.keys[pos] < key) {
            pos = pos + 1;
        }
        boolean updated = false;
        if (pos < leaf.numKeys) {
            // keys[pos] >= key; equal iff not (key < keys[pos]).
            if ((key < leaf.keys[pos]) == false) {
                if (leaf.dead[pos]) {
                    // Revive a tombstoned key (plan 10.2.1).
                    leaf.dead[pos] = false;
                    this.pager.incEntryCount();
                }
                leaf.values[pos] = value;
                this.pager.markDirty(leafId);
                updated = true;
            }
        }
        if (updated == false) {
            int32 j = leaf.numKeys;
            while (j > pos) {
                leaf.keys[j] = leaf.keys[j - 1];
                leaf.values[j] = leaf.values[j - 1];
                leaf.dead[j] = leaf.dead[j - 1];
                j = j - 1;
            }
            leaf.keys[pos] #= key;
            leaf.values[pos] #= value;
            leaf.dead[pos] = false;
            leaf.numKeys = leaf.numKeys + 1;
            this.pager.markDirty(leafId);
            this.pager.incEntryCount();
            int32 order = this.pager.getOrder();
            if (leaf.numKeys > order) {
                this.splitLeaf(path, depth);
            }
        }

        int32 u = 0;
        while (u < depth) {
            // Bind the array element through a local before passing it —
            // a direct unpin(path[u]) lowers the read to a slot l-value and
            // mistypes the argument (same workaround as ArrayList.appendAll).
            int64 pid = path[u];
            this.pager.unpin(pid);
            u = u + 1;
        }
    }

    /**
     * Value bound to `key`, or the type's zero value if absent.
     */
    public V get(K key) {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            V[] miss = heap V[1];
            return miss[0];
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            int32 i = 0;
            while (i < node.numKeys && (key < node.keys[i]) == false) {
                i = i + 1;
            }
            cur = node.childIds[i];
            node = this.pager.fetch(cur);
        }
        int32 i = 0;
        while (i < node.numKeys) {
            if ((key < node.keys[i]) == false && (node.keys[i] < key) == false) {
                if (node.dead[i]) {
                    V[] gone = heap V[1];
                    return gone[0];
                }
                V v = node.values[i];
                return v;
            }
            i = i + 1;
        }
        V[] miss = heap V[1];
        return miss[0];
    }

    /**
     * @returns true iff `key` is present.
     */
    public boolean containsKey(K key) {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            return false;
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            int32 i = 0;
            while (i < node.numKeys && (key < node.keys[i]) == false) {
                i = i + 1;
            }
            cur = node.childIds[i];
            node = this.pager.fetch(cur);
        }
        int32 i = 0;
        while (i < node.numKeys) {
            if ((key < node.keys[i]) == false && (node.keys[i] < key) == false) {
                return node.dead[i] == false;
            }
            i = i + 1;
        }
        return false;
    }

    /**
     * Tombstone the entry for `key` (plan 10.2.1; spec 13.17): the key
     * becomes absent to `get`/`containsKey`/scans and `count` drops, but
     * no page merging happens — {@link #compact} reclaims the space.
     * Returns whether a live entry was removed. O(log n).
     */
    public boolean remove(K key) {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            return false;
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            int32 i = 0;
            while (i < node.numKeys && (key < node.keys[i]) == false) {
                i = i + 1;
            }
            cur = node.childIds[i];
            node = this.pager.fetch(cur);
        }
        int32 i = 0;
        while (i < node.numKeys) {
            if ((key < node.keys[i]) == false && (node.keys[i] < key) == false) {
                if (node.dead[i]) {
                    return false;
                }
                node.dead[i] = true;
                this.pager.markDirty(cur);
                this.pager.decEntryCount();
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /**
     * Smallest key, or the type's zero value if empty.
     */
    public K min() {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            K[] miss = heap K[1];
            return miss[0];
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            cur = node.childIds[0];
            node = this.pager.fetch(cur);
        }
        // Skip tombstones, following the leaf chain if a whole leaf died.
        while (true) {
            int32 i = 0;
            while (i < node.numKeys) {
                if (node.dead[i] == false) {
                    K kmin = node.keys[i];
                    return kmin;
                }
                i = i + 1;
            }
            if (node.nextLeafId == -1) {
                K[] miss = heap K[1];
                return miss[0];
            }
            node = this.pager.fetch(node.nextLeafId);
        }
    }

    /**
     * Ordered cursor over every LIVE entry, ascending (plan 10.2.3).
     * The cursor reads through the pager — a scan larger than the
     * resident pool pages in and out mid-walk — and is valid only while
     * this tree is open and unmodified.
     */
    public #LtmCursor<K, V> scan() {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            return heap LtmCursor<K, V>(this.pager, -1, 0);
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            cur = node.childIds[0];
            node = this.pager.fetch(cur);
        }
        LtmCursor<K, V> c = heap LtmCursor<K, V>(this.pager, cur, 0);
        c.settle();
        return #c;
    }

    /**
     * Ordered cursor positioned at the first live entry with key AT OR
     * AFTER `key` (plan 10.2.3; 10.1.5).
     */
    public #LtmCursor<K, V> scanFrom(K key) {
        int64 rootId = this.pager.getRoot();
        if (rootId == -1) {
            return heap LtmCursor<K, V>(this.pager, -1, 0);
        }
        int64 cur = rootId;
        LtmBPlusTreeNode<K, V> node = this.pager.fetch(cur);
        while (node.leaf == false) {
            int32 i = 0;
            while (i < node.numKeys && (key < node.keys[i]) == false) {
                i = i + 1;
            }
            cur = node.childIds[i];
            node = this.pager.fetch(cur);
        }
        int32 pos = 0;
        while (pos < node.numKeys && node.keys[pos] < key) {
            pos = pos + 1;
        }
        LtmCursor<K, V> c = heap LtmCursor<K, V>(this.pager, cur, pos);
        c.settle();
        return #c;
    }

    /**
     * Rewrite the index without its tombstones (plan 10.2.2): stream the
     * live entries in order into a scratch file (`path + ".compact"`),
     * byte-copy the result back over this file, and reopen. Bounded
     * memory — both trees run through capped pagers. The scratch file is
     * left truncated to zero bytes (no delete syscall in the File
     * surface).
     */
    public void compact() {
        String scratch = this.pathStr + ".compact";
        // Truncate any stale scratch, then build the compacted tree.
        File t0 #= File.open(scratch, OpenMode.WRITE);
        t0.close();
        LtmBPlusTree<K, V> fresh = heap LtmBPlusTree<K, V>(scratch,
            this.keyEncB, this.valEncB, this.orderN, this.capacityN);
        if (this.keyFastB != null) {
            fresh.pager.setBufferEncoders(this.keyFastB, this.valFastB);
        }
        LtmCursor<K, V> cur #= this.scan();
        while (cur.valid()) {
            fresh.put(cur.key(), cur.value());
            cur.next();
        }
        fresh.close();
        this.pager.close();
        // Byte-copy scratch → path (truncating), then empty the scratch.
        File src #= File.open(scratch, OpenMode.READ);
        File dst #= File.open(this.pathStr, OpenMode.WRITE);
        int8[] buf = heap int8[65536];
        int64 n = src.read(buf, 0, 65536);
        while (n > 0) {
            dst.write(buf, 0, n);
            n = src.read(buf, 0, 65536);
        }
        src.close();
        dst.close();
        File t1 #= File.open(scratch, OpenMode.WRITE);
        t1.close();
        this.pager #= heap LtmPager<K, V>(this.pathStr, this.keyEncB,
            this.valEncB, this.orderN, 4096, this.capacityN);
        if (this.keyFastB != null) {
            this.pager.setBufferEncoders(this.keyFastB, this.valFastB);
        }
    }

    // ----- internals ---------------------------------------------------

    /** Split the overflowed leaf at the bottom of `path` and copy up. */
    private void splitLeaf(int64[] path, int32 depth) {
        int64 leafId = path[depth - 1];
        LtmBPlusTreeNode<K, V> leaf = this.pager.fetch(leafId);
        int32 total = leaf.numKeys;
        int32 mid = total / 2;
        LtmBPlusTreeNode<K, V> right = this.pager.allocNode(true);
        int64 rightId = right.pageId;
        right.numKeys = total - mid;
        int32 k = 0;
        while (k < right.numKeys) {
            right.keys[k] = leaf.keys[mid + k];
            right.values[k] = leaf.values[mid + k];
            right.dead[k] = leaf.dead[mid + k];
            k = k + 1;
        }
        leaf.numKeys = mid;
        right.nextLeafId = leaf.nextLeafId;
        leaf.nextLeafId = rightId;
        this.pager.markDirty(leafId);
        this.pager.markDirty(rightId);
        K sep = right.keys[0];
        this.insertIntoParent(path, depth, sep, rightId);
    }

    /**
     * Insert separator `upKey` and the new right child `rightId` above
     * the node at `path[depth-1]`, creating a new root or cascading
     * internal splits up the pinned path as needed.
     */
    private void insertIntoParent(int64[] path, int32 depth, K upKey, int64 rightId) {
        int32 level = depth - 1;
        K curKey = upKey;
        int64 curRight = rightId;
        boolean done = false;
        while (done == false) {
            if (level == 0) {
                LtmBPlusTreeNode<K, V> nr = this.pager.allocNode(false);
                nr.keys[0] = curKey;
                nr.numKeys = 1;
                nr.childIds[0] = path[0];
                nr.childIds[1] = curRight;
                this.pager.markDirty(nr.pageId);
                this.pager.setRoot(nr.pageId);
                done = true;
            } else {
                int64 leftId = path[level];
                int64 parentId = path[level - 1];
                LtmBPlusTreeNode<K, V> parent = this.pager.fetch(parentId);
                int32 ci = 0;
                while (ci <= parent.numKeys && parent.childIds[ci] != leftId) {
                    ci = ci + 1;
                }
                int32 j = parent.numKeys;
                while (j > ci) {
                    parent.keys[j] = parent.keys[j - 1];
                    j = j - 1;
                }
                parent.keys[ci] = curKey;
                int32 c = parent.numKeys + 1;
                while (c > ci + 1) {
                    parent.childIds[c] = parent.childIds[c - 1];
                    c = c - 1;
                }
                parent.childIds[ci + 1] = curRight;
                parent.numKeys = parent.numKeys + 1;
                this.pager.markDirty(parentId);

                int32 order = this.pager.getOrder();
                if (parent.numKeys > order) {
                    int32 total = parent.numKeys;
                    int32 mid = total / 2;
                    K promote = parent.keys[mid];
                    LtmBPlusTreeNode<K, V> rightInternal = this.pager.allocNode(false);
                    int64 riId = rightInternal.pageId;
                    rightInternal.numKeys = total - mid - 1;
                    int32 kk = 0;
                    while (kk < rightInternal.numKeys) {
                        rightInternal.keys[kk] = parent.keys[mid + 1 + kk];
                        kk = kk + 1;
                    }
                    int32 cc = 0;
                    while (cc <= rightInternal.numKeys) {
                        rightInternal.childIds[cc] = parent.childIds[mid + 1 + cc];
                        cc = cc + 1;
                    }
                    parent.numKeys = mid;
                    this.pager.markDirty(parentId);
                    this.pager.markDirty(riId);
                    curKey = promote;
                    curRight = riId;
                    level = level - 1;
                } else {
                    done = true;
                }
            }
        }
    }
}
