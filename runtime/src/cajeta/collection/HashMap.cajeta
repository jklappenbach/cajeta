package cajeta.collection;

/**
 * Hash-based map from keys to values.
 *
 * ## Hashing and equality
 *
 * `HashMap` uses two contracts on the key type `K`:
 *
 * - **`key.hash()`** for the bucket index. By default this is the
 *   identity hash inherited from `cajeta.lang.Object.hash()` — so
 *   two distinct instances of the same class are different keys
 *   even if their fields match. Override `hash()` on `K` (or apply
 *   the planned `@AutoHash` annotation) for value-keyed semantics.
 * - **`==` on keys** for equality within a bucket. For class types
 *   this is pointer identity; if you override `hash()` for value
 *   semantics you must also override `==` so equal keys compare
 *   equal — the contract HashMap relies on.
 *
 * ## v1 constraint: K must be a class type
 *
 * Primitives don't carry `hash()` or override `==`, so this v1
 * accepts only class-typed K. `HashMap<int32, V>` doesn't compile;
 * box your int32 keys (or wait for the planned primitive-hash
 * intrinsics + boxing helpers).
 *
 * ## Storage, probing, and tombstones
 *
 * Open addressing with linear probing — no entry chain, no
 * indirection through a heap-allocated bucket list. Three parallel
 * heap arrays at the same length: `keys`, `vals`, `state`.
 *
 * The `state` array tracks each slot's lifecycle: `EMPTY` (never
 * written, or freshly allocated), `OCCUPIED` (holds a live entry),
 * `TOMBSTONE` (held an entry that was removed). Tombstones are
 * needed because a deleted entry can't simply revert to `EMPTY`
 * without breaking lookup: a probe walking past a slot needs to
 * know whether to continue (a real key might live further along
 * because of an earlier collision at this slot) or stop. Tombstones
 * say "continue, but this slot is reusable."
 *
 * `put` opportunistically reuses the first tombstone it walks past
 * when inserting a new key, keeping the table compact across remove
 * + insert cycles. `get` / `containsKey` walk past tombstones
 * transparently.
 *
 * Capacity is **power-of-2**; the bucket index is
 * `hash(key) & (capacity - 1)`. Faster than `% capacity`, equivalent
 * distribution given a well-mixed hash. **Caller picks the initial
 * capacity**; the table auto-grows when the load factor (counting
 * tombstones, since they cost probe steps too) exceeds 0.75. Each
 * resize doubles capacity and reinserts every live entry into a
 * fresh table — that pass also clears tombstones, so a workload
 * that thrashes on `remove` + `put` eventually compacts.
 *
 * ## Missing in v1
 *
 * - **Iterator over entries** — needs `cajeta.collection.Iterator<T>`,
 *   not in place yet.
 * - **Primitive K** — see "v1 constraint" above.
 *
 * @see cajeta.lang.Object
 * @see cajeta.hash.Hash
 */
public class HashMap<K, V> {

    // Slot states. Inlined as integer literals at the call sites
    // because cajeta lacks `const` / `enum` for class-level constants
    // today — the comments name them.
    //   0 = EMPTY      (never written, or freshly allocated)
    //   1 = OCCUPIED   (live entry: keys[i] and vals[i] are valid)
    //   2 = TOMBSTONE  (deleted entry: probe past, but slot is reusable)

    /** Parallel storage: K bucket, V bucket, slot lifecycle. */
    private K[] keys;
    private V[] vals;
    private int8[] state;
    private int64 cap;
    private int64 sizeCount;
    // Number of slots that aren't EMPTY (OCCUPIED + TOMBSTONE). Both
    // cost probe steps, so resize decisions count both. sizeCount
    // alone would let a thrash-on-remove workload accumulate
    // tombstones until probes are linear; this counter triggers
    // the rebuild.
    private int64 usedSlots;

    /**
     * Construct a new HashMap with the given initial capacity.
     *
     * @param initialCapacity number of buckets to allocate; **must
     *        be a power of 2** (the mask-based index doesn't work
     *        otherwise). v1 doesn't validate this. The table grows
     *        from here as entries are added.
     */
    public HashMap(int64 initialCapacity) {
        this.cap = initialCapacity;
        this.keys = new K[initialCapacity];
        this.vals = new V[initialCapacity];
        this.state = new int8[initialCapacity];
        this.sizeCount = 0;
        this.usedSlots = 0;
    }

    /**
     * Insert or replace the value at `key`.
     *
     * @param key the key. Hashed once via `key.hash()`.
     * @param value the value to associate with `key`.
     */
    public void put(K key, V value) {
        int64 h = key.hash();
        int64 idx = h & (this.cap - 1);
        int64 firstTombstone = -1;
        // Probe until we hit an EMPTY slot. Along the way:
        //   - OCCUPIED slot with matching key → replace, done.
        //   - TOMBSTONE → remember the first one we see; if we
        //     eventually hit EMPTY without finding the key, we'll
        //     insert at the tombstone (compacts the table).
        while (this.state[idx] != 0) {
            if (this.state[idx] == 1) {
                if (this.keys[idx] == key) {
                    this.vals[idx] = value;
                    return;
                }
            } else {
                // state == 2 (TOMBSTONE)
                if (firstTombstone == -1) {
                    firstTombstone = idx;
                }
            }
            idx = (idx + 1) & (this.cap - 1);
        }
        // Reached EMPTY. Prefer the first tombstone if any —
        // compacting the table across remove + put cycles.
        int64 insertAt = idx;
        boolean reusingTombstone = false;
        if (firstTombstone != -1) {
            insertAt = firstTombstone;
            reusingTombstone = true;
        }
        this.keys[insertAt] = key;
        this.vals[insertAt] = value;
        this.state[insertAt] = 1;
        this.sizeCount = this.sizeCount + 1;
        // usedSlots only grows when we claim a fresh EMPTY slot;
        // reusing a tombstone repurposes a slot that was already
        // counted.
        if (reusingTombstone == false) {
            this.usedSlots = this.usedSlots + 1;
        }
        // Auto-grow at 0.75 load factor (usedSlots * 4 > cap * 3,
        // using the multiplied form to avoid integer-division
        // rounding). Triggers after the insert so the threshold
        // reflects the table's current state.
        if (this.usedSlots * 4 > this.cap * 3) {
            this.resize();
        }
    }

    /**
     * Double the capacity and reinsert every live entry. Clears all
     * tombstones in the process (the new table starts EMPTY). Called
     * from `put` when the load factor exceeds 0.75. Public surface
     * doesn't observe it directly — only the side effect (lookups
     * stay O(1) average even as the map grows).
     *
     * Implementation strategy: allocate the new arrays into locals,
     * walk `this.keys / vals / state` (the OLD arrays, still
     * reachable through `this`) to rebuild into the locals, then
     * publish the locals onto `this`. Avoids the local-of-class-
     * field-pointer pattern, which interacts awkwardly with
     * cajeta's drop chain (the local's scope-exit drop would race
     * with the field reassignment).
     */
    private void resize() {
        int64 oldCap = this.cap;
        int64 newCap = oldCap * 2;
        K[] newKeys = new K[newCap];
        V[] newVals = new V[newCap];
        int8[] newState = new int8[newCap];
        int64 newSize = 0;
        int64 i = 0;
        while (i < oldCap) {
            if (this.state[i] == 1) {
                // Inline insert into the new table. No tombstones
                // exist yet; every probe terminates at an EMPTY
                // slot. No duplicate-key check needed either — old
                // slots are already unique by construction.
                K k = this.keys[i];
                V v = this.vals[i];
                int64 h = k.hash();
                int64 idx = h & (newCap - 1);
                while (newState[idx] != 0) {
                    idx = (idx + 1) & (newCap - 1);
                }
                newKeys[idx] = k;
                newVals[idx] = v;
                newState[idx] = 1;
                newSize = newSize + 1;
            }
            i = i + 1;
        }
        // Publish the rebuilt table onto `this` via `#` (ownership
        // transfer). Without `#`, the locals' scope-exit drop chain
        // fires `__cajeta_free_array` on the new buffers right
        // after we hand them to `this`, leaving the map pointing at
        // freed memory and turning the next probe into an infinite
        // loop (garbage `state` bytes are unlikely to be EMPTY=0).
        this.keys = #newKeys;
        this.vals = #newVals;
        this.state = #newState;
        this.cap = newCap;
        this.sizeCount = newSize;
        this.usedSlots = newSize;
    }

    /**
     * Retrieve the value at `key`, or null/zero if absent.
     *
     * Use `containsKey` to distinguish "absent" from "present but
     * the stored value is null/0."
     *
     * @param key the key to look up. Hashed once via `key.hash()`.
     * @returns the value associated with `key`, or null/0 if not present.
     */
    public V get(K key) {
        int64 h = key.hash();
        int64 idx = h & (this.cap - 1);
        // Walk past TOMBSTONE (state==2) slots; stop only at EMPTY
        // (state==0). A matching OCCUPIED key (state==1) wins.
        while (this.state[idx] != 0) {
            if (this.state[idx] == 1) {
                if (this.keys[idx] == key) {
                    return this.vals[idx];
                }
            }
            idx = (idx + 1) & (this.cap - 1);
        }
        // Miss-path default. Cajeta lacks a generic "zero of V"
        // literal that works for both primitive V (where it should
        // be 0) and class V (where it should be null) — `return 0;`
        // breaks class-V (`ret i64 0` vs `ptr`); `return null;` breaks
        // primitive-V (`ret ptr null` vs `i32`). The V[1] trick gets
        // both: a fresh single-element V array is zero-initialized
        // (null for class V, 0 for primitive V) and element 0 has
        // the right LLVM type already. The array drops at scope exit
        // via the drop chain — no escape because we only read the
        // element. Callers that need to disambiguate "absent" from
        // "present-and-null/zero" should use containsKey() first.
        V[] missDefault = new V[1];
        return missDefault[0];
    }

    /**
     * Test whether `key` is present in the map.
     *
     * @param key the key to test.
     * @returns true iff `key` was previously inserted via `put`
     *          and not subsequently removed.
     */
    public boolean containsKey(K key) {
        int64 h = key.hash();
        int64 idx = h & (this.cap - 1);
        while (this.state[idx] != 0) {
            if (this.state[idx] == 1) {
                if (this.keys[idx] == key) {
                    return true;
                }
            }
            idx = (idx + 1) & (this.cap - 1);
        }
        return false;
    }

    /**
     * Remove the entry at `key`.
     *
     * Leaves a tombstone in the slot so subsequent probes still
     * traverse past it correctly. The tombstone is reusable by a
     * future `put` whose probe reaches it before an `EMPTY` slot.
     *
     * @param key the key to remove. Hashed once via `key.hash()`.
     * @returns true iff `key` was present and removed; false if
     *          no such key was in the map.
     */
    public boolean remove(K key) {
        int64 h = key.hash();
        int64 idx = h & (this.cap - 1);
        while (this.state[idx] != 0) {
            if (this.state[idx] == 1) {
                if (this.keys[idx] == key) {
                    this.state[idx] = 2;
                    this.sizeCount = this.sizeCount - 1;
                    return true;
                }
            }
            idx = (idx + 1) & (this.cap - 1);
        }
        return false;
    }

    /**
     * @returns the number of (key, value) pairs stored.
     */
    public int64 count() {
        return this.sizeCount;
    }

    // ----- Subscript-syntax sugar over get/put -------------------------

    /**
     * Subscript-read syntax: `v = m[key]` dispatches here. Delegates
     * to `get`. Returns null/0 on miss; use `containsKey` to
     * disambiguate "absent" from "present-and-null".
     *
     * @param key the key. Hashed once via `key.hash()`.
     * @returns the value associated with `key`, or null/0.
     */
    public V operator[] (K key) {
        return this.get(key);
    }

    /**
     * Subscript-write syntax: `m[key] = value` dispatches here.
     * Delegates to `put`. Replaces any existing value bound to a
     * `==`-equal key.
     *
     * @param key the key. Hashed once via `key.hash()`.
     * @param value the value to associate with `key`.
     */
    public void operator[]= (K key, V value) {
        this.put(key, value);
    }
}
