package cajeta.collection;

/**
 * Hash-based map from keys to values, backed by a SwissTable (SSE2-style open
 * addressing with SIMD metadata probing) over a DENSE entry array.
 *
 * ## Usage
 *
 * ```cajeta
 * HashMap<Tag, int32> counts = heap HashMap<Tag, int32>(16);
 * counts.put(tag, 1);
 * counts[tag] = counts[tag] + 1;       // subscript sugar over get / put
 * if (counts.containsKey(tag)) {
 *     int32 n = counts.get(tag);       // null/0 on miss — see get()
 * }
 * counts.remove(tag);
 * #Stream<Pair<Tag, int32>> es = counts.entries();
 * ```
 *
 * ## Hashing and equality
 *
 * - **`key.hash()`** indexes the table. Class K defaults to the identity hash
 *   from `cajeta.lang.Object`; override `hash()` (or apply `@AutoHash`) for
 *   value-keyed semantics — and then also override `==`, which decides equality
 *   within a probe.
 * - Primitive K lowers `.hash()` to a `__cajeta_hash_X` runtime helper; both
 *   `HashMap<Tag,int32>` and `HashMap<int32,V>` work without boxing.
 *
 * **Views are NOT allowed as K or V** — the `MapEntry<K,V>` fields would become
 * arrays-of-view (`CAJETA_ERROR_VIEW_AS_CLASS_FIELD`).
 *
 * ## Storage: dense SwissTable
 *
 * One `MapEntry<K,V>[] slots` array (each element an inline `{key, val}` value
 * struct) plus a `ctrl` metadata array, one control byte per slot: `EMPTY`
 * (0x80), `DELETED` (0xFE), or a 7-bit hash fragment `h2` in [0,127] (top bit
 * clear) for a FULL slot. `ctrl` is `cap + 16` long; the last 16 bytes mirror
 * the first 16 so a 16-wide group load starting at any slot reads a valid window.
 *
 * A lookup loads 16 control bytes at once (`Cajeta.vload16`) and compares all of
 * them to `h2` with one SIMD op (`eqMask`); set bits are the slots worth a full
 * key compare. Because key and value live together in one `slots[i]` element, a
 * confirmed probe touches just two cache lines (the `ctrl` group + the entry),
 * the dense abseil/ankerl layout. A group containing an `EMPTY` byte ends the
 * probe. Probing advances by groups of 16 with a triangular stride, which visits
 * every slot for a power-of-two capacity.
 *
 * `cap` is a power of two `>= 16` (the constructor rounds up). The table doubles
 * when non-empty slots (FULL + DELETED) exceed 0.75 of `cap`; a resize rebuilds
 * into a fresh table and clears tombstones. `remove` leaves a `DELETED` tombstone
 * that `put` reuses and `get` probes past.
 *
 * @See cajeta.collection.MapEntry
 * @See cajeta.lang.Object
 */
public final class HashMap<K, V> {

    // Control-byte sentinels (the rest of [0,127] are FULL h2 fragments):
    //   EMPTY   = 0x80 (-128)  never written / freshly cleared; ends a probe
    //   DELETED = 0xFE   (-2)  removed entry; probe past, slot is reusable
    // FULL slots have the top bit clear (>= 0 as signed int8).

    // Dense entry storage: one inline {key, val} struct per slot.
    private MapEntry<K, V>[] slots;
    // title-stores §3.3.2 — per-slot ownership lives in each MapEntry
    // slot's inline ownership word now (member stores write it, the
    // synthesized member walk drops by it); the owned[] sidecar is gone.
    // Control bytes: length cap + 16. ctrl[cap+i] mirrors ctrl[i] for i in [0,16)
    // so a group load near the end never overruns.
    private int8[] ctrl;
    private int64 cap;
    private int64 sizeCount;
    // Non-empty slots (FULL + DELETED). Both consume probe steps, so the resize
    // trigger counts both; a remove-heavy workload thus still compacts (on resize).
    private int64 usedSlots;

    /**
     * Construct a HashMap with the default capacity (64 — holds 48 entries
     * before the first resize at 0.75 load; sized for cache/index workloads
     * rather than the empty-map-heavy general case. Lazy table allocation,
     * which would make this free for never-populated maps, is tracked as a
     * follow-up).
     *
     * @EntryPoint
     */
    public HashMap() {
        this.cap = 64;
        this.slots = heap MapEntry<K, V>[64];
        this.ctrl = heap int8[80];
        this.sizeCount = 0;
        this.usedSlots = 0;
        this.fillCtrlEmpty();
    }

    /**
     * Construct a HashMap. `initialCapacity` is rounded up to a power of two
     * `>= 16`; the table grows from there at 0.75 load.
     *
     * @EntryPoint
     */
    public HashMap(int64 initialCapacity) {
        int64 c = 16;
        while (c < initialCapacity) {
            c = c * 2;
        }
        this.cap = c;
        this.slots = heap MapEntry<K, V>[c];
        this.ctrl = heap int8[c + 16];
        this.sizeCount = 0;
        this.usedSlots = 0;
        this.fillCtrlEmpty();
    }

    /**
     * Build a map from an array of `Pair<K,V>` entries — the lowering target
     * of a map literal `["a": 1, "b": 2]` (collection-literals §3). Each pair's
     * `first()` is the key and `second()` the value; later duplicates of a key
     * replace earlier ones, matching `put`. The default capacity (64) is used;
     * the table grows if the entry count crosses 0.75 load.
     */
    public HashMap(#Pair<K, V>[] entries) {
        this.cap = 64;
        this.slots = heap MapEntry<K, V>[64];
        this.ctrl = heap int8[80];
        this.sizeCount = 0;
        this.usedSlots = 0;
        this.fillCtrlEmpty();
        int32 n = (int32) entries.count();
        int32 i = 0;
        while (i < n) {
            this.put(entries[i].takeFirst(), entries[i].takeSecond());
            i = i + 1;
        }
    }

    // Fill `ctrlArr[0..total)` with EMPTY (0x80). The 8-byte word store
    // handles the bulk; cap+16 is a multiple of 8 so the tail rarely runs,
    // but it stays for safety. Shared by the ctors (via fillCtrlEmpty) and
    // resize (on the fresh table).
    @Inline
    private void fillEmpty(int8[] ctrlArr, int64 total) {
        int64 word = (int64) 0x8080808080808080;
        int64 k = 0;
        while (k + 8 <= total) {
            Cajeta.storeU64(ctrlArr, k, word);
            k = k + 8;
        }
        while (k < total) {
            ctrlArr[k] = (int8) 0x80;
            k = k + 1;
        }
    }

    @Inline
    private void fillCtrlEmpty() {
        this.fillEmpty(this.ctrl, this.cap + 16);
    }

    // Write control byte `b` at slot `i`, mirroring into the cloned tail when the
    // slot is one of the first 16.
    @Inline
    private void setCtrl(int64 i, int8 b) {
        this.ctrl[i] = b;
        if (i < 16) {
            this.ctrl[this.cap + i] = b;
        }
    }

    /**
     * Insert or replace the value at `key`.
     */
    public void put(K key, V value) {
        // The map does not own by default: the formals are plain, and each
        // `#=` store below records whatever mode the argument arrived in —
        // a `#`-spelled argument arms the slot's title, a plain one stores
        // a borrow.
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        int64 insertAt = -1;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    // Replace: the member store's displaced release
                    // (title-stores §3.3.2) drops an owned old value.
                    this.slots[i].val #= value;
                    // The incoming key duplicates the one already stored, so
                    // it is NOT stored. We do not drop it by hand: the key
                    // formal's own drop entry reclaims it at return WHEN the
                    // caller transferred title; a lent key is left to its
                    // owner. An explicit dropValue here double-frees a class
                    // key and drops a non-pointer for a primitive one (this
                    // was a SIGSEGV in HashMapTests.bracketReplaceUpdatesValue).
                    // Same rule as BPlusTree.put's replace path.
                    return;
                }
                mm = mm & (mm - 1);
            }
            int32 emptyM = g.eqMask((int8) 0x80) & 65535;
            // First empty-or-deleted slot on the probe is the insert candidate;
            // reusing a tombstone keeps the table compact across remove + put.
            if (insertAt == -1) {
                int32 free = emptyM | (g.eqMask((int8) 0xFE) & 65535);
                if (free != 0) {
                    insertAt = (pos + Cajeta.ctz64((int64) free)) & mask;
                }
            }
            // An EMPTY in the group proves the key is absent (a real key would
            // have landed before any empty on its probe chain).
            if (emptyM != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        boolean wasEmpty = (this.ctrl[insertAt] == (int8) 0x80);
        this.slots[insertAt].key #= key;
        this.slots[insertAt].val #= value;
        this.setCtrl(insertAt, h2);
        this.sizeCount = this.sizeCount + 1;
        // Reusing a DELETED slot doesn't consume a fresh empty, so usedSlots
        // (the growth driver) only moves when we claim an EMPTY slot.
        if (wasEmpty) {
            this.usedSlots = this.usedSlots + 1;
            if (this.usedSlots * 4 > this.cap * 3) {
                this.resize();
            }
        }
    }

    /**
     * Double the capacity, reinsert every FULL entry into a fresh EMPTY table,
     * and drop all tombstones. Published onto `this` via `#` ownership transfer
     * (without it the locals' scope-exit drop would free the live buffers).
     */
    @NoInline
    private void resize() {
        int64 oldCap = this.cap;
        int64 newCap = oldCap * 2;
        int64 newMask = newCap - 1;
        MapEntry<K, V>[] newSlots = heap MapEntry<K, V>[newCap];
        int8[] newCtrl = heap int8[newCap + 16];
        this.fillEmpty(newCtrl, newCap + 16);
        int64 newSize = 0;
        int64 s = 0;
        while (s < oldCap) {
            int8 c = this.ctrl[s];
            if (c >= (int8) 0) {   // FULL: reinsert (all keys unique, no eq check)
                K kk = this.slots[s].key;
                int64 h = kk.hash();
                int8 h2 = (int8) ((h >> 57) & 0x7F);
                int64 pos = h & newMask;
                int64 stride = 0;
                boolean placing = true;
                while (placing) {
                    Vector<int8,16> g = Cajeta.vload16(newCtrl, pos);
                    int32 emptyM = g.eqMask((int8) 0x80) & 65535;
                    if (emptyM != 0) {
                        int64 i = (pos + Cajeta.ctz64((int64) emptyM)) & newMask;
                        // Each `#=` forwards the slot's mode verbatim — an
                        // owning slot hands its title to the new table, a
                        // borrowing slot stays a borrow — and clears the source.
                        newSlots[i].key #= this.slots[s].key;
                        newSlots[i].val #= this.slots[s].val;
                        newCtrl[i] = h2;
                        if (i < 16) {
                            newCtrl[newCap + i] = h2;
                        }
                        newSize = newSize + 1;
                        placing = false;
                    } else {
                        stride = stride + 16;
                        pos = (pos + stride) & newMask;
                    }
                }
            }
            s = s + 1;
        }
        this.slots #= newSlots;
        this.ctrl #= newCtrl;
        this.cap = newCap;
        this.sizeCount = newSize;
        this.usedSlots = newSize;
    }

    // Shared lookup probe (get / containsKey / remove / the extracting
    // subscript): the slot index holding `key`, or -1 when absent. One
    // SIMD group compare per 16 slots; an EMPTY byte in a group proves
    // absence (a real key would have landed before any empty on its
    // probe chain). put() keeps its own loop — it also tracks the first
    // reusable EMPTY/DELETED slot, which no reader needs.
    @Inline
    private int64 findSlot(K key) {
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    return i;
                }
                mm = mm & (mm - 1);
            }
            if ((g.eqMask((int8) 0x80) & 65535) != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        return -1;
    }

    /**
     * Retrieve the value at `key`, or null/zero if absent. Use `containsKey` to
     * distinguish "absent" from "present but stored null/0".
     *
     * VIEW of the stored value — borrow, valid while this HashMap lives and the
     * entry is not removed or overwritten; copy it to retain.
     */
    public V get(K key) {
        int64 i = this.findSlot(key);
        if (i >= 0) {
            return this.slots[i].val;
        }
        // Miss default: a stack single-element V array is zero-initialized
        // (null for class V, 0 for primitive V) with the right LLVM element
        // type — no heap traffic on the miss path.
        V[] missDefault = stack V[1];
        return missDefault[0];
    }

    /**
     * Test whether `key` is present.
     */
    public boolean containsKey(K key) {
        return this.findSlot(key) >= 0;
    }

    /**
     * Remove the entry at `key`, leaving a `DELETED` tombstone (probed past
     * by lookups, reused by a later `put`).
     *
     * Structural removal (title-tracking §6.4): membership ends and the value
     * comes back in whatever mode the entry held it — the FLAGGED return. An
     * owned entry hands its title to the caller (whose receiving local drops
     * it); a borrowed entry hands back a borrow and the original owner keeps
     * the single drop. A discarded `m.remove(k);` statement is safe either
     * way: the compiler conditionally drops a discarded flagged temp. An
     * owned KEY is still reclaimed here (keys are not returned). Miss → the
     * zero default (null for class V), flag borrowed.
     */
    public V remove(K key) {
        int64 i = this.findSlot(key);
        if (i >= 0) {
            // Clear the key slot so the tombstone holds NO stale pointer:
            // the String field-store emitter old-drops the previous field
            // value unconditionally, so a stale freed key left here was
            // re-dropped when a later put reused this slot (the 6.2.6b
            // DnsCache eviction SIGSEGV). The zero source is a STACK slot —
            // no heap traffic on remove, and a stack address can never
            // collide with a recycled malloc address. For a String K the
            // clear-store's own old-drop also frees a borrow-resolved
            // copy; for class K it releases the owned key; primitives just
            // store zero.
            K[] kz = stack K[1];
            // The zero-store's displaced release (title-stores §3.3.2)
            // drops an OWNED class key. Bit clears with the plain store.
            this.slots[i].key = kz[0];
            // Fused claim: the val bit rides into `out` (owned or
            // borrowed, verbatim) and the slot bit clears — then
            // `return #out` carries that flag to the caller (the
            // flagged-return protocol, no explicit boolean).
            V out #= this.slots[i].val;
            this.setCtrl(i, (int8) 0xFE);
            this.sizeCount = this.sizeCount - 1;
            return #= out;
        }
        V[] missDefault = stack V[1];
        return Cajeta.flagged(missDefault[0], false);
    }

    @Inline
    public int64 count() {
        return this.sizeCount;
    }

    // title-stores §3.3.2 — no bespoke destructor: the slots field's
    // synthesized member walk drops exactly the owned members (String
    // members unconditionally, per the always-owned field rule).

    // ----- Subscript-syntax sugar over get/put -------------------------

    /** Subscript read: `v = m[key]` → `get(key)`. */
    public V operator[] (K key) {
        return this.get(key);
    }

    /** Subscript write: `m[key] = value` → `put(key, value)`. The `#`
     *  forwards are what thread the CALLER's transfer word through to put
     *  (an entry-less formal — String / primitive K — forwards its incoming
     *  word bit; a droppable class formal forwards its entry flag): a plain
     *  forward would read all-borrow and record every indexed store as
     *  borrowed regardless of the caller's spelling. */
    public void operator[]= (#K key, #V value) {
        this.put(#key, #value);
    }

    /**
     * Title-extracting subscript — `V v #= m[key]` (title-tracking §6.3).
     * TOTAL: either the entry holds a title and it moves to the caller —
     * the entry stays RESIDENT and readable, its bit decayed to borrowed
     * (membership is not ownership) — or this throws: extraction from an
     * absent key or from an entry that holds no title (borrowed, or already
     * extracted) is a Recoverable panic, never a silent second title.
     */
    public #V operator#[] (K key) {
        int64 i = this.findSlot(key);
        if (i >= 0) {
            // Guarded member detach (title-stores §3.3.2): the title moves
            // out and the bit decays; a borrowed or already-extracted
            // entry panics TITLE_MISS.
            V out #= this.slots[i].val;
            return #out;
        }
        throw heap Exception("#[] extraction: no entry for the key — extraction requires a resident owned entry");
    }

    // ----- Stream views over the map's live entries -------------------
    // The stream's "occupied" test is ctrl[i] >= 0 (FULL = top bit clear);
    // EMPTY/DELETED (top bit set) are skipped. Snapshot at call time — a later
    // resize / put / remove leaves the returned stream's behavior undefined.

    /** Stream over the live keys, slot-walk order. */
    public #Stream<K> keys() {
        return heap HashMapKeyStream<K, V>(this.slots, this.ctrl, this.cap);
    }

    /** Stream over the live values, slot-walk order. */
    public #Stream<V> values() {
        return heap HashMapValueStream<K, V>(this.slots, this.ctrl, this.cap);
    }

    /** Stream of (key, value) pairs, one fresh Pair per live slot. */
    public #Stream<Pair<K, V>> entries() {
        return heap HashMapEntryStream<K, V>(this.slots, this.ctrl, this.cap);
    }
}
