package cajeta.collection;

/**
 * Hash-based map from keys to values, backed by a SwissTable (SSE2-style open
 * addressing with SIMD metadata probing) over a DENSE entry array.
 *
 * ## Usage
 *
 * ```cajeta
 * #HashMap<Tag, int32> counts = heap HashMap<Tag, int32>(16);
 * counts.put(tag, 1);
 * counts[tag] = counts[tag] + 1;       // subscript sugar over get / put
 * if (counts.containsKey(tag)) {
 *     int32 n = counts.get(tag);       // null/0 on miss — see get()
 * }
 * counts.remove(tag);
 * #Stream<Pair<Tag, int32>> es = counts.entries();
 * ```
 *
 * ## Hashing and equality
 *
 * - **`key.hash()`** indexes the table. Class K defaults to the identity hash
 *   from `cajeta.lang.Object`; override `hash()` (or apply `@AutoHash`) for
 *   value-keyed semantics — and then also override `==`, which decides equality
 *   within a probe.
 * - Primitive K lowers `.hash()` to a `__cajeta_hash_X` runtime helper; both
 *   `HashMap<Tag,int32>` and `HashMap<int32,V>` work without boxing.
 *
 * **Views are NOT allowed as K or V** — the `MapEntry<K,V>` fields would become
 * arrays-of-view (`CAJETA_ERROR_VIEW_AS_CLASS_FIELD`).
 *
 * ## Storage: dense SwissTable
 *
 * One `MapEntry<K,V>[] slots` array (each element an inline `{key, val}` value
 * struct) plus a `ctrl` metadata array, one control byte per slot: `EMPTY`
 * (0x80), `DELETED` (0xFE), or a 7-bit hash fragment `h2` in [0,127] (top bit
 * clear) for a FULL slot. `ctrl` is `cap + 16` long; the last 16 bytes mirror
 * the first 16 so a 16-wide group load starting at any slot reads a valid window.
 *
 * A lookup loads 16 control bytes at once (`Cajeta.vload16`) and compares all of
 * them to `h2` with one SIMD op (`eqMask`); set bits are the slots worth a full
 * key compare. Because key and value live together in one `slots[i]` element, a
 * confirmed probe touches just two cache lines (the `ctrl` group + the entry),
 * the dense abseil/ankerl layout. A group containing an `EMPTY` byte ends the
 * probe. Probing advances by groups of 16 with a triangular stride, which visits
 * every slot for a power-of-two capacity.
 *
 * `cap` is a power of two `>= 16` (the constructor rounds up). The table doubles
 * when non-empty slots (FULL + DELETED) exceed 0.75 of `cap`; a resize rebuilds
 * into a fresh table and clears tombstones. `remove` leaves a `DELETED` tombstone
 * that `put` reuses and `get` probes past.
 *
 * @See cajeta.collection.MapEntry
 * @See cajeta.lang.Object
 */
public final class HashMap<K, V> {

    // Control-byte sentinels (the rest of [0,127] are FULL h2 fragments):
    //   EMPTY   = 0x80 (-128)  never written / freshly cleared; ends a probe
    //   DELETED = 0xFE   (-2)  removed entry; probe past, slot is reusable
    // FULL slots have the top bit clear (>= 0 as signed int8).

    // Dense entry storage: one inline {key, val} struct per slot.
    private MapEntry<K, V>[] slots;
    // Per-slot ownership bits for entries the map TOOK via `#` transfer and must
    // drop: bit0 = key owned, bit1 = val owned. Borrowed entries (plain `put`)
    // leave 0 and are never dropped. Parallel to slots; length cap.
    private int8[] owned;
    // Control bytes: length cap + 16. ctrl[cap+i] mirrors ctrl[i] for i in [0,16)
    // so a group load near the end never overruns.
    private int8[] ctrl;
    private int64 cap;
    private int64 sizeCount;
    // Non-empty slots (FULL + DELETED). Both consume probe steps, so the resize
    // trigger counts both; a remove-heavy workload thus still compacts (on resize).
    private int64 usedSlots;

    /**
     * Construct a HashMap. `initialCapacity` is rounded up to a power of two
     * `>= 16`; the table grows from there at 0.75 load.
     */
    public HashMap(int64 initialCapacity) {
        int64 c = 16;
        while (c < initialCapacity) {
            c = c * 2;
        }
        this.cap = c;
        this.slots = heap MapEntry<K, V>[c];
        this.ctrl = heap int8[c + 16];
        this.owned = heap int8[c];   // calloc 0 = nothing owned yet
        this.sizeCount = 0;
        this.usedSlots = 0;
        this.fillCtrlEmpty();
    }

    // Fill the whole ctrl array (slots + mirror) with EMPTY (0x80). The 8-byte
    // word store handles the bulk; cap+16 is a multiple of 8 so the tail rarely
    // runs, but it stays for safety.
    @Inline
    private void fillCtrlEmpty() {
        int64 n = this.cap + 16;
        int64 word = (int64) 0x8080808080808080;
        int64 k = 0;
        while (k + 8 <= n) {
            Cajeta.storeU64(this.ctrl, k, word);
            k = k + 8;
        }
        while (k < n) {
            this.ctrl[k] = (int8) 0x80;
            k = k + 1;
        }
    }

    // Write control byte `b` at slot `i`, mirroring into the cloned tail when the
    // slot is one of the first 16.
    @Inline
    private void setCtrl(int64 i, int8 b) {
        this.ctrl[i] = b;
        if (i < 16) {
            this.ctrl[this.cap + i] = b;
        }
    }

    /**
     * Insert or replace the value at `key`.
     */
    public void put(K key, V value) {
        // Ownership taken via `#` (read once at entry, before any other call):
        // bit0 = key, bit1 = val. Plain (borrow) calls read 0.
        int64 mvm = Cajeta.moveMask();
        boolean keyOwned = (mvm & 1) != 0;
        boolean valOwned = (mvm & 2) != 0;
        int8 ownBits = (int8) (mvm & 3);
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        int64 insertAt = -1;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    // Replace: drop the old owned value, keep the existing key.
                    if ((this.owned[i] & 2) != 0) {
                        Cajeta.dropValue(this.slots[i].val);
                    }
                    this.slots[i].val = value;
                    // The new key duplicates the stored one; drop it if we took it.
                    if (keyOwned) {
                        Cajeta.dropValue(key);
                    }
                    if (valOwned) {
                        this.owned[i] = (int8) (this.owned[i] | 2);
                    } else {
                        this.owned[i] = (int8) (this.owned[i] & 1);
                    }
                    return;
                }
                mm = mm & (mm - 1);
            }
            int32 emptyM = g.eqMask((int8) 0x80) & 65535;
            // First empty-or-deleted slot on the probe is the insert candidate;
            // reusing a tombstone keeps the table compact across remove + put.
            if (insertAt == -1) {
                int32 free = emptyM | (g.eqMask((int8) 0xFE) & 65535);
                if (free != 0) {
                    insertAt = (pos + Cajeta.ctz64((int64) free)) & mask;
                }
            }
            // An EMPTY in the group proves the key is absent (a real key would
            // have landed before any empty on its probe chain).
            if (emptyM != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        boolean wasEmpty = (this.ctrl[insertAt] == (int8) 0x80);
        this.slots[insertAt].key = key;
        this.slots[insertAt].val = value;
        this.owned[insertAt] = ownBits;
        this.setCtrl(insertAt, h2);
        this.sizeCount = this.sizeCount + 1;
        // Reusing a DELETED slot doesn't consume a fresh empty, so usedSlots
        // (the growth driver) only moves when we claim an EMPTY slot.
        if (wasEmpty) {
            this.usedSlots = this.usedSlots + 1;
            if (this.usedSlots * 4 > this.cap * 3) {
                this.resize();
            }
        }
    }

    /**
     * Double the capacity, reinsert every FULL entry into a fresh EMPTY table,
     * and drop all tombstones. Published onto `this` via `#` ownership transfer
     * (without it the locals' scope-exit drop would free the live buffers).
     */
    @NoInline
    private void resize() {
        int64 oldCap = this.cap;
        int64 newCap = oldCap * 2;
        int64 newMask = newCap - 1;
        MapEntry<K, V>[] newSlots = heap MapEntry<K, V>[newCap];
        int8[] newCtrl = heap int8[newCap + 16];
        int8[] newOwned = heap int8[newCap];
        int64 nlen = newCap + 16;
        int64 word = (int64) 0x8080808080808080;
        int64 k = 0;
        while (k + 8 <= nlen) {
            Cajeta.storeU64(newCtrl, k, word);
            k = k + 8;
        }
        while (k < nlen) {
            newCtrl[k] = (int8) 0x80;
            k = k + 1;
        }
        int64 newSize = 0;
        int64 s = 0;
        while (s < oldCap) {
            int8 c = this.ctrl[s];
            if (c >= (int8) 0) {   // FULL: reinsert (all keys unique, no eq check)
                K kk = this.slots[s].key;
                V vv = this.slots[s].val;
                int64 h = kk.hash();
                int8 h2 = (int8) ((h >> 57) & 0x7F);
                int64 pos = h & newMask;
                int64 stride = 0;
                boolean placing = true;
                while (placing) {
                    Vector<int8,16> g = Cajeta.vload16(newCtrl, pos);
                    int32 emptyM = g.eqMask((int8) 0x80) & 65535;
                    if (emptyM != 0) {
                        int64 i = (pos + Cajeta.ctz64((int64) emptyM)) & newMask;
                        newSlots[i].key = kk;
                        newSlots[i].val = vv;
                        newOwned[i] = this.owned[s];   // carry ownership across resize
                        newCtrl[i] = h2;
                        if (i < 16) {
                            newCtrl[newCap + i] = h2;
                        }
                        newSize = newSize + 1;
                        placing = false;
                    } else {
                        stride = stride + 16;
                        pos = (pos + stride) & newMask;
                    }
                }
            }
            s = s + 1;
        }
        this.slots = #newSlots;
        this.ctrl = #newCtrl;
        this.owned = #newOwned;
        this.cap = newCap;
        this.sizeCount = newSize;
        this.usedSlots = newSize;
    }

    /**
     * Retrieve the value at `key`, or null/zero if absent. Use `containsKey` to
     * distinguish "absent" from "present but stored null/0".
     */
    public V get(K key) {
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    return this.slots[i].val;
                }
                mm = mm & (mm - 1);
            }
            if ((g.eqMask((int8) 0x80) & 65535) != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        // Miss default: a fresh single-element V array is zero-initialized (null
        // for class V, 0 for primitive V) with the right LLVM element type.
        V[] missDefault = heap V[1];
        return missDefault[0];
    }

    /**
     * Test whether `key` is present.
     */
    public boolean containsKey(K key) {
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    return true;
                }
                mm = mm & (mm - 1);
            }
            if ((g.eqMask((int8) 0x80) & 65535) != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        return false;
    }

    /**
     * Remove the entry at `key`, leaving a `DELETED` tombstone (probed past by
     * lookups, reused by a later `put`).
     *
     * @returns true iff `key` was present.
     */
    public boolean remove(K key) {
        int64 h = key.hash();
        int64 mask = this.cap - 1;
        int8 h2 = (int8) ((h >> 57) & 0x7F);
        int64 pos = h & mask;
        int64 stride = 0;
        boolean searching = true;
        while (searching) {
            Vector<int8,16> g = Cajeta.vload16(this.ctrl, pos);
            int32 mm = g.eqMask(h2);
            while (mm != 0) {
                int64 i = (pos + Cajeta.ctz64((int64) (mm & 65535))) & mask;
                if (this.slots[i].key == key) {
                    if ((this.owned[i] & 1) != 0) {
                        Cajeta.dropValue(this.slots[i].key);
                    }
                    if ((this.owned[i] & 2) != 0) {
                        Cajeta.dropValue(this.slots[i].val);
                    }
                    this.owned[i] = (int8) 0;
                    this.setCtrl(i, (int8) 0xFE);
                    this.sizeCount = this.sizeCount - 1;
                    return true;
                }
                mm = mm & (mm - 1);
            }
            if ((g.eqMask((int8) 0x80) & 65535) != 0) {
                searching = false;
            } else {
                stride = stride + 16;
                pos = (pos + stride) & mask;
            }
        }
        return false;
    }

    @Inline
    public int64 count() {
        return this.sizeCount;
    }

    // Drop the keys/values the map OWNS (took via `#`). Runs before the auto
    // field-drops free the slots/ctrl/owned buffers. Borrowed entries (owned
    // bit clear) are left alone — their lifetime belongs to the caller.
    ~HashMap() {
        int64 k = 0;
        while (k < this.cap) {
            if (this.ctrl[k] >= (int8) 0) {   // FULL slot
                if ((this.owned[k] & 1) != 0) {
                    Cajeta.dropValue(this.slots[k].key);
                }
                if ((this.owned[k] & 2) != 0) {
                    Cajeta.dropValue(this.slots[k].val);
                }
            }
            k = k + 1;
        }
    }

    // ----- Subscript-syntax sugar over get/put -------------------------

    /** Subscript read: `v = m[key]` → `get(key)`. */
    public V operator[] (K key) {
        return this.get(key);
    }

    /** Subscript write: `m[key] = value` → `put(key, value)`. */
    public void operator[]= (K key, V value) {
        this.put(key, value);
    }

    // ----- Stream views over the map's live entries -------------------
    // The stream's "occupied" test is ctrl[i] >= 0 (FULL = top bit clear);
    // EMPTY/DELETED (top bit set) are skipped. Snapshot at call time — a later
    // resize / put / remove leaves the returned stream's behavior undefined.

    /** Stream over the live keys, slot-walk order. */
    public #Stream<K> keys() {
        return heap HashMapKeyStream<K, V>(this.slots, this.ctrl, this.cap);
    }

    /** Stream over the live values, slot-walk order. */
    public #Stream<V> values() {
        return heap HashMapValueStream<K, V>(this.slots, this.ctrl, this.cap);
    }

    /** Stream of (key, value) pairs, one fresh Pair per live slot. */
    public #Stream<Pair<K, V>> entries() {
        return heap HashMapEntryStream<K, V>(this.slots, this.ctrl, this.cap);
    }
}
