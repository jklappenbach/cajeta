package cajeta.collection;

/**
 * Standard `Collector<T, R>` factories. Each method returns a
 * `Collector` that `Stream<T>.collect<R>` can consume. The factories
 * are themselves method-level templated (`static <T> ...`) so each
 * call site monomorphizes per T — `Collectors.toList()` over an
 * `int32` stream is a distinct symbol from `toList()` over a
 * `String` stream.
 *
 * See cajeta-docs/stdlib/MethodLevelTemplate.md for the dispatch
 * model and cajeta-docs/stdlib/Streams.md § collect for the user-
 * facing pipeline shape.
 */
public class Collectors {
    /**
     * Collect every element into a fresh `ArrayList<T>`. The
     * accumulator appends in stream order and returns the same list
     * reference each iteration (no copy per step). The list is
     * heap-allocated and ownership flows out to the caller via the
     * collect call's return slot.
     */
    public static <T> Collector<T, ArrayList<T>> toList() {
        return new Collector<T, ArrayList<T>>(
            new ArrayList<T>(),
            (ArrayList<T> acc, T x) -> { acc.add(x); return acc; });
    }
}
