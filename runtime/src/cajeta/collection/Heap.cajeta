package cajeta.collection;

/**
 * Array-backed binary heap / priority queue.
 *
 * A **min-heap**: `peek()` and `pop()` return the smallest element by
 * the `<` ordering on `T`. Backed by a single dense array that grows
 * on demand (doubling, like `ArrayList`); the heap invariant
 * (`parent <= child`) is restored by sift-up on `push` and sift-down
 * on `pop`, both O(log n).
 *
 * ## Ordering
 *
 * Element order comes from the `<` operator on `T`, exactly like
 * `cajeta.lang.Math.min` / `max`. Primitive T (int*, float, …) uses
 * the built-in comparison and works today. Class T needs an
 * `operator<` overload; that links once operator overloading flows
 * through template specializations (same v1 limitation Math notes).
 * For a max-heap, wrap values in a type whose `<` is reversed.
 *
 * ## v1 surface
 *
 * `push` / `peek` / `pop` / `count` / `isEmpty`. `peek` and `pop` on
 * an empty heap return the type's zero value (matching the stdlib's
 * miss-path convention) rather than throwing; an exception-throwing
 * variant lands with the error model.
 *
 * ## Usage
 *
 * Construct with `heap Heap<T>()`, `push` elements in any order, then
 * drain in ascending order with repeated `pop`:
 *
 * ```cajeta
 * Heap<int32> h = heap Heap<int32>();
 * h.push(5);
 * h.push(1);
 * h.push(3);
 * int32 lo = h.peek();       // 1  (smallest, not removed)
 * int32 a = h.pop();         // 1
 * int32 b = h.pop();         // 3
 * int64 left = h.count();    // 1
 * boolean done = h.isEmpty();// false
 * ```
 *
 * Grows its backing array by doubling, the same strategy as
 * `ArrayList`; ordering uses `<` on `T` exactly like `Math`.
 *
 * @See cajeta.lang.Math
 * @See cajeta.collection.ArrayList
 */
public final class Heap<T> {

    private T[] data;
    // Per-element ownership bits (title-tracking §6): 1 = the heap TOOK the
    // element via `#`. Bits travel WITH their elements through every sift
    // swap. Same explicit-sidecar pattern as HashMap.owned / ArrayList.owned.
    private int8[] owned;
    private int32 sizeCount;
    private int32 capacity;

    /**
     * Create an empty heap with an initial capacity of 16, growing on
     * demand as elements are `push`ed.
     *
     * ```cajeta
     * Heap<int32> h = heap Heap<int32>();
     * ```
     *
     * @EntryPoint
     */
    public Heap() {
        this.capacity = 16;
        this.data = heap T[16];
        this.owned = heap int8[16];   // calloc 0 = nothing owned yet
        this.sizeCount = 0;
    }

    /**
     * @returns the number of elements currently in the heap.
     */
    @Inline
    public int64 count() {
        return (int64) this.sizeCount;
    }

    /**
     * @returns `true` when the heap holds no elements.
     */
    @Inline
    public boolean isEmpty() {
        return this.sizeCount == 0;
    }

    /**
     * Insert `v`, restoring the heap invariant by sifting it up to
     * its ordered position. O(log n) amortized (O(n) on the rare
     * grow). Grows the backing array by doubling when full.
     *
     * ```cajeta
     * Heap<int32> h = heap Heap<int32>();
     * h.push(3);
     * h.push(1);   // peek() == 1 after each insert
     * ```
     */
    public void push(T v) {
        // Word read FIRST — any later call would clobber the TLS carry.
        int64 mvm = Cajeta.moveMask();
        boolean vOwned = (mvm & 1) != 0;
        if (this.sizeCount >= this.capacity) {
            int32 newCap = this.capacity * 2;
            T[] grown = heap T[newCap];
            int8[] grownOwned = heap int8[newCap];
            int32 i = 0;
            while (i < this.sizeCount) {
                grown[i] = this.data[i];
                grownOwned[i] = this.owned[i];   // carry ownership across
                i = i + 1;
            }
            // Ownership transfer of the fresh storage into the field
            // (see ArrayList.add for why `#` is required here).
            this.data = #grown;
            this.owned = #grownOwned;
            this.capacity = newCap;
        }
        // Dual-capable store (title-tracking §6.1) — spelling matches the
        // caller's transfer, same as HashMap.put / ArrayList.add.
        if (vOwned) {
            this.data[this.sizeCount] = #v;
        } else {
            this.data[this.sizeCount] = v;
        }
        this.owned[this.sizeCount] = (int8) (mvm & 1);
        // Sift up from the new leaf toward the root. Ownership bits travel
        // with their elements through every swap.
        int32 child = this.sizeCount;
        boolean sifting = true;
        while (sifting) {
            if (child == 0) {
                sifting = false;
            } else {
                int32 parent = (child - 1) / 2;
                if (this.data[child] < this.data[parent]) {
                    // title-stores §2.1 — forwarding swap: claim, forward,
                    // restore; every bit rides, no displaced drop fires.
                    T tmp #= #this.data[child];
                    this.data[child] #= #this.data[parent];
                    this.data[parent] #= tmp;
                    int8 tmpO = this.owned[child];
                    this.owned[child] = this.owned[parent];
                    this.owned[parent] = tmpO;
                    child = parent;
                } else {
                    sifting = false;
                }
            }
        }
        this.sizeCount = this.sizeCount + 1;
    }

    /**
     * @returns the smallest element without removing it, or the
     *          type's zero value if the heap is empty.
     */
    @Inline
    public T peek() {
        if (this.sizeCount == 0) {
            T[] missDefault = heap T[1];
            return missDefault[0];
        }
        return this.data[0];
    }

    /**
     * Remove and return the smallest element, restoring the heap
     * invariant by sifting the moved last element down. O(log n).
     * Returns the type's zero value if the heap is empty.
     *
     * Remove-shaped (title-tracking §6.4): membership ends and the value
     * comes back in whatever mode the heap held it — the FLAGGED return.
     * An owned element hands its title to the caller (whose receiving
     * local drops it); a borrowed element hands back a borrow.
     */
    public T pop() {
        if (this.sizeCount == 0) {
            T[] missDefault = heap T[1];
            return Cajeta.flagged(missDefault[0], false);
        }
        boolean topOwned = (this.owned[0] & 1) != 0;
        T top #= #this.data[0];
        this.sizeCount = this.sizeCount - 1;
        // Move the last element (and its bit) to the root and sift down.
        this.data[0] #= #this.data[this.sizeCount];
        this.owned[0] = this.owned[this.sizeCount];
        this.owned[this.sizeCount] = (int8) 0;
        int32 i = 0;
        boolean sifting = true;
        while (sifting) {
            int32 l = 2 * i + 1;
            int32 r = 2 * i + 2;
            int32 smallest = i;
            if (l < this.sizeCount) {
                if (this.data[l] < this.data[smallest]) {
                    smallest = l;
                }
            }
            if (r < this.sizeCount) {
                if (this.data[r] < this.data[smallest]) {
                    smallest = r;
                }
            }
            if (smallest == i) {
                sifting = false;
            } else {
                T tmp #= #this.data[i];
                this.data[i] #= #this.data[smallest];
                this.data[smallest] #= tmp;
                int8 tmpO = this.owned[i];
                this.owned[i] = this.owned[smallest];
                this.owned[smallest] = tmpO;
                i = smallest;
            }
        }
        return Cajeta.flagged(top, topOwned);
    }

    // Drop the elements the heap OWNS (took via `#`). Borrowed elements are
    // left alone — their lifetime belongs to the caller.
    ~Heap() {
        int32 k = 0;
        while (k < this.sizeCount) {
            if ((this.owned[k] & 1) != 0) {
                Cajeta.dropValue(this.data[k]);
            }
            k = k + 1;
        }
    }
}
