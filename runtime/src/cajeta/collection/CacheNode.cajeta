package cajeta.collection;

/**
 * One entry in a `Cache``<K,V>`. Doubly-linked into the cache's LRU
 * list (head=most-recently-used, tail=least). The cache also keeps
 * a `HashMap``<K, CacheNode<K,V>>` for O(1) lookup, so each access
 * resolves the node directly without scanning the list.
 *
 * Same v1 visibility posture as `LinkedListNode` — fields are
 * public for the cache's straightforward access; a future stdlib
 * pass tightens visibility uniformly.
 */
public final class CacheNode<K, V> {
    public K key;
    public V value;
    /**
     * Nanosecond timestamp from `Cajeta.currentTimeNanos()` at the
     * last `get` or `put`. The TTL pass evicts entries whose
     * `(now - accessedAt) > maxAge`.
     *
     * Nanos rather than millis to match `Cajeta.currentTimeNanos`
     * + `cajeta.time.Duration`'s unit, and to defer the unit
     * conversion to the public API surface where humans see it.
     */
    public int64 accessedAt;
    public CacheNode<K, V> prev;
    public CacheNode<K, V> next;

    /**
     * Builds an unlinked node stamped with the current access time;
     * `prev`/`next` start `null` and the owning `Cache` splices it
     * into the LRU list. Allocate on the heap so the cache can own it.
     *
     * ```cajeta
     * CacheNode<K, V> fresh #= heap CacheNode<K, V>(key, value, Cajeta.currentTimeNanos());
     * ```
     */
    public CacheNode(K key, V value, int64 accessedAt) {
        // The node BORROWS the key. `Cache.put` hands the key on PLAIN, so
        // there is no title arriving here to record — the map's key slot is a
        // borrow for the same reason, and the key has to outlive the entry on
        // the cache caller's account. `#key` stores the alias AS-IS: a plain
        // store would resolve-copy a borrowed String into a field the node's
        // teardown never releases (T-origin String fields skip) — a leak per
        // entry.
        // (Pre-7.2.2 this aliased by ACCIDENT via the stale moveMask TLS.)
        this.key #= key;
        // Same for the value: `Cache.put` builds the node with a plain
        // `value`, so this store records a borrow on every insert and the
        // node never reclaims it. (A plain store here was the DnsCache UAF:
        // Cache.put's armed value formal dropped the entry the node had just
        // stored.) Only Cache.put's REPLACE path, whose `#=` reads its formal
        // directly, ever writes an owned value into this field.
        this.value #= value;
        this.accessedAt = accessedAt;
        this.prev = null;
        this.next = null;
    }
}
