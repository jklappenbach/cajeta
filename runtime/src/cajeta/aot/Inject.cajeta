package cajeta.aot;

/**
 * Marks an injection site — a field or a constructor/method parameter the
 * compiler resolves to a provider (AspectModel.md § @Inject). `name` qualifies,
 * and `optional` permits a null when no provider exists. `scope` is empty to take
 * the component's own, or "Owner" for one instance per injecting object.
 */
annotation Inject {
    String name() default "";
    String scope() default "";
    boolean optional() default false;
}
