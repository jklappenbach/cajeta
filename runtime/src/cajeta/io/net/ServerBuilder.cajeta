package cajeta.io.net;

import cajeta.io.net.Server;
import cajeta.io.net.ServerModel;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;

/**
 * The **model-selection builder** for a [`Server`](Server.cajeta) — plan
 * item **NET-4.5**. It is the single fluent surface a caller uses to
 * pick *which* of the two shipped accept stacks (Model A —
 * fiber-per-connection, or Model B — event-driven shared-pool) a server
 * uses, without naming the concrete [`Server`](Server.cajeta) /
 * [`SharedPoolServer`](SharedPoolServer.cajeta) class directly:
 *
 * ```cajeta
 * // Model A — fiber-per-connection (the default):
 * Server.builder()
 *     .bind("0.0.0.0:8080")
 *     .model(ServerModel.fiberPerConnection())
 *     .handler((conn) -> handle(conn))
 *     .serve();
 *
 * // Model B — event-driven shared-pool of 8 workers:
 * Server.builder()
 *     .bind("0.0.0.0:8080")
 *     .model(ServerModel.sharedPool(8))
 *     .handler((conn) -> handle(conn))
 *     .serve();
 * ```
 *
 * which mirror the spec's `.model(FiberPerConnection)` and
 * `.model(SharedPool(8))` (see
 * [`docs/Net.md` §Server accept models](../../../../../docs/Net.md#server-accept-models)).
 *
 * ## The selection seam
 *
 * The builder is a thin **selector** over the two factories the
 * dependency items already ship — it adds *no* new accept logic:
 *
 *   - [`ServerModel.fiberPerConnection()`](ServerModel.cajeta#fiberPerConnection)
 *     → [`Server.bind`](Server.cajeta#bind) (Model A, NET-4.2);
 *   - [`ServerModel.sharedPool(n)`](ServerModel.cajeta#sharedPool)
 *     → [`SharedPoolServer.bind`](SharedPoolServer.cajeta#bind) sized to
 *     `n` (Model B, NET-4.3).
 *
 * Because [`SharedPoolServer extends Server`](SharedPoolServer.cajeta),
 * [`build`](#build) returns a [`Server`](Server.cajeta) either way and
 * the caller drives the same `serve()` / `shutdown()` surface — the
 * model's accept-loop differences dispatch through the vtable. The
 * builder is the *only* place a build decides between the two; nothing
 * downstream needs to know which model is live.
 *
 * ## Defaults
 *
 *   - **model** — [`fiberPerConnection`](ServerModel.cajeta#fiberPerConnection)
 *     (Model A), so an unspecified `.model(...)` is the simplest, lowest-
 *     latency stack, matching the spec's "Simple, the default."
 *   - **backlog** — [`UNSET_BACKLOG`](#UNSET_BACKLOG): the
 *     [`TcpListener`](TcpListener.cajeta) platform default listen
 *     backlog. A `.backlog(n)` override routes through the
 *     `bindWithBacklog` factories (the NET-4.4 accept-queue knob the
 *     core already honors).
 *
 * ## Required steps
 *
 * [`bind`](#bind) (or [`bindAddress`](#bindAddress)) and
 * [`handler`](#handler) are required; [`build`](#build) / [`serve`](#serve)
 * raise a [`MalformedAddressException`](MalformedAddressException.cajeta)
 * (no address) or return without serving (no handler) if a required
 * step was skipped — see [`build`](#build).
 *
 * This is a **pure value type** until [`build`](#build) is called (no
 * I/O — it just records the choices), so the model-selection logic
 * tests directly: which concrete server a given builder configuration
 * produces.
 */
public class ServerBuilder {
    /**
     * Sentinel [`backlog`](#backlog) meaning "no explicit backlog" — use
     * the [`TcpListener`](TcpListener.cajeta) platform default. Any
     * value `< 1` is treated as unset.
     */
    public static final int32 UNSET_BACKLOG = 0;

    /**
     * The bound address, set by [`bind`](#bind) /
     * [`bindAddress`](#bindAddress). `null` until one is supplied;
     * [`build`](#build) requires it.
     */
    public SocketAddress address;

    /**
     * The accept model — defaults to
     * [`ServerModel.fiberPerConnection()`](ServerModel.cajeta#fiberPerConnection)
     * (Model A). Replaced by [`model`](#model).
     */
    public ServerModel serverModel;

    /**
     * The per-connection handler, `(TcpStream) -> void`. `null` until
     * [`handler`](#handler) supplies one; [`build`](#build) requires it.
     */
    public (TcpStream) -> void handler;

    /**
     * The explicit `listen(2)` backlog, or [`UNSET_BACKLOG`](#UNSET_BACKLOG)
     * for the platform default. Set by [`backlog`](#backlog).
     */
    public int32 backlog;

    /**
     * Internal ctor — user code goes through
     * [`Server.builder()`](Server.cajeta#builder). Starts with the
     * default model (fiber-per-connection), no address, no handler, and
     * the unset (platform-default) backlog.
     *
     * @EntryPoint
     */
    public ServerBuilder() {
        this.address = null;
        this.serverModel = ServerModel.fiberPerConnection();
        this.handler = null;
        this.backlog = ServerBuilder.UNSET_BACKLOG;
    }

    // ----- fluent configuration --------------------------------------------

    /**
     * Bind to `addr` — a `host:port` (or `[v6]:port`) string parsed via
     * [`SocketAddress.parse`](SocketAddress.cajeta#parse) (so a
     * malformed address raises a citing
     * [`MalformedAddressException`](MalformedAddressException.cajeta)
     * here, at configuration time). Port `0` ⇒ an ephemeral port,
     * readable after [`build`](#build) via
     * [`Server.localAddress`](Server.cajeta#localAddress).
     *
     * @return `this`, for chaining.
     */
    public ServerBuilder bind(String addr) {
        this.address = SocketAddress.parse(addr);
        return this;
    }

    /**
     * Bind to an already-parsed [`SocketAddress`](SocketAddress.cajeta).
     * The pre-parsed sibling of [`bind`](#bind) for callers that already
     * hold an address value.
     *
     * @return `this`, for chaining.
     */
    public ServerBuilder bindAddress(SocketAddress addr) {
        this.address #= addr;
        return this;
    }

    /**
     * Select the accept [`model`](ServerModel.cajeta) — Model A via
     * [`ServerModel.fiberPerConnection()`](ServerModel.cajeta#fiberPerConnection)
     * or Model B via [`ServerModel.sharedPool(n)`](ServerModel.cajeta#sharedPool).
     * A `null` selection is ignored (the default fiber-per-connection
     * model stays in place), so `.model(...)` can never null out the
     * model.
     *
     * @return `this`, for chaining.
     */
    public ServerBuilder model(ServerModel m) {
        if (m != null) {
            this.serverModel #= m;
        }
        return this;
    }

    /**
     * Set the per-connection [`handler`](Server.cajeta#handler),
     * `(TcpStream) -> void`: invoked once per accepted connection with
     * the owned [`TcpStream`](TcpStream.cajeta); it owns + closes the
     * stream. Required before [`build`](#build).
     *
     * @return `this`, for chaining.
     */
    public ServerBuilder handler((TcpStream) -> void h) {
        this.handler = h;
        return this;
    }

    /**
     * Set an explicit `listen(2)` [`backlog`](#backlog) (the accept-queue
     * depth, the NET-4.4 config knob the core already honors via
     * [`Server.bindWithBacklog`](Server.cajeta#bindWithBacklog)). A
     * value `< 1` resets to the platform default
     * ([`UNSET_BACKLOG`](#UNSET_BACKLOG)).
     *
     * @return `this`, for chaining.
     */
    public ServerBuilder backlog(int32 backlog) {
        if (backlog < 1) {
            this.backlog = ServerBuilder.UNSET_BACKLOG;
        } else {
            this.backlog = backlog;
        }
        return this;
    }

    // ----- terminal: build / serve -----------------------------------------

    /**
     * Build the configured [`Server`](Server.cajeta) — the
     * **model-selection seam**. Delegates to the selected
     * [`serverModel`](#serverModel)'s own materialization branch
     * ([`ServerModel.bindServer`](ServerModel.cajeta#bindServer), or
     * [`bindServerWithBacklog`](ServerModel.cajeta#bindServerWithBacklog)
     * if a [`backlog`](#backlog) was set), so the *single* place that
     * decides between the two accept stacks lives on the model:
     *
     *   - a [`SHARED_POOL_KIND`](ServerModel.cajeta#SHARED_POOL_KIND)
     *     model → a [`SharedPoolServer`](SharedPoolServer.cajeta) sized to
     *     the model's [`poolSize`](ServerModel.cajeta#poolSize) — Model B;
     *   - a [`FIBER_PER_CONNECTION_KIND`](ServerModel.cajeta#FIBER_PER_CONNECTION_KIND)
     *     model → a plain [`Server`](Server.cajeta) — Model A.
     *
     * Both paths return a [`Server`](Server.cajeta) (a
     * [`SharedPoolServer`](SharedPoolServer.cajeta) *is-a*
     * [`Server`](Server.cajeta)), so the caller's `serve()` / `shutdown()`
     * dispatch polymorphically to the live model's overrides.
     *
     * Requires [`bind`](#bind) (an address) — a missing address surfaces
     * a citing
     * [`MalformedAddressException`](MalformedAddressException.cajeta). The
     * [`handler`](#handler) is required at [`serve`](#serve) time (a
     * server with a `null` handler can be built but must not be served);
     * the factory wires whatever handler is set.
     *
     * @return an owned, bound — but not yet serving — server of the
     *         selected model.
     * @EntryPoint
     */
    public #Server build() {
        if (this.address == null) {
            throw heap MalformedAddressException(
                "Server.builder(): no bind address — call .bind(addr) first",
                (int64) -1);
        }
        if (this.backlog >= 1) {
            return this.serverModel.bindServerWithBacklog(
                this.address, this.backlog, this.handler);
        }
        return this.serverModel.bindServer(this.address, this.handler);
    }

    /**
     * Terminal convenience: [`build`](#build) the selected server, then
     * run its accept loop **synchronously** on the calling fiber via
     * [`Server.serve`](Server.cajeta#serve) (which dispatches to the live
     * model's accept loop — Model A's fiber-per-connection or Model B's
     * accept-loop-plus-worker-pool). Returns when the server stops (a
     * concurrent [`shutdown`](Server.cajeta#shutdown) latched the drain).
     *
     * For the spawn-the-accept-loop-and-keep-control shape, prefer
     * `spawn builder.build().runAsync()` so the caller retains the
     * server reference to call [`shutdown`](Server.cajeta#shutdown) on.
     */
    public void serve() {
        Server s #= this.build();
        s.serve();
    }
}
