package cajeta.io.net.ws;

import cajeta.lang.String;

/**
 * A peer sent bytes that violate the **RFC 6455 framing rules** — the
 * fault the WebSocket frame codec ([`WsFrameDecoder`](WsFrameDecoder.cajeta),
 * **NET-10.3**) raises when an incoming frame is not a legal frame. Per
 * RFC 6455 §5 the receiving endpoint MUST *Fail the WebSocket
 * Connection* (close code `1002` — "protocol error") on any of:
 *
 *   - a **reserved opcode** (`0x3`–`0x7` non-control, `0xB`–`0xF`
 *     control) — RFC 6455 §5.2;
 *   - a non-zero **RSV1/RSV2/RSV3** bit with no negotiated extension
 *     (`permessage-deflate` is deferred, so any RSV bit is a violation
 *     for now) — RFC 6455 §5.2;
 *   - a **client→server frame that is not masked**, or (symmetrically) a
 *     server→client frame that *is* masked — RFC 6455 §5.1 / §5.3;
 *   - a **fragmented control frame** (`FIN == 0` on opcode `0x8`–`0xA`)
 *     or a control frame with a payload longer than `125` bytes —
 *     RFC 6455 §5.5;
 *   - a 64-bit payload length whose **high bit is set** (the most
 *     significant bit MUST be `0`) — RFC 6455 §5.2.
 *
 * Carries the byte [`position`](#position) within the frame stream where
 * the violation was detected, mirroring the offset-citing discipline of
 * [`MalformedUriException`](../uri/MalformedUriException.cajeta) and the
 * HTTP body decoder's
 * [`InvalidChunkEncodingException`](../http/InvalidChunkEncodingException.cajeta).
 *
 * A [`WebSocketException`](WebSocketException.cajeta), so it inherits the
 * `kind == NetException.KIND_INVALID` (12) discriminant — see that
 * type's doc for the family rationale. The other WS leaves
 * (`HandshakeRejected`, `MessageTooLarge`, `ConnectionClosed`) land with
 * **NET-10.8**; this one ships with the codec it is raised by.
 */
public class ProtocolViolationException extends WebSocketException {
    /**
     * Byte offset within the frame stream at which the violation was
     * detected (`-1` when no meaningful position applies).
     */
    public int64 position;

    public ProtocolViolationException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;            // NetException.KIND_INVALID
        this.position = (int64) -1;
    }

    public ProtocolViolationException(String message, int64 position) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;            // NetException.KIND_INVALID
        this.position = position;
    }
}
