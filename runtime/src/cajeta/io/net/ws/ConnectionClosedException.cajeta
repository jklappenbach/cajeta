package cajeta.io.net.ws;

import cajeta.lang.String;

/**
 * The **WebSocket connection has closed** — raised on a
 * [`receive`](WebSocket.cajeta) / [`send`](WebSocket.cajeta) against a
 * connection whose close handshake (RFC 6455 §7) has completed (or whose
 * transport dropped without one). It is the WS analogue of an
 * end-of-stream: once the peer's `CLOSE` frame is seen (or the socket is
 * gone), every further data operation raises this so a reader loop
 * (`while (true) { ws.receive(); }`) terminates cleanly with the close
 * reason in hand rather than spinning.
 *
 * ## The carried close code (RFC 6455 §7.4)
 *
 * Carries the [`closeCode`](#closeCode) the close handshake reported and
 * the optional UTF-8 [`reason`](#reason). The code is one of the
 * [`WsCloseCode`](WsCloseCode.cajeta) constants:
 *
 *   - a **clean** close — the peer sent a `CLOSE` frame with a status code
 *     ([`WsCloseCode.NORMAL`](WsCloseCode.cajeta) `1000`,
 *     [`GOING_AWAY`](WsCloseCode.cajeta) `1001`, …) and an optional
 *     reason; [`isClean`](#isClean) is `true`;
 *   - a **no-status** close — the peer sent an empty `CLOSE` frame (no
 *     code); [`closeCode`](#closeCode) is
 *     [`WsCloseCode.NO_STATUS`](WsCloseCode.cajeta) (`1005`),
 *     [`isClean`](#isClean) is `true` (a close frame *was* exchanged);
 *   - an **abnormal** close — the transport dropped with no `CLOSE` frame
 *     (a TCP reset / truncated read); [`closeCode`](#closeCode) is
 *     [`WsCloseCode.ABNORMAL`](WsCloseCode.cajeta) (`1006`),
 *     [`isClean`](#isClean) is `false`.
 *
 * This lets a caller distinguish "the peer closed normally, stop reading"
 * (`closeCode == 1000`) from "the peer failed the connection on a
 * protocol error" (`closeCode == 1002`) or "the connection was cut"
 * (`closeCode == 1006`) — the discriminant the
 * [`docs/specification/io/net/Errors.md`](../../../../../docs/specification/io/net/Errors.md)
 * chart names ("`ConnectionClosed` carries the close code") and the plan
 * acceptance row `closeHandshakeReportsCode` checks.
 *
 * ## Hierarchy + the inherited `kind`
 *
 * A [`WebSocketException`](WebSocketException.cajeta), so it is catchable
 * as the WS family root (or the [`NetException`](../NetException.cajeta)
 * root). A connection close is not a "the peer sent garbage" parse fault
 * like its siblings — it is the orderly (or abrupt) end of the stream —
 * so it sets the inherited `kind` to
 * [`NetException.KIND_OTHER`](../NetException.cajeta) (99) rather than
 * `KIND_INVALID` (12). A caller discriminates a close by its **type** (or
 * its [`closeCode`](#closeCode)), not the coarse `kind`; the `99` keeps
 * the `e.kind` branch total while signalling "this is not an invalid-input
 * fault." (A clean `1000` close is, after all, the expected lifecycle
 * end, surfaced as a recoverable exception so the reader loop unwinds.)
 *
 * ## Construction
 *
 * Like every `cajeta.io.net` subtype (and per
 * [`cajeta.error.Throwable`](../../error/Throwable.cajeta)'s contract,
 * "each subclass repeats the field assignment"), this does **not** chain
 * through a `super(...)` call — it sets the inherited
 * `message`/`cause`/`kind` fields plus its own
 * [`closeCode`](#closeCode)/[`reason`](#reason)/[`isClean`](#isClean)
 * directly, mirroring
 * [`MessageTooLargeException`](MessageTooLargeException.cajeta)'s shape.
 * The `(message)` constructor exists for an abnormal close with no code;
 * it stamps [`closeCode`](#closeCode) =
 * [`WsCloseCode.ABNORMAL`](WsCloseCode.cajeta) (`1006`) and
 * [`isClean`](#isClean) = `false`.
 */
public class ConnectionClosedException extends WebSocketException {
    /**
     * The RFC 6455 §7.4 close code the close handshake reported — a
     * [`WsCloseCode`](WsCloseCode.cajeta) constant. [`WsCloseCode.NO_STATUS`](WsCloseCode.cajeta)
     * (`1005`) when a close frame arrived with no code;
     * [`WsCloseCode.ABNORMAL`](WsCloseCode.cajeta) (`1006`) when the
     * transport dropped with no close frame at all.
     */
    public int32 closeCode;

    /**
     * The optional UTF-8 reason phrase the peer included in its close
     * frame, or **null** when none was sent (an empty-payload or
     * code-only close). A caller tests `reason != null` before using it.
     */
    public String reason;

    /**
     * `true` when a `CLOSE` frame was actually exchanged (a clean
     * close, even a [`WsCloseCode.NO_STATUS`](WsCloseCode.cajeta) one);
     * `false` for an abnormal close where the transport dropped without a
     * close frame ([`WsCloseCode.ABNORMAL`](WsCloseCode.cajeta) `1006`).
     */
    public boolean isClean;

    /**
     * An **abnormal** close — the transport dropped without a `CLOSE`
     * frame. Stamps [`closeCode`](#closeCode) =
     * [`WsCloseCode.ABNORMAL`](WsCloseCode.cajeta) (`1006`),
     * [`isClean`](#isClean) = `false`, and a null reason.
     */
    public ConnectionClosedException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 99;            // NetException.KIND_OTHER — a stream end, not an invalid-input fault
        this.closeCode = 1006;     // WsCloseCode.ABNORMAL
        this.reason = null;        // no reason phrase
        this.isClean = false;
    }

    /**
     * A **clean** close with an explicit close code (and a null reason).
     * [`isClean`](#isClean) is `true` — a `CLOSE` frame was exchanged.
     */
    public ConnectionClosedException(String message, int32 closeCode) {
        this.message = message;
        this.cause = 0;
        this.kind = 99;            // NetException.KIND_OTHER
        this.closeCode = closeCode;
        this.reason = null;        // no reason phrase
        this.isClean = true;
    }

    /**
     * A **clean** close carrying both the close code and the peer's UTF-8
     * reason phrase. [`isClean`](#isClean) is `true`.
     */
    public ConnectionClosedException(String message, int32 closeCode, String reason) {
        this.message = message;
        this.cause = 0;
        this.kind = 99;            // NetException.KIND_OTHER
        this.closeCode = closeCode;
        this.reason = reason;
        this.isClean = true;
    }
}
