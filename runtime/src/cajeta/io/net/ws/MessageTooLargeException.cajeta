package cajeta.io.net.ws;

import cajeta.lang.String;

/**
 * A peer's **reassembled message exceeded the configured maximum size** —
 * the fault the fragmentation layer
 * ([`WsMessageAssembler`](WsMessageAssembler.cajeta), **NET-10.4**) raises
 * when the running total of a message's data + continuation frames passes
 * the [`WsMessageAssembler.maxMessageLength`](WsMessageAssembler.cajeta)
 * cap. It is the *message*-level guard, distinct from the *frame*-level
 * [`WsFrameDecoder`](WsFrameDecoder.cajeta) cap (which bounds one frame):
 * a hostile peer can stay under the per-frame limit yet stream an
 * unbounded number of small continuation frames, so reassembly enforces a
 * total-bytes ceiling and fails the connection (RFC 6455 §7.4.1 close
 * code `1009` — "Message Too Big") when it is crossed.
 *
 * Carries the [`limit`](#limit) that was exceeded so a handler can report
 * or log it, mirroring the offset-citing discipline of
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta) and
 * the HTTP [`HeadersTooLargeException`](../http/HeadersTooLargeException.cajeta).
 *
 * A [`WebSocketException`](WebSocketException.cajeta), so it inherits the
 * `kind == NetException.KIND_INVALID` (12) discriminant — a single
 * `catch (NetException e)` branching on `e.kind == 12` nets "the peer
 * sent something out of bounds" across the URI, HTTP, and WebSocket
 * families alike. **NET-10.8** owns the full WS error hierarchy
 * (`HandshakeRejected`, `ConnectionClosed` carrying the close code); this
 * leaf lands with the fragmentation layer that raises it, exactly as
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta)
 * shipped with the frame codec (**NET-10.3**) it is raised by.
 */
public class MessageTooLargeException extends WebSocketException {
    /**
     * The configured maximum message size (bytes) that was exceeded
     * (`-1` when no specific limit applies).
     */
    public int64 limit;

    public MessageTooLargeException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;            // NetException.KIND_INVALID
        this.limit = (int64) -1;
    }

    public MessageTooLargeException(String message, int64 limit) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;            // NetException.KIND_INVALID
        this.limit = limit;
    }
}
