package cajeta.io.net.ws;

/**
 * The **RFC 6455 §7.4.1 WebSocket close codes** — the 2-byte unsigned
 * status code an endpoint MAY place at the front of a
 * [`WsOpcode.CLOSE`](WsOpcode.cajeta) frame's payload to explain why the
 * connection is closing. A pure constants + classifiers holder (no
 * instances), the close-handshake analogue of
 * [`WsOpcode`](WsOpcode.cajeta), used by
 * [`ConnectionClosedException`](ConnectionClosedException.cajeta) (the
 * close code it carries) and — when it lands — the close handshake
 * (**NET-10.5**).
 *
 * ## The code space (RFC 6455 §7.4)
 *
 * Codes are partitioned into ranges:
 *
 *   - **`1000`–`2999`** — reserved for the RFC and IANA registry (the
 *     named constants below live here).
 *   - **`3000`–`3999`** — registered with IANA, for libraries/frameworks.
 *   - **`4000`–`4999`** — private use, for an application.
 *
 * The named codes (RFC 6455 §7.4.1):
 *
 *   - **`1000` normal** — the purpose for which the connection was
 *     established has been fulfilled.
 *   - **`1001` going away** — a server is shutting down or a browser is
 *     navigating away.
 *   - **`1002` protocol error** — the endpoint is terminating because of
 *     a protocol error (the close code a
 *     [`ProtocolViolationException`](ProtocolViolationException.cajeta)
 *     maps to).
 *   - **`1003` unsupported data** — a data type was received the endpoint
 *     cannot accept (e.g. binary to a text-only endpoint).
 *   - **`1007` invalid payload** — a message contained data inconsistent
 *     with its type (e.g. non-UTF-8 in a text frame).
 *   - **`1008` policy violation** — a generic "message violated policy"
 *     when no more-specific code fits.
 *   - **`1009` message too big** — a message was received that is too
 *     large to process (the close code a
 *     [`MessageTooLargeException`](MessageTooLargeException.cajeta) maps
 *     to).
 *   - **`1010` mandatory extension** — the client is closing because the
 *     server did not negotiate a required extension.
 *   - **`1011` internal error** — the server encountered an unexpected
 *     condition that prevented it from fulfilling the request.
 *
 * ## Reserved / never-on-the-wire codes (RFC 6455 §7.4.1)
 *
 * Three codes are **reserved**: an endpoint MUST NOT set them as the
 * status code in a close frame — they only ever describe a *local*
 * situation. [`ConnectionClosedException`](ConnectionClosedException.cajeta)
 * uses [`NO_STATUS`](#NO_STATUS) when a close frame arrived carrying *no*
 * code at all:
 *
 *   - **`1005` no status received** — a close frame was received with no
 *     status code (the application observes this; it never appears on the
 *     wire).
 *   - **`1006` abnormal closure** — the connection was closed without a
 *     close frame at all (a TCP reset / truncated read); never on the
 *     wire.
 *   - **`1015` TLS handshake failure** — the connection closed because
 *     the TLS handshake failed; never on the wire.
 */
public class WsCloseCode {
    /** `1000` — normal closure; the connection's purpose was fulfilled. */
    public static final int32 NORMAL              = 1000;
    /** `1001` — endpoint going away (server shutdown / page navigation). */
    public static final int32 GOING_AWAY          = 1001;
    /** `1002` — a protocol error; pairs with `ProtocolViolationException`. */
    public static final int32 PROTOCOL_ERROR      = 1002;
    /** `1003` — a data type was received the endpoint cannot accept. */
    public static final int32 UNSUPPORTED_DATA    = 1003;
    /**
     * `1005` — **reserved**: no status code was actually present in the
     * received close frame. MUST NOT be sent on the wire; used as the
     * carried code when a peer closes with an empty close payload.
     */
    public static final int32 NO_STATUS           = 1005;
    /**
     * `1006` — **reserved**: the connection closed abnormally, with no
     * close frame at all (a TCP-level reset / truncated read). MUST NOT be
     * sent on the wire.
     */
    public static final int32 ABNORMAL            = 1006;
    /** `1007` — a message contained data inconsistent with its type. */
    public static final int32 INVALID_PAYLOAD     = 1007;
    /** `1008` — a generic policy violation (no more-specific code fits). */
    public static final int32 POLICY_VIOLATION    = 1008;
    /** `1009` — message too big to process; pairs with `MessageTooLargeException`. */
    public static final int32 MESSAGE_TOO_BIG     = 1009;
    /** `1010` — the client required an extension the server did not negotiate. */
    public static final int32 MANDATORY_EXTENSION = 1010;
    /** `1011` — the server hit an unexpected internal condition. */
    public static final int32 INTERNAL_ERROR      = 1011;
    /**
     * `1015` — **reserved**: the connection closed because the TLS
     * handshake failed. MUST NOT be sent on the wire.
     */
    public static final int32 TLS_HANDSHAKE       = 1015;

    /**
     * `true` if `code` is a **valid status code an endpoint may place in a
     * close frame** (RFC 6455 §7.4.2): the RFC-defined codes `1000`–`1003`
     * and `1007`–`1011`, plus the whole registered (`3000`–`3999`) and
     * private (`4000`–`4999`) ranges. The reserved / never-on-the-wire
     * codes — `1004` (reserved, undefined), [`NO_STATUS`](#NO_STATUS)
     * `1005`, [`ABNORMAL`](#ABNORMAL) `1006`, [`TLS_HANDSHAKE`](#TLS_HANDSHAKE)
     * `1015` — the undefined `1012`–`2999` band, and any code `< 1000` or
     * `> 4999` are **not** sendable. A close handshake (NET-10.5) that
     * receives an unsendable code as the peer's status MUST fail the
     * connection with a
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta).
     */
    public static boolean isSendable(int32 code) {
        // 1000–1003 + 1007–1011 are the RFC 6455 §7.4.1 defined codes; 1004
        // is reserved/undefined, and 1005/1006 are the never-on-the-wire
        // reserved codes (the 1004–1006 gap is excluded by the two ranges).
        if (code >= 1000 && code <= 1003) {
            return true;
        }
        if (code >= 1007 && code <= 1011) {
            return true;
        }
        // 1012–2999 are reserved for the RFC/IANA registry and not currently
        // defined (so not sendable); 3000–4999 are registered/private.
        if (code >= 3000 && code <= 4999) {
            return true;
        }
        return false;
    }

    /**
     * `true` if `code` lies in the **private-use range** `4000`–`4999`
     * (RFC 6455 §7.4.2) — codes an application may define for its own
     * protocol with no IANA registration.
     */
    public static boolean isPrivateUse(int32 code) {
        return code >= 4000 && code <= 4999;
    }
}
