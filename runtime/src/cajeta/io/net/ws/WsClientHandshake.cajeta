package cajeta.io.net.ws;

import cajeta.lang.String;
import cajeta.codec.Base64;
import cajeta.io.net.Headers;
import cajeta.io.net.uri.Uri;
import cajeta.io.net.http.HttpRequest;
import cajeta.io.net.http.HttpResponse;
import cajeta.io.net.ws.WsServerHandshake;
import cajeta.io.net.ws.HandshakeRejectedException;

/**
 * The **WebSocket client-side opening handshake** (RFC 6455 §4.1) — plan
 * item **NET-10.1**, the mirror of [`WsServerHandshake`](WsServerHandshake.cajeta)
 * (NET-10.2). Given a target [`Uri`](../uri/Uri.cajeta), it **builds** the
 * HTTP/1.1 `Upgrade: websocket` request carrying a fresh
 * `Sec-WebSocket-Key`, and on the server's reply **validates** the
 * `101 Switching Protocols` response's `Sec-WebSocket-Accept` ==
 * `base64(SHA-1(key + GUID))` (RFC 6455 §1.3) — the proof the peer spoke
 * the WebSocket handshake and not an arbitrary `101`.
 *
 * Pure logic — a [`Uri`](../uri/Uri.cajeta) / key in, an
 * [`HttpRequest`](../http/HttpRequest.cajeta) out, and a
 * [`HttpResponse`](../http/HttpResponse.cajeta) + key → `boolean` validation
 * — no sockets. The socket wiring (connect, send the request, read the
 * response, switch to framing) is the NET-10.7 entry point that calls into
 * this, exactly as [`WsServerHandshake`](WsServerHandshake.cajeta) relates to
 * the server upgrade.
 *
 * ## The request (RFC 6455 §4.1)
 *
 * ```
 * GET /path HTTP/1.1
 * Host: host[:port]
 * Upgrade: websocket
 * Connection: Upgrade
 * Sec-WebSocket-Key: <base64 of 16 random bytes>
 * Sec-WebSocket-Version: 13
 * ```
 *
 * The `Host` header + origin-form target come from
 * [`HttpRequest.fromUri`](../http/HttpRequest.cajeta) (NET-7.1).
 *
 * > **Key randomness — scope note.** RFC 6455 §4.1 requires the 16-byte
 * > `Sec-WebSocket-Key` nonce be **freshly random** per connection. A CSPRNG
 * > stdlib source is not yet in the tree, so [`placeholderKey`](#placeholderKey)
 * > derives the 16 bytes from a caller-supplied varying seed — **flagged
 * > not-for-production**, mirroring the placeholder masking key note on
 * > [`WebSocket`](WebSocket.cajeta). The key is **not** a security secret in
 * > the handshake (the server only echoes `SHA-1(key + GUID)`), so a
 * > non-random key does not weaken the handshake's correctness — only its
 * > defense against a cross-protocol cache-poisoning attacker, which the
 * > CSPRNG upgrade (with NET-10.7's productionization) addresses.
 */
public class WsClientHandshake {
    /**
     * Build the client `Upgrade: websocket` request for `uri` with the
     * base64 `key` as `Sec-WebSocket-Key`. The request-target (origin-form)
     * and `Host` header are derived from `uri`
     * ([`HttpRequest.fromUri`](../http/HttpRequest.cajeta)); the four WS
     * handshake headers are added on top.
     */
    public static #HttpRequest buildRequest(Uri uri, String key) {
        HttpRequest r = HttpRequest.fromUri("GET", uri);
        r.setHeader("Upgrade", "websocket");
        r.setHeader("Connection", "Upgrade");
        r.setHeader("Sec-WebSocket-Key", key);
        r.setHeader("Sec-WebSocket-Version", "13");
        return #r;
    }

    /**
     * Validate the server's handshake `response` against the `key` we sent:
     * it must be `101 Switching Protocols` and carry a `Sec-WebSocket-Accept`
     * exactly equal to [`WsServerHandshake.acceptKey`](WsServerHandshake.cajeta#acceptKey)`(key)`
     * (RFC 6455 §4.1 step 5). Returns `true` on a valid upgrade, `false`
     * otherwise (wrong status, missing or mismatched accept token).
     */
    public static boolean validateAccept(HttpResponse response, String key) {
        if (response.statusCode() != 101) {
            return false;
        }
        Headers h = response.getHeaders();
        String got = h.get("Sec-WebSocket-Accept");
        if (got == null) {
            return false;
        }
        String expect = WsServerHandshake.acceptKey(key);
        return got.equals(expect);
    }

    /**
     * Throwing form of [`validateAccept`](#validateAccept): raise
     * [`HandshakeRejectedException`](HandshakeRejectedException.cajeta)
     * (status `400`) when the server's response is not a valid WebSocket
     * upgrade for `key`. The entry point (NET-10.7) calls this so a bad
     * server reply surfaces as the WS error type rather than a silent
     * `false`.
     */
    public static void requireAccept(HttpResponse response, String key) {
        if (!WsClientHandshake.validateAccept(response, key)) {
            throw heap HandshakeRejectedException(
                "server did not complete the WebSocket handshake", 400);
        }
    }

    /**
     * A `Sec-WebSocket-Key` value — the base64 of 16 key bytes derived from
     * `seed` (see the class-doc randomness scope note: a **placeholder**, not
     * a CSPRNG). Distinct `seed`s yield distinct keys, so an entry point
     * varies it per connection.
     */
    public static #String placeholderKey(int32 seed) {
        int8[] raw = heap int8[16];
        int32 x = seed;
        int32 i = 0;
        while (i < 16) {
            // A simple LCG-style byte mixer over the seed + index — varying and
            // deterministic, explicitly NOT cryptographically random (see the
            // class-doc scope note). All constants fit in a signed int32; the
            // multiply is allowed to wrap.
            x = x * 1103515245 + 12345 + i;
            x = x ^ (x >> 7);
            raw[i] = (int8) (x & 255);
            i = i + 1;
        }
        return Base64.encode(raw, (int64) 16);
    }
}
