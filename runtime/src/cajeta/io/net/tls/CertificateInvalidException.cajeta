package cajeta.io.net.tls;

import cajeta.lang.String;

/**
 * The peer's certificate failed verification (**NET-5.3 / 5.6**). The
 * [`reason`](#reason) is one of the [`TlsConnection`](TlsConnection.cajeta)
 * `CERT_*` ordinals — `CERT_EXPIRED`, `CERT_HOSTNAME`, `CERT_UNTRUSTED`, or
 * `CERT_OTHER` — so a caller can distinguish "this server's cert expired" from
 * "I don't trust this root" without parsing the message.
 */
public class CertificateInvalidException extends TlsException {
    /** The `TlsConnection.CERT_*` ordinal describing why verification failed. */
    public int32 reason;

    public CertificateInvalidException(String message, int32 reason) {
        this.message = message;
        this.cause = 0;
        this.kind = 99;   // NetException.KIND_OTHER
        this.reason = reason;
    }

    /** The `TlsConnection.CERT_*` reason ordinal. */
    public int32 getReason() {
        return this.reason;
    }
}
