package cajeta.io.net.http;

import cajeta.lang.String;
import cajeta.io.net.Headers;
import cajeta.io.net.uri.Uri;
import cajeta.io.net.http.PathParams;

/**
 * An HTTP/1.1 **request** message — the request-line triple
 * (*method*, *request-target*, *HTTP-version*), a [`Headers`](../Headers.cajeta)
 * map, and an optional in-memory **body**.
 *
 * This is the request half of the NET-7.1 message model. It is a
 * **pure data type** — no sockets, no native intrinsics — so it tests
 * directly over the JIT (the same discipline as
 * [`Headers`](../Headers.cajeta) and [`Uri`](../uri/Uri.cajeta)). The
 * incremental parser (NET-7.3), body framing (NET-7.4), and serializer
 * (NET-7.5) read and write *through* this type; they are separate plan
 * items and live in their own files.
 *
 * ## The request line
 *
 * ```
 * request-line = method SP request-target SP HTTP-version CRLF
 * ```
 *
 *   - **`method`** — the token verbatim (`"GET"`, `"POST"`, …). HTTP
 *     methods are **case-sensitive** (RFC 7230 §3.1.1), so unlike
 *     header names this is *not* canonicalized — `"get"` and `"GET"`
 *     are distinct tokens, and the registered methods are all
 *     uppercase.
 *   - **`target`** — the request-target. For the common
 *     *origin-form* this is the path + optional query
 *     (`/a/b?x=1&y=2`); the [`fromUri`](#) factory derives it from a
 *     parsed [`Uri`](../uri/Uri.cajeta) (path, or `"/"` when the path
 *     is empty, plus `?query` when present). *absolute-form*,
 *     *authority-form* (CONNECT), and *asterisk-form* (`OPTIONS *`)
 *     are representable by setting the target string directly.
 *   - **`version`** — the protocol version string (`"HTTP/1.1"`,
 *     `"HTTP/1.0"`). Defaults to `"HTTP/1.1"`.
 *
 * ## The body handle
 *
 * NET-7.1 carries the body as an **in-memory byte buffer** (`body` +
 * `hasBody`). This is the representation the serializer (NET-7.5)
 * frames as `Content-Length` and that the parser (NET-7.3/7.4)
 * populates for buffered bodies; the streaming `BodyReader` (NET-7.4)
 * is a later item that layers a pull-stream over the same field. An
 * absent body (`hasBody == false`) means "no message body" — distinct
 * from a present-but-empty body (a zero-length buffer with
 * `hasBody == true`, e.g. an empty `POST`).
 *
 * ## Immutable-ish builder shape
 *
 * Construction is fluent: a [`get`](#) / [`post`](#) / [`fromUri`](#)
 * factory yields a base request, then the chainable mutators
 * (`header`, `body`, `version`) layer fields on. The mutators return
 * the borrowed `this` (the [`JsonWriter`](../../codec/json/JsonWriter.cajeta)
 * chaining convention) so a request reads as one expression:
 *
 * ```cajeta
 * HttpRequest req = HttpRequest.get("/index.html")
 *     .header("Host", "example.test")
 *     .header("Accept", "text/html");
 * ```
 *
 * "Immutable-ish" because the type carries no defensive copies and the
 * fields are publicly readable; once a request is hands-off to the
 * serializer it is treated as frozen by convention, not enforcement.
 */
public class HttpRequest {
    /** Request method token, verbatim + case-sensitive (`"GET"`). */
    public String method;
    /** Request-target (origin-form `"/a/b?x=1"`, or `"*"`, etc.). */
    public String target;
    /** HTTP-version string (`"HTTP/1.1"`). */
    public String version;

    /** The header map. Never null after construction. */
    public Headers headers;

    /**
     * In-memory message body, meaningful only when `hasBody` is true.
     * A zero-length buffer with `hasBody == true` is a present-empty
     * body; `hasBody == false` is no body at all.
     */
    public int8[] body;
    /** True iff this request carries a message body. */
    public boolean hasBody;

    /**
     * Path parameters bound by the [`Router`](Router.cajeta) (NET-9.3)
     * when a route pattern (`/users/{id}`) matched this request's path.
     * `null` until a router dispatches the request (a request that never
     * went through a router carries no path params), so the
     * [`pathParam`](#pathParam) accessor null-checks before reading. The
     * router calls [`bindPathParams`](#bindPathParams) to install the map.
     */
    public PathParams pathParams;

    /**
     * Field-pinning constructor. Leaves the request at safe defaults —
     * `GET`, target `"/"`, `HTTP/1.1`, an empty header map, no body —
     * so a partially-built instance never carries dangling state. The
     * factories (`get`/`post`/`fromUri`) are the ergonomic entry
     * points.
     */
    public HttpRequest() {
        int8[] m = heap int8[3];
        m[0] = (int8) 71;   // 'G'
        m[1] = (int8) 69;   // 'E'
        m[2] = (int8) 84;   // 'T'
        this.method = heap String(#m, 3);
        int8[] t = heap int8[1];
        t[0] = (int8) 47;   // '/'
        this.target = heap String(#t, 1);
        int8[] v = heap int8[8];
        v[0] = (int8) 72;   // 'H'
        v[1] = (int8) 84;   // 'T'
        v[2] = (int8) 84;   // 'T'
        v[3] = (int8) 80;   // 'P'
        v[4] = (int8) 47;   // '/'
        v[5] = (int8) 49;   // '1'
        v[6] = (int8) 46;   // '.'
        v[7] = (int8) 49;   // '1'
        this.version = heap String(#v, 8);
        this.headers = heap Headers();
        int8[] e = heap int8[0];
        this.body = #e;
        this.hasBody = false;
        this.pathParams = null;
    }

    // -- factories ----------------------------------------------------------

    /**
     * A bodyless request with an explicit method + target on
     * `HTTP/1.1`. The method token is taken verbatim (case-sensitive);
     * the target string is taken as-is (origin-form, authority-form,
     * etc.).
     */
    public static #HttpRequest of(String method, String target) {
        HttpRequest r = heap HttpRequest();
        r.method = heap String(method.bytes, method.byteLength);
        r.target = heap String(target.bytes, target.byteLength);
        return #r;
    }

    /** A `GET` request for `target` on `HTTP/1.1`. */
    public static #HttpRequest get(String target) {
        return HttpRequest.of("GET", target);
    }

    /** A `POST` request for `target` on `HTTP/1.1` (set a body next). */
    public static #HttpRequest post(String target) {
        return HttpRequest.of("POST", target);
    }

    /**
     * Build a request from a parsed [`Uri`](../uri/Uri.cajeta),
     * deriving the **origin-form** request-target (path, or `"/"` when
     * the path is empty, with `"?" + query` appended when the URI
     * carried a query) and adding a `Host` header from the URI's host
     * (and `:port` when an explicit non-default port was present).
     *
     * This is the bridge the HTTP client (NET-8) uses to turn a target
     * URL into a wire request.
     */
    public static #HttpRequest fromUri(String method, Uri uri) {
        HttpRequest r = heap HttpRequest();
        r.method = heap String(method.bytes, method.byteLength);
        r.target = HttpRequest.originForm(uri);
        if (uri.hasAuthority) {
            String hostValue = HttpRequest.hostHeader(uri);
            r.headers.set("Host", hostValue);
        }
        return #r;
    }

    /**
     * Derive the origin-form request-target from `uri`:
     * `path [ "?" query ]`, with an empty path normalized to `"/"`
     * (RFC 7230 §5.3.1 — the origin-form path must not be empty).
     */
    private static #String originForm(Uri uri) {
        String path = uri.getPath();
        int32 pathLen = path.byteLength;
        boolean emptyPath = pathLen == 0;
        // path bytes, or a single '/' when the path is empty.
        int32 base = emptyPath ? 1 : pathLen;
        int32 total = base;
        String query = uri.getQuery();
        int32 qLen = 0;
        if (uri.hasQuery) {
            qLen = query.byteLength;
            total = total + 1 + qLen;   // '?' + query bytes
        }
        int8[] out = heap int8[total];
        int32 dst = 0;
        if (emptyPath) {
            out[dst] = (int8) 47;       // '/'
            dst = dst + 1;
        } else {
            int32 i = 0;
            while (i < pathLen) {
                out[dst] = path.byteAt(i);
                dst = dst + 1;
                i = i + 1;
            }
        }
        if (uri.hasQuery) {
            out[dst] = (int8) 63;       // '?'
            dst = dst + 1;
            int32 j = 0;
            while (j < qLen) {
                out[dst] = query.byteAt(j);
                dst = dst + 1;
                j = j + 1;
            }
        }
        return heap String(#out, total);
    }

    /**
     * Build the `Host` header value from `uri`: the host, plus
     * `":" + port` when the authority carried an **explicit** port
     * (an implicit scheme-default port is omitted, per RFC 7230
     * §5.4 — `Host` reflects what the client targeted).
     */
    private static #String hostHeader(Uri uri) {
        String host = uri.getHost();
        int32 hLen = host.byteLength;
        if (!uri.hasExplicitPort) {
            return heap String(host.bytes, hLen);
        }
        // host ":" decimal-port
        String portStr = HttpRequest.decimal(uri.getPort());
        int32 pLen = portStr.byteLength;
        int32 total = hLen + 1 + pLen;
        int8[] out = heap int8[total];
        int32 dst = 0;
        int32 i = 0;
        while (i < hLen) {
            out[dst] = host.byteAt(i);
            dst = dst + 1;
            i = i + 1;
        }
        out[dst] = (int8) 58;           // ':'
        dst = dst + 1;
        int32 j = 0;
        while (j < pLen) {
            out[dst] = portStr.byteAt(j);
            dst = dst + 1;
            j = j + 1;
        }
        return heap String(#out, total);
    }

    /**
     * Render a non-negative `int32` as its decimal ASCII string. Used
     * for the `Host` port suffix. (A dedicated number→string is a
     * `cajeta.lang` concern; this local keeps NET-7.1 self-contained
     * without taking a dependency that may not be wired for the JIT
     * codec layer yet.)
     */
    private static #String decimal(int32 value) {
        if (value == 0) {
            int8[] z = heap int8[1];
            z[0] = (int8) 48;           // '0'
            return heap String(#z, 1);
        }
        // Count digits.
        int32 digits = 0;
        int32 t = value;
        while (t > 0) {
            digits = digits + 1;
            t = t / 10;
        }
        int8[] out = heap int8[digits];
        int32 i = digits - 1;
        int32 v = value;
        while (v > 0) {
            int32 d = v % 10;
            out[i] = (int8) (48 + d);
            v = v / 10;
            i = i - 1;
        }
        return heap String(#out, digits);
    }

    // -- chainable mutators -------------------------------------------------

    /**
     * Append a `(name, value)` header (multi-value, order-preserving —
     * see [`Headers.add`](../Headers.cajeta)) and return the borrowed
     * `this` for chaining. Use [`setHeader`](#) for last-write-wins.
     */
    public HttpRequest header(String name, String value) {
        this.headers.add(name, value);
        return this;
    }

    /**
     * Set a header last-write-wins (see
     * [`Headers.set`](../Headers.cajeta)) and return `this`.
     */
    public HttpRequest setHeader(String name, String value) {
        this.headers.set(name, value);
        return this;
    }

    /**
     * Attach an in-memory body (a fresh owned copy of `data`'s
     * `length` bytes) and return `this`. Sets `hasBody`. The
     * serializer (NET-7.5) frames this as `Content-Length: length`.
     */
    public HttpRequest body(int8[] data, int32 length) {
        int8[] copy = heap int8[length];
        int32 i = 0;
        while (i < length) {
            copy[i] = data[i];
            i = i + 1;
        }
        this.body = #copy;
        this.hasBody = true;
        return this;
    }

    /** Override the HTTP-version string and return `this`. */
    public HttpRequest version(String v) {
        this.version = heap String(v.bytes, v.byteLength);
        return this;
    }

    // -- accessors ----------------------------------------------------------

    /** The method token (`"GET"`). */
    public String getMethod() {
        return this.method;
    }

    /** The request-target. */
    public String getTarget() {
        return this.target;
    }

    /** The HTTP-version string. */
    public String getVersion() {
        return this.version;
    }

    /** The header map (live; mutating it mutates the request). */
    public Headers getHeaders() {
        return this.headers;
    }

    /** Length of the in-memory body, or 0 when `hasBody` is false. */
    public int32 bodyLength() {
        if (!this.hasBody) {
            return 0;
        }
        return this.body.count();
    }

    // -- path params (NET-9.3) ----------------------------------------------

    /**
     * Install the path-parameter bindings a [`Router`](Router.cajeta)
     * (NET-9.3) extracted from a matched route pattern (`/users/{id}` over
     * `/users/42` binds `id -> "42"`). Takes ownership of `params`. The
     * router calls this once, right before invoking the matched handler,
     * so the handler can read [`pathParam`](#pathParam).
     */
    public void bindPathParams(#PathParams params) {
        this.pathParams = params;
    }

    /**
     * The value of the path parameter `name` the matched route bound, or
     * `null` when there is no such parameter (the route had no `{name}`
     * segment, or the request never went through a router). The value is
     * **percent-decoded** — the [`Router`](Router.cajeta) decodes captured
     * segments before binding. Mirrors the `req.pathParam("id")` surface
     * in `docs/Net.md`'s HTTP-server example.
     */
    public #String pathParam(String name) {
        if (this.pathParams == null) {
            return null;
        }
        return this.pathParams.get(name);
    }
}
