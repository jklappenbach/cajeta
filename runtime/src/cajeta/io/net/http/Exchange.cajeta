package cajeta.io.net.http;

import cajeta.io.net.http.HttpResponse;

/**
 * The result of one HTTP **request/response exchange** the
 * [`HttpServer`](HttpServer.cajeta) connection loop (NET-9.1) produces: the
 * [`HttpResponse`](HttpResponse.cajeta) to send (with its `Connection`
 * header already stamped to match the reuse decision) plus the
 * **keep-alive** verdict — whether the connection may be reused for the
 * next request.
 *
 * It is a tiny **immutable carrier** — the two values the loop threads from
 * "handle this request" to "write the response, then continue or close."
 * The server's pure-logic byte path
 * ([`HttpServer.handleRequest`](HttpServer.cajeta#handleRequest)) returns
 * one of these so a golden test can inspect both the response fields and
 * the reuse decision off a single call.
 */
public class Exchange {
    /**
     * The response to write back, fully built and with its `Connection`
     * header stamped to match [`keepAlive`](#keepAlive). Owned by this
     * carrier.
     */
    public HttpResponse response;

    /**
     * `true` iff the connection may be **reused** for the next request
     * (both sides permitted keep-alive); `false` if it must be closed after
     * this response. The loop's continue-vs-close gate.
     */
    public boolean keepAlive;

    /** Pin the response (taking ownership) + the reuse decision. */
    public Exchange(#HttpResponse response, boolean keepAlive) {
        this.response = #response;
        this.keepAlive = keepAlive;
    }

    /** The response to send. */
    public HttpResponse getResponse() {
        return this.response;
    }

    /** Whether the connection may be reused after this exchange. */
    public boolean isKeepAlive() {
        return this.keepAlive;
    }
}
