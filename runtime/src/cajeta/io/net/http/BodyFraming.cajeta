package cajeta.io.net.http;

/**
 * The **body-framing decision** the incremental parser
 * ([`HttpParser`](HttpParser.cajeta), NET-7.3) emits once the message
 * head is complete: *how the body that follows the head is delimited*.
 * NET-7.3 produces this decision; the streaming `BodyReader` that
 * actually consumes the body per the decision is NET-7.4 — so this type
 * is the clean hand-off boundary between the two plan items.
 *
 * ## The four framings (RFC 7230 §3.3.3)
 *
 *   - **`KIND_NONE`** — there is **no** message body. This is the
 *     framing for a head with neither `Content-Length` nor
 *     `Transfer-Encoding: chunked`, and the mandated framing for a
 *     `HEAD` response, any `1xx`, a `204`, and a `304` regardless of
 *     headers. `length` is `0`.
 *   - **`KIND_CONTENT_LENGTH`** — the body is exactly `length` bytes
 *     (the decimal `Content-Length` value). The reader consumes that
 *     many bytes.
 *   - **`KIND_CHUNKED`** — `Transfer-Encoding: chunked`; the body is a
 *     sequence of size-prefixed chunks terminated by a zero-size chunk.
 *     `length` is `-1` (unknown up front). Chunked **takes precedence**
 *     over `Content-Length` when both appear (RFC 7230 §3.3.3 rule 3),
 *     and the conflicting `Content-Length` is treated as unreliable.
 *   - **`KIND_CLOSE`** — the body runs until the connection closes
 *     (a *response* with neither length nor chunked framing and not a
 *     bodyless status). `length` is `-1`. A *request* with no framing
 *     headers has no body (`KIND_NONE`), never close-delimited — a
 *     server must not wait for EOF on a request body.
 *
 * ## `keepAlive`
 *
 * Carries the parser's connection-reuse read of the head (HTTP/1.1
 * default keep-alive unless `Connection: close`; HTTP/1.0 default close
 * unless `Connection: keep-alive`). The full keep-alive *policy*
 * (deciding reuse-vs-close across request+response) is NET-7.6; this
 * field is the per-message signal that item builds on. A `KIND_CLOSE`
 * body framing implies `keepAlive == false` (the connection-close *is*
 * the body delimiter).
 *
 * A **pure value type** — no I/O — tested directly over the JIT.
 */
public class BodyFraming {
    public static final int32 KIND_NONE           = 0;
    public static final int32 KIND_CONTENT_LENGTH = 1;
    public static final int32 KIND_CHUNKED        = 2;
    public static final int32 KIND_CLOSE          = 3;

    /** One of the `KIND_*` discriminants above. */
    public int32 kind;
    /**
     * Body length in bytes for `KIND_CONTENT_LENGTH`; `-1` for
     * `KIND_CHUNKED` / `KIND_CLOSE` (unknown up front); `0` for
     * `KIND_NONE`.
     */
    public int64 length;
    /** The per-message connection-reuse signal (see the type doc). */
    public boolean keepAlive;

    /** Field-pinning constructor: no body, length 0, keep-alive true. */
    public BodyFraming() {
        this.kind = 0;          // KIND_NONE
        this.length = (int64) 0;
        this.keepAlive = true;
    }

    public static #BodyFraming none(boolean keepAlive) {
        BodyFraming f = heap BodyFraming();
        f.kind = 0;             // KIND_NONE
        f.length = (int64) 0;
        f.keepAlive = keepAlive;
        return #f;
    }

    public static #BodyFraming contentLength(int64 length, boolean keepAlive) {
        BodyFraming f = heap BodyFraming();
        f.kind = 1;             // KIND_CONTENT_LENGTH
        f.length = length;
        f.keepAlive = keepAlive;
        return #f;
    }

    public static #BodyFraming chunked(boolean keepAlive) {
        BodyFraming f = heap BodyFraming();
        f.kind = 2;             // KIND_CHUNKED
        f.length = (int64) -1;
        f.keepAlive = keepAlive;
        return #f;
    }

    public static #BodyFraming closeDelimited() {
        BodyFraming f = heap BodyFraming();
        f.kind = 3;             // KIND_CLOSE
        f.length = (int64) -1;
        f.keepAlive = false;    // connection-close IS the delimiter
        return #f;
    }

    public boolean isNone()          { return this.kind == 0; }
    public boolean isContentLength() { return this.kind == 1; }
    public boolean isChunked()       { return this.kind == 2; }
    public boolean isClose()         { return this.kind == 3; }
}
