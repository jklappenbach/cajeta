package cajeta.io.net.http;

import cajeta.lang.String;
import cajeta.io.net.ByteChannel;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.dns.Dns;
import cajeta.io.net.dns.ResolveFamily;
import cajeta.io.net.tls.TlsStream;
import cajeta.io.net.uri.Uri;
import cajeta.io.net.http.HttpRequest;
import cajeta.io.net.http.HttpResponse;
import cajeta.io.net.http.HttpParser;
import cajeta.io.net.http.HttpSerializer;
import cajeta.io.net.http.BodyReader;
import cajeta.io.net.http.BodyFraming;

/**
 * The **HTTP/1.1 client** — plan item **NET-8.1**. It drives one
 * request/response exchange over an **async, TLS-or-plaintext** byte
 * channel, composing the layers below it with no new wire code of its own:
 *
 *   1. **resolve** the target host (NET-2 [`Dns`](../dns/Dns.cajeta) — numeric
 *      literals and names both),
 *   2. **connect** a non-blocking [`TcpStream`](../TcpStream.cajeta)
 *      (NET-3.3, fiber-parking),
 *   3. for `https://`, **wrap** it in a verifying
 *      [`TlsStream`](../tls/TlsStream.cajeta) (NET-5) offering ALPN
 *      `http/1.1`,
 *   4. **serialize** the request ([`HttpSerializer`](HttpSerializer.cajeta),
 *      NET-7.5) through a buffered [`AsyncWriter`](../AsyncWriter.cajeta),
 *   5. **parse** the response ([`HttpParser`](HttpParser.cajeta) +
 *      [`BodyReader`](BodyReader.cajeta), NET-7.3/7.4) off a buffered
 *      [`AsyncReader`](../AsyncReader.cajeta).
 *
 * The plaintext-vs-TLS choice is invisible to steps 4–5: both transports
 * satisfy [`ByteChannel`](../ByteChannel.cajeta), so the buffered reader/
 * writer — and therefore the whole exchange — are byte-for-byte identical
 * over `http://` and `https://`. That seam is the NET-8.1/NET-9.5 keystone.
 *
 * ```cajeta
 * HttpClient client = heap HttpClient();
 * HttpResponse resp = client.get("https://example.test/path");
 * // resp.statusCode(), resp.getHeaders(), resp.body ...
 * ```
 *
 * ## Trust
 *
 * By default a `https://` request verifies the peer against the
 * **operating-system** CA store
 * ([`TlsStream.clientSystemTrust`](../tls/TlsStream.cajeta#clientSystemTrust),
 * NET-5.3) — the real-world public-PKI path. A private CA or a
 * self-signed test server is supported by pinning an explicit anchor with
 * [`trustAnchor`](#trustAnchor) (PEM bytes), which switches the handshake
 * to [`TlsStream.client`](../tls/TlsStream.cajeta#client).
 *
 * ## Scope (NET-8.1)
 *
 * This is the **core single exchange**: connect, send, receive, close. The
 * connection pool + keep-alive reuse is NET-8.2, redirect following NET-8.3,
 * per-request deadlines NET-8.4, streaming bodies NET-8.5, the
 * `getJson`/`downloadTo` convenience NET-8.6 — each layers over this method.
 * v1 stamps `Connection: close` (one exchange per socket) and buffers the
 * response body in memory.
 */
public class HttpClient {
    /** Explicit trust-anchor PEM bytes, or `null` to use the OS trust store. */
    int8[] trustPem;
    /** Length of [`trustPem`](#trustPem) (meaningful when `hasTrustAnchor`). */
    int32 trustLen;
    /** True once [`trustAnchor`](#trustAnchor) pinned an explicit anchor. */
    boolean hasTrustAnchor;

    /**
     * Maximum number of 3xx redirects [`get`](#get) follows before giving up
     * and returning the last redirect response to the caller. Bounds redirect
     * loops (`A → B → A …`).
     */
    public static final int32 MAX_REDIRECTS = 10;

    /**
     * A client trusting the OS CA store (the default public-PKI path).
     *
     * @EntryPoint
     */
    public HttpClient() {
        int8[] e = heap int8[0];
        this.trustPem #= e;
        this.trustLen = 0;
        this.hasTrustAnchor = false;
    }

    /**
     * Pin an explicit trust anchor (PEM bytes) for `https://` verification,
     * replacing the OS trust store — the private-CA / self-signed test-server
     * path. A fresh owned copy of `pem[0..len)` is kept. Returns `this`.
     */
    public HttpClient trustAnchor(int8[] pem, int32 len) {
        int8[] copy = heap int8[len];
        int32 i = 0;
        while (i < len) {
            copy[i] = pem[i];
            i = i + 1;
        }
        this.trustPem #= copy;
        this.trustLen = len;
        this.hasTrustAnchor = true;
        return this;
    }

    // ----- the exchange ----------------------------------------------------

    /**
     * Send `req` to `uri`'s authority and return the parsed response.
     * Resolves + connects (TLS for `https`), serializes `req`, reads the
     * full response (head + buffered body). The request-target comes from
     * `req` (origin-form); a missing `Host` header is filled from `uri`.
     * `Connection: close` is stamped (NET-8.1 is one exchange per socket).
     *
     * @EntryPoint
     */
    public #HttpResponse send(Uri uri, HttpRequest req) {
        boolean https = HttpClient.isHttps(uri.getScheme());
        String host = uri.getHost();
        int32 port = uri.getPort();
        if (port < 0) {
            port = https ? 443 : 80;
        }
        HttpClient.ensureHost(req, uri);
        req.setHeader("Connection", "close");

        TcpStream sock = HttpClient.connectAny(host, port);

        if (https) {
            int8[] hostBytes = host.toBytes();
            int32 hostLen = host.byteLength();
            TlsStream tls = HttpClient.wrapTls(#sock, hostBytes, hostLen,
                                               this.trustPem, this.trustLen,
                                               this.hasTrustAnchor);
            int8[] alpn = HttpClient.alpnHttp11();
            tls.offerAlpn(alpn, 9);
            tls.handshake();
            HttpResponse rtls = HttpClient.exchange(tls, req);
            tls.close();
            return #rtls;
        }

        HttpResponse rplain = HttpClient.exchange(sock, req);
        sock.close();
        return #rplain;
    }

    /**
     * `GET url` — parse `url` to a [`Uri`](../uri/Uri.cajeta), build the
     * origin-form request (with `Host`), and [`send`](#send) it, **following
     * up to [`MAX_REDIRECTS`](#MAX_REDIRECTS) 3xx redirects** (NET-8.3). Each
     * redirect's `Location` (absolute, or origin-relative `"/path"`) becomes
     * the next GET target. This is required for real-world download URLs —
     * e.g. GitHub `releases/.../download/...` 302s to a signed CDN URL. If the
     * redirect limit is hit, or a 3xx arrives with no `Location`, the last
     * response is returned as-is (the caller sees the 3xx status).
     *
     * @EntryPoint
     */
    public #HttpResponse get(String url) {
        String current = url.substring(0, url.byteLength());
        int32 hops = 0;
        while (true) {
            Uri uri = Uri.parse(current);
            HttpRequest req = HttpRequest.fromUri("GET", uri);
            HttpResponse resp = this.send(uri, req);
            // Follow a 3xx with a Location while under the hop cap; otherwise
            // hand the response (2xx, 4xx, or an unfollowable 3xx) back. All
            // reads of `resp` happen here, before the single `return #resp`.
            if (HttpClient.isRedirect(resp.status) && hops < HttpClient.MAX_REDIRECTS) {
                String loc = resp.headers.get("Location");
                if (loc != null) {
                    String next = HttpClient.resolveRedirect(current, loc);
                    current #= next;
                    hops = hops + 1;
                    continue;
                }
            }
            return #resp;
        }
    }

    /** True for the redirect status codes [`get`](#get) follows. */
    static boolean isRedirect(int32 status) {
        return status == 301 || status == 302 || status == 303
            || status == 307 || status == 308;
    }

    /**
     * Resolve a redirect `Location` against the URL it came from. An absolute
     * `http(s)://…` target is taken verbatim; an origin-relative `"/path"` is
     * rebased onto `base`'s scheme + authority. Other relative forms (rare in
     * practice) are rebased onto the origin as well.
     */
    static #String resolveRedirect(String base, String loc) {
        if (loc.startsWith("https://") || loc.startsWith("http://")) {
            return loc.substring(0, loc.byteLength());
        }
        Uri b = Uri.parse(base);
        String origin = b.getScheme() + "://" + b.getHost();
        int32 port = b.getPort();
        if (port >= 0) {
            origin = origin + ":" + port;
        }
        if (loc.startsWith("/")) {
            return #(origin + loc);
        }
        return #(origin + "/" + loc);
    }

    // ----- transport wiring (static; no captured `this`) -------------------

    /**
     * Wrap an owned, connected `sock` as a verifying TLS client for `host`:
     * an explicit pinned anchor ([`TlsStream.client`](../tls/TlsStream.cajeta#client))
     * when `hasAnchor`, else the OS trust store
     * ([`clientSystemTrust`](../tls/TlsStream.cajeta#clientSystemTrust)).
     * Consumes `sock`.
     */
    static #TlsStream wrapTls(#TcpStream sock, int8[] host, int32 hostLen,
                              int8[] trustPem, int32 trustLen, boolean hasAnchor) {
        if (hasAnchor) {
            return TlsStream.client(#sock, host, hostLen, trustPem, trustLen);
        }
        return TlsStream.clientSystemTrust(#sock, host, hostLen);
    }

    /**
     * Write `req` to `ch`, then read + parse the response off the same
     * channel. `ch` is borrowed (the caller owns + closes the transport).
     *
     * This drives the [`ByteChannel`](../ByteChannel.cajeta) **directly** with
     * a local scratch buffer — `ch.writeAllAsync` for the serialized request,
     * `ch.readAsync` into a local for the response — rather than going through
     * the buffered [`AsyncReader`](../AsyncReader.cajeta)/[`AsyncWriter`](../AsyncWriter.cajeta).
     * The pure [`HttpParser`](HttpParser.cajeta) already buffers/streams the
     * head + body across arbitrary feed splits (NET-7.3), so a local read loop
     * is all the client needs, and it keeps the hot path on the direct,
     * stateless interface calls.
     */
    static #HttpResponse exchange(ByteChannel ch, HttpRequest req) {
        int8[] reqBytes = HttpSerializer.request(req);
        int32 reqLen = reqBytes.count();
        ch.writeAllAsync(reqBytes, (int64) 0, (int64) reqLen);
        return HttpClient.readResponse(ch);
    }

    /**
     * Read one HTTP/1.1 response off `ch`: pull chunks into a local scratch
     * buffer with [`ByteChannel.readAsync`](../ByteChannel.cajeta#readAsync),
     * feeding each to the incremental [`HttpParser`](HttpParser.cajeta) until
     * the head terminates, then drive a [`BodyReader`](BodyReader.cajeta) for
     * the parser's [`BodyFraming`](BodyFraming.cajeta) decision (seeded with the
     * parser leftover, then pulling more) until the body completes or the peer
     * closes. The decoded body is attached to the detached response.
     */
    static #HttpResponse readResponse(ByteChannel ch) {
        HttpParser parser = HttpParser.forResponse();
        int8[] scratch = heap int8[8192];
        while (!parser.isComplete()) {
            int64 n = ch.readAsync(scratch, (int64) 0, (int64) 8192);
            int32 got = (int32) n;
            if (got <= 0) {
                parser.endInput();      // truncated head -> UnexpectedEof
                break;
            }
            parser.feed(scratch, got);
        }

        HttpResponse response = parser.takeResponse();
        BodyFraming framing = parser.getFraming();

        BodyReader body = BodyReader.forFraming(framing);
        int8[] leftover = parser.leftover();
        int32 leftoverLen = parser.leftoverLength();
        if (leftoverLen > 0) {
            body.feed(leftover, leftoverLen);
        }
        while (!body.isComplete()) {
            int64 n = ch.readAsync(scratch, (int64) 0, (int64) 8192);
            int32 got = (int32) n;
            if (got <= 0) {
                body.endInput();        // KIND_CLOSE completes; others -> UnexpectedEof
                break;
            }
            body.feed(scratch, got);
        }
        int8[] decoded = body.drain();
        int32 decodedLen = decoded.count();
        if (decodedLen > 0) {
            response.body(decoded, decodedLen);
        }
        return #response;
    }

    // ----- resolution ------------------------------------------------------

    /**
     * Resolve `host` (numeric literal or name, via NET-2
     * [`Dns`](../dns/Dns.cajeta)) to its endpoints on `port` and connect a
     * fiber-parking [`TcpStream`](../TcpStream.cajeta) to the **first that
     * accepts**, trying each in turn on a connect failure — the minimal
     * try-all-addresses behavior that lets a dual-stack name
     * (`localhost` → `::1` + `127.0.0.1`) connect regardless of which family
     * the peer is actually listening on. Each candidate
     * [`SocketAddress`](../SocketAddress.cajeta) is rebuilt from the resolved
     * octets so it owns its bytes independently of the (dropped) resolve
     * array. Raises a [`NetException`](../NetException.cajeta) if every
     * resolved address fails to connect.
     */
    static #TcpStream connectAny(String host, int32 port) {
        // v1: resolve IPv4 and connect to the first endpoint. (The
        // try-all-addresses fallback over a `try`/`catch` around the parking
        // `connectAsync` is deferred — exception unwinding across a fiber park
        // is fragile in the current JIT; a non-throwing connect-result probe is
        // the right primitive for happy-eyeballs and is a follow-up.)
        SocketAddress[] addrs = Dns.resolve(host, port, ResolveFamily.V4_ONLY);
        SocketAddress a0 = addrs[0];
        IpAddress ip = a0.getIp();
        // `getOctets` returns the raw 16-byte backing buffer regardless of
        // family (IPv4 lives in `octets[0..4)`), so the family-relevant length
        // must come from the address family — NOT `oct.count()`, which is
        // always 16 and would re-interpret a V4 address as V6 (`fromOctets`
        // selects the family from `len`). Mirrors the DnsCache rebuild idiom.
        int8[] oct = ip.getOctets();
        int32 olen = 16;
        if (ip.isV4()) {
            olen = 4;
        }
        IpAddress ipCopy = IpAddress.fromOctets(oct, olen);
        SocketAddress connAddr = SocketAddress.of(#ipCopy, port);
        return TcpStream.connectAsync(#connAddr);
    }

    // ----- small helpers ---------------------------------------------------

    /**
     * Fill `req`'s `Host` header from `uri`'s authority when the request
     * doesn't already carry one (a hand-built request might not). Uses the
     * same host[:port] rule as [`HttpRequest.fromUri`](HttpRequest.cajeta).
     */
    static void ensureHost(HttpRequest req, Uri uri) {
        if (req.getHeaders().contains("Host")) {
            return;
        }
        if (!uri.hasAuthority) {
            return;
        }
        req.setHeader("Host", uri.getHost());
    }

    /** True iff `scheme` is `"https"` (case already lowered by `Uri`). */
    static boolean isHttps(String scheme) {
        if (scheme.byteLength() != 5) {
            return false;
        }
        int8[] b = scheme.toBytes();
        return b[0] == (int8) 104    // 'h'
            && b[1] == (int8) 116    // 't'
            && b[2] == (int8) 116    // 't'
            && b[3] == (int8) 112    // 'p'
            && b[4] == (int8) 115;   // 's'
    }

    /**
     * The ALPN wire list offering a single `http/1.1` protocol:
     * `\x08http/1.1` (a one-byte length `8` then the 8 token bytes). 9 bytes.
     */
    static #int8[] alpnHttp11() {
        int8[] a = heap int8[9];
        a[0] = (int8) 8;
        a[1] = (int8) 104;   // 'h'
        a[2] = (int8) 116;   // 't'
        a[3] = (int8) 116;   // 't'
        a[4] = (int8) 112;   // 'p'
        a[5] = (int8) 47;    // '/'
        a[6] = (int8) 49;    // '1'
        a[7] = (int8) 46;    // '.'
        a[8] = (int8) 49;    // '1'
        return #a;
    }
}
