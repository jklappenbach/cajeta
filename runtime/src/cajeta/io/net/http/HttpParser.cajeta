package cajeta.io.net.http;

import cajeta.lang.String;
import cajeta.io.net.Headers;

/**
 * The **incremental** HTTP/1.1 request/response **parser** (NET-7.3) —
 * a resumable state machine fed *arbitrary byte chunks*. A header split
 * across reads parses **identically** to a single one-shot feed: the
 * parser accumulates the message head until it sees the blank-line
 * terminator (`CRLFCRLF`), then parses the start-line + headers in one
 * pass and emits a parsed head ([`HttpRequest`](HttpRequest.cajeta) /
 * [`HttpResponse`](HttpResponse.cajeta)) plus a **body-framing
 * decision** ([`BodyFraming`](BodyFraming.cajeta)). The body *reader*
 * that consumes bytes per that decision is NET-7.4 — this parser stops
 * at the head boundary and hands the framing decision (and any body
 * bytes that arrived in the same chunk) to that layer.
 *
 * It is **pure logic** over `cajeta.lang.String` + `int8[]` — no
 * sockets, no native intrinsics — so it tests directly over the JIT
 * with the golden corpus under `test/net/golden/http/` (the same
 * discipline as [`Headers`](../Headers.cajeta) and
 * [`Uri`](../uri/Uri.cajeta)).
 *
 * ## Lifecycle
 *
 * ```cajeta
 * HttpParser p = HttpParser.forRequest();
 * p.feed(chunk1, chunk1.count());   // may be a partial head
 * p.feed(chunk2, chunk2.count());   // resumes where chunk1 stopped
 * if (p.isComplete()) {
 *     HttpRequest req = p.getRequest();
 *     BodyFraming  f  = p.getFraming();
 *     // body bytes that arrived in the same chunk as the head terminator:
 *     int8[] start = p.leftover();      // length p.leftoverLength()
 * }
 * ```
 *
 *   - [`forRequest`](#) / [`forResponse`](#) — pick the start-line
 *     grammar (request-line vs status-line). A parser parses exactly
 *     one message; construct a fresh one (or call [`reset`](#)) per
 *     message on a keep-alive connection.
 *   - [`feed`](#) — append the next `length` bytes. Returns `true` once
 *     the head is complete (so the caller can stop feeding head bytes);
 *     `false` means "need more." Idempotent after completion — extra
 *     feeds are appended to the leftover (body) buffer.
 *   - [`isComplete`](#) — head fully parsed.
 *   - [`endInput`](#) — assert the producer hit end-of-stream. Raises
 *     [`UnexpectedEofException`](UnexpectedEofException.cajeta) if the
 *     head never terminated (the `missing-crlf-terminator` abuse case).
 *
 * ## Abuse resistance
 *
 * Every `feed` consults [`HttpParserLimits`](HttpParserLimits.cajeta)
 * **as it accumulates**, before buffering unboundedly — total head
 * bytes, single-line length, and header count. Crossing a ceiling
 * raises [`HeadersTooLargeException`](HeadersTooLargeException.cajeta)
 * immediately (the `header-flood` / `long-header-line` /
 * `long-request-line` golden cases). A syntactically invalid head
 * raises [`MalformedMessageException`](MalformedMessageException.cajeta)
 * citing the byte offset.
 *
 * ## Body framing decision (RFC 7230 §3.3.3)
 *
 * Once the head is parsed, [`getFraming`](#) classifies the body:
 * `Transfer-Encoding: chunked` wins over `Content-Length`; a numeric
 * `Content-Length` gives a fixed-length body; a bodyless status
 * (`1xx`/`204`/`304`) or a request with no framing headers is
 * `KIND_NONE`; a response with neither is `KIND_CLOSE` (read to EOF).
 * See [`BodyFraming`](BodyFraming.cajeta) for the full table.
 */
public class HttpParser {
    // -- configuration ------------------------------------------------------

    /** True when parsing a request (request-line); false for a response. */
    boolean isRequest;
    /** The abuse-resistance ceilings consulted during accumulation. */
    HttpParserLimits limits;

    // -- accumulation state -------------------------------------------------

    /** Growable head buffer (start-line + headers + terminating blank line). */
    int8[] head;
    /** Bytes currently in `head`. */
    int32 headLen;
    /** Capacity of `head`. */
    int32 headCap;

    /**
     * Length of the line currently being accumulated (bytes since the
     * last `\n`). Tracked across `feed` calls so a single line split
     * over chunks is still bounded by `maxLineBytes`.
     */
    int32 curLineLen;
    /** Running count of `\n` bytes seen — an upper bound on header count. */
    int32 newlineCount;

    /** True once the `CRLFCRLF` head terminator has been seen + parsed. */
    boolean complete;

    /**
     * Body bytes that arrived in the same `feed` as (or after) the head
     * terminator — handed to the NET-7.4 body reader.
     */
    int8[] body;
    int32 bodyLen;
    int32 bodyCap;

    // -- parsed result ------------------------------------------------------

    HttpRequest request;
    HttpResponse response;
    BodyFraming framing;

    // -----------------------------------------------------------------------

    HttpParser() {
        this.isRequest = true;
        this.limits = heap HttpParserLimits();
        this.headCap = 256;
        this.head = heap int8[256];
        this.headLen = 0;
        this.curLineLen = 0;
        this.newlineCount = 0;
        this.complete = false;
        this.bodyCap = 0;
        this.body = heap int8[0];
        this.bodyLen = 0;
        this.request = null;
        this.response = null;
        this.framing = null;
    }

    /** A parser for an HTTP **request** at the default limits. */
    public static #HttpParser forRequest() {
        HttpParser p = heap HttpParser();
        p.isRequest = true;
        return #p;
    }

    /** A parser for an HTTP **response** at the default limits. */
    public static #HttpParser forResponse() {
        HttpParser p = heap HttpParser();
        p.isRequest = false;
        return #p;
    }

    /** A request parser with explicit abuse ceilings. */
    public static #HttpParser forRequestWithLimits(HttpParserLimits limits) {
        HttpParser p = heap HttpParser();
        p.isRequest = true;
        p.limits = limits;
        return #p;
    }

    /** A response parser with explicit abuse ceilings. */
    public static #HttpParser forResponseWithLimits(HttpParserLimits limits) {
        HttpParser p = heap HttpParser();
        p.isRequest = false;
        p.limits = limits;
        return #p;
    }

    // -- feeding ------------------------------------------------------------

    /**
     * Append the first `length` bytes of `data`, resuming the state
     * machine. Returns `true` once the head is complete. Bytes after
     * the head terminator (a body that arrived in the same chunk) are
     * captured into the leftover buffer. Raises
     * [`HeadersTooLargeException`](HeadersTooLargeException.cajeta) /
     * [`MalformedMessageException`](MalformedMessageException.cajeta) on
     * an abusive or malformed head.
     */
    public boolean feed(int8[] data, int32 length) {
        int32 i = 0;
        if (this.complete) {
            // Head already parsed: everything is body. Append + return.
            while (i < length) {
                int8 bb = data[i];
                this.appendBody(bb);
                i = i + 1;
            }
            return true;
        }
        while (i < length) {
            int8 c = data[i];
            this.appendHead(c);
            // Per-line + per-head ceilings, checked as we grow.
            if (c == (int8) 10) {                       // '\n'
                this.newlineCount = this.newlineCount + 1;
                this.curLineLen = 0;
                // newlineCount is an upper bound on (header lines + the
                // start line + the blank terminator line) — cap it
                // against the header-count ceiling early.
                if (this.newlineCount > this.limits.maxHeaderCount + 2) {
                    throw heap HeadersTooLargeException(
                        "too many header lines",
                        (int64) this.limits.maxHeaderCount,
                        (int64) (this.newlineCount - 2));
                }
            } else {
                this.curLineLen = this.curLineLen + 1;
                if (this.curLineLen > this.limits.maxLineBytes) {
                    throw heap HeadersTooLargeException(
                        "header line exceeds maxLineBytes",
                        (int64) this.limits.maxLineBytes,
                        (int64) this.curLineLen);
                }
            }
            if (this.headLen > this.limits.maxHeadBytes) {
                throw heap HeadersTooLargeException(
                    "head exceeds maxHeadBytes",
                    (int64) this.limits.maxHeadBytes,
                    (int64) this.headLen);
            }
            // Detect the CRLFCRLF terminator: the four bytes just
            // appended are CR LF CR LF.
            if (this.headEndsWithTerminator()) {
                this.parseHead();
                this.complete = true;
                // Drain the rest of this chunk into the body buffer.
                int32 j = i + 1;
                while (j < length) {
                    int8 bb = data[j];
                    this.appendBody(bb);
                    j = j + 1;
                }
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /**
     * Assert the producer reached end-of-stream. If the head is not yet
     * complete, the message head never terminated — raise
     * [`UnexpectedEofException`](UnexpectedEofException.cajeta). A no-op
     * once complete (a complete head + a truncated *body* is the body
     * reader's concern, NET-7.4 — not the head parser's).
     */
    public void endInput() {
        if (!this.complete) {
            throw heap UnexpectedEofException(
                "stream ended before the HTTP head terminated",
                (int64) this.headLen);
        }
    }

    // -- results ------------------------------------------------------------

    /** True once the message head has been fully parsed. */
    public boolean isComplete() {
        return this.complete;
    }

    /** The parsed request (null until complete, or if parsing a response). */
    public HttpRequest getRequest() {
        return this.request;
    }

    /**
     * **Detach** and return the parsed request, transferring ownership to the
     * caller and nulling the parser's handle so its drop won't double-free it
     * (the [`takeResponse`](#takeResponse) twin). The WebSocket server upgrade
     * ([`WsUpgrade.acceptServer`](../ws/WsUpgrade.cajeta)) keeps the request
     * after the short-lived parser drops. Returns `null` if parsing a
     * response / not yet complete.
     */
    public HttpRequest takeRequest() {
        HttpRequest r = this.request;
        this.request = null;
        return r;
    }

    /** The parsed response (null until complete, or if parsing a request). */
    public HttpResponse getResponse() {
        return this.response;
    }

    /**
     * **Detach** and return the parsed response, transferring ownership to the
     * caller and nulling the parser's handle so its drop won't double-free it
     * — the same hand-off discipline as
     * [`WsReadAction.takeMessage`](../ws/WsReadAction.cajeta#takeMessage). The
     * HTTP client ([`HttpClient.readResponse`](HttpClient.cajeta)) keeps the
     * response after the short-lived parser drops, so it takes ownership here.
     * Returns `null` if parsing a request / not yet complete.
     */
    public HttpResponse takeResponse() {
        HttpResponse r = this.response;
        this.response = null;
        return r;
    }

    /** The body-framing decision (null until complete). */
    public BodyFraming getFraming() {
        return this.framing;
    }

    /**
     * Body bytes that arrived in the same chunk(s) as / after the head
     * terminator — the prefix the NET-7.4 body reader continues from.
     * A fresh owned copy of exactly [`leftoverLength`](#) bytes.
     */
    public #int8[] leftover() {
        int32 n = this.bodyLen;
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.body[i];
            i = i + 1;
        }
        return #out;
    }

    /** Number of leftover body bytes captured. */
    public int32 leftoverLength() {
        return this.bodyLen;
    }

    // -- head accumulation helpers ------------------------------------------

    void appendHead(int8 c) {
        if (this.headLen >= this.headCap) {
            this.growHead();
        }
        this.head[this.headLen] = c;
        this.headLen = this.headLen + 1;
    }

    void growHead() {
        int32 newCap = this.headCap * 2;
        int8[] dst = heap int8[newCap];
        int32 i = 0;
        while (i < this.headLen) {
            dst[i] = this.head[i];
            i = i + 1;
        }
        this.head = #dst;
        this.headCap = newCap;
    }

    void appendBody(int8 c) {
        if (this.bodyLen >= this.bodyCap) {
            this.growBody();
        }
        this.body[this.bodyLen] = c;
        this.bodyLen = this.bodyLen + 1;
    }

    void growBody() {
        int32 newCap = this.bodyCap == 0 ? 64 : this.bodyCap * 2;
        int8[] dst = heap int8[newCap];
        int32 i = 0;
        while (i < this.bodyLen) {
            dst[i] = this.body[i];
            i = i + 1;
        }
        this.body = #dst;
        this.bodyCap = newCap;
    }

    /** True iff the last four head bytes are CR LF CR LF. */
    boolean headEndsWithTerminator() {
        if (this.headLen < 4) {
            return false;
        }
        int32 n = this.headLen;
        return this.head[n - 4] == (int8) 13
            && this.head[n - 3] == (int8) 10
            && this.head[n - 2] == (int8) 13
            && this.head[n - 1] == (int8) 10;
    }

    // -- head parsing -------------------------------------------------------

    /**
     * Parse the accumulated head (`head[0 .. headLen)`, terminated by
     * `CRLFCRLF`) into the start-line fields + the header map, then
     * compute the body-framing decision. Two-line discipline: the first
     * CRLF-delimited line is the start line; subsequent lines up to the
     * blank line are headers.
     */
    void parseHead() {
        // The head ends with CRLFCRLF; the meaningful content is
        // head[0 .. headLen-2) (drop the final blank line's CRLF) so the
        // last header line ends at a CRLF like the others.
        int32 limit = this.headLen - 2;

        // --- start line: up to the first CRLF.
        int32 lineEnd = this.findCrlf(0, limit);
        if (lineEnd < 0) {
            throw heap MalformedMessageException(
                "missing start-line CRLF", (int64) 0);
        }
        if (this.isRequest) {
            this.parseRequestLine(0, lineEnd);
        } else {
            this.parseStatusLine(0, lineEnd);
        }

        // --- header lines: each up to its CRLF, until `limit`.
        // NB: select the head's headers with an if/else, not a ternary —
        // exactly one of `this.request` / `this.response` is non-null here,
        // so a ternary (whose codegen may evaluate both arms) would deref
        // the null one.
        Headers headers = null;
        if (this.isRequest) {
            headers = this.request.getHeaders();
        } else {
            headers = this.response.getHeaders();
        }
        int32 pos = lineEnd + 2;        // skip the start-line CRLF
        while (pos < limit) {
            int32 hEnd = this.findCrlf(pos, limit);
            if (hEnd < 0) {
                throw heap MalformedMessageException(
                    "header line missing CRLF", (int64) pos);
            }
            this.parseHeaderLine(headers, pos, hEnd);
            pos = hEnd + 2;
        }

        this.framing = this.decideFraming(headers);
    }

    /**
     * Find the byte offset of the next `CR LF` pair in
     * `head[from .. end)`, or `-1` if none. Returns the index of the CR.
     */
    int32 findCrlf(int32 from, int32 end) {
        int32 i = from;
        while (i + 1 < end) {
            if (this.head[i] == (int8) 13 && this.head[i + 1] == (int8) 10) {
                return i;
            }
            i = i + 1;
        }
        // Also match a CRLF whose LF is exactly `end` (the last line).
        if (i + 1 == end) {
            if (this.head[i] == (int8) 13 && this.head[i + 1] == (int8) 10) {
                return i;
            }
        }
        return -1;
    }

    /**
     * Parse `request-line = method SP request-target SP HTTP-version`
     * from `head[start .. end)` into the request fields.
     */
    void parseRequestLine(int32 start, int32 end) {
        int32 sp1 = this.indexOfSpace(start, end);
        if (sp1 < 0) {
            throw heap MalformedMessageException(
                "request-line missing method/target separator",
                (int64) start);
        }
        int32 sp2 = this.indexOfSpace(sp1 + 1, end);
        if (sp2 < 0) {
            throw heap MalformedMessageException(
                "request-line missing target/version separator",
                (int64) (sp1 + 1));
        }
        String method = this.slice(start, sp1);
        String target = this.slice(sp1 + 1, sp2);
        String version = this.slice(sp2 + 1, end);
        if (method.byteLength == 0 || target.byteLength == 0
            || version.byteLength == 0) {
            throw heap MalformedMessageException(
                "request-line has an empty token", (int64) start);
        }
        HttpRequest r = heap HttpRequest();
        r.method = #method;
        r.target = #target;
        r.version = #version;
        this.request = #r;
    }

    /**
     * Parse `status-line = HTTP-version SP status-code SP reason-phrase`
     * from `head[start .. end)` into the response fields. The reason
     * phrase may be empty (RFC 7230 §3.1.2 allows it).
     */
    void parseStatusLine(int32 start, int32 end) {
        int32 sp1 = this.indexOfSpace(start, end);
        if (sp1 < 0) {
            throw heap MalformedMessageException(
                "status-line missing version/code separator",
                (int64) start);
        }
        int32 codeStart = sp1 + 1;
        int32 sp2 = this.indexOfSpace(codeStart, end);
        // A status line may omit the trailing space + reason; if there
        // is no second space, the code runs to end and the reason is "".
        int32 codeEnd = sp2 < 0 ? end : sp2;
        String version = this.slice(start, sp1);
        int32 code = this.parseStatusCode(codeStart, codeEnd);
        String reason = sp2 < 0
            ? this.emptyString()
            : this.slice(sp2 + 1, end);
        if (version.byteLength == 0) {
            throw heap MalformedMessageException(
                "status-line has an empty version", (int64) start);
        }
        HttpResponse r = heap HttpResponse();
        r.version = #version;
        r.status = code;
        r.reason = #reason;
        this.response = #r;
    }

    /**
     * Parse the 3-digit status code from `head[start .. end)`. RFC 7230
     * fixes the status code at exactly three DIGITs.
     */
    int32 parseStatusCode(int32 start, int32 end) {
        if (end - start != 3) {
            throw heap MalformedMessageException(
                "status code must be exactly 3 digits", (int64) start);
        }
        int32 value = 0;
        int32 i = start;
        while (i < end) {
            int32 d = ((int32) this.head[i]) & 255;
            if (d < 48 || d > 57) {                 // not '0'..'9'
                throw heap MalformedMessageException(
                    "non-digit in status code", (int64) i);
            }
            value = value * 10 + (d - 48);
            i = i + 1;
        }
        return value;
    }

    /**
     * Parse one `field-name ":" OWS field-value OWS` header line from
     * `head[start .. end)` and add it to `headers` (which lowercases the
     * name + OWS-trims the value per its own contract). A header line
     * with no colon is malformed.
     */
    void parseHeaderLine(Headers headers, int32 start, int32 end) {
        int32 colon = this.indexOfColon(start, end);
        if (colon < 0) {
            throw heap MalformedMessageException(
                "header line has no ':' separator", (int64) start);
        }
        String name = this.slice(start, colon);
        if (name.byteLength == 0) {
            throw heap MalformedMessageException(
                "header line has an empty field name", (int64) start);
        }
        // Value is everything after the colon; Headers.add OWS-trims it.
        String value = this.slice(colon + 1, end);
        headers.add(name, value);
    }

    // -- framing decision ---------------------------------------------------

    /**
     * Decide the body framing from the parsed head + `headers` per
     * RFC 7230 §3.3.3. Order matters: bodyless status first, then
     * chunked, then Content-Length, then the request-vs-response
     * no-framing default.
     */
    #BodyFraming decideFraming(Headers headers) {
        boolean keepAlive = this.decideKeepAlive(headers);

        if (!this.isRequest) {
            int32 status = this.response.status;
            // 1xx, 204, 304 are definitionally bodyless (RFC 7230 §3.3.3).
            if ((status >= 100 && status < 200)
                || status == 204 || status == 304) {
                return BodyFraming.none(keepAlive);
            }
        }

        // Transfer-Encoding: chunked wins over Content-Length.
        String te = headers.get("transfer-encoding");
        if (te != null) {
            if (this.containsChunkedToken(te)) {
                return BodyFraming.chunked(keepAlive);
            }
        }

        String cl = headers.get("content-length");
        if (cl != null) {
            int64 n = this.parseContentLength(cl);
            return BodyFraming.contentLength(n, keepAlive);
        }

        // No explicit framing: a request has no body; a response is
        // delimited by connection close (read to EOF).
        if (this.isRequest) {
            return BodyFraming.none(keepAlive);
        }
        return BodyFraming.closeDelimited();
    }

    /**
     * HTTP/1.1 defaults to keep-alive unless `Connection: close`;
     * HTTP/1.0 defaults to close unless `Connection: keep-alive`. The
     * full reuse policy is NET-7.6; this is the per-message read.
     */
    boolean decideKeepAlive(Headers headers) {
        boolean isHttp10 = this.versionIsHttp10();
        String conn = headers.get("connection");
        if (conn != null) {
            String lc = conn.toLowerCase();
            if (this.tokenContains(lc, "close")) {
                return false;
            }
            if (this.tokenContains(lc, "keep-alive")) {
                return true;
            }
        }
        return !isHttp10;
    }

    boolean versionIsHttp10() {
        // if/else, not a ternary: only one of request/response is non-null.
        String v = null;
        if (this.isRequest) {
            v = this.request.version;
        } else {
            v = this.response.version;
        }
        return v.equals("HTTP/1.0");
    }

    /**
     * True iff a `Transfer-Encoding` value's final coding is `chunked`
     * (case-insensitive). v1 checks for the `chunked` token anywhere in
     * the value, which is sufficient for the conforming
     * single-`chunked` case the corpus + clients produce; a layered
     * `gzip, chunked` still matches.
     */
    boolean containsChunkedToken(String te) {
        return this.tokenContains(te.toLowerCase(), "chunked");
    }

    /**
     * Parse a decimal `Content-Length` value into an int64. A
     * non-numeric or negative length is a malformed message.
     */
    int64 parseContentLength(String cl) {
        int32 n = cl.byteLength;
        if (n == 0) {
            throw heap MalformedMessageException(
                "empty Content-Length", (int64) -1);
        }
        int64 value = (int64) 0;
        int32 i = 0;
        while (i < n) {
            int32 d = ((int32) cl.byteAt(i)) & 255;
            if (d < 48 || d > 57) {
                throw heap MalformedMessageException(
                    "non-digit in Content-Length", (int64) -1);
            }
            value = value * ((int64) 10) + ((int64) (d - 48));
            i = i + 1;
        }
        return value;
    }

    // -- byte helpers -------------------------------------------------------

    /** First space (0x20) in `head[from .. end)`, or -1. */
    int32 indexOfSpace(int32 from, int32 end) {
        int32 i = from;
        while (i < end) {
            if (this.head[i] == (int8) 32) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** First colon (0x3A) in `head[from .. end)`, or -1. */
    int32 indexOfColon(int32 from, int32 end) {
        int32 i = from;
        while (i < end) {
            if (this.head[i] == (int8) 58) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** A fresh owned `String` over `head[from .. to)`. */
    #String slice(int32 from, int32 to) {
        int32 len = to - from;
        if (len < 0) {
            len = 0;
        }
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = this.head[from + i];
            i = i + 1;
        }
        return heap String(#out, len);
    }

    #String emptyString() {
        int8[] e = heap int8[0];
        return heap String(#e, 0);
    }

    /**
     * True iff `token` appears in the (already-lowercased) `value` as a
     * whole comma/space/tab-delimited token — so `keep-alive` does not
     * spuriously match a substring and `close` matches `Connection:
     * close` but not a header value that merely contains those letters
     * inside a larger word.
     */
    boolean tokenContains(String value, String token) {
        int32 vlen = value.byteLength;
        int32 tlen = token.byteLength;
        if (tlen == 0 || tlen > vlen) {
            return false;
        }
        int32 i = 0;
        while (i + tlen <= vlen) {
            if (this.matchesAt(value, i, token, tlen)) {
                // Left boundary: start, or a delimiter byte before.
                boolean leftOk = i == 0 || this.isDelim(value.byteAt(i - 1));
                int32 after = i + tlen;
                boolean rightOk = after == vlen
                    || this.isDelim(value.byteAt(after));
                if (leftOk && rightOk) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    boolean matchesAt(String value, int32 at, String token, int32 tlen) {
        int32 j = 0;
        while (j < tlen) {
            if (value.byteAt(at + j) != token.byteAt(j)) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /** Token delimiter: comma, space, or tab (the list-rule separators). */
    boolean isDelim(int8 b) {
        int32 c = ((int32) b) & 255;
        return c == 44 || c == 32 || c == 9;    // ',' ' ' '\t'
    }
}
