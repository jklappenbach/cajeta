package cajeta.io.net.http;

import cajeta.lang.String;

/**
 * Thrown by the incremental HTTP parser ([`HttpParser`](HttpParser.cajeta),
 * NET-7.3) when an inbound message's **head exceeds a configured
 * limit** — total head byte size, header-field count, or single
 * line length — **before** the parser has buffered the offending bytes
 * unboundedly. This is the abuse-resistance gate the NET-7.3 hardening
 * vectors (`test/net/golden/http/abuse.vectors`: `header-flood`,
 * `long-header-line`, `long-request-line`) pin: a conforming parser
 * **rejects** these floods rather than growing its head buffer without
 * bound.
 *
 * The `limit` field carries the configured ceiling that was crossed,
 * and `observed` the value the parser had reached when it tripped, so
 * a caller (or a 431 *Request Header Fields Too Large* responder) can
 * report both.
 *
 * ## Hierarchy
 *
 * As with [`MalformedMessageException`](MalformedMessageException.cajeta),
 * the spec places `HeadersTooLarge` under `cajeta.io.net.NetException`
 * (plan item **NET-7.7**). That item has now landed: this descends from
 * the intermediate [`HttpException`](HttpException.cajeta) →
 * `cajeta.io.net.NetException` root, so it is catchable as `HttpException`
 * (every HTTP parse fault) or the `NetException` root. (NET-7.3
 * originally rooted it on `cajeta.error.RecoverableException` as a
 * placeholder; NET-7.7 is the one-line reparent.) The
 * `(message, limit, observed)` constructor contract stays **identical**
 * across the reparent.
 *
 * ## The inherited `kind`
 *
 * As a `NetException`, every instance carries the cross-platform
 * [`kind`](../NetException.cajeta) ordinal, classified to
 * [`NetException.KIND_INVALID`](../NetException.cajeta) (12) — the whole
 * HTTP family's bucket — since an over-limit head is an invalid-input
 * abuse, not an errno-derived socket error. The crossed ceiling and the
 * value reached still ride on `limit` / `observed`.
 */
public class HeadersTooLargeException extends HttpException {
    /** The configured ceiling (bytes or count) that was crossed. */
    public int64 limit;
    /** The value reached when the limit tripped. */
    public int64 observed;

    public HeadersTooLargeException(String message, int64 limit, int64 observed) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;   // NetException.KIND_INVALID (via HttpException)
        this.limit = limit;
        this.observed = observed;
    }

    /**
     * `431 Request Header Fields Too Large` — the status an HTTP server
     * answers when an inbound request head crosses a configured ceiling.
     * Overrides [`HttpException.httpStatus`](HttpException.cajeta)'s `400`
     * default so the [`HttpServer`](HttpServer.cajeta) request loop maps an
     * over-limit head to `431` by virtual dispatch.
     */
    public int32 httpStatus() {
        return 431;
    }
}
