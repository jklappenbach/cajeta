package cajeta.io.net.http;

import cajeta.lang.String;
import cajeta.io.net.Headers;
import cajeta.io.net.http.HttpRequest;

/**
 * The **`Expect: 100-continue` policy** (RFC 7231 §5.1.1) — plan item
 * **NET-9.6**, the `100-continue` half. A client that wants to avoid sending
 * a large request body the server might reject can announce
 * `Expect: 100-continue` in the head and **pause** before the body, waiting
 * for the server to answer either an interim `100 Continue` ("go ahead, send
 * the body") or a final status (e.g. `417`, `413`, `401`) that lets it skip
 * the body entirely. This type is the **pure decision logic** the
 * [`HttpServer`](HttpServer.cajeta) body path consults once the head is
 * parsed, before it reads the body.
 *
 * ## The decision (per [`decide`](#decide))
 *
 * Given the parsed request head + the active [`ServerLimits`](ServerLimits.cajeta):
 *
 *   - **No `Expect: 100-continue`** (the header absent, or carrying some
 *     other expectation) → [`ACTION_PROCEED`](#ACTION_PROCEED): read the body
 *     normally, send nothing interim. An *unrecognized* expectation token is
 *     `417` (RFC 7231 §5.1.1 — "respond with 417 to any expectation it does
 *     not support"), but `100-continue` is the only token defined, so this
 *     reduces to: a non-`100-continue` `Expect` value →
 *     [`ACTION_EXPECTATION_FAILED`](#ACTION_EXPECTATION_FAILED) (`417`).
 *   - **`Expect: 100-continue` but the server doesn't honour it**
 *     ([`ServerLimits.expectContinueEnabled`](ServerLimits.cajeta) is
 *     `false`) → [`ACTION_PROCEED`](#ACTION_PROCEED): the client must fall
 *     back to its own send timeout. (The server still reads the body if the
 *     client sends it; it simply never emits the interim `100`.)
 *   - **`Expect: 100-continue`, honoured, on HTTP/1.1, body within the size
 *     cap** → [`ACTION_SEND_CONTINUE`](#ACTION_SEND_CONTINUE): emit an
 *     interim `100 Continue` on the wire, then read the body.
 *   - **`Expect: 100-continue`, honoured, but the declared `Content-Length`
 *     already exceeds [`ServerLimits.maxBodyBytes`](ServerLimits.cajeta)** →
 *     [`ACTION_REJECT_TOO_LARGE`](#ACTION_REJECT_TOO_LARGE): answer
 *     `413 Payload Too Large` **without** the `100`, so the client never
 *     wastes the upload — the cleanest place to apply the body cap, since
 *     the client explicitly asked permission first.
 *   - **`Expect: 100-continue` on HTTP/1.0** →
 *     [`ACTION_PROCEED`](#ACTION_PROCEED): `1xx` interim responses are an
 *     HTTP/1.1 feature (RFC 7231 §5.1.1 — a server MUST NOT send a `100` to
 *     an HTTP/1.0 client), so the server silently proceeds.
 *
 * ## Where this sits
 *
 * Pure logic over the parsed [`HttpRequest`](HttpRequest.cajeta) +
 * [`ServerLimits`](ServerLimits.cajeta) — no sockets — so it golden-tests
 * over the JIT. The [`HttpServer`](HttpServer.cajeta) maps the action to a
 * wire effect: write a `100 Continue` head, or short-circuit to a `413`/`417`
 * response, before the body read.
 */
public final class ExpectContinue {
    /** Read the body normally; emit no interim response. */
    public static final int32 ACTION_PROCEED = 0;
    /** Emit an interim `100 Continue`, then read the body. */
    public static final int32 ACTION_SEND_CONTINUE = 1;
    /** Short-circuit to `417 Expectation Failed` (unsupported expectation). */
    public static final int32 ACTION_EXPECTATION_FAILED = 2;
    /** Short-circuit to `413 Payload Too Large` (declared body over the cap). */
    public static final int32 ACTION_REJECT_TOO_LARGE = 3;

    /**
     * Decide the [`ACTION_*`](#ACTION_PROCEED) the server takes for `request`
     * under `limits`, given the body's framing
     * ([`BodyFraming`](BodyFraming.cajeta) from the parser — its `kind` +
     * declared `length`). See the type doc for the full table.
     */
    public static int32 decide(HttpRequest request, BodyFraming framing,
                               ServerLimits limits) {
        if (!ExpectContinue.wantsContinue(request)) {
            // No `Expect: 100-continue`. An *other* (unsupported) Expect
            // value is 417; an absent Expect proceeds.
            if (ExpectContinue.hasUnsupportedExpect(request)) {
                return ExpectContinue.ACTION_EXPECTATION_FAILED;
            }
            return ExpectContinue.ACTION_PROCEED;
        }
        // The client announced `Expect: 100-continue`.
        if (!limits.expectContinueEnabled) {
            return ExpectContinue.ACTION_PROCEED;      // server opts out
        }
        // A declared Content-Length already over the cap → 413 now, no body.
        if (framing.isContentLength() && !limits.bodyWithinCap(framing.length)) {
            return ExpectContinue.ACTION_REJECT_TOO_LARGE;
        }
        // 1xx interim responses are HTTP/1.1-only (RFC 7231 §5.1.1).
        if (!ExpectContinue.isHttp11(request)) {
            return ExpectContinue.ACTION_PROCEED;
        }
        return ExpectContinue.ACTION_SEND_CONTINUE;
    }

    /**
     * True iff `request` carries `Expect: 100-continue` (case-insensitive
     * on the token — `100-continue` is the only defined expectation, and
     * RFC 7231 §5.1.1 makes the token case-insensitive). A multi-value or
     * comma-folded `Expect` containing the token still counts (the folded
     * accessor returns the joined value; the token match scans it).
     */
    public static boolean wantsContinue(HttpRequest request) {
        Headers headers = request.getHeaders();
        if (!headers.contains("Expect")) {
            return false;
        }
        String value = headers.get("Expect");
        if (value == null) {
            return false;
        }
        return ExpectContinue.isContinueToken(value);
    }

    /**
     * True iff `request` carries an `Expect` header whose value is **not**
     * the `100-continue` token — an expectation the server does not support,
     * which RFC 7231 §5.1.1 answers with `417`.
     */
    static boolean hasUnsupportedExpect(HttpRequest request) {
        Headers headers = request.getHeaders();
        if (!headers.contains("Expect")) {
            return false;
        }
        String value = headers.get("Expect");
        if (value == null) {
            return false;
        }
        return !ExpectContinue.isContinueToken(value);
    }

    /**
     * Case-insensitive match of an `Expect` field value against the
     * `100-continue` token, tolerating surrounding optional whitespace the
     * [`Headers`](../Headers.cajeta) map already trims at insert.
     */
    static boolean isContinueToken(String value) {
        String lower = value.toLowerCase();
        return lower.equals("100-continue");
    }

    /** True iff the request's version string is exactly `HTTP/1.1`. */
    static boolean isHttp11(HttpRequest request) {
        return request.getVersion().equals("HTTP/1.1");
    }
}
