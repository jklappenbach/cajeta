package cajeta.io.net.http;

import cajeta.lang.String;
import cajeta.io.net.Headers;

/**
 * HTTP/1.1 **serializer** — renders an [`HttpRequest`](HttpRequest.cajeta)
 * or [`HttpResponse`](HttpResponse.cajeta) (NET-7.1) to its **wire
 * bytes**: the start-line, the [`Headers`](../Headers.cajeta) block
 * (NET-7.2), the CRLF that ends the head, and the framed body.
 *
 * This is the NET-7.5 deliverable. The plan's eventual target is an
 * `AsyncWriter` (Phase 3), but the codec layer is specified as
 * *"pure codec over byte buffers, so it tests without sockets"*
 * (plan Phase 7 goal). So — exactly like
 * [`JsonWriter`](../../codec/json/JsonWriter.cajeta) — the serializer
 * accumulates into a grown owned byte buffer and hands it back with
 * [`toBytes`](#); the socket-facing `AsyncWriter` adapter is a thin
 * shim a later item layers over the same bytes. No I/O, no native
 * intrinsics here.
 *
 * ## Wire grammar (RFC 7230)
 *
 * ```
 * HTTP-message = start-line CRLF
 *                *( header-field CRLF )
 *                CRLF
 *                [ message-body ]
 *
 * request-line = method SP request-target SP HTTP-version
 * status-line  = HTTP-version SP status-code SP reason-phrase
 * ```
 *
 * The header block is emitted **one wire line per stored slot** —
 * the [`Headers`](../Headers.cajeta) map already holds repeated and
 * comma-folded values as distinct insertion-ordered slots, so the
 * serializer just walks `0..count()` calling
 * [`nameAt`](../Headers.cajeta) / [`valueAt`](../Headers.cajeta). Note
 * the stored name is **lowercased** (the map canonicalizes on insert);
 * that is wire-legal, as field names are case-insensitive
 * (RFC 7230 §3.2).
 *
 * ## Body framing — `Content-Length` vs chunked
 *
 * Two framings, mutually exclusive (RFC 7230 §3.3.3):
 *
 *   - **`Content-Length`** (the default, [`request`](#) / [`response`](#)):
 *     the body length is known up front, so the serializer emits a
 *     `Content-Length: <n>` header (when the caller hasn't already set
 *     one) and the body bytes verbatim. An absent body
 *     (`hasBody == false`) emits **no** length header and no body —
 *     correct for a bodyless `GET`, a `204`, or a `304`. A
 *     *present-empty* body (`hasBody == true`, length 0) emits
 *     `Content-Length: 0` and zero body bytes.
 *   - **chunked** ([`requestChunked`](#) / [`responseChunked`](#)):
 *     for a body whose length isn't known up front. The serializer
 *     emits `Transfer-Encoding: chunked` (when not already set), then
 *     frames the in-memory body as a **single chunk** followed by the
 *     terminating `0\r\n\r\n`. (The streaming multi-chunk emitter that
 *     writes one chunk per flush is the NET-9.4 server-side item; this
 *     codec primitive frames a buffered body so the chunked **wire
 *     form** has a golden vector and the keep-alive item (NET-7.6) and
 *     server (NET-9.1) have an emitter to call.)
 *
 * ## Defaults the serializer supplies
 *
 * Per the deliverable, the serializer fills *framing* defaults the
 * caller didn't set, but never overrides an explicit header:
 *
 *   - **`Content-Length`** — added for a present body in the
 *     length-framed path iff the head carries neither `Content-Length`
 *     nor `Transfer-Encoding` (RFC 7230 §3.3.2: a sender MUST NOT send
 *     both; an explicit `Transfer-Encoding` suppresses the auto length).
 *   - **`Transfer-Encoding: chunked`** — added in the chunked path iff
 *     not already present.
 *
 * `Host` (request) is the caller's responsibility and is normally
 * already present — [`HttpRequest.fromUri`](HttpRequest.cajeta) sets it.
 * `Connection` keep-alive/close policy is NET-7.6 (it decides the value;
 * this serializer emits whatever header the caller placed on the map).
 * `Date` is a server-supplied default that NET-9.1 stamps before
 * calling the serializer (the codec layer has no clock).
 */
public final class HttpSerializer {
    int8[] buf;
    int32 cap;
    int32 size;

    /** Start an empty serializer with a small growable buffer. */
    public HttpSerializer() {
        this.cap = 256;
        this.buf = heap int8[256];
        this.size = 0;
    }

    /** Bytes written so far. */
    public int32 size() {
        return this.size;
    }

    // -- one-shot static helpers ------------------------------------------

    /**
     * Serialize `req` with **`Content-Length`** body framing and return
     * the owned wire bytes. Convenience over a fresh serializer +
     * [`writeRequest`](#) + [`toBytes`](#).
     */
    public static #int8[] request(HttpRequest req) {
        HttpSerializer s = heap HttpSerializer();
        s.writeRequest(req);
        return s.toBytes();
    }

    /**
     * Serialize `req` with **chunked** transfer-encoding and return the
     * owned wire bytes.
     */
    public static #int8[] requestChunked(HttpRequest req) {
        HttpSerializer s = heap HttpSerializer();
        s.writeRequestChunked(req);
        return s.toBytes();
    }

    /** Serialize `resp` with `Content-Length` framing; owned wire bytes. */
    public static #int8[] response(HttpResponse resp) {
        HttpSerializer s = heap HttpSerializer();
        s.writeResponse(resp);
        return s.toBytes();
    }

    /** Serialize `resp` with chunked transfer-encoding; owned wire bytes. */
    public static #int8[] responseChunked(HttpResponse resp) {
        HttpSerializer s = heap HttpSerializer();
        s.writeResponseChunked(resp);
        return s.toBytes();
    }

    /**
     * Serialize **only** `resp`'s status line + header block (adding
     * `Transfer-Encoding: chunked` when absent) + the head-terminating
     * CRLF — **no** body, **no** chunk terminator. The head a streaming
     * chunked response ([`ResponseBodyWriter.begin`](ResponseBodyWriter.cajeta#begin),
     * NET-9.4) writes once before pushing body chunks through the
     * incremental [`ChunkedEncoder`](ChunkedEncoder.cajeta); the chunks +
     * the `0 CRLF CRLF` terminator follow on the wire from that writer,
     * not from this codec. Owned wire bytes.
     */
    public static #int8[] responseChunkedHead(HttpResponse resp) {
        HttpSerializer s = heap HttpSerializer();
        s.writeStatusLine(resp);
        s.writeChunkedHead(resp.getHeaders());
        return s.toBytes();
    }

    // -- request --------------------------------------------------------------

    /**
     * Write `req`'s request-line, header block, head-terminating CRLF,
     * and (when present) its body framed as `Content-Length`. Returns
     * `this` for chaining.
     *
     * ```
     * method SP request-target SP HTTP-version CRLF
     * *( header CRLF )
     * CRLF
     * [ body ]
     * ```
     */
    public HttpSerializer writeRequest(HttpRequest req) {
        this.writeRequestLine(req);
        this.writeLengthHead(req.getHeaders(), req.hasBody, req.bodyLength());
        this.writeBody(req.body, req.hasBody, req.bodyLength(), false);
        return this;
    }

    /**
     * Write `req` with a **chunked** body: the request-line + headers
     * (adding `Transfer-Encoding: chunked` when absent), then the body
     * as a single chunk + the `0\r\n\r\n` terminator.
     */
    public HttpSerializer writeRequestChunked(HttpRequest req) {
        this.writeRequestLine(req);
        this.writeChunkedHead(req.getHeaders());
        this.writeBody(req.body, req.hasBody, req.bodyLength(), true);
        return this;
    }

    /** `method SP target SP version CRLF`. */
    void writeRequestLine(HttpRequest req) {
        this.appendString(req.getMethod());
        this.append((int8) 32);                 // SP
        this.appendString(req.getTarget());
        this.append((int8) 32);                 // SP
        this.appendString(req.getVersion());
        this.appendCrlf();
    }

    // -- response -------------------------------------------------------------

    /**
     * Write `resp`'s status-line, header block, head-terminating CRLF,
     * and (when present) its `Content-Length`-framed body. Returns
     * `this`.
     *
     * ```
     * HTTP-version SP status-code SP reason-phrase CRLF
     * *( header CRLF )
     * CRLF
     * [ body ]
     * ```
     */
    public HttpSerializer writeResponse(HttpResponse resp) {
        this.writeStatusLine(resp);
        this.writeLengthHead(resp.getHeaders(), resp.hasBody, resp.bodyLength());
        this.writeBody(resp.body, resp.hasBody, resp.bodyLength(), false);
        return this;
    }

    /** Write `resp` with a chunked body (mirror of `writeRequestChunked`). */
    public HttpSerializer writeResponseChunked(HttpResponse resp) {
        this.writeStatusLine(resp);
        this.writeChunkedHead(resp.getHeaders());
        this.writeBody(resp.body, resp.hasBody, resp.bodyLength(), true);
        return this;
    }

    /**
     * `HTTP-version SP status-code SP reason-phrase CRLF`. The status
     * code is rendered as decimal ASCII; the reason phrase is emitted
     * verbatim (it may be empty — `200 \r\n` is wire-legal, the SP
     * before the empty phrase is still required by the grammar).
     */
    void writeStatusLine(HttpResponse resp) {
        this.appendString(resp.getVersion());
        this.append((int8) 32);                 // SP
        this.appendDecimal(resp.statusCode());
        this.append((int8) 32);                 // SP
        this.appendString(resp.getReason());
        this.appendCrlf();
    }

    // -- shared head/body emit ------------------------------------------------

    /**
     * Emit the header block for the `Content-Length` framing, supplying
     * a `Content-Length` default when a body is present and the head
     * carries no length/encoding header, then the head-terminating
     * CRLF.
     */
    void writeLengthHead(Headers headers, boolean hasBody, int32 bodyLen) {
        this.writeHeaderLines(headers);
        if (hasBody) {
            boolean hasLen = headers.contains("Content-Length");
            boolean hasTe = headers.contains("Transfer-Encoding");
            if (!hasLen && !hasTe) {
                String lenValue = HttpSerializer.decimalString(bodyLen);
                // The Headers map lowercases stored names, and the golden
                // wire vectors are all-lowercase; emit the auto-supplied
                // framing header lowercased to match (field names are
                // case-insensitive — RFC 7230 §3.2).
                this.writeHeaderLine("content-length", lenValue);
            }
        }
        this.appendCrlf();                      // blank line ends the head
    }

    /**
     * Emit the header block for chunked framing, supplying
     * `Transfer-Encoding: chunked` when the head doesn't already carry
     * a `Transfer-Encoding`, then the head-terminating CRLF.
     */
    void writeChunkedHead(Headers headers) {
        this.writeHeaderLines(headers);
        if (!headers.contains("Transfer-Encoding")) {
            String teValue = HttpSerializer.lit("chunked");
            this.writeHeaderLine("transfer-encoding", teValue);
        }
        this.appendCrlf();
    }

    /**
     * Emit one `name: value CRLF` line per stored header slot, in
     * insertion order (the map keeps repeated/folded values as distinct
     * slots, so this faithfully reproduces multi-value order).
     */
    void writeHeaderLines(Headers headers) {
        int32 n = headers.count();
        int32 i = 0;
        while (i < n) {
            this.writeHeaderLine(headers.nameAt(i), headers.valueAt(i));
            i = i + 1;
        }
    }

    /** `name ": " value CRLF`. */
    void writeHeaderLine(String name, String value) {
        this.appendString(name);
        this.append((int8) 58);                 // ':'
        this.append((int8) 32);                 // SP
        this.appendString(value);
        this.appendCrlf();
    }

    /**
     * Emit the message body. In the length-framed path (`chunked ==
     * false`) the body bytes go out verbatim (or nothing, for an absent
     * body). In the chunked path the buffered body is framed as a single
     * `size-hex CRLF data CRLF` chunk (omitted entirely when the body is
     * empty — a zero-size chunk would prematurely terminate the stream),
     * always followed by the `0 CRLF CRLF` last-chunk terminator.
     */
    void writeBody(int8[] body, boolean hasBody, int32 bodyLen, boolean chunked) {
        if (!chunked) {
            if (hasBody) {
                this.appendBytes(body, bodyLen);
            }
            return;
        }
        // chunked: a non-empty body → one chunk; then the terminator.
        if (hasBody && bodyLen > 0) {
            this.appendHex(bodyLen);
            this.appendCrlf();
            this.appendBytes(body, bodyLen);
            this.appendCrlf();
        }
        // last-chunk: "0" CRLF (no trailers) CRLF
        this.append((int8) 48);                 // '0'
        this.appendCrlf();
        this.appendCrlf();
    }

    // -- owned-bytes handoff --------------------------------------------------

    /**
     * Hand back the accumulated wire bytes as a fresh owned buffer and
     * reset the serializer for reuse (mirrors
     * [`JsonWriter.toBytes`](../../codec/json/JsonWriter.cajeta)).
     */
    public #int8[] toBytes() {
        int32 n = this.size;
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.buf[i];
            i = i + 1;
        }
        this.size = 0;
        return #out;
    }

    /**
     * The wire bytes as a `String` (HTTP heads are ASCII; a binary body
     * is still byte-faithful through the `String`'s byte storage). Handy
     * for tests and for the text-protocol debug path.
     */
    public #String toStringValue() {
        int32 n = this.size;
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = this.buf[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    // -- byte-buffer primitives -----------------------------------------------

    /** Append a String's bytes verbatim. */
    void appendString(String s) {
        int8[] b = s.toBytes();
        this.appendBytes(b, s.byteLength());
    }

    /** Append `bytes[0..n)`. */
    void appendBytes(int8[] bytes, int32 n) {
        int32 i = 0;
        while (i < n) {
            int8 b = bytes[i];
            this.append(b);
            i = i + 1;
        }
    }

    /** Append CR LF. */
    void appendCrlf() {
        this.append((int8) 13);                 // CR
        this.append((int8) 10);                 // LF
    }

    /**
     * Append a non-negative `int32` as decimal ASCII (the
     * `Content-Length` value and the status code). Negative input is
     * never expected here (lengths and codes are non-negative); it would
     * render the magnitude without a sign.
     */
    void appendDecimal(int32 value) {
        if (value == 0) {
            this.append((int8) 48);             // '0'
            return;
        }
        int32 v = value;
        if (v < 0) {
            v = - v;
        }
        // Accumulate digits low-to-high into a scratch, then emit reversed.
        int8[] tmp = heap int8[12];
        int32 nd = 0;
        while (v > 0) {
            int32 d = v % 10;
            tmp[nd] = (int8) (48 + d);
            v = v / 10;
            nd = nd + 1;
        }
        while (nd > 0) {
            nd = nd - 1;
            int8 b = tmp[nd];
            this.append(b);
        }
    }

    /**
     * Append a non-negative `int32` as **lowercase hexadecimal** ASCII
     * with no leading zeros (the chunk-size line). `0` renders as `"0"`.
     */
    void appendHex(int32 value) {
        if (value == 0) {
            this.append((int8) 48);             // '0'
            return;
        }
        int32 v = value;
        if (v < 0) {
            v = - v;
        }
        int8[] tmp = heap int8[8];
        int32 nd = 0;
        while (v > 0) {
            int32 d = v % 16;
            int8 c = (int8) (48 + d);           // '0'..'9'
            if (d >= 10) {
                c = (int8) (97 + (d - 10));     // 'a'..'f'
            }
            tmp[nd] = c;
            v = v / 16;
            nd = nd + 1;
        }
        while (nd > 0) {
            nd = nd - 1;
            int8 b = tmp[nd];
            this.append(b);
        }
    }

    /** Append one byte, growing the buffer on demand. */
    void append(int8 b) {
        if (this.size >= this.cap) {
            this.grow();
        }
        this.buf[this.size] = b;
        this.size = this.size + 1;
    }

    /** Double the buffer capacity, copying live bytes through. */
    void grow() {
        int32 newCap = this.cap * 2;
        int8[] dst = heap int8[newCap];
        int32 i = 0;
        while (i < this.size) {
            dst[i] = this.buf[i];
            i = i + 1;
        }
        this.buf #= dst;
        this.cap = newCap;
    }

    // -- small static String helpers ------------------------------------------

    /**
     * Render a non-negative `int32` as a decimal ASCII `String` — used
     * to build the `Content-Length` header **value** (the header API
     * takes a `String`). Mirrors the inline `appendDecimal` digit loop.
     */
    static #String decimalString(int32 value) {
        if (value == 0) {
            int8[] z = heap int8[1];
            z[0] = (int8) 48;                   // '0'
            return heap String(#z, 1);
        }
        int32 digits = 0;
        int32 t = value;
        while (t > 0) {
            digits = digits + 1;
            t = t / 10;
        }
        int8[] out = heap int8[digits];
        int32 i = digits - 1;
        int32 v = value;
        while (v > 0) {
            int32 d = v % 10;
            out[i] = (int8) (48 + d);
            v = v / 10;
            i = i - 1;
        }
        return heap String(#out, digits);
    }

    /** Copy a literal into a fresh owned `String` (header default values). */
    static #String lit(String s) {
        return s.substring(0, s.byteLength());
    }
}
