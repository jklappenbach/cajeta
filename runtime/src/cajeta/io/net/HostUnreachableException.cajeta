package cajeta.io.net;

import cajeta.lang.String;

/**
 * The target host could not be reached — a routing failure to the
 * specific host (no route, ICMP host-unreachable). POSIX
 * `EHOSTUNREACH` / Winsock `WSAEHOSTUNREACH`.
 * `kind == NetException.KIND_HOST_UNREACHABLE` (7). Compare
 * [`NetworkUnreachableException`](NetworkUnreachableException.cajeta),
 * which is the whole-network variant. See
 * [`docs/specification/io/net/Errors.md`](../../../../../docs/specification/io/net/Errors.md).
 */
public class HostUnreachableException extends NetException {
    public HostUnreachableException(#String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 7;   // NetException.KIND_HOST_UNREACHABLE
    }
}
