package cajeta.io.net;

import cajeta.io.net.AddressFamily;
import cajeta.io.net.IpAddress;
import cajeta.io.net.MalformedAddressException;
import cajeta.io.net.NetErrors;
import cajeta.io.net.RecvResult;
import cajeta.io.net.WouldBlockException;
import cajeta.io.net.reactor.Reactor;
import cajeta.io.net.SocketAddress;

// NOTE (NET / b2 socket receiver-lowering): this is the **sync** surface of
// `UdpSocket`. The non-blocking (NET-1.7) + async (NET-3.3) forms depend on
// `cajeta.io.net.reactor.Reactor`, which is still gated (un-gated by b3); they
// were trimmed here and return in b3. The sync ops below carry stub bodies for
// the parser and are **intrinsic-lowered at the call site** (the compiler
// recognizes a `cajeta.io.net.UdpSocket` receiver and emits the matching
// `__cajeta_net_*` native call), exactly the way a `TcpStream` receiver lowers
// (see MethodCallExpression.cpp, `cajeta.io.net.UdpSocket` blocks).

/**
 * A **UDP datagram socket** (plan item **NET-1.5**) — the connectionless
 * transport peer of the connection-oriented [`TcpStream`](TcpStream.cajeta) /
 * [`TcpListener`](TcpListener.cajeta).
 *
 * ## Surface (sync — b2)
 *
 *   - [`bind`](#bind) — create a `SOCK_DGRAM` socket and bind it to a local
 *     [`SocketAddress`](SocketAddress.cajeta). `0.0.0.0:0` (or `[::]:0`) asks
 *     the kernel for an ephemeral port + the wildcard address.
 *   - [`sendTo`](#sendTo) / [`recvFrom`](#recvFrom) — the *unconnected*
 *     datagram path: each `sendTo` names its destination explicitly, and
 *     [`recvFrom`](#recvFrom) returns a [`RecvResult`](RecvResult.cajeta)
 *     reporting both the byte count **and the sender's address**.
 *   - [`connect`](#connect) — set a **default peer** (no handshake), enabling
 *     the address-less [`send`](#send) / [`recv`](#recv) forms.
 *   - [`localAddress`](#localAddress) — the bound local endpoint (resolves the
 *     kernel-assigned ephemeral port after a `bind(..,:0)`).
 *
 * The method bodies are **intrinsic-lowered at the call site** (the same shared
 * net-receiver codegen `TcpStream` / `TcpListener` use); the stub bodies exist
 * for the parser.
 */
public class UdpSocket {
    /**
     * OS socket descriptor, or `-1` once closed. Pinned at field index 1
     * (after the vtable) so the intrinsic codegen addresses it identically to
     * [`File`](../io/file/File.cajeta) / `TcpStream`.
     */
    public int32 fd;

    /**
     * Internal-only ctor wired by [`bind`](#bind). User code goes through the
     * static factory, which binds `fd` from the `socket()` + `bind()` syscalls.
     */
    public UdpSocket(int32 fd) {
        this.fd = fd;
    }

    // -- factory ------------------------------------------------------------

    /**
     * Open a UDP socket and bind it to `local`. The address family of `local`
     * (`V4` / `V6`) selects the socket family. Intrinsic-lowered to
     * `__cajeta_net_socket(family, SOCK_DGRAM, 0)` then
     * `__cajeta_net_bind(fd, packed(local))`.
     *
     * @EntryPoint
     */
    public static #UdpSocket bind(SocketAddress local) {
        return heap UdpSocket(-1);
    }

    // -- unconnected datagram path ------------------------------------------

    /**
     * Send `data[offset .. offset+length)` as one datagram to the explicit
     * destination `dest`. Returns the byte count handed to the kernel.
     * Intrinsic-lowered to
     * `__cajeta_net_sendto(this.fd, &data[8+offset], length, 0, packed(dest))`.
     */
    public int32 sendTo(int8[] data, int32 offset, int32 length,
                        SocketAddress dest) {
        return 0;
    }

    /**
     * Receive one datagram into `dst[offset .. offset+capacity)`, returning a
     * [`RecvResult`](RecvResult.cajeta) carrying the byte count **and** the
     * sender's [`SocketAddress`](SocketAddress.cajeta). Intrinsic-lowered to
     * `__cajeta_net_recvfrom(this.fd, &dst[8+offset], capacity, 0, sockaddrOut,
     * lenOut)`, with the reported `sockaddr` unpacked into the result's `from`.
     */
    public #RecvResult recvFrom(int8[] dst, int32 offset, int32 capacity) {
        return heap RecvResult();
    }

    // -- connected datagram path --------------------------------------------

    /**
     * Set a **default peer** (UDP `connect` performs no handshake). Intrinsic-
     * lowered to `__cajeta_net_connect(this.fd, packed(peer))`.
     */
    public void connect(SocketAddress peer) {
        return;
    }

    /**
     * Send `data[offset .. offset+length)` to the [`connect`](#connect)-stored
     * default peer. Intrinsic-lowered to
     * `__cajeta_net_send(this.fd, &data[8+offset], length, 0)`.
     */
    public int32 send(int8[] data, int32 offset, int32 length) {
        return 0;
    }

    /**
     * Receive one datagram from the [`connect`](#connect)-stored peer into
     * `dst[offset .. offset+capacity)`, returning the byte count. Intrinsic-
     * lowered to `__cajeta_net_recv(this.fd, &dst[8+offset], capacity, 0)`.
     */
    public int32 recv(int8[] dst, int32 offset, int32 capacity) {
        return 0;
    }

    // -- introspection ------------------------------------------------------

    /**
     * The local address this socket is bound to (resolving the kernel-assigned
     * ephemeral port after a `bind(..,:0)`). Intrinsic-lowered to
     * `__cajeta_net_getsockname(this.fd)` then `__cajeta_net_sockaddr_unpack`.
     */
    public #SocketAddress localAddress() {
        return heap SocketAddress();
    }

    // -- socket options (NET-1.6) -------------------------------------------
    //
    // Typed option methods — each lowers to the dedicated NET-1.6 native helper
    // that holds the platform `level`/`optname` in C
    // (`runtime/native/cajeta_net_socket_options.c`).

    /** Enable / disable `SO_BROADCAST`. Lowers to
     *  `__cajeta_net_set_broadcast(this.fd, on ? 1 : 0)`. */
    public void setBroadcast(boolean on) {
        return;
    }

    /** Read `SO_BROADCAST` back. Lowers to
     *  `__cajeta_net_get_broadcast(this.fd) != 0`. */
    public boolean getBroadcast() {
        return false;
    }

    /** Set the outbound TTL / hop limit. Lowers to
     *  `__cajeta_net_set_ttl(this.fd, isV6, ttl)`. */
    public void setTtl(int32 ttl) {
        return;
    }

    /** The current outbound TTL / hop limit. Lowers to
     *  `__cajeta_net_get_ttl(this.fd, isV6)`. */
    public int32 getTtl() {
        return 0;
    }

    /** Set the kernel receive buffer size (`SO_RCVBUF`). Lowers to
     *  `__cajeta_net_set_recvbuf(this.fd, bytes)`. */
    public void setRecvBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_RCVBUF` size. Lowers to
     *  `__cajeta_net_get_recvbuf(this.fd)`. */
    public int32 getRecvBufferSize() {
        return 0;
    }

    /** Set the kernel send buffer size (`SO_SNDBUF`). Lowers to
     *  `__cajeta_net_set_sendbuf(this.fd, bytes)`. */
    public void setSendBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_SNDBUF` size. Lowers to
     *  `__cajeta_net_get_sendbuf(this.fd)`. */
    public int32 getSendBufferSize() {
        return 0;
    }

    // -- multicast (NET-14) ---------------------------------------------------
    //
    // Real bodies over `@Native` bridges (the `recvFromAsync` pattern), NOT
    // call-site intrinsic lowering: family dispatch and argument validation are
    // ordinary Cajeta logic, and only the platform constants live in C
    // (`cajeta_net_socket_options.c` § NET-14.1).
    //
    // The interface argument is deliberately asymmetric because the kernels
    // are: IPv4 names an interface by ADDRESS (`ip_mreq.imr_interface`), IPv6
    // by INDEX (`ipv6_mreq.ipv6mr_interface`). The default-interface forms work
    // for both families.

    @Native("__cajeta_net_mcast_join_v4")
    private static int32 mcastJoinV4(int32 fd, int8[] group, int8[] iface);
    @Native("__cajeta_net_mcast_leave_v4")
    private static int32 mcastLeaveV4(int32 fd, int8[] group, int8[] iface);
    @Native("__cajeta_net_mcast_join_v6")
    private static int32 mcastJoinV6(int32 fd, int8[] group, int32 ifaceIndex);
    @Native("__cajeta_net_mcast_leave_v6")
    private static int32 mcastLeaveV6(int32 fd, int8[] group, int32 ifaceIndex);
    @Native("__cajeta_net_set_mcast_ttl")
    private static int32 mcastSetTtl(int32 fd, int32 isV6, int32 ttl);
    @Native("__cajeta_net_get_mcast_ttl")
    private static int32 mcastGetTtl(int32 fd, int32 isV6);
    @Native("__cajeta_net_set_mcast_loop")
    private static int32 mcastSetLoop(int32 fd, int32 isV6, int32 on);
    @Native("__cajeta_net_get_mcast_loop")
    private static int32 mcastGetLoop(int32 fd, int32 isV6);
    @Native("__cajeta_net_set_mcast_if_v4")
    private static int32 mcastSetIfV4(int32 fd, int8[] iface);
    @Native("__cajeta_net_get_mcast_if_v4")
    private static int32 mcastGetIfV4(int32 fd, int8[] ifaceOut);
    @Native("__cajeta_net_set_mcast_if_v6")
    private static int32 mcastSetIfV6(int32 fd, int32 ifaceIndex);
    @Native("__cajeta_net_get_mcast_if_v6")
    private static int32 mcastGetIfV6(int32 fd);
    @Native("__cajeta_net_sockname_is_v6")
    private static int32 socknameIsV6(int32 fd);
    @Native("__cajeta_net_last_error")
    private static int32 mcastLastError();

    /**
     * This socket's family as an `is_v6` flag, read off the kernel via
     * `getsockname` — the wrapper stores only `fd`, and the multicast option
     * pairs (`IP_MULTICAST_*` vs `IPV6_MULTICAST_*`) live at different levels.
     */
    int32 isV6Flag() {
        int32 v = UdpSocket.socknameIsV6(this.fd);
        if (v < (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "multicast: socket family probe");
        }
        return v;
    }

    /**
     * Join the multicast group `group` on the kernel-default interface. The
     * group's family (`V4`/`V6`) picks the membership call; it must match the
     * family this socket was bound with.
     */
    public void joinGroup(IpAddress group) {
        int32 r;
        if (group.isV6()) {
            r = UdpSocket.mcastJoinV6(this.fd, group.getOctets(), 0);
        } else {
            r = UdpSocket.mcastJoinV4(this.fd, group.getOctets(), null);
        }
        if (r != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "joinGroup " + group.toString());
        }
    }

    /** Leave `group` (joined via the default interface). */
    public void leaveGroup(IpAddress group) {
        int32 r;
        if (group.isV6()) {
            r = UdpSocket.mcastLeaveV6(this.fd, group.getOctets(), 0);
        } else {
            r = UdpSocket.mcastLeaveV4(this.fd, group.getOctets(), null);
        }
        if (r != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "leaveGroup " + group.toString());
        }
    }

    /**
     * Join an IPv4 `group` via the interface whose address is `ifaceV4`.
     * IPv4-only by construction — IPv6 selects interfaces by index; use
     * [`joinGroupOnIndex`](#joinGroupOnIndex).
     */
    public void joinGroupOn(IpAddress group, IpAddress ifaceV4) {
        if (!group.isV4() || !ifaceV4.isV4()) {
            throw heap MalformedAddressException(
                "joinGroupOn is v4-by-address; v6 joins select by index",
                (int64) -1);
        }
        if (UdpSocket.mcastJoinV4(this.fd, group.getOctets(),
                                  ifaceV4.getOctets()) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "joinGroupOn " + group.toString());
        }
    }

    /** Leave an IPv4 `group` joined via the interface addressed `ifaceV4`. */
    public void leaveGroupOn(IpAddress group, IpAddress ifaceV4) {
        if (!group.isV4() || !ifaceV4.isV4()) {
            throw heap MalformedAddressException(
                "leaveGroupOn is v4-by-address; v6 leaves select by index",
                (int64) -1);
        }
        if (UdpSocket.mcastLeaveV4(this.fd, group.getOctets(),
                                   ifaceV4.getOctets()) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "leaveGroupOn " + group.toString());
        }
    }

    /**
     * Join an IPv6 `group` via interface index `ifaceIndex` (0 = kernel
     * default). IPv6-only by construction — IPv4 selects interfaces by
     * address; use [`joinGroupOn`](#joinGroupOn).
     */
    public void joinGroupOnIndex(IpAddress group, int32 ifaceIndex) {
        if (!group.isV6()) {
            throw heap MalformedAddressException(
                "joinGroupOnIndex is v6-by-index; v4 joins select by address",
                (int64) -1);
        }
        if (UdpSocket.mcastJoinV6(this.fd, group.getOctets(), ifaceIndex)
                != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "joinGroupOnIndex " + group.toString());
        }
    }

    /** Leave an IPv6 `group` joined via interface index `ifaceIndex`. */
    public void leaveGroupOnIndex(IpAddress group, int32 ifaceIndex) {
        if (!group.isV6()) {
            throw heap MalformedAddressException(
                "leaveGroupOnIndex is v6-by-index; v4 leaves select by address",
                (int64) -1);
        }
        if (UdpSocket.mcastLeaveV6(this.fd, group.getOctets(), ifaceIndex)
                != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "leaveGroupOnIndex " + group.toString());
        }
    }

    /**
     * Set the TTL / hop limit for OUTBOUND multicast sends (distinct from the
     * unicast [`setTtl`](#setTtl)). Default 1 = link-local, per the RFCs.
     */
    public void setMulticastTtl(int32 ttl) {
        if (UdpSocket.mcastSetTtl(this.fd, this.isV6Flag(), ttl) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "setMulticastTtl");
        }
    }

    /** The current outbound multicast TTL / hop limit. */
    public int32 getMulticastTtl() {
        int32 v = UdpSocket.mcastGetTtl(this.fd, this.isV6Flag());
        if (v < (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "getMulticastTtl");
        }
        return v;
    }

    /**
     * Whether this host's own group sends are looped back to local members
     * (OS default: on). `setMulticastLoopback(false)` suppresses self-delivery.
     */
    public void setMulticastLoopback(boolean on) {
        int32 flag = on ? (int32) 1 : (int32) 0;
        if (UdpSocket.mcastSetLoop(this.fd, this.isV6Flag(), flag) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "setMulticastLoopback");
        }
    }

    /** Read the multicast-loopback flag back. */
    public boolean getMulticastLoopback() {
        int32 v = UdpSocket.mcastGetLoop(this.fd, this.isV6Flag());
        if (v < (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "getMulticastLoopback");
        }
        return v != (int32) 0;
    }

    /**
     * Select the OUTBOUND interface for multicast sends by its IPv4 address
     * (v4 sockets only — v6 selects by index via
     * [`setMulticastInterfaceIndex`](#setMulticastInterfaceIndex)).
     */
    public void setMulticastInterface(IpAddress ifaceV4) {
        if (!ifaceV4.isV4()) {
            throw heap MalformedAddressException(
                "setMulticastInterface is v4-by-address; v6 selects by index",
                (int64) -1);
        }
        if (UdpSocket.mcastSetIfV4(this.fd, ifaceV4.getOctets()) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "setMulticastInterface");
        }
    }

    /** The current v4 outbound multicast interface (0.0.0.0 = kernel default). */
    public #IpAddress getMulticastInterface() {
        int8[] octets = heap int8[4];
        if (UdpSocket.mcastGetIfV4(this.fd, octets) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "getMulticastInterface");
        }
        return IpAddress.fromOctets(octets, 4);
    }

    /** Select the OUTBOUND v6 multicast interface by index (0 = kernel default). */
    public void setMulticastInterfaceIndex(int32 ifaceIndex) {
        if (UdpSocket.mcastSetIfV6(this.fd, ifaceIndex) != (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "setMulticastInterfaceIndex");
        }
    }

    /** The current v6 outbound multicast interface index. */
    public int32 getMulticastInterfaceIndex() {
        int32 v = UdpSocket.mcastGetIfV6(this.fd);
        if (v < (int32) 0) {
            throw NetErrors.fromErrno(UdpSocket.mcastLastError(),
                                      "getMulticastInterfaceIndex");
        }
        return v;
    }

    // -- lifecycle ----------------------------------------------------------

    /**
     * Close the underlying socket. Idempotent; sets `this.fd = -1`. Intrinsic-
     * lowered to `__cajeta_net_close(this.fd)`.
     */
    /** Toggle non-blocking mode on `fd` (tracked form). Returns 0 / -1. */
    @Native("__cajeta_net_set_nonblocking_tracked")
    private static int32 setNonBlockingNative(int32 fd, int32 nonblocking);

    /**
     * Put this socket's descriptor into non-blocking mode and ensure the
     * net reactor is initialized — idempotent one-time setup, same shape as
     * `TcpStream.ensureAsyncReady` (NET-3.3).
     */
    void ensureAsyncReady() {
        int32 fd = this.fd;
        UdpSocket.setNonBlockingNative(fd, 1);
        Reactor.init();
    }

    /**
     * Async [`recvFrom`](#recvFrom): **parks the fiber** (not the carrier)
     * on the reactor until a datagram is ready, then receives it — the UDP
     * half of plan item **NET-3.3**, and the primitive a gossip-style
     * receive loop drives (`dev.cajeta.gossip`).
     *
     * Await-first readiness: park on
     * [`Reactor.awaitReadable`](reactor/Reactor.cajeta#awaitReadable)
     * (level-triggered — returns immediately when a datagram is already
     * queued), then the non-blocking `recvFrom` collects it. A spurious
     * wakeup (another consumer drained the socket first) re-parks; the
     * intended use is a single receive fiber per socket.
     */
    public #RecvResult recvFromAsync(int8[] dst, int32 offset, int32 capacity) {
        this.ensureAsyncReady();
        while (true) {
            Reactor.awaitReadable(this.fd);
            try {
                return this.recvFrom(dst, offset, capacity);
            } catch (WouldBlockException e) {
                // spurious readiness — re-park
            }
        }
    }

    public void close() {
        return;
    }

    /**
     * Destructor: closes the socket if [`close`](#close) wasn't called, so a
     * dropped `UdpSocket` never leaks a descriptor.
     */
    public ~UdpSocket() {
        this.close();
    }
}
