package cajeta.io.net;

import cajeta.lang.String;

/**
 * The local end aborted a connection in progress (e.g. an
 * in-flight `accept`/`connect` was torn down by the local stack).
 * POSIX `ECONNABORTED` / Winsock `WSAECONNABORTED`.
 * `kind == NetException.KIND_CONNECTION_ABORTED` (4). See
 * [`docs/specification/io/net/Errors.md`](../../../../../docs/specification/io/net/Errors.md).
 */
public class ConnectionAbortedException extends NetException {
    public ConnectionAbortedException(#String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 4;   // NetException.KIND_CONNECTION_ABORTED
    }
}
