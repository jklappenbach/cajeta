package cajeta.io.file;

import cajeta.lang.String;

/**
 * Streaming byte writer. See
 * `docs/specification/io/file/FileWriter.md`.
 *
 * Returned by `File``.openWrite(p, mode)`. The caller hands in
 * `(data, len)` per call; the native write loops past OS-level short
 * writes so every byte lands, but there is no user-space buffer —
 * bytes go straight to the syscall. Write `String` payloads directly
 * with `writeString`, raw bytes with `write`.
 *
 * Call `close()` when done — there is no auto-close-on-drop destructor
 * yet (planned; see `docs/specification/io/file/FileWriter.md`).
 *
 * ```cajeta
 * stack w = File.openWrite(path, mode);
 * w.writeString("hello\n");
 * w.write(bytes, len);
 * w.flush();
 * w.close();
 * ```
 */
public class FileWriter {
    /**
     * OS file descriptor, or `-1` once closed. Layout-pinned at
     * field index 0 — see FileReader for the rationale.
     */
    public int32 fd;

    /**
     * Bytes written to the fd since open. Updated after each `write`.
     */
    public int64 pos;

    /**
     * Internal-only ctor wired by `File.openWrite(p, mode)`. User
     * code goes through the factory; the factory binds the fd
     * from the open() syscall.
     */
    public FileWriter(int32 fd) {
        this.fd = fd;
        this.pos = 0;
    }

    /**
     * Write `data[0..len)` to the file. The internal loop
     * tolerates partial OS writes — when this returns, every
     * requested byte is in the kernel's buffer (or the call
     * threw on a hard error).
     *
     * Phase A: intrinsic-lowered to
     * `__cajeta_file_write(this.fd, data, len)`.
     *
     * ```cajeta
     * w.write(bytes, len);
     * ```
     */
    public void write(int8[] data, int32 len) {
        return;
    }

    /**
     * Write a `String`'s UTF-8 bytes to the file. The String's
     * `bytes` field is the source of truth (mode-0 owned or
     * mode-1 view — doesn't matter; we just read the bytes).
     *
     * Intrinsic-lowered to
     * `__cajeta_file_write(this.fd, &s.bytes[8], s.byteLength)`.
     * `this.pos` advances by `s.byteLength`.
     *
     * ```cajeta
     * w.writeString("line one\n");
     * ```
     */
    public void writeString(String s) {
        return;
    }

    /**
     * Flush hook. Writes are already unbuffered (they go straight to the
     * `write()` syscall), so this is currently a no-op — kept for API
     * symmetry and forward compatibility. It does NOT `fsync`; durability
     * flushing is `File.sync()` (Phase E, the random-access surface).
     *
     * Phase A: intrinsic-lowered to `__cajeta_file_flush(this.fd)` (no-op).
     */
    public void flush() {
        return;
    }

    /**
     * Flush + close the underlying fd. Idempotent; the destructor
     * also calls this for callers that don't close explicitly.
     */
    public void close() {
        return;
    }
}
