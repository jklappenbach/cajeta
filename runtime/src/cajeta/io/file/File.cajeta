package cajeta.io.file;

import cajeta.lang.String;

/**
 * Filesystem access in two patterns under one class name (see
 * `docs/specification/io/file/File.md`):
 *
 *   - **Static one-shots** — `readAllBytes` / `writeAllBytes`,
 *     and the `openRead` / `openWrite` factories that return
 *     streaming `FileReader` / `FileWriter`.
 *   - **Instance random-access handle** — Phase E. Returned by
 *     `File.open(path, mode)`; supports seek, lock, truncate,
 *     sync, and positional read/write.
 *
 * Pick a factory by what you need: whole-file in one call, a
 * streaming reader/writer, or a seekable handle. Open modes are
 * selected with `OpenMode`.
 *
 * ```cajeta
 * // Whole-file one-shot.
 * int8[] all = File.readAllBytes("/etc/hostname");
 *
 * // Seekable random-access handle.
 * File f = File.open("/tmp/db.bin", OpenMode.READ_WRITE);
 * f.seek(4096);
 * int8[] page = heap int8[512];
 * f.read(page, 0, 512);
 * f.close();
 * ```
 *
 * All bodies are intrinsic-lowered at the call site
 * (MethodCallExpression's File-receiver dispatch); the stubs
 * below exist for the parser only.
 */
public class File {
    /**
     * OS file descriptor, or `-1` once closed. Only meaningful
     * for File INSTANCES (the static methods don't touch this).
     * Pinned at field index 1 (after vtable) so the intrinsic
     * codegen can address it identically to FileReader /
     * FileWriter.
     */
    public int32 fd;

    /**
     * Cached position so `position()` reads avoid an `lseek`
     * syscall. Updated by every successful read/write/seek.
     * Field index 2.
     */
    public int64 pos;

    /**
     * Internal-only ctor wired by `File.open(...)`. User code
     * goes through the static factory; the factory binds the
     * fd from the open() syscall.
     */
    public File(int32 fd) {
        this.fd = fd;
        this.pos = 0;
    }

    // ----- Static one-shots (Phase A) -----

    /**
     * Read the entire file at `path` into a freshly allocated
     * `int8[]`. Intrinsic-lowered to
     * `__cajeta_file_read_all(path)`.
     *
     * ```cajeta
     * int8[] bytes = File.readAllBytes("/etc/hostname");
     * ```
     *
     * @EntryPoint
     */
    public static #int8[] readAllBytes(String path) {
        int8[] empty = heap int8[0];
        return empty;
    }

    /**
     * Write `data[0..len)` to `path` with atomic-rename
     * semantics. Intrinsic-lowered to
     * `__cajeta_file_write_all(path, data, len)`. `len` is
     * int64 end to end — multi-GiB payloads do not truncate
     * (cajeta-llama 4.2.1, spec 3.2).
     *
     * ```cajeta
     * int8[] data = heap int8[3];
     * File.writeAllBytes("/tmp/out.bin", data, 3);
     * ```
     *
     * @EntryPoint
     */
    public static void writeAllBytes(String path, int8[] data, int64 len) {
        return;
    }

    /**
     * Open `path` for reading; return a streaming `FileReader`.
     *
     * ```cajeta
     * FileReader r = File.openRead("/var/log/app.log");
     * String line = r.readString(256);
     * r.close();
     * ```
     *
     * @EntryPoint
     */
    public static #FileReader openRead(String path) {
        return heap FileReader(-1);
    }

    /**
     * Open `path` for writing in `mode`; return a streaming
     * `FileWriter`. `mode` is an `OpenMode` such as
     * `WRITE`, `APPEND`, or `CREATE_NEW`.
     *
     * ```cajeta
     * FileWriter w = File.openWrite("/tmp/out.txt", OpenMode.APPEND);
     * w.writeString("hello\n");
     * w.close();
     * ```
     *
     * @EntryPoint
     */
    public static #FileWriter openWrite(String path, OpenMode mode) {
        return heap FileWriter(-1);
    }

    // Static factories for random-access (Phase E)

    /**
     * Open `path` as a seekable random-access `File` handle in
     * the given `OpenMode`. The returned handle owns its fd;
     * transfer it with `#` and `close()` it (or let the
     * destructor) when done.
     *
     * ```cajeta
     * File f = File.open("/tmp/db.bin", OpenMode.READ_WRITE);
     * f.seek(1024);
     * int8[] buf = heap int8[64];
     * f.read(buf, 0, 64);
     * f.close();
     * ```
     *
     * @EntryPoint
     */
    public static #File open(String path, OpenMode mode) {
        return heap File(-1);
    }

    /**
     * Atomically create-and-open `path`, failing if it already
     * exists (`O_CREAT | O_EXCL`). Use as a lock-file / unique-
     * create primitive; equivalent to `open(path, OpenMode.CREATE_NEW)`
     * with read/write access.
     *
     * ```cajeta
     * File lock = File.openExclusive("/tmp/run.lock");
     * lock.close();
     * ```
     */
    public static #File openExclusive(String path) {
        return heap File(-1);
    }

    // ----- Instance methods (Phase E random-access) -----

    /**
     * Read up to `length` bytes from the current file position
     * into `dst[offset .. offset+length)`. Returns the actual
     * count filled. Zero == EOF; negative would indicate a
     * hard error (today the helper returns -1, which the
     * caller-side `int64` ABI propagates upward; the eventual
     * IoException-throwing wrapper lands with the hierarchy).
     *
     * Intrinsic-lowered to
     * `__cajeta_file_read(this.fd, &dst[8+offset], length)`,
     * with `this.pos` advanced by the returned count.
     */
    public int64 read(int8[] dst, int64 offset, int64 length) {
        return 0;
    }

    /**
     * Write `data[offset .. offset+length)` at the current file
     * position. Returns the count actually written (always
     * equal to `length` on success; -1 on hard error).
     *
     * Intrinsic-lowered to
     * `__cajeta_file_write(this.fd, &data[8+offset], length)`,
     * with `this.pos` advanced by `length`.
     */
    public int64 write(int8[] data, int64 offset, int64 length) {
        return 0;
    }

    /**
     * Current file position in bytes. Reads `this.pos` directly;
     * no syscall.
     */
    public int64 position() {
        return this.pos;
    }

    /**
     * Move to absolute byte offset `absolute`. Throws (when the
     * exception hierarchy lands) on negative offsets or past-
     * end positions on filesystems that don't support sparse
     * extension. Updates `this.pos` to the resulting position.
     *
     * Intrinsic-lowered to
     * `__cajeta_file_seek(this.fd, absolute, 0)`.
     */
    public void seek(int64 absolute) {
        return;
    }

    /**
     * Seek `offset` bytes back from end-of-file (negative
     * `offset` walks toward the beginning; `0` lands at EOF).
     * Intrinsic-lowered to
     * `__cajeta_file_seek(this.fd, offset, 2)`.
     */
    public void seekFromEnd(int64 offset) {
        return;
    }

    /**
     * Current file length in bytes. Always one `fstat()`.
     */
    public int64 size() {
        return 0;
    }

    /**
     * Resize the file to `size` bytes. Extends with zero-bytes
     * (sparse on filesystems that support it); truncates if the
     * file is larger. `this.pos` is NOT moved.
     *
     * Intrinsic-lowered to `__cajeta_file_truncate(this.fd, size)`.
     */
    public void truncate(int64 size) {
        return;
    }

    /**
     * No-op flush — there's no user-space buffer in v1. Defined
     * for InputStream / OutputStream conformance.
     */
    public void flush() {
        return;
    }

    /**
     * `fsync(2)` — durably flush every pending byte to disk
     * before returning. Crash-recovery primitive; the streaming
     * `FileWriter.flush()` does NOT call this.
     *
     * Intrinsic-lowered to `__cajeta_file_sync(this.fd)`.
     */
    public void sync() {
        return;
    }

    /**
     * Blocking exclusive lock on this fd (POSIX `flock` LOCK_EX).
     * Held until `unlock()` or `close()`. Intra-process
     * advisory; OS-level mandatory locks aren't surfaced here.
     */
    public void lock() {
        return;
    }

    /**
     * Non-blocking exclusive lock attempt. Returns true on
     * success, false if another process holds the lock.
     */
    public boolean tryLock() {
        return false;
    }

    /**
     * Release a held lock. No-op if no lock is held.
     */
    public void unlock() {
        return;
    }

    /**
     * Close the underlying fd. Idempotent; the destructor also
     * calls this. Sets `this.fd = -1` so subsequent calls are
     * no-ops.
     */
    public void close() {
        return;
    }
}
