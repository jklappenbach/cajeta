package cajeta.io.file;

import cajeta.lang.String;

/**
 * Static one-shot reads / writes + streaming-open factories.
 *
 * See `cajeta-docs/stdlib/io/file/File.md` for the full surface.
 * Random-access instance methods (open / seek / lock / sync /
 * truncate) are Phase E and not present in this class until then.
 *
 * Path overloads land with the Path class (Phase B). The String-
 * overloaded statics below are the Phase-A surface that Json file
 * I/O uses end-to-end:
 *
 *   int8[] bytes = File.readAllBytes("data.json");
 *   File.writeAllBytes("out.json", bytes, bytes.count());
 *
 * All static bodies are intrinsic-lowered at the call site —
 * MethodCallExpression detects `File.<name>` and emits the
 * corresponding runtime helper call directly. The stub bodies
 * below exist to satisfy the parser; codegen never enters them.
 */
public class File {
    /**
     * Read the entire file at `path` into a freshly allocated
     * int8[]. The returned array has `count() == fileBytes`. EOF
     * mid-read throws IoException (a half-read tree is never
     * surfaced).
     *
     * `#` return: caller takes ownership of the array.
     *
     * Intrinsic-lowered to `__cajeta_file_read_all(path)`.
     */
    public static #int8[] readAllBytes(String path) {
        int8[] empty = new int8[0];
        return empty;
    }

    /**
     * Write the first `len` bytes of `data` to `path`. Atomic-
     * rename semantics: writes to `<path>.tmp.<pid>.<rand>`,
     * fsyncs, renames over `path`. Concurrent readers see either
     * the pre-write or post-write state, never a half-written
     * file.
     *
     * Intrinsic-lowered to
     * `__cajeta_file_write_all(path, data, len)`.
     */
    public static void writeAllBytes(String path, int8[] data, int32 len) {
        return;
    }

    /**
     * Open `path` for reading; return a streaming FileReader. The
     * caller drives the byte loop via `reader.read(buf, max)`.
     *
     * `#` return: caller owns the FileReader (drop closes the
     * underlying fd).
     *
     * Intrinsic-lowered to a malloc-and-init sequence that calls
     * `__cajeta_file_open(path, OpenMode.READ)`, materializes a
     * FileReader instance around the resulting fd, and returns it.
     */
    public static #FileReader openRead(String path) {
        return heap FileReader(-1);
    }

    /**
     * Open `path` for writing in `mode`; return a streaming
     * FileWriter.
     *
     * `#` return: caller owns the FileWriter (drop flushes +
     * closes).
     *
     * Intrinsic-lowered to a malloc-and-init sequence that calls
     * `__cajeta_file_open(path, mode)`, materializes a FileWriter
     * around the fd, and returns it.
     */
    public static #FileWriter openWrite(String path, OpenMode mode) {
        return heap FileWriter(-1);
    }
}
