package cajeta.io.file;

/**
 * The kind of filesystem change carried by a `FileEvent` emitted
 * from a `Watcher`. Each observed change on a watched `Path` is
 * classified as exactly one of these.
 *
 * The ordinal is stable and is what travels in the `FileEvent`
 * `kind` field (stored as `int32`), so dispatch by comparing
 * against the named constants:
 *
 * ```cajeta
 * FileEvent event = heap FileEvent(path, WatchKind.RENAME, timestampNanos, renameTarget);
 * if (event.kind == WatchKind.RENAME) {
 *     // event.renameTarget holds the destination Path
 *     reindex(event.path, event.renameTarget);
 * } else if (event.kind == WatchKind.DELETE) {
 *     dropFromIndex(event.path);
 * }
 * ```
 *
 * Ordinals are stable; runtime helpers (`__cajeta_inotify_*`,
 * `__cajeta_fsevents_*`, `__cajeta_readdir_changes_w_*`) emit these
 * directly.
 *
 * Phase deferred — placeholder so file structure mirrors the
 * spec; the Watcher backing is not built yet.
 */
public enum WatchKind {
    /** A new entry appeared at the watched `Path`. */
    CREATE,
    /** Existing content or metadata at the `Path` changed. */
    MODIFY,
    /** The entry at the watched `Path` was removed. */
    DELETE,
    /** The entry moved; the destination is carried in the `FileEvent` `renameTarget` field. */
    RENAME
}
