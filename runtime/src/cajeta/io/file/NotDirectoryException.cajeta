package cajeta.io.file;

import cajeta.lang.String;

/**
 * A `Path` is a non-directory where a directory was expected — for
 * example a `mkdirs()` whose chain runs through a file-shaped
 * intermediate component. POSIX `ENOTDIR`. See
 * `docs/specification/io/file/Errors.md`.
 *
 * Subclass of `IoException`; the counterpart to `IsDirectoryException`.
 *
 * ```cajeta
 * try {
 *     Path.of("/etc/passwd/child").mkdirs();
 * } catch (NotDirectoryException e) {
 *     log.warn(e.message);
 * }
 * ```
 */
public class NotDirectoryException extends IoException {
    /**
     * Wraps a human-readable `String` `message` describing the path
     * component that was not a directory.
     *
     * ```cajeta
     * throw heap NotDirectoryException("not a directory: " + path.name());
     * ```
     */
    public NotDirectoryException(String message) {
        super(message);
    }
}
