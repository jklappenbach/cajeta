package cajeta.io.file;

/**
 * Snapshot of a single `stat` call: size, timestamps, type flags, and
 * permission bits for one filesystem entry, captured in one syscall so
 * callers avoid a flurry of per-attribute round-trips.
 *
 * ## Reading attributes
 * Read the populated fields directly off an instance:
 *
 * ```cajeta
 * #FileInfo meta = heap FileInfo();
 * if (meta.isFile) {
 *     int64 bytes = meta.size;
 *     int64 mtime = meta.modifiedNanos;   // Unix nanoseconds
 * }
 * ```
 *
 * The `isFile` / `isDir` / `isSymlink` flags mirror the cheaper
 * single-attribute probes on `Path` (`isFile()` / `isDir()` /
 * `isSymlink()`); prefer this type when you need several attributes at
 * once.
 *
 * Phase C placeholder. A stat-touching accessor on `Path` that
 * returns a populated `FileInfo` in one syscall lands with Phase C;
 * until then the only constructor is the zero-initialized no-arg form
 * below.
 *
 * `Instant`-typed timestamps (`created`, `modified`, `accessed`)
 * are commented out until the `Instant` class lands
 * (see docs/specification/time/Time.md). For now we expose
 * `createdNanos` / `modifiedNanos` / `accessedNanos` as `int64`
 * Unix nanoseconds — flippable to `Instant` accessors without
 * breaking callers.
 */
public class FileInfo {
    public int64 size;
    public int64 createdNanos;
    public int64 modifiedNanos;
    public int64 accessedNanos;
    public boolean isFile;
    public boolean isDir;
    public boolean isSymlink;
    public int32 permissions;

    /**
     * Zero-initialized record (all sizes/timestamps `0`, all flags
     * `false`). Once the Phase C stat accessor on `Path` lands you
     * will normally receive a populated instance from it; for now
     * construct one directly as a blank to fill in:
     *
     * ```cajeta
     * #FileInfo meta = heap FileInfo();
     * meta.isDir = true;
     * meta.permissions = 0o755;
     * ```
     */
    public FileInfo() {
        this.size = 0;
        this.createdNanos = 0;
        this.modifiedNanos = 0;
        this.accessedNanos = 0;
        this.isFile = false;
        this.isDir = false;
        this.isSymlink = false;
        this.permissions = 0;
    }
}
