package cajeta.io.file;

import cajeta.lang.String;
import cajeta.time.Clock;

/**
 * Streaming byte reader. See
 * `docs/specification/io/file/FileReader.md`.
 *
 * Returned by `File.openRead(p)` (see `File`). The caller drives
 * the byte loop: call `read(buf, max)` repeatedly until it returns
 * 0 (EOF). The native read drains OS-level short reads in a loop, so
 * it returns `max` only while more data remains; a short return (less
 * than `max`, including 0) means EOF was reached on this call. There
 * is no user-space buffer — bytes go straight into the caller's array
 * via the syscall. The `fd` field holds the OS file descriptor;
 * zero-or-positive means the underlying fd is live.
 *
 * Call `close()` when done — there is no auto-close-on-drop destructor
 * yet (planned; see `docs/specification/io/file/FileReader.md`).
 *
 * ## Usage
 *
 * Drain a file through the streaming `read` loop:
 *
 * ```cajeta
 * FileReader r #= File.openRead("data.bin");
 * int8[] buf = heap int8[4096];
 * int32 n = r.read(buf, 4096);
 * while (n != 0) {
 *     // consume buf[0..n); pos advances by n
 *     n = r.read(buf, 4096);
 * }
 * r.close();
 * ```
 *
 * Or pull text straight into a `String` (taken as UTF-8; transcode
 * via `Encoding` if the file isn't UTF-8):
 *
 * ```cajeta
 * FileReader r #= File.openRead("notes.txt");
 * String text #= r.readString(65536);
 * r.close();
 * ```
 */
public class FileReader {
    /**
     * OS file descriptor, or `-1` once closed. Layout-pinned at
     * field index 0 so the intrinsic codegen can address it
     * statically across implementations (vtable + fd is the
     * minimum struct shape).
     */
    public int32 fd;

    /**
     * Bytes consumed from the file since open. Updated after each
     * successful `read`.
     */
    public int64 pos;

    /**
     * Internal-only ctor wired by `File.openRead(p)`. User code
     * goes through the factory rather than constructing directly
     * — the factory binds the fd from the open() syscall.
     */
    public FileReader(int32 fd) {
        this.fd = fd;
        this.pos = 0;
    }

    /**
     * Read up to `max` bytes into `buf[0..max)`. Returns the
     * count actually filled. Zero means EOF; the file stays open
     * and subsequent reads return zero. Negative would signal an
     * IO error and should never surface here — the body throws on
     * error rather than returning a sentinel.
     *
     * Phase A: body is intrinsic-lowered to
     * `__cajeta_file_read(this.fd, buf, max)` at the call site.
     * The stub below exists for the parser; codegen never enters
     * it.
     *
     * @EntryPoint
     */
    public int32 read(int8[] buf, int32 max) {
        return 0;
    }

    /**
     * Bytes consumed since open. Streaming model only — no seek.
     */
    public int64 position() {
        return this.pos;
    }

    /** Portable single-fd readiness probe: `READY` / `TIMEOUT` / `ERROR`.
     *  `timeoutMs = 0` makes it non-blocking, which is the only way this
     *  is ever called here — a nonzero native timeout would block the
     *  CARRIER, and the whole point of `awaitReadable` is that it does
     *  not. See `cajeta.io.net.reactor.Reactor`, which owns the same
     *  intrinsic for sockets. */
    @Native("__cajeta_net_reactor_poll_fd")
    private static int32 pollFdNative(int32 fd, int32 interest,
        int32 timeoutMs);

    /**
     * Wait until this reader's fd is readable, or `timeoutMs` elapses.
     *
     * **Readiness is BYTES, not lines.** A true return means at least one
     * byte can be read without blocking — never that a whole line, record,
     * or message has arrived. A caller that needs a line must buffer
     * across calls; see the loop below.
     *
     * The wait is cooperative: it probes, then sleeps the FIBER rather
     * than the carrier, so other fibers keep running while this one waits.
     * That is the property the call exists for — a blocking read is
     * already available and is exactly what this replaces.
     *
     * @param timeoutMs how long to wait. `0` probes and returns at once;
     *        negative waits indefinitely.
     * @return `true` if the fd is readable, `false` if the timeout
     *         elapsed first.
     * @throws IoException if the fd is invalid or the probe fails —
     *         an error is NOT reported as a timeout, because a caller
     *         that cannot tell them apart spins forever on a dead fd.
     *
     * ## Usage
     *
     * Read whole lines off stdin without stalling other fibers:
     *
     * ```cajeta
     * FileReader in #= heap FileReader(0);
     * int8[] buf = heap int8[4096];
     * while (in.awaitReadable(-1)) {
     *     int32 n = in.read(buf, 4096);
     *     if (n == 0) { break; }          // EOF: readable, reads zero
     *     // append buf[0..n) to a pending buffer and split on '\n';
     *     // a partial tail stays pending for the next pass.
     * }
     * ```
     *
     * ## Platforms
     *
     * POSIX only. On Windows this throws: Winsock `select()` accepts
     * only SOCKETs, and a console or pipe HANDLE is not one, so there is
     * no correct implementation short of a native Win32 path
     * (`PeekNamedPipe` / `WaitForSingleObject`). The signature will not
     * change when that lands.
     */
    public boolean awaitReadable(int32 timeoutMs) {
        int32 READ = 1;
        int32 READY = 1;
        int32 ERROR = 0 - 1;

        // A zero timeout is a pure probe — answer the fd's real state and
        // return, no parking.
        int32 first = FileReader.pollFdNative(this.fd, READ, 0);
        if (first == ERROR) {
            throw heap IoException(
                "awaitReadable: not a pollable descriptor (fd="
                + this.fd + ")");
        }
        if (first == READY) {
            return true;
        }
        if (timeoutMs == 0) {
            return false;
        }

        // Deadline loop. `Reactor.pollPark` is the same shape but has no
        // timeout — it spins until ready or error — so it cannot be reused
        // directly here.
        int64 deadline = 0 - 1;
        if (timeoutMs > 0) {
            deadline = Clock.nanoTime()
                + ((int64) timeoutMs) * 1000000L;
        }
        int64 backoff = 50000L;         // 50us, doubling to a 2ms cap
        while (true) {
            Cajeta.fiberSleepNanos(backoff);
            if (backoff < 2000000L) {
                backoff = backoff * 2L;
            }
            int32 r = FileReader.pollFdNative(this.fd, READ, 0);
            if (r == READY) {
                return true;
            }
            if (r == ERROR) {
                throw heap IoException(
                    "awaitReadable: probe failed (fd=" + this.fd + ")");
            }
            if (deadline >= 0L && Clock.nanoTime() >= deadline) {
                return false;
            }
        }
        return false;
    }

    /**
     * Read up to `maxBytes` bytes and return them as a String.
     * The String materializes a freshly allocated bytes buffer
     * (mode-0 owned) so closing the reader doesn't invalidate
     * the returned text. EOF mid-read returns whatever was read
     * before EOF (possibly empty if EOF was hit immediately).
     *
     * No charset decode happens at this layer — the bytes are
     * taken as UTF-8 (`String`'s wire format). If the file isn't
     * UTF-8 the resulting `String`'s `count()` may not match the
     * caller's expectation; transcoding via `Encoding` is the
     * caller's responsibility.
     *
     * ```cajeta
     * FileReader r #= File.openRead("notes.txt");
     * String head #= r.readString(1024);
     * r.close();
     * ```
     *
     * Intrinsic-lowered: allocates a fresh int8[maxBytes],
     * calls `__cajeta_file_read(this.fd, &buf[0], maxBytes)`,
     * shrinks the array's count word to the actual byte count
     * returned, and wraps the result in a class String shell.
     *
     * @EntryPoint
     */
    public #String readString(int32 maxBytes) {
        int8[] empty = heap int8[0];
        return heap String(#empty, 0);
    }

    /**
     * Close the underlying fd. Idempotent. Required — there is no
     * auto-close-on-drop destructor yet.
     *
     * Phase A: intrinsic-lowered to
     * `__cajeta_file_close(this.fd)` and `this.fd = -1`.
     */
    public void close() {
        return;
    }
}
