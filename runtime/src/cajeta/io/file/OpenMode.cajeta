package cajeta.io.file;

/**
 * File-open intent enum. See `docs/stdlib/io/file/OpenMode.md`.
 *
 * Ordinal values are stable — runtime helpers
 * (`__cajeta_file_open(path, mode)`) interpret them directly as
 * the C-side switch:
 *
 *   0 READ        — O_RDONLY
 *   1 WRITE       — O_WRONLY | O_CREAT | O_TRUNC
 *   2 APPEND      — O_WRONLY | O_CREAT | O_APPEND
 *   3 READ_WRITE  — O_RDWR   | O_CREAT
 *   4 CREATE_NEW  — O_WRONLY | O_CREAT | O_EXCL
 *
 * Don't reorder without updating cajeta_runtime.c's openmode→flags
 * map.
 *
 * ## Usage
 * Pass a mode to the `File` / `FileWriter` factories to declare
 * intent up front; the matching `O_*` flags are applied for you:
 *
 * ```cajeta
 * #File db = File.open("/tmp/db.bin", OpenMode.READ_WRITE);
 * #FileWriter log = File.openWrite("/var/log/app.log", OpenMode.APPEND);
 * ```
 *
 * `FileReader` is always read-only, so `File`.openRead takes no
 * `OpenMode`.
 */
public enum OpenMode {
    /** Read an existing file (`O_RDONLY`); fails if the path is missing. */
    READ,
    /** Write from the start, creating or truncating the file (`O_WRONLY | O_CREAT | O_TRUNC`). */
    WRITE,
    /** Write at end-of-file, creating it if absent (`O_WRONLY | O_CREAT | O_APPEND`). */
    APPEND,
    /** Read and write the same handle, creating it if absent (`O_RDWR | O_CREAT`). */
    READ_WRITE,
    /** Create exclusively (`O_WRONLY | O_CREAT | O_EXCL`); throws if the file already exists. */
    CREATE_NEW
}
