package cajeta.hash;

import cajeta.lang.String;

/**
 * SHA-256 (FIPS 180-4) — 256-bit cryptographic digest.
 *
 * Unlike `MD5` / `SipHash` / `XXHash3` (the non-cryptographic
 * checksum + hash-table primitives that share this package), SHA-256
 * **is** a cryptographic hash: collision- and preimage-resistant, the
 * SHA-2 family member the rest of the stack relies on for integrity.
 * It is the primitive the networking layer is built on:
 *
 * - **TLS certificate validation** (`cajeta.net.tls`) fingerprints
 *   certs + drives the verifier with SHA-256.
 * - **`cvm`'s release-checksum verification** — fetch a binary over
 *   HTTPS and confirm its published SHA-256 matches before installing.
 * - **Streaming download integrity** — `HttpClient.downloadTo(path)`
 *   keeps a *running* SHA-256 over the bytes as they land on disk, so
 *   the checksum is known the instant the download finishes (no second
 *   pass over a multi-hundred-MB file).
 *
 * The streaming shape is exactly why this is `update`/`digest`-based
 * and not just a one-shot static: a download arrives in chunks, and
 * the incremental digest over the chunks must equal the one-shot
 * digest of the whole — a property the FIPS vectors pin (see
 * `Sha256Tests`).
 *
 * ## Surface
 *
 * One-shot statics:
 * ```cajeta
 * int8[] digest = Sha256.hash(bytes, bytes.count());   // 32 raw bytes
 * String hex    = Sha256.hashHex(bytes, bytes.count()); // 64 lowercase hex chars
 * ```
 *
 * Streaming (the download path):
 * ```cajeta
 * Sha256 sum = heap Sha256();
 * sum.update(chunk1, chunk1.count());
 * sum.update(chunk2, chunk2.count());
 * String hex = sum.hex();      // finalize → 64-char lowercase hex
 * // compare hex against the manifest's published checksum
 * ```
 *
 * `hex()` / `digest()` finalize the state and are **terminal** — after
 * either call the state is consumed; `reset()` re-initializes a single
 * instance to hash another input without reallocating.
 *
 * `finish()` projects the 256-bit digest to 64 bits (first 8 bytes,
 * little-endian) to satisfy the `Hasher` contract — that projection is
 * for hash-table use only, **never** for integrity; integrity callers
 * use the full `digest()` / `hex()`.
 *
 * ## v1 native-bridge workarounds
 *
 * Identical to `MD5` (this class is its structural twin):
 *
 * - `boolean` doesn't yet coerce at the `@Native` ABI boundary, so
 *   `writeBoolean` materializes int8 via ternary.
 * - `int8[]` return from `@Native` doesn't register with the per-thread
 *   live-set, so the one-shot + digest helpers pre-allocate the output
 *   on the cajeta side and the C helper fills it.
 *
 * @see cajeta.hash.MD5
 * @see cajeta.hash.Hasher
 * @see [stdlib/Hashing.md § SHA-256](../../../../../cajeta-docs/stdlib/Hashing.md)
 */
public final class Sha256 implements Hasher {

    /**
     * Opaque pointer to the native `struct cajeta_sha256_state`.
     */
    public pointer state;

    public Sha256() {
        this.state = Sha256.allocState();
    }

    ~Sha256() {
        Sha256.freeState(this.state);
    }

    // --- @Native bridges --------------------------------------------

    @Native("__cajeta_sha256_alloc")
    private static pointer allocState();

    @Native("__cajeta_sha256_free")
    private static void freeState(pointer s);

    @Native("__cajeta_sha256_reset")
    private static void resetState(pointer s);

    @Native("__cajeta_sha256_update")
    private static void updateNative(pointer s, int8[] data, int64 len);

    @Native("__cajeta_sha256_finalize_into")
    private static void finalizeInto(pointer s, int8[] out);

    @Native("__cajeta_sha256_finalize_hex_into")
    private static void finalizeHexInto(pointer s, int8[] out);

    @Native("__cajeta_sha256_finish_int64")
    private static int64 finishInt64(pointer s);

    @Native("__cajeta_sha256_oneshot_into")
    private static void oneshotInto(int8[] data, int64 len, int8[] out);

    @Native("__cajeta_sha256_oneshot_hex_into")
    private static void oneshotHexInto(int8[] data, int64 len, int8[] out);

    @Native("__cajeta_sha256_write_i8")
    private static void writeI8Native(pointer s, int8 v);

    @Native("__cajeta_sha256_write_i16")
    private static void writeI16Native(pointer s, int16 v);

    @Native("__cajeta_sha256_write_i32")
    private static void writeI32Native(pointer s, int32 v);

    @Native("__cajeta_sha256_write_i64")
    private static void writeI64Native(pointer s, int64 v);

    @Native("__cajeta_sha256_write_f32")
    private static void writeF32Native(pointer s, float32 v);

    @Native("__cajeta_sha256_write_f64")
    private static void writeF64Native(pointer s, float64 v);

    // --- One-shot statics -------------------------------------------

    /**
     * One-shot 32-byte digest of `data[0..len)`. Allocates a fresh
     * `int8[32]` and transfers ownership to the caller.
     */
    public static #int8[] hash(int8[] data, int64 len) {
        int8[] out = heap int8[32];
        Sha256.oneshotInto(data, len, out);
        return #out;
    }

    /**
     * One-shot lowercase 64-char hex digest of `data[0..len)`. The
     * common shape for checksum comparison against a published string.
     */
    public static #String hashHex(int8[] data, int64 len) {
        int8[] hex = heap int8[64];
        Sha256.oneshotHexInto(data, len, hex);
        return heap String(#hex, 64);
    }

    /**
     * One-shot 32-byte digest of a String's UTF-8 bytes.
     */
    public static #int8[] hashString(String s) {
        return Sha256.hash(s.bytes, (int64) s.byteLength);
    }

    /**
     * One-shot lowercase hex digest of a String's UTF-8 bytes.
     */
    public static #String hashStringHex(String s) {
        return Sha256.hashHex(s.bytes, (int64) s.byteLength);
    }

    // --- Streaming surface ------------------------------------------

    /**
     * Append `data[0..len)` to the streaming digest. The incremental
     * digest over successive `update` calls equals the one-shot digest
     * of the concatenation (FIPS-pinned).
     */
    public void update(int8[] data, int64 len) {
        Sha256.updateNative(this.state, data, len);
    }

    /**
     * Finalize and return the 32-byte digest. Consumes the state —
     * subsequent updates produce undefined results until `reset()`.
     */
    public #int8[] digest() {
        int8[] out = heap int8[32];
        Sha256.finalizeInto(this.state, out);
        return #out;
    }

    /**
     * Finalize and return the lowercase 64-char hex digest. Consumes
     * the state (terminal, like `digest()`). This is the shape the
     * download-checksum path uses: `sum.hex()` then string-compare
     * against the manifest value.
     */
    public #String hex() {
        int8[] out = heap int8[64];
        Sha256.finalizeHexInto(this.state, out);
        return heap String(#out, 64);
    }

    /**
     * Re-initialize the working state. Lets a single Sha256 instance
     * hash multiple independent inputs without reallocating.
     */
    public void reset() {
        Sha256.resetState(this.state);
    }

    // --- Hasher streaming primitives --------------------------------

    public void writeBoolean(boolean v) {
        Sha256.writeI8Native(this.state, (int8)(v ? 1 : 0));
    }
    public void writeInt8(int8 v)       { Sha256.writeI8Native(this.state, v); }
    public void writeInt16(int16 v)     { Sha256.writeI16Native(this.state, v); }
    public void writeInt32(int32 v)     { Sha256.writeI32Native(this.state, v); }
    public void writeInt64(int64 v)     { Sha256.writeI64Native(this.state, v); }
    public void writeUInt8(uint8 v)     { Sha256.writeI8Native(this.state, (int8) v); }
    public void writeUInt16(uint16 v)   { Sha256.writeI16Native(this.state, (int16) v); }
    public void writeUInt32(uint32 v)   { Sha256.writeI32Native(this.state, (int32) v); }
    public void writeUInt64(uint64 v)   { Sha256.writeI64Native(this.state, (int64) v); }
    public void writeFloat32(float32 v) { Sha256.writeF32Native(this.state, v); }
    public void writeFloat64(float64 v) { Sha256.writeF64Native(this.state, v); }

    public void writeBytes(int8[] data) {
        Sha256.updateNative(this.state, data, data.count());
    }

    public void writeBytesRange(int8[] data, int64 offset, int64 length) {
        // v1: `offset` ignored — the C helper reads from data[8..].
        // Slicing primitive is a v2 follow-up (matches MD5).
        Sha256.updateNative(this.state, data, length);
    }

    public void writeString(String s) {
        Sha256.updateNative(this.state, s.bytes, (int64) s.byteLength);
    }

    public void writeObject(Object obj) {
        Sha256.writeI64Native(this.state, obj.hash());
    }

    /**
     * Hasher projection: first 8 digest bytes as a little-endian
     * int64. **Hash-table use only — not for integrity.** Integrity
     * callers use `digest()` / `hex()`.
     */
    public int64 finish() {
        return Sha256.finishInt64(this.state);
    }
}
