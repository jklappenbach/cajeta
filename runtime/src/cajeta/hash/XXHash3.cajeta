package cajeta.hash;

import cajeta.lang.String;

/**
 * XXH3-64 — fast general-purpose 64-bit non-cryptographic hash.
 *
 * The default-backing algorithm for compiler-synthesized
 * `Object.hash()`, `String.hash()`, and `@AutoHash`. Multi-GB/s
 * throughput on modern CPUs; small-input path (the typical
 * field-hashing case) is a handful of cycles.
 *
 * Pick over `RapidHash` when ecosystem interop matters (LZ4 / zstd /
 * RocksDB / ClickHouse all use XXH3). Pick over `SipHash` when the
 * input is non-attacker-controlled — XXH3 is ~10× faster.
 *
 * ## Surface
 *
 * One-shot statics:
 * ```cajeta
 * int64 h = XXHash3.hash(bytes, bytes.count());           // process-seeded
 * int64 h2 = XXHash3.hashSeeded(bytes, bytes.count(), seed);
 * int64 hs = XXHash3.hashString(text);
 * ```
 *
 * Streaming `Hasher`:
 * ```cajeta
 * XXHash3 h = heap XXHash3();                              // process-seeded
 * h.writeInt32(record.id);
 * h.writeString(record.title);
 * int64 digest = h.finish();
 * ```
 *
 * @See cajeta.hash.Hasher
 * @See cajeta.hash.DefaultHasher
 * @See [specification/hash/Hashing.md § XXHash3](../../../../../docs/specification/hash/Hashing.md)
 */
public final class XXHash3 implements Hasher {

    /**
     * Opaque pointer to the native `XXH3_state_t`.
     */
    public pointer state;

    /**
     * The seed the state was initialized with. Kept so `reset()`
     * can re-derive an equivalent fresh state.
     */
    public int64 seed;

    /**
     * Construct a streaming hasher seeded with the per-process random seed.
     *
     * ```cajeta
     * XXHash3 h = heap XXHash3();
     * h.writeString(record.title);
     * int64 digest = h.finish();
     * ```
     *
     * @EntryPoint
     */
    public XXHash3() {
        this.seed = Hash.processSeed();
        this.state = XXHash3.allocState(this.seed);
    }

    /**
     * Construct with an explicit seed — use when you need digests that
     * reproduce across processes.
     *
     * ```cajeta
     * XXHash3 h = heap XXHash3(0xC0FFEEL);
     * h.writeInt64(key);
     * int64 digest = h.finish();
     * ```
     */
    public XXHash3(int64 seedArg) {
        this.seed = seedArg;
        this.state = XXHash3.allocState(seedArg);
    }

    ~XXHash3() {
        XXHash3.freeState(this.state);
    }

    // --- @Native bridges --------------------------------------------

    @Native("__cajeta_xxh3_alloc")
    private static pointer allocState(int64 s);

    @Native("__cajeta_xxh3_free")
    private static void freeState(pointer s);

    @Native("__cajeta_xxh3_reset")
    private static void resetNative(pointer s, int64 seedArg);

    @Native("__cajeta_xxh3_update")
    private static void updateNative(pointer s, int8[] data, int64 len);

    @Native("__cajeta_xxh3_finish")
    private static int64 finishNative(pointer s);

    @Native("__cajeta_xxh3_oneshot")
    private static int64 oneshot(int8[] data, int64 len, int64 seedArg);

    @Native("__cajeta_xxh3_128_oneshot")
    private static void oneshot128(int8[] data, int64 len, int64 seedArg, int8[] out16);

    @Native("__cajeta_xxh3_128_hex")
    private static void hex128Into(int64 low, int64 high, int8[] out32);

    @Native("__cajeta_xxh3_write_i8")
    private static void writeI8Native(pointer s, int8 v);

    @Native("__cajeta_xxh3_write_i16")
    private static void writeI16Native(pointer s, int16 v);

    @Native("__cajeta_xxh3_write_i32")
    private static void writeI32Native(pointer s, int32 v);

    @Native("__cajeta_xxh3_write_i64")
    private static void writeI64Native(pointer s, int64 v);

    @Native("__cajeta_xxh3_write_f32")
    private static void writeF32Native(pointer s, float32 v);

    @Native("__cajeta_xxh3_write_f64")
    private static void writeF64Native(pointer s, float64 v);

    // --- One-shot statics -------------------------------------------

    /**
     * One-shot 64-bit hash of `data[0..len)` under the per-process seed.
     *
     * ```cajeta
     * int64 h = XXHash3.hash(bytes, bytes.count());
     * ```
     *
     * @EntryPoint
     */
    public static int64 hash(int8[] data, int64 len) {
        int64 seed = Hash.processSeed();
        if (len > 240) {
            return XXHash3.hashLong(data, len, seed);
        }
        return XXHash3.oneshot(data, len, seed);
    }

    /**
     * One-shot hash under an explicit `seedArg`, for reproducible digests.
     *
     * ```cajeta
     * int64 h = XXHash3.hashSeeded(bytes, bytes.count(), 0xC0FFEEL);
     * ```
     */
    @Inline
    public static int64 hashSeeded(int8[] data, int64 len, int64 seedArg) {
        return XXHash3.oneshot(data, len, seedArg);
    }

    /**
     * One-shot hash of a `String`'s UTF-8 bytes under the per-process seed.
     *
     * ```cajeta
     * int64 h = XXHash3.hashString("hello");
     * ```
     *
     * @EntryPoint
     */
    @Inline
    public static int64 hashString(String s) {
        if (s.byteOffset() != (int64) 0) {
            int8[] w = s.toBytes();
            return XXHash3.oneshot(w, (int64) s.byteLength, Hash.processSeed());
        }
        return XXHash3.oneshot(s.bytes, (int64) s.byteLength, Hash.processSeed());
    }

    /**
     * One-shot hash of a `String`'s UTF-8 bytes under an explicit `seedArg`.
     *
     * ```cajeta
     * int64 h = XXHash3.hashStringSeeded("hello", 0xC0FFEEL);
     * ```
     */
    @Inline
    public static int64 hashStringSeeded(String s, int64 seedArg) {
        if (s.byteOffset() != (int64) 0) {
            int8[] w = s.toBytes();
            return XXHash3.oneshot(w, (int64) s.byteLength, seedArg);
        }
        return XXHash3.oneshot(s.bytes, (int64) s.byteLength, seedArg);
    }

    // --- 128-bit one-shot surface -----------------------------------
    //
    // XXH3-128: the 128-bit non-cryptographic fingerprint — the direct,
    // higher-collision-margin replacement for MD5 in new code (cache keys,
    // ETags, content fingerprints). The digest is delivered as 16 bytes
    // (low64 little-endian, then high64 little-endian) into a caller-provided
    // `int8[16]`, mirroring the native reference and `MD5.hash` — so the hot
    // path is heap-free when the buffer is reused. Inputs > 240 B take the
    // pure-Cajeta AVX-512 SIMD long path (hashLong128Into); shorter inputs use
    // the native reference. NOTE: low64 is bit-identical to the 64-bit XXH3
    // digest on the long path (XXH3 computes both from the same accumulators).
    //
    // (The digest is NOT returned as a `Vector<int64,2>` value: returning a
    // small SIMD vector by value across a non-inlined call currently mis-codegens
    // to zero under AOT -O3 — a separate compiler bug. The int8[16] out-param is
    // both the correct workaround and the more idiomatic digest-buffer shape.)

    /**
     * One-shot 128-bit hash of `data[0..len)` under `seedArg`, written as 16
     * bytes (low64 LE, then high64 LE) into `out16` — zero-allocation when the
     * buffer is reused. Routes >240 B to the SIMD long path, else native.
     *
     * ```cajeta
     * int8[] digest = heap int8[16];
     * XXHash3.hash128Into(bytes, bytes.count(), 0xC0FFEEL, digest);
     * ```
     */
    public static void hash128Into(int8[] data, int64 len, int64 seedArg, int8[] out16) {
        if (len > 240) {
            XXHash3.hashLong128Into(data, len, seedArg, out16);
        } else {
            XXHash3.oneshot128(data, len, seedArg, out16);
        }
    }

    /**
     * One-shot 128-bit digest of `data[0..len)` (per-process seed) as a fresh
     * owned 16-byte array (low64 LE, then high64 LE).
     *
     * ```cajeta
     * int8[] digest = XXHash3.hash128(bytes, bytes.count());
     * ```
     */
    public static #int8[] hash128(int8[] data, int64 len) {
        int8[] out = heap int8[16];
        XXHash3.hash128Into(data, len, Hash.processSeed(), out);
        return #out;
    }

    /** Low 64 bits of the 128-bit digest (== the 64-bit XXH3 hash for inputs > 240 B). */
    public static int64 hash128Low(int8[] data, int64 len) {
        int8[] out = heap int8[16];
        XXHash3.hash128Into(data, len, Hash.processSeed(), out);
        return Cajeta.loadU64(out, 0);
    }

    /** High 64 bits of the 128-bit digest. */
    public static int64 hash128High(int8[] data, int64 len) {
        int8[] out = heap int8[16];
        XXHash3.hash128Into(data, len, Hash.processSeed(), out);
        return Cajeta.loadU64(out, 8);
    }

    /**
     * One-shot 128-bit digest as the 32-char canonical lowercase hex string
     * (big-endian high64 then low64 — matches `XXH128_canonicalFromHash`).
     *
     * ```cajeta
     * String etag = XXHash3.hash128Hex(bytes, bytes.count());
     * ```
     *
     * @EntryPoint
     */
    public static #String hash128Hex(int8[] data, int64 len) {
        return XXHash3.hash128HexSeeded(data, len, Hash.processSeed());
    }

    /**
     * One-shot 128-bit canonical hex digest under an explicit `seedArg`, for
     * reproducible digests (e.g. cross-process ETags).
     */
    public static #String hash128HexSeeded(int8[] data, int64 len, int64 seedArg) {
        int8[] out = heap int8[16];
        XXHash3.hash128Into(data, len, seedArg, out);
        int8[] hex = heap int8[32];
        XXHash3.hex128Into(Cajeta.loadU64(out, 0), Cajeta.loadU64(out, 8), hex);
        return heap String(#hex, 32);
    }

    // --- Streaming surface ------------------------------------------

    /** Feed `data[0..len)` into the running hash state. */
    public void update(int8[] data, int64 len) {
        XXHash3.updateNative(this.state, data, len);
    }

    /** Discard accumulated input and re-seed from the original seed, so the instance can be reused for a fresh digest. */
    public void reset() {
        XXHash3.resetNative(this.state, this.seed);
    }

    // --- Hasher streaming primitives --------------------------------

    /** Feed `v` as a single byte: `1` for true, `0` for false. */
    public void writeBoolean(boolean v) {
        XXHash3.writeI8Native(this.state, (int8)(v ? 1 : 0));
    }
    /** Append the raw byte of `v`. */
    public void writeInt8(int8 v)       { XXHash3.writeI8Native(this.state, v); }
    /** Append the 2 raw bytes of `v`. */
    public void writeInt16(int16 v)     { XXHash3.writeI16Native(this.state, v); }
    /** Append the 4 raw bytes of `v`. */
    public void writeInt32(int32 v)     { XXHash3.writeI32Native(this.state, v); }
    /** Append the 8 raw bytes of `v`. */
    public void writeInt64(int64 v)     { XXHash3.writeI64Native(this.state, v); }
    /** Append the raw byte of `v`. */
    public void writeUInt8(uint8 v)     { XXHash3.writeI8Native(this.state, (int8) v); }
    /** Append the 2 raw bytes of `v`. */
    public void writeUInt16(uint16 v)   { XXHash3.writeI16Native(this.state, (int16) v); }
    /** Append the 4 raw bytes of `v`. */
    public void writeUInt32(uint32 v)   { XXHash3.writeI32Native(this.state, (int32) v); }
    /** Append the 8 raw bytes of `v`. */
    public void writeUInt64(uint64 v)   { XXHash3.writeI64Native(this.state, (int64) v); }
    /** Append the 4 raw bytes of `v`. */
    public void writeFloat32(float32 v) { XXHash3.writeF32Native(this.state, v); }
    /** Append the 8 raw bytes of `v`. */
    public void writeFloat64(float64 v) { XXHash3.writeF64Native(this.state, v); }

    /** Feed every byte of `data` into the running hash. */
    public void writeBytes(int8[] data) {
        XXHash3.updateNative(this.state, data, data.count());
    }

    /**
     * Feed `length` bytes of `data` into the running hash. Note: `offset`
     * is currently ignored — hashing always starts at index `0`.
     */
    public void writeBytesRange(int8[] data, int64 offset, int64 length) {
        XXHash3.updateNative(this.state, data, length);
    }

    /** Feed a `String`'s UTF-8 bytes into the running hash. */
    public void writeString(String s) {
        if (s.byteOffset() != (int64) 0) {
            int8[] w = s.toBytes();
            XXHash3.updateNative(this.state, w, (int64) s.byteLength);
            return;
        }
        XXHash3.updateNative(this.state, s.bytes, (int64) s.byteLength);
    }

    /** Mix in `obj` by feeding its `Object` `hash()` value as 8 bytes. */
    public void writeObject(Object obj) {
        XXHash3.writeI64Native(this.state, obj.hash());
    }

    /**
     * Finalize and return the 64-bit digest of everything written so far.
     * The state is left intact; call `reset()` to start a new digest.
     *
     * ```cajeta
     * h.writeInt32(record.id);
     * int64 digest = h.finish();
     * ```
     */
    public int64 finish() {
        return XXHash3.finishNative(this.state);
    }

    // ================================================================
    //  Pure-Cajeta SIMD long-path (Vector<int64,8> = 512-bit / AVX-512)
    // ================================================================
    // A faithful port of XXH3-64's bulk algorithm — `accumulate_512` +
    // `scrambleAcc` + `mergeAccs` — written in Cajeta SIMD value types, no
    // @Native, no C xxHash. Built with `--cpu=native` the Vector<int64,8>
    // arithmetic lowers to AVX-512 (vpmullq / vpxorq / vpsrlq / vpaddq), so a
    // 64-byte stripe is one set of vector ops instead of eight scalar rounds.
    // hash() routes inputs > 240 bytes here; the result is bit-identical to the
    // native XXH3_64bits_withSeed long path.

    // Build the 192-byte seeded secret (XXH3_initCustomSecret): each 64-bit word
    // of kSecret gets +seed (even index) or -seed (odd index).
    public static #int8[] buildSecret(int64 seed) {
        int8[] s = heap int8[192];
        Cajeta.storeU64(s, 0, 0xBE4BA423396CFEB8L + seed);
        Cajeta.storeU64(s, 8, 0x1CAD21F72C81017CL - seed);
        Cajeta.storeU64(s, 16, 0xDB979083E96DD4DEL + seed);
        Cajeta.storeU64(s, 24, 0x1F67B3B7A4A44072L - seed);
        Cajeta.storeU64(s, 32, 0x78E5C0CC4EE679CBL + seed);
        Cajeta.storeU64(s, 40, 0x2172FFCC7DD05A82L - seed);
        Cajeta.storeU64(s, 48, 0x8E2443F7744608B8L + seed);
        Cajeta.storeU64(s, 56, 0x4C263A81E69035E0L - seed);
        Cajeta.storeU64(s, 64, 0xCB00C391BB52283CL + seed);
        Cajeta.storeU64(s, 72, 0xA32E531B8B65D088L - seed);
        Cajeta.storeU64(s, 80, 0x4EF90DA297486471L + seed);
        Cajeta.storeU64(s, 88, 0xD8ACDEA946EF1938L - seed);
        Cajeta.storeU64(s, 96, 0x3F349CE33F76FAA8L + seed);
        Cajeta.storeU64(s, 104, 0x1D4F0BC7C7BBDCF9L - seed);
        Cajeta.storeU64(s, 112, 0x3159B4CD4BE0518AL + seed);
        Cajeta.storeU64(s, 120, 0x647378D9C97E9FC8L - seed);
        Cajeta.storeU64(s, 128, 0xC3EBD33483ACC5EAL + seed);
        Cajeta.storeU64(s, 136, 0xEB6313FAFFA081C5L - seed);
        Cajeta.storeU64(s, 144, 0x49DAF0B751DD0D17L + seed);
        Cajeta.storeU64(s, 152, 0x9E68D429265516D3L - seed);
        Cajeta.storeU64(s, 160, 0xFCA1477D58BE162BL + seed);
        Cajeta.storeU64(s, 168, 0xCE31D07AD1B8F88FL - seed);
        Cajeta.storeU64(s, 176, 0x280416958F3ACB45L + seed);
        Cajeta.storeU64(s, 184, 0x7E404BBBCAFBD7AFL - seed);
        return s;
    }

    // 64x64 -> 128 multiply, folded: low64(a*b) ^ high64(a*b) (schoolbook, O(1)).
    @Inline
    public static int64 mulFold(int64 a, int64 b) {
        int64 aLo = a & 0xFFFFFFFFL;
        int64 aHi = a >>> 32;
        int64 bLo = b & 0xFFFFFFFFL;
        int64 bHi = b >>> 32;
        int64 ll = aLo * bLo;
        int64 lh = aLo * bHi;
        int64 hl = aHi * bLo;
        int64 hh = aHi * bHi;
        int64 cross = (ll >>> 32) + (lh & 0xFFFFFFFFL) + (hl & 0xFFFFFFFFL);
        int64 low = (cross << 32) | (ll & 0xFFFFFFFFL);
        int64 high = hh + (lh >>> 32) + (hl >>> 32) + (cross >>> 32);
        return low ^ high;
    }

    @Inline
    public static int64 mix2(int64 a0, int64 a1, int8[] secret, int64 off) {
        int64 x0 = a0 ^ Cajeta.loadU64(secret, off);
        int64 x1 = a1 ^ Cajeta.loadU64(secret, off + 8);
        return XXHash3.mulFold(x0, x1);
    }

    @Inline
    public static int64 avalanche(int64 h) {
        int64 x = h ^ (h >>> 37);
        x = x * 0x165667919E3779F9L;
        x = x ^ (x >>> 32);
        return x;
    }

    // The long-input driver: init 8 accumulators, run the block loop
    // (16 stripes + scramble), the trailing stripes, the final stripe, then
    // merge to a 64-bit digest.
    public static int64 hashLong(int8[] data, int64 len, int64 seed) {
        int8[] secret = XXHash3.buildSecret(seed);
        // INIT_ACC built directly as an 8-lane value vector (no heap staging
        // buffer): { PRIME32_3, PRIME64_1..4, PRIME32_2, PRIME64_5, PRIME32_1 }.
        // Vector is a value type — `stack` is syntactic, acc stays in registers.
        Vector<int64,8> acc = stack Vector<int64,8>(
            0x00000000C2B2AE3DL, 0x9E3779B185EBCA87L, 0xC2B2AE3D27D4EB4FL,
            0x165667B19E3779F9L, 0x85EBCA77C2B2AE63L, 0x0000000085EBCA77L,
            0x27D4EB2F165667C5L, 0x000000009E3779B1L);

        // A single flat stripe loop with a VARIABLE trip count so the optimizer
        // doesn't fully unroll it: under a 16x unroll the serial `acc` dependency
        // + per-stripe temps overflow the zmm file and `acc` spills to the stack
        // every stripe. As one rolled loop, `acc` stays a zmm-register PHI.
        // `inBlock` counts 0..15 within each 1024-byte block (== the stripe's
        // secret index); a full block of 16 triggers the scramble. The trailing
        // partial block (< 16 stripes) and the final stripe get no scramble —
        // exactly the XXH3 long-path structure.
        int64 nbBlocks = (len - 1) / 1024;
        int64 bIdx = 0;
        while (bIdx < nbBlocks) {
            int64 base = bIdx * 1024;
            int64 s = 0;
            while (s < 16) {                          // constant trip count -> unrolls,
                Vector<int64,8> d = Cajeta.vload8i64(data, base + s * 64); // pipelines the
                Vector<int64,8> key = d ^ Cajeta.vload8i64(secret, s * 8); // 16 independent
                Vector<int64,8> hi = key >>> 32;                           // addends ahead of
                acc = acc + (Cajeta.vswapPairs(d) + (key & 0xFFFFFFFFL) * hi); // the serial acc chain
                s = s + 1;
            }
            Vector<int64,8> shifted = acc >>> 47;
            acc = ((acc ^ shifted) ^ Cajeta.vload8i64(secret, 128)) * 0x000000009E3779B1L;
            bIdx = bIdx + 1;
        }
        int64 nbStripes = ((len - 1) - 1024 * nbBlocks) / 64;
        int64 s2 = 0;
        while (s2 < nbStripes) {
            Vector<int64,8> d = Cajeta.vload8i64(data, nbBlocks * 1024 + s2 * 64);
            Vector<int64,8> key = d ^ Cajeta.vload8i64(secret, s2 * 8);
            Vector<int64,8> hi = key >>> 32;
            acc = acc + (Cajeta.vswapPairs(d) + (key & 0xFFFFFFFFL) * hi);
            s2 = s2 + 1;
        }
        // The always-present last stripe (secret + 192 - 64 - 7).
        Vector<int64,8> dl = Cajeta.vload8i64(data, len - 64);
        Vector<int64,8> keyl = dl ^ Cajeta.vload8i64(secret, 121);
        Vector<int64,8> hil = keyl >>> 32;
        acc = acc + (Cajeta.vswapPairs(dl) + (keyl & 0xFFFFFFFFL) * hil);

        int64 result = len * 0x9E3779B185EBCA87L; // len * PRIME64_1
        result = result + XXHash3.mix2(Cajeta.vlane(acc, 0), Cajeta.vlane(acc, 1), secret, 11);
        result = result + XXHash3.mix2(Cajeta.vlane(acc, 2), Cajeta.vlane(acc, 3), secret, 27);
        result = result + XXHash3.mix2(Cajeta.vlane(acc, 4), Cajeta.vlane(acc, 5), secret, 43);
        result = result + XXHash3.mix2(Cajeta.vlane(acc, 6), Cajeta.vlane(acc, 7), secret, 59);
        return XXHash3.avalanche(result);
    }

    // The 128-bit long-input driver. The accumulator loop is IDENTICAL to
    // hashLong (XXH3 shares XXH3_hashLong_internal_loop between the 64- and
    // 128-bit paths); only the finalization differs — two mergeAccs instead of
    // one. low64 reuses the 64-bit merge (start = len*PRIME64_1, secret 11/27/
    // 43/59) so it equals hashLong bit-for-bit; high64 uses start = ~(len*
    // PRIME64_2) over secret 117/133/149/165 (= secretSize-64-11 + 16*i). The
    // 8-lane acc stays in a zmm register under --cpu=native exactly as hashLong.
    // Writes 16 bytes (low64 LE, then high64 LE) into out16 (no Vector-value
    // return — that mis-codegens to zero across a non-inlined call under -O3).
    public static void hashLong128Into(int8[] data, int64 len, int64 seed, int8[] out16) {
        int8[] secret = XXHash3.buildSecret(seed);
        Vector<int64,8> acc = stack Vector<int64,8>(
            0x00000000C2B2AE3DL, 0x9E3779B185EBCA87L, 0xC2B2AE3D27D4EB4FL,
            0x165667B19E3779F9L, 0x85EBCA77C2B2AE63L, 0x0000000085EBCA77L,
            0x27D4EB2F165667C5L, 0x000000009E3779B1L);

        int64 nbBlocks = (len - 1) / 1024;
        int64 bIdx = 0;
        while (bIdx < nbBlocks) {
            int64 base = bIdx * 1024;
            int64 s = 0;
            while (s < 16) {
                Vector<int64,8> d = Cajeta.vload8i64(data, base + s * 64);
                Vector<int64,8> key = d ^ Cajeta.vload8i64(secret, s * 8);
                Vector<int64,8> hi = key >>> 32;
                acc = acc + (Cajeta.vswapPairs(d) + (key & 0xFFFFFFFFL) * hi);
                s = s + 1;
            }
            Vector<int64,8> shifted = acc >>> 47;
            acc = ((acc ^ shifted) ^ Cajeta.vload8i64(secret, 128)) * 0x000000009E3779B1L;
            bIdx = bIdx + 1;
        }
        int64 nbStripes = ((len - 1) - 1024 * nbBlocks) / 64;
        int64 s2 = 0;
        while (s2 < nbStripes) {
            Vector<int64,8> d = Cajeta.vload8i64(data, nbBlocks * 1024 + s2 * 64);
            Vector<int64,8> key = d ^ Cajeta.vload8i64(secret, s2 * 8);
            Vector<int64,8> hi = key >>> 32;
            acc = acc + (Cajeta.vswapPairs(d) + (key & 0xFFFFFFFFL) * hi);
            s2 = s2 + 1;
        }
        Vector<int64,8> dl = Cajeta.vload8i64(data, len - 64);
        Vector<int64,8> keyl = dl ^ Cajeta.vload8i64(secret, 121);
        Vector<int64,8> hil = keyl >>> 32;
        acc = acc + (Cajeta.vswapPairs(dl) + (keyl & 0xFFFFFFFFL) * hil);

        int64 a0 = Cajeta.vlane(acc, 0);
        int64 a1 = Cajeta.vlane(acc, 1);
        int64 a2 = Cajeta.vlane(acc, 2);
        int64 a3 = Cajeta.vlane(acc, 3);
        int64 a4 = Cajeta.vlane(acc, 4);
        int64 a5 = Cajeta.vlane(acc, 5);
        int64 a6 = Cajeta.vlane(acc, 6);
        int64 a7 = Cajeta.vlane(acc, 7);

        int64 low = len * 0x9E3779B185EBCA87L;            // len * PRIME64_1
        low = low + XXHash3.mix2(a0, a1, secret, 11);
        low = low + XXHash3.mix2(a2, a3, secret, 27);
        low = low + XXHash3.mix2(a4, a5, secret, 43);
        low = low + XXHash3.mix2(a6, a7, secret, 59);
        low = XXHash3.avalanche(low);

        int64 high = ~(len * 0xC2B2AE3D27D4EB4FL);         // ~(len * PRIME64_2)
        high = high + XXHash3.mix2(a0, a1, secret, 117);
        high = high + XXHash3.mix2(a2, a3, secret, 133);
        high = high + XXHash3.mix2(a4, a5, secret, 149);
        high = high + XXHash3.mix2(a6, a7, secret, 165);
        high = XXHash3.avalanche(high);

        Cajeta.storeU64(out16, 0, low);
        Cajeta.storeU64(out16, 8, high);
    }
}
