package cajeta.hash;

import cajeta.lang.String;

/**
 * SHA-1 (FIPS 180-4) — 160-bit digest. **WebSocket handshake only.**
 *
 * **Not for security use.** SHA-1's collision resistance is broken:
 * a practical collision was demonstrated in 2017 (SHAttered) and
 * chosen-prefix collisions became practical in 2020. Do **not** use
 * SHA-1 for signatures, MACs, password hashing, certificate
 * fingerprinting, or anything where an attacker benefits from forging
 * a match. For real cryptographic hashing use `cajeta.hash.Sha256`.
 *
 * The **one** sanctioned use in this tree is the WebSocket opening
 * handshake. RFC 6455 §1.3 fixes the `Sec-WebSocket-Accept` value as
 *
 * ```
 * base64( SHA-1( Sec-WebSocket-Key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11" ) )
 * ```
 *
 * The handshake's correctness — not its security — depends on SHA-1
 * here; the algorithm is a protocol constant, so SHA-1's collision
 * weakness is irrelevant to it. This class exists to satisfy that
 * single caller (`cajeta.io.net` WebSocket handshake) and is flagged
 * accordingly.
 *
 * ## Surface
 *
 * One-shot statics:
 * ```cajeta
 * int8[] digest = Sha1.hash(bytes, bytes.count());   // 20 bytes
 * String hex    = Sha1.hashHex(bytes, bytes.count()); // 40 hex chars
 * ```
 *
 * Streaming `Hasher`:
 * ```cajeta
 * Sha1 h = heap Sha1();
 * h.update(keyBytes, keyBytes.count());
 * h.update(guidBytes, guidBytes.count());
 * int8[] accept = h.digest();   // 20-byte digest, then base64 it
 * ```
 *
 * `finish()` projects the 160-bit digest to 64 bits (first 8 bytes,
 * little-endian) to satisfy the `Hasher` contract. Callers wanting the
 * full 20-byte digest call `digest()` *before* `finish()` — once
 * `finish()` runs the state is consumed.
 *
 * ## v1 native-bridge workarounds
 *
 * - `boolean` doesn't yet coerce at the @Native ABI boundary, so
 *   `writeBoolean` materializes int8 via ternary.
 * - `int8[]` return from @Native doesn't register with the per-thread
 *   live-set, so one-shot and digest helpers pre-allocate the output
 *   on the cajeta side and the C helper fills it.
 *
 * @see cajeta.hash.Hasher
 * @see cajeta.hash.Sha256
 * @see [specification/hash/Hashing.md § SHA-1](../../../../../docs/specification/hash/Hashing.md)
 */
public final class Sha1 implements Hasher {

    /**
     * Opaque pointer to the native `struct cajeta_sha1_state`.
     */
    public pointer state;

    /**
     * Construct a fresh streaming SHA-1 hasher.
     *
     * @EntryPoint
     */
    public Sha1() {
        this.state = Sha1.allocState();
    }

    ~Sha1() {
        Sha1.freeState(this.state);
    }

    // --- @Native bridges --------------------------------------------

    @Native("__cajeta_sha1_alloc")
    private static pointer allocState();

    @Native("__cajeta_sha1_free")
    private static void freeState(pointer s);

    @Native("__cajeta_sha1_reset")
    private static void resetState(pointer s);

    @Native("__cajeta_sha1_update")
    private static void updateNative(pointer s, int8[] data, int64 len);

    @Native("__cajeta_sha1_finalize_into")
    private static void finalizeInto(pointer s, int8[] out);

    @Native("__cajeta_sha1_finish_int64")
    private static int64 finishInt64(pointer s);

    @Native("__cajeta_sha1_oneshot_into")
    private static void oneshotInto(int8[] data, int64 len, int8[] out);

    @Native("__cajeta_sha1_oneshot_hex_into")
    private static void oneshotHexInto(int8[] data, int64 len, int8[] out);

    @Native("__cajeta_sha1_write_i8")
    private static void writeI8Native(pointer s, int8 v);

    @Native("__cajeta_sha1_write_i16")
    private static void writeI16Native(pointer s, int16 v);

    @Native("__cajeta_sha1_write_i32")
    private static void writeI32Native(pointer s, int32 v);

    @Native("__cajeta_sha1_write_i64")
    private static void writeI64Native(pointer s, int64 v);

    @Native("__cajeta_sha1_write_f32")
    private static void writeF32Native(pointer s, float32 v);

    @Native("__cajeta_sha1_write_f64")
    private static void writeF64Native(pointer s, float64 v);

    // --- One-shot statics -------------------------------------------

    /**
     * One-shot 20-byte digest of `data[0..len)`. Allocates a fresh
     * `int8[20]` and transfers ownership to the caller.
     *
     * @EntryPoint
     */
    public static #int8[] hash(int8[] data, int64 len) {
        int8[] out = heap int8[20];
        Sha1.oneshotInto(data, len, out);
        return #out;
    }

    /**
     * One-shot lowercase 40-char hex digest of `data[0..len)`.
     *
     * @EntryPoint
     */
    public static #String hashHex(int8[] data, int64 len) {
        int8[] hex = heap int8[40];
        Sha1.oneshotHexInto(data, len, hex);
        return heap String(#hex, 40);
    }

    /**
     * One-shot 20-byte digest of a String's UTF-8 bytes.
     */
    public static #int8[] hashString(String s) {
        return Sha1.hash(s.bytes, (int64) s.byteLength);
    }

    /**
     * One-shot lowercase hex digest of a String's UTF-8 bytes.
     */
    public static #String hashStringHex(String s) {
        return Sha1.hashHex(s.bytes, (int64) s.byteLength);
    }

    // --- Streaming surface ------------------------------------------

    /**
     * Append `data[0..len)` to the streaming digest.
     */
    public void update(int8[] data, int64 len) {
        Sha1.updateNative(this.state, data, len);
    }

    /**
     * Finalize and return the 20-byte digest. Consumes the state —
     * subsequent updates produce undefined results until `reset()`.
     */
    public #int8[] digest() {
        int8[] out = heap int8[20];
        Sha1.finalizeInto(this.state, out);
        return #out;
    }

    /**
     * Re-initialize the working state. Lets a single Sha1 instance
     * hash multiple independent inputs without reallocating.
     */
    public void reset() {
        Sha1.resetState(this.state);
    }

    // --- Hasher streaming primitives --------------------------------

    public void writeBoolean(boolean v) {
        Sha1.writeI8Native(this.state, (int8)(v ? 1 : 0));
    }
    public void writeInt8(int8 v)       { Sha1.writeI8Native(this.state, v); }
    public void writeInt16(int16 v)     { Sha1.writeI16Native(this.state, v); }
    public void writeInt32(int32 v)     { Sha1.writeI32Native(this.state, v); }
    public void writeInt64(int64 v)     { Sha1.writeI64Native(this.state, v); }
    public void writeUInt8(uint8 v)     { Sha1.writeI8Native(this.state, (int8) v); }
    public void writeUInt16(uint16 v)   { Sha1.writeI16Native(this.state, (int16) v); }
    public void writeUInt32(uint32 v)   { Sha1.writeI32Native(this.state, (int32) v); }
    public void writeUInt64(uint64 v)   { Sha1.writeI64Native(this.state, (int64) v); }
    public void writeFloat32(float32 v) { Sha1.writeF32Native(this.state, v); }
    public void writeFloat64(float64 v) { Sha1.writeF64Native(this.state, v); }

    public void writeBytes(int8[] data) {
        Sha1.updateNative(this.state, data, data.count());
    }

    public void writeBytesRange(int8[] data, int64 offset, int64 length) {
        // v1: `offset` ignored — the C helper reads from data[8..].
        // Slicing primitive is a v2 follow-up.
        Sha1.updateNative(this.state, data, length);
    }

    public void writeString(String s) {
        Sha1.updateNative(this.state, s.bytes, (int64) s.byteLength);
    }

    public void writeObject(Object obj) {
        Sha1.writeI64Native(this.state, obj.hash());
    }

    public int64 finish() {
        return Sha1.finishInt64(this.state);
    }
}
