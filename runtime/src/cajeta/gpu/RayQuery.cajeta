package cajeta.gpu;

/**
 * RayQuery — a kernel-local cursor that traces a single ray through an
 * {@link AccelerationStructure} and walks the intersection candidates, entirely
 * inside a compute kernel (the `SPV_KHR_ray_query` "ray query in a shader"
 * model — no separate ray-tracing pipeline or hit shaders).
 *
 * Unlike Buffer / Texture2D / AccelerationStructure, a RayQuery is NOT a host
 * handle: it is a device-only, function-local object (lowered to an
 * `OpVariable Function` of `OpTypeRayQueryKHR`). It is constructed on the kernel
 * stack, initialized against a bound AccelerationStructure, then advanced:
 *
 *     RayQuery rq = stack RayQuery();
 *     rq.initialize(scene, 0, 255,        // AS, rayFlags, cullMask
 *                   px, py, pz,  0.0f,       // origin,    tMin
 *                   0.0f, 0.0f, 1.0f, r);    // direction, tMax
 *     while (rq.proceed()) {
 *         if (rq.candidateType() == 1u) {    // an AABB / procedural candidate
 *             // ... test the primitive; confirm/generate is a follow-up ...
 *         }
 *     }
 *     uint32 hit = rq.committedType();        // 0 = none committed
 *
 * The origin and direction are passed as three float32 scalars each (the lowerer
 * assembles the `<3 x float>` vectors); this keeps RayQuery independent of the
 * Vector<T,N> language type. For a spatial-index query, use a degenerate
 * near-zero-length ray (tMax ≈ 0) centred on the query point.
 *
 * RAY QUERY IS VULKAN-ONLY. `SPV_KHR_ray_query` is an `[EnvVulkan]` extension;
 * these operations lower only on the Vulkan/SPIR-V backend. On other backends a
 * RayQuery in a kernel is a clean "not supported on backend" diagnostic.
 *
 * v1 ops: initialize / proceed / committedType / candidateType — enough for the
 * spatial-index walk. Confirm/generate-intersection, the per-candidate geometry
 * getters (t, instance/primitive id, barycentrics), and committed-hit details
 * are follow-ups as their opcodes are lowered.
 *
 * The method bodies here are resolution placeholders — they are never emitted as
 * real calls; each is lowered at its call site inside an @Kernel / @Device
 * function to the backend ray-query op (Vulkan `OpRayQueryInitializeKHR` /
 * `OpRayQueryProceedKHR` / `OpRayQueryGetIntersectionTypeKHR` via the
 * `llvm.spv.ray.query.*` intrinsics). Using a RayQuery on the host is unsupported.
 */
public final class RayQuery {
    // Placeholder field. RayQuery is a device-only opaque (the device lowerer
    // ignores this host class entirely and allocates an OpTypeRayQueryKHR), but
    // the host front-end still lays the class out — a zero-field class has no
    // LLVM type, which would make every instance method's `this` parameter null.
    // One reserved word gives it a valid (never-used) host layout.
    int32 reserved;

    public RayQuery() {
        this.reserved = 0;
    }

    /**
     * Device-only intrinsic: begin a ray query against `as`. `rayFlags` is the
     * standard ray-flags bitmask (0 = none); `cullMask` the 8-bit instance cull
     * mask (255 = all). The ray is (origin, direction) with parametric extent
     * [tMin, tMax]; origin/direction are given component-wise.
     */
    public void initialize(AccelerationStructure as, uint32 rayFlags, uint32 cullMask,
                           float32 originX, float32 originY, float32 originZ,
                           float32 tMin,
                           float32 dirX, float32 dirY, float32 dirZ,
                           float32 tMax) {
    }

    /**
     * Device-only intrinsic: advance the traversal to the next candidate
     * intersection. Returns true while there is a candidate to inspect, false
     * once traversal is complete.
     */
    public boolean proceed() {
        return false;
    }

    /**
     * Device-only intrinsic: the type of the current COMMITTED intersection —
     * 0 = none, 1 = triangle, 2 = generated (procedural/AABB). Read after the
     * proceed() loop completes.
     */
    public uint32 committedType() {
        return 0;
    }

    /**
     * Device-only intrinsic: the type of the current CANDIDATE intersection —
     * 0 = triangle candidate, 1 = AABB (procedural) candidate. Read inside the
     * proceed() loop to decide how to test the candidate.
     */
    public uint32 candidateType() {
        return 0;
    }

    /**
     * Device-only intrinsic: the primitive (AABB / triangle) index of the current
     * CANDIDATE intersection — which indexed datum this candidate corresponds to.
     * The RTNN exact-distance refinement reads this inside the proceed() loop to
     * recover the data point and compute the true L2 distance (vs the AABB-overlap
     * L-infinity approximation). Maps to OpRayQueryGetIntersectionPrimitiveIndexKHR.
     */
    public uint32 candidatePrimitiveIndex() {
        return 0;
    }

    /**
     * Device-only intrinsic: the parametric distance `t` of the current CANDIDATE
     * intersection along the ray (origin + t·direction). Defined for triangle
     * candidates (the Möller-Trumbore hit distance); for AABB candidates it is the
     * box-entry parameter. Read inside the proceed() loop to find the nearest hit
     * (the user tracks the minimum, or commits via confirm/generate in a later
     * increment). Maps to OpRayQueryGetIntersectionTKHR (candidate).
     *
     * NOTE: software (CPU, etc.) only in v1; the native (Vulkan) getter needs a
     * fork SPIR-V intrinsic that is not yet carried.
     */
    public float32 candidateDistance() {
        return 0.0f;
    }

    /**
     * Device-only intrinsic: the barycentric `u` of the current TRIANGLE candidate
     * (the weight of vertex 1; vertex 0's weight is 1 - u - v). With
     * candidateBarycentricV, interpolates per-vertex attributes at the hit.
     * Maps to OpRayQueryGetIntersectionBarycentricsKHR (candidate). Software only
     * in v1 (native getter pending a fork intrinsic).
     */
    public float32 candidateBarycentricU() {
        return 0.0f;
    }

    /**
     * Device-only intrinsic: the barycentric `v` of the current TRIANGLE candidate
     * (the weight of vertex 2). See {@link #candidateBarycentricU}.
     */
    public float32 candidateBarycentricV() {
        return 0.0f;
    }

    /**
     * Device-only intrinsic: commit the current TRIANGLE candidate as the hit. The
     * ray's effective tMax shrinks to this candidate's distance, so the remaining
     * traversal only finds closer hits — call it for each accepted triangle and the
     * committed hit ends up the nearest. Read the result after the proceed() loop
     * via committedType()/committedDistance()/committed barycentrics. Maps to
     * OpRayQueryConfirmIntersectionKHR. Software (CPU) only in v1.
     */
    public void confirmIntersection() {
    }

    /**
     * Device-only intrinsic: commit an AABB (procedural) candidate as a generated
     * hit at parametric distance `t` (the shader's own intersection result; must be
     * within the current ray extent). Shrinks tMax to `t` like confirmIntersection.
     * Maps to OpRayQueryGenerateIntersectionKHR. Software (CPU) only in v1.
     */
    public void generateIntersection(float32 t) {
    }

    /**
     * Device-only intrinsic: the parametric distance of the COMMITTED (nearest)
     * intersection — valid after the proceed() loop when committedType() != 0.
     * (OpRayQueryGetIntersectionTKHR, committed.) Software only in v1.
     */
    public float32 committedDistance() {
        return 0.0f;
    }

    /** Committed triangle barycentric u (see candidateBarycentricU). */
    public float32 committedBarycentricU() {
        return 0.0f;
    }

    /** Committed triangle barycentric v. */
    public float32 committedBarycentricV() {
        return 0.0f;
    }

    /**
     * Device-only intrinsic: the caller primitive index of the COMMITTED hit.
     * (OpRayQueryGetIntersectionPrimitiveIndexKHR, committed.) Software only in v1.
     */
    public uint32 committedPrimitiveIndex() {
        return 0;
    }

    /**
     * Device-only intrinsic: whether the current TRIANGLE candidate is front-facing
     * (the CCW-winding convention — the geometric normal faces the ray).
     * (OpRayQueryGetIntersectionFrontFaceKHR, candidate.)
     *
     * NOTE: the front-face of an UNCONFIRMED candidate is unreliable on some
     * drivers (observed non-deterministic on RADV). For a dependable result,
     * confirmIntersection() the hit and read committedFrontFace(). The software
     * path is reliable for both.
     */
    public boolean candidateFrontFace() {
        return false;
    }

    /** Whether the COMMITTED hit is front-facing. See candidateFrontFace. */
    public boolean committedFrontFace() {
        return false;
    }
}
