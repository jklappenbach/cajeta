package cajeta.gpu;

/**
 * Strategy — the BVH encoding strategy (cajeta-accel; spec
 * docs/specs/cajeta-accel-spec.md §3). The ONLY axis that names a distinct
 * acceleration-structure encoding: the bound representation. Width (the branching
 * factor) and backend (where it runs) are ORTHOGONAL — width is lowered from
 * capability, backend is where the kernel executes — so neither appears here.
 *
 *   Exact      — full-float AABBs. No decode; bounds feed SIMD lanes directly.
 *                The natural CPU fit; Exact at width 2 is the {@link Bvh} Reference
 *                role, the correctness oracle and portable floor.
 *   Quantized  — 8-bit compressed AABBs ({@link BvhCodec}). Decode-on-read; ~one
 *                cache line per wide node. The natural GPU/bandwidth fit.
 *
 * Every strategy is CORRECT on every backend (quantized bounds stay conservative);
 * only the cost economics differ, so the capability-driven selector matches the
 * strategy to the backend and the benchmark harness measures the off-diagonal.
 *
 * The ordinal is the stable tag stored in a built structure's header — append
 * only, do not reorder.
 */
public enum Strategy {
    Exact,      // 0 — full-float AABBs
    Quantized   // 1 — 8-bit compressed AABBs
}
