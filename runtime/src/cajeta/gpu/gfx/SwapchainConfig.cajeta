package cajeta.gpu.gfx;

/**
 * SwapchainConfig — the pure WSI SELECTION POLICY a {@link Swapchain} is built
 * from (cajeta-gfx §4.2 / GP-1).
 *
 * A swapchain is an opaque, build-from-description driver object (the noun-seam
 * discipline of {@code cajeta.gpu}); its description is derived by CHOOSING,
 * from what the driver reports for a {@code cajeta.ifx.Surface}, the surface
 * (format, colorSpace) pair, the present mode, the image count, and the extent.
 * That choosing is backend-independent arithmetic over the reported capability
 * sets — separated here so it is testable on the host with no device, while the
 * live {@code VK_KHR_swapchain} acquire/present loop lives behind {@code Swapchain}'s
 * native primitives.
 *
 * ORDINALS ARE THE STABLE NATIVE CONTRACT (as for {@link cajeta.gpu.TextureFormat}):
 * every value here is the {@code VK_*} enum ordinal the runtime reports and
 * consumes — present modes are {@code VK_PRESENT_MODE_*_KHR}
 * (0 Immediate, 1 Mailbox, 2 Fifo, 3 FifoRelaxed), formats are {@code VK_FORMAT_*},
 * color spaces are {@code VK_COLOR_SPACE_*_KHR}. The policy never interprets the
 * values beyond equality and ordering, so it is format-taxonomy-agnostic.
 */
public class SwapchainConfig {

    // VK_PRESENT_MODE_FIFO_KHR — the one present mode the Vulkan spec guarantees
    // every surface supports; the universal fallback.
    public static int32 presentModeFifo() { return 2; }

    /**
     * Choose the present mode: `preferred` if the driver reports it among the
     * first `count` entries of `available`, otherwise FIFO (2) — the always-
     * supported mode. (Common picks: Mailbox(1) for low-latency triple buffering,
     * FIFO(2) for vsync.)
     */
    public static int32 choosePresentMode(int32[] available, int32 count, int32 preferred) {
        int32 i = 0;
        while (i < count) {
            if (available[i] == preferred) { return preferred; }
            i = i + 1;
        }
        return 2;  // VK_PRESENT_MODE_FIFO_KHR
    }

    /**
     * Choose a surface (format, colorSpace) pair and return its INDEX into the
     * driver's reported set — `formats[i]` paired with `colorSpaces[i]`, the
     * first `count` entries. Preference order: the exact
     * (prefFormat, prefColorSpace) pair; else the first pair whose colorSpace
     * matches `prefColorSpace` (keep the requested color space, take whatever
     * format carries it); else index 0 (the spec guarantees at least one pair).
     * Returns -1 when `count <= 0` (a surface with no formats — caller errors).
     */
    public static int32 chooseSurfaceFormat(int32[] formats, int32[] colorSpaces,
                                            int32 count, int32 prefFormat,
                                            int32 prefColorSpace) {
        if (count <= 0) { return -1; }
        int32 i = 0;
        while (i < count) {
            if (formats[i] == prefFormat) {
                if (colorSpaces[i] == prefColorSpace) { return i; }
            }
            i = i + 1;
        }
        int32 j = 0;
        while (j < count) {
            if (colorSpaces[j] == prefColorSpace) { return j; }
            j = j + 1;
        }
        return 0;
    }

    /**
     * Choose the swapchain image count: `desired` clamped into the surface's
     * [minImageCount, maxImageCount]. A `maxImageCount` of 0 means "no upper
     * bound" (the Vulkan convention), so only the lower bound applies. Callers
     * pick `desired = minImageCount + 1` for the usual double/triple buffering.
     */
    public static uint32 chooseImageCount(uint32 minImageCount, uint32 maxImageCount,
                                          uint32 desired) {
        uint32 n = desired;
        if (n < minImageCount) { n = minImageCount; }
        if (maxImageCount > 0) {
            if (n > maxImageCount) { n = maxImageCount; }
        }
        return n;
    }

    /**
     * Choose the swapchain extent width. Vulkan reports `currentExtent` =
     * 0xFFFFFFFF on both axes when the surface size is driven by the swapchain
     * (Wayland, some X11); then the caller's `desired` framebuffer width is used,
     * clamped to [minWidth, maxWidth]. Otherwise `currentWidth` is mandatory and
     * returned verbatim. {@link #chooseExtentHeight} is the matching axis.
     */
    public static uint32 chooseExtentWidth(uint32 currentWidth, uint32 desiredWidth,
                                           uint32 minWidth, uint32 maxWidth) {
        uint32 undefined = 4294967295;   // VK 0xFFFFFFFF — compare uint-to-uint
        if (currentWidth != undefined) { return currentWidth; }
        uint32 w = desiredWidth;
        if (w < minWidth) { w = minWidth; }
        if (w > maxWidth) { w = maxWidth; }
        return w;
    }

    /** Choose the swapchain extent height — see {@link #chooseExtentWidth}. */
    public static uint32 chooseExtentHeight(uint32 currentHeight, uint32 desiredHeight,
                                            uint32 minHeight, uint32 maxHeight) {
        uint32 undefined = 4294967295;   // VK 0xFFFFFFFF — compare uint-to-uint
        if (currentHeight != undefined) { return currentHeight; }
        uint32 h = desiredHeight;
        if (h < minHeight) { h = minHeight; }
        if (h > maxHeight) { h = maxHeight; }
        return h;
    }
}
