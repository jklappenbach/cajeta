package cajeta.gpu.gfx;

import cajeta.ifx.Surface;

/**
 * Swapchain — the presentable image chain a frame is rendered into and shown
 * through (cajeta-gfx §4.2 / GP-1). The one graphics noun that bridges to the
 * platform: it consumes an opaque {@link cajeta.ifx.Surface} and pairs it with
 * the matching Vulkan WSI extension to build a {@code VkSwapchainKHR}.
 *
 * BUILD-FROM-DESCRIPTION, OPAQUE, RAII — the same noun discipline as
 * {@link cajeta.gpu.AccelerationStructure} / {@link cajeta.gpu.Image2D}: a small
 * host-side handle ({@code deviceHandle}) over a driver object the constructor
 * acquires and the destructor releases at scope exit. The resolved description
 * (format / colorSpace / present mode / image count) is chosen by
 * {@link SwapchainConfig} from what the driver reports for the surface, then
 * passed in here; the per-frame ring is sequenced by {@link FrameSync}.
 *
 * SURFACE OPACITY. The {@code Surface}'s native handle is never inspected by app
 * code; the swapchain BACKEND (the native primitive below) is its sole privileged
 * reader — it is handed the surface and extracts the platform handle + kind to
 * pick the WSI path. A headless surface ({@code isHeadless()}) builds an offscreen
 * image ring instead (servers, CI, the harness).
 *
 * v1 LIMITS: a single swapchain, no explicit recreate on resize/out-of-date yet
 * (rebuild by dropping + reconstructing). The live acquire/queue-present runs on
 * a device; the offscreen path runs anywhere.
 */
public final class Swapchain {
    int64  deviceHandle;   // opaque VkSwapchainKHR (or offscreen ring); 0 == freed
    uint32 width;
    uint32 height;
    int32  format;         // resolved VK_FORMAT_* (see SwapchainConfig)
    int32  colorSpace;     // resolved VK_COLOR_SPACE_*_KHR
    int32  presentMode;    // resolved VK_PRESENT_MODE_*_KHR
    uint32 imageCount;     // number of images in the chain

    /**
     * RAII constructor: build a swapchain for `surface` with an already-resolved
     * description (use {@link SwapchainConfig} to choose the arguments from the
     * surface's reported capabilities). The constructor acquires the device
     * swapchain (or offscreen ring for a headless surface); ~Swapchain() releases
     * it.
     *
     *     Swapchain sc = heap Swapchain(surface, fmt, cs, pm, n);
     *     uint32 img = sc.acquireNextImage();
     *     // ... render into image `img` ...
     *     sc.present(img);
     *     // swapchain freed automatically at scope exit
     */
    public Swapchain(Surface surface, int32 format, int32 colorSpace,
                     int32 presentMode, uint32 imageCount) {
        this.width = surface.surfaceWidth();
        this.height = surface.surfaceHeight();
        this.format = format;
        this.colorSpace = colorSpace;
        this.presentMode = presentMode;
        this.imageCount = imageCount;
        this.deviceHandle = this.deviceCreate(surface, format, colorSpace,
                                              presentMode, imageCount);
    }

    /**
     * Destructor — release the device swapchain. Runs via the drop chain at scope
     * exit. Null-guarded and idempotent: a prior free, or a moved-from handle,
     * makes this a no-op.
     */
    ~Swapchain() {
        if (this.deviceHandle != 0) {
            this.deviceFree(this.deviceHandle);
            this.deviceHandle = 0;
        }
    }

    /**
     * Acquire the next image to render into, returning its index in the chain
     * (`vkAcquireNextImageKHR`). The caller renders into that image, then hands it
     * to {@link #present}. The per-frame in-flight pacing is the caller's, via
     * {@link FrameSync}.
     */
    public uint32 acquireNextImage() {
        return this.deviceAcquire(this.deviceHandle);
    }

    /** Present the rendered image `imageIndex` to the surface (`vkQueuePresentKHR`). */
    public void present(uint32 imageIndex) {
        this.devicePresent(this.deviceHandle, imageIndex);
    }

    public uint32 bufferCount()    { return this.imageCount; }
    public uint32 extentWidth()    { return this.width; }
    public uint32 extentHeight()   { return this.height; }
    public int32  colorFormat()    { return this.format; }
    public int32  colorSpaceTag()  { return this.colorSpace; }
    public int32  presentModeTag() { return this.presentMode; }

    // Device-swapchain primitives. Instance @Native methods (the
    // AccelerationStructure/Image2D convention): pointer-shaped at the ABI
    // boundary, one C symbol per name. `deviceCreate` is handed the Surface — the
    // backend reads its opaque handle + kind to pick the WSI path (or build the
    // offscreen ring for a headless surface). The runtime implementation lives in
    // the Vulkan WSI layer (cajeta-gfx §4.c) and is exercised on a device.
    @Native("__cajeta_gfx_swapchain_create")
    private int64 deviceCreate(Surface surface, int32 format, int32 colorSpace,
                               int32 presentMode, uint32 imageCount);

    @Native("__cajeta_gfx_swapchain_acquire")
    private uint32 deviceAcquire(int64 handle);

    @Native("__cajeta_gfx_swapchain_present")
    private void devicePresent(int64 handle, uint32 imageIndex);

    @Native("__cajeta_gfx_swapchain_free")
    private void deviceFree(int64 handle);
}
