package cajeta.gpu;

import cajeta.lang.Math;

/**
 * Sdf — signed-distance-field primitives, CSG combinators, and a sphere tracer
 * (cajeta-gfx §3, the acceleration/sampling/residency foundation; spec §8.7).
 *
 * A signed distance field maps a point to the distance to the nearest surface,
 * NEGATIVE inside the solid and zero exactly on it. SDFs compose analytically —
 * union is the min of two fields, intersection the max, subtraction max(a, -b)
 * — which makes them the natural representation for procedural geometry,
 * soft shadows, ambient occlusion, and collision margins.
 *
 * SPHERE TRACING renders an SDF without triangles: from a ray's current point,
 * the field value is the radius of the largest empty sphere, so a step of
 * exactly that distance provably never crosses a surface; iterating marches
 * right up to the boundary and stops when the field falls below epsilon. It
 * converges onto the analytic surface (a ray toward a sphere hits at the same
 * t the closed-form intersection gives).
 *
 * Pure scalar float32 math (no vector value types — every coordinate is passed
 * and returned as a scalar, sidestepping the value-type codegen traps), so it
 * is deterministic and host-testable, and lowers identically on the GPU. The
 * grid-sampled SDF (a `float32[]` volume + trilinear fetch) and the noise /
 * octahedral-encode primitives are the sibling slices of §3.c.
 */
public class Sdf {

    /** Signed distance to a sphere of radius `r` centred at the origin. */
    public static float32 sphere(float32 px, float32 py, float32 pz, float32 r) {
        float32 len = Math.sqrt(px * px + py * py + pz * pz);
        return len - r;
    }

    /**
     * Signed distance to an axis-aligned box with half-extents (bx, by, bz)
     * centred at the origin: the exterior distance (length of the positive part
     * of |p|-b) plus the interior term (max component of |p|-b, clamped to <= 0).
     */
    public static float32 box(float32 px, float32 py, float32 pz,
                              float32 bx, float32 by, float32 bz) {
        float32 qx = Math.abs(px) - bx;
        float32 qy = Math.abs(py) - by;
        float32 qz = Math.abs(pz) - bz;
        float32 mx = Math.max(qx, 0.0f);
        float32 my = Math.max(qy, 0.0f);
        float32 mz = Math.max(qz, 0.0f);
        float32 outside = Math.sqrt(mx * mx + my * my + mz * mz);
        float32 qyz = Math.max(qy, qz);
        float32 inner = Math.max(qx, qyz);
        float32 inside = Math.min(inner, 0.0f);
        return outside + inside;
    }

    /**
     * Signed distance to a plane through the origin with unit normal
     * (nx, ny, nz): the signed projection of `p` onto the normal (positive on
     * the normal's side). `n` is assumed already normalized.
     */
    public static float32 plane(float32 px, float32 py, float32 pz,
                                float32 nx, float32 ny, float32 nz) {
        return px * nx + py * ny + pz * nz;
    }

    /** CSG union: the field of A ∪ B is the nearer surface. */
    public static float32 opUnion(float32 a, float32 b) {
        return Math.min(a, b);
    }

    /** CSG intersection: the field of A ∩ B is the farther surface. */
    public static float32 opIntersect(float32 a, float32 b) {
        return Math.max(a, b);
    }

    /** CSG subtraction A \ B: intersect A with the complement of B. */
    public static float32 opSubtract(float32 a, float32 b) {
        return Math.max(a, 0.0f - b);
    }

    /**
     * Sphere-trace a ray against a single sphere (centre c, radius r). Marches
     * from t = 0 by the SDF value each step — the guaranteed-empty radius — and
     * returns the hit `t` once the field drops below `eps`, or -1 if it exits
     * past `tMax` or exhausts `maxSteps`. The ray direction (dx, dy, dz) should
     * be unit length so `t` is a true distance. This is the canonical sphere-
     * trace loop specialized to one primitive (cajeta has no SDF closures to
     * pass a general scene); CSG scenes inline opUnion/opIntersect in the loop.
     */
    public static float32 sphereTraceSphere(
            float32 ox, float32 oy, float32 oz,
            float32 dx, float32 dy, float32 dz,
            float32 cx, float32 cy, float32 cz, float32 r,
            float32 tMax, int32 maxSteps, float32 eps) {
        float32 t = 0.0f;
        int32 i = 0;
        while (i < maxSteps) {
            float32 px = ox + dx * t;
            float32 py = oy + dy * t;
            float32 pz = oz + dz * t;
            float32 rx = px - cx;
            float32 ry = py - cy;
            float32 rz = pz - cz;
            float32 d = Sdf.sphere(rx, ry, rz, r);
            if (d < eps) {
                return t;
            }
            t = t + d;
            if (t > tMax) {
                return 0.0f - 1.0f;
            }
            i = i + 1;
        }
        return 0.0f - 1.0f;
    }
}
