package cajeta.gpu;

/**
 * BvhCodec — the bit-reinterpret + quantized-node encoding primitives for a
 * COMPRESSED software BVH (cajeta-gfx §3, the acceleration foundation; spec §8.7).
 * The parked quality upgrade off {@link Lbvh}: the frozen BVH block stores its
 * integer fields (prim indices, child links) as float32 today, so every read pays
 * a float->int conversion cast — and that cast mis-lowers in the current codegen
 * (it must go the float64->int64->int32 long way, {@link Lbvh#floorToInt}). These
 * primitives remove both costs.
 *
 * Two upgrades, both pure encode/decode (no traversal — the single shipped
 * traversal {@link SoftwareRayQuery#step} is untouched; these are the building
 * blocks a future compressed layout would adopt):
 *
 *   1. REINTERPRET. {@link #packInt}/{@link #unpackInt} carry an exact int32 in a
 *      float32 slot by IEEE-754 BITCAST (`Cajeta.bitsToF32`/`f32ToBits`) instead of
 *      a value conversion. The round-trip is bit-exact for EVERY int32 — including
 *      values above 2^24 that a `(float32)` conversion would round and lose — and
 *      reading the field back is a single bitcast, not the float->int cast chain.
 *
 *   2. QUANTIZED NODES. A wide/compressed BVH stores each child AABB as 8-bit
 *      offsets inside the parent box (QBVH/CWBVH), shrinking a 6-float child box to
 *      6 bytes. {@link #quantizeMin}/{@link #quantizeMax} round the low corner DOWN
 *      and the high corner UP so {@link #dequantize} always yields a CONSERVATIVE
 *      box that fully encloses the true child (required for correct culling), tight
 *      to within one quantum (extent/255). {@link #packBytes4}/{@link #unpackByte}
 *      pack the quantized bytes into int32 words for compact storage.
 *
 * CODEGEN DISCIPLINE (see the value-type-codegen-gotchas memory). Byte packing
 * uses LEFT shift + or; byte extraction uses `(word >> shift) & 255` — the mask
 * cleans the sign-extension an arithmetic `>>` leaves on a word whose top byte set
 * the sign bit, so no int32 `>>>` (which mis-lowers) is needed. Float->int goes
 * through {@link Lbvh#floorToInt}'s float64->int64->int32 chain. Pure and
 * deterministic, so it is host-testable.
 */
public class BvhCodec {

    /**
     * Store the exact bits of int32 `v` in a float32 slot by IEEE-754 reinterpret
     * (not a value conversion). Inverse of {@link #unpackInt}. The returned float
     * is usually a NaN/denormal bit pattern — it is never meant to be read as a
     * number, only bitcast back.
     */
    public static float32 packInt(int32 v) {
        return Cajeta.bitsToF32(v);
    }

    /**
     * Recover the int32 stored by {@link #packInt} — a single bitcast, with no
     * float->int conversion cast (the cast the float-stored layout pays on every
     * read). Bit-exact for every int32.
     */
    public static int32 unpackInt(float32 w) {
        return Cajeta.f32ToBits(w);
    }

    /**
     * Floor `x` (>= 0 here) to int32 via the float64->int64->int32 chain — a direct
     * float32->int32 cast mis-lowers (the same route {@link Lbvh#floorToInt} uses).
     */
    public static int32 floorToInt(float32 x) {
        float64 xd = x;
        int64 t = (int64) xd;
        return (int32) t;
    }

    /** Ceil `x` (>= 0 here) to int32: floor, then bump up if floor undershot. */
    public static int32 ceilToInt(float32 x) {
        int32 f = BvhCodec.floorToInt(x);
        float32 fb = f;              // int32 -> float32
        if (fb < x) { f = f + 1; }
        return f;
    }

    /**
     * Quantize the LOW corner coordinate `c` of a child box to an 8-bit cell in
     * [0, 255] within the parent span [lo, hi], rounding DOWN — so the dequantized
     * value is <= `c` and the decoded box's min never cuts inside the true child.
     * Clamped at both ends; a degenerate span collapses to 0.
     */
    public static int32 quantizeMin(float32 c, float32 lo, float32 hi) {
        float32 span = hi - lo;
        float32 t = 0.0f;
        if (span > 0.0000001f) {
            t = (c - lo) / span;
        }
        if (t < 0.0f) { t = 0.0f; }
        if (t > 1.0f) { t = 1.0f; }
        int32 q = BvhCodec.floorToInt(t * 255.0f);
        if (q < 0) { q = 0; }
        if (q > 255) { q = 255; }
        return q;
    }

    /**
     * Quantize the HIGH corner coordinate `c` to an 8-bit cell in [0, 255] within
     * [lo, hi], rounding UP — so the dequantized value is >= `c` and the decoded
     * box's max never cuts inside the true child. Clamped; degenerate span -> 255.
     */
    public static int32 quantizeMax(float32 c, float32 lo, float32 hi) {
        float32 span = hi - lo;
        float32 t = 1.0f;
        if (span > 0.0000001f) {
            t = (c - lo) / span;
        }
        if (t < 0.0f) { t = 0.0f; }
        if (t > 1.0f) { t = 1.0f; }
        int32 q = BvhCodec.ceilToInt(t * 255.0f);
        if (q < 0) { q = 0; }
        if (q > 255) { q = 255; }
        return q;
    }

    /**
     * Decode an 8-bit quantized cell `q` (in [0, 255]) back to a float coordinate
     * in [lo, hi]: lo + (q/255)*(hi - lo). Paired with the directional rounding of
     * {@link #quantizeMin}/{@link #quantizeMax} this yields a conservative box.
     */
    public static float32 dequantize(int32 q, float32 lo, float32 hi) {
        float32 fq = q;             // int32 -> float32 (exact, <= 255)
        float32 t = fq / 255.0f;
        return lo + t * (hi - lo);
    }

    /**
     * Pack four bytes (each masked to [0, 255]) little-endian into one int32:
     * b0 in bits 0-7, b1 in 8-15, b2 in 16-23, b3 in 24-31. The `<< 24` of b3 may
     * set the sign bit — harmless, it is just a bit pattern (store it via
     * {@link #packInt} if it must ride in a float slot).
     */
    public static int32 packBytes4(int32 b0, int32 b1, int32 b2, int32 b3) {
        int32 r = b0 & 255;
        r = r | ((b1 & 255) << 8);
        r = r | ((b2 & 255) << 16);
        r = r | ((b3 & 255) << 24);
        return r;
    }

    /**
     * Extract byte `i` (0..3) from a packed int32 `word`: `(word >> (8*i)) & 255`.
     * The `& 255` removes the sign-extension an arithmetic `>>` leaves when the top
     * byte set the sign bit, so the byte comes back correct for any word — no int32
     * `>>>` needed.
     */
    public static int32 unpackByte(int32 word, int32 i) {
        int32 shift = i * 8;
        return (word >> shift) & 255;
    }
}
