package cajeta.lang;

/**
 * Immutable UTF-8 text, the single string type for Cajeta.
 *
 * See `docs/specification/lang/String.md` for the full design.
 *
 * ## Usage
 *
 * Strings are read-only: every transformation (`substring`, `trim`,
 * `toUpperCase`, `replace`, ...) returns a fresh heap `String` rather
 * than mutating in place, so they hand back `#String` (ownership
 * transfer). Query methods (`count`, `size`, `contains`, `indexOf`,
 * `startsWith`, `codepointAt`, ...) read without allocating.
 *
 * ```cajeta
 * heap String s = "  Hello, World  ";
 * String clean = s.trim();               // "Hello, World"
 * if (clean.startsWith("Hello") && clean.contains("World")) {
 *     String loud = clean.toUpperCase(); // "HELLO, WORLD"
 *     int64 codepoints = clean.count();   // 12 (codepoints, not bytes)
 *     int64 firstComma = clean.indexOf(","); // 5
 * }
 * ```
 *
 * ## Storage model — the tagged Utf8 core (slice-spec §8; slices plan 6.2.2)
 *
 * The storage is the 16-byte tagged core the `Utf8` value type pioneered,
 * discriminated by the length in `lenTag` (mask 0x1FFFFFFF):
 *
 *   len <= 12   Inline — the text bytes live directly in {aux, base}'s
 *               16 - 4 = 12 bytes; self-contained, no buffer, no rc.
 *               Every <= 12 B result is built Inline (the normalization
 *               rule), so pointer forms are unambiguous.
 *   len >  12   pointer form: `aux` = window byte offset, `base` = the
 *               ROOT CajetaArray header (count word + data); the text is
 *               base[8 + aux ..]. Tag bits:
 *                 bit31  wrapper holds one rc stake on base (drop
 *                        releases, copies retain).
 *                 bit30  BORROW — stakeless view of a heap root (the
 *                        compiler's scope-proven substring downgrade).
 *                 bit29  STATIC root (literals + views of them); no rc.
 *                 none   OWNED sole root — drop frees it through the
 *                        owner-drop seam.
 *
 * The legacy `mode` field and the 24-byte SSO region collapsed into the
 * tag; byte-level operations live in the C natives (cajeta_rt_string.c)
 * so the form dispatch is written exactly once. `byteLength` is a method
 * now — the length rides `lenTag`.
 *
 * Equality is content-based; `hash()` is XXH3 over the window bytes, in
 * parity with `Utf8.hash()` across every form.
 */
public final class String {
    int32 lenTag;
    int32 aux;
    int8[] base;
    public int32 cachedCpLength;

    /**
     * Constructs the empty String (Inline form, zero bytes).
     *
     * ```cajeta
     * heap String s = String();
     * boolean blank = s.isEmpty();   // true
     * int64 n = s.count();           // 0
     * ```
     *
     * @EntryPoint
     */
    public String() {
        this.lenTag = 0;
        this.aux = 0;
        this.base = null;
        this.cachedCpLength = -1;
    }

    // Ownership-transfer core of the (#int8[], int32) ctor: <= 12 B copies
    // Inline and frees the buffer; longer adopts it as this wrapper's OWNED
    // root. Consumes the buffer on both arms (the `#` at the call site
    // deactivated the caller's drop entry).
    @Native("__cajeta_string_adopt")
    private void adopt(#int8[] buf, int32 n);

    /**
     * Ownership-transfer constructor — takes the caller's byte buffer
     * (`#`: the caller's drop entry deactivates). Short payloads
     * (<= 12 B) copy Inline and the buffer is freed immediately; longer
     * payloads adopt the buffer as this String's owned root. This is the
     * builder path — every `return heap String(#out, n)` in the stdlib
     * (Number/Boolean/Guid/StringBuilder/Utf8.toString) routes here.
     *
     * @EntryPoint
     */
    public String(#int8[] bytes, int32 byteLength) {
        this.cachedCpLength = -1;
        this.adopt(#bytes, byteLength);
    }

    /**
     * Content-based hash overriding Object's identity hash — XXH3-64
     * (seeded with the per-process hash-flood seed) over the window
     * bytes, representation-independent across every form and in parity
     * with `Utf8.hash()`.
     */
    @Native("__cajeta_string_hash")
    public int64 hash();

    /**
     * Byte size of the text window, as int32. Replaces the retired
     * `byteLength` FIELD — the length rides `lenTag` now.
     */
    @Inline
    public int32 byteLength() {
        return this.lenTag & 0x1FFFFFFF;
    }

    /**
     * Byte size of the text window. Distinct from `count()` (codepoints).
     */
    @Inline
    public int64 size() {
        return (int64) (this.lenTag & 0x1FFFFFFF);
    }

    /** True when this String carries zero bytes. */
    @Inline
    public boolean isEmpty() {
        return (this.lenTag & 0x1FFFFFFF) == 0;
    }

    /**
     * Byte offset of this String's window within its root buffer — 0 for
     * Inline/owned/static full-window strings, the window offset for
     * views. With `root()` this is the zero-copy window contract for
     * consumers that pass the raw root buffer to natives.
     */
    @Inline
    public int64 byteOffset() {
        if ((this.lenTag & 0x1FFFFFFF) <= 12) {
            return (int64) 0;
        }
        return (int64) this.aux;
    }

    /**
     * The ROOT buffer backing this String as a borrowed int8[] handle —
     * null for Inline strings (they have no root; use `toBytes()`).
     * The window is `root()[byteOffset() .. byteOffset()+byteLength())`.
     * Zero-copy fast-path companion to `toBytes()` for audited consumers.
     */
    @Inline
    public int8[] root() {
        if ((this.lenTag & 0x1FFFFFFF) <= 12) {
            return null;
        }
        return this.base;
    }

    /**
     * Number of Unicode codepoints. O(N) on first call, then O(1)
     * (cached in `cachedCpLength`; -1 = not yet computed). Malformed
     * UTF-8 is counted best-effort (stray continuation bytes skipped).
     */
    public int64 count() {
        if (this.cachedCpLength >= 0) {
            return (int64) this.cachedCpLength;
        }
        int32 n = this.lenTag & 0x1FFFFFFF;
        int32 cps = 0;
        int32 i = 0;
        while (i < n) {
            int32 b = ((int32) this.byteAt(i)) & 0xff;
            if ((b & 0x80) == 0) {
                cps = cps + 1;
                i = i + 1;
            } else if ((b & 0xC0) == 0x80) {
                i = i + 1;
            } else {
                cps = cps + 1;
                i = i + 1;
                while (i < n && ((((int32) this.byteAt(i)) & 0xff) & 0xC0) == 0x80) {
                    i = i + 1;
                }
            }
        }
        this.cachedCpLength = cps;
        return (int64) cps;
    }

    // boolean routed through int32 at the native boundary (0/1) — the
    // @Native ABI doesn't coerce i1 yet (same workaround as cajeta.hash).
    @Native("__cajeta_string_equals")
    private int32 equalsNative(String other);

    /**
     * Byte-for-byte equality over the windows — representation-
     * independent (an Inline "abc" equals a windowed view of "abc").
     */
    @Inline
    public boolean equals(String other) {
        if (other == null) {
            return false;
        }
        return this.equalsNative(other) != 0;
    }

    /**
     * Value `==` for Strings: null-safe, byte-exact equality (delegates
     * to equals()). More-specific overload of Object.operator==.
     */
    public static boolean operator== (String a, String b) {
        if (a == null || b == null) {
            return a == null && b == null;
        }
        return a.equals(b);
    }

    /**
     * Raw byte at the given byte index, or 0 out of range. Byte-indexed;
     * codepoint access goes through `codepointAt`.
     */
    @Native("__cajeta_string_byte_at")
    public int8 charAt(int32 idx);

    /**
     * Raw byte at the given byte index, or 0 out of range. Same native
     * as charAt (the bounds check costs one compare).
     */
    @Native("__cajeta_string_byte_at")
    public int8 byteAt(int32 index);

    /**
     * First byte-index at which `needle`'s window appears in this
     * String's window, or -1. Empty needle matches at 0.
     */
    @Inline
    public int64 indexOf(String needle) {
        return this.indexOfFrom(needle, (int64) 0);
    }

    /** indexOf starting the scan at byte offset `start`. */
    @Native("__cajeta_string_index_of")
    public int64 indexOfFrom(String needle, int64 start);

    @Native("__cajeta_string_starts_with")
    private int32 startsWithNative(String prefix);

    /** True iff `prefix`'s window starts this String's window. */
    @Inline
    public boolean startsWith(String prefix) {
        if (prefix == null) {
            return false;
        }
        return this.startsWithNative(prefix) != 0;
    }

    @Native("__cajeta_string_ends_with")
    private int32 endsWithNative(String suffix);

    /** True iff `suffix`'s window ends this String's window. */
    @Inline
    public boolean endsWith(String suffix) {
        if (suffix == null) {
            return false;
        }
        return this.endsWithNative(suffix) != 0;
    }

    /** True iff `needle` appears anywhere in this String. */
    @Inline
    public boolean contains(String needle) {
        return this.indexOfFrom(needle, (int64) 0) >= (int64) 0;
    }

    /**
     * Returns a half-open byte-indexed window `[begin, end)` of this
     * String. Indices clamp to [0, byteLength]. ZERO-COPY for > 12 B
     * results (a stake-carrying view of this String's root buffer,
     * slice-spec §7.1); <= 12 B results are Inline (the normalization
     * rule — cheaper than any pointer chase, no lifetime at all).
     */
    public #String substring(int32 begin, int32 end) {
        int32 n = this.lenTag & 0x1FFFFFFF;
        if (begin < 0) {
            begin = 0;
        }
        if (end > n) {
            end = n;
        }
        if (end < begin) {
            end = begin;
        }
        return Cajeta.stringSlice(this, begin, end - begin);
    }

    /**
     * INTERNAL (slices plan 4.2.2): borrow-mode substring — identical
     * window semantics, zero rc. The compiler rewrites `substring` calls
     * to this when the receiving local provably never escapes.
     */
    public #String substringView(int32 begin, int32 end) {
        int32 n = this.lenTag & 0x1FFFFFFF;
        if (begin < 0) {
            begin = 0;
        }
        if (end > n) {
            end = n;
        }
        if (end < begin) {
            end = begin;
        }
        return Cajeta.stringSliceBorrow(this, begin, end - begin);
    }

    /**
     * Returns a new String with ASCII lowercase mapped to uppercase.
     * Non-ASCII bytes pass through (Unicode folding is a Locale-rollout
     * follow-up, as before).
     */
    @Native("__cajeta_string_upper")
    public #String toUpperCase();

    /** ASCII uppercase mapped to lowercase; same caveats as toUpperCase. */
    @Native("__cajeta_string_lower")
    public #String toLowerCase();

    /**
     * Strips leading and trailing ASCII whitespace (bytes 0..0x20) and
     * returns the resulting window — zero-copy for > 12 B results.
     */
    public #String trim() {
        int32 n = this.lenTag & 0x1FFFFFFF;
        int32 start = 0;
        int32 end = n;
        while (start < end && (((int32) this.byteAt(start)) & 0xff) <= 0x20) {
            start = start + 1;
        }
        while (end > start && (((int32) this.byteAt(end - 1)) & 0xff) <= 0x20) {
            end = end - 1;
        }
        return Cajeta.stringSlice(this, start, end - start);
    }

    /** INTERNAL (slices plan 4.2.2): borrow-mode trim — see substringView. */
    public #String trimView() {
        int32 n = this.lenTag & 0x1FFFFFFF;
        int32 start = 0;
        int32 end = n;
        while (start < end && (((int32) this.byteAt(start)) & 0xff) <= 0x20) {
            start = start + 1;
        }
        while (end > start && (((int32) this.byteAt(end - 1)) & 0xff) <= 0x20) {
            end = end - 1;
        }
        return Cajeta.stringSliceBorrow(this, start, end - start);
    }

    // Native replace core: NULL result = "no change" (no match, empty or
    // null pattern) so this side can hand back the receiver unchanged.
    @Native("__cajeta_string_replace")
    private String replaceNative(String from, String repl);

    /**
     * Returns a new String with every non-overlapping occurrence of
     * `from` replaced by `repl`. No match (or empty/null `from`)
     * returns this String unchanged.
     */
    public #String replace(String from, String repl) {
        String out = this.replaceNative(from, repl);
        if (out == null) {
            return this;
        }
        return #out;
    }

    /**
     * The effective byte window as a fresh caller-owned array — the
     * view-safe replacement for raw buffer reads (same contract as
     * before the re-core).
     */
    @Native("__cajeta_string_to_bytes")
    public #int8[] toBytes();

    /**
     * Unicode codepoint at the given codepoint index. O(N) walk;
     * malformed UTF-8 decoded best-effort. Out-of-range returns 0.
     */
    public char codepointAt(int32 cpIdx) {
        int32 n = this.lenTag & 0x1FFFFFFF;
        int32 i = 0;       // byte cursor
        int32 cp = 0;      // current codepoint index
        while (i < n) {
            int32 b0 = ((int32) this.byteAt(i)) & 0xff;
            int32 width = 1;
            int32 decoded = 0;
            if ((b0 & 0x80) == 0) {
                decoded = b0;
                width = 1;
            } else if ((b0 & 0xE0) == 0xC0) {
                int32 b1 = (i + 1 < n) ? (((int32) this.byteAt(i + 1)) & 0xff) : 0;
                decoded = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                width = 2;
            } else if ((b0 & 0xF0) == 0xE0) {
                int32 b1 = (i + 1 < n) ? (((int32) this.byteAt(i + 1)) & 0xff) : 0;
                int32 b2 = (i + 2 < n) ? (((int32) this.byteAt(i + 2)) & 0xff) : 0;
                decoded = ((b0 & 0x0F) << 12)
                        | ((b1 & 0x3F) << 6)
                        |  (b2 & 0x3F);
                width = 3;
            } else if ((b0 & 0xF8) == 0xF0) {
                int32 b1 = (i + 1 < n) ? (((int32) this.byteAt(i + 1)) & 0xff) : 0;
                int32 b2 = (i + 2 < n) ? (((int32) this.byteAt(i + 2)) & 0xff) : 0;
                int32 b3 = (i + 3 < n) ? (((int32) this.byteAt(i + 3)) & 0xff) : 0;
                decoded = ((b0 & 0x07) << 18)
                        | ((b1 & 0x3F) << 12)
                        | ((b2 & 0x3F) << 6)
                        |  (b3 & 0x3F);
                width = 4;
            } else {
                // Stray continuation or invalid leader — skip without counting.
                i = i + 1;
                continue;
            }
            if (cp == cpIdx) {
                return (char) decoded;
            }
            cp = cp + 1;
            i = i + width;
        }
        return (char) 0;
    }
}
