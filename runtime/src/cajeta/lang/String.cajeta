package cajeta.lang;

/**
 * Immutable UTF-8 text, the single string type for Cajeta.
 *
 * See `docs/specification/lang/String.md` for the full design — this
 * file is the load-bearing data definition; method implementations land
 * in subsequent phases (Phase 2c+).
 *
 * ## Usage
 *
 * Strings are read-only: every transformation (`substring`, `trim`,
 * `toUpperCase`, `replace`, ...) returns a fresh heap `String` rather
 * than mutating in place, so they hand back `#String` (ownership
 * transfer). Query methods (`count`, `size`, `contains`, `indexOf`,
 * `startsWith`, `codepointAt`, ...) read without allocating.
 *
 * ```cajeta
 * heap String s = "  Hello, World  ";
 * String clean = s.trim();               // "Hello, World"
 * if (clean.startsWith("Hello") && clean.contains("World")) {
 *     String loud = clean.toUpperCase(); // "HELLO, WORLD"
 *     int64 codepoints = clean.count();   // 12 (codepoints, not bytes)
 *     int64 firstComma = clean.indexOf(","); // 5
 * }
 * ```
 *
 * Equality is content-based: `Object`'s `==` dispatches through the
 * `hash()` override below, and `equals(String)` is the explicit
 * byte-for-byte check. Hashing keys cleanly into `HashMap` and
 * `HashSet`.
 *
 * ## Phase 2b-α scope
 *
 * What's here today:
 *   - The four-field storage layout (see below)
 *   - A no-arg constructor that leaves bytes null and the discriminator
 *     fields at safe defaults (mode = 0 owned, cachedCpLength = -1 not
 *     computed). This is the JIT-test surface that pins the layout.
 *
 * What's NOT yet wired:
 *   - String literals still emit `i8*` via the legacy primitive alias
 *     (see CajetaType.cpp:130 — the alias coexists with this class for
 *     now and is removed in Phase 2b-β when literal codegen materializes
 *     view-mode `String` instances pointing at static storage).
 *   - No methods (`size`, `getBytes`, `fromBytes`, comparison, ...) —
 *     each lands in its own phase, paired with JIT tests.
 *
 * ## Storage model
 *
 *   - `bytes`           : UTF-8 payload. Owner of the bytes when
 *                         `mode == 0`; borrowed view into static or
 *                         externally-owned storage when `mode == 1`.
 *   - `byteLength`      : number of valid bytes in `bytes`. Distinct
 *                         from any underlying array length so view
 *                         mode (which slices into shared storage) can
 *                         carry a length independent of the host
 *                         buffer.
 *   - `mode`            : 0 = owned, 1 = view. The drop chain checks
 *                         this to decide whether to reclaim `bytes`.
 *   - `cachedCpLength`  : lazy codepoint count. `-1` = not yet
 *                         computed; first call to a codepoint-counting
 *                         method walks the bytes once and caches the
 *                         result. Cheap (4 bytes) and removes the
 *                         O(N) cost from repeated `length` calls on
 *                         the same String.
 *
 * Field visibility is `public` for Phase 2b-α so the JIT tests can
 * pin layout directly. Once methods land, visibility narrows and the
 * pinning shifts to behaviour-level assertions.
 */
public final class String {
    public int8[] bytes;
    public int32  byteLength;
    public int32  mode;
    public int32  cachedCpLength;
    // Small-string optimization (SSO). For short owned strings the compiler
    // points `bytes` at this inline region instead of a separate heap buffer,
    // so a build like `"key" + i` costs no buffer allocation. The two fields
    // are contiguous and shaped exactly like a CajetaArray header
    // ({ i64 count; i8 data[] }), so every `bytes` reader works unchanged:
    // ssoCount is the count word, ssoData is the data. ssoData length is the
    // SSO capacity (compiler caps inline at length-1 to leave room for a NUL).
    // Untouched (left zero) for view-mode literals and heap-buffer strings.
    private int64    ssoCount;
    private int8[24] ssoData;

    /**
     * Constructs the empty String — `bytes` null, `byteLength` 0,
     * `mode` 0 (owned), `cachedCpLength` -1 (not yet computed). The
     * empty literal `""` produces an equivalent value.
     *
     * ```cajeta
     * heap String s = String();
     * boolean blank = s.isEmpty();   // true
     * int64 n = s.count();           // 0
     * ```
     *
     * @EntryPoint
     */
    public String() {
        this.bytes = null;
        this.byteLength = 0;
        this.mode = 0;
        this.cachedCpLength = -1;
    }

    /**
     * Ownership-transfer constructor — takes the caller's byte buffer
     * (`#`: the caller's drop entry deactivates) and OWNS it: this
     * String's drop frees `bytes` (mode 0). This is the builder path —
     * every `return heap String(#out, n)` in the stdlib
     * (Number/Boolean/Guid/StringBuilder/Utf8.toString) transfers a
     * freshly built buffer here.
     *
     * History (slices plan 9.1): this ctor used to set mode = 1 (view)
     * while STILL taking `#` — the signature transferred ownership the
     * body then declined, so every transferred buffer was orphaned
     * (+1 leak per toString). Static-buffer literals never route here
     * (literal codegen materializes its own mode-1 instances), so the
     * view behavior protected nothing.
     *
     * `cachedCpLength` is initialized to -1 (not yet computed); the
     * first `count()` call walks `bytes` and caches the result.
     *
     * @EntryPoint
     */
    public String(#int8[] bytes, int32 byteLength) {
        this.bytes = bytes;
        this.byteLength = byteLength;
        this.mode = 0;
        this.cachedCpLength = -1;
    }

    /**
     * Content-based hash overriding Object's identity hash.
     *
     * Two distinct String instances with identical UTF-8 bytes hash
     * equally, which gives `==` (inherited from Object via virtual
     * dispatch through hash()) automatic value-equality semantics on
     * String. String does NOT override operator== — the semantic shift
     * is carried entirely by this hash() override.
     *
     * Backed by the runtime XXH3-64 (seeded with the per-process hash-
     * flood seed) via the Cajeta.hashBytes intrinsic — multi-GB/s vs the
     * old byte-at-a-time FNV-1a dependency chain, and the same DoS-
     * resistant seeded construction the primitive and cajeta.hash hashers
     * use.
     *
     * The empty/null-bytes case hashes via the len == 0 path (a stable
     * seed-derived value), so `heap String()` and `heap String(b, 0)`
     * agree.
     */
    public int64 hash() {
        // bytes==null implies byteLength==0 (both ctors), and the XXH3
        // len==0 path never dereferences the data pointer, so the null
        // and empty cases yield the same seed-derived value with no guard.
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        return Cajeta.hashBytes(this.bytes, (int64) o, (int64) this.byteLength);
    }

    /**
     * Number of Unicode characters (codepoints) in this String.
     *
     * Walks the UTF-8 payload counting codepoints — O(N) on first call,
     * then O(1) on subsequent calls (cached in `cachedCpLength`; -1
     * means not yet computed). Counting by ASCII fast-path skips
     * continuation bytes (10xxxxxx) and only increments on leader
     * bytes (0xxxxxxx or 11xxxxxx).
     *
     * Distinct from byte length (`byteLength` field) — UTF-8 encodes
     * codepoints in 1..4 bytes, so an n-codepoint String has between
     * n and 4n bytes. For ASCII the two are equal.
     *
     * Returns int64 for forward-compatibility with very large strings;
     * the in-memory cache uses int32 (`cachedCpLength`) because a
     * String exceeding 2 billion codepoints is implausible in practice
     * and the 4-byte field keeps the header compact.
     *
     * Malformed UTF-8 input (continuation byte where a leader is
     * expected) is skipped silently — the count is "best effort" for
     * invalid input. Use String.fromBytes with EncodingErrorPolicy.FAIL
     * at the ingestion boundary if you need malformed-input rejection.
     */
    public int64 count() {
        if (this.cachedCpLength >= 0) {
            return (int64) this.cachedCpLength;
        }
        if (this.bytes == null) {
            this.cachedCpLength = 0;
            return 0;
        }
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 cps = 0;
        int32 i = 0;
        while (i < this.byteLength) {
            int32 b = ((int32) this.bytes[o + i]) & 0xff;
            if ((b & 0x80) == 0) {
                // ASCII byte — one codepoint, one byte.
                cps = cps + 1;
                i = i + 1;
            } else if ((b & 0xC0) == 0x80) {
                // Stray continuation byte at a leader-expected position;
                // skip without counting (malformed input is best-effort).
                i = i + 1;
            } else {
                // Leader byte (0xC0-0xFF). Count one codepoint, then
                // skip all following continuation bytes for this
                // codepoint.
                cps = cps + 1;
                i = i + 1;
                while (i < this.byteLength
                        && (((int32) this.bytes[o + i]) & 0xC0) == 0x80) {
                    i = i + 1;
                }
            }
        }
        this.cachedCpLength = cps;
        return (int64) cps;
    }

    /**
     * Byte size of the underlying data buffer. Returns `byteLength`
     * as int64.
     *
     * Distinct from `count()` (which returns the codepoint count).
     * For ASCII the two coincide; for multibyte UTF-8 they diverge.
     * Naming convention (2026-05-19):
     *   - `count()` = number of logical elements (codepoints here,
     *     entries for collections).
     *   - `size()`  = byte size of the storage buffer.
     * `length()` is intentionally absent — ambiguous in practice
     * (capacity vs element count depending on the reader's
     * background) and the universal-`count()` convention removes it.
     */
    @Inline
    public int64 size() {
        return (int64) this.byteLength;
    }

    /**
     * True when this String carries zero bytes — equivalent to
     * `byteLength == 0`. The empty literal `""` and the no-arg ctor
     * both produce empty strings.
     */
    @Inline
    public boolean isEmpty() {
        return this.byteLength == 0;
    }

    /**
     * Byte-for-byte equality. Two Strings are equal iff they have the
     * same byteLength and identical UTF-8 payloads. Distinct from
     * Object.operator==, which falls through to hash() comparison;
     * for collision-sensitive callers, equals() is the explicit
     * byte-walk.
     *
     * Phase 2b-β note: this overload's signature is `(String)`, not
     * `(Object)`, so it does NOT override Object.operator==. It IS
     * the canonical content-equality entry point — call it directly
     * when you want byte-for-byte semantics; the operator== path
     * still works via hash() and is enough for hash-keyed
     * collections.
     */
    public boolean equals(String other) {
        if (other == null) {
            return false;
        }
        if (this.byteLength != other.byteLength) {
            return false;
        }
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 oo = 0;
        if (other.mode == 2) { oo = (int32) other.ssoCount; }
        int32 i = 0;
        while (i < this.byteLength) {
            if (this.bytes[o + i] != other.bytes[oo + i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /**
     * Value `==` for Strings: null-safe, BYTE-EXACT equality. Two non-null
     * Strings are equal iff they have identical UTF-8 payloads (delegates to
     * equals()). This is a more-specific overload of the inherited
     * Object.operator==(Object,Object) (resolveMethod prefers it for two String
     * operands; `String == Object` still falls through to Object's hash form).
     *
     * Byte-exact, not the inherited hash-only compare, for two reasons:
     *   1. Correctness — hash equality admits collisions, so hash-based `==`
     *      could report two distinct strings equal. Hash-keyed collections
     *      confirm a probe with `==`, so a collision there returned the WRONG
     *      value; the byte walk closes that latent hole.
     *   2. Speed — both params are statically `String` (a `final` class), so the
     *      equals() call (and the byteLength/byte loop inside it) devirtualizes
     *      to a direct, inlinable call. The old hash form recomputed BOTH
     *      operands' XXH3 every comparison — in a map probe the key was hashed
     *      for the bucket and then re-hashed twice more inside `==` (~3 XXH3 per
     *      lookup); a short-key byte compare is far cheaper.
     */
    public static boolean operator== (String a, String b) {
        if (a == null || b == null) {
            return a == null && b == null;
        }
        return a.equals(b);
    }

    /**
     * Returns the byte at the given byte index, or 0 if the index is
     * out of range. v1 charAt is byte-indexed and returns int8
     * (ASCII-equivalent code unit), matching the legacy intrinsic-
     * dispatch behavior — codepoint-indexed access goes through
     * `codepointAt`. The Java-style `char` (codepoint) variant lands
     * if the design expands later; for now the two cover distinct
     * use cases (raw byte vs Unicode scalar).
     */
    @Inline
    public int8 charAt(int32 idx) {
        if (idx < 0 || idx >= this.byteLength) {
            return (int8) 0;
        }
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        return this.bytes[o + idx];
    }

    /**
     * First byte-index at which `needle`'s payload appears as a
     * contiguous run in this String, or -1 if not found. Returns 0
     * for an empty needle (matches the standard "every string
     * contains the empty string at position 0" convention).
     *
     * O(N×M) naive byte-walk — sufficient for v1; KMP / Boyer-Moore
     * is a follow-up once the search/replace path becomes a hotspot.
     */
    public int64 indexOf(String needle) {
        return this.indexOfFrom(needle, 0);
    }

    // SWAR substring search starting at byte offset `start`. `indexOf` is
    // `indexOfFrom(needle, 0)`. (`replace` does NOT use this per-match — it inlines
    // one continuous SWAR scan so the setup is hoisted out of the match loop.)
    public int64 indexOfFrom(String needle, int64 start) {
        if (needle == null) {
            return (int64) -1;
        }
        int32 nlen = needle.byteLength;
        if (nlen == 0) {
            return start;
        }
        if ((int64) nlen > (int64) this.byteLength - start) {
            return (int64) -1;
        }
        int64 hlen = (int64) this.byteLength;
        int64 lim = hlen - (int64) nlen;          // last valid start offset
        int64 ho = 0;
        if (this.mode == 2) { ho = this.ssoCount; }
        int32 no = 0;
        if (needle.mode == 2) { no = (int32) needle.ssoCount; }
        int8 first = needle.bytes[no];
        int8 last = needle.bytes[no + nlen - 1];
        // SIMD memmem (two-byte prefilter, 32 bytes/iter -> AVX2 under cpu=native).
        // For each block, vector-compare the first-byte window bytes[i..i+31] to
        // `first` AND the last-byte window bytes[i+nlen-1..+31] to `last`; only
        // positions matching BOTH (cand) get a full verify. A needle whose first
        // and last bytes rarely co-occur (the common case) clears `cand` to 0 most
        // iterations, so the loop runs at vector-load bandwidth. nlen==1 reduces to
        // a single-window scan (last==first, both windows alias) automatically.
        int64 i = start;
        int64 blockEnd = lim - 31;                 // last i with both 32-byte loads in bounds
        int64 nm1 = (int64) nlen - 1;
        while (i <= blockEnd) {
            Vector<int8,32> va = this.bytes.vload<32>(ho + i);
            Vector<int8,32> vb = this.bytes.vload<32>(ho + i + nm1);
            int32 cand = va.eqMask(first) & vb.eqMask(last);
            while (cand != 0) {
                int64 at = i + (int64) Cajeta.ctz64((int64) cand);
                if (this.regionMatches(at, needle, nlen)) {
                    return at;
                }
                cand = cand & (cand - 1);          // clear this candidate, find the next
            }
            i = i + 32;
        }
        // Tail (short haystacks, or the final < 32-byte window): scalar scan.
        while (i <= lim) {
            if (this.bytes[ho + i] == first && this.regionMatches(i, needle, nlen)) {
                return i;
            }
            i = i + 1;
        }
        return (int64) -1;
    }

    // Verify `needle[0..nlen)` occurs at byte offset `at`. (The first byte is
    // already known to match at SWAR candidates, but we re-check all bytes so
    // the scalar tail and any SWAR false positive are handled uniformly.)
    @Inline
    private boolean regionMatches(int64 at, String needle, int32 nlen) {
        int64 ho = 0;
        if (this.mode == 2) { ho = this.ssoCount; }
        int32 no = 0;
        if (needle.mode == 2) { no = (int32) needle.ssoCount; }
        int32 j = 0;
        while (j < nlen) {
            if (this.bytes[ho + at + (int64) j] != needle.bytes[no + j]) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /**
     * True iff `prefix`'s bytes appear at the start of this String's
     * payload. Empty prefix is always a prefix; null is treated as
     * the absence of a prefix (returns false).
     */
    public boolean startsWith(String prefix) {
        if (prefix == null) {
            return false;
        }
        if (prefix.byteLength > this.byteLength) {
            return false;
        }
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 po = 0;
        if (prefix.mode == 2) { po = (int32) prefix.ssoCount; }
        int32 i = 0;
        while (i < prefix.byteLength) {
            if (this.bytes[o + i] != prefix.bytes[po + i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /**
     * True iff `suffix`'s bytes appear at the end of this String's
     * payload. Mirrors startsWith on the trailing side.
     */
    public boolean endsWith(String suffix) {
        if (suffix == null) {
            return false;
        }
        if (suffix.byteLength > this.byteLength) {
            return false;
        }
        int32 off = this.byteLength - suffix.byteLength;
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 so = 0;
        if (suffix.mode == 2) { so = (int32) suffix.ssoCount; }
        int32 i = 0;
        while (i < suffix.byteLength) {
            if (this.bytes[o + off + i] != suffix.bytes[so + i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /**
     * True iff `needle`'s bytes appear anywhere in this String's
     * payload. Delegates to indexOf and tests for non-negative
     * result.
     */
    @Inline
    public boolean contains(String needle) {
        return this.indexOf(needle) >= (int64) 0;
    }

    /**
     * Returns a half-open byte-indexed slice `[begin, end)` of this
     * String. Indices are clamped to [0, byteLength]; if end < begin
     * after clamping the result is empty. ZERO-COPY (slice-spec §7.1):
     * the result is a mode-2 windowed view sharing this String's root
     * buffer — the runtime promotes/retains the root per the source's
     * mode; SSO sources materialize a copy (never a view into a
     * wrapper's inline region).
     */
    public #String substring(int32 begin, int32 end) {
        if (begin < 0) {
            begin = 0;
        }
        if (end > this.byteLength) {
            end = this.byteLength;
        }
        if (end < begin) {
            end = begin;
        }
        int32 len = end - begin;
        return Cajeta.stringSlice(this, begin, len);
    }

    /**
     * INTERNAL (slices plan 4.2.2): borrow-mode substring — identical window
     * semantics, but the view takes NO stake (zero rc). The compiler rewrites
     * `substring` calls to this when the receiving local provably never
     * leaves its scope; escapes of the VALUE resolve at their own sites.
     * Not intended for direct use.
     */
    public #String substringView(int32 begin, int32 end) {
        if (begin < 0) {
            begin = 0;
        }
        if (end > this.byteLength) {
            end = this.byteLength;
        }
        if (end < begin) {
            end = begin;
        }
        int32 len = end - begin;
        return Cajeta.stringSliceBorrow(this, begin, len);
    }

    // 0x80 in each byte of `v` whose value lies in [lo, hi]. Valid only when
    // every byte of `v` is < 0x80 (no inter-byte carry): byte+0x80-lo sets the
    // high bit iff byte >= lo, and the same for hi+1 gives byte > hi.
    @Inline
    private static uint64 asciiRangeMask(uint64 v, uint64 lo, uint64 hi) {
        uint64 high = (uint64) 0x8080808080808080;
        uint64 ones = (uint64) 0x0101010101010101;
        uint64 ge = (v + ones * ((uint64) 0x80 - lo)) & high;
        uint64 gt = (v + ones * ((uint64) 0x80 - (hi + (uint64) 1))) & high;
        return ge & ~gt;
    }

    // Uppercase/lowercase an all-ASCII 8-byte word. The bit-5 mask is confined
    // with & 0x2020..20 so the result is correct regardless of >> signedness.
    @Inline
    private static uint64 swarUpper(uint64 v) {
        uint64 m = String.asciiRangeMask(v, (uint64) 0x61, (uint64) 0x7A);
        return v & ~((m >> 2) & (uint64) 0x2020202020202020);
    }
    @Inline
    private static uint64 swarLower(uint64 v) {
        uint64 m = String.asciiRangeMask(v, (uint64) 0x41, (uint64) 0x5A);
        return v | ((m >> 2) & (uint64) 0x2020202020202020);
    }

    /**
     * Returns a new String with all ASCII lowercase letters mapped
     * to uppercase. Non-ASCII bytes pass through unchanged — full
     * Unicode case folding (locale-aware, multi-byte) is a planned
     * follow-up tied to the cajeta.text.Locale rollout.
     */
    public #String toUpperCase() {
        int32 n = this.byteLength;
        int8[] out = Cajeta.allocBytes((int64) n);   // every byte written below
        int8[] src = this.bytes;
        int32 so = 0;
        if (this.mode == 2) { so = (int32) this.ssoCount; }
        uint64 high = (uint64) 0x8080808080808080;
        int32 k = 0;
        // 32 bytes/iter (4 words, one ASCII guard); clears bit 5 ([a-z]->[A-Z]).
        while (k + 32 <= n) {
            uint64 v0 = (uint64) Cajeta.loadU64(src, (int64) (so + k));
            uint64 v1 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 8));
            uint64 v2 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 16));
            uint64 v3 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 24));
            if ((((v0 | v1) | (v2 | v3)) & high) == (uint64) 0) {
                Cajeta.storeU64(out, (int64) k, (int64) String.swarUpper(v0));
                Cajeta.storeU64(out, (int64) (k + 8), (int64) String.swarUpper(v1));
                Cajeta.storeU64(out, (int64) (k + 16), (int64) String.swarUpper(v2));
                Cajeta.storeU64(out, (int64) (k + 24), (int64) String.swarUpper(v3));
            } else {
                int32 j = 0;
                while (j < 32) {
                    int32 b = ((int32) src[so + k + j]) & 0xff;
                    out[k + j] = (b >= 0x61 && b <= 0x7A) ? (int8) (b - 32) : src[so + k + j];
                    j = j + 1;
                }
            }
            k = k + 32;
        }
        while (k + 8 <= n) {
            uint64 v = (uint64) Cajeta.loadU64(src, (int64) (so + k));
            if ((v & high) == (uint64) 0) {
                Cajeta.storeU64(out, (int64) k, (int64) String.swarUpper(v));
            } else {
                int32 j = 0;
                while (j < 8) {
                    int32 b = ((int32) src[so + k + j]) & 0xff;
                    out[k + j] = (b >= 0x61 && b <= 0x7A) ? (int8) (b - 32) : src[so + k + j];
                    j = j + 1;
                }
            }
            k = k + 8;
        }
        while (k < n) {
            int32 b = ((int32) src[so + k]) & 0xff;
            out[k] = (b >= 0x61 && b <= 0x7A) ? (int8) (b - 32) : src[so + k];
            k = k + 1;
        }
        return heap String(#out, n);
    }

    /**
     * Returns a new String with all ASCII uppercase letters mapped
     * to lowercase. Non-ASCII bytes pass through unchanged. Same
     * deferred Unicode-folding caveat as toUpperCase.
     */
    public #String toLowerCase() {
        int32 n = this.byteLength;
        int8[] out = Cajeta.allocBytes((int64) n);   // every byte written below
        int8[] src = this.bytes;
        int32 so = 0;
        if (this.mode == 2) { so = (int32) this.ssoCount; }
        uint64 high = (uint64) 0x8080808080808080;
        int32 k = 0;
        // 32 bytes/iter (4 words, one ASCII guard); sets bit 5 ([A-Z]->[a-z]).
        while (k + 32 <= n) {
            uint64 v0 = (uint64) Cajeta.loadU64(src, (int64) (so + k));
            uint64 v1 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 8));
            uint64 v2 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 16));
            uint64 v3 = (uint64) Cajeta.loadU64(src, (int64) (so + k + 24));
            if ((((v0 | v1) | (v2 | v3)) & high) == (uint64) 0) {
                Cajeta.storeU64(out, (int64) k, (int64) String.swarLower(v0));
                Cajeta.storeU64(out, (int64) (k + 8), (int64) String.swarLower(v1));
                Cajeta.storeU64(out, (int64) (k + 16), (int64) String.swarLower(v2));
                Cajeta.storeU64(out, (int64) (k + 24), (int64) String.swarLower(v3));
            } else {
                int32 j = 0;
                while (j < 32) {
                    int32 b = ((int32) src[so + k + j]) & 0xff;
                    out[k + j] = (b >= 0x41 && b <= 0x5A) ? (int8) (b + 32) : src[so + k + j];
                    j = j + 1;
                }
            }
            k = k + 32;
        }
        while (k + 8 <= n) {
            uint64 v = (uint64) Cajeta.loadU64(src, (int64) (so + k));
            if ((v & high) == (uint64) 0) {
                Cajeta.storeU64(out, (int64) k, (int64) String.swarLower(v));
            } else {
                int32 j = 0;
                while (j < 8) {
                    int32 b = ((int32) src[so + k + j]) & 0xff;
                    out[k + j] = (b >= 0x41 && b <= 0x5A) ? (int8) (b + 32) : src[so + k + j];
                    j = j + 1;
                }
            }
            k = k + 8;
        }
        while (k < n) {
            int32 b = ((int32) src[so + k]) & 0xff;
            out[k] = (b >= 0x41 && b <= 0x5A) ? (int8) (b + 32) : src[so + k];
            k = k + 1;
        }
        return heap String(#out, n);
    }

    /**
     * Strips leading and trailing ASCII whitespace (byte values 0
     * through 0x20 inclusive) and returns the resulting view. v1
     * matches Java's `String.trim()` semantics — full Unicode
     * whitespace (codepoints in Z*, plus 0085/2028/2029, etc.) is
     * the planned `strip()` companion once Locale lands.
     */
    public #String trim() {
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 start = 0;
        int32 end = this.byteLength;
        while (start < end && (((int32) this.bytes[o + start]) & 0xff) <= 0x20) {
            start = start + 1;
        }
        while (end > start && (((int32) this.bytes[o + end - 1]) & 0xff) <= 0x20) {
            end = end - 1;
        }
        // Zero-copy: the trimmed run is a window of this String (slice-spec §7.1).
        return Cajeta.stringSlice(this, start, end - start);
    }

    /** INTERNAL (slices plan 4.2.2): borrow-mode trim — see substringView. */
    public #String trimView() {
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 start = 0;
        int32 end = this.byteLength;
        while (start < end && (((int32) this.bytes[o + start]) & 0xff) <= 0x20) {
            start = start + 1;
        }
        while (end > start && (((int32) this.bytes[o + end - 1]) & 0xff) <= 0x20) {
            end = end - 1;
        }
        return Cajeta.stringSliceBorrow(this, start, end - start);
    }

    /**
     * Returns a new String with every non-overlapping occurrence of
     * `from`'s bytes replaced by `to`'s bytes. Two-pass naive
     * implementation: first pass counts occurrences and sizes the
     * output buffer; second pass walks bytes copying through.
     * Empty or null `from` returns this String unchanged.
     */
    public #String replace(String from, String repl) {
        if (from == null || repl == null) {
            return this;
        }
        int32 flen = from.byteLength;
        if (flen == 0) {
            return this;
        }
        int64 tlen = (int64) repl.byteLength;
        int64 hlen = (int64) this.byteLength;
        int64 flen64 = (int64) flen;
        // Pass 1: count occurrences with the fast SWAR indexOfFrom (no copying)
        // to size the output EXACTLY — one allocation, no growth churn, no final
        // copy, and no over-allocation slack in the returned String. (A
        // StringBuilder is slower here: replace is copy-bound, and its growth +
        // toString copy cost more than this second SWAR scan, which is cheap.)
        int64 count = 0;
        int64 p = this.indexOfFrom(from, 0);
        while (p >= (int64) 0) {
            count = count + 1;
            p = this.indexOfFrom(from, p + flen64);
        }
        if (count == 0) {
            return this;        // no match — hand back the receiver unchanged
        }
        int64 outLen = hlen + count * (tlen - flen64);
        int8[] out = Cajeta.allocBytes(outLen);   // every byte written below
        // Pass 2: walk matches with the SWAR indexOfFrom, bulk-copying each
        // segment + replacement into the exact buffer (8-byte stores via the
        // @Inline copyRange). (A hand-inlined continuous SWAR scan here measured
        // SLOWER — its jump-and-reload control flow optimizes worse than this
        // simple walk — so the per-match indexOfFrom call is kept.)
        int64 ho = 0;
        if (this.mode == 2) { ho = this.ssoCount; }
        int64 ro = 0;
        if (repl.mode == 2) { ro = repl.ssoCount; }
        int64 src = 0;
        int64 dst = 0;
        int64 at = this.indexOfFrom(from, 0);
        while (at >= (int64) 0) {
            int64 seg = at - src;
            String.copyRange(out, dst, this.bytes, ho + src, seg);
            dst = dst + seg;
            String.copyRange(out, dst, repl.bytes, ro, tlen);
            dst = dst + tlen;
            src = at + flen64;
            at = this.indexOfFrom(from, src);
        }
        String.copyRange(out, dst, this.bytes, ho + src, hlen - src);
        return heap String(#out, (int32) outLen);
    }

    // Copy `len` bytes from `src[s..]` to `dst[d..]`, 8 bytes per store (the
    // 8-byte chunk window never exceeds `len`, so neither buffer is overrun) with
    // a scalar tail. Static — takes both arrays explicitly.
    @Inline
    private static void copyRange(int8[] dst, int64 d, int8[] src, int64 s, int64 len) {
        int64 k = 0;
        while (k + 8 <= len) {
            Cajeta.storeU64(dst, d + k, Cajeta.loadU64(src, s + k));
            k = k + 8;
        }
        while (k < len) {
            dst[d + k] = src[s + k];
            k = k + 1;
        }
    }

    /**
     * Raw byte at the given byte index. Byte-indexed (not codepoint-
     * indexed) — for the codepoint variant use codepointAt. Out-of-
     * range index is the caller's responsibility; v1 doesn't bounds-
     * check (matches the int8[] array-access convention with
     * --bounds=off).
     */
    @Inline
    public int8 byteAt(int32 index) {
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        return this.bytes[o + index];
    }

    /**
     * Byte offset of this String's window within its root buffer — 0
     * for owned/static/SSO strings, the window offset for mode-2 views.
     * With `bytes` + `byteLength` this is the zero-copy window contract
     * for consumers that pass the raw buffer to natives: when it is 0
     * (and the callee takes an explicit length) the raw fast path is
     * window-exact; otherwise materialize via `toBytes()`.
     */
    @Inline
    public int64 byteOffset() {
        if (this.mode == 2) {
            return this.ssoCount;
        }
        return (int64) 0;
    }

    /**
     * The effective byte window as a fresh caller-owned array — the
     * view-safe replacement for reading `.bytes` raw (a windowed view's
     * `bytes` points at the ROOT buffer; the window offset would be
     * silently ignored). Copies `byteLength` bytes.
     */
    public #int8[] toBytes() {
        int32 n = this.byteLength;
        int8[] out = heap int8[n];
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 i = 0;
        while (i < n) {
            out[i] = this.bytes[o + i];
            i = i + 1;
        }
        return #out;
    }

    /**
     * Unicode codepoint at the given codepoint index. O(N) walk —
     * the UTF-8 layout doesn't permit O(1) codepoint indexing.
     * Callers who need to iterate codepoints should use a single
     * pass rather than repeated codepointAt calls.
     *
     * Returns the decoded codepoint as a 32-bit int (Cajeta `char`).
     * Malformed UTF-8 in the byte stream is decoded best-effort:
     * stray continuation bytes are skipped without advancing the
     * codepoint count, and a leader byte missing its full
     * complement of continuation bytes produces a value derived
     * from whatever bytes ARE present.
     */
    public char codepointAt(int32 cpIdx) {
        int32 o = 0;
        if (this.mode == 2) { o = (int32) this.ssoCount; }
        int32 i = 0;       // byte cursor
        int32 cp = 0;      // current codepoint index
        while (i < this.byteLength) {
            int32 b0 = ((int32) this.bytes[o + i]) & 0xff;
            int32 width = 1;
            int32 decoded = 0;
            if ((b0 & 0x80) == 0) {
                // 1-byte ASCII.
                decoded = b0;
                width = 1;
            } else if ((b0 & 0xE0) == 0xC0) {
                // 2-byte (110xxxxx 10xxxxxx).
                int32 b1 = (i + 1 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 1]) & 0xff) : 0;
                decoded = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                width = 2;
            } else if ((b0 & 0xF0) == 0xE0) {
                // 3-byte.
                int32 b1 = (i + 1 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 1]) & 0xff) : 0;
                int32 b2 = (i + 2 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 2]) & 0xff) : 0;
                decoded = ((b0 & 0x0F) << 12)
                        | ((b1 & 0x3F) << 6)
                        |  (b2 & 0x3F);
                width = 3;
            } else if ((b0 & 0xF8) == 0xF0) {
                // 4-byte.
                int32 b1 = (i + 1 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 1]) & 0xff) : 0;
                int32 b2 = (i + 2 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 2]) & 0xff) : 0;
                int32 b3 = (i + 3 < this.byteLength)
                    ? (((int32) this.bytes[o + i + 3]) & 0xff) : 0;
                decoded = ((b0 & 0x07) << 18)
                        | ((b1 & 0x3F) << 12)
                        | ((b2 & 0x3F) << 6)
                        |  (b3 & 0x3F);
                width = 4;
            } else {
                // Stray continuation or invalid leader — skip without
                // counting.
                i = i + 1;
                continue;
            }
            if (cp == cpIdx) {
                return (char) decoded;
            }
            cp = cp + 1;
            i = i + width;
        }
        // cpIdx out of range — v1 doesn't bounds-check; return 0 as a
        // best-effort placeholder rather than throw.
        return (char) 0;
    }
}
