package cajeta.lang;

/**
 * Boxed `uint16` (16-bit unsigned). Immutable, heap-allocatable,
 * reflection-introspectable; value equality via the `hash()` override
 * (zero-extended). Boxed value is field index 0. See
 * `plans/lang/wrapper-types-plan.md` (W2).
 */
public class UInt16 extends Number {
    uint16 value;

    public UInt16(uint16 value) { this.value = value; return; }

    /** Heap box — the boxing entry point (Java-style `valueOf`). */
    public static #UInt16 of(uint16 value) { return heap UInt16(value); }

    /** The wrapped primitive. */
    public uint16 value() { return this.value; }

    public int64   asInt64()   { return (int64) this.value; }
    public float64 asFloat64() { return (float64) this.value; }

    /** Value-based hash → equal values compare equal via Object.operator==. */
    public int64 hash() { return (int64) this.value; }

    public #String toString() { return this.formatUnsigned((uint64) this.value); }
}
