package cajeta.lang;

/**
 * Two-field generic value type. The foundation for stdlib APIs that
 * pair two values together — `HashMap`.entries() returning a
 * `Stream` of `Pair<K,V>`, key/value tuples in maps, source/target
 * pairs in graphs, etc.
 *
 * Lives in `cajeta.lang` (not `cajeta.util`) because it's used across
 * many stdlib types, not specifically a collection concern.
 *
 * ## Storage
 *
 * Same semantics as any other class in the unified-class model
 * (docs/specification/lang/UnifiedClasses.md). Use
 * `stack Pair<K, V>(...)` for a stack instance (lifetime tied to the
 * enclosing scope; no heap traffic) or `heap Pair<K, V>(...)` when the
 * pair needs to escape.
 *
 * ## A pair OWNS its components
 *
 * The constructor's formals are `#K` / `#V`, so construction is a
 * must-own edge (docs/specification/lang/OwnershipTransfer.md). An
 * already-owned local has to be surrendered with `#` at the call site;
 * passing it plain is `CAJETA_ERROR_TRANSFER_REQUIRED`. A fresh rvalue
 * — a literal, or a `heap T(...)` / `stack T(...)` written inline — is
 * an unowned temporary and passes plain.
 *
 * ```cajeta
 * Pair<String, int32> lit = heap Pair<String, int32>("k", 1);
 * Pair<Box, Box> fresh = heap Pair<Box, Box>(heap Box(3), heap Box(4));
 *
 * Box a = heap Box(3);
 * Box b = heap Box(4);
 * Pair<Box, Box> bad  = heap Pair<Box, Box>(a, b);    // TRANSFER_REQUIRED
 * Pair<Box, Box> good = heap Pair<Box, Box>(#a, #b);  // transfers
 * ```
 *
 * ## Fields are immutable from the API perspective
 *
 * v1 exposes only `first()` and `second()` getters. Mutating the
 * fields after construction isn't supported by the surface; if you
 * need a different pair, construct a new one.
 */
public final class Pair<K, V> {
    K first;
    V second;

    /**
     * Builds a pair from its two components.
     *
     * ```cajeta
     * String name = "ada";
     * int32  age  = 36;
     * Pair<String, int32> p = stack Pair<String, int32>(#name, age);
     * String who = p.first();
     * int32  yrs = p.second();
     * ```
     *
     * @EntryPoint
     */
    public Pair(#K first, #V second) {
        // uniform-transfer 2.3 — a pair OWNS its two components, so the
        // formals are `#` and the stores are unconditional transfers.
        this.first #= first;
        this.second #= second;
    }

    /** Borrowing reads — the pair keeps its components. */
    @Inline
    public K first()  { return this.first; }
    @Inline
    public V second() { return this.second; }

    /**
     * Extracting reads — the component's title moves to the caller and the
     * pair's slot decays to borrowed. Needed wherever a pair is DECOMPOSED
     * into an owning container (`HashMap(#Pair<K,V>[])`): the borrowing
     * `first()`/`second()` cannot feed a `#K`/`#V` formal.
     */
    @Inline
    public #K takeFirst()  { K out #= this.first;  return #out; }
    @Inline
    public #V takeSecond() { V out #= this.second; return #out; }
}
