package cajeta.lang;

import cajeta.lang.String;

/**
 * `Utf8` — a 16-byte value-type text field (slice-spec §8; slices plan Unit 6a).
 * The Inline form of the tagged design: up to 12 bytes of UTF-8 stored directly
 * in the value — no heap buffer, no refcount, trivially memcpy-able — which is
 * exactly what makes it legal as a `record`/`@ValueType` field (records reject
 * heap-class fields like `String`). Covers the dominant schema-text case:
 * symbols, venue codes, currencies, categories.
 *
 * v1 (6a) is Inline-only: {@link #of} clamps at 12 bytes (documented; the
 * Static/Shared forms of the full tagged design lift the cap). Equality and
 * hashing are over the window bytes — representation-independent among `Utf8`
 * values; XXH parity with `String.hash` arrives with the Shared form.
 */
@ValueType
public final class Utf8 {
    int32 len;
    int8[12] data;

    /**
     * Build from up to the first 12 bytes of `s` (byte-indexed; clamps longer
     * input — the Inline cap). Reads through `charAt`, so windowed (mode-2)
     * source Strings contribute their window bytes.
     */
    public static Utf8 of(String s) {
        Utf8 u = stack Utf8();
        int32 n = 0;
        if (s != null) {
            n = (int32) s.size();
        }
        if (n > 12) {
            n = 12;
        }
        u.len = n;
        int32 i = 0;
        while (i < n) {
            u.data[i] = s.charAt(i);
            i = i + 1;
        }
        while (i < 12) {
            u.data[i] = (int8) 0;
            i = i + 1;
        }
        return u;
    }

    /** Byte length of the text (0..12). */
    public int64 size() {
        return (int64) this.len;
    }

    /** True when zero bytes. */
    public boolean isEmpty() {
        return this.len == 0;
    }

    /** Raw byte at `idx`; 0 out of range (the `charAt` convention). */
    public int8 charAt(int32 idx) {
        if (idx < 0 || idx >= this.len) {
            return (int8) 0;
        }
        return this.data[idx];
    }

    /** Byte-for-byte equality over the window (representation-independent). */
    public boolean equals(Utf8 other) {
        if (this.len != other.len) {
            return false;
        }
        int32 i = 0;
        while (i < this.len) {
            if (this.data[i] != other.data[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /** Byte-for-byte equality against a String's window. */
    public boolean equalsString(String s) {
        if (s == null) {
            return this.len == 0;
        }
        if ((int64) this.len != s.size()) {
            return false;
        }
        int32 i = 0;
        while (i < this.len) {
            if (this.data[i] != s.charAt(i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /** FNV-1a over the window bytes — equal texts hash equal regardless of
     *  source. uint64 arithmetic: FNV wraps by design (unchecked). */
    public int64 hash() {
        uint64 h = (uint64) 1469598103934665603;
        uint64 prime = (uint64) 1099511628211;
        int32 i = 0;
        while (i < this.len) {
            uint64 b = (uint64) (((int32) this.data[i]) & 0xff);
            h = h ^ b;
            h = h * prime;
            i = i + 1;
        }
        return (int64) h;
    }

    /** Materialize as an owned `String`. */
    public #String toString() {
        int32 n = this.len;
        int8[] out = Cajeta.allocBytes((int64) n);
        int32 i = 0;
        while (i < n) {
            out[i] = this.data[i];
            i = i + 1;
        }
        return heap String(#out, n);
    }
}
