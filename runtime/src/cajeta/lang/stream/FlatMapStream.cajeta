package cajeta.lang.stream;

/**
 * Intermediate combinator: wraps a Stream<T> and applies
 * `fn: (T) -> Stream<R>` to each element, then flattens by draining
 * each returned inner stream before pulling the next outer element.
 * Yields Stream<R>.
 *
 * State between pulls: the inner stream `current` is retained across
 * calls to next() until exhausted, then a new outer element triggers
 * fn() to produce the next inner stream. `current.isEmpty()` is the
 * initial-state marker — null Optional<...> can't be expressed with a
 * non-templated reference type.
 *
 * Lazy: fn invoked per outer pull, inner stream pulled on demand.
 * Outer empty → fmt empty. Inner stream returns empty → loop pulls
 * next outer until something yields or outer exhausts.
 *
 * Reached through `flatMap` on any `Stream`, not constructed
 * directly. Each yielded element arrives as an `Optional`.
 *
 * ## Usage
 * ```cajeta
 * // Flatten an array-of-rows into a single stream of ints:
 * int32[][] rows = { { 1, 2 }, { }, { 3 } };
 * #Stream<int32[]> outer = heap ArrayStream<int32[]>(rows, 3);
 *
 * #Stream<int32> flat = outer.flatMap<int32>(
 *     (int32[] row) -> heap ArrayStream<int32>(row, row.length));
 *
 * // empty inner rows are skipped transparently → 1, 2, 3
 * flat.forEach((int32 x) -> println(x));
 * ```
 *
 * Sibling combinator `MapStream` is the 1:1 version (one element in,
 * one out); `FlatMapStream` is 1:N (one element in, a whole inner
 * `Stream` out).
 */
public class FlatMapStream<T, R> extends Stream<R> {
    Stream<T> source;
    (T) -> #Stream<R> fn;
    Stream<R> current;
    boolean primed;

    /**
     * Wraps `source` and the per-element expander `fn`. Prefer the
     * `flatMap` factory on `Stream` over calling this directly.
     *
     * ```cajeta
     * #Stream<int32[]> outer = heap ArrayStream<int32[]>(rows, 3);
     * #Stream<int32> flat = heap FlatMapStream<int32[], int32>(
     *     outer, (int32[] row) -> heap ArrayStream<int32>(row, row.length));
     * ```
     */
    public FlatMapStream(#Stream<T> source, (T) -> #Stream<R> fn) {
        this.source = source;
        this.fn = fn;
        this.primed = false;
    }

    /**
     * Pull the next flattened element: drains the live inner stream
     * first, and only when it empties pulls the next outer element to
     * build a fresh inner via `fn`. Empty inner streams are skipped;
     * returns an empty `Optional` once the outer source exhausts.
     */
    public Optional<R> next() {
        while (true) {
            if (this.primed) {
                Optional<R> r = this.current.next();
                if (r.isPresent()) {
                    return r;
                }
                this.primed = false;
            }
            Optional<T> o = this.source.next();
            if (o.isEmpty()) {
                return stack Optional<R>(false, null);
            }
            this.current = this.fn(o.get());
            this.primed = true;
        }
        return stack Optional<R>(false, null);
    }

    /**
     * Type-changing wrapper unwind — see MapStream.unwrap for the
     * pattern. Exposes `Stream<T>` source as `Stream<?>`. The wrapper
     * is NOT marked stateful here, but FlatMap fan-out makes the
     * per-share rebuild non-trivial; the driver currently doesn't
     * split a chain whose root is hidden behind a FlatMap (root
     * walking stops at this FlatMap, splittableSize returns -1L,
     * fallback is sequential). The override is still useful for
     * `.flatMap().filter().parallel()`-style chains where this
     * FlatMap is not the closest-to-root.
     */
    public Stream<?> unwrap() {
        return this.source;
    }

    /**
     * Type-changing wrapper rebuild. Re-wraps a freshly-split inner
     * share with this stream's `fn` so each worker sees the
     * flatMap-over-share chain (see `MapStream``.cloneChainOver`).
     */
    public #Stream<R> cloneChainOver(#Stream<?> newRoot) {
        return heap FlatMapStream<T, R>(this.source.cloneChainOver(#newRoot), this.fn);
    }
}
