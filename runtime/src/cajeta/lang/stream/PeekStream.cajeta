package cajeta.lang.stream;

/**
 * Intermediate combinator: wraps another `Stream` and invokes `fn` as a
 * side effect on each element pulled, then passes the element through
 * unchanged. Useful for observing or debugging a pipeline without altering
 * the values that flow through it.
 *
 * You rarely name `PeekStream` directly; it is produced by
 * ``Stream`.peek(fn)` and consumed through the usual `Stream` protocol,
 * with each `next()` returning an `Optional`.
 *
 * ```cajeta
 * // log every element on the way past, then count them
 * long n = source.peek((int v) -> printValue(v)).count();
 * ```
 *
 * Lazy: `fn` is called once per pull, not eagerly over the whole source.
 * An empty stream propagates without invoking `fn`.
 */
public final class PeekStream<T> extends Stream<T> {
    Stream<T> source;
    (T) -> void fn;

    /**
     * Takes ownership of `source` and retains `fn`. Prefer the
     * ``Stream`.peek(fn)` factory over calling this directly.
     *
     * ```cajeta
     * #Stream<string> traced =
     *     heap PeekStream<string>(#source, (string s) -> printValue(s));
     * ```
     */
    public PeekStream(#Stream<T> source, (T) -> void fn) {
        this.source = #source;
        this.fn = fn;
    }

    /**
     * Pulls the next element from the source; when present, invokes `fn` on
     * it before returning it unchanged in the same `Optional`. An empty
     * `Optional` (exhausted source) is forwarded without calling `fn`.
     */
    public Optional<T> next() {
        Optional<T> o = this.source.next();
        if (o.isPresent()) {
            this.fn(o.get());
        }
        return o;
    }

    @Inline
    public Stream<?> unwrap() {
        return this.source;
    }

    /**
     * Recursive chain re-wrap: rebuild source-chain over newRoot,
     * then wrap the result in a fresh PeekStream<T>(_, fn).
     */
    public #Stream<T> cloneChainOver(#Stream<?> newRoot) {
        return heap PeekStream<T>(this.source.cloneChainOver(#newRoot), this.fn);
    }
}
