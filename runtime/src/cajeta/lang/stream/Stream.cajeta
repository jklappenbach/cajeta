package cajeta.lang.stream;

import cajeta.collection.Collector;

/**
 * The pull-protocol base for everything iteration-related in the
 * stdlib (stdlib/Streams.md § Stream). Implementers override `next()`
 * to yield elements; combinator methods on Stream itself consume
 * `next()` and inherit to every subclass.
 *
 * ## v1 minimal surface
 *
 * Just the pull primitive plus `count()` and `forEach((T) -> void)`
 * terminals. The intermediate-combinator wrappers (MapStream,
 * FilterStream, TakeStream, ...) and the rest of the terminal set
 * (fold, reduce, anyMatch, ..., collect) land in P6.5+.
 *
 * ## "Abstract" via empty-default convention
 *
 * Cajeta doesn't have abstract-method enforcement at vtable build
 * today, so Stream's `next()` lands as a concrete method returning
 * `None` by default. Implementers override; the default is never
 * meaningfully invoked because user code only calls `next()` on
 * subclasses. (Future work: real abstract-method support so
 * forgetting to override is a compile-time error.)
 *
 * ## Stream vs Optional integration
 *
 * Per stdlib/Streams.md, Optional<T> extends Stream<T> with single-
 * shot next(). That lands once method-override on generic stdlib
 * classes is verified end-to-end via ArrayStream below.
 */
public class Stream<T> {
    /**
     * Pull the next element. Implementers override; default returns
     * an empty Optional.
     */
    public Optional<T> next() {
        return heap Optional<T>(false, null);
    }

    /**
     * Count elements by walking next() to exhaustion. The simplest
     * terminal; no lambda needed.
     */
    public int32 count() {
        int32 n = 0;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            n = n + 1;
            o = this.next();
        }
        return n;
    }

    /**
     * Apply `fn` to every remaining element by walking next() to
     * exhaustion. P6.5 first lambda-taking terminal.
     */
    public void forEach((T) -> void fn) {
        Optional<T> o = this.next();
        while (o.isPresent()) {
            fn(o.get());
            o = this.next();
        }
    }

    /**
     * Returns true if any remaining element matches `pred`. Short-
     * circuits on the first match. Empty stream → false.
     */
    public boolean anyMatch((T) -> boolean pred) {
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return true;
            }
            o = this.next();
        }
        return false;
    }

    /**
     * Returns true iff every remaining element matches `pred`. Short-
     * circuits on the first non-match. Empty stream → true
     * (vacuously).
     */
    public boolean allMatch((T) -> boolean pred) {
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (!pred(o.get())) {
                return false;
            }
            o = this.next();
        }
        return true;
    }

    /**
     * Returns true iff no remaining element matches `pred`. Short-
     * circuits on the first match. Empty stream → true (vacuously).
     */
    public boolean noneMatch((T) -> boolean pred) {
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return false;
            }
            o = this.next();
        }
        return true;
    }

    /**
     * Returns the first remaining element matching `pred` wrapped in
     * a present Optional, or an empty Optional if none match.
     *
     * Pre-fix the body declared `T v = o.get();` and reused `v`
     * inside the loop; that registered a drop entry for `v` which,
     * for class-typed T, freed the element even though ownership
     * stays with the stream source. Calling `o.get()` twice (once
     * for the predicate, once for the construction) sidesteps the
     * borrow-via-local issue — neither result gets a drop entry
     * since both are immediate temporaries.
     */
    public Optional<T> findFirst((T) -> boolean pred) {
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return heap Optional<T>(true, o.get());
            }
            o = this.next();
        }
        return heap Optional<T>(false, null);
    }

    /**
     * Left-fold with an explicit seed. `acc = fn(acc, element)` for
     * each element in order; returns the final accumulator. The seed
     * and result share the element type T (Java's `reduce(T,
     * BinaryOperator<T>)` shape). One-liner wrapper over `fold<T>`.
     */
    public T reduce(T seed, (T, T) -> T fn) {
        return this.fold(seed, fn);
    }

    /**
     * Cross-type left-fold. `acc = fn(acc, element)` for each element
     * in order; returns the final R accumulator. R is method-level so
     * the seed type can differ from the element type — sum an
     * `int32` stream into an `int64`, count `Counter` instances into
     * an `int32`, build a `String` from a stream of any T, etc.
     *
     * Non-virtual by construction (method-level templates can't sit in
     * a vtable — see cajeta-docs/stdlib/MethodLevelTemplate.md). The
     * inherited `next()` is what subclasses customize; this combinator
     * stays the same body across every Stream<T> subclass.
     */
    public final <R> R fold(R seed, (R, T) -> R fn) {
        R acc = seed;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = this.next();
        }
        return acc;
    }

    /**
     * Reduce a stream via a Collector — packages the (seed,
     * accumulator) pair so the same Stream can feed any compatible
     * Collector. See `cajeta.collection.Collector` and
     * `cajeta.collection.Collectors` for the standard built-in
     * collectors (`toList`, etc.). The R type is method-level so the
     * result type is independent of T.
     */
    public final <R> R collect(Collector<T, R> c) {
        return this.fold(c.seed, c.accumulator);
    }
}
