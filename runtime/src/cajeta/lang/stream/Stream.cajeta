package cajeta.lang.stream;

import cajeta.collection.Collector;
import cajeta.error.Exception;

/**
 * The pull-protocol base for everything iteration-related in the
 * stdlib (stdlib/Streams.md § Stream). Implementers override `next()`
 * to yield elements; combinator methods on Stream itself consume
 * `next()` and inherit to every subclass.
 *
 * ## v1 minimal surface
 *
 * Just the pull primitive plus `count()` and `forEach((T) -> void)`
 * terminals. The intermediate-combinator wrappers (MapStream,
 * FilterStream, TakeStream, ...) and the rest of the terminal set
 * (fold, reduce, anyMatch, ..., collect) land in P6.5+.
 *
 * ## "Abstract" via empty-default convention
 *
 * Cajeta doesn't have abstract-method enforcement at vtable build
 * today, so Stream's `next()` lands as a concrete method returning
 * `None` by default. Implementers override; the default is never
 * meaningfully invoked because user code only calls `next()` on
 * subclasses. (Future work: real abstract-method support so
 * forgetting to override is a compile-time error.)
 *
 * ## Stream vs Optional integration
 *
 * Per stdlib/Streams.md, Optional<T> extends Stream<T> with single-
 * shot next(). That lands once method-override on generic stdlib
 * classes is verified end-to-end via ArrayStream below.
 *
 * ## Usage
 *
 * A stream comes from a splittable root such as `ArrayStream`; chain
 * lazy intermediates and finish with an eager terminal:
 *
 * ```cajeta
 * Stream<int32> s = ArrayStream.from(nums);
 * int32 evens = s.filter((x) -> x % 2 == 0).count();
 *
 * // cross-type fold into a wider accumulator
 * int64 sum = ArrayStream.from(nums)
 *     .fold<int64>(0L, (acc, e) -> acc + e);
 *
 * // opt into the parallel path; a combiner merges per-worker partials
 * int64 par = ArrayStream.from(nums).parallel()
 *     .fold<int64>(0L, (acc, e) -> acc + e, (a, b) -> a + b);
 * ```
 *
 * Element lookups (`findFirst`) return an `Optional`; reductions can
 * be packaged with a `Collector` (see `Collectors` for the
 * built-ins like `toList`).
 */
public class Stream<T> {
    /**
     * Parallel-eligibility flag. Set by `.parallel()`; cleared by
     * `.sequential()`. Terminals consult it to decide whether to
     * fork. The bit propagates through wrapper combinators (filter,
     * map, etc.) via their ctors (each wrapper copies its source's
     * flag at construction). See docs/stdlib/StreamParallelism.md.
     */
    boolean isParallel = false;

    /**
     * Pull the next element. Implementers override; default returns
     * an empty Optional.
     */
    public Optional<T> next() {
        return stack Optional<T>(false, null);
    }

    /**
     * Wrapper-chain unwind protocol. Wrappers (FilterStream,
     * PeekStream, TakeStream, SkipStream) override `unwrap()` to
     * return their source. Splittable roots (ArrayStream,
     * HashMap*Stream) leave it null — null signals "I am the chain
     * root."
     *
     * The driver walks unwrap() to compute `depth` and locate the
     * root, then forks per share via `cloneChainOver` (which
     * rebuilds the chain over the share).
     */
    public Stream<?> unwrap() {
        return null;
    }

    /**
     * Stateful intermediate marker. `take(n)` and `skip(n)` depend on
     * global encounter order, which doesn't survive splitting. The
     * driver throws CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL when
     * it sees a stateful wrapper in the chain.
     */
    public boolean isStatefulWrapper() {
        return false;
    }

    /**
     * Recursive chain re-wrap. Splittable roots return `newRoot`
     * unchanged. Wrappers (FilterStream, PeekStream) override to
     * recurse: rebuild the chain bottom-up by passing the new root
     * down through this.source.cloneChainOver, then wrap the result
     * in a fresh copy of self. Drives the per-worker share-rebuild
     * in ParallelDriver.reduceParallelChain.
     */
    public #Stream<T> cloneChainOver(#Stream<?> newRoot) {
        // Splittable-root default: hand back the share as-is. The cast
        // is safe because cloneChainOver is only called by the
        // chain-walker with a `piece` produced from THIS class's own
        // trySplitRoot (a Splittable root of element type T) — so the
        // runtime type of newRoot really is Stream<T>. (Step 5b —
        // template wildcards; see ParallelDriver chain walk.)
        return (Stream<T>) newRoot;
    }

    /**
     * Splittable-shape bridge. Splittable implementers (ArrayStream,
     * HashMap*Stream) override these two methods to delegate to
     * their Splittable.trySplit / estimateSize; non-Splittable
     * streams keep the defaults (-1L and null).
     *
     * Stand-in for `head instanceof Splittable<T>` until Cajeta RTTI
     * grows that surface (see RttiSmokeTests.cpp). Returning a
     * Splittable<T> directly hits the unfinished class→interface
     * upcast-on-return path (Hasher.cajeta § "v1 limitation: void
     * write returns"), so the driver-facing surface is two
     * primitive-typed virtuals instead.
     */
    public int64 splittableSize() {
        return -1L;
    }

    public #Stream<?> trySplitRoot() {
        return null;
    }

    /**
     * Mark this stream as parallel-eligible. Returns the same stream
     * — no wrapper allocation. Terminals branch on the flag; if the
     * source can't split or the size is below threshold, the
     * terminal falls back to sequential transparently.
     */
    public Stream<T> parallel() {
        this.isParallel = true;
        return this;
    }

    /**
     * Clear the parallel-eligibility flag. Used as the escape hatch
     * for stateful intermediate ops (`take`/`skip`) which require
     * ordered traversal. Returns this.
     */
    public Stream<T> sequential() {
        this.isParallel = false;
        return this;
    }

    /**
     * Count elements by walking next() to exhaustion. The simplest
     * terminal; no lambda needed.
     *
     * ```cajeta
     * int32 n = s.count();
     * ```
     */
    public int32 count() {
        int32 n = 0;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            n = n + 1;
            o = this.next();
        }
        return n;
    }

    /**
     * Apply `fn` to every remaining element by walking next() to
     * exhaustion. Under `.parallel()` dispatches to
     * `ParallelDriver.forEachParallelChain` — each worker drains its
     * own share. Order across workers is unspecified per
     * StreamParallelism.md § Per-terminal rules; `fn` must be
     * commutative and thread-safe.
     *
     * ```cajeta
     * s.forEach((x) -> print(x));
     * ```
     */
    public void forEach((T) -> void fn) {
        if (this.isParallel) {
            ParallelDriver.forEachParallelChain<T>(this, fn);
            return;
        }
        Optional<T> o = this.next();
        while (o.isPresent()) {
            fn(o.get());
            o = this.next();
        }
    }

    /**
     * Returns true if any remaining element matches `pred`. Short-
     * circuits on the first match. Empty stream → false. Under
     * `.parallel()` dispatches to
     * `ParallelDriver.anyMatchParallelChain`; the first worker to
     * find a match flips a shared cancel flag and siblings bail at
     * their next pull-loop checkpoint.
     *
     * ```cajeta
     * boolean hasNeg = s.anyMatch((x) -> x < 0);
     * ```
     */
    public boolean anyMatch((T) -> boolean pred) {
        if (this.isParallel) {
            return ParallelDriver.anyMatchParallelChain<T>(this, pred);
        }
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return true;
            }
            o = this.next();
        }
        return false;
    }

    /**
     * Returns true iff every remaining element matches `pred`.
     * Short-circuits on the first non-match. Empty stream → true
     * (vacuously). Parallel path symmetric with `anyMatch`, using
     * a shared `fail` flag.
     */
    public boolean allMatch((T) -> boolean pred) {
        if (this.isParallel) {
            return ParallelDriver.allMatchParallelChain<T>(this, pred);
        }
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (!pred(o.get())) {
                return false;
            }
            o = this.next();
        }
        return true;
    }

    /**
     * Returns true iff no remaining element matches `pred`. Short-
     * circuits on the first match. Empty stream → true (vacuously).
     * Parallel path symmetric with `anyMatch`.
     */
    public boolean noneMatch((T) -> boolean pred) {
        if (this.isParallel) {
            return ParallelDriver.noneMatchParallelChain<T>(this, pred);
        }
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return false;
            }
            o = this.next();
        }
        return true;
    }

    /**
     * Returns the first remaining element matching `pred` wrapped in
     * a present Optional, or an empty Optional if none match. Under
     * `.parallel()` semantics shift to findAny — per § R1 in
     * StreamParallelism.md, encounter order isn't preserved across
     * split workers, so "first" becomes "any". Dispatches to
     * `ParallelDriver.findAnyParallelChain<T>` which walks the
     * wrapper chain, rejects stateful intermediates, and forks via
     * `scope { spawn findAnyWorker<T> }`.
     *
     * Pre-fix the body declared `T v = o.get();` and reused `v`
     * inside the loop; that registered a drop entry for `v` which,
     * for class-typed T, freed the element even though ownership
     * stays with the stream source. Calling `o.get()` twice (once
     * for the predicate, once for the construction) sidesteps the
     * borrow-via-local issue — neither result gets a drop entry
     * since both are immediate temporaries.
     *
     * ```cajeta
     * Optional<int32> hit = s.findFirst((x) -> x > 10);
     * if (hit.isPresent()) { use(hit.get()); }
     * ```
     */
    public Optional<T> findFirst((T) -> boolean pred) {
        if (this.isParallel) {
            return ParallelDriver.findAnyParallelChain<T>(this, pred);
        }
        Optional<T> o = this.next();
        while (o.isPresent()) {
            if (pred(o.get())) {
                return stack Optional<T>(true, o.get());
            }
            o = this.next();
        }
        return stack Optional<T>(false, null);
    }

    /**
     * Left-fold with an explicit seed. `acc = fn(acc, element)` for
     * each element in order; returns the final accumulator. The seed
     * and result share the element type T (Java's `reduce(T,
     * BinaryOperator<T>)` shape). One-liner wrapper over `fold<T>`.
     *
     * Under `.parallel()` this dispatches to
     * `ParallelDriver.reduceParallelChain` which walks the wrapper
     * chain to find a Splittable root, rebuilds the chain over each
     * split share via `head.cloneChainOver(piece)`, and forks
     * workers via `scope { spawn reduceWorker<T> }`. Falls back to
     * sequential `fold` when the root isn't Splittable or the
     * source is too small. Per Java's contract, `fn` must be
     * associative and `seed` its identity for the parallel path to
     * give the same answer as the sequential one.
     *
     * ```cajeta
     * int32 total = s.reduce(0, (a, b) -> a + b);
     * ```
     */
    public T reduce(T seed, (T, T) -> #T fn) {
        if (this.isParallel) {
            return ParallelDriver.reduceParallelChain<T>(this, seed, fn);
        }
        return this.fold(seed, fn);
    }

    /**
     * Cross-type left-fold. `acc = fn(acc, element)` for each element
     * in order; returns the final R accumulator. R is method-level so
     * the seed type can differ from the element type — sum an
     * `int32` stream into an `int64`, count `Counter` instances into
     * an `int32`, build a `String` from a stream of any T, etc.
     *
     * Non-virtual by construction (method-level templates can't sit in
     * a vtable — see docs/stdlib/MethodLevelTemplate.md). The
     * inherited `next()` is what subclasses customize; this combinator
     * stays the same body across every Stream<T> subclass.
     *
     * ```cajeta
     * int64 sum = s.fold<int64>(0L, (acc, e) -> acc + e);
     * ```
     */
    public final R fold<R>(R seed, (R, T) -> #R fn) {
        if (this.isParallel) {
            throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_FOLD_NO_COMBINER: 2-arg fold(seed, fn) cannot be applied to a parallel stream because there is no way to merge per-worker partials; use the 3-arg fold(seed, fn, combiner) overload, or call .sequential() first");
        }
        R acc = seed;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = this.next();
        }
        return acc;
    }

    /**
     * Cross-type left-fold with explicit `combiner` for the parallel
     * path. Same per-element accumulation as the 2-arg `fold<R>`, but
     * adds the `(R, R) -> #R combiner` that the parallel driver uses
     * to merge per-worker partials at join time (Java's
     * `reduce(seed, accumulator, combiner)` shape).
     *
     * Under `.parallel()` dispatches to
     * `ParallelDriver.foldParallelChain<T, R>` which walks the chain,
     * rejects stateful intermediates, rebuilds each share via
     * `head.cloneChainOver(piece)`, and forks workers via
     * `scope { spawn foldWorker<T, R> }`. Falls back to sequential
     * when the root isn't Splittable or the source is too small.
     *
     * Contract (per Java + StreamParallelism.md § Per-terminal rules):
     *   - `combiner` MUST be associative.
     *   - `seed` MUST be the identity for both `fn` and `combiner`:
     *     `combiner(seed, fn(seed, t)) == fn(seed, t)` for every t.
     * Violating these gives a numerically-correct but
     * implementation-dependent answer.
     *
     * ```cajeta
     * int64 sum = s.parallel().fold<int64>(0L,
     *     (acc, e) -> acc + e,   // per-worker accumulate
     *     (a, b) -> a + b);      // merge partials at join
     * ```
     */
    public final R fold<R>(R seed, (R, T) -> #R fn, (R, R) -> #R combiner) {
        if (this.isParallel) {
            return ParallelDriver.foldParallelChain<T, R>(this, seed, fn, combiner);
        }
        R acc = seed;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = this.next();
        }
        return acc;
    }

    /**
     * Reduce a stream via a `Collector` — packages the (supplier,
     * accumulator, combiner) triple so the same Stream can feed any
     * compatible `Collector`. See `cajeta.collection.Collector` and
     * `Collectors` for the standard built-in collectors (`toList`,
     * etc.). The R type is method-level so the result type is
     * independent of T.
     *
     * ```cajeta
     * #List<int32> out = s.collect(Collectors.toList<int32>());
     * ```
     *
     * Under `.parallel()` each worker calls `c.supplier()` for its
     * own R partial (mutable R like ArrayList is safe — no aliasing
     * across workers) and the orchestrator merges via `c.combiner`.
     * Sequential collect calls `c.supplier()` once for the fold's
     * initial accumulator.
     */
    public final R collect<R>(Collector<T, R> c) {
        if (this.isParallel) {
            return ParallelDriver.collectParallelChain<T, R>(this, c.supplier, c.accumulator, c.combiner);
        }
        return this.fold(c.supplier(), c.accumulator);
    }

    /**
     * Lazy intermediate: keep only elements matching `pred`, dropping
     * the rest. No pull happens until a terminal runs.
     *
     * ```cajeta
     * #Stream<int32> evens = s.filter((x) -> x % 2 == 0);
     * ```
     */
    public #Stream<T> filter((T) -> boolean pred) {
        return heap FilterStream<T>(this, pred);
    }

    /**
     * Stateful intermediate: cap the stream at the first `n`
     * elements. Rejects on a parallel-flagged stream — ordered
     * "first N" can't be defined across split workers without
     * imposing an ordering barrier that defeats parallelism (per
     * StreamParallelism.md § Per-terminal rules). Call
     * `.sequential()` before `.take(n)` if a parallel pipeline
     * needs to bound its work.
     */
    public #Stream<T> take(int32 n) {
        if (this.isParallel) {
            throw heap Exception("take(n) cannot be applied to a parallel stream; call .sequential() first to clear the parallel flag");
        }
        return heap TakeStream<T>(this, n);
    }

    /**
     * Stateful intermediate: drop the first `n` elements. Same
     * parallel-incompatibility as take(n).
     */
    public #Stream<T> skip(int32 n) {
        if (this.isParallel) {
            throw heap Exception("skip(n) cannot be applied to a parallel stream; call .sequential() first to clear the parallel flag");
        }
        return heap SkipStream<T>(this, n);
    }

    /**
     * Lazy intermediate: invoke `fn` on each element for its side
     * effect (logging, debugging) and pass the element through
     * unchanged. Stream contents and length are untouched.
     *
     * ```cajeta
     * int32 n = s.peek((x) -> print(x)).count();
     * ```
     */
    public #Stream<T> peek((T) -> void fn) {
        return heap PeekStream<T>(this, fn);
    }

    /**
     * Lazy intermediate: applies `fn: (T) -> R` to each element,
     * yielding Stream<R>.
     *
     * ```cajeta
     * #Stream<int64> wide = s.map<int64>((x) -> x * 2L);
     * ```
     */
    public final #Stream<R> map<R>((T) -> #R fn) {
        return heap MapStream<T, R>(this, fn);
    }

    /**
     * Applies `fn: (T) -> Stream<R>` to each element, then flattens
     * by draining each returned inner stream before pulling the next
     * outer element. Yields Stream<R>.
     */
    public final #Stream<R> flatMap<R>((T) -> #Stream<R> fn) {
        return heap FlatMapStream<T, R>(this, fn);
    }

    /**
     * Recovery intermediate: like `map`, but elements whose `fn`
     * throws `RecoverableException` are DROPPED. Stream shortens.
     * `UnrecoverableException` propagates (alarm contract).
     *
     * Use when failures are noise and you don't need the error
     * record. See `StreamParallelism.ErrorHandling.md` § 3.3 for
     * the full pattern catalogue.
     */
    public final #Stream<R> mapOrSkip<R>((T) -> #R fn) {
        return heap MapOrSkipStream<T, R>(this, fn);
    }

    /**
     * Recovery intermediate: like `map`, but elements whose `fn`
     * throws `RecoverableException` are SUBSTITUTED with `fallback`.
     * Stream length unchanged. `UnrecoverableException` propagates.
     *
     * Use when you need a same-length stream and a sentinel value
     * is acceptable for failures (0 for sum, identity for product).
     */
    public final #Stream<R> mapOrFallback<R>((T) -> #R fn, R fallback) {
        return heap MapOrFallbackStream<T, R>(this, fn, fallback);
    }

    /**
     * Recovery intermediate: like `map`, but elements whose `fn`
     * throws `RecoverableException` are passed to
     * `logger: (T, Exception) -> void` and then DROPPED. Stream
     * shortens. `UnrecoverableException` propagates.
     *
     * Use when you want failures observable without aborting the
     * pipeline. The logger sees both the offending element and the
     * caught exception.
     */
    public final #Stream<R> mapOrLog<R>((T) -> #R fn, (T, Exception) -> void logger) {
        return heap MapOrLogStream<T, R>(this, fn, logger);
    }
}
