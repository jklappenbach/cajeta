package cajeta.lang.stream;

/**
 * Walks a HashMap's slot arrays and yields each OCCUPIED value.
 * Snapshot semantics match HashMapKeyStream — the same caveat about
 * mutation-during-iteration applies. See HashMapKeyStream for the
 * iteration model + skip rules (EMPTY / TOMBSTONE / OCCUPIED).
 */
public class HashMapValueStream<K, V> extends Stream<V> {
    V[] vals;
    int8[] state;
    int64 cap;
    int64 idx;

    public HashMapValueStream(V[] vals, int8[] state, int64 cap) {
        this.vals = vals;
        this.state = state;
        this.cap = cap;
        this.idx = 0;
    }

    public Optional<V> next() {
        while (this.idx < this.cap) {
            if (this.state[this.idx] == 1) {
                V v = this.vals[this.idx];
                this.idx = this.idx + 1;
                return heap Optional<V>(true, v);
            }
            this.idx = this.idx + 1;
        }
        return heap Optional<V>(false, null);
    }
}
