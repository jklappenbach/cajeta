package cajeta.lang.stream;

/**
 * Walks a HashMap's slot arrays and yields each OCCUPIED value.
 * Snapshot semantics match HashMapKeyStream — the same caveat about
 * mutation-during-iteration applies. See HashMapKeyStream for the
 * iteration model + skip rules (EMPTY / TOMBSTONE / OCCUPIED).
 */
public class HashMapValueStream<K, V> extends Stream<V> implements Splittable<V> {
    V[] vals;
    int8[] state;
    int64 cap;
    int64 idx;

    public HashMapValueStream(V[] vals, int8[] state, int64 cap) {
        this.vals = vals;
        this.state = state;
        this.cap = cap;
        this.idx = 0;
    }

    public Optional<V> next() {
        while (this.idx < this.cap) {
            if (this.state[this.idx] == 1) {
                V v = this.vals[this.idx];
                this.idx = this.idx + 1;
                return stack Optional<V>(true, #v);
            }
            this.idx = this.idx + 1;
        }
        return stack Optional<V>(false, null);
    }

    /**
     * See HashMapKeyStream.trySplit — same disjoint-slot-range
     * model, applied to the values array.
     */
    public #Stream<V> trySplit() {
        int64 remaining = this.cap - this.idx;
        if (remaining < 2L) {
            return null;
        }
        int64 mid = this.idx + remaining / 2L;
        HashMapValueStream<K, V> upper = heap HashMapValueStream<K, V>(this.vals, this.state, this.cap);
        upper.idx = mid;
        this.cap = mid;
        return upper;
    }

    public int64 estimateSize() {
        return this.cap - this.idx;
    }

    public int64 splittableSize() {
        return this.estimateSize();
    }

    public #Stream<?> trySplitRoot() {
        return this.trySplit();
    }
}
