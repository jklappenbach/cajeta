package cajeta.lang.stream;

/**
 * A `Stream` over a `HashMap`'s values — walks the slot arrays
 * and yields each OCCUPIED value. As a `Splittable` root it can be
 * split for parallel terminals (see `ParallelDriver`).
 *
 * You normally obtain one from `HashMap` rather than constructing
 * it directly:
 *
 * ```cajeta
 * HashMap<String, int32> ages = ...;
 * int64 total #= ages.values()
 *     .map<int64>((v) -> (int64) v)
 *     .reduce(0L, (a, b) -> a + b);
 * ```
 *
 * Snapshot semantics match `HashMapKeyStream` — the same caveat
 * about mutation-during-iteration applies. See `HashMapKeyStream`
 * for the iteration model + skip rules (EMPTY / TOMBSTONE /
 * OCCUPIED).
 */
public class HashMapValueStream<K, V> extends Stream<V> implements Splittable<V> {
    MapEntry<K, V>[] slots;
    int8[] ctrl;
    int64 cap;
    int64 idx;

    /**
     * Captures references to the value + state arrays and the slot
     * capacity, with the cursor parked at the first slot. Snapshot
     * point: see the class note. Prefer `HashMap`.`values()` over
     * calling this directly — it wires the map's internal arrays in
     * for you.
     *
     * ```cajeta
     * Stream<V> s = heap HashMapValueStream<K, V>(vals, state, cap);
     * ```
     */
    public HashMapValueStream(MapEntry<K, V>[] slots, int8[] ctrl, int64 cap) {
        this.slots #= slots;
        this.ctrl #= ctrl;
        this.cap = cap;
        this.idx = 0;
    }

    /**
     * Advances the cursor to the next OCCUPIED slot and returns its
     * value in a present `Optional`, skipping EMPTY/TOMBSTONE slots.
     * Returns an empty `Optional` once the slot range is exhausted.
     */
    public Optional<V> next() {
        while (this.idx < this.cap) {
            if (this.ctrl[this.idx] >= (int8) 0) {   // FULL: top bit clear
                V v = this.slots[this.idx].val;
                this.idx = this.idx + 1;
                return stack Optional<V>(true, #v);
            }
            this.idx = this.idx + 1;
        }
        return stack Optional<V>(false);
    }

    /**
     * See HashMapKeyStream.trySplit — same disjoint-slot-range
     * model, applied to the values array.
     */
    public #Stream<V> trySplit() {
        int64 remaining = this.cap - this.idx;
        if (remaining < 2L) {
            return null;
        }
        int64 mid = this.idx + remaining / 2L;
        HashMapValueStream<K, V> upper = heap HashMapValueStream<K, V>(this.slots, this.ctrl, this.cap);
        upper.idx = mid;
        this.cap = mid;
        return upper;
    }

    /**
     * Conservative remaining-element estimate: counts remaining slot
     * positions, not occupied entries, so it overshoots when EMPTY/
     * TOMBSTONE slots are present. Robust for split-count math since
     * every share applies the skip rules identically.
     */
    public int64 estimateSize() {
        return this.cap - this.idx;
    }

    public int64 splittableSize() {
        return this.estimateSize();
    }

    public #Stream<?> trySplitRoot() {
        return this.trySplit();
    }
}
