package cajeta.lang.stream;

/**
 * Fork/join orchestrator for parallel stream terminals.
 *
 * Each entry point (reduceParallel, anyMatchParallel, allMatchParallel,
 * noneMatchParallel) decides a split count from estimateSize, pulls up
 * to nSplits-1 shares off the source via trySplit, spawns one async
 * worker per share inside a `scope { ... }`, and walks the tail piece
 * on the orchestrator's own fiber. The scope joins every spawned
 * worker before control passes the closing brace; the orchestrator
 * then combines the partials with the terminal-specific combine op
 * (associative + identity-respecting per the StreamParallelism §
 * Per-terminal rules contract).
 *
 * Below MIN_PER_SPLIT * 2 elements (or when estimateSize() = UNKNOWN
 * yields a single split) the orchestrator walks the source on this
 * fiber — no spawn overhead for tiny / single-element sources.
 *
 * Today's scheduler is cooperative single-carrier (per Thread.md §
 * Status); the orchestration topology is fork-ready, and once a
 * multi-carrier scheduler lands the same driver yields wall-clock
 * parallelism without a code change.
 *
 * See cajeta-docs/stdlib/StreamParallelism.md.
 */
public class ParallelDriver {
    /**
     * Minimum elements per split before parallel pays off. Below
     * this threshold, the driver runs sequentially even if the
     * stream is marked parallel — fiber-spawn overhead dominates
     * the work for small sources.
     */
    public static final int64 MIN_PER_SPLIT = 32L;

    /**
     * Maximum fan-out per parallel call. Today the driver runs
     * sequentially regardless; once spawn-based fork lands the cap
     * applies to the worker count.
     */
    public static final int32 MAX_SPLITS = 8;

    /**
     * Parallel count. Source confirmed Splittable<T> and parallel-
     * eligible by the caller (Stream<T>.count() override).
     *
     * v1 body walks the source sequentially. The split-count
     * decision is computed but unused — the driver records what
     * fan-out it WOULD have picked for future debug instrumentation.
     */
    public static int32 countParallel<T>(Splittable<T> source) {
        // Inline sequential walk. Avoids re-dispatching through
        // count() which would tangle with the parallel-flag check.
        int32 n = 0;
        Optional<T> o = source.next();
        while (o.isPresent()) {
            n = n + 1;
            o = source.next();
        }
        return n;
    }

    /**
     * Parallel reduce. Source confirmed Splittable<T> and parallel-
     * eligible by the caller; today the caller is direct user code
     * via `ParallelDriver.reduceParallel<T>(splittable, ...)`. A
     * wrapper-aware Stream<T>.reduce dispatch — which checks
     * isParallel and downcasts when the head is Splittable — lands
     * in P2 alongside the wrapper-chain unwind work.
     *
     * Contract (per Java's reduce(T, BinaryOperator<T>) and
     * StreamParallelism.md § Per-terminal rules):
     *   - `fn` MUST be associative.
     *   - `seed` MUST be `fn`'s identity (e.g. 0 for +, 1 for *,
     *     empty for string concat).
     * Violating these gives a numerically-correct but
     * implementation-dependent result; that's the same contract
     * Java's parallel reduce documents. The
     * `parallel-reduce-nonzero-seed` lint at the call site (P4
     * work) flags the most-common identity mistake.
     *
     * v1 body walks the source sequentially. Split-and-spawn lands
     * in a follow-up with structured concurrency wiring (see
     * StreamParallelism.md § Worker layout); when it lands, each
     * worker calls this same `fn` to accumulate into its partial
     * and the orchestrator combines partials with `fn` again (legal
     * because `fn` is associative + identity-respecting per the
     * contract above).
     */
    public static T reduceParallel<T>(Splittable<T> source, T seed, (T, T) -> T fn) {
        int64 sz = source.estimateSize();
        int32 nSplits = pickSplitCount(sz);
        if (nSplits < 2) {
            T acc = seed;
            Optional<T> o = source.next();
            while (o.isPresent()) {
                acc = fn(acc, o.get());
                o = source.next();
            }
            return acc;
        }
        Stream<T>[] shares = new Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<T> piece = source.trySplit();
            if (piece == null) {
                break;
            }
            shares[si] = piece;
            shareCount = shareCount + 1;
            si = si + 1;
        }
        T[] partials = new T[shareCount + 1];
        int32 pi = 0;
        while (pi < shareCount + 1) {
            partials[pi] = seed;
            pi = pi + 1;
        }
        // Fork each worker as its own fiber inside a scope; the
        // scope's closing `}` joins every spawned worker before
        // control returns. The orchestrator then walks the tail
        // share on its own fiber and combines partials.
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn reduceWorker<T>(shares[wi], wi, partials, fn);
                wi = wi + 1;
            }
        }
        T tail = seed;
        Optional<T> o = source.next();
        while (o.isPresent()) {
            tail = fn(tail, o.get());
            o = source.next();
        }
        partials[shareCount] = tail;
        T acc = seed;
        int32 ci = 0;
        while (ci < shareCount + 1) {
            acc = fn(acc, partials[ci]);
            ci = ci + 1;
        }
        return acc;
    }

    /**
     * Per-worker drain. Pulls every element from `share`, folds it
     * into the running accumulator via `fn`, and writes the result
     * back into `partials[slot]`. Async — invoked via `spawn` from
     * reduceParallel's fork loop. Returns 0 only because spawn
     * targets need a return type; the meaningful output is the
     * partials[slot] write.
     */
    public static async int32 reduceWorker<T>(Stream<T> share, int32 slot, T[] partials, (T, T) -> T fn) {
        T acc = partials[slot];
        Optional<T> o = share.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = share.next();
        }
        partials[slot] = acc;
        return 0;
    }


    /**
     * Parallel anyMatch. Returns true as soon as any element
     * satisfies `predicate`. v1 walks sequentially and short-circuits
     * on first match; when split-and-spawn lands, the first worker
     * to hit a match cancels its sibling scopes so they stop
     * pulling. The predicate must be side-effect-free (Java's same
     * contract) so cancellation can't observe a half-committed state.
     */
    public static boolean anyMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (predicate(o.get())) {
                return true;
            }
            o = source.next();
        }
        return false;
    }

    /**
     * Parallel allMatch. Returns true only if every element
     * satisfies `predicate`. Vacuously true on an empty source.
     * Short-circuits on the first non-match (worker-cancelling once
     * split-and-spawn lands).
     */
    public static boolean allMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (!predicate(o.get())) {
                return false;
            }
            o = source.next();
        }
        return true;
    }

    /**
     * Parallel noneMatch. Returns true only if no element satisfies
     * `predicate`. Short-circuits on the first match.
     */
    public static boolean noneMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (predicate(o.get())) {
                return false;
            }
            o = source.next();
        }
        return true;
    }

    /**
     * Decide split count from estimateSize.
     *  - size < MIN_PER_SPLIT * 2 → 1 (sequential).
     *  - else: ceil(sqrt(size)) capped by MAX_SPLITS.
     *  - estimateSize() == -1 (UNKNOWN) → MAX_SPLITS (best effort).
     */
    public static int32 pickSplitCount(int64 sz) {
        if (sz < 0L) {
            return MAX_SPLITS;
        }
        if (sz < MIN_PER_SPLIT * 2L) {
            return 1;
        }
        int64 s = isqrt(sz);
        int32 n = (int32) s;
        if (n > MAX_SPLITS) {
            n = MAX_SPLITS;
        }
        if (n < 2) {
            n = 2;
        }
        return n;
    }

    /**
     * Integer square root (Newton's method). Inlined here so the
     * driver doesn't take a Math dependency at this layer.
     */
    public static int64 isqrt(int64 n) {
        if (n < 2L) {
            return n;
        }
        int64 x = n;
        int64 y = (x + 1L) / 2L;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2L;
        }
        return x;
    }
}
