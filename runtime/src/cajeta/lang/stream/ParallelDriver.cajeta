package cajeta.lang.stream;

import cajeta.error.Exception;
import cajeta.concurrent.AtomicInt32;

/**
 * Fork/join orchestrator for parallel stream terminals.
 *
 * Each entry point (reduceParallel, anyMatchParallel, allMatchParallel,
 * noneMatchParallel) decides a split count from estimateSize, pulls up
 * to nSplits-1 shares off the source via trySplit, spawns one async
 * worker per share inside a `scope { ... }`, and walks the tail piece
 * on the orchestrator's own fiber. The scope joins every spawned
 * worker before control passes the closing brace; the orchestrator
 * then combines the partials with the terminal-specific combine op
 * (associative + identity-respecting per the StreamParallelism §
 * Per-terminal rules contract).
 *
 * Below MIN_PER_SPLIT * 2 elements (or when estimateSize() = UNKNOWN
 * yields a single split) the orchestrator walks the source on this
 * fiber — no spawn overhead for tiny / single-element sources.
 *
 * Today's scheduler is cooperative single-carrier (per Concurrency.md §
 * Status); the orchestration topology is fork-ready, and once a
 * multi-carrier scheduler lands the same driver yields wall-clock
 * parallelism without a code change.
 *
 * ## Usage
 * ```cajeta
 * // Reduce a Splittable source in parallel — `fn` MUST be associative
 * // and `seed` its identity:
 * int32 total = ParallelDriver.reduceParallel<int32>(src, 0, (a, b) -> a + b);
 *
 * // Over a whole Stream pipeline (wrapper-chain aware):
 * boolean any = ParallelDriver.anyMatchParallelChain<int32>(stream, (x) -> x > 100);
 * Optional<int32> hit = ParallelDriver.findAnyParallelChain<int32>(stream, (x) -> x % 2 == 0);
 * ```
 *
 * Drives `Splittable` sources and `Stream` pipelines, returns
 * single-element results as `Optional`, and coordinates short-circuit
 * workers through a shared `AtomicInt32` cancel flag.
 *
 * See docs/specification/lang/stream/StreamParallelism.md.
 */
public class ParallelDriver {
    /**
     * Minimum elements per split before parallel pays off. Below
     * this threshold, the driver runs sequentially even if the
     * stream is marked parallel — fiber-spawn overhead dominates
     * the work for small sources.
     */
    public static final int64 MIN_PER_SPLIT = 32L;

    /**
     * Maximum fan-out per parallel call. Today the driver runs
     * sequentially regardless; once spawn-based fork lands the cap
     * applies to the worker count.
     */
    public static final int32 MAX_SPLITS = 8;

    /**
     * Parallel count. Source confirmed Splittable<T> and parallel-
     * eligible by the caller (Stream<T>.count() override).
     *
     * v1 body walks the source sequentially. The split-count
     * decision is computed but unused — the driver records what
     * fan-out it WOULD have picked for future debug instrumentation.
     *
     * ```cajeta
     * int32 n = ParallelDriver.countParallel<int32>(src);
     * ```
     */
    public static int32 countParallel<T>(Splittable<T> source) {
        // Inline sequential walk. Avoids re-dispatching through
        // count() which would tangle with the parallel-flag check.
        int32 n = 0;
        Optional<T> o = source.next();
        while (o.isPresent()) {
            n = n + 1;
            o = source.next();
        }
        return n;
    }

    /**
     * Parallel reduce. Source confirmed Splittable<T> and parallel-
     * eligible by the caller; today the caller is direct user code
     * via `ParallelDriver.reduceParallel<T>(splittable, ...)`. A
     * wrapper-aware Stream<T>.reduce dispatch — which checks
     * isParallel and downcasts when the head is Splittable — lands
     * in P2 alongside the wrapper-chain unwind work.
     *
     * Contract (per Java's reduce(T, BinaryOperator<T>) and
     * StreamParallelism.md § Per-terminal rules):
     *   - `fn` MUST be associative.
     *   - `seed` MUST be `fn`'s identity (e.g. 0 for +, 1 for *,
     *     empty for string concat).
     * Violating these gives a numerically-correct but
     * implementation-dependent result; that's the same contract
     * Java's parallel reduce documents. The
     * `parallel-reduce-nonzero-seed` lint at the call site (P4
     * work) flags the most-common identity mistake.
     *
     * v1 body walks the source sequentially. Split-and-spawn lands
     * in a follow-up with structured concurrency wiring (see
     * StreamParallelism.md § Worker layout); when it lands, each
     * worker calls this same `fn` to accumulate into its partial
     * and the orchestrator combines partials with `fn` again (legal
     * because `fn` is associative + identity-respecting per the
     * contract above).
     *
     * ```cajeta
     * int32 sum = ParallelDriver.reduceParallel<int32>(src, 0, (a, b) -> a + b);
     * ```
     */
    public static T reduceParallel<T>(Splittable<T> source, T seed, (T, T) -> #T fn) {
        int64 sz = source.estimateSize();
        int32 nSplits = pickSplitCount(sz);
        if (nSplits < 2) {
            T acc = seed;
            Optional<T> o = source.next();
            while (o.isPresent()) {
                acc = fn(acc, o.get());
                o = source.next();
            }
            return acc;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<T> piece = source.trySplit();
            if (piece == null) {
                break;
            }
            shares[si] = piece;
            shareCount = shareCount + 1;
            si = si + 1;
        }
        T[] partials = heap T[shareCount + 1];
        int32 pi = 0;
        while (pi < shareCount + 1) {
            partials[pi] = seed;
            pi = pi + 1;
        }
        // Fork each worker as its own fiber inside a scope; the
        // scope's closing `}` joins every spawned worker before
        // control returns. The orchestrator then walks the tail
        // share on its own fiber and combines partials.
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn reduceWorker<T>(shares[wi], wi, partials, fn);
                wi = wi + 1;
            }
        }
        T tail = seed;
        Optional<T> o = source.next();
        while (o.isPresent()) {
            tail = fn(tail, o.get());
            o = source.next();
        }
        partials[shareCount] = tail;
        T acc = seed;
        int32 ci = 0;
        while (ci < shareCount + 1) {
            acc = fn(acc, partials[ci]);
            ci = ci + 1;
        }
        return acc;
    }

    /**
     * Per-worker drain. Pulls every element from `share`, folds it
     * into the running accumulator via `fn`, and writes the result
     * back into `partials[slot]`. Async — invoked via `spawn` from
     * reduceParallel's fork loop. Returns 0 only because spawn
     * targets need a return type; the meaningful output is the
     * partials[slot] write.
     */
    public static async int32 reduceWorker<T>(Stream<T> share, int32 slot, T[] partials, (T, T) -> #T fn) {
        T acc = partials[slot];
        Optional<T> o = share.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = share.next();
        }
        partials[slot] = acc;
        return 0;
    }


    /**
     * Parallel anyMatch. Returns true as soon as any element
     * satisfies `predicate`. Fork shape mirrors reduceParallel:
     * pull nSplits-1 shares, spawn one findHitWorker per share
     * inside a scope, walk the tail on the orchestrator fiber. All
     * workers share a single-element `hit` flag; the first hit
     * (worker or tail) sets it, and every other worker bails at the
     * top of its next loop iteration. The predicate must be side-
     * effect-free (Java's same contract) so the cooperative cancel
     * can't observe a half-committed state.
     *
     * ```cajeta
     * boolean found = ParallelDriver.anyMatchParallel<int32>(src, (x) -> x > 100);
     * ```
     */
    public static boolean anyMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        int64 sz = source.estimateSize();
        int32 nSplits = pickSplitCount(sz);
        if (nSplits < 2) {
            Optional<T> o = source.next();
            while (o.isPresent()) {
                if (predicate(o.get())) {
                    return true;
                }
                o = source.next();
            }
            return false;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<T> piece = source.trySplit();
            if (piece == null) {
                break;
            }
            shares[si] = piece;
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 hit = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findHitWorker<T>(shares[wi], predicate, hit);
                wi = wi + 1;
            }
        }
        if (hit.load() != 0) {
            return true;
        }
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (predicate(o.get())) {
                return true;
            }
            o = source.next();
        }
        return false;
    }

    /**
     * Parallel allMatch. Returns true only if every element
     * satisfies `predicate`. Vacuously true on an empty source.
     * Uses findFailWorker, which signals on the first !predicate
     * element; sibling workers see the flag and bail.
     *
     * ```cajeta
     * boolean ok = ParallelDriver.allMatchParallel<int32>(src, (x) -> x >= 0);
     * ```
     */
    public static boolean allMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        int64 sz = source.estimateSize();
        int32 nSplits = pickSplitCount(sz);
        if (nSplits < 2) {
            Optional<T> o = source.next();
            while (o.isPresent()) {
                if (!predicate(o.get())) {
                    return false;
                }
                o = source.next();
            }
            return true;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<T> piece = source.trySplit();
            if (piece == null) {
                break;
            }
            shares[si] = piece;
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 fail = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findFailWorker<T>(shares[wi], predicate, fail);
                wi = wi + 1;
            }
        }
        if (fail.load() != 0) {
            return false;
        }
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (!predicate(o.get())) {
                return false;
            }
            o = source.next();
        }
        return true;
    }

    /**
     * Parallel noneMatch. Returns true only if no element satisfies
     * `predicate`. Same shape as anyMatch — shares findHitWorker —
     * but inverts the return: a hit means the result is false.
     *
     * ```cajeta
     * boolean none = ParallelDriver.noneMatchParallel<int32>(src, (x) -> x < 0);
     * ```
     */
    public static boolean noneMatchParallel<T>(Splittable<T> source, (T) -> boolean predicate) {
        int64 sz = source.estimateSize();
        int32 nSplits = pickSplitCount(sz);
        if (nSplits < 2) {
            Optional<T> o = source.next();
            while (o.isPresent()) {
                if (predicate(o.get())) {
                    return false;
                }
                o = source.next();
            }
            return true;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<T> piece = source.trySplit();
            if (piece == null) {
                break;
            }
            shares[si] = piece;
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 hit = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findHitWorker<T>(shares[wi], predicate, hit);
                wi = wi + 1;
            }
        }
        if (hit.load() != 0) {
            return false;
        }
        Optional<T> o = source.next();
        while (o.isPresent()) {
            if (predicate(o.get())) {
                return false;
            }
            o = source.next();
        }
        return true;
    }

    /**
     * Worker for anyMatch / noneMatch. Drains `share` until either
     * the cooperative `hit` flag is set by a sibling, or this worker
     * finds an element satisfying `predicate` (and sets `hit` for
     * siblings). Returns 0 unconditionally — the meaningful output
     * is the hit.store(1) write.
     *
     * R8.3 audit: `hit` is an AtomicInt32 (was `boolean[1]`) so the
     * cross-carrier reads/writes don't tear under multi-worker
     * scheduling. The one-shot 0→1 transition is the only contended
     * write; load() per-iteration is the cooperative bail check.
     */
    public static async int32 findHitWorker<T>(Stream<T> share, (T) -> boolean predicate, AtomicInt32 hit) {
        Optional<T> o = share.next();
        while (o.isPresent()) {
            if (hit.load() != 0) {
                return 0;
            }
            if (predicate(o.get())) {
                hit.store(1);
                return 0;
            }
            o = share.next();
        }
        return 0;
    }

    /**
     * Worker for allMatch. Drains `share` until either the
     * cooperative `fail` flag is set by a sibling, or this worker
     * finds an element failing `predicate` (and sets `fail`).
     *
     * R8.3 audit: `fail` is an AtomicInt32 (was `boolean[1]`); same
     * rationale as findHitWorker.
     */
    public static async int32 findFailWorker<T>(Stream<T> share, (T) -> boolean predicate, AtomicInt32 fail) {
        Optional<T> o = share.next();
        while (o.isPresent()) {
            if (fail.load() != 0) {
                return 0;
            }
            if (!predicate(o.get())) {
                fail.store(1);
                return 0;
            }
            o = share.next();
        }
        return 0;
    }

    /**
     * Worker for forEach. Drains `share`, invoking `fn` on each
     * element. No short-circuit (forEach visits every element); no
     * shared cancel flag.
     */
    public static async int32 forEachWorker<T>(Stream<T> share, (T) -> void fn) {
        Optional<T> o = share.next();
        while (o.isPresent()) {
            fn(o.get());
            o = share.next();
        }
        return 0;
    }

    /**
     * Wrapper-chain-aware parallel reduce. Entry point for
     * `Stream<T>.reduce` when `isParallel` is set on the head.
     *
     *   1. Walk `head.unwrap()` to find the chain root. Reject
     *      stateful intermediates (take/skip) with
     *      CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL.
     *   2. Pick `nSplits` from `root.splittableSize()`. If the root
     *      isn't Splittable or the size is below threshold, fall
     *      back to sequential `head.next()` walk.
     *   3. For each split share, rebuild the head's wrapper chain
     *      over the share via `head.cloneChainOver(#piece)` —
     *      wrappers recurse to rebuild themselves bottom-up,
     *      Splittable roots return the share unchanged. Fork via
     *      `scope { spawn reduceWorker<T> }`.
     *   4. Tail walks `head.next()` on the orchestrator (the root's
     *      residual after all `trySplitRoot` calls).
     *   5. Combine partials sequentially. v1 is O(N) over splits;
     *      tree-reduce is a v2 tuning step.
     *
     * Type-changing wrappers (MapStream<U,T>, FlatMapStream<U,T>)
     * inherit Stream<T>.unwrap()=null, so the unwind stops at the
     * MapStream itself. splittableSize on the MapStream returns -1L
     * (inherited Stream<T> default), triggering the sequential
     * fallback. Lifting the type-changing case wants either
     * Object-erasure or wildcards (CajetaType.cpp:454 rejects
     * `<?>` today).
     *
     * Entry point for a `Stream` head; sibling chain links such as
     * `MapStream` / `FlatMapStream` fall back to sequential here.
     *
     * ```cajeta
     * int32 total = ParallelDriver.reduceParallelChain<int32>(stream, 0, (a, b) -> a + b);
     * ```
     */
    public static #T reduceParallelChain<T>(Stream<T> head, T seed, (T, T) -> #T fn) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        // Sequential fallback shared by two cases:
        //   - root not Splittable (splittableSize returns -1L)
        //   - source too small for fork to pay off (nSplits < 2)
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            T accY = seed;
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                accY = fn(accY, oY.get());
                oY = head.next();
            }
            return accY;
        }
        // Pull splits, then rebuild head's wrapper chain over each
        // via cloneChainOver. For depth==0 the base Stream<T>
        // .cloneChainOver returns newRoot unchanged → piece becomes
        // the share. For depth>0, each wrapper level wraps the
        // recursive result so the worker sees the same chain over
        // its slice.
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        T[] partials = heap T[shareCount + 1];
        int32 pi = 0;
        while (pi < shareCount + 1) {
            partials[pi] = seed;
            pi = pi + 1;
        }
        scope {
            int32 swi = 0;
            while (swi < shareCount) {
                spawn reduceWorker<T>(shares[swi], swi, partials, fn);
                swi = swi + 1;
            }
        }
        T tail = seed;
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            tail = fn(tail, ot.get());
            ot = head.next();
        }
        partials[shareCount] = tail;
        T acc = seed;
        int32 ci = 0;
        while (ci < shareCount + 1) {
            acc = fn(acc, partials[ci]);
            ci = ci + 1;
        }
        return acc;
    }

    /**
     * Wrapper-chain-aware parallel fold with explicit combiner.
     * Same shape as `reduceParallelChain` but with cross-type R: the
     * per-share accumulator is `(R, T) -> #R fn`, and the partials
     * are merged via `(R, R) -> #R combiner` (which the orchestrator
     * also uses to seed-accumulate, mirroring fn's identity contract
     * over `seed`). Per Java's reduce(seed, fn, combiner) contract:
     *   - `combiner` MUST be associative.
     *   - `combiner(seed, fn(seed, t))` MUST equal `fn(seed, t)` —
     *     i.e. `seed` is the identity for both fn and combiner.
     * Violating these gives a numerically-correct but
     * implementation-dependent answer (same as Java's parallel
     * collect contract).
     *
     * Type-changing wrappers (MapStream<U,T>, FlatMapStream<U,T>)
     * still fall back to sequential here for the same reason as
     * reduceParallelChain: the chain is Stream<T>-typed and the
     * Map/FlatMap nodes flip to a different element type that
     * Stream<T>.unwrap()=null hides. Lifting that wants either
     * Object-erasure or wildcard support (CajetaType.cpp:454).
     *
     * ```cajeta
     * // Fold int32 elements into a wider int64 accumulator:
     * int64 total = ParallelDriver.foldParallelChain<int32, int64>(
     *     stream, 0L, (acc, x) -> acc + (int64) x, (a, b) -> a + b);
     * ```
     */
    public static #R foldParallelChain<T, R>(Stream<T> head, R seed, (R, T) -> #R fn, (R, R) -> #R combiner) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            R accY = seed;
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                accY = fn(accY, oY.get());
                oY = head.next();
            }
            return accY;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        R[] partials = heap R[shareCount + 1];
        int32 pi = 0;
        while (pi < shareCount + 1) {
            partials[pi] = seed;
            pi = pi + 1;
        }
        scope {
            int32 swi = 0;
            while (swi < shareCount) {
                spawn foldWorker<T, R>(shares[swi], swi, partials, fn);
                swi = swi + 1;
            }
        }
        R tail = seed;
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            tail = fn(tail, ot.get());
            ot = head.next();
        }
        partials[shareCount] = tail;
        R acc = seed;
        int32 ci = 0;
        while (ci < shareCount + 1) {
            acc = combiner(acc, partials[ci]);
            ci = ci + 1;
        }
        return acc;
    }

    /**
     * Per-worker drain for `foldParallelChain`. Mirrors reduceWorker
     * but with two type params — T for the element type, R for the
     * accumulator. The combiner isn't needed inside the worker; it
     * only fires on the orchestrator when the join-scope completes.
     */
    public static async int32 foldWorker<T, R>(Stream<T> share, int32 slot, R[] partials, (R, T) -> #R fn) {
        R acc = partials[slot];
        Optional<T> o = share.next();
        while (o.isPresent()) {
            acc = fn(acc, o.get());
            o = share.next();
        }
        partials[slot] = acc;
        return 0;
    }

    /**
     * Wrapper-chain-aware parallel collect. Same orchestration as
     * `foldParallelChain` with one critical difference: each
     * partial slot is initialized via `supplier()` rather than from
     * a single shared seed. For mutable R (e.g. ArrayList) this is
     * what keeps workers from aliasing one instance and racing on
     * `add` / drop. Per-worker drain reuses `foldWorker<T, R>` —
     * the worker side is identical; only the partials[] seeding
     * differs.
     *
     * ```cajeta
     * // Each worker gets its own `ArrayList` via the supplier, so
     * // there's no aliasing/race on a shared mutable container:
     * ArrayList<int32> out = ParallelDriver.collectParallelChain<int32, ArrayList<int32>>(
     *     stream,
     *     () -> heap ArrayList<int32>(),
     *     (list, x) -> list.add(x),
     *     (a, b) -> a.addAll(b));
     * ```
     */
    public static #R collectParallelChain<T, R>(Stream<T> head, () -> #R supplier, (R, T) -> #R accumulator, (R, R) -> #R combiner) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            R accY = supplier();
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                accY = accumulator(accY, oY.get());
                oY = head.next();
            }
            return accY;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        R[] partials = heap R[shareCount + 1];
        int32 pi = 0;
        while (pi < shareCount + 1) {
            partials[pi] = supplier();
            pi = pi + 1;
        }
        scope {
            int32 swi = 0;
            while (swi < shareCount) {
                spawn foldWorker<T, R>(shares[swi], swi, partials, accumulator);
                swi = swi + 1;
            }
        }
        R tail = partials[shareCount];
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            tail = accumulator(tail, ot.get());
            ot = head.next();
        }
        partials[shareCount] = tail;
        R acc = partials[0];
        int32 ci = 1;
        while (ci < shareCount + 1) {
            acc = combiner(acc, partials[ci]);
            ci = ci + 1;
        }
        return acc;
    }

    /**
     * Wrapper-chain-aware parallel anyMatch. Same shape as
     * `reduceParallelChain`: walk unwrap, reject stateful, rebuild
     * each share via `head.cloneChainOver(#piece)`, fork via
     * `scope { spawn findHitWorker<T> }`. Short-circuits via a
     * shared `boolean[1] hit` flag.
     *
     * ```cajeta
     * boolean found = ParallelDriver.anyMatchParallelChain<int32>(stream, (x) -> x > 100);
     * ```
     */
    public static boolean anyMatchParallelChain<T>(Stream<T> head, (T) -> boolean predicate) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                if (predicate(oY.get())) {
                    return true;
                }
                oY = head.next();
            }
            return false;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 hit = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findHitWorker<T>(shares[wi], predicate, hit);
                wi = wi + 1;
            }
        }
        if (hit.load() != 0) {
            return true;
        }
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            if (predicate(ot.get())) {
                return true;
            }
            ot = head.next();
        }
        return false;
    }

    /**
     * Wrapper-chain-aware parallel allMatch. Same shape as
     * anyMatchParallelChain but uses findFailWorker — first worker
     * to find a non-matching element flips the shared `fail` flag;
     * siblings observe and bail.
     *
     * ```cajeta
     * boolean ok = ParallelDriver.allMatchParallelChain<int32>(stream, (x) -> x >= 0);
     * ```
     */
    public static boolean allMatchParallelChain<T>(Stream<T> head, (T) -> boolean predicate) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                if (!predicate(oY.get())) {
                    return false;
                }
                oY = head.next();
            }
            return true;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 fail = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findFailWorker<T>(shares[wi], predicate, fail);
                wi = wi + 1;
            }
        }
        if (fail.load() != 0) {
            return false;
        }
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            if (!predicate(ot.get())) {
                return false;
            }
            ot = head.next();
        }
        return true;
    }

    /**
     * Wrapper-chain-aware parallel noneMatch. Same shape as
     * anyMatchParallelChain — shares findHitWorker, but inverts the
     * return: a hit means the result is false.
     *
     * ```cajeta
     * boolean none = ParallelDriver.noneMatchParallelChain<int32>(stream, (x) -> x < 0);
     * ```
     */
    public static boolean noneMatchParallelChain<T>(Stream<T> head, (T) -> boolean predicate) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                if (predicate(oY.get())) {
                    return false;
                }
                oY = head.next();
            }
            return true;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        AtomicInt32 hit = heap AtomicInt32(0);
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findHitWorker<T>(shares[wi], predicate, hit);
                wi = wi + 1;
            }
        }
        if (hit.load() != 0) {
            return false;
        }
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            if (predicate(ot.get())) {
                return false;
            }
            ot = head.next();
        }
        return true;
    }

    /**
     * Wrapper-chain-aware parallel findAny. Returns the first
     * matching element from ANY worker (or the tail walk) wrapped in
     * an Optional; empty Optional if no element matches. Per § R1
     * StreamParallelism.md, `findFirst` under `.parallel()` shifts
     * semantically to findAny — encounter order across split workers
     * isn't preserved, so the "first" in the sequential sense isn't
     * meaningful. Worker writes its hit element into the shared
     * `result` slot and flips `result[0]` non-null — siblings observe and bail.
     *
     * Same chain-walking shape as anyMatchParallelChain: walk
     * unwrap, reject stateful, rebuild each share via
     * `head.cloneChainOver(#piece)`, fork via
     * `scope { spawn findAnyWorker<T> }`.
     *
     * ```cajeta
     * Optional<int32> hit = ParallelDriver.findAnyParallelChain<int32>(stream, (x) -> x % 2 == 0);
     * if (hit.isPresent()) {
     *     int32 even = hit.get();
     * }
     * ```
     */
    public static Optional<T> findAnyParallelChain<T>(Stream<T> head, (T) -> boolean predicate) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                if (predicate(oY.get())) {
                    return stack Optional<T>(true, oY.get());
                }
                oY = head.next();
            }
            return stack Optional<T>(false);
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        // Shared Optional<T>[1] slot — workers write the freshly-
        // constructed Optional<T> directly. A non-null entry doubles
        // as the cooperative cancel signal (other workers bail at
        // the top of their next iteration). Race on the slot is
        // benign — findAny only requires SOME match.
        //
        // History: pre-Task-#46 this used a T[1] + boolean[1] pair
        // with the orchestrator constructing the Optional after
        // scope-join, working around a compile-time crash in
        // `heap Optional<T>[1]` when T is a method-template parameter
        // (CajetaArray ctor's elementType->getLlvmType() returned
        // null for a bare-template Optional and crashed
        // llvm::ArrayType::get). Fixed by extending
        // CajetaClass::getLlvmType to return ptr for bare templates
        // — same fallback the placeholder and wildcard cases use.
        Optional<T>[] result = heap Optional<T>[1];
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn findAnyWorker<T>(shares[wi], predicate, result);
                wi = wi + 1;
            }
        }
        if (result[0] != null && result[0].isPresent()) {
            return stack Optional<T>(true, result[0].get());
        }
        // Tail walks on the orchestrator after scope-join — workers
        // finished without a hit, but the root may have residual
        // elements.
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            if (predicate(ot.get())) {
                return stack Optional<T>(true, ot.get());
            }
            ot = head.next();
        }
        return stack Optional<T>(false);
    }

    /**
     * Worker for findAny. Drains `share`; on each iteration first
     * checks the shared `result[0]` cancel flag (any non-null entry
     * means another worker already found a match), then runs the
     * predicate. First worker to find a match writes a freshly
     * constructed Optional<T> into result[0]. Race on the slot
     * itself is benign — findAny only requires SOME match.
     */
    public static async int32 findAnyWorker<T>(Stream<T> share, (T) -> boolean predicate, Optional<T>[] result) {
        Optional<T> o = share.next();
        while (o.isPresent()) {
            if (result[0] != null) {
                return 0;
            }
            if (predicate(o.get())) {
                result[0] = heap Optional<T>(true, o.get());
                return 0;
            }
            o = share.next();
        }
        return 0;
    }

    /**
     * Wrapper-chain-aware parallel forEach. No return value, no
     * short-circuit — each worker drains its share to completion.
     * Order across workers is unspecified per
     * StreamParallelism.md § Per-terminal rules — `fn` must be
     * commutative AND thread-safe.
     *
     * ```cajeta
     * ParallelDriver.forEachParallelChain<int32>(stream, (x) -> println(x));
     * ```
     */
    public static void forEachParallelChain<T>(Stream<T> head, (T) -> void fn) {
        int32 depth = 0;
        Stream<?> cur = head;
        while (cur != null) {
            if (cur.isStatefulWrapper()) {
                throw heap Exception("CAJETA_ERROR_STREAM_PARALLEL_REJECT_STATEFUL: stateful intermediate op (take/skip) cannot be parallelized; call .sequential() before the stateful op");
            }
            Stream<?> next = cur.unwrap();
            if (next == null) {
                break;
            }
            cur = next;
            depth = depth + 1;
        }
        int64 sz = cur.splittableSize();
        int32 nSplits = pickSplitCount(sz);
        if (sz < 0L || nSplits < 2) {
            Optional<T> oY = head.next();
            while (oY.isPresent()) {
                fn(oY.get());
                oY = head.next();
            }
            return;
        }
        Stream<T>[] shares = heap Stream<T>[nSplits - 1];
        int32 shareCount = 0;
        int32 si = 0;
        while (si < nSplits - 1) {
            Stream<?> piece = cur.trySplitRoot();
            if (piece == null) {
                break;
            }
            shares[si] = head.cloneChainOver(#piece);
            shareCount = shareCount + 1;
            si = si + 1;
        }
        scope {
            int32 wi = 0;
            while (wi < shareCount) {
                spawn forEachWorker<T>(shares[wi], fn);
                wi = wi + 1;
            }
        }
        Optional<T> ot = head.next();
        while (ot.isPresent()) {
            fn(ot.get());
            ot = head.next();
        }
    }

    /**
     * Decide split count from estimateSize.
     *  - size < MIN_PER_SPLIT * 2 → 1 (sequential).
     *  - else: ceil(sqrt(size)) capped by MAX_SPLITS.
     *  - estimateSize() == -1 (UNKNOWN) → MAX_SPLITS (best effort).
     */
    public static int32 pickSplitCount(int64 sz) {
        if (sz < 0L) {
            return MAX_SPLITS;
        }
        if (sz < MIN_PER_SPLIT * 2L) {
            return 1;
        }
        int64 s = isqrt(sz);
        int32 n = (int32) s;
        if (n > MAX_SPLITS) {
            n = MAX_SPLITS;
        }
        if (n < 2) {
            n = 2;
        }
        return n;
    }

    /**
     * Integer square root (Newton's method). Inlined here so the
     * driver doesn't take a Math dependency at this layer.
     */
    public static int64 isqrt(int64 n) {
        if (n < 2L) {
            return n;
        }
        int64 x = n;
        int64 y = (x + 1L) / 2L;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2L;
        }
        return x;
    }
}
