package cajeta.lang.stream;

/**
 * A `Stream` that walks a `HashMap`'s slot arrays and yields each
 * OCCUPIED key. Implements `Splittable`, so it can be partitioned for
 * parallel traversal via `trySplit()`.
 *
 * Snapshot semantics: the constructor captures references to the
 * keys + state arrays at the moment of call. If the source `HashMap`
 * resizes (which swaps in fresh arrays) or mutates entries after
 * this stream is constructed, behavior is undefined — same
 * concurrent-modification rule as Java's non-snapshot iterators.
 *
 * The slot walk skips EMPTY (state==0) and TOMBSTONE (state==2)
 * positions; only OCCUPIED (state==1) yields. Pull complexity is
 * O(cap) total across the full iteration (linear scan), not
 * O(cap * size); the iterator state is a single int64 position
 * cursor advanced through each `next()` call. Keys are pulled one at a
 * time as an `Optional`; an empty `Optional` marks exhaustion.
 *
 * ```cajeta
 * #Stream<K> keys = heap HashMapKeyStream<K, V>(map.keys, map.state, map.cap);
 * Optional<K> head = keys.next();
 * while (head.isPresent()) {
 *     process(head.get());
 *     head = keys.next();
 * }
 * ```
 */
public class HashMapKeyStream<K, V> extends Stream<K> implements Splittable<K> {
    MapEntry<K, V>[] slots;
    int8[] ctrl;
    int64 cap;
    int64 idx;

    /**
     * Constructs a key stream over the given slot arrays, starting at
     * position 0. `cap` bounds the scan; `state[i]` classifies slot `i`
     * (0=EMPTY, 1=OCCUPIED, 2=TOMBSTONE) and `keys[i]` holds the key for
     * OCCUPIED slots. Typically built by a `HashMap` over its own
     * internal arrays rather than constructed directly.
     *
     * ```cajeta
     * #Stream<K> s = heap HashMapKeyStream<K, V>(map.keys, map.state, map.cap);
     * ```
     */
    public HashMapKeyStream(MapEntry<K, V>[] slots, int8[] ctrl, int64 cap) {
        this.slots #= slots;
        this.ctrl #= ctrl;
        this.cap = cap;
        this.idx = 0;
    }

    /**
     * Advances the cursor to the next OCCUPIED slot and returns its key
     * wrapped in a present `Optional`, skipping EMPTY and TOMBSTONE
     * positions. Returns an empty `Optional` once the cursor reaches
     * `cap` (stream exhausted).
     */
    public Optional<K> next() {
        while (this.idx < this.cap) {
            if (this.ctrl[this.idx] >= (int8) 0) {   // FULL: top bit clear
                K k = this.slots[this.idx].key;
                this.idx = this.idx + 1;
                return stack Optional<K>(true, #k);
            }
            this.idx = this.idx + 1;
        }
        return stack Optional<K>(false);
    }

    /**
     * Splits the remaining slot range in half. The returned stream
     * walks the upper half (from midpoint to cap); this stream
     * narrows its own cap to the midpoint so subsequent next() calls
     * only see the lower half. Shares the same keys + state arrays —
     * disjoint by index range, not by array identity.
     */
    public #Stream<K> trySplit() {
        int64 remaining = this.cap - this.idx;
        if (remaining < 2L) {
            return null;
        }
        int64 mid = this.idx + remaining / 2L;
        HashMapKeyStream<K, V> upper = heap HashMapKeyStream<K, V>(this.slots, this.ctrl, this.cap);
        upper.idx = mid;
        this.cap = mid;
        return upper;
    }

    /**
     * Estimate is conservative — counts remaining slot positions, not
     * occupied entries. Splitting overshoots somewhat (each share
     * iterates its slot range, skipping EMPTY/TOMBSTONE) but the
     * split-count math is robust to that since each share walks the
     * skip rules identically.
     */
    public int64 estimateSize() {
        return this.cap - this.idx;
    }

    /** Alias for `estimateSize()`; the `Splittable` view of the remaining work. */
    public int64 splittableSize() {
        return this.estimateSize();
    }

    /** Root-level entry point for the `Splittable` framework; delegates to `trySplit()`. */
    public #Stream<?> trySplitRoot() {
        return this.trySplit();
    }
}
