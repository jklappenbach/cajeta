package cajeta.lang.stream;

public class ArrayStream<T> extends Stream<T> implements Splittable<T> {
    T[] data;
    int32 idx;
    int32 limit;

    public ArrayStream(T[] data, int32 limit) {
        this.data = data;
        this.idx = 0;
        this.limit = limit;
    }

    public #Optional<T> next() {
        if (this.idx >= this.limit) {
            return heap Optional<T>(false, null);
        }
        T v = this.data[this.idx];
        this.idx = this.idx + 1;
        return heap Optional<T>(true, v);
    }

    /**
     * Override count() to dispatch to the parallel driver when
     * the .parallel() flag is set. Other Stream subclasses inherit
     * Stream<T>.count() and stay sequential — wrapper-aware
     * splitting (FilterStream over a Splittable source) is P2 work.
     */
    /**
     * Count terminal. Sequential by default; under `.parallel()` it
     * computes a fast-path result without per-element work — an
     * ArrayStream's remaining-element count is just `limit - idx`,
     * known at trySplit time. No fork/join is needed for count
     * specifically; the parallel path simply takes the O(1) length.
     *
     * Per-element terminals (reduce, anyMatch, etc.) that need actual
     * work distribution land in P2 once the
     * templated-interface-dispatch-under-method-template issue is
     * resolved in the compiler (see StreamParallelism.Examples.md §
     * 8 Migration sweep — known compiler issue: calling .next() on a
     * `Splittable<T>` parameter inside a method-templated static
     * dispatches to the abstract base instead of the implementer).
     */
    public int32 count() {
        if (this.isParallel) {
            // O(1) fast path: count = remaining slots.
            return this.limit - this.idx;
        }
        int32 n = 0;
        Optional<T> o = this.next();
        while (o.isPresent()) {
            n = n + 1;
            o = this.next();
        }
        return n;
    }

    /**
     * Halve the remaining index range. Returns a fresh ArrayStream
     * covering [mid, limit); this stream's limit becomes mid. The
     * underlying data buffer is shared (no copy) — ownership of
     * elements stays with whoever owns the buffer; the two
     * ArrayStreams just present disjoint index ranges.
     *
     * Returns null if there are fewer than 2 remaining elements
     * (can't split a single element).
     */
    public #Stream<T> trySplit() {
        int32 remaining = this.limit - this.idx;
        if (remaining < 2) {
            return null;
        }
        int32 mid = this.idx + (remaining / 2);
        // The share covers [mid, limit). Construct a fresh
        // ArrayStream pointing at the same data but starting at mid.
        ArrayStream<T> share = heap ArrayStream<T>(this.data, this.limit);
        share.idx = mid;
        // Shrink this stream to [idx, mid).
        this.limit = mid;
        return share;
    }

    public int64 estimateSize() {
        return (int64) (this.limit - this.idx);
    }

    public int64 splittableSize() {
        return this.estimateSize();
    }

    public #Stream<?> trySplitRoot() {
        // Returns Stream<T>; assignable to Stream<?> at the upcast site.
        // The parallel chain walker (Step 5b — template wildcards) typed
        // the cursor `Stream<?>` to step past type-changing wrappers.
        return this.trySplit();
    }
}
