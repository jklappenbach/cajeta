package cajeta.lang.stream;

/**
 * Intermediate combinator: wraps another `Stream` and yields only those
 * elements for which `pred` returns true. Lazy — the predicate is
 * invoked on each pull, not eagerly over the whole source.
 *
 * You rarely name `FilterStream` directly; it is produced by
 * ``Stream`.filter(pred)` and consumed through the usual `Stream`
 * protocol, with each `next()` returning an `Optional`.
 *
 * ```cajeta
 * #Stream<int> evens = source.filter((int n) -> n % 2 == 0);
 * Optional<int> first = evens.next();   // first matching element, or empty
 * ```
 *
 * Empty inner stream short-circuits; otherwise `next()` loops pulling
 * from the source until either a matching element is found or the
 * source exhausts.
 */
public final class FilterStream<T> extends Stream<T> {
    Stream<T> source;
    (T) -> boolean pred;

    /**
     * Takes ownership of `source` and retains `pred`. Prefer the
     * ``Stream`.filter(pred)` factory over calling this directly.
     *
     * ```cajeta
     * #Stream<string> nonEmpty =
     *     heap FilterStream<string>(#source, (string s) -> s.length() > 0);
     * ```
     */
    public FilterStream(#Stream<T> source, (T) -> boolean pred) {
        this.source = source;
        this.pred = pred;
    }

    /**
     * Pulls from the source until `pred` accepts an element, returning it
     * wrapped in a present `Optional`, or an empty `Optional` once the
     * source is exhausted.
     */
    public Optional<T> next() {
        Optional<T> o = this.source.next();
        while (o.isPresent()) {
            T v = o.get();
            if (this.pred(v)) {
                return stack Optional<T>(true, #v);
            }
            o = this.source.next();
        }
        return o;
    }

    @Inline
    public Stream<?> unwrap() {
        return this.source;
    }

    /**
     * Recursive chain re-wrap: rebuild source-chain over newRoot,
     * then wrap the result in a fresh FilterStream<T>(_, pred).
     * Inlined to avoid an intermediate `Stream<T> innerWrapped`
     * local — the local's drop would fire at this scope's exit and
     * free the inner stream the just-constructed FilterStream needs.
     */
    public #Stream<T> cloneChainOver(#Stream<?> newRoot) {
        return heap FilterStream<T>(this.source.cloneChainOver(#newRoot), this.pred);
    }
}
