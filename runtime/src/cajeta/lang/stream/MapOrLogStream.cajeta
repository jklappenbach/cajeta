package cajeta.lang.stream;

import cajeta.error.Exception;
import cajeta.error.RecoverableException;

/**
 * Intermediate recovery combinator: wraps another Stream<T> and
 * applies `fn: (T) -> R` to each element, yielding a Stream<R>.
 * Elements whose `fn` invocation throws `RecoverableException` are
 * passed to the user-supplied `logger: (T, Exception) -> void` and
 * then **dropped** — the output stream is shorter than the input.
 *
 * Logger receives both the offending element and the caught
 * exception so downstream tooling can attribute failures to the
 * source value. `UnrecoverableException` is NOT caught.
 *
 * Stdlib doesn't ship a canonical `Logger` type yet, so this
 * combinator takes a function-shaped callback. A typical use
 * funnels into a println / stderr writer:
 *
 *   xs.stream().mapOrLog(
 *       (x) -> risky(x),
 *       (x, e) -> println("warn[" + x + "]: " + e.message))
 *     ...
 */
public class MapOrLogStream<T, R> extends Stream<R> {
    Stream<T> source;
    (T) -> #R fn;
    (T, Exception) -> void logger;

    public MapOrLogStream(#Stream<T> source, (T) -> #R fn, (T, Exception) -> void logger) {
        this.source = source;
        this.fn = fn;
        this.logger = logger;
    }

    public Optional<R> next() {
        while (true) {
            Optional<T> o = this.source.next();
            if (o.isEmpty()) {
                return stack Optional<R>(false, null);
            }
            T elem = o.get();
            try {
                R mapped = this.fn(elem);
                return stack Optional<R>(true, #mapped);
            } catch (RecoverableException e) {
                this.logger(elem, e);
                // drop, pull next
            }
        }
        return stack Optional<R>(false, null);
    }

    /** Type-changing wrapper unwind — see MapStream. (Step 5b.) */
    public Stream<?> unwrap() {
        return this.source;
    }

    public #Stream<R> cloneChainOver(#Stream<?> newRoot) {
        return heap MapOrLogStream<T, R>(this.source.cloneChainOver(#newRoot), this.fn, this.logger);
    }
}
