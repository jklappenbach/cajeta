package cajeta.lang.stream;

/**
 * Intermediate combinator: wraps another Stream<T> and applies
 * `fn: (T) -> R` to each element, yielding a Stream<R>. The element
 * type may change — exercises template multi-arg substitution
 * (MapStream<T,R> extends Stream<R>, not Stream<T>).
 *
 * Lazy — fn is invoked on each pull, not eagerly. Empty inner stream
 * passes through.
 */
public class MapStream<T, R> extends Stream<R> {
    Stream<T> source;
    (T) -> R fn;

    public MapStream(Stream<T> source, (T) -> R fn) {
        this.source = source;
        this.fn = fn;
    }

    public #Optional<R> next() {
        Optional<T> o = this.source.next();
        if (o.isEmpty()) {
            return heap Optional<R>(false, null);
        }
        R mapped = this.fn(o.get());
        return heap Optional<R>(true, mapped);
    }

    /**
     * Type-changing wrapper unwind. Exposes the inner `Stream<T>` as
     * `Stream<?>` so the parallel chain walker can step past the
     * element-type change. Without this override, MapStream would
     * inherit `Stream<R>.unwrap()` (whose default returns null), the
     * walker would terminate at the MapStream, and `.map().parallel()`
     * would fall back to sequential. (Step 5b — template wildcards.)
     */
    public Stream<?> unwrap() {
        return this.source;
    }

    /**
     * Type-changing wrapper rebuild. Re-wraps a freshly-split inner
     * share with this MapStream's `fn` so each worker sees the
     * map-over-share chain. `newRoot` arrives as `Stream<?>` —
     * `this.source.cloneChainOver` is `Stream<T>.cloneChainOver`
     * (source's element type is T), whose return is `Stream<T>` and
     * naturally matches the MapStream<T,R> ctor's first arg.
     */
    public #Stream<R> cloneChainOver(#Stream<?> newRoot) {
        return heap MapStream<T, R>(this.source.cloneChainOver(newRoot), this.fn);
    }
}
