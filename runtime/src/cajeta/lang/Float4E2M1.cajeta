package cajeta.lang;

import cajeta.error.Exception;

/**
 * Boxed `float4e2m1` (OCP MX FP4, 2-bit exponent / 1-bit mantissa, 4-bit storage). Immutable, heap-allocatable,
 * reflection-introspectable; boxed value is field index 0.
 * See `plans/lang/wrapper-types-plan.md` (W4).
 *
 * ## Conversions are deferred
 *
 * The OCP-microscaling sub-byte / fp8 formats have **no LLVM IR float type** —
 * cajeta stores them as opaque `iN` bit patterns and there is no runtime
 * decode helper yet (future work). So:
 *
 *  - `value()` returns the raw opaque primitive (the stored bits).
 *  - `asInt64()` returns those **raw storage bits** widened — NOT the decoded
 *    numeric value. Useful to inspect/serialize the bit pattern.
 *  - `asFloat64()` **throws** rather than silently mis-converting the bits as
 *    an integer-to-float numeric cast (which would be meaningless).
 *  - `hash()` is over the raw bits, so two boxes with identical storage compare
 *    equal; `toString()` is inherited (deferred) for the same decode reason.
 *
 * When the fp-conversion natives land, `asFloat64()`/`toString()` get real
 * implementations and this caveat goes away.
 */
public class Float4E2M1 extends Number {
    float4e2m1 value;

    public Float4E2M1(float4e2m1 value) { this.value = value; return; }

    /** Heap box — the boxing entry point (Java-style `valueOf`). */
    public static #Float4E2M1 of(float4e2m1 value) { return heap Float4E2M1(value); }

    /** The wrapped opaque primitive (raw stored bits). */
    public float4e2m1 value() { return this.value; }

    /** Raw storage bits widened — NOT a decoded numeric value (see class doc). */
    public int64 asInt64() { return (int64) this.value; }

    /** Deferred: no fp-decode helper for this format yet (see class doc). */
    public float64 asFloat64() {
        throw heap Exception("Float4E2M1.asFloat64: fp decode for float4e2m1 is not implemented yet (no runtime conversion helper); use value()/asInt64() for the raw bits");
    }

    /** Raw-bits value hash → identical storage compares equal. */
    public int64 hash() { return (int64) this.value; }
}
