package cajeta.lang;

/**
 * Growable UTF-8 byte buffer for building a String in amortized O(N) — the
 * counterpart to Rust `String::push_str`, Java `StringBuilder`, Go
 * `strings.Builder`. Repeated `s = s + chunk` on an immutable `String` is
 * O(N^2) (every `+` copies the whole accumulator); accumulate into a
 * `StringBuilder` instead and materialize once with `toString()`.
 *
 * ```cajeta
 * StringBuilder sb = stack StringBuilder();
 * sb.append("Hello, ");
 * sb.append("world");
 * String s = sb.toString();        // "Hello, world"
 * ```
 *
 * Small-string optimization (SSO): the first 64 bytes live in an inline buffer
 * embedded in the object (`int8[64] small`), so a `stack StringBuilder()` build
 * of <= 64 bytes does ZERO heap allocation during the build — the bytes live on
 * the stack until `toString()` materializes the escaping result. A build that
 * exceeds 64 bytes spills ONCE to a doubling heap buffer (`int8[] large`) and
 * continues with byte-identical output. Exactly one of {small, large} holds the
 * live bytes, selected by `spilled`; `cap` is 64 while inline and the heap
 * size once spilled.
 *
 * The hot `append` path is `@Inline`; the rare spill/doubling is the
 * `@NoInline grow()` cold path — the same hot/cold split `ArrayList.add`/`grow`
 * use. The inline path writes bytes scalar (a <= 64-byte buffer is small); the
 * spilled path uses the 8-byte `blit` over the heap buffer.
 */
public final class StringBuilder {
    int8[64] small;   // inline SSO buffer (the build-time bytes while !spilled)
    int8[] large;     // heap spill buffer (null until the build exceeds 64 bytes)
    int32 len;        // bytes used (in whichever buffer is live)
    int32 cap;        // 64 while inline; the heap buffer's size once spilled
    boolean spilled;  // false => bytes in `small`; true => bytes in `large`

    /** Create an empty builder. No heap allocation — the inline buffer is used
     *  until/unless the build exceeds 64 bytes.
     *
     * @EntryPoint
     */
    public StringBuilder() {
        this.len = 0;
        this.cap = 64;
        this.spilled = false;
        this.large = null;
    }

    /** Number of UTF-8 bytes accumulated so far. */
    public int32 count() {
        return this.len;
    }

    /** `true` when nothing has been appended yet. */
    public boolean isEmpty() {
        return this.len == 0;
    }

    /**
     * Append the UTF-8 bytes of `s`. Amortized O(len(s)); the buffer spills /
     * doubles (out-of-line in `grow`) only when it would overflow.
     */
    @Inline
    public void append(String s) {
        int32 add = s.byteLength;
        if (add == 0) {
            return;
        }
        if (this.len + add > this.cap) {
            this.grow(this.len + add);
        }
        if (this.spilled) {
            StringBuilder.blit(this.large, (int64) this.len, s.bytes, 0, (int64) add);
        } else {
            int8[] src = s.bytes;
            int32 base = this.len;
            int32 i = 0;
            while (i < add) {
                this.small[base + i] = src[i];
                i = i + 1;
            }
        }
        this.len = this.len + add;
    }

    /**
     * Append `len` bytes from `src` starting at `off`. The bulk primitive behind
     * segment copies (e.g. `String.replace` emitting the text between matches);
     * amortized O(len), spilling/doubling out-of-line in `grow`.
     */
    @Inline
    public void appendBytes(int8[] src, int32 off, int32 len) {
        if (len <= 0) {
            return;
        }
        if (this.len + len > this.cap) {
            this.grow(this.len + len);
        }
        if (this.spilled) {
            StringBuilder.blit(this.large, (int64) this.len, src, (int64) off, (int64) len);
        } else {
            int32 base = this.len;
            int32 i = 0;
            while (i < len) {
                this.small[base + i] = src[off + i];
                i = i + 1;
            }
        }
        this.len = this.len + len;
    }

    // Copy `len` bytes src[s..] -> dst[d..], 8 bytes per store (the 8-byte chunk
    // window never exceeds `len`, so neither buffer is overrun) + scalar tail.
    // Used only on the heap buffer (`large`); the inline buffer is written
    // scalar in append/appendBytes (it can't decay to an int8[] argument).
    @Inline
    private static void blit(int8[] dst, int64 d, int8[] src, int64 s, int64 len) {
        int64 k = 0;
        while (k + 8 <= len) {
            Cajeta.storeU64(dst, d + k, Cajeta.loadU64(src, s + k));
            k = k + 8;
        }
        while (k < len) {
            dst[d + k] = src[s + k];
            k = k + 1;
        }
    }

    // Cold, out-of-line: ensure room for at least `need` bytes. The first
    // overflow spills the inline buffer to a fresh heap buffer (one-way,
    // copying the live bytes over); later overflows double the heap buffer.
    // Split out of `append` so the common in-capacity case stays branch-cold
    // and `append` stays inlinable.
    @NoInline
    private void grow(int32 need) {
        // First overflow (inline) starts the heap buffer at 128 (double the
        // 64-byte inline cap); a later overflow doubles the current heap cap.
        int32 newCap = this.spilled ? this.cap * 2 : 128;
        while (newCap < need) {
            newCap = newCap * 2;
        }
        // Uninitialized: grow copies the live [0,len) bytes over and later
        // appends fill the rest; nothing reads the tail before it is written.
        int8[] grown = Cajeta.allocBytes((int64) newCap);
        // Copy the live bytes over from whichever buffer currently holds them.
        // The heap buffer (`large`) goes 8 bytes at a time via blit; the inline
        // buffer can't decay to an int8[] argument, so it stays scalar (<= 64 B).
        if (this.spilled) {
            StringBuilder.blit(grown, 0, this.large, 0, (int64) this.len);
        } else {
            int32 i = 0;
            while (i < this.len) {
                grown[i] = this.small[i];
                i = i + 1;
            }
        }
        // `#grown` transfers ownership into the field — same pattern as
        // ArrayList.grow / HashMap.rehash; without it the local's scope-exit
        // drop would free the buffer we just installed. One-way: once spilled,
        // the build stays on the heap buffer.
        this.large = #grown;
        this.cap = newCap;
        this.spilled = true;
    }

    /**
     * Materialize the accumulated bytes into a fresh owned `String` (one final
     * copy of exactly `count()` bytes from the live buffer). The builder is left
     * usable for more appends.
     */
    public #String toString() {
        // Uninitialized: the copy below fills all `len` bytes before any read.
        int8[] out = Cajeta.allocBytes((int64) this.len);
        if (this.spilled) {
            StringBuilder.blit(out, 0, this.large, 0, (int64) this.len);
        } else {
            int32 i = 0;
            while (i < this.len) {
                out[i] = this.small[i];
                i = i + 1;
            }
        }
        return heap String(#out, this.len);
    }
}
