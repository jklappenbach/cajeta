package cajeta.lang;

/**
 * Boxed `bfloat16` (brain-float: float32's 8-bit exponent, 7 mantissa bits /
 * LLVM `bfloat`). Immutable, heap-allocatable, reflection-introspectable; boxed
 * value is field index 0. Distinct from `Float16` (binary16) — same width, wider
 * exponent. See `plans/lang/wrapper-types-plan.md` (W3).
 *
 * Equality is **bitwise**, realized by widening to `float64` and hashing those
 * bits: bfloat16 → double is lossless and injective over finite values, and the
 * float64 native canonicalizes `-0.0` to `+0.0`. `asFloat64()` / `asInt64()`
 * use the ordinary fp casts.
 */
public class BFloat16 extends Number {
    bfloat16 value;

    @Native("__cajeta_hash_float64")
    private static int64 hashF64(float64 value);

    public BFloat16(bfloat16 value) { this.value = value; return; }

    /** Heap box — the boxing entry point (Java-style `valueOf`). */
    public static #BFloat16 of(bfloat16 value) { return heap BFloat16(value); }

    /** The wrapped primitive. */
    public bfloat16 value() { return this.value; }

    public int64   asInt64()   { return (int64) this.value; }
    public float64 asFloat64() { return (float64) this.value; }

    /** Bitwise value hash (via lossless float64 widening). */
    public int64 hash() { return hashF64((float64) this.value); }

    public #String toString() { return this.formatFloat(this.asFloat64()); }
}
