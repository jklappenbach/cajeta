package cajeta.lang;

/**
 * Boxed `int32`. An immutable, heap-allocatable, reflection-introspectable
 * wrapper so a 32-bit signed integer can flow through `Object`-typed slots
 * (generic containers, reflective `invokeBoxed`).
 *
 * Value equality is carried by the `hash()` override: `Object.operator==` is
 * `a.hash() == b.hash()`, so `Int32.of(5) == Int32.of(5)` and
 * `Int32.of(5) != Int32.of(6)` without an explicit `operator==`.
 *
 * The boxed value is field index 0 (see `Number`), so
 * `Class.of(box).getInt32(box, 0)` reads it. See
 * `plans/lang/wrapper-types-plan.md`.
 */
public final class Int32 extends Number {
    int32 value;

    public Int32(int32 value) { this.value = value; return; }

    /** Heap box — the boxing entry point (Java-style `valueOf`). */
    public static #Int32 of(int32 value) { return heap Int32(value); }

    /** The wrapped primitive. */
    @Inline
    public int32 value() { return this.value; }

    @Inline
    public int64   asInt64()   { return (int64) this.value; }
    @Inline
    public float64 asFloat64() { return (float64) this.value; }

    /** Value-based hash → equal values compare equal via Object.operator==. */
    @Inline
    public int64 hash() { return (int64) this.value; }

    public #String toString() { return this.formatSigned(this.asInt64()); }
}
