package cajeta.lang;

/**
 * Marker for **numeric** types — the root of the numeric template-bound
 * hierarchy (`numeric-bounds-spec.md`). Used as a template-parameter or wildcard
 * bound (`<T extends Numeric>`, `Tensor<? extends Numeric>`).
 *
 * Conformance is **dual**: the primitive numeric types (`int8..int128`,
 * `uint8..uint128`, `float16/32/64/128`, `bfloat16`, the `float8`/`float6`/
 * `float4` formats) satisfy it **intrinsically** (the compiler's type-flag
 * lattice — no `implements` needed and no boxing), and a class may satisfy it
 * **nominally** by declaring `implements Numeric`. `boolean` is NOT numeric.
 *
 * Sub-markers: {@link Floating}, {@link Integral}, {@link Complex}.
 */
public interface Numeric {
}
