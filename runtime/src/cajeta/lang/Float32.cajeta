package cajeta.lang;

/**
 * Boxed `float32`. Immutable, heap-allocatable, reflection-introspectable
 * wrapper for a 32-bit IEEE-754 float. Boxed value is field index 0.
 *
 * Equality is **bitwise** (via the `hash()` override over the raw bits), so
 * `Float32.of(1.5f) == Float32.of(1.5f)` but `!= Float32.of(1.2f)` — a numeric
 * truncation hash would falsely equate distinct values. `-0.0` canonicalizes to
 * `+0.0` and distinct NaN bit patterns hash distinctly (the native's policy).
 * See `plans/lang/wrapper-types-plan.md`.
 */
public final class Float32 extends Number {
    float32 value;

    // Bit-reinterpreting hash (memcpy to bits, +0/-0 canonicalized, seed-mixed)
    // — shared with the compiler's synthesized structural hashing.
    @Native("__cajeta_hash_float32")
    private static int64 hashBits(float32 value);

    public Float32(float32 value) { this.value = value; return; }

    /** Heap box — the boxing entry point (Java-style `valueOf`). */
    public static #Float32 of(float32 value) { return heap Float32(value); }

    /**
     * The raw IEEE-754 bits of `value`, **reinterpreted, not converted** —
     * `toBits(0.5f)` is 0x3F000000, where `(int32) 0.5f` is 0. The float32
     * twin of `Float64.toBits`; see there for why binary formats need it.
     */
    @Native("__cajeta_f32_to_bits")
    public static int32 toBits(float32 value);

    /** Rebuild a float32 from raw IEEE-754 bits — the inverse of `toBits`. */
    @Native("__cajeta_f32_from_bits")
    public static float32 fromBits(int32 bits);

    /** The wrapped primitive. */
    @Inline
    public float32 value() { return this.value; }

    @Inline
    public int64   asInt64()   { return (int64) this.value; }
    @Inline
    public float64 asFloat64() { return (float64) this.value; }

    /** Bitwise value hash → equal values compare equal via Object.operator==. */
    public int64 hash() { return hashBits(this.value); }

    public #String toString() { return this.formatFloat(this.asFloat64()); }
}
