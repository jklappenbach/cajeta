package cajeta.lang;

/**
 * Text encoding identifiers for String byte-interchange.
 *
 * Used by String.fromBytes(byte[], int32, Encoding, ...) /
 * String.getBytes(Encoding, ...) and any other code that needs to
 * cross the bytes ↔ text boundary with explicit encoding choice.
 * No platform-default fallback (Java's FileReader trap) — every
 * conversion declares its encoding.
 *
 * v1 covers UTF + ASCII + Western (Latin-1, Windows-1252) + the
 * four most common CJK encodings. Arabic / Hebrew / additional ISO
 * code pages land in v2 if anybody asks. The cryptographic /
 * compression family is not part of Encoding — that's
 * cajeta.codec.* territory.
 *
 * See cajeta-docs/stdlib/lang/String.md § Encoding interchange.
 */
public enum Encoding {
    UTF_8,
    UTF_16_LE,
    UTF_16_BE,
    UTF_32_LE,
    UTF_32_BE,
    ASCII,
    LATIN_1,          // ISO-8859-1
    WINDOWS_1252,     // Western European, Windows codepage 1252
    GB18030,          // CJK Chinese (simplified, full Unicode range)
    SHIFT_JIS,        // CJK Japanese
    EUC_KR,           // CJK Korean
    BIG_5             // CJK Chinese (traditional)
}
