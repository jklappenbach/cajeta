package cajeta.error;

import cajeta.lang.String;

/**
 * Thrown by a **capture cast** `(Foo<int32>) w` when the runtime reified
 * instantiation of `w` does not match the target instantiation
 * (reified-capture-spec.md §3). cajeta monomorphizes, so a value widened to a
 * wildcard (`Foo<?>`) is still its concrete instantiation at runtime; the
 * unguarded capture cast checks that identity and throws this rather than
 * handing back a mis-typed pointer (the alternative is undefined behaviour).
 *
 * Recoverable: a failed dynamic capture is a normal, caller-handleable
 * condition at an interop boundary (the caller can fall back), mirroring
 * {@link cajeta.math.BroadcastException}. The guarded form
 * (`if (w instanceof Foo<int32> f) { ... }`) and the pattern-binding form avoid
 * the throw entirely when the caller wants to branch instead.
 */
public class ClassCastException extends RecoverableException {
    public ClassCastException(#String message) {
        this.message = message;
        this.cause = 0;
    }
}
