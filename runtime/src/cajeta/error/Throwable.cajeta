package cajeta.error;

/**
 * Root of the cajeta exception hierarchy — every throwable type derives
 * from `Throwable`, carrying a human-readable `message`. Subtypes split the
 * hierarchy into `Exception` (which adds a `cause` chain) and the
 * recoverable/unrecoverable variants `RecoverableException` and
 * `UnrecoverableException`.
 *
 * ```cajeta
 * heap Throwable err = Throwable("disk is full");
 * String why = err.message;
 * ```
 *
 * ## Implementation note
 *
 * Constructors don't call `super(...)` — `super` is still
 * UnsupportedExpression — so inherited fields are written directly via
 * `this.message`, and each subclass repeats the field assignment.
 * See docs/specification/error/ErrorModel.md.
 */
public class Throwable {
    public String message;

    /**
     * Wrap a message into a throwable.
     *
     * ```cajeta
     * heap Throwable err = Throwable("unexpected end of input");
     * ```
     */
    public Throwable(#String message) {
        this.message = message;
    }

    /**
     * The human-readable message this throwable was constructed with.
     */
    public String getMessage() {
        return this.message;
    }

    @Native("__cajeta_get_trace")
    private static int32 getTraceNative(Object throwable, int64[] outAddrs, int32 max);
    @Native("__cajeta_print_trace")
    private static void printTraceNative(Object throwable, int32 fd);
    @Native("__cajeta_type_name_len")    private static int32 typeNameLen(Object o);
    @Native("__cajeta_type_name_into")   private static void  typeNameInto(Object o, int8[] out);
    @Native("__cajeta_json_escape_len")  private static int32 jsonEscapeLen(String s);
    @Native("__cajeta_json_escape_into") private static void  jsonEscapeInto(String s, int8[] out);

    /**
     * The stable diagnostic `code`. Defaults to this throwable's canonical type
     * name (e.g. `cajeta.error.Exception`); Unit 2 lets `@DiagnosticCode` override.
     */
    public #String code() {
        int32 len = typeNameLen(this);
        int8[] out = heap int8[len];
        typeNameInto(this, out);
        return heap String(#out, len);
    }

    /**
     * The underlying cause, or `0` (none). `Exception` overrides this to expose
     * its `cause` field; the bare hierarchy root has no cause.
     */
    public Throwable getCause() {
        return null;
    }

    /** JSON-string-escape `s` (shared escaping with the compiler emitter). */
    private static #String jsonEscape(String s) {
        int32 len = jsonEscapeLen(s);
        int8[] out = heap int8[len];
        jsonEscapeInto(s, out);
        return heap String(#out, len);
    }

    /**
     * Render this throwable as a single NDJSON diagnostic object — a superset of
     * the compiler's `--diag-format=json` shape (`severity`/`code`/`message`)
     * plus `causeChain` (outer→inner) and `frames`. Built lazily, on call.
     */
    public #String toJson() {
        String m = this.message;
        String j = "{\"severity\":\"error\",\"code\":\"" + this.code() + "\"";
        j = j + ",\"message\":\"" + jsonEscape(m) + "\"";
        Throwable c = this.getCause();
        if (c != null) {
            j = j + ",\"causeChain\":[";
            boolean first = true;
            while (c != null) {
                if (!first) { j = j + ","; }
                String cm = c.message;
                j = j + "{\"code\":\"" + c.code() + "\",\"message\":\"" + jsonEscape(cm) + "\"}";
                first = false;
                c = c.getCause();
            }
            j = j + "]";
        }
        StackFrame[] frames = this.getStackTrace();
        int64 fn = frames.count();
        j = j + ",\"frames\":[";
        int64 i = 0;
        while (i < fn) {
            if (i > 0) { j = j + ","; }
            StackFrame f = frames[i];
            int64 addr = f.nativeAddress;
            j = j + "{\"nativeAddress\":" + addr + "}";
            i = i + 1;
        }
        j = j + "]}";
        return j;
    }

    /**
     * The captured stack frames, throw-site first. Empty when capture was off
     * (`--stack-trace-capture=off`, the Release default) or on a context that
     * doesn't capture (Windows, in-fiber throws). Frames currently carry the
     * native return address only; symbol + `file:line` are follow-ups (§4).
     */
    public StackFrame[] getStackTrace() {
        int64[] addrs = heap int64[64];
        int32 n = getTraceNative(this, addrs, 64);
        StackFrame[] frames = heap StackFrame[n];
        int32 i = 0;
        while (i < n) {
            frames[i] = heap StackFrame(addrs[i]);
            i = i + 1;
        }
        return frames;
    }

    /**
     * Print this throwable's stack trace to stderr. A no-op body of frames when
     * no trace was captured (message still surfaces via the uncaught handler).
     */
    public void printStackTrace() {
        printTraceNative(this, 2);
    }
}
