package cajeta.error;

/**
 * Fatal subtype of `Exception` for conditions a program cannot sanely
 * continue past: invariant violations, programmer error, out-of-memory.
 *
 * Unlike `RecoverableException`, an `UnrecoverableException` is *not*
 * meant to be caught and worked around. Codegen registers this class's
 * vtable with the runtime through a global constructor
 * (`__cajeta_set_unrecoverable_vtable`); when a thrown instance's vtable
 * chain reaches that address the throw bypasses user `catch` handlers and
 * propagates straight to abort. See `docs/specification/error/ErrorModel.md`.
 *
 * Throw one when state has gone unrecoverably wrong:
 *
 * ```cajeta
 * if (slot == 0) {
 *     throw new #UnrecoverableException("allocator returned null slot");
 * }
 * ```
 */
public class UnrecoverableException extends Exception {
    /**
     * Build a fatal exception carrying `message`. `message` is a heap
     * `#String` whose ownership transfers into the exception; `cause` is
     * left unset (`0`).
     *
     * ```cajeta
     * throw new #UnrecoverableException("unreachable branch taken");
     * ```
     *
     * @EntryPoint
     */
    public UnrecoverableException(#String message) {
        this.message = message;
        this.cause = 0;
    }
}
