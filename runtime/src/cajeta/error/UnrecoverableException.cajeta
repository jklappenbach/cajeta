package cajeta.error;

// Unrecoverable subtype: invariant violation, programmer error, OOM.
// The runtime publishes UnrecoverableException's vtable as a global
// marker (__cajeta_unrecoverable_vtable_marker); thrown instances
// whose vtable chain reaches this marker bypass user catch handlers
// and propagate to abort. See cajeta-docs/ErrorModel.md.
public class UnrecoverableException extends Exception {
    public UnrecoverableException(String message) {
        this.message = message;
        this.cause = 0;
    }
}
