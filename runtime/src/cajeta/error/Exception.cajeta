package cajeta.error;

import cajeta.lang.Optional;

/**
 * General-purpose thrown error and the base of the catchable exception
 * hierarchy. Extends `Throwable` (the hierarchy root, which carries the
 * `message` field) and is itself the parent of `RecoverableException` and
 * `UnrecoverableException` — the runtime walks that vtable chain on a throw
 * to decide whether it propagates to abort.
 *
 * Beyond the inherited `message`, `Exception` adds a `cause` link so a wrapped
 * lower-level failure can be carried along; it is `0` (none) when the throw has
 * no underlying cause.
 *
 * ## Usage
 *
 * ```cajeta
 * throw heap Exception("config file missing");
 * ```
 *
 * Prefer the more specific `RecoverableException` for errors a caller can
 * reasonably handle and proceed past, and `UnrecoverableException` for fatal
 * conditions.
 */
public class Exception extends Throwable {
    public Throwable cause;

    /**
     * Construct an exception carrying `message`; `cause` is initialized to none
     * (`0`).
     *
     * ```cajeta
     * throw heap Exception("invalid argument");
     * ```
     *
     * @EntryPoint
     */
    public Exception(#String message) {
        this.message = message;
        this.cause = null;
    }

    /**
     * Construct an exception wrapping a lower-level `cause`; ownership of `cause`
     * transfers into this exception's `cause` chain.
     *
     * ```cajeta
     * throw heap Exception("config load failed", heap Exception("file missing"));
     * ```
     */
    public Exception(#String message, #Throwable cause) {
        this.message = message;
        this.cause = #cause;
    }

    /**
     * The underlying cause carried with this exception; empty when none.
     * Wraps the borrowed field (no transfer) — the exception keeps ownership of
     * its cause chain. `Optional<Throwable>` (no `#` on the type argument) is a
     * borrow-mode instantiation, so its drop leaves `cause` alone; only
     * `Optional<#Throwable>` would take ownership. See
     * `specs/optional-borrow-ownership-spec.md`.
     */
    public Optional<Throwable> getCause() {
        if (this.cause == null) {
            return stack Optional<Throwable>(false, #null);
        }
        return stack Optional<Throwable>(true, this.cause);
    }
}
