package cajeta.nucleo.nn;

import cajeta.math.Tensor;

/**
 * Parameter — an **optimizable** `float32` tensor owned by a {@link Module} (plan
 * resolution N4). The newtype is the whole point: "this tensor trains" is
 * type-visible, so parameter collection is a typed field walk
 * (`instanceof Parameter`), and a plain `Tensor<float32>` field on the same
 * module is a **buffer** (enumerated by `Module.buffers()`, never updated by
 * an optimizer). There is no per-tensor `requires_grad` flag — WHICH tensors
 * train is decided by which collection the optimizer is constructed over
 * (spec §3.7).
 *
 * The parameter OWNS its tensor; an optimizer borrows the parameter and
 * updates the tensor's values in place through {@link #get}. Nothing here
 * carries gradient state — grads are explicit values returned by the
 * `GradAll` transform and consumed by `step` (spec §4).
 *
 * ```cajeta
 * Parameter w = heap Parameter(Tensor.zeros<float32>(shape));
 * w.get().set1(0, 0.5f);            // in-place update through the borrow
 * ```
 *
 * v1 is float32-only (the nn core is non-generic): `instanceof`/casts with an
 * IDENTIFIER template argument mis-parse inside templates, and a concrete
 * class extending an instantiated template base does not resolve inherited
 * members — both recorded compiler gaps; `Parameter<T>` returns when they
 * close (nucleo-nn-optim plan 8.2.2).
 */
public class Parameter {
    Tensor<float32> value;

    /** Wrap an owned tensor as an optimizable parameter (takes ownership). */
    public Parameter(#Tensor<float32> value) {
        this.value #= value;
    }

    /** The underlying tensor, as a borrow — read it, or update it in place. */
    public Tensor<float32> get() {
        return this.value;
    }
}
