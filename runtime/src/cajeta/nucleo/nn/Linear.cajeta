package cajeta.nucleo.nn;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;

/**
 * Linear — the fully-connected layer: `y = x · W + b` with `W : [in, out]`
 * and `b : [out]` (spec §2). Both are {@link Parameter}s (declared order:
 * `weight` then `bias` — the order {@link Module#parameters} reports and a
 * `GradAll` functional step's leading args follow).
 *
 * Initialization is the standard scaled uniform `U(-1/√in, +1/√in)` for the
 * weight and ZEROS for the bias, drawn from an EXPLICIT seeded
 * {@link Generator} (Philox) — reproducible by construction, no global RNG
 * (spec §4). Same seed, same weights.
 *
 * ```cajeta
 * Linear fc = heap Linear(784, 256, 42);
 * Tensor<float32> y = fc.forward(x);       // x: [batch, 784] -> y: [batch, 256]
 * ```
 */
public class Linear extends Module {
    Parameter weight;
    Parameter bias;

    /** @EntryPoint */
    public Linear(int64 inFeatures, int64 outFeatures, uint64 seed) {
        Generator g = heap Generator(seed);
        float32 bound = 1.0f / Math.sqrt((float32) inFeatures);
        int64[] ws = heap int64[2];
        ws[0] = inFeatures;
        ws[1] = outFeatures;
        // Construct the parameter over an owned zeros tensor, then fill it
        // THROUGH the borrow from the 1-D draw (row-major). Rank-correct
        // accessors: set2 on the [in, out] weight (set1/get1 index by
        // stride[0] — 1-D ONLY); get1 on the 1-D draw. Not `reshape` — on a
        // contiguous base that is a storage-sharing VIEW whose base would
        // drop at ctor exit.
        this.weight = heap Parameter(Tensor.zeros<float32>(ws));
        Tensor<float32> u = g.uniform(inFeatures * outFeatures);
        Tensor<float32> w = this.weight.get();
        int64 r = 0;
        while (r < inFeatures) {
            int64 c = 0;
            while (c < outFeatures) {
                w.set2(r, c, (u.get1(r * outFeatures + c) - 0.5f) * 2.0f * bound);
                c = c + 1;
            }
            r = r + 1;
        }
        int64[] bs = heap int64[1];
        bs[0] = outFeatures;
        this.bias = heap Parameter(Tensor.zeros<float32>(bs));
    }

    /** The affine map `x · W + b` — ordinary `cajeta.math` ops; the layer
     *  adds no compute of its own (spec §2.5). `x : [batch, in]`. */
    public #Tensor<float32> forward(Tensor<float32> x) {
        return Tensor.add<float32>(
            Tensor.matmul<float32>(x, this.weight.get()), this.bias.get());
    }
}
