package cajeta.nucleo.nn;

import cajeta.concurrent.FiberLocal;

/**
 * Modes — train/eval selection WITHOUT a global mutable flag (spec §8;
 * resolution N9): the mode is a `FiberLocal` binding scoped to a body, so
 * two concurrent forwards in different modes never interfere (§8.2), a
 * validation pass inside a training loop nests without save/restore (§8.3),
 * and mode-insensitive modules simply never ask (§8.4).
 *
 * The DEFAULT (no binding) is EVAL — inference-safe: dropout is identity,
 * batchnorm-style layers would read running statistics. Training is opted
 * into lexically:
 *
 * ```cajeta
 * Modes.train(() -> {
 *     GradResult<float32, Tensor<float32>[]> r = step(...);
 *     opt.step(r.grads);
 * });
 * float32 valLoss = Losses.mse(model.forward(vx), vy);   // eval by default
 * ```
 *
 * (Representation: int32 0 = eval, 1 = train — a FiberLocal over the enum
 * type is blocked on the identifier-template-arg gaps in the plan ledger.)
 */
public final class Modes {
    static FiberLocal<int32> current = heap FiberLocal<int32>();

    /** True inside a {@link #train} scope on THIS fiber; false otherwise. */
    public static boolean isTraining() {
        return Modes.current.orElse(0) != 0;
    }

    /** Run `body` in TRAIN mode (scoped to this fiber; restores on exit). */
    public static void train(() -> void body) {
        Modes.current.where(1, body);
    }

    /** Run `body` in EVAL mode — nests inside a train scope for a
     *  validation pass (§8.3). */
    public static void eval(() -> void body) {
        Modes.current.where(0, body);
    }
}
