package cajeta.nucleo.nn;

import cajeta.collection.ArrayList;
import cajeta.math.Tensor;

/**
 * Module — the composable neural-net building block (spec §2; resolutions
 * N1/N2): an ordinary base class whose subclasses declare {@link Parameter}
 * fields (owned, optimizable tensors), sub-`Module` fields (composition), and
 * plain `Tensor<float32>` fields (buffers — running statistics, lookup tables),
 * and define a `forward` method by convention (`model.forward(x)`; there is
 * ONE model abstraction — no Sequential/Functional/subclassing split).
 *
 * Parameter collection is a **reflection walk** (N1): {@link #parameters}
 * enumerates this module's typed fields via the object-receiver rtti natives
 * (`fieldCount`/`fieldIsRef`/`fieldRef`) + `instanceof`, recursing
 * depth-first into sub-modules, in DECLARED order —
 * so the order is stable run-to-run (§3.1), a field added to a module is
 * collected automatically (§3.5), and no per-module registration list exists.
 * {@link #parameterNames} yields the dotted paths (`head.weight`) in the SAME
 * order — the basis a serializer keys on (§3.4). {@link #buffers} enumerates
 * the plain tensor fields the optimizer must never touch (§3.6).
 *
 * OWNERSHIP (N3): the module owns its parameters; collections returned here
 * hold **borrows** — an optimizer constructed over them updates the tensors
 * in place and must not outlive the module.
 *
 * v1 is FLOAT32-ONLY and the class is non-generic — every parameter and
 * buffer in the tree is `float32`, matching `GradAll`'s uniform-type grads
 * contract. The generic `Module` is blocked on two recorded compiler gaps
 * (identifier-template-arg `instanceof`/cast mis-parse in templates;
 * concrete-extends-instantiated-template member resolution) — plan 8.2.2.
 */
public class Module {

    // The self-walk natives: THIS module's own field count / reference-kind
    // test / name / borrow-read, rtti derived from the receiver. Object-
    // receiver forms because (a) a multi-reference-param borrow return is
    // rejected by the checker — provenance must be `this` — and (b) member
    // resolution on a `Class<?>` wildcard receiver is unavailable to stdlib
    // code today, so the Class/Field surface can't drive this walk yet.
    @Native("__cajeta_object_field_count")
    int32 fieldCount();
    @Native("__cajeta_object_field_is_ref")
    int32 fieldIsRef(int32 index);
    @Native("__cajeta_object_field_name_len")
    int32 fieldNameLen(int32 index);
    @Native("__cajeta_object_field_name_into")
    void fieldNameInto(int32 index, int8[] out);
    @Native("__cajeta_object_field_ref")
    Object fieldRef(int32 index);

    #String fieldName(int32 index) {
        int32 len = this.fieldNameLen(index);
        int8[] out = heap int8[len];
        this.fieldNameInto(index, out);
        return heap String(#out, len);
    }

    /**
     * Every {@link Parameter} owned by this module and (transitively) by its
     * sub-modules, declared order, parent-first — the collection an optimizer
     * is constructed over. Elements are borrows (the module keeps ownership).
     */
    public #Parameter[] parameters() {
        ArrayList<Parameter> acc = heap ArrayList<Parameter>();
        this.collectParams(acc);
        int32 n = acc.count();
        Parameter[] out = heap Parameter[n];
        int32 i = 0;
        while (i < n) {
            out[i] = acc.get(i);
            i = i + 1;
        }
        return out;
    }

    /**
     * The stable dotted path of each parameter (`w0`, `head.weight`), in the
     * SAME order as {@link #parameters} — the parallel-collection v1
     * `namedParameters` surface. Returns an OWNING list (the JsonObject.keys
     * idiom): the paths are freshly built strings, moved in with `#`.
     */
    public #ArrayList<String> parameterNames() {
        ArrayList<String> acc #= heap ArrayList<String>();
        this.collectNames("", acc);
        return acc;
    }

    /**
     * Every plain `Tensor<float32>` field of this module and its sub-modules —
     * state a serializer records but an optimizer must never update (§3.6).
     * Borrows, same ordering rule as {@link #parameters}.
     */
    public #Tensor<float32>[] buffers() {
        ArrayList<Tensor<float32>> acc = heap ArrayList<Tensor<float32>>();
        this.collectBuffers(acc);
        int32 n = acc.count();
        Tensor<float32>[] out = heap Tensor<float32>[n];
        int32 i = 0;
        while (i < n) {
            out[i] = acc.get(i);
            i = i + 1;
        }
        return out;
    }

    void collectParams(ArrayList<Parameter> acc) {
        int32 n = this.fieldCount();
        int32 i = 0;
        while (i < n) {
            if (this.fieldIsRef(i) != 0) {
                Object o = this.fieldRef(i);
                if (o instanceof Parameter p) {
                    acc.add(p);
                } else if (o instanceof Module m) {
                    m.collectParams(acc);
                }
            }
            i = i + 1;
        }
    }

    void collectNames(String prefix, ArrayList<String> acc) {
        int32 n = this.fieldCount();
        int32 i = 0;
        while (i < n) {
            if (this.fieldIsRef(i) != 0) {
                Object o = this.fieldRef(i);
                if (o instanceof Parameter p) {
                    String path #= prefix + this.fieldName(i);
                    acc.add(#path);
                } else if (o instanceof Module m) {
                    m.collectNames(prefix + this.fieldName(i) + ".", acc);
                }
            }
            i = i + 1;
        }
    }

    void collectBuffers(ArrayList<Tensor<float32>> acc) {
        int32 n = this.fieldCount();
        int32 i = 0;
        while (i < n) {
            if (this.fieldIsRef(i) != 0) {
                Object o = this.fieldRef(i);
                if (o instanceof Tensor<float32> t) {
                    acc.add(t);
                } else if (o instanceof Module m) {
                    m.collectBuffers(acc);
                }
            }
            i = i + 1;
        }
    }
}
