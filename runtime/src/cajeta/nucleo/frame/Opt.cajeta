package cajeta.nucleo.frame;

import cajeta.lang.String;

/**
 * Opt — the rule-based plan rewriter (nucleo-frame U7, spec §5): applied at
 * force, between the built chain and the executor. Two rewrite families:
 *
 *  - PREDICATE PUSHDOWN (spec §5.2): a filter sinks below any neighbor it
 *    provably commutes with — `dropNulls` always (both are independent
 *    row-wise keeps, three-valued semantics included), `fillNull`/`with`
 *    only when the predicate references NONE of the columns the node
 *    (re)defines. `project` blocks: it renames and re-ordinals its output,
 *    and every reference is ordinal-bound at plan build. Filters that
 *    reach the scan leaf become scan-level predicates — rows failing them
 *    are never materialized.
 *
 *  - PROJECTION PUSHDOWN (spec §5.3): a top-down needed-column analysis.
 *    Only a `project` bounds the output (every other op preserves its
 *    input schema, so with no `project` the scan must read everything);
 *    below one, each op adds what it reads — a filter its predicate's
 *    columns, `fillNull` its target, a bare `dropNulls` every nullable
 *    column of its input, `with` swaps its computed names for their
 *    operands. The scan then reads exactly the surviving set (plus any
 *    sunk predicate's columns — those buffers ARE read), in source order.
 *    Pruned slots stay NULL placeholders in the scan's output so every
 *    ordinal bound at plan build keeps meaning; the analysis guarantees
 *    nothing above reads a pruned slot.
 *
 * The rewritten chain BORROWS every payload (predicates, selection chains)
 * from the original plan, which the owning handle keeps alive — rewriting
 * consumes nothing, so `Table.explain()` prints the optimized plan without
 * disturbing the handle and `collect()` rewrites on every force.
 */
public class Opt {

    /** Rewrite `root` (never consumed) against the scan source `src`. */
    public static #Plan rewrite(Plan root, DynFrame src) {
        int32 depth = 0;
        Plan walk = root;
        while (walk.kindOf() != 1) {
            depth = depth + 1;
            walk = walk.childOf();
        }
        if (depth == 0) {
            return Plan.scan();
        }
        // Bottom-first array of borrowed nodes: ops[0] nearest the scan.
        Plan[] ops = heap Plan[depth];
        int32 fill = depth;
        walk = root;
        while (walk.kindOf() != 1) {
            fill = fill - 1;
            ops[fill] = walk;
            walk = walk.childOf();
        }
        // Sink filters toward the scan (bubble passes to a fixpoint).
        int32 pass = 0;
        while (pass < depth) {
            int32 j = depth - 1;
            while (j > 0) {
                if (ops[j].kindOf() == 2 && ops[j - 1].kindOf() != 2
                        && Opt.commutes(ops[j].predOf(), ops[j - 1])) {
                    Plan tmp = ops[j];
                    ops[j] = ops[j - 1];
                    ops[j - 1] = tmp;
                }
                j = j - 1;
            }
            pass = pass + 1;
        }
        // Filters sitting directly on the scan become scan predicates.
        int32 nSink = 0;
        while (nSink < depth && ops[nSink].kindOf() == 2) {
            nSink = nSink + 1;
        }
        // Input schema of each remaining op (bare dropNulls needs its
        // input's nullable set; sunk filters read the source directly).
        DynFrame[] schemas = heap DynFrame[depth + 1];
        schemas[nSink] #= src.schemaOnly();
        int32 k = nSink;
        while (k < depth) {
            schemas[k + 1] #= Opt.schemaThrough(ops[k], schemas[k]);
            k = k + 1;
        }
        // Needed-column analysis, top-down over the remaining chain.
        int32 cap = src.width();
        int32 q = nSink;
        while (q < depth) {
            cap = cap + ops[q].selCount() + ops[q].keyCount()
                + ops[q].aggCount() + ops[q].sortKeyCount();
            q = q + 1;
        }
        if (cap < 1) { cap = 1; }
        String[] need = heap String[cap];
        int32 nNeed = 0;
        boolean all = true;
        int32 top = depth - 1;
        while (top >= nSink) {
            Plan node = ops[top];
            int32 kind = node.kindOf();
            if (kind == 3) {
                nNeed = 0;
                all = false;
                nNeed = Opt.addSelRefs(node.selsOf(), need, nNeed);
            }
            if (kind == 5) {
                // A group BOUNDS the output exactly like a project: keys
                // plus aggregates, nothing carried through.
                nNeed = 0;
                all = false;
                nNeed = Opt.addSelRefs(node.keysOf(), need, nNeed);
                nNeed = Opt.addAggRefs(node.aggsOf(), need, nNeed);
            }
            if (kind == 6 && !all) {
                // A sort reads its key columns; it bounds nothing, so the
                // rest of the needed set carries through unchanged.
                nNeed = Opt.addSortRefs(node.sortKeysOf(), need, nNeed);
            }
            if (kind == 8) {
                // A resample BOUNDS the output like a group: the time column
                // plus the aggregates' columns, nothing carried through.
                nNeed = 0;
                all = false;
                nNeed = Opt.addName(node.colNameOf(), need, nNeed);
                nNeed = Opt.addAggRefs(node.aggsOf(), need, nNeed);
            }
            if (kind == 7) {
                // A join draws on both inputs; the left scan below it must
                // read everything (the right branch is optimized on its
                // own). Projection pushdown does not cross the join.
                nNeed = 0;
                all = true;
            }
            if (kind == 4 && !all) {
                nNeed = Opt.removeSelOuts(node.selsOf(), need, nNeed);
                nNeed = Opt.addSelRefs(node.selsOf(), need, nNeed);
            }
            if (kind == 2 && !all) {
                nNeed = Opt.addPredRefs(node.predOf(), need, nNeed);
            }
            if (kind == 12 && !all) {
                nNeed = Opt.addName(node.colNameOf(), need, nNeed);
            }
            if (kind == 13 && !all) {
                if (node.colNameOf() != null) {
                    nNeed = Opt.addName(node.colNameOf(), need, nNeed);
                } else {
                    DynFrame isch = schemas[top];
                    int32 c = 0;
                    while (c < isch.width()) {
                        if (isch.nullableAt(c)) {
                            nNeed = Opt.addName(isch.nameAt(c), need, nNeed);
                        }
                        c = c + 1;
                    }
                }
            }
            top = top - 1;
        }
        // Build the rewritten chain: configured scan leaf, then the
        // remaining ops above it (payloads borrowed throughout).
        Plan leaf = Plan.scan();
        if (nSink > 0) {
            Pred[] preds = heap Pred[nSink];
            int32 s = 0;
            while (s < nSink) {
                // REMAPPED clones, not borrows: a predicate's column refs
                // are ordinal-bound to the schema it was BUILT against, and
                // a group (like a project) re-ordinals its output — the
                // sunk copy must address `src` by name. The clone is owned
                // by the rewritten leaf, which dies with the rewrite.
                preds[s] #= Opt.remapPred(ops[s].predOf(), src);
                s = s + 1;
            }
            leaf.__setScanPreds(#preds, nSink);
        }
        if (!all) {
            // A sunk predicate's columns are read at the scan too — count
            // them in the set so the read accounting stays honest.
            int32 s2 = 0;
            while (s2 < nSink) {
                nNeed = Opt.addPredRefs(ops[s2].predOf(), need, nNeed);
                s2 = s2 + 1;
            }
            String[] sc = heap String[src.width()];
            int32 keepN = 0;
            int32 c2 = 0;
            while (c2 < src.width()) {
                if (Opt.contains(need, nNeed, src.nameAt(c2))) {
                    sc[keepN] = src.nameAt(c2);
                    keepN = keepN + 1;
                }
                c2 = c2 + 1;
            }
            leaf.__setScanCols(#sc, keepN);
        }
        return Opt.chainFrom(ops, depth - 1, nSink, #leaf);
    }

    /** The ordinal `name` occupies in `target` — an optimizer invariant
     *  break if it is absent (the sink rules only move predicates over
     *  columns that survive by name). */
    static int32 remapOrdinal(String name, DynFrame target) {
        int32 o = target.find(name);
        if (o < 0) {
            throw heap FrameException("optimizer: pushed predicate names '"
                + name + "', absent from the scan schema "
                + target.schemaText());
        }
        return o;
    }

    /** A predicate rebound to `target`'s ordinals (a fresh owned tree). */
    static #Pred remapPred(Pred p, DynFrame target) {
        int32 k = p.kind();
        if (k == 30) {
            return Pred.and(Opt.remapPred(p.leftPredicate(), target),
                Opt.remapPred(p.rightPredicate(), target));
        }
        if (k == 31) {
            return Pred.or(Opt.remapPred(p.leftPredicate(), target),
                Opt.remapPred(p.rightPredicate(), target));
        }
        if (k == 32) {
            return Pred.negate(Opt.remapPred(p.leftPredicate(), target));
        }
        if (k == 26 || k == 27) {
            ColStr sr = p.strOperandExpr();
            return Pred.cmpStr(k,
                ColStr.colRef(Opt.remapOrdinal(sr.name(), target), sr.name()),
                p.strValue());
        }
        if (k >= 40 && k <= 45) {
            ColI64 ir = p.iOperandExpr();
            return Pred.cmpI64(k,
                ColI64.colRef(Opt.remapOrdinal(ir.name(), target), ir.name()),
                p.iValue());
        }
        return Pred.cmp(k, Opt.remapF64(p.operandExpr(), target), p.value());
    }

    /** A float64 expression rebound to `target`'s ordinals. */
    static #ColF64 remapF64(ColF64 e, DynFrame target) {
        int32 k = e.kind();
        if (k == 0) {
            return ColF64.colRef(Opt.remapOrdinal(e.name(), target), e.name());
        }
        if (k == 1) {
            return ColF64.literal(e.literalValue());
        }
        return ColF64.arith(k, Opt.remapF64(e.leftChild(), target),
            Opt.remapF64(e.rightChild(), target));
    }

    /** Wrap `below` with borrowed copies of ops[nSink..k], top-down. */
    static #Plan chainFrom(Plan[] ops, int32 k, int32 nSink, #Plan below) {
        if (k < nSink) {
            return #below;
        }
        return Plan.borrowNode(ops[k],
            Opt.chainFrom(ops, k - 1, nSink, #below));
    }

    /** The op's output schema given its input schema (schema-only). */
    static #DynFrame schemaThrough(Plan node, DynFrame in) {
        int32 k = node.kindOf();
        if (k == 3) {
            DynFrame c3 = in.schemaOnly();
            return Exec.apply(node.selsOf(), node.selCount(), #c3, false);
        }
        if (k == 4) {
            DynFrame c4 = in.schemaOnly();
            return Exec.apply(node.selsOf(), node.selCount(), #c4, true);
        }
        if (k == 5) {
            DynFrame c5 = in.schemaOnly();
            return Exec.applyGroup(node, #c5);
        }
        if (k == 7) {
            // A join's output schema was precomputed at plan build (the
            // right branch was executed there); no need to re-run it.
            return node.joinOutOf().schemaOnly();
        }
        if (k == 8) {
            DynFrame c8 = in.schemaOnly();
            return Exec.applyResample(node, #c8);
        }
        if (k == 12) {
            DynFrame c12 = in.schemaOnly();
            return Exec.applyFillNull(node, #c12);
        }
        // filter / sort / dropNulls preserve the schema
        return in.schemaOnly();
    }

    /** Is `name` a group key that passes through UNRENAMED? Only such a
     *  key means the same column above and below the group, so only such a
     *  predicate can sink past it (U8 / the deferred 7.1.3 rule). */
    static boolean isPassthroughKey(Plan node, String name) {
        Sel s = node.keysOf();
        while (s != null) {
            if (s.outNameOf().equals(name)) {
                String srcName = "";
                if (s.strRefOf() != null) {
                    srcName = s.strRefOf().name();
                } else if (s.iRefOf() != null) {
                    srcName = s.iRefOf().name();
                } else if (s.exprOf() != null && s.exprOf().kind() == 0) {
                    srcName = s.exprOf().name();
                }
                return srcName.equals(name);
            }
            s = s.nextOf();
        }
        return false;
    }

    /** Every column `p` references, appended to `need`; used both for the
     *  needed-column analysis and for the sink-legality check below. */
    static int32 addAggRefs(Agg a0, String[] need, int32 n) {
        Agg a = a0;
        int32 n2 = n;
        while (a != null) {
            n2 = Opt.addOneAggRefs(a, need, n2);
            a = a.nextOf();
        }
        return n2;
    }

    static int32 addOneAggRefs(Agg a, String[] need, int32 n) {
        int32 k = a.kind();
        if (k == 20) {
            return Opt.addOneAggRefs(a.leftAgg(), need, n);
        }
        if (k >= 10 && k <= 13) {
            int32 n2 = Opt.addOneAggRefs(a.leftAgg(), need, n);
            return Opt.addOneAggRefs(a.rightAgg(), need, n2);
        }
        if (a.strRefOf() != null) {
            return Opt.addName(a.strRefOf().name(), need, n);
        }
        if (a.iRefOf() != null) {
            return Opt.addName(a.iRefOf().name(), need, n);
        }
        return Opt.addExprRefs(a.exprOf(), need, n);
    }

    /** May the filter predicate `p` move below `node`? */
    static boolean commutes(Pred p, Plan node) {
        int32 k = node.kindOf();
        if (k == 5) {
            // Below a group, a predicate must read ONLY unrenamed keys:
            // those columns pass through untouched, so filtering before
            // grouping removes exactly the rows whose groups the filter
            // would have removed after. A predicate over an AGGREGATE has
            // no meaning below the reduction that produces it.
            String[] refs = heap String[16];
            int32 nr = Opt.addPredRefs(p, refs, 0);
            int32 i = 0;
            while (i < nr) {
                if (!Opt.isPassthroughKey(node, refs[i])) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        if (k == 6) {
            // A stable sort commutes with a filter: the survivors of a
            // sorted table are the sorted survivors, in the same order.
            return true;
        }
        if (k == 13) {
            return true;    // both independent row-wise keeps
        }
        if (k == 12) {
            return !Opt.predRefs(p, node.colNameOf());
        }
        if (k == 4) {
            Sel s = node.selsOf();
            while (s != null) {
                if (Opt.predRefs(p, s.outNameOf())) {
                    return false;
                }
                s = s.nextOf();
            }
            return true;
        }
        return false;      // project re-ordinals; everything else: unknown
    }

    /** Does `p` reference column `name` anywhere in its operand trees? */
    static boolean predRefs(Pred p, String name) {
        int32 k = p.kind();
        if (k >= 30 && k <= 32) {
            if (Opt.predRefs(p.leftPredicate(), name)) {
                return true;
            }
            if (p.rightPredicate() != null) {
                return Opt.predRefs(p.rightPredicate(), name);
            }
            return false;
        }
        if (k == 26 || k == 27) {
            return p.strOperandExpr().name().equals(name);
        }
        if (k >= 40 && k <= 45) {
            return p.iOperandExpr().name().equals(name);
        }
        return Opt.exprRefs(p.operandExpr(), name);
    }

    static boolean exprRefs(ColF64 e, String name) {
        int32 k = e.kind();
        if (k == 0) {
            return e.name().equals(name);
        }
        if (k == 1) {
            return false;
        }
        if (Opt.exprRefs(e.leftChild(), name)) {
            return true;
        }
        return Opt.exprRefs(e.rightChild(), name);
    }

    /** Add every column `p` references to `need` (dedup); new count. */
    static int32 addPredRefs(Pred p, String[] need, int32 n) {
        int32 k = p.kind();
        if (k >= 30 && k <= 32) {
            int32 n2 = Opt.addPredRefs(p.leftPredicate(), need, n);
            if (p.rightPredicate() != null) {
                n2 = Opt.addPredRefs(p.rightPredicate(), need, n2);
            }
            return n2;
        }
        if (k == 26 || k == 27) {
            return Opt.addName(p.strOperandExpr().name(), need, n);
        }
        if (k >= 40 && k <= 45) {
            return Opt.addName(p.iOperandExpr().name(), need, n);
        }
        return Opt.addExprRefs(p.operandExpr(), need, n);
    }

    static int32 addExprRefs(ColF64 e, String[] need, int32 n) {
        int32 k = e.kind();
        if (k == 0) {
            return Opt.addName(e.name(), need, n);
        }
        if (k == 1) {
            return n;
        }
        int32 n2 = Opt.addExprRefs(e.leftChild(), need, n);
        return Opt.addExprRefs(e.rightChild(), need, n2);
    }

    /** Add every column a sort key chain references. */
    static int32 addSortRefs(SortKey k0, String[] need, int32 n) {
        SortKey k = k0;
        int32 n2 = n;
        while (k != null) {
            n2 = Opt.addName(k.name(), need, n2);
            k = k.nextOf();
        }
        return n2;
    }

    /** Add every column the selection chain reads (not what it names). */
    static int32 addSelRefs(Sel s0, String[] need, int32 n) {
        Sel s = s0;
        int32 n2 = n;
        while (s != null) {
            if (s.strRefOf() != null) {
                n2 = Opt.addName(s.strRefOf().name(), need, n2);
            } else if (s.iRefOf() != null) {
                n2 = Opt.addName(s.iRefOf().name(), need, n2);
            } else if (s.exprOf() != null) {
                n2 = Opt.addExprRefs(s.exprOf(), need, n2);
            }
            s = s.nextOf();
        }
        return n2;
    }

    /** Drop the chain's OUTPUT names from `need` (a `with` provides them
     *  itself — its operands get added back by {@link #addSelRefs}). */
    static int32 removeSelOuts(Sel s0, String[] need, int32 n) {
        Sel s = s0;
        int32 n2 = n;
        while (s != null) {
            int32 i = 0;
            while (i < n2) {
                if (need[i].equals(s.outNameOf())) {
                    int32 j = i;
                    while (j < n2 - 1) {
                        need[j] = need[j + 1];
                        j = j + 1;
                    }
                    n2 = n2 - 1;
                } else {
                    i = i + 1;
                }
            }
            s = s.nextOf();
        }
        return n2;
    }

    static int32 addName(String name, String[] need, int32 n) {
        int32 i = 0;
        while (i < n) {
            if (need[i].equals(name)) {
                return n;
            }
            i = i + 1;
        }
        need[n] = name;
        return n + 1;
    }

    static boolean contains(String[] need, int32 n, String name) {
        int32 i = 0;
        while (i < n) {
            if (need[i].equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}
