package cajeta.nucleo.frame;

import cajeta.lang.String;

/**
 * Opt — the rule-based plan rewriter (nucleo-frame U7, spec §5): applied at
 * force, between the built chain and the executor. Two rewrite families:
 *
 *  - PREDICATE PUSHDOWN (spec §5.2): a filter sinks below any neighbor it
 *    provably commutes with — `dropNulls` always (both are independent
 *    row-wise keeps, three-valued semantics included), `fillNull`/`with`
 *    only when the predicate references NONE of the columns the node
 *    (re)defines. `project` blocks: it renames and re-ordinals its output,
 *    and every reference is ordinal-bound at plan build. Filters that
 *    reach the scan leaf become scan-level predicates — rows failing them
 *    are never materialized.
 *
 *  - PROJECTION PUSHDOWN (spec §5.3): a top-down needed-column analysis.
 *    Only a `project` bounds the output (every other op preserves its
 *    input schema, so with no `project` the scan must read everything);
 *    below one, each op adds what it reads — a filter its predicate's
 *    columns, `fillNull` its target, a bare `dropNulls` every nullable
 *    column of its input, `with` swaps its computed names for their
 *    operands. The scan then reads exactly the surviving set (plus any
 *    sunk predicate's columns — those buffers ARE read), in source order.
 *    Pruned slots stay NULL placeholders in the scan's output so every
 *    ordinal bound at plan build keeps meaning; the analysis guarantees
 *    nothing above reads a pruned slot.
 *
 * The rewritten chain BORROWS every payload (predicates, selection chains)
 * from the original plan, which the owning handle keeps alive — rewriting
 * consumes nothing, so `Table.explain()` prints the optimized plan without
 * disturbing the handle and `collect()` rewrites on every force.
 */
public class Opt {

    /** Rewrite `root` (never consumed) against the scan source `src`. */
    public static #Plan rewrite(Plan root, DynFrame src) {
        int32 depth = 0;
        Plan walk = root;
        while (walk.kindOf() != 1) {
            depth = depth + 1;
            walk = walk.childOf();
        }
        if (depth == 0) {
            return Plan.scan();
        }
        // Bottom-first array of borrowed nodes: ops[0] nearest the scan.
        Plan[] ops = heap Plan[depth];
        int32 fill = depth;
        walk = root;
        while (walk.kindOf() != 1) {
            fill = fill - 1;
            ops[fill] = walk;
            walk = walk.childOf();
        }
        // Sink filters toward the scan (bubble passes to a fixpoint).
        int32 pass = 0;
        while (pass < depth) {
            int32 j = depth - 1;
            while (j > 0) {
                if (ops[j].kindOf() == 2 && ops[j - 1].kindOf() != 2
                        && Opt.commutes(ops[j].predOf(), ops[j - 1])) {
                    Plan tmp = ops[j];
                    ops[j] = ops[j - 1];
                    ops[j - 1] = tmp;
                }
                j = j - 1;
            }
            pass = pass + 1;
        }
        // Filters sitting directly on the scan become scan predicates.
        int32 nSink = 0;
        while (nSink < depth && ops[nSink].kindOf() == 2) {
            nSink = nSink + 1;
        }
        // Input schema of each remaining op (bare dropNulls needs its
        // input's nullable set; sunk filters read the source directly).
        DynFrame[] schemas = heap DynFrame[depth + 1];
        schemas[nSink] #= src.schemaOnly();
        int32 k = nSink;
        while (k < depth) {
            schemas[k + 1] #= Opt.schemaThrough(ops[k], schemas[k]);
            k = k + 1;
        }
        // Needed-column analysis, top-down over the remaining chain.
        int32 cap = src.width();
        int32 q = nSink;
        while (q < depth) {
            cap = cap + ops[q].selCount();
            q = q + 1;
        }
        if (cap < 1) { cap = 1; }
        String[] need = heap String[cap];
        int32 nNeed = 0;
        boolean all = true;
        int32 top = depth - 1;
        while (top >= nSink) {
            Plan node = ops[top];
            int32 kind = node.kindOf();
            if (kind == 3) {
                nNeed = 0;
                all = false;
                nNeed = Opt.addSelRefs(node.selsOf(), need, nNeed);
            }
            if (kind == 4 && !all) {
                nNeed = Opt.removeSelOuts(node.selsOf(), need, nNeed);
                nNeed = Opt.addSelRefs(node.selsOf(), need, nNeed);
            }
            if (kind == 2 && !all) {
                nNeed = Opt.addPredRefs(node.predOf(), need, nNeed);
            }
            if (kind == 12 && !all) {
                nNeed = Opt.addName(node.colNameOf(), need, nNeed);
            }
            if (kind == 13 && !all) {
                if (node.colNameOf() != null) {
                    nNeed = Opt.addName(node.colNameOf(), need, nNeed);
                } else {
                    DynFrame isch = schemas[top];
                    int32 c = 0;
                    while (c < isch.width()) {
                        if (isch.nullableAt(c)) {
                            nNeed = Opt.addName(isch.nameAt(c), need, nNeed);
                        }
                        c = c + 1;
                    }
                }
            }
            top = top - 1;
        }
        // Build the rewritten chain: configured scan leaf, then the
        // remaining ops above it (payloads borrowed throughout).
        Plan leaf = Plan.scan();
        if (nSink > 0) {
            Pred[] preds = heap Pred[nSink];
            int32 s = 0;
            while (s < nSink) {
                preds[s] = ops[s].predOf();
                s = s + 1;
            }
            leaf.__setScanPreds(#preds, nSink);
        }
        if (!all) {
            // A sunk predicate's columns are read at the scan too — count
            // them in the set so the read accounting stays honest.
            int32 s2 = 0;
            while (s2 < nSink) {
                nNeed = Opt.addPredRefs(ops[s2].predOf(), need, nNeed);
                s2 = s2 + 1;
            }
            String[] sc = heap String[src.width()];
            int32 keepN = 0;
            int32 c2 = 0;
            while (c2 < src.width()) {
                if (Opt.contains(need, nNeed, src.nameAt(c2))) {
                    sc[keepN] = src.nameAt(c2);
                    keepN = keepN + 1;
                }
                c2 = c2 + 1;
            }
            leaf.__setScanCols(#sc, keepN);
        }
        return Opt.chainFrom(ops, depth - 1, nSink, #leaf);
    }

    /** Wrap `below` with borrowed copies of ops[nSink..k], top-down. */
    static #Plan chainFrom(Plan[] ops, int32 k, int32 nSink, #Plan below) {
        if (k < nSink) {
            return #below;
        }
        return Plan.borrowNode(ops[k],
            Opt.chainFrom(ops, k - 1, nSink, #below));
    }

    /** The op's output schema given its input schema (schema-only). */
    static #DynFrame schemaThrough(Plan node, DynFrame in) {
        int32 k = node.kindOf();
        if (k == 3) {
            DynFrame c3 = in.schemaOnly();
            return Exec.apply(node.selsOf(), node.selCount(), #c3, false);
        }
        if (k == 4) {
            DynFrame c4 = in.schemaOnly();
            return Exec.apply(node.selsOf(), node.selCount(), #c4, true);
        }
        if (k == 12) {
            DynFrame c12 = in.schemaOnly();
            return Exec.applyFillNull(node, #c12);
        }
        return in.schemaOnly();   // filter / dropNulls preserve the schema
    }

    /** May the filter predicate `p` move below `node`? */
    static boolean commutes(Pred p, Plan node) {
        int32 k = node.kindOf();
        if (k == 13) {
            return true;    // both independent row-wise keeps
        }
        if (k == 12) {
            return !Opt.predRefs(p, node.colNameOf());
        }
        if (k == 4) {
            Sel s = node.selsOf();
            while (s != null) {
                if (Opt.predRefs(p, s.outNameOf())) {
                    return false;
                }
                s = s.nextOf();
            }
            return true;
        }
        return false;      // project re-ordinals; everything else: unknown
    }

    /** Does `p` reference column `name` anywhere in its operand trees? */
    static boolean predRefs(Pred p, String name) {
        int32 k = p.kind();
        if (k >= 30 && k <= 32) {
            if (Opt.predRefs(p.leftPredicate(), name)) {
                return true;
            }
            if (p.rightPredicate() != null) {
                return Opt.predRefs(p.rightPredicate(), name);
            }
            return false;
        }
        if (k == 26 || k == 27) {
            return p.strOperandExpr().name().equals(name);
        }
        if (k >= 40 && k <= 45) {
            return p.iOperandExpr().name().equals(name);
        }
        return Opt.exprRefs(p.operandExpr(), name);
    }

    static boolean exprRefs(ColF64 e, String name) {
        int32 k = e.kind();
        if (k == 0) {
            return e.name().equals(name);
        }
        if (k == 1) {
            return false;
        }
        if (Opt.exprRefs(e.leftChild(), name)) {
            return true;
        }
        return Opt.exprRefs(e.rightChild(), name);
    }

    /** Add every column `p` references to `need` (dedup); new count. */
    static int32 addPredRefs(Pred p, String[] need, int32 n) {
        int32 k = p.kind();
        if (k >= 30 && k <= 32) {
            int32 n2 = Opt.addPredRefs(p.leftPredicate(), need, n);
            if (p.rightPredicate() != null) {
                n2 = Opt.addPredRefs(p.rightPredicate(), need, n2);
            }
            return n2;
        }
        if (k == 26 || k == 27) {
            return Opt.addName(p.strOperandExpr().name(), need, n);
        }
        if (k >= 40 && k <= 45) {
            return Opt.addName(p.iOperandExpr().name(), need, n);
        }
        return Opt.addExprRefs(p.operandExpr(), need, n);
    }

    static int32 addExprRefs(ColF64 e, String[] need, int32 n) {
        int32 k = e.kind();
        if (k == 0) {
            return Opt.addName(e.name(), need, n);
        }
        if (k == 1) {
            return n;
        }
        int32 n2 = Opt.addExprRefs(e.leftChild(), need, n);
        return Opt.addExprRefs(e.rightChild(), need, n2);
    }

    /** Add every column the selection chain reads (not what it names). */
    static int32 addSelRefs(Sel s0, String[] need, int32 n) {
        Sel s = s0;
        int32 n2 = n;
        while (s != null) {
            if (s.strRefOf() != null) {
                n2 = Opt.addName(s.strRefOf().name(), need, n2);
            } else if (s.iRefOf() != null) {
                n2 = Opt.addName(s.iRefOf().name(), need, n2);
            } else if (s.exprOf() != null) {
                n2 = Opt.addExprRefs(s.exprOf(), need, n2);
            }
            s = s.nextOf();
        }
        return n2;
    }

    /** Drop the chain's OUTPUT names from `need` (a `with` provides them
     *  itself — its operands get added back by {@link #addSelRefs}). */
    static int32 removeSelOuts(Sel s0, String[] need, int32 n) {
        Sel s = s0;
        int32 n2 = n;
        while (s != null) {
            int32 i = 0;
            while (i < n2) {
                if (need[i].equals(s.outNameOf())) {
                    int32 j = i;
                    while (j < n2 - 1) {
                        need[j] = need[j + 1];
                        j = j + 1;
                    }
                    n2 = n2 - 1;
                } else {
                    i = i + 1;
                }
            }
            s = s.nextOf();
        }
        return n2;
    }

    static int32 addName(String name, String[] need, int32 n) {
        int32 i = 0;
        while (i < n) {
            if (need[i].equals(name)) {
                return n;
            }
            i = i + 1;
        }
        need[n] = name;
        return n + 1;
    }

    static boolean contains(String[] need, int32 n, String name) {
        int32 i = 0;
        while (i < n) {
            if (need[i].equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}
