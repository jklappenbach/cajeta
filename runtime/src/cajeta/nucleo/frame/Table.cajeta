package cajeta.nucleo.frame;

import cajeta.lang.Int64;
import cajeta.lang.String;
import cajeta.time.Duration;

/**
 * `Table<T>` — the typed dataframe (nucleo-frame spec §2): a set of columns
 * whose names and physical types derive at compile time from the fields of
 * the **record** `T`, the table's schema. The record is a type-level
 * descriptor — a `Table<T>` never holds row objects; each field becomes one
 * column with the mapped physical:
 *
 *   float64 / float32 / int8..int64 / uint8..uint64  ->  `Column<that>`
 *   `Instant`                                        ->  `Column<int64>` (epoch-nanos)
 *   `Utf8`                                           ->  `StringColumn` (utf8)
 *   `@Nullable` on a mappable field                  ->  `NullableColumn<that>`
 *
 * A non-record schema argument, or a field with no physical mapping, is a
 * named compile error (`CAJETA_ERROR_FRAME_SCHEMA` /
 * `CAJETA_ERROR_FRAME_UNMAPPED_FIELD`).
 *
 * The per-schema surface is synthesized at instantiation (source-synthesis
 * facility): one public typed accessor field per column (`ticks.price` — a
 * typo fails the compile), a constructor taking the columns in schema order
 * (adopting them zero-copy after a loud row-length check), schema
 * introspection (`colCount`/`colNameAt`/`colTypeAt`/`colNullableAt`), the
 * typed row surface (`rowAt`, `rows()`), and the typed relational ops
 * (`filter`/`select`/`with` taking the `<Record>Cols` builder lambda).
 *
 * LAZINESS (spec §4, F-FORCE): one lazy `Table<T>` type. A materialized
 * table is a forced source; `lazy()` and the relational ops build plan
 * HANDLES that execute nothing until a terminal (`collect()` — exactly
 * once, cached; `head`/`fetch`; row iteration). A schema-changing op
 * (`select`/`with`) returns a visible `Table<?>`, narrowed back by the
 * checked `.as<R>()` or accessed dynamically via `col("...")`.
 *
 * Handles are LINEAR: chaining an op off a handle consumes it, and reusing
 * a chained-away handle is a named FrameException. The DATA is immutable —
 * materialized sources are never consumed and every snapshot is a
 * refcounted zero-copy alias.
 *
 * Internally every materialized table carries a schema-agnostic column bag
 * (`DynFrame`) aliasing the same storage as the typed accessor fields; the
 * executor and the erased `Table<?>` world run entirely on it. Typed
 * results come back through `rebinder` — a closure installed by the
 * synthesized constructor that rebuilds a typed table from a frame
 * (template code cannot name synthesized members: a `Table<?>` monomorph
 * compiles this same body).
 */
public class Table<T> {
    int64 rows;
    Plan plan;           // null on a materialized table
    DynFrame src;        // plan handles: the zero-copy scan snapshot
    DynFrame schema;     // plan handles: the RESULT schema (schema-only)
    DynFrame dyn;        // materialized: the dynamic column bag
    Table<?> cachedOwn;  // OWNER of the collected result
    Table<T> cached;     // borrowed typed view of cachedOwn (capture cast)
    int64 execCount;     // executions run through this handle (F-FORCE pin)
    boolean typed;       // result schema still matches T (rebind on collect)
    boolean spent;       // linear handle already chained away
    boolean erased;      // materialized WITHOUT typed accessor columns
    String label;        // "Table<pkg.Rec>" or "Table<?>" (describe)
    Rebinder rebinder;   // typed rebuild: owned by materialized tables
                         // (synthesized ctors install); handles borrow
    Sel groupKeys;       // U8: keys named by groupBy, pending its agg
    int32 nGroupKeys;
    boolean grouped;     // a groupBy handle awaiting .agg(...)
    boolean resampling;  // U10: a resample handle awaiting .agg(...)
    String rsTsName;     // U10: resample time column + bucketing params
    int64 rsEvery;
    int64 rsOrigin;
    int64 rsOffset;
    boolean rsClosedRight;
    boolean windowing;   // U11: a rolling handle awaiting .agg(...)
    String winTsName;    // U11: rolling time column (null = count form)
    int64 winSize;       // U11: window nanos (time) or row count
    boolean winByTime;
    boolean optOff;      // skip the U7 rewriter (the tests' baseline)
    int64 statRows;      // last execution: rows the scan materialized
    int64 statCols;      // last execution: column buffers the scan read
    int64 statChunks;    // last execution: zone-map chunks considered (U13)
    int64 statSkipped;   // last execution: zone-map chunks skipped
    int64 statProbed;    // last execution: rows examined vs the predicate (U14)

    /** A plan handle: op chain + scan snapshot + result schema. Built by
     *  `lazy()` and the relational ops; columns stay unset until forced. */
    public Table(#Plan plan, #DynFrame src, #DynFrame schema, boolean typed) {
        this.plan #= plan;
        this.src #= src;
        this.schema #= schema;
        this.typed = typed;
        this.rows = -1;
        this.execCount = 0;
        this.label = "Table<?>";
        this.statRows = -1;
        this.statCols = -1;
        this.statChunks = -1;
        this.statSkipped = -1;
        this.statProbed = -1;
    }

    /** A schema-erased materialized table over a dynamic column bag — what
     *  a schema-changing plan materializes to (visible as `Table<?>`). */
    public Table(#DynFrame d) {
        this.dyn #= d;
        this.rows = this.dyn.rowsOf();
        this.erased = true;
        this.label = "Table<?>";
        this.statRows = -1;
        this.statCols = -1;
        this.statChunks = -1;
        this.statSkipped = -1;
        this.statProbed = -1;
    }

    /** Number of rows — the shared length of every column. Plan handles
     *  report -1 until forced ({@link #collect} first). */
    public int64 rowCount() {
        return this.rows;
    }

    /** How many times this handle's plan has executed: 0 until the first
     *  terminal, and 1 after any number of re-forces (the result caches). */
    public int64 executions() {
        return this.execCount;
    }

    /** True when rows are materialized here (a source table, or a handle
     *  already forced). */
    public boolean isForced() {
        return this.plan == null || this.cached != null;
    }

    void __liveCheck() {
        if (this.spent) {
            throw heap FrameException(
                "Table: handle already chained away - re-chain from the "
                + "source table");
        }
    }

    /** The result schema this table/handle produces (schema-only view). */
    DynFrame __schemaOf() {
        if (this.dyn != null) { return this.dyn; }
        return this.schema;
    }

    #DynFrame __schemaClone() {
        return this.__schemaOf().schemaOnly();
    }

    /** The materialized dynamic bag, aliased (zero-copy). */
    #DynFrame __dynAlias() {
        return this.dyn.aliasFrame();
    }

    /** Detach the op chain: a handle yields its plan (and is spent); a
     *  materialized source yields a fresh scan leaf (and is untouched). */
    #Plan __takeChain() {
        this.__liveCheck();
        if (this.plan == null) {
            return Plan.scan();
        }
        this.spent = true;
        Plan p #= this.plan;
        return #p;
    }

    /** The scan snapshot for a new handle chained off this one. */
    #DynFrame __takeSrc() {
        if (this.dyn != null) {
            return this.dyn.aliasFrame();
        }
        DynFrame s #= this.src;
        return #s;
    }

    /**
     * THE terminal (spec §4.5–4.6): execute the whole accumulated plan,
     * materialize the result, and cache it — re-forcing the same handle
     * returns the cached result without re-executing. On a materialized
     * source table this is the identity.
     */
    public Table<T> collect() {
        if (this.cached != null) {
            return this.cached;
        }
        this.__liveCheck();
        if (this.grouped) {
            throw heap FrameException("Table.collect: groupBy names the "
                + "keys but nothing to reduce - complete it with .agg(...)");
        }
        if (this.resampling) {
            throw heap FrameException("Table.collect: resample names the "
                + "time buckets but nothing to reduce - complete it with "
                + ".agg(...)");
        }
        if (this.windowing) {
            throw heap FrameException("Table.collect: rolling names the "
                + "window but nothing to reduce - complete it with "
                + ".agg(...)");
        }
        if (this.plan == null) {
            return this;
        }
        this.execCount = this.execCount + 1;
        ExecStats st = heap ExecStats();
        DynFrame out = this.__execute(st);
        this.statRows = st.scanRows();
        this.statCols = st.scanCols();
        this.statChunks = st.scanChunks();
        this.statSkipped = st.scanChunksSkipped();
        this.statProbed = st.scanProbed();
        if (this.typed) {
            // `typed` implies a rebinder was installed/propagated at
            // handle build — the invariant every typed-handle builder
            // keeps (lazy/filter propagate, as<R> attaches).
            RebindSlot slot = heap RebindSlot();
            this.rebinder.rebindInto(out, slot);
            this.cachedOwn #= slot.take();
            this.cached = (Table<T>) this.cachedOwn;
            // The rebound table's columns are zero-copy VIEWS: storage is
            // single-owner (Storage has no refcount — views borrow), and
            // fresh executor storage (gathers, computed columns) is owned
            // by the frame. Adopt the frame so that storage lives exactly
            // as long as the result that aliases it.
            this.cached.src #= out;
        } else {
            this.cachedOwn #= heap Table<T>(#out);
            this.cached = (Table<T>) this.cachedOwn;
        }
        return this.cached;
    }

    /** Run the plan — through the U7 rewriter unless disabled. The
     *  rewritten chain BORROWS this handle's payloads; the handle keeps
     *  them alive across the run. */
    #DynFrame __execute(ExecStats st) {
        if (this.optOff) {
            return Exec.run(this.plan, this.src, st);
        }
        Plan opt = Opt.rewrite(this.plan, this.src);
        return Exec.run(opt, this.src, st);
    }

    /** Turn the pushdown rewriter (U7, spec §5) off/on for this handle —
     *  default on. The result must be identical either way; the pushdown
     *  tests pin that equality. */
    public void optimize(boolean on) {
        this.optOff = !on;
    }

    /** Rows the scan materialized on the last execution (-1 before any):
     *  with predicate pushdown (U7), rows failing a pushed filter never
     *  materialize. */
    public int64 scanRows() {
        return this.statRows;
    }

    /** Column buffers the scan read on the last execution (-1 before
     *  any): with projection pushdown (U7), columns the pipeline never
     *  references are never read. */
    public int64 scanCols() {
        return this.statCols;
    }

    /** Chunks the last pushdown scan partitioned the source into (U13, spec
     *  §6); 0 when no predicate reached the scan (the chunk path did not run),
     *  -1 before any execution. */
    public int64 scanChunks() {
        return this.statChunks;
    }

    /** Chunks a zone-map proved entirely outside the pushed predicate and
     *  skipped without reading their cells (U13). The soundness pin: skipping
     *  never changes the result, only the work. */
    public int64 scanChunksSkipped() {
        return this.statSkipped;
    }

    /** Rows the last pushdown scan examined against the predicate (U14): with a
     *  B+ index a point/range lookup examines only the located candidates
     *  (probed == matches), proving the index jumped to the rows rather than
     *  scanning the table; -1 before any execution. */
    public int64 scanProbed() {
        return this.statProbed;
    }

    /** Declare column `name` a B+-indexed key on this SOURCE table (U14, spec
     *  §9.5.1): a pushed point/range predicate on it is answered by a
     *  bulk-loaded in-memory B+ (position-set result) rather than a chunk scan.
     *  A knob, not a correctness lever — the answer is identical either way;
     *  the index only accelerates. Set it on the materialized source before
     *  chaining; it carries through the scan snapshot. */
    public void indexColumn(String name) {
        if (this.dyn == null) {
            throw heap FrameException("Table.indexColumn: not a materialized "
                + "source - declare the index before chaining ops");
        }
        if (this.dyn.find(name) < 0) {
            throw heap FrameException("Table.indexColumn: no column '" + name
                + "' in schema " + this.dyn.schemaText());
        }
        this.dyn.addIndexed(name);
    }

    /** Declare a Z-ORDER spatial index over the integer column pair
     *  `(xName, yName)` on this SOURCE table (U15, spec §9.5.2): a 2-D range
     *  (a box: bounds on both columns) is answered by REUSING the B+
     *  ({@link cajeta.nucleo.frame.BPlusIndex}) on a morton-interleaved key —
     *  no second tree type. The morton range over-covers the box; the row-wise
     *  box predicate makes the answer exact. A knob, not a correctness lever;
     *  absence degrades to the ordinary scan. */
    public void indexSpatial(String xName, String yName) {
        if (this.dyn == null) {
            throw heap FrameException("Table.indexSpatial: not a materialized "
                + "source - declare the index before chaining ops");
        }
        int32 xo = this.dyn.find(xName);
        int32 yo = this.dyn.find(yName);
        if (xo < 0 || yo < 0) {
            throw heap FrameException("Table.indexSpatial: columns '" + xName
                + "', '" + yName + "' must both be in schema "
                + this.dyn.schemaText());
        }
        if (this.dyn.tagAt(xo) > 8 || this.dyn.tagAt(yo) > 8) {
            throw heap FrameException("Table.indexSpatial: '" + xName + "', '"
                + yName + "' must be integer columns (Z-order interleaves "
                + "integer coordinates)");
        }
        this.dyn.setSpatial(xName, yName);
    }

    /** Set the zone-map chunk width for scans off this SOURCE table (U13, spec
     *  §9): the source is partitioned into fixed-width row chunks and a pushed
     *  range predicate skips whole chunks via their per-chunk min/max. A knob,
     *  not a correctness lever — any width gives the same rows (smaller chunks
     *  skip more finely). Set it on the materialized source before chaining;
     *  it carries through the scan snapshot. */
    public void zoneChunkRows(int64 rows) {
        if (this.dyn == null) {
            throw heap FrameException("Table.zoneChunkRows: not a materialized "
                + "source - set the chunk width before chaining ops");
        }
        this.dyn.setZoneChunk(rows);
    }

    /** A plan handle whose scan reads a zero-copy snapshot of this
     *  materialized table (building it reads no data). */
    public #Table<T> lazy() {
        if (this.plan != null) {
            throw heap FrameException("Table.lazy: already a plan handle");
        }
        Table<T> h = heap Table<T>(Plan.scan(), this.dyn.aliasFrame(),
            this.dyn.schemaOnly(), !this.erased);
        h.label = this.label;
        h.rebinder = this.rebinder;
        return #h;
    }

    /** Filter by an already-built predicate — the dynamic form
     *  (`t.filter(t.col("price") > 0.0)`); the typed lambda form is the
     *  synthesized `filter((TickCols c) -> ...)`. Lazy: builds a node. */
    public #Table<T> filter(#Pred p) {
        DynFrame sch = this.__schemaClone();
        boolean ty = this.typed || this.plan == null;
        if (this.erased) { ty = false; }
        Plan node = Plan.filterNode(#p, this.__takeChain());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #sch, ty);
        h.label = this.label;
        h.rebinder = this.rebinder;
        return #h;
    }

    /** Projection/with-columns over a selection chain (internal — the
     *  synthesized `select`/`with` build the chain from the typed lambda).
     *  The result schema changes, so the handle is schema-erased. */
    public #Table<T> __project(#Sel sels, int32 nsels, boolean keepAll) {
        // Compute (and validate) the output schema at PLAN BUILD time
        // against this node's input schema — nothing executes.
        DynFrame inSchema = this.__schemaClone();
        Plan node = Plan.selNode(keepAll, #sels, nsels, this.__takeChain());
        DynFrame outSchema = Exec.apply(node.selsOf(), node.selCount(),
            #inSchema, keepAll);
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Dynamic column accessor (spec §4.3.2): a float64 expression node for
     *  a numeric column, validated against the (plan-build) schema — an
     *  unknown name fails loud naming the schema; utf8 guides to
     *  {@link #colStr}; exact int64 comparisons via {@link #colInt}. */
    public #ColF64 col(String name) {
        DynFrame sch = this.__schemaOf();
        int32 i = sch.find(name);
        if (i < 0) {
            throw heap FrameException("Table.col: no column '" + name
                + "' in schema " + sch.schemaText());
        }
        if (sch.tagAt(i) == 11) {
            throw heap FrameException("Table.col: column '" + name
                + "' is utf8 - use colStr(\"...\")");
        }
        return ColF64.colRef(i, name);
    }

    /** Dynamic utf8 column accessor. */
    public #ColStr colStr(String name) {
        DynFrame sch = this.__schemaOf();
        int32 i = sch.find(name);
        if (i < 0) {
            throw heap FrameException("Table.colStr: no column '" + name
                + "' in schema " + sch.schemaText());
        }
        if (sch.tagAt(i) != 11) {
            throw heap FrameException("Table.colStr: column '" + name
                + "' is '" + sch.typeNameAt(i) + "' - use col(\"...\")");
        }
        return ColStr.colRef(i, name);
    }

    /** Dynamic exact-integer column accessor (no float64 round-trip). */
    public #ColI64 colInt(String name) {
        DynFrame sch = this.__schemaOf();
        int32 i = sch.find(name);
        if (i < 0) {
            throw heap FrameException("Table.colInt: no column '" + name
                + "' in schema " + sch.schemaText());
        }
        if (sch.tagAt(i) > 8) {
            throw heap FrameException("Table.colInt: column '" + name
                + "' is '" + sch.typeNameAt(i) + "' - use col(\"...\")");
        }
        return ColI64.colRef(i, name);
    }

    int32 __nullableColIndex(String op, String name) {
        DynFrame sch = this.__schemaOf();
        int32 i = sch.find(name);
        if (i < 0) {
            throw heap FrameException("Table." + op + ": no column '" + name
                + "' in schema " + sch.schemaText());
        }
        if (!sch.nullableAt(i)) {
            throw heap FrameException("Table." + op + ": column '" + name
                + "' is not nullable ('" + sch.typeNameAt(i) + "')");
        }
        return i;
    }

    /** Explicit null fill (spec §7.4): every null in `name` becomes `v`,
     *  and the column goes NON-NULL in the result schema — a schema
     *  change, so the result is erased (`Table<?>`); narrow with the
     *  filled record. Lazy: builds a node. */
    public #Table<?> fillNull(String name, float64 v) {
        int32 i = this.__nullableColIndex("fillNull", name);
        DynFrame outSchema = this.__schemaClone();
        outSchema.clearNullable(i);
        Plan node = Plan.fillNullNode(name, v, this.__takeChain());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Explicit null fill, exact-integer value (integer physicals). */
    public #Table<?> fillNull(String name, int64 v) {
        int32 i = this.__nullableColIndex("fillNull", name);
        DynFrame outSchema = this.__schemaClone();
        outSchema.clearNullable(i);
        Plan node = Plan.fillNullIntNode(name, v, this.__takeChain());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Explicit row drop (spec §7.4): rows missing a value in ANY
     *  nullable column are dropped. Schema-preserving — the result stays
     *  typed (the columns keep their nullable TYPE; they just hold no
     *  nulls). Lazy: builds a node. */
    public #Table<T> dropNulls() {
        return this.__dropNulls(null);
    }

    /** Explicit row drop limited to one column's nulls. */
    public #Table<T> dropNulls(String name) {
        this.__nullableColIndex("dropNulls", name);
        return this.__dropNulls(name);
    }

    #Table<T> __dropNulls(String name) {
        DynFrame sch = this.__schemaClone();
        boolean ty = this.typed || this.plan == null;
        if (this.erased) { ty = false; }
        Plan node = Plan.dropNullsNode(name, this.__takeChain());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #sch, ty);
        h.label = this.label;
        h.rebinder = this.rebinder;
        return #h;
    }

    /** Name the group keys (internal — the synthesized `groupBy` builds the
     *  chain from the typed lambda). Lazy and incomplete: the handle holds
     *  the keys until `agg` completes the node, and forcing it before then
     *  is a named error rather than a silent whole-table reduction. */
    public #Table<T> __groupBy(#Sel keys, int32 nkeys) {
        DynFrame sch = this.__schemaClone();
        Plan pl = this.__takeChain();
        DynFrame sr = this.__takeSrc();
        Table<T> h = heap Table<T>(#pl, #sr, #sch, false);
        h.groupKeys #= keys;
        h.nGroupKeys = nkeys;
        h.grouped = true;
        h.label = this.label;
        return #h;
    }

    /** Complete a groupBy with its aggregates (internal — the synthesized
     *  `agg` builds the chain from the typed lambda). The output schema is
     *  computed and VALIDATED here, at plan build: a computed key, an
     *  unknown column, or an unnamed aggregate fails now, before anything
     *  runs. The shape changes, so the result is erased. */
    public #Table<?> __agg(#Agg aggs, int32 naggs) {
        if (this.windowing) {
            DynFrame inSchema = this.__schemaClone();
            this.windowing = false;
            Plan node = Plan.windowNode(this.winTsName, this.winSize,
                this.winByTime, #aggs, naggs, this.__takeChain());
            DynFrame outSchema = Exec.applyWindow(node, #inSchema);
            Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema,
                false);
            return #h;
        }
        if (this.resampling) {
            DynFrame inSchema = this.__schemaClone();
            this.resampling = false;
            Plan node = Plan.resampleNode(this.rsTsName, this.rsEvery,
                this.rsOrigin, this.rsOffset, this.rsClosedRight, #aggs,
                naggs, this.__takeChain());
            DynFrame outSchema = Exec.applyResample(node, #inSchema);
            Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema,
                false);
            return #h;
        }
        if (!this.grouped) {
            throw heap FrameException(
                "Table.agg: no group keys - call groupBy(...) or "
                + "resample(...) first");
        }
        DynFrame inSchema = this.__schemaClone();
        Sel k #= this.groupKeys;
        this.grouped = false;
        Plan node = Plan.groupNode(#k, this.nGroupKeys, #aggs, naggs,
            this.__takeChain());
        DynFrame outSchema = Exec.applyGroup(node, #inSchema);
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Name the resample time column and bucketing (internal — the
     *  synthesized `resample` supplies the time-column name; the typed
     *  lambda `(RecCols) -> ColI64` selects it). Like `groupBy`, the handle
     *  holds the buckets until `agg` completes the node, and forcing it
     *  before then is a named error. `origin`/`offset` are nanos; the grid
     *  base is `origin + offset`; `closedRight` flips left- to right-closed
     *  (spec §8). */
    public #Table<T> __resample(String tsName, int64 every, int64 origin,
                                int64 offset, boolean closedRight) {
        DynFrame sch = this.__schemaClone();
        Plan pl = this.__takeChain();
        DynFrame sr = this.__takeSrc();
        Table<T> h = heap Table<T>(#pl, #sr, #sch, false);
        h.rsTsName = tsName;
        h.rsEvery = every;
        h.rsOrigin = origin;
        h.rsOffset = offset;
        h.rsClosedRight = closedRight;
        h.resampling = true;
        h.label = this.label;
        return #h;
    }

    /** Dynamic resample (spec §4.3.2, §8): a string-keyed time column, the
     *  default grid (epoch origin, no offset, left-closed). The typed
     *  lambda form is the synthesized `resample((Cols) -> ColI64, Duration
     *  [, origin, offset, closedRight])`. */
    public #Table<T> resample(String tsName, Duration every) {
        return this.__resample(tsName, every.toNanos(), 0, 0, false);
    }

    /** Name the rolling window (internal — the synthesized `rolling`
     *  supplies the time-column name via a typed lambda, or the count form
     *  passes a null name). Like `resample`, the handle holds the window
     *  until `agg` completes the node (spec §8 resolution). */
    public #Table<T> __rolling(String tsName, int64 size, boolean byTime) {
        DynFrame sch = this.__schemaClone();
        Plan pl = this.__takeChain();
        DynFrame sr = this.__takeSrc();
        Table<T> h = heap Table<T>(#pl, #sr, #sch, false);
        h.winTsName = tsName;
        h.winSize = size;
        h.winByTime = byTime;
        h.windowing = true;
        h.label = this.label;
        return #h;
    }

    /** Dynamic time-window rolling (spec §4.3.2): a string-keyed time
     *  column, trailing `(t - window, t]`. The typed lambda form is the
     *  synthesized `rolling((Cols) -> ColI64, Duration)`. */
    public #Table<T> rolling(String tsName, Duration window) {
        return this.__rolling(tsName, window.toNanos(), true);
    }

    /** Row-count rolling (spec §8 resolution): the trailing `n` rows in
     *  input order, clamped at the start. No time column — the result is
     *  the aggregates alone. */
    public #Table<T> rolling(int64 n) {
        return this.__rolling(null, n, false);
    }

    /** Order the rows by a key list (internal — the synthesized `sort`
     *  builds the chain from the typed lambda). Schema-PRESERVING, so the
     *  handle stays typed: a sort of a `Table<T>` is still a `Table<T>`.
     *  Lazy: builds a node. A computed key was already rejected by the
     *  collector (`Sorts.add`). */
    public #Table<T> __sort(#SortKey keys, int32 nkeys) {
        DynFrame sch = this.__schemaClone();
        boolean ty = this.typed || this.plan == null;
        if (this.erased) { ty = false; }
        Plan node = Plan.sortNode(#keys, nkeys, this.__takeChain());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #sch, ty);
        h.label = this.label;
        h.rebinder = this.rebinder;
        return #h;
    }

    /** Join against `other` on a key list (internal — the synthesized
     *  `join` builds the chain from the typed lambda). The keys reference
     *  THIS (left) schema and are matched by NAME on the right. The output
     *  schema is computed and VALIDATED here, at plan build: a key absent
     *  from the right, or a utf8 column that a `how` would null-extend,
     *  fails now, before anything runs. The shape changes, so the result is
     *  erased (`Table<?>`); narrow with the joined record. */
    public #Table<?> __join(Table<?> other, #Sel keys, int32 nkeys,
                            int32 how) {
        this.__liveCheck();
        DynFrame lsch = this.__schemaClone();
        DynFrame rsch = other.__schemaClone();
        Plan rp = other.__takeChain();
        DynFrame rs = other.__takeSrc();
        Plan node = Plan.joinNode(#keys, nkeys, how, #rp, #rs,
            this.__takeChain());
        DynFrame outSchema = Exec.applyJoin(node, #lsch, #rsch);
        node.__setJoinOut(outSchema.schemaOnly());
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Dynamic join (spec §4.3.2): a single string-keyed join on a
     *  `Table<?>`, the key looked up in this schema and validated at plan
     *  build. The typed lambda form is the synthesized `join((Cols, Sels)
     *  -> void, Join)`. */
    public #Table<?> join(Table<?> other, String key, int32 how) {
        DynFrame sch = this.__schemaOf();
        int32 i = sch.find(key);
        if (i < 0) {
            throw heap FrameException("join: no column '" + key
                + "' in schema " + sch.schemaText());
        }
        Sel k;
        if (sch.tagAt(i) == 11) {
            k #= Sel.ofStr(ColStr.colRef(i, key), key);
        } else if (sch.tagAt(i) > 8) {
            k #= Sel.of(ColF64.colRef(i, key), key);
        } else {
            k #= Sel.ofI64(ColI64.colRef(i, key), key);
        }
        return this.__join(#other, #k, 1, how);
    }

    /** Melt (wide->long, spec §4.1): stack the value columns into a
     *  `variable`/`value` pair, repeating the id columns. Schema-STATIC
     *  (id columns + utf8 variable + the value-vars' shared physical), so
     *  melt is LAZY and its result — a differently-shaped `Table<?>` —
     *  narrows at plan build with `.as<R>()`. */
    public #Table<?> melt(String[] idVars, int32 nId, String[] valVars,
                          int32 nVal, String variableName, String valueName) {
        DynFrame inSchema = this.__schemaClone();
        Plan node = Plan.meltNode(idVars, nId, valVars, nVal, variableName,
            valueName, this.__takeChain());
        DynFrame outSchema = Exec.applyMelt(node, #inSchema);
        Table<T> h = heap Table<T>(#node, this.__takeSrc(), #outSchema, false);
        return #h;
    }

    /** Melt with the default `variable`/`value` output names. */
    public #Table<?> melt(String[] idVars, int32 nId, String[] valVars,
                          int32 nVal) {
        return this.melt(idVars, nId, valVars, nVal, "variable", "value");
    }

    /** Pivot (long->wide, spec §4.1): one row per distinct `index` tuple,
     *  one column per distinct value of `columnsKey`, filled from
     *  `valuesKey`. The output COLUMNS come from the DATA, so unlike every
     *  other op pivot cannot know its schema at plan build — it is EAGER
     *  (like Polars): it forces this handle, reads the data, and returns a
     *  MATERIALIZED `Table<?>` (the canonical erased case, spec §4.3),
     *  narrowed once the value set is known. A duplicate (index, key) cell
     *  is a loud error. */
    public #Table<?> pivot(String[] index, int32 nIndex, String columnsKey,
                           String valuesKey) {
        Table<T> m = this.collect();
        DynFrame in = m.__matDyn("pivot").aliasFrame();
        DynFrame out = Exec.pivot(in, index, nIndex, columnsKey, valuesKey);
        Table<?> r = heap Table<T>(#out);
        return #r;
    }

    /** Pivot with a single index column. */
    public #Table<?> pivot(String index, String columnsKey,
                           String valuesKey) {
        String[] idx = heap String[1];
        idx[0] = index;
        return this.pivot(idx, 1, columnsKey, valuesKey);
    }

    /** Column count of a MATERIALIZED table — the schema-agnostic read
     *  surface that works on a `Table<?>` (the synthesized `colCount` is a
     *  per-record compile-time fact, so it needs a known schema). */
    public int32 width() {
        return this.__matDyn("width").width();
    }

    DynFrame __matDyn(String op) {
        if (this.dyn == null) {
            throw heap FrameException("Table." + op + ": this table is not "
                + "materialized - force it with collect() first");
        }
        return this.dyn;
    }

    /** Dynamic cell reads on a materialized table (spec §4.3.2) — the
     *  `Table<?>` read side, name-keyed and validated. The column access
     *  itself lives on DynFrame so this template never names a type from
     *  the column package (see DynFrame's note). */
    public float64 f64At(String name, int64 row) {
        return this.__matDyn("f64At").f64Named("f64At", name, row);
    }

    public int64 i64At(String name, int64 row) {
        return this.__matDyn("i64At").i64Named("i64At", name, row);
    }

    public #String strAt(String name, int64 row) {
        return this.__matDyn("strAt").strNamed("strAt", name, row);
    }

    /** Whether a cell HAS a value — false exactly where the column is
     *  nullable and this row is null (spec §7). */
    public boolean validAt(String name, int64 row) {
        return this.__matDyn("validAt").validNamed("validAt", name, row);
    }

    /**
     * The checked narrowing (spec §4.3.1): validate the real schema —
     * known at plan build, no forcing — against `R`'s fields, then rebind.
     * A mismatch is a named FrameException (absent column / actual vs
     * expected type / column count); a failed narrow neither forces nor
     * consumes this handle. On an unforced handle the narrow stays LAZY
     * (returns an unforced `Table<R>` handle); on a materialized table it
     * returns the typed table directly.
     */
    public final #Table<R> as<R>() {
        this.__liveCheck();
        Table<R> probe = heap Table<R>(this.__schemaClone());
        probe.__narrowCheck();
        if (this.plan != null && this.cached == null) {
            DynFrame sch = this.__schemaClone();
            Plan pl = this.__takeChain();
            DynFrame sr = this.__takeSrc();
            Table<R> h = heap Table<R>(#pl, #sr, #sch, true);
            h.__attachRebinder();
            return #h;
        }
        Table<T> m = this.collect();
        return probe.__rebindOwned(m.__dynAlias());
    }

    /** Schema + plan for an unforced handle (never rows); schema + row
     *  count for a materialized table (spec §2.5, §4 "printing"). */
    public #String describe() {
        if (this.spent) {
            return "Table [spent handle - re-chain from the source table]";
        }
        if (this.cached != null) {
            return this.cached.describe();
        }
        if (this.plan != null) {
            return this.label + " [unforced] plan: " + this.plan.describe()
                + " schema " + this.schema.schemaText();
        }
        String n = stack Int64(this.rows).toString();
        String w = stack Int64((int64) this.dyn.width()).toString();
        return this.label + " [" + n + " rows x " + w + " cols] "
            + this.dyn.schemaText();
    }

    /** The plan as the U7 rewriter will run it (spec §2.5, §5): pushed
     *  predicates and the pruned column set show on the scan leaf
     *  (`scan[filter x2, cols: a,b]`). Printing rewrites nothing — the
     *  rewritten chain borrows this handle's payloads and is dropped. */
    public #String explain() {
        if (this.spent) {
            return "Table [spent handle - re-chain from the source table]";
        }
        if (this.plan == null) {
            return this.describe();
        }
        Plan opt = Opt.rewrite(this.plan, this.src);
        String pd = opt.describe();
        return this.label + " [optimized] plan: " + pd
            + " schema " + this.schema.schemaText();
    }
}
