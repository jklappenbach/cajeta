package cajeta.nucleo.frame;

import cajeta.lang.String;
import cajeta.nucleo.column.DynCol;

/**
 * Exec — the plan executor (nucleo-frame U5): walks a {@link Plan} chain
 * scan-first over {@link DynFrame}s, schema-agnostic — the typed world ends
 * at the handle's snapshot and resumes at the typed rebind. v1 is a
 * row-interpreting executor (filter builds an index gather; project/with
 * evaluate selections per row); the nucleo-expr fusion seam replaces the
 * inner loops later without changing this contract.
 *
 * Executors are validity-PRESERVING (gathers carry null bitmaps with their
 * values); three-valued predicate semantics over nulls land with U6 —
 * until then predicates read physical values.
 *
 * `apply(sels, ...)` doubles as the plan-build schema computer: fed a
 * schema-only frame it returns the output schema without touching data —
 * `col("...")`/`.as<R>()` validate against it before anything runs.
 */
public class Exec {

    /** Execute `node`'s chain against the scan snapshot `src`. */
    public static #DynFrame run(Plan node, DynFrame src) {
        ExecStats st = heap ExecStats();
        return Exec.run(node, src, st);
    }

    /** Execute, recording scan counters into `st` (U7). */
    public static #DynFrame run(Plan node, DynFrame src, ExecStats st) {
        if (node.kindOf() == 1) {
            if (node.scanPredCount() == 0 && !node.scanPruned()) {
                st.note(src.rowsOf(), (int64) src.width());
                return src.aliasFrame();
            }
            return Exec.applyScan(node, src, st);
        }
        DynFrame in = Exec.run(node.childOf(), src, st);
        if (node.kindOf() == 2) {
            return Exec.applyFilter(node.predOf(), #in);
        }
        if (node.kindOf() == 3) {
            return Exec.apply(node.selsOf(), node.selCount(), #in, false);
        }
        if (node.kindOf() == 4) {
            return Exec.apply(node.selsOf(), node.selCount(), #in, true);
        }
        if (node.kindOf() == 12) {
            return Exec.applyFillNull(node, #in);
        }
        if (node.kindOf() == 13) {
            return Exec.applyDropNulls(node, #in);
        }
        throw heap FrameException(
            "plan node not executable yet: " + node.opName());
    }

    /** Optimizer scan (U7): materialize only the referenced columns and
     *  only the rows passing every pushed predicate — failing rows and
     *  pruned column buffers are never read. Pruned slots stay NULL
     *  placeholders so every ordinal bound at plan build keeps meaning;
     *  the needed-column analysis guarantees nothing above reads them. */
    static #DynFrame applyScan(Plan node, DynFrame src, ExecStats st) {
        int32 w = src.width();
        boolean[] keep = heap boolean[w];
        if (node.scanPruned()) {
            int32 ci = 0;
            while (ci < node.scanColCount()) {
                int32 o = src.find(node.scanColAt(ci));
                if (o >= 0) { keep[o] = true; }
                ci = ci + 1;
            }
        } else {
            int32 j0 = 0;
            while (j0 < w) { keep[j0] = true; j0 = j0 + 1; }
        }
        int64 kc = 0;
        int32 j1 = 0;
        while (j1 < w) {
            if (keep[j1]) { kc = kc + 1; }
            j1 = j1 + 1;
        }
        int64 n = src.rowsOf();
        DynCol[] out = heap DynCol[w];
        if (node.scanPredCount() == 0) {
            int32 j2 = 0;
            while (j2 < w) {
                if (keep[j2]) { out[j2] #= src.colAt(j2).alias(); }
                j2 = j2 + 1;
            }
            st.note(n, kc);
            return src.rebuild(#out, n);
        }
        int64 cap = n;
        if (cap < 1) { cap = 1; }
        int64[] idx = heap int64[cap];
        int64 m = 0;
        int64 i = 0;
        while (i < n) {
            boolean pass = true;
            int32 pi = 0;
            while (pi < node.scanPredCount()) {
                if (Exec.evalPred3(node.scanPredAt(pi), src, i) != 1) {
                    pass = false;
                }
                pi = pi + 1;
            }
            if (pass) {
                idx[m] = i;
                m = m + 1;
            }
            i = i + 1;
        }
        int32 j = 0;
        while (j < w) {
            if (keep[j]) { out[j] #= src.colAt(j).gather(idx, m); }
            j = j + 1;
        }
        st.note(m, kc);
        return src.rebuild(#out, m);
    }

    /** float64 expression eval at row `i` (colRef / literal / arithmetic). */
    static float64 evalF64(ColF64 e, DynFrame f, int64 i) {
        int32 k = e.kind();
        if (k == 0) {
            int32 o = e.ordinal();
            if (o < 0 || o >= f.width()) {
                throw heap FrameException("column '" + e.name()
                    + "' is not in schema " + f.schemaText());
            }
            if (f.tagAt(o) == 11) {
                throw heap FrameException("column '" + e.name()
                    + "' is utf8; a numeric expression expected it numeric");
            }
            return f.colAt(o).f64At(i);
        }
        if (k == 1) {
            return e.literalValue();
        }
        float64 a = Exec.evalF64(e.leftChild(), f, i);
        float64 b = Exec.evalF64(e.rightChild(), f, i);
        if (k == 2) { return a + b; }
        if (k == 3) { return a - b; }
        if (k == 4) { return a * b; }
        if (k == 5) { return a / b; }
        throw heap FrameException("unknown expression kind");
    }

    /** Exact int64 reference eval at row `i`. */
    static int64 evalI64(ColI64 e, DynFrame f, int64 i) {
        int32 o = e.ordinal();
        if (o < 0 || o >= f.width()) {
            throw heap FrameException("column '" + e.name()
                + "' is not in schema " + f.schemaText());
        }
        if (f.tagAt(o) > 8) {
            throw heap FrameException("column '" + e.name() + "' is '"
                + f.typeNameAt(o) + "'; an integer comparison expected an "
                + "integer column");
        }
        return f.colAt(o).i64At(i);
    }

    /** Utf8 reference eval at row `i`. */
    static #String evalStr(ColStr e, DynFrame f, int64 i) {
        int32 o = e.ordinal();
        if (o < 0 || o >= f.width()) {
            throw heap FrameException("column '" + e.name()
                + "' is not in schema " + f.schemaText());
        }
        if (f.tagAt(o) != 11) {
            throw heap FrameException("column '" + e.name() + "' is '"
                + f.typeNameAt(o) + "'; a string comparison expected utf8");
        }
        return f.colAt(o).strAt(i);
    }

    /** Row validity of a float64 expression: a colRef is its column's
     *  validity, a literal is always valid, arithmetic is valid only when
     *  BOTH children are (null propagates — spec §7). */
    static boolean exprValidF64(ColF64 e, DynFrame f, int64 i) {
        int32 k = e.kind();
        if (k == 0) {
            int32 o = e.ordinal();
            if (o < 0 || o >= f.width()) {
                throw heap FrameException("column '" + e.name()
                    + "' is not in schema " + f.schemaText());
            }
            return f.colAt(o).validAt(i);
        }
        if (k == 1) {
            return true;
        }
        return Exec.exprValidF64(e.leftChild(), f, i)
            && Exec.exprValidF64(e.rightChild(), f, i);
    }

    /** SCHEMA-time nullability of a float64 expression: nullable iff it
     *  references any nullable column (works on schema-only frames — no
     *  data reads). A false here selects the no-validity-read fast path. */
    static boolean exprRefsNullable(ColF64 e, DynFrame f) {
        int32 k = e.kind();
        if (k == 0) {
            int32 o = e.ordinal();
            if (o < 0 || o >= f.width()) {
                throw heap FrameException("column '" + e.name()
                    + "' is not in schema " + f.schemaText());
            }
            return f.nullableAt(o);
        }
        if (k == 1) {
            return false;
        }
        if (Exec.exprRefsNullable(e.leftChild(), f)) {
            return true;
        }
        return Exec.exprRefsNullable(e.rightChild(), f);
    }

    /** THREE-VALUED predicate eval at row `i` (spec §7): 0 false, 1 true,
     *  2 null. A comparison over a null operand is NULL (the raw bytes
     *  never decide); logic is Kleene (`null & false = false`,
     *  `null | true = true`, `!null = null`). The filter keeps a row only
     *  on 1 — a null predicate excludes. */
    static int32 evalPred3(Pred p, DynFrame f, int64 i) {
        int32 k = p.kind();
        if (k == 30) {
            int32 l = Exec.evalPred3(p.leftPredicate(), f, i);
            if (l == 0) { return 0; }
            int32 r = Exec.evalPred3(p.rightPredicate(), f, i);
            if (r == 0) { return 0; }
            if (l == 2 || r == 2) { return 2; }
            return 1;
        }
        if (k == 31) {
            int32 l = Exec.evalPred3(p.leftPredicate(), f, i);
            if (l == 1) { return 1; }
            int32 r = Exec.evalPred3(p.rightPredicate(), f, i);
            if (r == 1) { return 1; }
            if (l == 2 || r == 2) { return 2; }
            return 0;
        }
        if (k == 32) {
            int32 l = Exec.evalPred3(p.leftPredicate(), f, i);
            if (l == 2) { return 2; }
            if (l == 1) { return 0; }
            return 1;
        }
        if (k >= 20 && k <= 25) {
            if (!Exec.exprValidF64(p.operandExpr(), f, i)) {
                return 2;
            }
            float64 a = Exec.evalF64(p.operandExpr(), f, i);
            float64 b = p.value();
            boolean r = false;
            if (k == 20) { r = a > b; }
            if (k == 21) { r = a >= b; }
            if (k == 22) { r = a < b; }
            if (k == 23) { r = a <= b; }
            if (k == 24) { r = a == b; }
            if (k == 25) { r = a != b; }
            if (r) { return 1; }
            return 0;
        }
        if (k == 26 || k == 27) {
            // utf8 columns have no nullable physical (v1) — always valid.
            String a = Exec.evalStr(p.strOperandExpr(), f, i);
            boolean eq = a.equals(p.strValue());
            if (k == 26 && eq) { return 1; }
            if (k == 27 && !eq) { return 1; }
            return 0;
        }
        if (k >= 40 && k <= 45) {
            ColI64 ie = p.iOperandExpr();
            int32 o = ie.ordinal();
            if (o < 0 || o >= f.width()) {
                throw heap FrameException("column '" + ie.name()
                    + "' is not in schema " + f.schemaText());
            }
            if (!f.colAt(o).validAt(i)) {
                return 2;
            }
            int64 a = Exec.evalI64(ie, f, i);
            int64 b = p.iValue();
            boolean r = false;
            if (k == 40) { r = a > b; }
            if (k == 41) { r = a >= b; }
            if (k == 42) { r = a < b; }
            if (k == 43) { r = a <= b; }
            if (k == 44) { r = a == b; }
            if (k == 45) { r = a != b; }
            if (r) { return 1; }
            return 0;
        }
        throw heap FrameException("unknown predicate kind");
    }

    /** Filter: evaluate `p` per row, gather the passing rows per column. */
    static #DynFrame applyFilter(Pred p, #DynFrame in) {
        if (in.isSchemaOnly()) {
            return in.schemaOnly();   // filter preserves the schema
        }
        int64 n = in.rowsOf();
        int64 cap = n;
        if (cap < 1) { cap = 1; }
        int64[] idx = heap int64[cap];
        int64 m = 0;
        int64 i = 0;
        while (i < n) {
            if (Exec.evalPred3(p, in, i) == 1) {
                idx[m] = i;
                m = m + 1;
            }
            i = i + 1;
        }
        DynCol[] out = heap DynCol[in.width()];
        int32 j = 0;
        while (j < in.width()) {
            // A null slot is a column the U7 scan pruned — carry it.
            if (in.colAt(j) != null) {
                out[j] #= in.colAt(j).gather(idx, m);
            }
            j = j + 1;
        }
        return in.rebuild(#out, m);
    }

    /** Project (`keepAll == false`) or with-columns (`keepAll == true`).
     *  Passthrough references alias zero-copy; computed expressions
     *  materialize float64. `with` REPLACES a same-named column in place.
     *  Fed a schema-only frame, computes the output SCHEMA only. */
    static #DynFrame apply(Sel sels, int32 nsels, #DynFrame in, boolean keepAll) {
        boolean schemaOnly = in.isSchemaOnly();
        int64 n = in.rowsOf();
        int32 cap = nsels;
        if (keepAll) { cap = cap + in.width(); }
        if (cap < 1) { cap = 1; }
        String[] names = heap String[cap];
        int32[] tags = heap int32[cap];
        boolean[] nulls = heap boolean[cap];
        DynCol[] cols = heap DynCol[cap];
        int32 w = 0;
        if (keepAll) {
            while (w < in.width()) {
                names[w] = in.nameAt(w);
                tags[w] = in.tagAt(w);
                nulls[w] = in.nullableAt(w);
                // A null slot is a column the U7 scan pruned — carry it.
                if (!schemaOnly && in.colAt(w) != null) {
                    cols[w] #= in.colAt(w).alias();
                }
                w = w + 1;
            }
        }
        Sel s = sels;
        while (s != null) {
            String outName = s.outNameOf();
            // `with` replaces a same-named column in place.
            int32 at = w;
            if (keepAll) {
                int32 j = 0;
                while (j < w) {
                    if (names[j].equals(outName)) { at = j; }
                    j = j + 1;
                }
            }
            int32 tag = 10;
            boolean nullable = false;
            if (s.strRefOf() != null) {
                ColStr r = s.strRefOf();
                int32 o = r.ordinal();
                if (o < 0 || o >= in.width()) {
                    throw heap FrameException("column '" + r.name()
                        + "' is not in schema " + in.schemaText());
                }
                if (in.tagAt(o) != 11) {
                    throw heap FrameException("column '" + r.name() + "' is '"
                        + in.typeNameAt(o) + "', not utf8");
                }
                tag = 11;
                if (!schemaOnly) { cols[at] #= in.colAt(o).alias(); }
            } else if (s.iRefOf() != null) {
                ColI64 r = s.iRefOf();
                int32 o = r.ordinal();
                if (o < 0 || o >= in.width()) {
                    throw heap FrameException("column '" + r.name()
                        + "' is not in schema " + in.schemaText());
                }
                if (in.tagAt(o) > 8) {
                    throw heap FrameException("column '" + r.name() + "' is '"
                        + in.typeNameAt(o) + "', not an integer physical");
                }
                tag = in.tagAt(o);
                nullable = in.nullableAt(o);
                if (!schemaOnly) { cols[at] #= in.colAt(o).alias(); }
            } else if (s.exprOf() != null && s.exprOf().kind() == 0) {
                ColF64 r = s.exprOf();
                int32 o = r.ordinal();
                if (o < 0 || o >= in.width()) {
                    throw heap FrameException("column '" + r.name()
                        + "' is not in schema " + in.schemaText());
                }
                if (in.tagAt(o) == 11) {
                    throw heap FrameException("column '" + r.name()
                        + "' is utf8; reference it with a string builder");
                }
                tag = in.tagAt(o);
                nullable = in.nullableAt(o);
                if (!schemaOnly) { cols[at] #= in.colAt(o).alias(); }
            } else {
                // Computed float64 expression — materialized via DynCol so
                // the column instantiation resolves in its own package.
                // Nullability is a SCHEMA fact (spec §7.3): an expression
                // over only non-null inputs takes the fast loop below —
                // it never reads a validity bit (6.3.1's audit point);
                // one referencing a nullable column materializes nullable,
                // with null propagated per row.
                nullable = Exec.exprRefsNullable(s.exprOf(), in);
                if (!schemaOnly) {
                    if (nullable) {
                        DynCol c = DynCol.newNF64(n);
                        int64 i = 0;
                        while (i < n) {
                            if (Exec.exprValidF64(s.exprOf(), in, i)) {
                                c.setNF64(i, Exec.evalF64(s.exprOf(), in, i));
                            }
                            i = i + 1;
                        }
                        cols[at] #= c;
                    } else {
                        DynCol c = DynCol.newF64(n);
                        int64 i = 0;
                        while (i < n) {
                            c.setF64(i, Exec.evalF64(s.exprOf(), in, i));
                            i = i + 1;
                        }
                        cols[at] #= c;
                    }
                }
            }
            names[at] = outName;
            tags[at] = tag;
            nulls[at] = nullable;
            if (at == w) { w = w + 1; }
            s = s.nextOf();
        }
        if (schemaOnly) {
            return heap DynFrame(#names, #tags, #nulls, w);
        }
        // This frame's passthrough columns ALIAS `in`'s storage; adopt the
        // consumed input so that storage lives exactly as long as the
        // aliases (single-owner Storage — the U7-surfaced dangle: a
        // gathered frame below a project was dropped out from under it).
        DynFrame r = heap DynFrame(#names, #tags, #nulls, #cols, w, n);
        r.__adopt(#in);
        return #r;
    }

    /** Fill-null: the target column's nulls become the node's value and
     *  the column goes NON-NULL; every other column aliases zero-copy.
     *  The plan-build validation already named bad targets — a miss here
     *  is an executor invariant break, still loud. */
    static #DynFrame applyFillNull(Plan node, #DynFrame in) {
        String name = node.colNameOf();
        int32 target = in.find(name);
        if (target < 0) {
            throw heap FrameException("fillNull: column '" + name
                + "' is not in schema " + in.schemaText());
        }
        if (in.isSchemaOnly()) {
            DynFrame s = in.schemaOnly();
            s.clearNullable(target);
            return #s;
        }
        DynCol[] out = heap DynCol[in.width()];
        int32 j = 0;
        while (j < in.width()) {
            if (j == target) {
                if (node.fillIsIntOf()) {
                    out[j] #= in.colAt(j).fillNullsInt(node.fillIOf());
                } else {
                    out[j] #= in.colAt(j).fillNulls(node.fillFOf());
                }
            } else if (in.colAt(j) != null) {
                // A null slot is a column the U7 scan pruned — carry it.
                out[j] #= in.colAt(j).alias();
            }
            j = j + 1;
        }
        DynFrame r = in.rebuild(#out, in.rowsOf());
        r.clearNullable(target);
        // Non-target columns alias `in`'s storage — adopt it (see apply).
        r.__adopt(#in);
        return #r;
    }

    /** Drop-nulls: keep only rows where the subset column (or, with no
     *  subset, every nullable column) is valid; schema unchanged. */
    static #DynFrame applyDropNulls(Plan node, #DynFrame in) {
        if (in.isSchemaOnly()) {
            return in.schemaOnly();
        }
        String name = node.colNameOf();
        int32 target = -1;
        if (name != null) {
            target = in.find(name);
            if (target < 0) {
                throw heap FrameException("dropNulls: column '" + name
                    + "' is not in schema " + in.schemaText());
            }
        }
        int64 n = in.rowsOf();
        int64 cap = n;
        if (cap < 1) { cap = 1; }
        int64[] idx = heap int64[cap];
        int64 m = 0;
        int64 i = 0;
        while (i < n) {
            boolean keep = true;
            if (target >= 0) {
                keep = in.colAt(target).validAt(i);
            } else {
                int32 j = 0;
                while (j < in.width()) {
                    if (in.nullableAt(j) && !in.colAt(j).validAt(i)) {
                        keep = false;
                    }
                    j = j + 1;
                }
            }
            if (keep) {
                idx[m] = i;
                m = m + 1;
            }
            i = i + 1;
        }
        DynCol[] out = heap DynCol[in.width()];
        int32 j = 0;
        while (j < in.width()) {
            // A null slot is a column the U7 scan pruned — carry it. (The
            // needed-column analysis never prunes a column this node's
            // validity walk reads.)
            if (in.colAt(j) != null) {
                out[j] #= in.colAt(j).gather(idx, m);
            }
            j = j + 1;
        }
        return in.rebuild(#out, m);
    }
}
