package cajeta.nucleo.frame;

import cajeta.lang.String;
import cajeta.nucleo.column.DynCol;

/**
 * DynFrame — the schema-agnostic column bag (nucleo-frame U5): parallel
 * name/tag/nullability arrays plus {@link DynCol} columns. Every
 * materialized `Table` carries one (typed accessors and the dyn store alias
 * the same storage); plan handles carry a full frame as their scan snapshot
 * and a SCHEMA-ONLY frame (`cols == null`, `rows == -1`) describing their
 * result — the `col("...")` accessor and `.as<R>()` validate against it at
 * plan-build, before anything executes.
 *
 * Physical tags are {@link DynCol}'s: 1 int8 .. 10 float64, 11 utf8.
 */
public class DynFrame {
    String[] names;
    int32[] tags;
    boolean[] nulls;
    DynCol[] cols;      // null on a schema-only frame
    int32 w;
    int64 rows;
    int64 zoneChunk;    // U13: zone-map chunk width in rows (0 = the default);
                        //   a source-table knob (`Table.zoneChunkRows`) carried
                        //   through aliasing to the scan snapshot
    String[] indexed;   // U14: names of columns carrying a B+ index (the
    int32 nIndexed;     //   `Table.indexColumn` knob), owned, carried on alias
    String spatialX;    // U15: the Z-order spatial pair (`Table.indexSpatial`);
    String spatialY;    //   null = no spatial index. Carried on alias.
    DynFrame backing;   // owned: a consumed input frame this frame's column
                        // aliases borrow from (Storage is single-owner —
                        // executors that alias must keep their input alive)

    public DynFrame(#String[] names, #int32[] tags, #boolean[] nulls,
                    #DynCol[] cols, int32 w, int64 rows) {
        this.names #= names;
        this.tags #= tags;
        this.nulls #= nulls;
        this.cols #= cols;
        this.w = w;
        this.rows = rows;
    }

    /** A SCHEMA-ONLY frame: no columns, no rows — what plan handles carry
     *  as their result description. */
    public DynFrame(#String[] names, #int32[] tags, #boolean[] nulls,
                    int32 w) {
        this.names #= names;
        this.tags #= tags;
        this.nulls #= nulls;
        this.w = w;
        this.rows = -1;
    }

    public int32 width() { return this.w; }
    public int64 rowsOf() { return this.rows; }
    public boolean isSchemaOnly() { return this.cols == null; }

    /** The zone-map chunk width in rows (0 = use the executor default). */
    public int64 zoneChunkOf() { return this.zoneChunk; }
    /** Set the zone-map chunk width (the `Table.zoneChunkRows` knob, U13). */
    public void setZoneChunk(int64 rows) { this.zoneChunk = rows; }

    /** Columns declared for a B+ index (U14). */
    public int32 indexedCount() { return this.nIndexed; }
    public String indexedAt(int32 i) { return this.indexed[i]; }

    /** Declare column `name` indexed (the `Table.indexColumn` knob, U14).
     *  Owned array, borrow-copied names — the meltNode convention; the source
     *  name strings outlive the query. Idempotent per name.
     *
     *  The element store is `#=`, not `=` (3.3.3). The intent was already
     *  "borrowed names" and `#=` is how that intent is WRITTEN rather than
     *  asserted in prose: it records the source's mode in the slot, so a lent
     *  name stays lent (unchanged behaviour) and a caller that spells
     *  `addIndexed(#n)` gets the name freed with the frame. A plain store
     *  offered neither guarantee — it kept the borrow with nothing recording
     *  it, which is what the check now rejects. */
    public void addIndexed(String name) {
        if (this.indexed == null) {
            this.indexed #= heap String[this.w];
            this.nIndexed = 0;
        }
        int32 i = 0;
        while (i < this.nIndexed) {
            if (this.indexed[i].equals(name)) { return; }
            i = i + 1;
        }
        if (this.nIndexed < this.w) {
            this.indexed[this.nIndexed] #= name;
            this.nIndexed = this.nIndexed + 1;
        }
    }

    /** The Z-order spatial pair (U15), or null if none. */
    public String spatialXOf() { return this.spatialX; }
    public String spatialYOf() { return this.spatialY; }

    /** Declare the Z-order spatial index over columns `x`, `y` (U15). */
    public void setSpatial(String x, String y) {
        // `#=` mirrors addIndexed's slot store: a lent name stays lent,
        // a `#`-passed name is owned by the frame (§2.3).
        this.spatialX #= x;
        this.spatialY #= y;
    }

    /** Copy `o`'s index declarations into this frame (alias carry). */
    void __copyIndexed(DynFrame o) {
        this.spatialX = o.spatialX;
        this.spatialY = o.spatialY;
        if (o.indexed == null) { return; }
        String[] c = heap String[o.w];
        int32 i = 0;
        while (i < o.nIndexed) { c[i] = o.indexed[i]; i = i + 1; }
        this.indexed #= c;
        this.nIndexed = o.nIndexed;
    }

    /** Ordinal-keyed cell reads (U13) — the zone-map builder summarizes a
     *  column by ordinal; these return primitives so no frame class names
     *  {@link DynCol} in a signature beyond DynFrame's own `colAt`. */
    public float64 f64AtCol(int32 c, int64 row) {
        return this.cols[c].f64At(row);
    }
    public int64 i64AtCol(int32 c, int64 row) {
        return this.cols[c].i64At(row);
    }
    public boolean validAtCol(int32 c, int64 row) {
        return this.cols[c].validAt(row);
    }

    public String nameAt(int32 i) { return this.names[i]; }
    public int32 tagAt(int32 i) { return this.tags[i]; }
    public boolean nullableAt(int32 i) { return this.nulls[i]; }
    public DynCol colAt(int32 i) { return this.cols[i]; }

    /** Flip column `i` non-nullable (the fillNull schema effect). */
    void clearNullable(int32 i) {
        this.nulls[i] = false;
    }

    /** Adopt a consumed input frame whose storage this frame's aliases
     *  borrow (U7): an executor that ALIASES its input's columns must keep
     *  that input alive exactly as long as itself — Storage is single-owner
     *  and views borrow. Chains transitively through `backing`. */
    void __adopt(#DynFrame f) {
        this.backing #= f;
    }

    /** Name-keyed cell reads (U8) — the `Table<?>` dynamic read surface.
     *  They live HERE rather than on Table so that Table never names
     *  {@link DynCol} in a signature: Table is instantiated per schema and
     *  can be built while the column package is still an archive
     *  placeholder, and a placeholder in a member signature resolves to
     *  nothing (the U5 cross-package lesson). DynFrame is schema-agnostic
     *  and already holds the columns, so the reference stays inside it. */
    int32 __require(String op, String name) {
        int32 i = this.find(name);
        if (i < 0) {
            throw heap FrameException("Table." + op + ": no column '" + name
                + "' in schema " + this.schemaText());
        }
        return i;
    }

    public float64 f64Named(String op, String name, int64 row) {
        return this.cols[this.__require(op, name)].f64At(row);
    }

    public int64 i64Named(String op, String name, int64 row) {
        return this.cols[this.__require(op, name)].i64At(row);
    }

    public #String strNamed(String op, String name, int64 row) {
        return this.cols[this.__require(op, name)].strAt(row);
    }

    public boolean validNamed(String op, String name, int64 row) {
        return this.cols[this.__require(op, name)].validAt(row);
    }

    /** Assemble an untyped frame from an external Arrow array set (U16, spec
     *  §10.3): each column imports zero-copy through {@link DynCol#importArrow}
     *  (the null-count airlock lives there); the physical tag and nullability
     *  are DERIVED from the imported columns, and lengths must agree. Column
     *  names are positional placeholders — Arrow field names are not read from
     *  the C schema (v1); the typed rebind (`importArrow<R>`) is positional and
     *  supplies the record's names. */
    public static #DynFrame fromArrow(int64[] schemas, int64[] arrays, int32 n) {
        String[] nm = heap String[n];
        int32[] tg = heap int32[n];
        boolean[] nl = heap boolean[n];
        DynCol[] dc = heap DynCol[n];
        int64 rows = -1;
        int32 i = 0;
        while (i < n) {
            DynCol c #= DynCol.importArrow(schemas[i], arrays[i]);
            int64 len = c.size();
            if (rows < 0) { rows = len; }
            else if (len != rows) {
                throw heap FrameException("Table.importArrow: column lengths "
                    + "disagree at the Arrow boundary");
            }
            nm[i] = "col";
            tg[i] = c.tagOf();
            nl[i] = c.isNullable();
            dc[i] #= c;
            i = i + 1;
        }
        if (rows < 0) { rows = 0; }
        return heap DynFrame(#nm, #tg, #nl, #dc, n, rows);
    }

    /** Export every column across the C Data Interface (U16, spec §10.2): one
     *  `{ArrowSchema, ArrowArray}` bundle address per column, over the live
     *  buffers (zero-copy borrow). Lives here (not on Table) so Table never
     *  names a column-package Arrow type in a signature — the U8 rule; the
     *  addresses are plain int64. */
    public #int64[] exportArrow() {
        int64[] addrs = heap int64[this.w];
        int32 i = 0;
        while (i < this.w) {
            addrs[i] = this.cols[i].exportArrow();
            i = i + 1;
        }
        return #addrs;
    }

    /** Ordinal of `name`, or -1. */
    public int32 find(String name) {
        int32 i = 0;
        while (i < this.w) {
            if (this.names[i].equals(name)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** The physical name at `i` — DynCol's vocabulary. */
    public #String typeNameAt(int32 i) {
        int32 t = this.tags[i];
        if (t == 1) { return "int8"; }
        if (t == 2) { return "int16"; }
        if (t == 3) { return "int32"; }
        if (t == 4) { return "int64"; }
        if (t == 5) { return "uint8"; }
        if (t == 6) { return "uint16"; }
        if (t == 7) { return "uint32"; }
        if (t == 8) { return "uint64"; }
        if (t == 9) { return "float32"; }
        if (t == 10) { return "float64"; }
        if (t == 11) { return "utf8"; }
        return "unknown";
    }

    /** `{ts: int64, price: float64, lastTrade: float64?}` — diagnostics. */
    public #String schemaText() {
        String s = "{";
        int32 i = 0;
        while (i < this.w) {
            if (i > 0) { s = s + ", "; }
            s = s + this.names[i] + ": " + this.typeNameAt(i);
            if (this.nulls[i]) { s = s + "?"; }
            i = i + 1;
        }
        return s + "}";
    }

    #String[] namesCopy() {
        String[] c = heap String[this.w];
        int32 i = 0;
        while (i < this.w) { c[i] = this.names[i]; i = i + 1; }
        return #c;
    }

    #int32[] tagsCopy() {
        int32[] c = heap int32[this.w];
        int32 i = 0;
        while (i < this.w) { c[i] = this.tags[i]; i = i + 1; }
        return #c;
    }

    #boolean[] nullsCopy() {
        boolean[] c = heap boolean[this.w];
        int32 i = 0;
        while (i < this.w) { c[i] = this.nulls[i]; i = i + 1; }
        return #c;
    }

    /** Zero-copy share: schema arrays copied, every column aliased. The
     *  chunk width carries forward — an alias is the same data as its origin,
     *  so the same zone-map chunking applies (U13). */
    public #DynFrame aliasFrame() {
        DynCol[] c = heap DynCol[this.w];
        int32 i = 0;
        while (i < this.w) { c[i] #= this.cols[i].alias(); i = i + 1; }
        DynFrame f = heap DynFrame(this.namesCopy(), this.tagsCopy(),
            this.nullsCopy(), #c, this.w, this.rows);
        f.zoneChunk = this.zoneChunk;
        f.__copyIndexed(this);
        return #f;
    }

    /** Schema without data: `cols == null`, `rows == -1`. */
    public #DynFrame schemaOnly() {
        return heap DynFrame(this.namesCopy(), this.tagsCopy(),
            this.nullsCopy(), this.w);
    }

    /** Same schema over new columns (the executor's result builder). */
    public #DynFrame rebuild(#DynCol[] cols, int64 rows) {
        return heap DynFrame(this.namesCopy(), this.tagsCopy(),
            this.nullsCopy(), #cols, this.w, rows);
    }

    /** A row window — zero-copy per column physics (DynCol.slice). */
    public #DynFrame sliceRows(int64 off, int64 len) {
        DynCol[] c = heap DynCol[this.w];
        int32 i = 0;
        while (i < this.w) { c[i] #= this.cols[i].slice(off, len); i = i + 1; }
        return heap DynFrame(this.namesCopy(), this.tagsCopy(),
            this.nullsCopy(), #c, this.w, len);
    }
}
