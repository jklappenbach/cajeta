package cajeta.nucleo.frame;

/**
 * ColStr — a utf8-typed column reference node (nucleo-frame U1). String
 * columns compare with `==`/`!=` against string literals, producing
 * {@link Pred} nodes; there is NO numeric comparison on a string column —
 * `c.venue() > 0.0` is a COMPILE error (no such operator), which is the
 * typed DSL's §3.2 claim doing its job.
 */
@AutoHash
public class ColStr {
    int32 ordinal;
    String name;

    ColStr(int32 ordinal, String name) {
        this.ordinal = ordinal;
        this.name = name;
    }

    /** A column reference (the synthesized builders call this). */
    public static #ColStr colRef(int32 ordinal, String name) {
        return heap ColStr(ordinal, name);
    }

    public int32 ordinal() { return this.ordinal; }
    public String name() { return this.name; }

    public static #Pred operator==(#ColStr a, String v) { return Pred.cmpStr(26, #a, v); }
    public static #Pred operator!=(#ColStr a, String v) { return Pred.cmpStr(27, #a, v); }
}
