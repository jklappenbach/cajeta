package cajeta.nucleo.sparse;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/**
 * Thrown by `cajeta.nucleo.sparse` on shape violations (COO index out of
 * range, vector length mismatch in SpMV) — normal, caller-handleable
 * conditions ({@link cajeta.math.linalg.LinAlgException}'s discipline).
 */
public class SparseException extends RecoverableException {
    public SparseException(#String message) {
        this.message = message;
        this.cause = 0;
    }
}
