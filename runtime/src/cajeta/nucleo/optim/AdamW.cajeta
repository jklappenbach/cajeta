package cajeta.nucleo.optim;

import cajeta.math.Tensor;
import cajeta.nucleo.nn.Parameter;

/**
 * AdamW (Loshchilov & Hutter) — Adam with DECOUPLED weight decay:
 * `p -= lr · ( m̂/(√v̂+ε) + weightDecay·p )`. The decay applies directly to
 * the parameter, NOT through the gradient/moment path — which is exactly how
 * it differs from Adam-plus-L2 (the moments never see the decay term).
 * Same β/ε and state discipline as {@link Adam}.
 */
public final class AdamW implements Optimizer {
    Parameter[] params;
    float32 lr;
    float32 weightDecay;
    Tensor<float32>[] m;
    Tensor<float32>[] v;
    float32 beta1Power;
    float32 beta2Power;
    boolean hasState;

    /** @EntryPoint */
    public AdamW(#Parameter[] params, float32 lr, float32 weightDecay) {
        this.params #= params;
        this.lr = lr;
        this.weightDecay = weightDecay;
        this.hasState = false;
        this.beta1Power = 1.0f;
        this.beta2Power = 1.0f;
    }

    public float32 getLr() { return this.lr; }
    public void setLr(float32 v) { this.lr = v; }

    public void step(Tensor<float32>[] grads) {
        Updates.validate(this.params, grads);
        int32 n = (int32) this.params.count();
        if (!this.hasState) {
            Tensor<float32>[] ms = heap Tensor<float32>[n];
            Tensor<float32>[] vs = heap Tensor<float32>[n];
            int32 j = 0;
            while (j < n) {
                ms[j] = Tensor.zerosLike<float32>(this.params[j].get());
                vs[j] = Tensor.zerosLike<float32>(this.params[j].get());
                j = j + 1;
            }
            this.m #= ms;
            this.v #= vs;
            this.hasState = true;
        }
        this.beta1Power = this.beta1Power * 0.9f;
        this.beta2Power = this.beta2Power * 0.999f;
        float32 c1 = 1.0f - this.beta1Power;
        float32 c2 = 1.0f - this.beta2Power;
        int32 i = 0;
        while (i < n) {
            AdamW.updateOne(this.params[i].get(), grads[i], this.m[i],
                            this.v[i], this.lr, this.weightDecay, c1, c2);
            i = i + 1;
        }
    }

    static void updateOne(Tensor<float32> p, Tensor<float32> g,
                          Tensor<float32> m, Tensor<float32> v,
                          float32 lr, float32 wd, float32 c1, float32 c2) {
        int64[] shape = Tensor.shapeOf<float32>(p);
        int32 nd = (int32) shape.count();
        int64 total = Tensor.productOf(shape);
        int64[] idx = heap int64[nd];
        int32 k = 0;
        while (k < nd) {
            idx[k] = 0;
            k = k + 1;
        }
        int64 lin = 0;
        while (lin < total) {
            float32 gv = g.getAt(idx);
            float32 mv = 0.9f * m.getAt(idx) + 0.1f * gv;
            float32 vv = 0.999f * v.getAt(idx) + 0.001f * gv * gv;
            m.setAt(idx, mv);
            v.setAt(idx, vv);
            float32 mhat = mv / c1;
            float32 vhat = vv / c2;
            float32 pv = p.getAt(idx);
            p.setAt(idx, pv - lr * (mhat / (Math.sqrt(vhat) + 1e-8f) + wd * pv));
            lin = lin + 1;
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= shape[ax]) {
                    idx[ax] = 0;
                    ax = ax - 1;
                } else {
                    carry = false;
                }
            }
        }
    }
}
