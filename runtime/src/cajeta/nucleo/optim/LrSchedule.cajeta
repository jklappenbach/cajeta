package cajeta.nucleo.optim;

/**
 * LrSchedule — the thin MUTATING wrapper over a pure schedule function
 * (spec §6.2; resolution N7): holds a borrowed optimizer, an explicit step
 * count (its own state, never a global), and a schedule selector.
 * `step()` advances the count and writes `lr(count)` into the optimizer;
 * `getLr()` reads the value actually in effect (§6.3).
 *
 * The CORE remains the pure functions in {@link Schedules} — this class only
 * packages "advance and apply" for the familiar `sched.step()` muscle
 * memory. Kinds: 0 = step decay, 1 = exponential, 2 = cosine,
 * 3 = warmup+cosine.
 */
public final class LrSchedule {
    Optimizer opt;
    int32 kind;
    float32 base;
    float32 gamma;
    int64 stepSize;
    int64 tMax;
    int64 warmupSteps;
    int64 count;

    LrSchedule(Optimizer opt, int32 kind, float32 base, float32 gamma,
               int64 stepSize, int64 tMax, int64 warmupSteps) {
        this.opt = opt;
        this.kind = kind;
        this.base = base;
        this.gamma = gamma;
        this.stepSize = stepSize;
        this.tMax = tMax;
        this.warmupSteps = warmupSteps;
        this.count = 0;
    }

    /** @EntryPoint */
    public static #LrSchedule stepDecay(Optimizer opt, float32 base,
                                        int64 stepSize, float32 gamma) {
        return heap LrSchedule(opt, 0, base, gamma, stepSize, 0, 0);
    }

    /** @EntryPoint */
    public static #LrSchedule exponential(Optimizer opt, float32 base,
                                          float32 gamma) {
        return heap LrSchedule(opt, 1, base, gamma, 0, 0, 0);
    }

    /** @EntryPoint */
    public static #LrSchedule cosine(Optimizer opt, float32 base, int64 tMax) {
        return heap LrSchedule(opt, 2, base, 0.0f, 0, tMax, 0);
    }

    /** @EntryPoint */
    public static #LrSchedule warmupCosine(Optimizer opt, float32 base,
                                           int64 warmupSteps, int64 tMax) {
        return heap LrSchedule(opt, 3, base, 0.0f, 0, tMax, warmupSteps);
    }

    /** Advance the schedule one step and apply the new LR to the optimizer. */
    public void step() {
        float32 lr = this.base;
        if (this.kind == 0) {
            lr = Schedules.stepLr(this.base, this.stepSize, this.gamma,
                                  this.count);
        }
        if (this.kind == 1) {
            lr = Schedules.exponentialLr(this.base, this.gamma, this.count);
        }
        if (this.kind == 2) {
            lr = Schedules.cosineLr(this.base, this.tMax, this.count);
        }
        if (this.kind == 3) {
            lr = Schedules.warmupCosineLr(this.base, this.warmupSteps,
                                          this.tMax, this.count);
        }
        this.opt.setLr(lr);
        this.count = this.count + 1;
    }

    /** The LR currently in effect on the wrapped optimizer. */
    public float32 getLr() {
        return this.opt.getLr();
    }
}
