        if (this.tag == 5) { return DynCol.ofNU8(this.__narrowNU8(#o, m)); }
        if (this.tag == 6) { return DynCol.ofNU16(this.__narrowNU16(#o, m)); }
        if (this.tag == 7) { return DynCol.ofNU32(this.__narrowNU32(#o, m)); }
        if (this.tag == 8) { return DynCol.ofNU64(this.__narrowNU64(#o, m)); }
        return DynCol.ofNI64(#o);
