package cajeta.nucleo.column;

import cajeta.lang.String;

/**
 * DynCol — the dynamically-typed column wrapper (nucleo-frame U5): one
 * variant over every physical the frame maps (`Column<int8..float64>`,
 * their `NullableColumn` forms, and utf8 `StringColumn`). The frame's
 * schema-agnostic machinery — the plan executor, the erased `Table<?>`
 * result store, the `col("...")` dynamic accessor — flows columns through
 * this wrapper; typed tables unwrap them zero-copy through the per-physical
 * `asXx()` accessors (refcounted aliases, never copies).
 *
 * Physical tags: 1 int8, 2 int16, 3 int32, 4 int64, 5 uint8, 6 uint16,
 * 7 uint32, 8 uint64, 9 float32, 10 float64, 11 utf8. `nullable` is an
 * orthogonal flag (utf8 is never nullable — no nullable-utf8 physical yet).
 *
 * Value reads: `f64At` widens any numeric to float64 (int64 values beyond
 * 2^53 lose precision — use `i64At` for exact integer reads), `i64At` reads
 * integer tags exactly, `strAt` reads utf8. A wrong-kind read is a named
 * {@link ColumnTypeException}, never a reinterpretation. Nullable columns
 * read their PHYSICAL value (validity is `validAt` — three-valued predicate
 * semantics land with nucleo-frame U6).
 */
public class DynCol {
    int32 tag;
    boolean nullable;
    Column<int8> i8;
    Column<int16> i16;
    Column<int32> i32;
    Column<int64> i64;
    Column<uint8> u8;
    Column<uint16> u16;
    Column<uint32> u32;
    Column<uint64> u64;
    Column<float32> f32;
    Column<float64> f64;
    StringColumn str;
    NullableColumn<int8> ni8;
    NullableColumn<int16> ni16;
    NullableColumn<int32> ni32;
    NullableColumn<int64> ni64;
    NullableColumn<uint8> nu8;
    NullableColumn<uint16> nu16;
    NullableColumn<uint32> nu32;
    NullableColumn<uint64> nu64;
    NullableColumn<float32> nf32;
    NullableColumn<float64> nf64;

    DynCol(int32 tag, boolean nullable) {
        this.tag = tag;
        this.nullable = nullable;
    }

    public static #DynCol ofI8(#Column<int8> c)      { DynCol d = heap DynCol(1, false);  d.i8 #= c;   return #d; }
    public static #DynCol ofI16(#Column<int16> c)    { DynCol d = heap DynCol(2, false);  d.i16 #= c;  return #d; }
    public static #DynCol ofI32(#Column<int32> c)    { DynCol d = heap DynCol(3, false);  d.i32 #= c;  return #d; }
    public static #DynCol ofI64(#Column<int64> c)    { DynCol d = heap DynCol(4, false);  d.i64 #= c;  return #d; }
    public static #DynCol ofU8(#Column<uint8> c)     { DynCol d = heap DynCol(5, false);  d.u8 #= c;   return #d; }
    public static #DynCol ofU16(#Column<uint16> c)   { DynCol d = heap DynCol(6, false);  d.u16 #= c;  return #d; }
    public static #DynCol ofU32(#Column<uint32> c)   { DynCol d = heap DynCol(7, false);  d.u32 #= c;  return #d; }
    public static #DynCol ofU64(#Column<uint64> c)   { DynCol d = heap DynCol(8, false);  d.u64 #= c;  return #d; }
    public static #DynCol ofF32(#Column<float32> c)  { DynCol d = heap DynCol(9, false);  d.f32 #= c;  return #d; }
    public static #DynCol ofF64(#Column<float64> c)  { DynCol d = heap DynCol(10, false); d.f64 #= c;  return #d; }
    public static #DynCol ofStr(#StringColumn c)     { DynCol d = heap DynCol(11, false); d.str #= c;  return #d; }
    public static #DynCol ofNI8(#NullableColumn<int8> c)     { DynCol d = heap DynCol(1, true);  d.ni8 #= c;  return #d; }
    public static #DynCol ofNI16(#NullableColumn<int16> c)   { DynCol d = heap DynCol(2, true);  d.ni16 #= c; return #d; }
    public static #DynCol ofNI32(#NullableColumn<int32> c)   { DynCol d = heap DynCol(3, true);  d.ni32 #= c; return #d; }
    public static #DynCol ofNI64(#NullableColumn<int64> c)   { DynCol d = heap DynCol(4, true);  d.ni64 #= c; return #d; }
    public static #DynCol ofNU8(#NullableColumn<uint8> c)    { DynCol d = heap DynCol(5, true);  d.nu8 #= c;  return #d; }
    public static #DynCol ofNU16(#NullableColumn<uint16> c)  { DynCol d = heap DynCol(6, true);  d.nu16 #= c; return #d; }
    public static #DynCol ofNU32(#NullableColumn<uint32> c)  { DynCol d = heap DynCol(7, true);  d.nu32 #= c; return #d; }
    public static #DynCol ofNU64(#NullableColumn<uint64> c)  { DynCol d = heap DynCol(8, true);  d.nu64 #= c; return #d; }
    public static #DynCol ofNF32(#NullableColumn<float32> c) { DynCol d = heap DynCol(9, true);  d.nf32 #= c; return #d; }
    public static #DynCol ofNF64(#NullableColumn<float64> c) { DynCol d = heap DynCol(10, true); d.nf64 #= c; return #d; }

    /** A fresh zero-filled float64 column — what computed expressions
     *  materialize into. Lives here (not in the executor) so the
     *  `Column<float64>` instantiation resolves in Column's OWN package —
     *  a cross-lazy-package instantiation can degrade to a wildcard
     *  handle while Column is still an archive placeholder. */
    public static #DynCol newF64(int64 n) {
        return DynCol.ofF64(Column.zeros<float64>(n));
    }

    /** Write a float64 cell (plain float64 columns only — the computed-
     *  column materialization loop). */
    public void setF64(int64 i, float64 v) {
        if (this.tag == 10 && !this.nullable) {
            this.f64.set(i, v);
            return;
        }
        throw heap ColumnTypeException(
            "DynCol.setF64: column is '" + this.typeName() + "'");
    }

    /** A fresh ALL-NULL nullable float64 column — what a computed
     *  expression over a nullable input materializes into (rows the
     *  expression can't produce stay null). */
    public static #DynCol newNF64(int64 n) {
        return DynCol.ofNF64(NullableColumn.nulls<float64>(n));
    }

    /** Write a float64 cell and mark it valid (nullable float64 columns
     *  only — the null-propagating computed-column loop). */
    public void setNF64(int64 i, float64 v) {
        if (this.tag == 10 && this.nullable) {
            this.nf64.set(i, v);
            return;
        }
        throw heap ColumnTypeException(
            "DynCol.setNF64: column is '" + this.typeName() + "'");
    }

    /** A fresh zeroed int64 column — what an EXACT integer aggregate
     *  (sum/min/max/first/last over an int64 column, and every `count`)
     *  materializes into (U8). Lives here for the same package-resolution
     *  reason as {@link #newF64}. */
    public static #DynCol newI64(int64 n) {
        return DynCol.ofI64(Column.zeros<int64>(n));
    }

    /** Write an int64 cell (plain int64 columns only). */
    public void setI64(int64 i, int64 v) {
        if (this.tag == 4 && !this.nullable) {
            this.i64.set(i, v);
            return;
        }
        throw heap ColumnTypeException(
            "DynCol.setI64: column is '" + this.typeName() + "'");
    }

    /** A fresh ALL-NULL nullable int64 column — an exact integer aggregate
     *  whose group may have no non-null cell (U8). */
    public static #DynCol newNI64(int64 n) {
        return DynCol.ofNI64(NullableColumn.nulls<int64>(n));
    }

    /** Write an int64 cell and mark it valid (nullable int64 only). */
    public void setNI64(int64 i, int64 v) {
        if (this.tag == 4 && this.nullable) {
            this.ni64.set(i, v);
            return;
        }
        throw heap ColumnTypeException(
            "DynCol.setNI64: column is '" + this.typeName() + "'");
    }

    /** A utf8 column over already-built values — what a `first`/`last`
     *  aggregate over a string column materializes into (U8). */
    public static #DynCol newStr(String[] values) {
        return DynCol.ofStr(StringColumn.of(values));
    }

    /** Dense NON-NULL copy with every null replaced by `v` (float
     *  physicals; integer physicals take {@link #fillNullsInt}). The
     *  spec §7 explicit fill — never an implicit coercion. */
    public #DynCol fillNulls(float64 v) {
        if (this.nullable) {
            if (this.tag == 9) { return DynCol.ofF32(this.nf32.fillNulls((float32) v)); }
            if (this.tag == 10) { return DynCol.ofF64(this.nf64.fillNulls(v)); }
        }
        throw heap ColumnTypeException(
            "DynCol.fillNulls: column is '" + this.typeName()
                + "' (nullable float physicals only)");
    }

    /** Dense NON-NULL copy with every null replaced by `v` (integer
     *  physicals — exact, no float64 round-trip). */
    public #DynCol fillNullsInt(int64 v) {
        if (this.nullable) {
            if (this.tag == 1) { return DynCol.ofI8(this.ni8.fillNulls((int8) v)); }
            if (this.tag == 2) { return DynCol.ofI16(this.ni16.fillNulls((int16) v)); }
            if (this.tag == 3) { return DynCol.ofI32(this.ni32.fillNulls((int32) v)); }
            if (this.tag == 4) { return DynCol.ofI64(this.ni64.fillNulls(v)); }
            if (this.tag == 5) { return DynCol.ofU8(this.nu8.fillNulls((uint8) v)); }
            if (this.tag == 6) { return DynCol.ofU16(this.nu16.fillNulls((uint16) v)); }
            if (this.tag == 7) { return DynCol.ofU32(this.nu32.fillNulls((uint32) v)); }
            if (this.tag == 8) { return DynCol.ofU64(this.nu64.fillNulls((uint64) v)); }
        }
        throw heap ColumnTypeException(
            "DynCol.fillNullsInt: column is '" + this.typeName()
                + "' (nullable integer physicals only)");
    }

    public int32 tagOf() { return this.tag; }
    public boolean isNullable() { return this.nullable; }

    /** The physical name — matches the frame's `colTypeAt` vocabulary. */
    public #String typeName() {
        if (this.tag == 1) { return "int8"; }
        if (this.tag == 2) { return "int16"; }
        if (this.tag == 3) { return "int32"; }
        if (this.tag == 4) { return "int64"; }
        if (this.tag == 5) { return "uint8"; }
        if (this.tag == 6) { return "uint16"; }
        if (this.tag == 7) { return "uint32"; }
        if (this.tag == 8) { return "uint64"; }
        if (this.tag == 9) { return "float32"; }
        if (this.tag == 10) { return "float64"; }
        if (this.tag == 11) { return "utf8"; }
        return "unknown";
    }

    public int64 size() {
        if (this.nullable) {
            if (this.tag == 1) { return this.ni8.size(); }
            if (this.tag == 2) { return this.ni16.size(); }
            if (this.tag == 3) { return this.ni32.size(); }
            if (this.tag == 4) { return this.ni64.size(); }
            if (this.tag == 5) { return this.nu8.size(); }
            if (this.tag == 6) { return this.nu16.size(); }
            if (this.tag == 7) { return this.nu32.size(); }
            if (this.tag == 8) { return this.nu64.size(); }
            if (this.tag == 9) { return this.nf32.size(); }
            if (this.tag == 10) { return this.nf64.size(); }
        }
        if (this.tag == 1) { return this.i8.size(); }
        if (this.tag == 2) { return this.i16.size(); }
        if (this.tag == 3) { return this.i32.size(); }
        if (this.tag == 4) { return this.i64.size(); }
        if (this.tag == 5) { return this.u8.size(); }
        if (this.tag == 6) { return this.u16.size(); }
        if (this.tag == 7) { return this.u32.size(); }
        if (this.tag == 8) { return this.u64.size(); }
        if (this.tag == 9) { return this.f32.size(); }
        if (this.tag == 10) { return this.f64.size(); }
        if (this.tag == 11) { return this.str.size(); }
        return 0;
    }

    /** A zero-copy share of the same storage (refcounted aliases). */
    public #DynCol alias() {
        if (this.nullable) {
            if (this.tag == 1) { return DynCol.ofNI8(this.ni8.alias()); }
            if (this.tag == 2) { return DynCol.ofNI16(this.ni16.alias()); }
            if (this.tag == 3) { return DynCol.ofNI32(this.ni32.alias()); }
            if (this.tag == 4) { return DynCol.ofNI64(this.ni64.alias()); }
            if (this.tag == 5) { return DynCol.ofNU8(this.nu8.alias()); }
            if (this.tag == 6) { return DynCol.ofNU16(this.nu16.alias()); }
            if (this.tag == 7) { return DynCol.ofNU32(this.nu32.alias()); }
            if (this.tag == 8) { return DynCol.ofNU64(this.nu64.alias()); }
            if (this.tag == 9) { return DynCol.ofNF32(this.nf32.alias()); }
            if (this.tag == 10) { return DynCol.ofNF64(this.nf64.alias()); }
        }
        if (this.tag == 1) { return DynCol.ofI8(this.i8.alias()); }
        if (this.tag == 2) { return DynCol.ofI16(this.i16.alias()); }
        if (this.tag == 3) { return DynCol.ofI32(this.i32.alias()); }
        if (this.tag == 4) { return DynCol.ofI64(this.i64.alias()); }
        if (this.tag == 5) { return DynCol.ofU8(this.u8.alias()); }
        if (this.tag == 6) { return DynCol.ofU16(this.u16.alias()); }
        if (this.tag == 7) { return DynCol.ofU32(this.u32.alias()); }
        if (this.tag == 8) { return DynCol.ofU64(this.u64.alias()); }
        if (this.tag == 9) { return DynCol.ofF32(this.f32.alias()); }
        if (this.tag == 10) { return DynCol.ofF64(this.f64.alias()); }
        if (this.tag == 11) { return DynCol.ofStr(this.str.alias()); }
        throw heap ColumnTypeException("DynCol.alias: unknown physical tag");
    }

    /** A row window — zero-copy for numeric physicals (Column.slice). */
    public #DynCol slice(int64 off, int64 len) {
        if (this.nullable) {
            if (this.tag == 1) { return DynCol.ofNI8(this.ni8.slice(off, len)); }
            if (this.tag == 2) { return DynCol.ofNI16(this.ni16.slice(off, len)); }
            if (this.tag == 3) { return DynCol.ofNI32(this.ni32.slice(off, len)); }
            if (this.tag == 4) { return DynCol.ofNI64(this.ni64.slice(off, len)); }
            if (this.tag == 5) { return DynCol.ofNU8(this.nu8.slice(off, len)); }
            if (this.tag == 6) { return DynCol.ofNU16(this.nu16.slice(off, len)); }
            if (this.tag == 7) { return DynCol.ofNU32(this.nu32.slice(off, len)); }
            if (this.tag == 8) { return DynCol.ofNU64(this.nu64.slice(off, len)); }
            if (this.tag == 9) { return DynCol.ofNF32(this.nf32.slice(off, len)); }
            if (this.tag == 10) { return DynCol.ofNF64(this.nf64.slice(off, len)); }
        }
        if (this.tag == 1) { return DynCol.ofI8(this.i8.slice(off, len)); }
        if (this.tag == 2) { return DynCol.ofI16(this.i16.slice(off, len)); }
        if (this.tag == 3) { return DynCol.ofI32(this.i32.slice(off, len)); }
        if (this.tag == 4) { return DynCol.ofI64(this.i64.slice(off, len)); }
        if (this.tag == 5) { return DynCol.ofU8(this.u8.slice(off, len)); }
        if (this.tag == 6) { return DynCol.ofU16(this.u16.slice(off, len)); }
        if (this.tag == 7) { return DynCol.ofU32(this.u32.slice(off, len)); }
        if (this.tag == 8) { return DynCol.ofU64(this.u64.slice(off, len)); }
        if (this.tag == 9) { return DynCol.ofF32(this.f32.slice(off, len)); }
        if (this.tag == 10) { return DynCol.ofF64(this.f64.slice(off, len)); }
        if (this.tag == 11) { return DynCol.ofStr(this.str.slice(off, len)); }
        throw heap ColumnTypeException("DynCol.slice: unknown physical tag");
    }

    /** Numeric read widened to float64 (int64/uint64 beyond 2^53 lose
     *  precision — `i64At` reads integers exactly). */
    public float64 f64At(int64 i) {
        if (this.nullable) {
            if (this.tag == 1) { return (float64) this.ni8.get(i); }
            if (this.tag == 2) { return (float64) this.ni16.get(i); }
            if (this.tag == 3) { return (float64) this.ni32.get(i); }
            if (this.tag == 4) { return (float64) this.ni64.get(i); }
            if (this.tag == 5) { return (float64) this.nu8.get(i); }
            if (this.tag == 6) { return (float64) this.nu16.get(i); }
            if (this.tag == 7) { return (float64) this.nu32.get(i); }
            if (this.tag == 8) { return (float64) this.nu64.get(i); }
            if (this.tag == 9) { return (float64) this.nf32.get(i); }
            if (this.tag == 10) { return this.nf64.get(i); }
        }
        if (this.tag == 1) { return (float64) this.i8.get(i); }
        if (this.tag == 2) { return (float64) this.i16.get(i); }
        if (this.tag == 3) { return (float64) this.i32.get(i); }
        if (this.tag == 4) { return (float64) this.i64.get(i); }
        if (this.tag == 5) { return (float64) this.u8.get(i); }
        if (this.tag == 6) { return (float64) this.u16.get(i); }
        if (this.tag == 7) { return (float64) this.u32.get(i); }
        if (this.tag == 8) { return (float64) this.u64.get(i); }
        if (this.tag == 9) { return (float64) this.f32.get(i); }
        if (this.tag == 10) { return this.f64.get(i); }
        throw heap ColumnTypeException(
            "DynCol.f64At: utf8 column read as numeric");
    }

    /** Exact integer read (integer tags only). */
    public int64 i64At(int64 i) {
        if (this.nullable) {
            if (this.tag == 1) { return (int64) this.ni8.get(i); }
            if (this.tag == 2) { return (int64) this.ni16.get(i); }
            if (this.tag == 3) { return (int64) this.ni32.get(i); }
            if (this.tag == 4) { return this.ni64.get(i); }
            if (this.tag == 5) { return (int64) this.nu8.get(i); }
            if (this.tag == 6) { return (int64) this.nu16.get(i); }
            if (this.tag == 7) { return (int64) this.nu32.get(i); }
            if (this.tag == 8) { return (int64) this.nu64.get(i); }
        }
        if (this.tag == 1) { return (int64) this.i8.get(i); }
        if (this.tag == 2) { return (int64) this.i16.get(i); }
        if (this.tag == 3) { return (int64) this.i32.get(i); }
        if (this.tag == 4) { return this.i64.get(i); }
        if (this.tag == 5) { return (int64) this.u8.get(i); }
        if (this.tag == 6) { return (int64) this.u16.get(i); }
        if (this.tag == 7) { return (int64) this.u32.get(i); }
        if (this.tag == 8) { return (int64) this.u64.get(i); }
        throw heap ColumnTypeException(
            "DynCol.i64At: non-integer column ('" + this.typeName()
                + "') read as int64");
    }

    /** Utf8 read (utf8 tag only). */
    public #String strAt(int64 i) {
        if (this.tag == 11) { return this.str.get(i); }
        throw heap ColumnTypeException(
            "DynCol.strAt: numeric column ('" + this.typeName()
                + "') read as utf8");
    }

    /** Row validity — always true on non-nullable physicals. */
    public boolean validAt(int64 i) {
        if (!this.nullable) { return true; }
        if (this.tag == 1) { return this.ni8.isValid(i); }
        if (this.tag == 2) { return this.ni16.isValid(i); }
        if (this.tag == 3) { return this.ni32.isValid(i); }
        if (this.tag == 4) { return this.ni64.isValid(i); }
        if (this.tag == 5) { return this.nu8.isValid(i); }
        if (this.tag == 6) { return this.nu16.isValid(i); }
        if (this.tag == 7) { return this.nu32.isValid(i); }
        if (this.tag == 8) { return this.nu64.isValid(i); }
        if (this.tag == 9) { return this.nf32.isValid(i); }
        if (this.tag == 10) { return this.nf64.isValid(i); }
        return true;
    }

    /** Row gather: a NEW column of the same physical holding rows
     *  `idx[0..m)` — the filter executor's core; validity gathers with the
     *  values on nullable physicals. */
    public #DynCol gather(int64[] idx, int64 m) {
        if (this.nullable) {
            if (this.tag == 1) {
                NullableColumn<int8> o = NullableColumn.nulls<int8>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.ni8.isValid(idx[i])) { o.set(i, this.ni8.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNI8(#o);
            }
            if (this.tag == 2) {
                NullableColumn<int16> o = NullableColumn.nulls<int16>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.ni16.isValid(idx[i])) { o.set(i, this.ni16.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNI16(#o);
            }
            if (this.tag == 3) {
                NullableColumn<int32> o = NullableColumn.nulls<int32>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.ni32.isValid(idx[i])) { o.set(i, this.ni32.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNI32(#o);
            }
            if (this.tag == 4) {
                NullableColumn<int64> o = NullableColumn.nulls<int64>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.ni64.isValid(idx[i])) { o.set(i, this.ni64.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNI64(#o);
            }
            if (this.tag == 5) {
                NullableColumn<uint8> o = NullableColumn.nulls<uint8>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.nu8.isValid(idx[i])) { o.set(i, this.nu8.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNU8(#o);
            }
            if (this.tag == 6) {
                NullableColumn<uint16> o = NullableColumn.nulls<uint16>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.nu16.isValid(idx[i])) { o.set(i, this.nu16.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNU16(#o);
            }
            if (this.tag == 7) {
                NullableColumn<uint32> o = NullableColumn.nulls<uint32>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.nu32.isValid(idx[i])) { o.set(i, this.nu32.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNU32(#o);
            }
            if (this.tag == 8) {
                NullableColumn<uint64> o = NullableColumn.nulls<uint64>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.nu64.isValid(idx[i])) { o.set(i, this.nu64.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNU64(#o);
            }
            if (this.tag == 9) {
                NullableColumn<float32> o = NullableColumn.nulls<float32>(m);
                int64 i = 0;
                while (i < m) {
                    if (this.nf32.isValid(idx[i])) { o.set(i, this.nf32.get(idx[i])); }
                    i = i + 1;
                }
                return DynCol.ofNF32(#o);
            }
            if (this.tag == 10) {
