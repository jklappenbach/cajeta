package cajeta.nucleo.column;

import cajeta.math.DType;
import cajeta.math.Storage;
import cajeta.math.Tensor;

/**
 * `Column<T>` — a typed, contiguous, Arrow-laid-out buffer of NON-NULL values
 * (nucleo-column-spec §1-§3): the physical substrate a dataframe column, a
 * tensor backing, and an interop buffer all share.
 *
 * The load-bearing invariant (spec §1.1): a `Column<T>` for numeric `T` IS a
 * tensor buffer — the same bytes, no marshalling. It is built as a window
 * over a rank-1 root `Tensor<T>` whose storage it owns: {@link #asTensor}
 * hands out a zero-copy view through the tensor engine's own view machinery
 * (shared `Storage`, drop-chain sound), and {@link #fromTensor} adopts a
 * contiguous rank-1 tensor's buffer the same way. There is NO validity
 * bitmap here and no validity branch in {@link #get} — nullability is a
 * different type (`NullableColumn<T>`, spec §3).
 *
 * OWNED buffers start at a 64-byte-aligned address: factories over-allocate
 * by one cache line and place the data at an aligned element offset inside
 * the storage (spec §6; the aligned-start-offset resolution). Adopted
 * (tensor-born) buffers keep their natural alignment — Arrow RECOMMENDS
 * 64-byte alignment but does not require it, so export stays legal.
 *
 * v1 admits fixed-width numerics `int8..int64`, `uint8..uint64`,
 * `float16..float64`. Excluded, by name ({@link ColumnTypeException}):
 * `boolean` (Arrow bit-packs bools; a byte-backed buffer would break the
 * bit-identity invariant) and 128-bit types (no canonical Arrow format).
 */
public class Column<T> {
    Tensor<T> root;    // rank-1 window host; owned storage (or adopted alias)
    int64 off;         // element offset of the aligned data start within root
    int64 len;         // logical element count
    // FOREIGN backing mode (spec 4.2, the Q-import resolution): an imported
    // column borrows the PRODUCER's buffer zero-copy. fData != 0 selects the
    // mode; fSchema/fArray hold the producer's structs so the destructor can
    // honor the release contract exactly once. Owned columns keep all three 0.
    int64 fData;
    int64 fSchema;
    int64 fArray;
    Storage<T> stage;  // foreign mode: 1-element staging slot for cast-free reads

    /**
     * Wrap a rank-1 root tensor. `root` is surrendered (`#`-moved) by the
     * factories — a fresh owned tensor, or an {@link Tensor#alias} of an
     * adopted one (the alias keeps the source's drop chain sound). Internal —
     * use the factories.
     */
    public Column(Tensor<T> root, int64 off, int64 len) {
        this.root #= root;
        this.off = off;
        this.len = len;
        this.fData = 0;
        this.fSchema = 0;
        this.fArray = 0;
        this.stage = null;
    }

    /**
     * FOREIGN-backed column over a producer's buffer (zero-copy borrow).
     * Passing schema/array 0 makes a release-less view (the validity half of
     * a nullable import — the data column owns the release). Internal — use
     * {@link #importArrow}.
     */
    public Column(int64 fData, int64 fSchema, int64 fArray, int64 len) {
        this.root = null;
        this.off = 0;
        this.len = len;
        this.fData = fData;
        this.fSchema = fSchema;
        this.fArray = fArray;
        this.stage #= heap Storage<T>(1);
    }

    /**
     * The cross-ABI ownership contract (spec 4.3): when a foreign-backed
     * column drops, the producer's releases run exactly once (destructor
     * fires once via the live-set claim; the released-marker null makes any
     * later call a no-op).
     */
    ~Column() {
        if (this.fArray != 0) {
            ArrowFfi f = stack ArrowFfi();
            f.callReleases(this.fSchema, this.fArray);
        }
    }

    // The v1 dtype gate. One place; import/export reuse it (plan U3/U4).
    static void admit<E>() {
        DType d = DType.of<E>();
        if (d.isBool() || d.bits() > 64) {
            throw heap ColumnTypeException(
                "Column v1 admits fixed-width numerics (int8..int64, "
                + "uint8..uint64, float16..float64); boolean and 128-bit "
                + "types are excluded");
        }
    }

    /** Aligned, zero-filled column of `n` elements. */
    public static #Column<E> zeros<E>(int64 n) {
        Column.admit<E>();
        int64 eb = (int64) DType.of<E>().bytes();
        // Over-allocate one cache line and start at the first 64-aligned
        // address. Malloc bases are >=8-aligned and eb is a power of two
        // <= 8, so (64 - rem) is an exact multiple of eb.
        int64[] shp = heap int64[1];
        shp[0] = n + 64 / eb;
        Tensor<E> root = Tensor.zeros<E>(shp);
        int64 rem = root.hostAddress() % 64;
        int64 off = 0;
        if (rem != 0) {
            off = (64 - rem) / eb;
        }
        return heap Column<E>(#root, off, n);
    }

    /** Aligned column holding a copy of `data` (spec 2.1). */
    public static #Column<E> of<E>(E[] data) {
        int64 n = (int64) data.count();
        Column<E> c = Column.zeros<E>(n);
        int64 i = 0;
        while (i < n) {
            c.set(i, data[(int32) i]);
            i = i + 1;
        }
        return #c;
    }

    /**
     * Adopt a contiguous rank-1 tensor's buffer ZERO-COPY (spec 7.4 inverse):
     * the column shares the tensor's `Storage` through an alias view. The
     * buffer keeps its natural alignment (recorded, legal).
     */
    public static #Column<E> fromTensor<E>(Tensor<E> t) {
        Column.admit<E>();
        if (t.ndim() != 1 || t.strideAt(0) != 1) {
            throw heap ColumnTypeException(
                "Column.fromTensor requires a contiguous rank-1 tensor");
        }
        Tensor<E> root = t.alias();
        return heap Column<E>(#root, 0, t.size());
    }

    /** Logical element count. */
    public int64 size() {
        return this.len;
    }

    /** Read element `i` — a direct indexed load, no validity branch (spec 2.3, 3.3). */
    public T get(int64 i) {
        if (this.fData != 0) {
            // Cast-free foreign read: byte-copy the element into the owned
            // 1-slot stage, read it back as a native T. (A `(T)` numeric
            // conversion here miscompiles under the `Column<?>` wildcard
            // instantiation's pointer-shaped sentinel.)
            ArrowFfi f = stack ArrowFfi();
            DType d = DType.of<T>();
            f.peekInto(this.fData, i, d.bytes(), this.stage.hostAddress());
            return this.stage.get(0);
        }
        return this.root.get1(this.off + i);
    }

    /** Write `v` to element `i`. Imported (foreign-backed) columns are
     *  read-only borrows — {@link #materialize} first. */
    public void set(int64 i, T v) {
        if (this.fData != 0) {
            throw heap ColumnTypeException(
                "an imported column is a read-only borrow of the producer's "
                + "buffer - materialize() an owned copy to write");
        }
        this.root.set1(this.off + i, v);
    }

    /**
     * ZERO-COPY tensor view of exactly this column's elements (spec 7.4) —
     * a slice of the root, so the tensor engine's view/drop machinery
     * applies unchanged. Writes are mutually visible; the column must
     * outlive the view (the `TensorProtocol` borrow discipline). A
     * FOREIGN-backed column has no tensor view (the compute boundary is an
     * explicit copy — the Q-import resolution): {@link #materialize} first.
     */
    public #Tensor<T> asTensor() {
        if (this.fData != 0) {
            throw heap ColumnTypeException(
                "a foreign-backed (imported) column has no zero-copy tensor "
                + "view - materialize() the owned copy first");
        }
        return this.root.slice(0, this.off, this.off + this.len);
    }

    /**
     * An OWNED, aligned, dense copy of this column — the explicit crossing
     * from a foreign borrow into the compute substrate (spec 4.2 as
     * narrowed; also a plain deep copy for owned columns).
     */
    public #Column<T> materialize() {
        Column<T> out = Column.zeros<T>(this.len);
        int64 i = 0;
        while (i < this.len) {
            out.set(i, this.get(i));
            i = i + 1;
        }
        return #out;
    }

    /**
     * ZERO-COPY whole-column view: a new column sharing this column's
     * storage (refcounted through {@link Tensor#alias}) over the same
     * window. The frame's lazy-plan scan snapshots columns through this —
     * building a plan handle copies no data. A FOREIGN-backed column has no
     * shareable root; alias falls back to {@link #materialize} (an owned
     * snapshot — foreign buffers cannot be refcount-shared).
     */
    public #Column<T> alias() {
        if (this.fData != 0) {
            return this.materialize();
        }
        Tensor<T> r = this.root.alias();
        return heap Column<T>(#r, this.off, this.len);
    }

    /**
     * ZERO-COPY row window: elements `[off, off+len)` as a storage-sharing
     * view (the `head(n)` terminal's substrate). Bounds are checked loud.
     * Foreign-backed columns materialize first (see {@link #alias}).
     */
    public #Column<T> slice(int64 off, int64 len) {
        if (off < 0 || len < 0 || off + len > this.len) {
            throw heap ColumnTypeException(
                "slice window out of range for this column");
        }
        if (this.fData != 0) {
            Column<T> m = this.materialize();
            return m.slice(off, len);
        }
        Tensor<T> r = this.root.alias();
        return heap Column<T>(#r, this.off + off, len);
    }

    /** Largest element (whole-column scalar reduction — a self-evident
     *  force, no collect() needed). Empty columns fail loud. */
    public T max() {
        if (this.len == 0) {
            throw heap ColumnTypeException("max() over an empty column");
        }
        T best = this.get(0);
        int64 i = 1;
        while (i < this.len) {
            T v = this.get(i);
            if (v > best) {
                best = v;
            }
            i = i + 1;
        }
        return best;
    }

    /** Smallest element. Empty columns fail loud. */
    public T min() {
        if (this.len == 0) {
            throw heap ColumnTypeException("min() over an empty column");
        }
        T best = this.get(0);
        int64 i = 1;
        while (i < this.len) {
            T v = this.get(i);
            if (v < best) {
                best = v;
            }
            i = i + 1;
        }
        return best;
    }

    /** Sum of all elements ((T) 0 for an empty column). */
    public T sum() {
        T acc = (T) 0;
        int64 i = 0;
        while (i < this.len) {
            acc = acc + this.get(i);
            i = i + 1;
        }
        return acc;
    }

    /** Data address of element 0 (Arrow interop / alignment probes; spec §6). */
    public int64 dataAddress() {
        if (this.fData != 0) {
            return this.fData;
        }
        return this.root.hostAddress()
             + this.off * ((int64) this.root.itemsize());
    }

    /**
     * The import airlock (spec 4.2, 3.5): wrap a producer's
     * `ArrowSchema`/`ArrowArray` pair ZERO-COPY as a `Column<?>` — callers
     * capture via `instanceof` + cast (the `Tensor.fromProtocol` idiom). An
     * array carrying nulls belongs to {@link NullableColumn#importArrow};
     * an unmodeled format or nonzero offset is a named error, never a
     * misread.
     */
    public static #Column<?> importArrow(int64 schemaAddr, int64 arrayAddr) {
        ArrowFfi f = stack ArrowFfi();
        if (f.readNullCount(arrayAddr) != 0) {
            throw heap ColumnTypeException(
                "array carries nulls (null_count > 0) - import it with "
                + "NullableColumn.importArrow (the type reflects the "
                + "physical reality)");
        }
        return Column.importForeign(schemaAddr, arrayAddr, 0);
    }

    // Shared airlock core: dtype-dispatch a foreign wrap. validityGuard 1
    // relaxes the null-count check (NullableColumn's path). Internal.
    static #Column<?> importForeign(int64 schemaAddr, int64 arrayAddr,
                                    int32 validityGuard) {
        ArrowFfi f = stack ArrowFfi();
        if (f.readOffset(arrayAddr) != 0) {
            throw heap ColumnTypeException(
                "nonzero ArrowArray.offset is not supported in v1");
        }
        int64 packed = f.readDtype(schemaAddr);
        if (packed < 0) {
            throw heap ColumnTypeException(
                "unknown or unmodeled Arrow format for a v1 fixed-width "
                + "column import");
        }
        int32 kind = (int32) (packed >> 8);
        int32 bits = (int32) (packed & 255);
        int64 data = f.readBuffer(arrayAddr, 1);
        int64 n = f.readLength(arrayAddr);
        if (kind == DType.KIND_INT) {
            if (bits == 8)  { return Column.wrapForeign<int8>(data, schemaAddr, arrayAddr, n); }
            if (bits == 16) { return Column.wrapForeign<int16>(data, schemaAddr, arrayAddr, n); }
            if (bits == 32) { return Column.wrapForeign<int32>(data, schemaAddr, arrayAddr, n); }
            return Column.wrapForeign<int64>(data, schemaAddr, arrayAddr, n);
        }
        if (kind == DType.KIND_UINT) {
            if (bits == 8)  { return Column.wrapForeign<uint8>(data, schemaAddr, arrayAddr, n); }
            if (bits == 16) { return Column.wrapForeign<uint16>(data, schemaAddr, arrayAddr, n); }
            if (bits == 32) { return Column.wrapForeign<uint32>(data, schemaAddr, arrayAddr, n); }
            return Column.wrapForeign<uint64>(data, schemaAddr, arrayAddr, n);
        }
        if (bits == 32) { return Column.wrapForeign<float32>(data, schemaAddr, arrayAddr, n); }
        return Column.wrapForeign<float64>(data, schemaAddr, arrayAddr, n);
    }

    static #Column<?> wrapForeign<E>(int64 data, int64 schemaAddr,
                                     int64 arrayAddr, int64 n) {
        return heap Column<E>(data, schemaAddr, arrayAddr, n);
    }

    /**
     * The Tensor retrofit's IMPORT half (spec §7.3 as narrowed): import a
     * foreign fixed-width array and cross the compute boundary in one step —
     * materialize an owned aligned copy, hand back its tensor view as
     * `Tensor<?>` (capture via instanceof + cast). One explicit copy; the
     * producer's releases fire when the transient foreign borrow drops.
     * Lives HERE rather than on `Tensor` because cajeta.math cannot import
     * this package (lazy-parse cycle: column -> math).
     */
    public static #Tensor<?> importAsTensor(int64 schemaAddr, int64 arrayAddr) {
        ArrowFfi f = stack ArrowFfi();
        if (f.readNullCount(arrayAddr) != 0) {
            throw heap ColumnTypeException(
                "array carries nulls - the dense tensor substrate needs an "
                + "explicit fill/drop through NullableColumn first");
        }
        int64 packed = f.readDtype(schemaAddr);
        if (packed < 0) {
            throw heap ColumnTypeException(
                "unknown or unmodeled Arrow format for a tensor import");
        }
        int32 kind = (int32) (packed >> 8);
        int32 bits = (int32) (packed & 255);
        if (kind == DType.KIND_INT) {
            if (bits == 8)  { return Column.importTensorTyped<int8>(schemaAddr, arrayAddr); }
            if (bits == 16) { return Column.importTensorTyped<int16>(schemaAddr, arrayAddr); }
            if (bits == 32) { return Column.importTensorTyped<int32>(schemaAddr, arrayAddr); }
            return Column.importTensorTyped<int64>(schemaAddr, arrayAddr);
        }
        if (kind == DType.KIND_UINT) {
            if (bits == 8)  { return Column.importTensorTyped<uint8>(schemaAddr, arrayAddr); }
            if (bits == 16) { return Column.importTensorTyped<uint16>(schemaAddr, arrayAddr); }
            if (bits == 32) { return Column.importTensorTyped<uint32>(schemaAddr, arrayAddr); }
            return Column.importTensorTyped<uint64>(schemaAddr, arrayAddr);
        }
        if (bits == 32) { return Column.importTensorTyped<float32>(schemaAddr, arrayAddr); }
        return Column.importTensorTyped<float64>(schemaAddr, arrayAddr);
    }

    static #Tensor<?> importTensorTyped<E>(int64 schemaAddr, int64 arrayAddr) {
        Column<?> w = Column.importForeign(schemaAddr, arrayAddr, 0);
        Column<E> c = (Column<E>) w;
        // Copy into a tensor that OWNS its storage outright — returning a
        // view of a column-owned root would dangle once the transient
        // column drops (the root has no owner but the doomed wrapper).
        int64 n = c.size();
        int64[] shp = heap int64[1];
        shp[0] = n;
        Tensor<E> t = Tensor.zeros<E>(shp);
        int64 i = 0;
        while (i < n) {
            t.set1(i, c.get(i));
            i = i + 1;
        }
        return #t;
    }

    // Instance @Native per the KernelBuffer precedent (generic class ->
    // instance dispatch); `this` is ignored on the C side.
    @Native("__cajeta_arrow_export_fixed")
    private int64 exportFixed(int64 dataAddr, int64 len, int64 nullCount,
                              int64 validityAddr, int32 kind, int32 bits);

    /**
     * The C Data Interface export (spec §4.1): the address of a C bundle
     * whose head is { ArrowSchema, ArrowArray } over this column's LIVE
     * buffers — a zero-copy BORROW (spec 4.4). The consumer's release frees
     * the struct shells only; this column must outlive the consumer's reads
     * (the `TensorProtocol` discipline: round-trip promptly).
     */
    public int64 exportArrow() {
        DType d = DType.of<T>();
        return this.exportFixed(this.dataAddress(), this.len, 0, 0,
                                d.kind(), d.bits());
    }
}
