package cajeta.nucleo.column;

/**
 * Package-internal bindings to the Arrow C Data Interface shims
 * (`runtime/native/cajeta_arrow.c`). Instance `@Native` methods on a
 * non-generic class (the `String.adopt` shape); call sites build a cheap
 * `stack ArrowFfi()` and read through it. Not part of the column API.
 */
public class ArrowFfi {
    public ArrowFfi() { }

    /** (kind << 8) | bits for a v1 fixed-width format; -1 when unmodeled. */
    @Native("__cajeta_arrow_read_dtype")
    public int64 readDtype(int64 schemaAddr);

    @Native("__cajeta_arrow_read_length")
    public int64 readLength(int64 arrayAddr);

    @Native("__cajeta_arrow_read_null_count")
    public int64 readNullCount(int64 arrayAddr);

    @Native("__cajeta_arrow_read_offset")
    public int64 readOffset(int64 arrayAddr);

    /** buffers[idx] as an address; 0 when absent/out of range. */
    @Native("__cajeta_arrow_read_buffer")
    public int64 readBuffer(int64 arrayAddr, int64 idx);

    /** Invoke the producer's releases (both structs, released-marker safe). */
    @Native("__cajeta_arrow_call_releases")
    public void callReleases(int64 schemaAddr, int64 arrayAddr);

    /** Copy element `i` (elemBytes wide) from a foreign buffer into `dst` —
     *  dtype-blind, so generic readers stay cast-free (wildcard-safe). */
    @Native("__cajeta_arrow_peek_into")
    public void peekInto(int64 dataAddr, int64 i, int32 elemBytes, int64 dst);

    /** 1 iff the schema's format is utf8 ("u"). */
    @Native("__cajeta_arrow_read_is_utf8")
    public int64 readIsUtf8(int64 schemaAddr);

    /** int32 offsets-buffer element (StringColumn is non-generic — direct
     *  typed returns are wildcard-safe there). */
    @Native("__cajeta_arrow_peek_i32")
    public int32 peekI32(int64 addr, int64 i);

    /** uint8 data-buffer byte, widened to int32. */
    @Native("__cajeta_arrow_peek_u8")
    public int32 peekU8(int64 addr, int64 i);

    /** Extension tag: 1 = cajeta.mxfp4, 0 = none, -1 = another extension. */
    @Native("__cajeta_arrow_read_ext_kind")
    public int64 readExtKind(int64 schemaAddr);

    /** MX block size from the extension metadata; 0 when absent. */
    @Native("__cajeta_arrow_read_ext_block")
    public int64 readExtBlock(int64 schemaAddr);

    /** The ARRAY struct's address within an export bundle whose head address is
     *  `bundleAddr` (the schema address is `bundleAddr` itself) — splits a
     *  bundle into the (schema, array) pair the import airlocks expect. */
    @Native("__cajeta_arrow_bundle_array")
    public int64 bundleArrayAddr(int64 bundleAddr);
}
