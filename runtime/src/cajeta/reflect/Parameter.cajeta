package cajeta.reflect;

import cajeta.lang.String;

/**
 * A single declared parameter of a {@link Method} or {@link Constructor}
 * (REFL-4). Holds a borrow of the owning class's RTTI plus the indices needed
 * to resolve its descriptor; the implicit `this` is excluded, so `index` is the
 * user-visible position.
 */
public final class Parameter {
    pointer rtti;
    int32 ownerIsCtor;   // 1 if the owning member is a constructor, else 0
    int32 ownerIndex;    // the method / constructor index
    int32 index;         // this parameter's user-visible position

    @Native("__cajeta_rtti_param_name_len")
    private static int32 nameLen(pointer rtti, int32 isCtor, int32 mIdx, int32 pIdx);
    @Native("__cajeta_rtti_param_name_into")
    private static void nameInto(pointer rtti, int32 isCtor, int32 mIdx, int32 pIdx, int8[] out);
    @Native("__cajeta_rtti_param_type_len")
    private static int32 typeLen(pointer rtti, int32 isCtor, int32 mIdx, int32 pIdx);
    @Native("__cajeta_rtti_param_type_into")
    private static void typeInto(pointer rtti, int32 isCtor, int32 mIdx, int32 pIdx, int8[] out);
    // REFL-6a annotation reflection. ownerKind 4 = parameter of a method,
    // 5 = parameter of a constructor (so ownerKind == 4 + ownerIsCtor); the
    // owning member index rides ownerIndex and this parameter's position subIndex.
    @Native("__cajeta_rtti_annotation_count")
    private static int32 annCountNative(pointer rtti, int32 ok, int32 oi, int32 si);
    @Native("__cajeta_rtti_annotation_name_len")
    private static int32 annNameLen(pointer rtti, int32 ok, int32 oi, int32 si, int32 ai);
    @Native("__cajeta_rtti_annotation_name_into")
    private static void annNameInto(pointer rtti, int32 ok, int32 oi, int32 si, int32 ai, int8[] out);

    public Parameter(pointer rtti, int32 ownerIsCtor, int32 ownerIndex, int32 index) {
        this.rtti = rtti;
        this.ownerIsCtor = ownerIsCtor;
        this.ownerIndex = ownerIndex;
        this.index = index;
    }

    /** This parameter's position in the user-visible signature (0-based). */
    public int32 getIndex() { return this.index; }

    /** The declared parameter name (e.g. `"x"`). */
    public #String getName() {
        int32 len = nameLen(this.rtti, this.ownerIsCtor, this.ownerIndex, this.index);
        int8[] out = heap int8[len];
        nameInto(this.rtti, this.ownerIsCtor, this.ownerIndex, this.index, out);
        return heap String(#out, len);
    }

    /** The canonical type name of this parameter (e.g. `"int32"`). */
    public #String getTypeName() {
        int32 len = typeLen(this.rtti, this.ownerIsCtor, this.ownerIndex, this.index);
        int8[] out = heap int8[len];
        typeInto(this.rtti, this.ownerIsCtor, this.ownerIndex, this.index, out);
        return heap String(#out, len);
    }

    // --- annotations (REFL-6a; names only — arguments are REFL-6b) ----------

    // Annotation ownerKind for a parameter: 4 = parameter of a method, 5 =
    // parameter of a constructor (mirrors the C resolver in cajeta_runtime.c).
    private int32 annOwnerKind() { return 4 + this.ownerIsCtor; }

    /** Number of annotations declared on this parameter. */
    public int32 getAnnotationCount() {
        return annCountNative(this.rtti, this.annOwnerKind(), this.ownerIndex, this.index);
    }

    /** Canonical name of this parameter's annotation at `i` (empty if out of range). */
    public #String getAnnotationName(int32 i) {
        int32 len = annNameLen(this.rtti, this.annOwnerKind(), this.ownerIndex, this.index, i);
        int8[] out = heap int8[len];
        annNameInto(this.rtti, this.annOwnerKind(), this.ownerIndex, this.index, i, out);
        return heap String(#out, len);
    }

    /** This parameter's annotation at `i` as an {@link Annotation} object. */
    public #Annotation getAnnotation(int32 i) {
        return heap Annotation(this.rtti, this.annOwnerKind(), this.ownerIndex, this.index, i);
    }

    /** Whether this parameter declares an annotation with the given canonical name. */
    public boolean hasAnnotation(String name) {
        int32 n = this.getAnnotationCount();
        int32 i = 0;
        while (i < n) {
            if (this.getAnnotationName(i).equals(name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}
