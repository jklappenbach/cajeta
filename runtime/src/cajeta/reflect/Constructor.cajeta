package cajeta.reflect;

import cajeta.lang.Object;

/**
 * A declared constructor of a class (REFL-4). Reflective construction routes
 * through the synthesized per-class heapInstance adapter (REFL-2C). The
 * no-argument path is here; argument marshalling lands next.
 */
public final class Constructor {
    pointer rtti;
    int32 index;

    @Native("__cajeta_rtti_constructor_param_count")
    private static int32 paramCountOf(pointer rtti, int32 idx);
    @Native("__cajeta_class_new0")
    private static #Object new0(pointer rtti, int32 idx);
    @Native("__cajeta_class_new")
    private static #Object newN(pointer rtti, int32 idx, int64[] args);

    public Constructor(pointer rtti, int32 index) {
        this.rtti = rtti;
        this.index = index;
    }

    public int32 getIndex() { return this.index; }

    /** Number of user-visible parameters (the implicit `this` is excluded). */
    public int32 getParameterCount() { return paramCountOf(this.rtti, this.index); }

    /** The parameter at `i` (0-based, user-visible). */
    public #Parameter getParameter(int32 i) {
        return heap Parameter(this.rtti, 1, this.index, i);
    }

    /**
     * Construct a new HEAP instance via this NO-ARGUMENT constructor (allocates
     * on the heap, installs the vtable, runs the ctor). Returns the new owned
     * object. Named `heapInstance` to make the allocation site explicit —
     * reflective construction is always heap (the type, hence its size and
     * escape, is unknown at the call site, so a stack alloca can't be emitted);
     * a future `stackInstance`/unsafe-placement form can join this namespace.
     */
    public #Object heapInstance() { return new0(this.rtti, this.index); }

    /**
     * Construct a HEAP instance via this constructor with raw arguments packed
     * into `args` (one int64 per user parameter, declared order). Returns the
     * new owned object.
     */
    public #Object heapInstance(int64[] args) {
        return newN(this.rtti, this.index, args);
    }
}
