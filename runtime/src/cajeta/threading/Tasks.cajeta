package cajeta.threading;

import cajeta.lang.Optional;
import cajeta.threading.Channel;
import cajeta.threading.SelectResult;
import cajeta.time.Duration;

/**
 * Task-related utilities. v1 surface: `withTimeout(Duration, Task<R>)` —
 * wait on a previously-spawned task with a deadline, reporting completion
 * vs. timeout via `Optional<R>`, and signalling cooperative cancellation
 * to the body on timeout.
 *
 * ## API shape
 *
 * The user spawns the task explicitly; withTimeout layers the timeout on
 * top of the existing await machinery:
 *
 *     Task<int32> t = spawn compute();
 *     Optional<int32> r = Tasks.withTimeout(Duration.ofMillis(50), t);
 *     if (r.isPresent()) { ... use r.get() ... } else { ... handle timeout ... }
 *
 * Two forms ship: the templated `withTimeout<R>(Duration, Task<R>) ->
 * #Optional<R>` (the canonical API; R is inferred from the Task<R>
 * arg) and an `int32` specialization `withTimeoutInt32` that predates
 * the generic form and remains for callers already pinned to it. New
 * code should prefer the templated form.
 *
 * A lambda-taking sibling shape — `withTimeout(d, () -> compute())` per
 * cajeta-docs/stdlib/Thread.md § withTimeout — works via spawn-of-lambda
 * (the caller wraps the call in a lambda and spawns it; the timeout
 * machinery layers on top, same as the pre-spawned-Task form).
 *
 * ## withTimeout semantics
 *
 * The function waits on the task's done flag with the supplied deadline.
 * The `Optional<R>` return reports whether the body finished inside the
 * deadline — `present` iff done flipped before the deadline expired,
 * `empty` otherwise.
 *
 * On timeout: the body is signalled for cooperative cancellation via
 * `Cajeta.taskCancel(t)` (R5-C — sets `cancel_with` on the task's fiber).
 * The body sees the cancellation at its next `await` and the runtime
 * throws the sentinel inside its frame. withTimeout then awaits the task
 * in a try/catch — bodies that yield short-circuit via the thrown
 * cancellation, bodies without yield points still run to natural
 * completion (no preemption). The exception is consumed inside withTimeout
 * so the empty Optional is the only observable signal.
 *
 * The surrounding scope still owns the task; the caller's scope drop
 * waits on the task's done flag before freeing. For cancellation to
 * shorten the wall-clock wait, body code must include at least one yield
 * point (await, channel receive, Lock.acquire, etc.). Pure CPU loops
 * with no yields are not interruptible in v1 — this matches the runtime
 * primitive (`__cajeta_task_wait_timeout` waits without preempting).
 */
public class Tasks {
    // Returns Optional<int32> by value (M3 sret/NRVO): the Optional is
    // constructed directly into the caller's slot, avoiding the heap
    // allocation a `#Optional<int32>` return would have required. The
    // caller's local declaration (`Optional<int32> r = Tasks.withTimeout...`)
    // owns the value-form slot under the normal scope-exit drop.
    public static Optional<int32> withTimeoutInt32(Duration d, Task<int32> t) {
        int64 deadline = Cajeta.currentTimeNanos() + d.toNanos();
        pointer done = Cajeta.taskDonePointer(t);
        int32 ok = Cajeta.taskWaitTimeout(done, deadline);
        if (ok != 1) {
            // Timeout: signal cooperative cancellation. The body sees this
            // at its next await; bodies without yield points still run to
            // completion.
            Cajeta.taskCancel(t);
        }
        // Await drains the body to settle. If the body was cancelled, the
        // await re-raises the sentinel; consume it here so callers only
        // see the empty Optional. The runtime clears task->exception on
        // re-raise so the enclosing scope drop doesn't re-propagate.
        int32 val = 0;
        try {
            val = await t;
        } catch (Exception e) {
        }
        if (ok == 1) {
            return stack Optional<int32>(true, val);
        }
        return stack Optional<int32>(false, val);
    }

    public static Optional<R> withTimeout<R>(Duration d, Task<R> t) {
        int64 deadline = Cajeta.currentTimeNanos() + d.toNanos();
        pointer done = Cajeta.taskDonePointer(t);
        int32 ok = Cajeta.taskWaitTimeout(done, deadline);
        if (ok == 1) {
            R val = await t;
            return stack Optional<R>(true, #val);
        }
        // Timeout — cancel cooperatively and drain. The await may throw
        // the cancellation sentinel; consume it so callers only see the
        // empty Optional. The runtime clears task->exception on re-raise
        // so the enclosing scope drop doesn't re-propagate.
        Cajeta.taskCancel(t);
        try {
            R drained = await t;
            return stack Optional<R>(false, drained);
        } catch (Exception e) {
        }
        // Body raised after cancel — task->value not safely readable.
        // `null` codegens as zero for primitive R, null ptr for class R;
        // the slot is unused on the empty path either way.
        return stack Optional<R>(false, null);
    }

    /**
     * Absolute-instant sibling of `withTimeout`. Same Optional<R>
     * reporting contract and same cooperative-cancellation semantics
     * (R5-C); differs only in how the deadline is expressed:
     * `withTimeout(d, t)` is `withDeadline(now + d, t)`.
     *
     * Useful when a higher-level operation already has a deadline budget
     * and wants to fan out sub-operations that share it (each
     * sub-operation passes the same absolute instant rather than
     * re-deriving a duration from "remaining budget").
     */
    public static Optional<R> withDeadline<R>(int64 deadlineNanos, Task<R> t) {
        pointer done = Cajeta.taskDonePointer(t);
        int32 ok = Cajeta.taskWaitTimeout(done, deadlineNanos);
        if (ok == 1) {
            R val = await t;
            return stack Optional<R>(true, #val);
        }
        Cajeta.taskCancel(t);
        try {
            R drained = await t;
            return stack Optional<R>(false, drained);
        } catch (Exception e) {
        }
        return stack Optional<R>(false, null);
    }

    /**
     * Sync→async bridge: spawn the user-supplied body on the carrier
     * pool, block the calling thread until it completes, return the
     * value. The caller need not already be inside an `async` method
     * or fiber — the runtime's `__cajeta_task_wait` falls through to a
     * condvar wait when there's no current fiber, so a plain
     * non-async `main` can use this to drive async work without itself
     * having to be `async`.
     *
     * v1 surface: primitive / value-return R via the spawn-of-lambda
     * ABI. Heap-class returns are not yet supported through this entry
     * point — `() -> #R` callers should keep using the explicit
     * `await spawn body()` pattern until the heap-form companion ships.
     */
    public static R runBlocking<R>(() -> R body) {
        Task<R> t = spawn body();
        return await t;
    }

    /**
     * Multiplexed receive across an array of channels — Go's
     * `select { case <- a: ...; case <- b: ... }` in a stdlib API
     * shape. Returns an `Optional<SelectResult<T>>`:
     *
     *   - present — wraps a `SelectResult<T>` with `index` set to the
     *     zero-based position of the channel that produced `value`.
     *     If multiple channels are ready in the same pass the lowest
     *     index wins (deterministic for v1; a future fairness pass
     *     can rotate the start).
     *   - empty — every channel was closed AND drained.
     *
     * v1 implementation: poll-and-backoff over `tryReceive()` /
     * `isClosed()`. Each pass tries every channel non-blocking; if all
     * empty and at least one is still open, the fiber sleeps via
     * `Cajeta.fiberSleepNanos` with exponential backoff (100us → 10ms
     * cap) before re-polling. The carrier is never held — sleeping
     * parks on the timer wheel, freeing the carrier to run other fibers.
     *
     * The backoff trades latency for CPU: a quiescent select wakes ~100
     * times/second under the cap, not thousands. Future versions can
     * register a per-channel waiter list and park on any of them
     * (one wake per send), eliminating the polling overhead entirely —
     * the API contract above stays unchanged.
     *
     * The Optional-of-SelectResult shape (rather than a SelectResult
     * with a sentinel `index == -1`) sidesteps a pre-existing codegen
     * quirk where `heap T<int32>(literal, null)` mis-positions the
     * primitive arg when T's second constructor parameter is primitive
     * and the user passes `null`. Wrapping in `Optional` means the
     * "no value" branch is `heap Optional<SelectResult<T>>(false, null)`
     * — SelectResult<T> is a class so `null` is type-natural here.
     */
    public static Optional<SelectResult<T>> selectReceive<T>(Channel<T>[] channels) {
        int64 backoff = 100000;
        while (true) {
            boolean any_open = false;
            for (int32 i = 0; i < channels.count(); i = i + 1) {
                Channel<T> ch = channels[i];
                Optional<T> r = ch.tryReceive();
                if (r.isPresent()) {
                    SelectResult<T> sr = heap SelectResult<T>(i, r.get());
                    return stack Optional<SelectResult<T>>(true, #sr);
                }
                if (!ch.isClosed()) {
                    any_open = true;
                }
            }
            if (!any_open) {
                return stack Optional<SelectResult<T>>(false, null);
            }
            Cajeta.fiberSleepNanos(backoff);
            if (backoff < 10000000) {
                backoff = backoff * 2;
            }
        }
    }
}
