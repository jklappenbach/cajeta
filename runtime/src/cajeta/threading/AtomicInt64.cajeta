package cajeta.threading;

/**
 * Atomic 64-bit signed integer — cajeta-docs/stdlib/Thread.md § Atomics.
 *
 * Same design as `AtomicInt32` (a heap cell + compiler-emitted inline LLVM
 * atomic instructions, all seq_cst in v1); see that class's doc for the
 * rationale and the v1 surface contract. The 64-bit variant matters for
 * sequence numbers, timestamps, and generation counters that overflow i32
 * under sustained traffic.
 */
public class AtomicInt64 {
    pointer cell;

    public AtomicInt64(int64 initial) {
        this.cell = Cajeta.atomicI64New(initial);
    }

    public ~AtomicInt64() {
        Cajeta.atomicI64Destroy(this.cell);
    }

    public int64 load() {
        return Cajeta.atomicI64Load(this.cell);
    }

    public void store(int64 v) {
        Cajeta.atomicI64Store(this.cell, v);
    }

    public int64 fetchAdd(int64 delta) {
        return Cajeta.atomicI64FetchAdd(this.cell, delta);
    }

    public boolean compareAndSet(int64 expected, int64 desired) {
        return Cajeta.atomicI64CompareAndSet(this.cell, expected, desired);
    }
}
