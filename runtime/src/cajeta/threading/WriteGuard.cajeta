package cajeta.threading;

/**
 * RAII guard for {@Link RwLock}'s exclusive write lock. Its destructor
 * releases the write lock, so it unlocks automatically at scope exit
 * (normal return or exception unwind, via the drop chain). Holds the raw
 * rwlock handle so its drop reaches the runtime release helper directly.
 *
 * See cajeta-docs/stdlib/Thread.md § Synchronization primitives.
 */
public class WriteGuard {
    public pointer handle;
    public WriteGuard(pointer handle) { this.handle = handle; }
    public ~WriteGuard() { Cajeta.rwlockWrunlock(this.handle); }
}
