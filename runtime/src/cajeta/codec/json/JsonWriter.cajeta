package cajeta.codec.json;

import cajeta.lang.String;

public final class JsonWriter {
    int8[] buf;
    int32 cap;
    int32 size;

    int8[] depthStack;
    boolean[] sibling;
    int32 depth;
    boolean afterKey;

    public JsonWriter() {
        this.cap = 64;
        this.buf = new int8[64];
        this.size = 0;
        this.depthStack = new int8[1024];
        this.sibling = new boolean[1024];
        this.depth = 0;
        this.afterKey = false;
    }

    public int32 size() {
        return this.size;
    }

    public JsonWriter beginObject() {
        this.maybeSeparator();
        this.append((int32) 123);
        this.pushFrame((int32) 1);
        return this;
    }

    public JsonWriter endObject() {
        this.append((int32) 125);
        this.popFrame();
        this.markSibling();
        return this;
    }

    public JsonWriter beginArray() {
        this.maybeSeparator();
        this.append((int32) 91);
        this.pushFrame((int32) 0);
        return this;
    }

    public JsonWriter endArray() {
        this.append((int32) 93);
        this.popFrame();
        this.markSibling();
        return this;
    }

    public JsonWriter writeNull() {
        this.maybeSeparator();
        this.append((int32) 110);
        this.append((int32) 117);
        this.append((int32) 108);
        this.append((int32) 108);
        this.markSibling();
        return this;
    }

    public JsonWriter writeBoolean(boolean v) {
        this.maybeSeparator();
        if (v) {
            this.append((int32) 116);
            this.append((int32) 114);
            this.append((int32) 117);
            this.append((int32) 101);
        } else {
            this.append((int32) 102);
            this.append((int32) 97);
            this.append((int32) 108);
            this.append((int32) 115);
            this.append((int32) 101);
        }
        this.markSibling();
        return this;
    }

    public JsonWriter writeNumber(int64 v) {
        this.maybeSeparator();
        if (v == (int64) 0) {
            this.append((int32) 48);
            this.markSibling();
            return this;
        }
        boolean negative = false;
        if (v < (int64) 0) {
            negative = true;
            v = - v;
        }
        int8[] tmp = new int8[20];
        int32 nd = 0;
        while (v > (int64) 0) {
            int64 d = v % (int64) 10;
            tmp[nd] = (int8) (d + (int64) 48);
            v = v / (int64) 10;
            nd = nd + 1;
        }
        if (negative) {
            this.append((int32) 45);
        }
        while (nd > 0) {
            nd = nd - 1;
            this.append((int32) tmp[nd]);
        }
        this.markSibling();
        return this;
    }

    // Float64 emitter. Always emits a decimal point so the value
    // round-trips as float64 (not int) through any JSON parser. v1
    // is a naive fixed-precision serializer: integer part via the
    // int64 digit loop above (inlined to avoid double maybeSeparator),
    // followed by '.' and up to 6 fractional digits. Doesn't yet emit
    // scientific notation for very large / very small magnitudes; that
    // lands when a real strtod-class formatter is wired through.
    public JsonWriter writeNumber(float64 v) {
        this.maybeSeparator();
        if (v == 0.0) {
            this.append((int32) 48);          // '0'
            this.append((int32) 46);          // '.'
            this.append((int32) 48);          // '0'
            this.markSibling();
            return this;
        }
        if (v < 0.0) {
            this.append((int32) 45);          // '-'
            v = - v;
        }
        // Integer part — copy of the int64 digit-accumulate loop so we
        // don't trigger maybeSeparator/markSibling twice.
        int64 intPart = (int64) v;
        float64 frac = v - (float64) intPart;
        if (intPart == (int64) 0) {
            this.append((int32) 48);
        } else {
            int8[] tmp = new int8[20];
            int32 nd = 0;
            while (intPart > (int64) 0) {
                int64 d = intPart % (int64) 10;
                tmp[nd] = (int8) (d + (int64) 48);
                intPart = intPart / (int64) 10;
                nd = nd + 1;
            }
            while (nd > 0) {
                nd = nd - 1;
                this.append((int32) tmp[nd]);
            }
        }
        this.append((int32) 46);              // '.'
        if (frac == 0.0) {
            this.append((int32) 48);
        } else {
            int32 digits = 6;
            while (digits > 0 && frac > 0.0) {
                frac = frac * 10.0;
                int32 d = (int32) frac;
                frac = frac - (float64) d;
                this.append((int32) (48 + d));
                digits = digits - 1;
            }
        }
        this.markSibling();
        return this;
    }

    // Byte-buffer + explicit length form. The String-typed overload
    // below is the user-friendly path; this one stays for the
    // synthesizer's hot-path emit code which already has the bytes
    // and byteLength in hand.
    public JsonWriter writeString(int8[] s, int32 n) {
        this.maybeSeparator();
        this.writeStringRaw(s, n);
        this.markSibling();
        return this;
    }

    // String-typed overload — delegates to the byte-buffer form
    // against the String's `.bytes` + `.byteLength` directly.
    // Preferred for hand-written user code.
    public JsonWriter writeString(String s) {
        return this.writeString(s.bytes, s.byteLength);
    }

    // Emit `"key":` (escapes `"` and `\` inside the key). Suppresses
    // the leading separator on the value that immediately follows.
    public JsonWriter key(int8[] name, int32 n) {
        this.maybeSeparator();
        this.writeStringRaw(name, n);
        this.append((int32) 58);
        this.markSibling();
        this.afterKey = true;
        return this;
    }

    // String-typed key overload. Same shape as writeString(String).
    public JsonWriter key(String name) {
        return this.key(name.bytes, name.byteLength);
    }

    /**
     * Emit `bytes[0..n)` verbatim — no quoting, no escaping, no
     * sibling marking adjustment beyond the standard separator
     * dance. The bytes MUST already be a syntactically valid JSON
     * value (quoted string, number, boolean, null, array, or
     * object). Used by the @JsonRaw synthesizer arm — the
     * captured bytes from `JsonReader.currentRawBytes()` are
     * passed through unchanged so the wire-form round-trip is
     * byte-stable.
     *
     * Callers are responsible for the bytes being valid JSON;
     * `writeRaw` doesn't validate (the parser will reject on
     * read-back if not).
     */
    public JsonWriter writeRaw(int8[] bytes, int32 n) {
        this.maybeSeparator();
        int32 i = 0;
        while (i < n) {
            this.append((int32) bytes[i]);
            i = i + 1;
        }
        this.markSibling();
        return this;
    }

    final void writeStringRaw(int8[] s, int32 n) {
        this.append((int32) 34);
        int32 i = 0;
        while (i < n) {
            int8 c = s[i];
            if (c == (int8) 34) {
                this.append((int32) 92);
                this.append((int32) 34);
            } else if (c == (int8) 92) {
                this.append((int32) 92);
                this.append((int32) 92);
            } else {
                this.append((int32) c);
            }
            i = i + 1;
        }
        this.append((int32) 34);
    }

    // Recursively emit a JsonValue tree. Routes by kind into the
    // existing scalar emitters; for objects + arrays walks members
    // and recurses. The writer's separator state takes care of
    // commas between siblings — the caller doesn't need to thread
    // anything.
    public JsonWriter writeValue(JsonValue v) {
        int32 k = v.kind();
        if (k == 0) {                                  // NULL
            return this.writeNull();
        }
        if (k == 1) {                                  // BOOLEAN
            return this.writeBoolean(v.asBoolean());
        }
        if (k == 2) {                                  // NUMBER
            return this.writeNumber(v.asInt64());
        }
        if (k == 3) {                                  // STRING
            return this.writeString(v.asBytes(), v.asBytesLength());
        }
        if (k == 4) {                                  // ARRAY
            JsonArray a = v.asArray();
            this.beginArray();
            int32 i = 0;
            while (i < a.count()) {
                this.writeValue(a.get(i));
                i = i + 1;
            }
            this.endArray();
            return this;
        }
        if (k == 5) {                                  // OBJECT
            JsonObject o = v.asObject();
            this.beginObject();
            int32 i = 0;
            while (i < o.count()) {
                this.key(o.keyAt(i), o.keyLenAt(i));
                this.writeValue(o.valueAt(i));
                i = i + 1;
            }
            this.endObject();
            return this;
        }
        // Unknown kind — treat as null to be forgiving.
        return this.writeNull();
    }

    public #int8[] toBytes() {
        int32 n = this.size;
        int8[] out = new int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.buf[i];
            i = i + 1;
        }
        this.size = 0;
        this.depth = 0;
        this.afterKey = false;
        return out;
    }

    void maybeSeparator() {
        if (this.afterKey) {
            this.afterKey = false;
            return;
        }
        if (this.depth > 0 && this.sibling[this.depth - 1]) {
            this.append((int32) 44);
        }
    }

    void markSibling() {
        if (this.depth > 0) {
            this.sibling[this.depth - 1] = true;
        }
    }

    final void pushFrame(int32 kind) {
        this.depthStack[this.depth] = (int8) kind;
        this.sibling[this.depth] = false;
        this.depth = this.depth + 1;
    }

    void popFrame() {
        this.depth = this.depth - 1;
        this.afterKey = false;
    }

    final void append(int8 b) {
        if (this.size >= this.cap) {
            this.grow();
        }
        this.buf[this.size] = b;
        this.size = this.size + 1;
    }

    void grow() {
        int32 newCap = this.cap * 2;
        int8[] dst = new int8[newCap];
        int32 i = 0;
        while (i < this.size) {
            dst[i] = this.buf[i];
            i = i + 1;
        }
        this.buf = dst;
        this.cap = newCap;
    }
}
