package cajeta.codec.json;

import cajeta.lang.String;
import cajeta.io.file.FileWriter;

/**
 * Streaming JSON encoder that builds wire-form bytes incrementally.
 *
 * `JsonWriter` owns a growable `int8[]` buffer and tracks nesting
 * depth and sibling state so callers never have to thread commas or
 * colons by hand. Every `begin*`/`end*`/`write*`/`key` method returns
 * `this`, so emission reads as a fluent chain. When the document is
 * complete, `toBytes` hands back the encoded bytes and resets the
 * writer for reuse.
 *
 * Scalars come in via `writeNull`, `writeBoolean`, `writeNumber`,
 * and `writeString` (the latter accepts a `String` directly). A
 * whole parsed tree can be re-emitted with `writeValue`, which walks
 * a `JsonValue` and its `JsonArray` / `JsonObject` children.
 *
 * ## Usage
 * ```cajeta
 * JsonWriter w = heap JsonWriter();
 * w.beginObject()
 *  .key("name").writeString("Ada")
 *  .key("age").writeNumber((int64) 36)
 *  .key("admin").writeBoolean(true)
 *  .endObject();
 * int8[] json #= w.toBytes();      // {"name":"Ada","age":36,"admin":true}
 * ```
 */
public final class JsonWriter {
    int8[] buf;
    int32 cap;
    int32 size;

    int8[] depthStack;
    boolean[] sibling;
    int32 depth;
    boolean afterKey;

    /**
     * Create an empty writer with a 64-byte buffer that grows on demand.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginArray().writeNumber((int64) 1).writeNumber((int64) 2).endArray();
     * int8[] json #= w.toBytes();   // [1,2]
     * ```
     */
    public JsonWriter() {
        this.cap = 64;
        this.buf = heap int8[64];
        this.size = 0;
        this.depthStack = heap int8[1024];
        this.sibling = heap boolean[1024];
        this.depth = 0;
        this.afterKey = false;
    }

    public int32 size() {
        return this.size;
    }

    /**
     * Open a JSON object (`{`), pushing a new nesting frame. Pair each
     * call with `endObject` and emit members as `key`/value pairs.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginObject().key("ok").writeBoolean(true).endObject();   // {"ok":true}
     * ```
     */
    public JsonWriter beginObject() {
        this.maybeSeparator();
        this.append((int32) 123);
        this.pushFrame((int32) 1);
        return this;
    }

    /** Close the current object (`}`) and pop its nesting frame. */
    public JsonWriter endObject() {
        this.append((int32) 125);
        this.popFrame();
        this.markSibling();
        return this;
    }

    /**
     * Open a JSON array (`[`), pushing a new nesting frame. Pair each
     * call with `endArray`; separators between elements are automatic.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginArray().writeString("a").writeString("b").endArray();   // ["a","b"]
     * ```
     */
    public JsonWriter beginArray() {
        this.maybeSeparator();
        this.append((int32) 91);
        this.pushFrame((int32) 0);
        return this;
    }

    /** Close the current array (`]`) and pop its nesting frame. */
    public JsonWriter endArray() {
        this.append((int32) 93);
        this.popFrame();
        this.markSibling();
        return this;
    }

    /** Emit a JSON `null` literal. */
    public JsonWriter writeNull() {
        this.maybeSeparator();
        this.append((int32) 110);
        this.append((int32) 117);
        this.append((int32) 108);
        this.append((int32) 108);
        this.markSibling();
        return this;
    }

    /** Emit a JSON `true` or `false` literal. */
    public JsonWriter writeBoolean(boolean v) {
        this.maybeSeparator();
        if (v) {
            this.append((int32) 116);
            this.append((int32) 114);
            this.append((int32) 117);
            this.append((int32) 101);
        } else {
            this.append((int32) 102);
            this.append((int32) 97);
            this.append((int32) 108);
            this.append((int32) 115);
            this.append((int32) 101);
        }
        this.markSibling();
        return this;
    }

    /**
     * Emit a signed integer in base-10 (e.g. `-42`).
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.writeNumber((int64) -42);   // -42
     * ```
     */
    public JsonWriter writeNumber(int64 v) {
        this.maybeSeparator();
        if (v == (int64) 0) {
            this.append((int32) 48);
            this.markSibling();
            return this;
        }
        boolean negative = false;
        if (v < (int64) 0) {
            negative = true;
            v = - v;
        }
        int8[] tmp = heap int8[20];
        int32 nd = 0;
        while (v > (int64) 0) {
            int64 d = v % (int64) 10;
            tmp[nd] = (int8) (d + (int64) 48);
            v = v / (int64) 10;
            nd = nd + 1;
        }
        if (negative) {
            this.append((int32) 45);
        }
        while (nd > 0) {
            nd = nd - 1;
            this.append((int32) tmp[nd]);
        }
        this.markSibling();
        return this;
    }

    /**
     * Emit a `float64`, always with a decimal point so the value
     * round-trips as a float (not an int) through any JSON parser.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.writeNumber(3.5);   // 3.5
     * ```
     *
     * v1 is a naive fixed-precision serializer: the integer part via
     * the `int64` digit loop above (inlined to avoid a double
     * `maybeSeparator`), followed by `.` and up to 6 fractional
     * digits. It does not yet emit scientific notation for very large
     * or very small magnitudes; that lands when a real strtod-class
     * formatter is wired through.
     */
    public JsonWriter writeNumber(float64 v) {
        this.maybeSeparator();
        if (v == 0.0) {
            this.append((int32) 48);          // '0'
            this.append((int32) 46);          // '.'
            this.append((int32) 48);          // '0'
            this.markSibling();
            return this;
        }
        if (v < 0.0) {
            this.append((int32) 45);          // '-'
            v = - v;
        }
        // Integer part — copy of the int64 digit-accumulate loop so we
        // don't trigger maybeSeparator/markSibling twice.
        int64 intPart = (int64) v;
        float64 frac = v - (float64) intPart;
        if (intPart == (int64) 0) {
            this.append((int32) 48);
        } else {
            int8[] tmp = heap int8[20];
            int32 nd = 0;
            while (intPart > (int64) 0) {
                int64 d = intPart % (int64) 10;
                tmp[nd] = (int8) (d + (int64) 48);
                intPart = intPart / (int64) 10;
                nd = nd + 1;
            }
            while (nd > 0) {
                nd = nd - 1;
                this.append((int32) tmp[nd]);
            }
        }
        this.append((int32) 46);              // '.'
        if (frac == 0.0) {
            this.append((int32) 48);
        } else {
            int32 digits = 6;
            while (digits > 0 && frac > 0.0) {
                frac = frac * 10.0;
                int32 d = (int32) frac;
                frac = frac - (float64) d;
                this.append((int32) (48 + d));
                digits = digits - 1;
            }
        }
        this.markSibling();
        return this;
    }

    /**
     * Emit a quoted, escaped JSON string from the first `n` bytes of
     * `s` (`"` and `\` are escaped). Byte-buffer + explicit length
     * form for the synthesizer's hot-path emit code, which already has
     * the bytes and length in hand; hand-written code should prefer
     * the `String` overload below.
     */
    public JsonWriter writeString(int8[] s, int32 n) {
        this.maybeSeparator();
        this.writeStringRaw(s, n);
        this.markSibling();
        return this;
    }

    /**
     * Emit a quoted, escaped JSON string from a `String` (delegates
     * to the byte-buffer form against `.bytes` + `.byteLength()`).
     * Preferred for hand-written user code.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.writeString("hi \"there\"");   // "hi \"there\""
     * ```
     */
    public JsonWriter writeString(String s) {
        if (s.root() == null || s.byteOffset() != (int64) 0) {
            int8[] w #= s.toBytes();
            return this.writeString(w, s.byteLength());
        }
        return this.writeString(s.root(), s.byteLength());
    }

    /**
     * Emit an object member name as `"key":` (escaping `"` and `\`
     * inside the key) and suppress the leading separator on the value
     * that immediately follows. Byte-buffer + length form; prefer the
     * `String` overload in hand-written code.
     */
    public JsonWriter key(int8[] name, int32 n) {
        this.maybeSeparator();
        this.writeStringRaw(name, n);
        this.append((int32) 58);
        this.markSibling();
        this.afterKey = true;
        return this;
    }

    /**
     * Emit an object member name from a `String`. Same shape as the
     * `String` `writeString` overload.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginObject().key("id").writeNumber((int64) 7).endObject();   // {"id":7}
     * ```
     */
    public JsonWriter key(String name) {
        if (name.root() == null || name.byteOffset() != (int64) 0) {
            int8[] w #= name.toBytes();
            return this.key(w, name.byteLength());
        }
        return this.key(name.root(), name.byteLength());
    }

    /**
     * Emit `bytes[0..n)` verbatim — no quoting, no escaping, no
     * sibling marking adjustment beyond the standard separator
     * dance. The bytes MUST already be a syntactically valid JSON
     * value (quoted string, number, boolean, null, array, or
     * object). Used by the @JsonRaw synthesizer arm — the
     * captured bytes from `JsonReader``.currentRawBytes()` are
     * passed through unchanged so the wire-form round-trip is
     * byte-stable.
     *
     * Callers are responsible for the bytes being valid JSON;
     * `writeRaw` doesn't validate (the parser will reject on
     * read-back if not).
     */
    public JsonWriter writeRaw(int8[] bytes, int32 n) {
        this.maybeSeparator();
        int32 i = 0;
        while (i < n) {
            this.append((int32) bytes[i]);
            i = i + 1;
        }
        this.markSibling();
        return this;
    }

    /** Write `"..."` for the first `n` bytes of `s`, escaping `"` and `\`. No separator handling. */
    final void writeStringRaw(int8[] s, int32 n) {
        this.append((int32) 34);
        int32 i = 0;
        while (i < n) {
            int8 c = s[i];
            if (c == (int8) 34) {
                this.append((int32) 92);
                this.append((int32) 34);
            } else if (c == (int8) 92) {
                this.append((int32) 92);
                this.append((int32) 92);
            } else {
                int32 u = (int32) c & 255;
                if (u < 32) {
                    // Control characters MUST be escaped (RFC 8259 §7):
                    // a raw newline in a string is invalid JSON, and it
                    // split a JSONL line in two before this landed. The
                    // named short escapes for the common five, \u00XX
                    // for the rest. UTF-8 continuation bytes are >= 128
                    // and never enter this branch.
                    this.append((int32) 92);
                    if (u == 10) {
                        this.append((int32) 110);          // \n
                    } else if (u == 13) {
                        this.append((int32) 114);          // \r
                    } else if (u == 9) {
                        this.append((int32) 116);          // \t
                    } else if (u == 8) {
                        this.append((int32) 98);           // \b
                    } else if (u == 12) {
                        this.append((int32) 102);          // \f
                    } else {
                        this.append((int32) 117);          // \u00XX
                        this.append((int32) 48);
                        this.append((int32) 48);
                        int32 hi = u >> 4;
                        int32 lo = u & 15;
                        this.append(hi < 10 ? 48 + hi : 87 + hi);
                        this.append(lo < 10 ? 48 + lo : 87 + lo);
                    }
                } else {
                    this.append(u);
                }
            }
            i = i + 1;
        }
        this.append((int32) 34);
    }

    /**
     * Recursively emit a parsed `JsonValue` tree. Routes by
     * `v.kind()` into the scalar emitters; for arrays and objects it
     * walks the `JsonArray` / `JsonObject` members and recurses.
     * Separator state handles commas between siblings, so the caller
     * threads nothing. An unknown kind is emitted as `null` to be
     * forgiving.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.writeValue(parsed);            // re-emits the tree as JSON
     * int8[] json #= w.toBytes();
     * ```
     */
    public JsonWriter writeValue(JsonValue v) {
        int32 k = v.kind();
        if (k == 0) {                                  // NULL
            return this.writeNull();
        }
        if (k == 1) {                                  // BOOLEAN
            return this.writeBoolean(v.asBoolean());
        }
        if (k == 2) {                                  // NUMBER
            if (v.isFloat()) {
                return this.writeNumber(v.asFloat64());
            }
            return this.writeNumber(v.asInt64());
        }
        if (k == 3) {                                  // STRING
            return this.writeString(v.asBytes(), v.asBytesLength());
        }
        if (k == 4) {                                  // ARRAY
            JsonArray a = v.array();
            this.beginArray();
            int32 i = 0;
            while (i < a.count()) {
                this.writeValue(a.get(i));
                i = i + 1;
            }
            this.endArray();
            return this;
        }
        if (k == 5) {                                  // OBJECT
            JsonObject o = v.object();
            this.beginObject();
            int32 i = 0;
            while (i < o.count()) {
                this.key(o.keyAt(i), o.keyLenAt(i));
                this.writeValue(o.valueAt(i));
                i = i + 1;
            }
            this.endObject();
            return this;
        }
        // Unknown kind — treat as null to be forgiving.
        return this.writeNull();
    }

    /**
     * Copy the encoded document out as a fresh heap `#int8[]` and
     * reset the writer (size, depth, and key state) so it can be
     * reused for the next document. Ownership of the returned bytes
     * transfers to the caller.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginArray().writeBoolean(true).endArray();
     * int8[] json #= w.toBytes();   // [true]  — w is now empty again
     * ```
     */
    public #int8[] toBytes() {
        int32 n = this.size;
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.buf[i];
            i = i + 1;
        }
        this.size = 0;
        this.depth = 0;
        this.afterKey = false;
        return out;
    }

    /**
     * Stream the encoded document straight to a `FileWriter` sink and
     * reset the writer for reuse — no intermediate `int8[]` allocation
     * (the internal buffer is reused across calls). Use this on a hot
     * path that emits many documents, where `toBytes`' per-call copy
     * would dominate.
     *
     * ```cajeta
     * JsonWriter w = heap JsonWriter();
     * w.beginObject().key("ok").writeBoolean(true).endObject();
     * w.writeTo(sink);   // {"ok":true} written; w is empty again
     * ```
     */
    public void writeTo(FileWriter sink) {
        int8[] b = this.buf;
        int32 sz = this.size;
        sink.write(b, sz);
        this.size = 0;
        this.depth = 0;
        this.afterKey = false;
    }

    /**
     * Like `writeTo`, but terminates the record with a newline — one
     * JSON value per line (JSON Lines / `.jsonl`). The newline is
     * appended into the reused buffer so the whole line is a single
     * `write`, and the writer is reset for the next record. This is the
     * primitive a JSONL logger sits on (see `JsonLinesWriter`).
     */
    public void writeLineTo(FileWriter sink) {
        this.append((int8) 10);
        int8[] b = this.buf;
        int32 sz = this.size;
        sink.write(b, sz);
        this.size = 0;
        this.depth = 0;
        this.afterKey = false;
    }

    /** Emit a `,` before a value when the current frame already has a sibling, unless we just wrote a key. */
    void maybeSeparator() {
        if (this.afterKey) {
            this.afterKey = false;
            return;
        }
        if (this.depth > 0 && this.sibling[this.depth - 1]) {
            this.append((int32) 44);
        }
    }

    /** Record that the current frame now has a value, so the next one is comma-separated. */
    void markSibling() {
        if (this.depth > 0) {
            this.sibling[this.depth - 1] = true;
        }
    }

    /** Push a nesting frame (`kind` 1 = object, 0 = array) with no sibling yet. */
    final void pushFrame(int32 kind) {
        this.depthStack[this.depth] = (int8) kind;
        this.sibling[this.depth] = false;
        this.depth = this.depth + 1;
    }

    /** Pop the current nesting frame and clear pending key state. */
    void popFrame() {
        this.depth = this.depth - 1;
        this.afterKey = false;
    }

    /** Append one byte, growing the buffer first if it is full. */
    final void append(int8 b) {
        if (this.size >= this.cap) {
            this.grow();
        }
        this.buf[this.size] = b;
        this.size = this.size + 1;
    }

    /** Double the buffer capacity and copy the existing bytes across. */
    void grow() {
        int32 newCap = this.cap * 2;
        int8[] dst = heap int8[newCap];
        int32 i = 0;
        while (i < this.size) {
            dst[i] = this.buf[i];
            i = i + 1;
        }
        this.buf #= dst;
        this.cap = newCap;
    }
}
