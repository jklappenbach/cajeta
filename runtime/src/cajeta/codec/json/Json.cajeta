package cajeta.codec.json;

import cajeta.lang.String;

/**
 * # `cajeta.codec.json.Json` — top-level JSON entry points
 *
 * Three tiers, choose by ergonomics-vs-speed tradeoff:
 *
 * | Tier | Entry point                    | Returns / takes    | When to use                              |
 * |------|--------------------------------|--------------------|------------------------------------------|
 * | 3    | `Json.parse(bytes, len)`       | `JsonValue` tree | Ad-hoc inspection, schema-less, mutation |
 * | 3    | `Json.toBytes(value)`          | `JsonValue` → bytes| Symmetric write-back of a value tree   |
 * | 1    | `Json.parse<T>(bytes, len)`    | `T` direct-binding | Known shape, want zero `JsonValue` alloc |
 * | 1    | `Json.toBytes<T>(value: T)`    | `T` → bytes        | Symmetric                                |
 * | 2    | `JsonReader`.next() / `JsonWriter` | tokens     | Hot path; full control over allocation   |
 *
 * Tier 1 is the **synthesizer**: the compiler walks T's declared
 * fields at the call site and emits a per-field key-dispatch
 * parse loop / sequential write chain. No JsonValue tree, no
 * runtime reflection.
 *
 * ## Tier 1 quick examples
 *
 * Define a class and round-trip it:
 *
 * ```cajeta
 * public class User {
 *     public int32 id;
 *     public String name;
 * }
 *
 * User u = heap User();
 * u.id = 7;
 * u.name = "alice";
 * int8[] bytes #= Json.toBytes<User>(u);        // {"id":7,"name":"alice"}
 * User v #= Json.parse<User>(bytes, (int64) bytes.count());
 * // Or directly from a String:
 * User w #= Json.parse<User>("{\"id\":7,\"name\":\"alice\"}");
 * ```
 *
 * ### Supported field types (Tier 1, v1)
 *
 * | Field type              | Read                          | Write                          |
 * |-------------------------|-------------------------------|--------------------------------|
 * | `int32`, `int64`        | NUMBER → int                  | int → NUMBER                   |
 * | `float64`               | NUMBER → float                | float → NUMBER                 |
 * | `boolean`               | `true`/`false` → bool         | bool → `true`/`false`          |
 * | `String`    | STRING → view-mode String     | bytes + length → STRING        |
 * | nested class            | recurses into `parseObjectFromReader<T>` | recurses into `toBytesObjectInto<T>` |
 * | `T[]` (primitive elem)  | `[...]` → fresh `T[]`         | iterate → `[...]`              |
 * | `T[]` (class elem)      | peek-dispatch + recursive parse | iterate + recursive emit     |
 *
 * ### Per-field annotations
 *
 * | Annotation                            | Effect                                                       |
 * |---------------------------------------|--------------------------------------------------------------|
 * | `@JsonProperty("wire_name")`          | Rename the wire key on both read and write                   |
 * | `@JsonIgnore`                         | Skip the field on both read and write                        |
 * | `@JsonRequired`                       | Throw `JsonParseException` on parse if the key is missing    |
 * | `@JsonAlias({"alt1", "alt2"})`        | Also accept these keys on read; write still uses primary key |
 * | `@JsonInclude("NON_NULL")`            | Omit the field on write when the reference is null           |
 *
 * Annotations compose. `@JsonProperty` + `@JsonRequired` checks the
 * renamed key; `@JsonProperty` overrides `@JsonNamingStrategy`;
 * `@JsonIgnore` wins over `@JsonRequired` (the field never appears,
 * so requiring it would never succeed).
 *
 * ### Class-level annotations
 *
 * | Annotation                                 | Effect                                                          |
 * |--------------------------------------------|-----------------------------------------------------------------|
 * | `@JsonNamingStrategy("SNAKE_CASE")`        | `firstName` → `first_name` for every un-renamed field           |
 * | `@JsonNamingStrategy("KEBAB_CASE")`        | `firstName` → `first-name` for every un-renamed field           |
 * | `@JsonStrict`                              | Throw on unknown keys at read time (default: silently consume)  |
 *
 * ### Worked example
 *
 * ```cajeta
 * @JsonNamingStrategy("SNAKE_CASE")
 * @JsonStrict
 * public class User {
 *     @JsonRequired
 *     public int32 id;
 *
 *     @JsonAlias({"username"})
 *     public String userName;          // wire key: "user_name" (or "username" on read)
 *
 *     @JsonProperty("display")          // overrides naming strategy
 *     public String displayName;
 *
 *     @JsonInclude("NON_NULL")
 *     public String email;              // omitted from output when null
 *
 *     @JsonIgnore
 *     public int32 sessionToken;        // never written, never read
 * }
 * ```
 *
 * ## Tier 3 — value tree
 *
 * Use when the shape isn't known at compile time, or for one-off
 * mutation:
 *
 * ```cajeta
 * JsonValue v #= Json.parse("{\"id\":1,\"name\":\"alice\"}");
 * int64 id = v.object().get("id").asInt64();         // 1
 * String name = v.object().get("name").asString();   // "alice"
 * ```
 *
 * ## Tier 2 — raw pull tokenizer
 *
 * When allocation matters: `JsonReader`.next() returns token codes
 * (`START_OBJECT` / `KEY` / `NUMBER` / etc.); accessor methods
 * (`currentNumberAsInt64()` / `currentBytes()` / ...) materialize
 * the just-read token. Symmetric writer surface is `JsonWriter`
 * (`beginObject()` / `key(bytes, len)` / `writeNumber(...)`).
 *
 * See `docs/specification/codec/json/Json.md` for the full design notes.
 */
public final class Json {

    /**
     * Tier-3 entry point — parse a JSON byte buffer into a mutable
     * `JsonValue` tree. Use when the shape isn't known at compile
     * time; for a known shape prefer the Tier-1 `Json.parse<T>` to
     * skip the tree allocation.
     *
     * ```cajeta
     * int8[] buf = ...;                              // raw UTF-8 JSON
     * JsonValue v #= Json.parse(buf, (int64) buf.count());
     * int64 id = v.object().get("id").asInt64();
     * ```
     *
     * Throws `JsonParseException` on malformed input.
     *
     * @EntryPoint
     */
    public static #JsonValue parse(int8[] bytes, int64 length) {
        JsonReader r = heap JsonReader(bytes, length);
        return r.readValue();
    }

    /**
     * Tier-3 String overload. Delegates to the byte-buffer entry
     * point against the `String`'s UTF-8 payload directly — no copy,
     * no re-encoding, since `String` already stores
     * the bytes the parser wants.
     *
     * ```cajeta
     * JsonValue v #= Json.parse("{\"id\":1,\"name\":\"alice\"}");
     * ```
     *
     * @EntryPoint
     */
    public static #JsonValue parse(String s) {
        if (s.root() == null || s.byteOffset() != (int64) 0) {
            int8[] w #= s.toBytes();
            return Json.parse(w, (int64) s.byteLength());
        }
        return Json.parse(s.root(), (int64) s.byteLength());
    }

    /**
     * Tier-3 emit — serialize a `JsonValue` tree back to a fresh
     * JSON byte buffer. Symmetric counterpart of `Json.parse`.
     *
     * ```cajeta
     * JsonValue v #= Json.parse("{\"id\":1}");
     * int8[] out #= Json.toBytes(v);                 // {"id":1}
     * ```
     *
     * @EntryPoint
     */
    public static #int8[] toBytes(JsonValue value) {
        JsonWriter w = heap JsonWriter();
        w.writeValue(value);
        return w.toBytes();
    }

    /**
     * Tier 1 codegen entry point — parses JSON bytes into a `T`-typed
     * value by synthesizing per-T parse code at the call site. The
     * captured body here is a failsafe: if the compiler-side
     * synthesizer (Phase 4b in MethodTemplateInstantiator) doesn't
     * engage, callers see this throw rather than silently get back
     * default-zeroed objects.
     *
     * v1 supports a class T with primitive fields and (eventually)
     * nested classes / arrays / annotation-driven naming. The synthesis
     * walks T's declared field list and emits a key-dispatch loop
     * against JsonReader.
     *
     * ```cajeta
     * int8[] buf #= Json.toBytes<User>(u);
     * User v #= Json.parse<User>(buf, (int64) buf.count());
     * ```
     *
     * Throws `JsonParseException` if the synthesizer fails to engage.
     *
     * See docs/specification/codec/json/Json.md § Tier 1.
     *
     * @EntryPoint
     */
    // Tier-1 templated parse. Coexists with the Tier-3 `parse(int8[],
    // int64)` above — the resolver distinguishes by the call site's
    // explicit-type-args presence: `Json.parse(buf, n)` routes to
    // Tier-3 (returns JsonValue); `Json.parse<T>(buf, n)` routes here
    // (returns T via synthesizer).
    public static T parse<T>(int8[] bytes, int64 length) {
        throw heap JsonParseException(
            "Json.parse<T>: synthesizer not engaged", (int64) 0);
    }

    /**
     * Tier-1 String overload — convenience entry point that takes a
     * `String` and forwards to the byte-buffer Tier-1
     * variant. The synthesizer matches by name AND param-type
     * signature; this overload's `(String)` shape does NOT match
     * `(int8[], int64)`, so the body below is preserved verbatim and
     * the user gets `Json.parse<T>(jsonString)` as a clean API.
     *
     * ```cajeta
     * User u #= Json.parse<User>("{\"id\":7,\"name\":\"alice\"}");
     * ```
     *
     * @EntryPoint
     */
    public static T parse<T>(String s) {
        if (s.root() == null || s.byteOffset() != (int64) 0) {
            int8[] w #= s.toBytes();
            return Json.parse<T>(w, (int64) s.byteLength());
        }
        return Json.parse<T>(s.root(), (int64) s.byteLength());
    }

    /**
     * Tier 1 helper — read a T from an EXISTING JsonReader position.
     * The synthesizer expects the reader to be positioned such that
     * the next `r.next()` call returns START_OBJECT for T's body.
     *
     * Used internally to recurse into nested class fields without
     * creating a new JsonReader. Public so the synthesizer can emit
     * cross-class instantiation calls (the wrapper class context
     * doesn't otherwise have access to private helpers).
     */
    public static T parseObjectFromReader<T>(JsonReader r) {
        throw heap JsonParseException(
            "Json.parseObjectFromReader<T>: synthesizer not engaged", (int64) 0);
    }

    /**
     * Tier-1 binding walk — consume one object value of type T at the
     * cursor `jc.ci`, return a freshly-allocated T, and advance `jc.ci`
     * past the object. This is the synthesizer's stage-2 deserialization
     * driver: it runs straight over the SIMD structural index built by
     * `JsonIndex.build`, dispatching on the one byte at each index position
     * with NO per-token `JsonReader.next()` call boundary — that is what
     * carries the SIMD scan throughput to the binding (2-3x Jackson vs the
     * pull reader's 0.4x). The walk state rides a single `JsonCursor`
     * pointer so the recursive instantiation stays codegen-stable. Public
     * so the synthesizer can emit cross-class recursive calls.
     *
     * See docs/specification/codec/json/Json.md § Tier 1 and plans/Json-fast-path.md.
     */
    public static T walkValue<T>(JsonCursor jc) {
        throw heap JsonParseException(
            "Json.walkValue<T>: synthesizer not engaged", (int64) 0);
    }

    /**
     * Thin delegating wrapper used for nested-class ARRAY elements. It does
     * nothing but forward to `walkValue<T>`, yet the indirection is load-
     * bearing: a synthesized `walkValue<Outer>` that recursively
     * instantiates `walkValue<Element>` AT A CALL SITE INSIDE ITS ARRAY
     * LOOP produces malformed IR (an undefined SSA value — the outer
     * function's codegen state is clobbered by the same-template
     * re-entrant instantiation). Routing the in-loop element call through a
     * DIFFERENTLY-named template (`walkElement`, which instantiates
     * `walkValue<Element>` at its own top level, not in a loop) breaks that
     * pattern — exactly how the old `parseObjectFromReader` path stayed
     * stable. Nested-class SCALAR fields call `walkValue` directly (their
     * recursion isn't in a loop, so they're unaffected).
     */
    public static T walkElement<T>(JsonCursor jc) {
        return Json.walkValue<T>(jc);
    }

    /**
     * Tier 1 emit — symmetric counterpart of parse<T>. Coexists with
     * Tier-3 `toBytes(JsonValue)` via the same template-vs-overload
     * disambiguation as parse.
     *
     * ```cajeta
     * User u = heap User();
     * u.id = 7;
     * int8[] bytes #= Json.toBytes<User>(u);         // {"id":7,...}
     * ```
     *
     * @EntryPoint
     */
    public static int8[] toBytes<T>(T value) {
        throw heap JsonParseException(
            "Json.toBytes<T>: synthesizer not engaged", (int64) 0);
    }

    /**
     * Tier 1 helper — emit T into an EXISTING JsonWriter. Writes
     * beginObject / fields / endObject. Used internally to recurse
     * into nested class fields, sharing the parent's JsonWriter so
     * the nested bytes interleave correctly with the outer ones.
     */
    public static void toBytesObjectInto<T>(JsonWriter w, T value) {
        throw heap JsonParseException(
            "Json.toBytesObjectInto<T>: synthesizer not engaged", (int64) 0);
    }
}
