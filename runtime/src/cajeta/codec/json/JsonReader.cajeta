package cajeta.codec.json;

import cajeta.lang.String;

/**
 * Pull tokenizer for RFC 8259 JSON. Walks an int8[] input buffer
 * once forward, emitting one JsonToken-ordinal per next() call.
 * String and number tokens are recorded as byte-offset spans into
 * the input buffer (tokenStart, tokenEnd) without materialization
 * — the caller pays the parse/decode cost only when it asks for a
 * concrete value (Phase 2).
 *
 * See cajeta-docs/stdlib/codec/Json.md § Tier 2.
 *
 * v1 (Phase 1) scope:
 *  - Structural tokenization for objects, arrays, separators.
 *  - Primitive literal tokens (true / false / null) with span.
 *  - Number tokenization (span only — value parsing Phase 2).
 *  - String tokenization (span only — content decoding Phase 2).
 *  - Strict RFC 8259 (no relaxed comments / trailing commas yet).
 *
 * Length is passed explicitly because arrays don't yet expose a
 * `.length` property in this stdlib (Java/Cajeta arrays know their
 * size; the accessor just hasn't landed). Callers writing a one-
 * shot parse pass `(buf, buf.length)` once the property lands.
 *
 * Token ordinals (matching the JsonToken enum):
 *   0 START_OBJECT  1 END_OBJECT  2 START_ARRAY  3 END_ARRAY
 *   4 KEY           5 STRING      6 NUMBER       7 BOOLEAN
 *   8 NULL          9 END
 */
public class JsonReader {
    int8[] input;
    int64 length;
    int64 pos;
    int64 tokenStart;
    int64 tokenEnd;
    int32 current;
    boolean currentBool;

    // Depth + per-frame state for the container nesting walk.
    // depthStack[i] = 0 for array, 1 for object.
    // frameState[i] = 0 (freshly opened), 1 (post-value), 2 (post-separator).
    int8[] depthStack;
    int8[] frameState;
    int32 depth;
    int32 maxDepth;

    // After a KEY token + ':' consumption, the next next() call
    // produces the value; that one value is not separator-gated.
    boolean afterKey;

    // One-token lookahead state. `peek()` advances by one token and
    // caches it; the very next `next()` call returns the cached token
    // instead of advancing again. Callers can `peek()` multiple times
    // in a row — every call after the first is idempotent until
    // `next()` consumes the cached value. The Tier-1 synthesizer
    // uses this to dispatch a nested-class array's elements: peek
    // either END_ARRAY (consume and exit loop) or START_OBJECT
    // (leave cached so the recursive `parseObjectFromReader<T>` sees
    // it as the first token of the inner parse).
    int32 peekedToken;
    boolean hasPeeked;

    public JsonReader(int8[] input, int64 length) {
        this.input = input;
        this.length = length;
        this.pos = 0;
        this.tokenStart = 0;
        this.tokenEnd = 0;
        this.current = 9;          // END (matches JsonToken.END ordinal)
        this.currentBool = false;
        this.maxDepth = 1024;
        this.depthStack = new int8[1024];
        this.frameState = new int8[1024];
        this.depth = 0;
        this.afterKey = false;
        this.peekedToken = 9;      // END placeholder
        this.hasPeeked = false;
    }

    /**
     * Lookahead by one token without consuming it. Subsequent
     * `peek()` calls return the same cached token. The very next
     * `next()` call returns the cached token (advancing past it);
     * all later `next()` calls advance from the buffer normally.
     *
     * Use case: dispatch on token kind at a position the recursive
     * parser also expects to start at — e.g. nested-class array
     * iteration where the loop peeks each element's leading token,
     * exits on `END_ARRAY`, and otherwise hands off to a recursive
     * `parseObjectFromReader<T>` that will itself read the
     * `START_OBJECT`.
     */
    public int32 peek() {
        if (this.hasPeeked) {
            return this.peekedToken;
        }
        int32 t = this.next();
        this.peekedToken = t;
        this.hasPeeked = true;
        return t;
    }

    public int32 current() {
        return this.current;
    }

    public int64 position() {
        return this.pos;
    }

    public int64 tokenStart() {
        return this.tokenStart;
    }

    public int64 tokenEnd() {
        return this.tokenEnd;
    }

    public boolean currentBoolean() {
        return this.currentBool;
    }

    public int32 next() {
        // Consume a cached peek if there is one — peek() already
        // advanced the buffer position past the underlying token.
        if (this.hasPeeked) {
            this.hasPeeked = false;
            this.current = this.peekedToken;
            return this.peekedToken;
        }
        this.skipWs();

        if (this.pos >= this.length) {
            if (this.depth != 0) {
                throw heap JsonParseException(
                    "unexpected end of input inside container",
                    this.pos);
            }
            this.current = 9;       // END
            return 9;
        }

        // In a container and NOT in the value-position right after a
        // key: handle separator / close before reading the next item.
        if (this.depth > 0) {
            if (!this.afterKey) {
                int8 frame = this.depthStack[this.depth - 1];
                int8 state = this.frameState[this.depth - 1];
                int8 c = this.input[this.pos];

                // Close brackets short-circuit (valid in both
                // freshly-opened and post-value states).
                if (frame == (int8) 0 && c == (int8) 93) {
                    return this.consumeClose(3);    // END_ARRAY
                }
                if (frame == (int8) 1 && c == (int8) 125) {
                    return this.consumeClose(1);    // END_OBJECT
                }

                // Post-value: must see a separator before the next item.
                if (state == (int8) 1) {
                    if (c != (int8) 44) {
                        throw heap JsonParseException(
                            "expected ',' or container close",
                            this.pos);
                    }
                    this.pos = this.pos + 1;
                    this.frameState[this.depth - 1] = (int8) 2;
                    this.skipWs();
                    if (this.pos >= this.length) {
                        throw heap JsonParseException(
                            "unexpected end of input after separator",
                            this.pos);
                    }
                }
            }

            // Object frame outside the key-value gap: read a key.
            if (!this.afterKey
                    && this.depthStack[this.depth - 1] == (int8) 1) {
                return this.scanKey();
            }
        }

        this.afterKey = false;
        int8 c2 = this.input[this.pos];

        if (c2 == (int8) 123) {              // '{'
            return this.openContainer((int8) 1, 0);   // START_OBJECT
        }
        if (c2 == (int8) 91) {               // '['
            return this.openContainer((int8) 0, 2);   // START_ARRAY
        }
        if (c2 == (int8) 34) {               // '"'
            this.scanStringSpan();
            this.markValueProduced();
            this.current = 5;                // STRING
            return 5;
        }
        if (c2 == (int8) 45
                || (c2 >= (int8) 48 && c2 <= (int8) 57)) {
            this.scanNumberSpan();
            this.markValueProduced();
            this.current = 6;                // NUMBER
            return 6;
        }
        if (c2 == (int8) 116) {              // 't'
            this.expectLiteral4((int8) 116, (int8) 114,
                                (int8) 117, (int8) 101);
            this.currentBool = true;
            this.markValueProduced();
            this.current = 7;                // BOOLEAN
            return 7;
        }
        if (c2 == (int8) 102) {              // 'f'
            this.expectLiteral5((int8) 102, (int8) 97,
                                (int8) 108, (int8) 115,
                                (int8) 101);
            this.currentBool = false;
            this.markValueProduced();
            this.current = 7;                // BOOLEAN
            return 7;
        }
        if (c2 == (int8) 110) {              // 'n'
            this.expectLiteral4((int8) 110, (int8) 117,
                                (int8) 108, (int8) 108);
            this.markValueProduced();
            this.current = 8;                // NULL
            return 8;
        }

        throw heap JsonParseException("unexpected character", this.pos);
    }

    int32 openContainer(int8 kind, int32 token) {
        if (this.depth >= this.maxDepth) {
            throw heap JsonParseException(
                "nesting depth limit exceeded",
                this.pos);
        }
        this.depthStack[this.depth] = kind;
        this.frameState[this.depth] = (int8) 0;
        this.depth = this.depth + 1;
        this.tokenStart = this.pos;
        this.pos = this.pos + 1;
        this.tokenEnd = this.pos;
        this.current = token;
        return token;
    }

    int32 consumeClose(int32 token) {
        this.pos = this.pos + 1;
        this.depth = this.depth - 1;
        this.markValueProduced();
        this.tokenStart = this.pos - 1;
        this.tokenEnd = this.pos;
        this.current = token;
        return token;
    }

    void skipWs() {
        while (this.pos < this.length) {
            int8 c = this.input[this.pos];
            if (c == (int8) 32
                    || c == (int8) 9
                    || c == (int8) 10
                    || c == (int8) 13) {
                this.pos = this.pos + 1;
            } else {
                return;
            }
        }
    }

    int32 scanKey() {
        if (this.input[this.pos] != (int8) 34) {
            throw heap JsonParseException(
                "expected '\"' to begin object key",
                this.pos);
        }
        this.scanStringSpan();
        this.skipWs();
        if (this.pos >= this.length || this.input[this.pos] != (int8) 58) {
            throw heap JsonParseException(
                "expected ':' after object key",
                this.pos);
        }
        this.pos = this.pos + 1;
        this.afterKey = true;
        this.current = 4;        // KEY
        return 4;
    }

    void scanStringSpan() {
        this.pos = this.pos + 1;     // past opening '"'
        this.tokenStart = this.pos;
        while (this.pos < this.length) {
            int8 c = this.input[this.pos];
            if (c == (int8) 34) {
                this.tokenEnd = this.pos;
                this.pos = this.pos + 1;
                return;
            }
            if (c == (int8) 92) {
                this.pos = this.pos + 2;
                if (this.pos > this.length) {
                    throw heap JsonParseException(
                        "unterminated escape sequence",
                        this.pos);
                }
            } else {
                this.pos = this.pos + 1;
            }
        }
        throw heap JsonParseException(
            "unterminated string",
            this.pos);
    }

    void scanNumberSpan() {
        this.tokenStart = this.pos;
        this.pos = this.pos + 1;
        while (this.pos < this.length) {
            int8 c = this.input[this.pos];
            boolean isDigit = c >= (int8) 48 && c <= (int8) 57;
            boolean isDot = c == (int8) 46;
            boolean isExp = c == (int8) 101 || c == (int8) 69;
            boolean isSign = c == (int8) 43 || c == (int8) 45;
            if (isDigit || isDot || isExp || isSign) {
                this.pos = this.pos + 1;
            } else {
                this.tokenEnd = this.pos;
                return;
            }
        }
        this.tokenEnd = this.pos;
    }

    void expectLiteral4(int8 b0, int8 b1, int8 b2, int8 b3) {
        if (this.pos + 4 > this.length) {
            throw heap JsonParseException("truncated literal", this.pos);
        }
        if (this.input[this.pos] != b0
                || this.input[this.pos + 1] != b1
                || this.input[this.pos + 2] != b2
                || this.input[this.pos + 3] != b3) {
            throw heap JsonParseException("invalid literal", this.pos);
        }
        this.tokenStart = this.pos;
        this.pos = this.pos + 4;
        this.tokenEnd = this.pos;
    }

    void expectLiteral5(int8 b0, int8 b1, int8 b2, int8 b3, int8 b4) {
        if (this.pos + 5 > this.length) {
            throw heap JsonParseException("truncated literal", this.pos);
        }
        if (this.input[this.pos] != b0
                || this.input[this.pos + 1] != b1
                || this.input[this.pos + 2] != b2
                || this.input[this.pos + 3] != b3
                || this.input[this.pos + 4] != b4) {
            throw heap JsonParseException("invalid literal", this.pos);
        }
        this.tokenStart = this.pos;
        this.pos = this.pos + 5;
        this.tokenEnd = this.pos;
    }

    void markValueProduced() {
        if (this.depth > 0) {
            this.frameState[this.depth - 1] = (int8) 1;
        }
    }

    // --- Phase 2: materialization helpers ---------------------------

    // Copy the current token's bytes into a fresh int8[]. Works for
    // KEY, STRING, NUMBER, and the literal-spanning tokens (BOOLEAN /
    // NULL). For string tokens the escape sequences are NOT decoded
    // — they appear verbatim (\n stays as the two bytes '\\','n').
    // String-escape decoding lands when needed.
    public #int8[] currentBytes() {
        int32 len = (int32) (this.tokenEnd - this.tokenStart);
        int8[] out = new int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = this.input[this.tokenStart + (int64) i];
            i = i + 1;
        }
        return out;
    }

    /**
     * Copy the current token's bytes INCLUDING the wire-form
     * delimiters. For STRING / KEY tokens that means the
     * surrounding `"` quotes; for NUMBER / BOOLEAN / NULL it's
     * identical to `currentBytes()` since those tokens have no
     * outer delimiters. Used by the @JsonRaw synthesizer arm —
     * the captured bytes must round-trip through
     * `JsonWriter.writeRaw` and re-parse as the same JSON value.
     *
     * Object / array values aren't span-captureable from a single
     * token (their tokens are the structural braces; the
     * interior is a series of nested tokens). v1 @JsonRaw covers
     * primitive token values only; nested-span capture is a
     * follow-up that requires walking the inner-token tree.
     *
     * Detection of "is this a STRING/KEY token" uses the raw
     * input byte immediately preceding the token start: if it's
     * `"` (0x22), we include both quotes; otherwise the span is
     * unchanged.
     */
    public #int8[] currentRawBytes() {
        int64 start = this.tokenStart;
        int64 end = this.tokenEnd;
        // Probe for an enclosing pair of quotes.
        boolean quoted = false;
        if (start > 0 && end < this.length) {
            if (this.input[start - 1] == (int8) 34
                    && this.input[end] == (int8) 34) {
                quoted = true;
            }
        }
        int64 effStart = quoted ? (start - 1) : start;
        int64 effEnd = quoted ? (end + 1) : end;
        int32 len = (int32) (effEnd - effStart);
        int8[] out = new int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = this.input[effStart + (int64) i];
            i = i + 1;
        }
        return out;
    }

    /**
     * Materialize the current token's bytes as a `cajeta.lang.String`
     * view. The String's `bytes` field points at a fresh int8[] copy
     * of the token (same copy `currentBytes()` makes); the
     * `byteLength` reflects the token's span.
     *
     * Use this when the caller wants a String for ergonomics —
     * comparison, passing to other APIs, building a key map. The
     * hot-path tokenizer code keeps using `currentBytes()` directly
     * to avoid the wrapper allocation.
     */
    public #String currentString() {
        int8[] bytes = this.currentBytes();
        return heap String(bytes, (int32) bytes.count());
    }

    // Parse the current NUMBER token's integer span as int64. v1 only
    // handles signed integers (leading '-' optional). Floats throw
    // JsonParseException — proper float parsing lands when the
    // runtime gains a strtod-equivalent helper.
    public int64 currentNumberAsInt64() {
        int64 i = this.tokenStart;
        int64 end = this.tokenEnd;
        if (i >= end) {
            throw heap JsonParseException(
                "empty number token", this.tokenStart);
        }
        boolean negative = false;
        if (this.input[i] == (int8) 45) {       // '-'
            negative = true;
            i = i + 1;
            if (i >= end) {
                throw heap JsonParseException(
                    "bare '-' is not a number", this.tokenStart);
            }
        }
        int64 acc = 0;
        while (i < end) {
            int8 c = this.input[i];
            if (c < (int8) 48 || c > (int8) 57) {
                throw heap JsonParseException(
                    "non-integer number (v1 doesn't parse floats)",
                    i);
            }
            int64 d = (int64) (c - (int8) 48);
            acc = acc * (int64) 10 + d;
            i = i + 1;
        }
        if (negative) {
            return - acc;
        }
        return acc;
    }

    // Convenience: parse as int32 by delegating to int64 + downcast.
    // Overflow check is responsibility of the caller for now (lands
    // alongside JsonOverflowException in Phase 2.5).
    public int32 currentNumberAsInt32() {
        return (int32) this.currentNumberAsInt64();
    }

    // Parse the current NUMBER token's span as float64. Supports
    // optional leading '-', integer part, optional '.' + fractional
    // digits, and optional exponent (e/E with optional +/-). No
    // strtod-class accuracy guarantees — naive digit accumulation
    // with float64 arithmetic. For the typical JSON numbers users
    // produce (32-bit doubles, small magnitudes), this round-trips
    // cleanly with the writer's printf-%.17g formatting.
    public float64 currentNumberAsFloat64() {
        int64 i = this.tokenStart;
        int64 end = this.tokenEnd;
        if (i >= end) {
            throw heap JsonParseException(
                "empty number token", this.tokenStart);
        }
        boolean negative = false;
        if (this.input[i] == (int8) 45) {       // '-'
            negative = true;
            i = i + 1;
            if (i >= end) {
                throw heap JsonParseException(
                    "bare '-' is not a number", this.tokenStart);
            }
        }
        float64 intPart = 0.0;
        while (i < end) {
            int8 c = this.input[i];
            if (c < (int8) 48 || c > (int8) 57) break;
            intPart = intPart * 10.0
                + (float64) (((int32) c) - 48);
            i = i + 1;
        }
        float64 frac = 0.0;
        float64 scale = 1.0;
        if (i < end && this.input[i] == (int8) 46) {   // '.'
            i = i + 1;
            while (i < end) {
                int8 c = this.input[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                scale = scale * 10.0;
                frac = frac
                    + ((float64) (((int32) c) - 48)) / scale;
                i = i + 1;
            }
        }
        float64 r = intPart + frac;
        // Optional exponent.
        if (i < end
                && (this.input[i] == (int8) 101
                    || this.input[i] == (int8) 69)) {  // 'e' / 'E'
            i = i + 1;
            boolean expNeg = false;
            if (i < end && this.input[i] == (int8) 45) {       // '-'
                expNeg = true;
                i = i + 1;
            } else if (i < end && this.input[i] == (int8) 43) { // '+'
                i = i + 1;
            }
            int32 exp = 0;
            while (i < end) {
                int8 c = this.input[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                exp = exp * 10 + (((int32) c) - 48);
                i = i + 1;
            }
            float64 pow10 = 1.0;
            int32 ej = 0;
            while (ej < exp) {
                pow10 = pow10 * 10.0;
                ej = ej + 1;
            }
            if (expNeg) {
                r = r / pow10;
            } else {
                r = r * pow10;
            }
        }
        if (negative) {
            return - r;
        }
        return r;
    }

    // --- Phase 3: JsonValue tree materialization --------------------

    // Drive next() once and build a #JsonValue for whatever value
    // appears at the current cursor position. Recursively expands
    // arrays and objects into JsonArray / JsonObject. Returns the
    // value with ownership transferred; the caller's drop chain
    // reclaims the tree.
    public #JsonValue readValue() {
        int32 t = this.next();
        return this.readValueAfter(t);
    }

    // Same shape, but the caller has already pulled the leading
    // token (e.g. inside an object loop where the parent dispatched
    // on KEY → call next() for the value → call this). Lets the
    // builder reuse the per-element token without double-advancing.
    public #JsonValue readValueAfter(int32 t) {
        JsonValue v = heap JsonValue();
        if (t == 0) {                                  // START_OBJECT
            JsonObject o = heap JsonObject();
            this.readObjectBody(o);
            v.setObject(#o);
        } else if (t == 2) {                           // START_ARRAY
            JsonArray a = heap JsonArray();
            this.readArrayBody(a);
            v.setArray(#a);
        } else if (t == 5) {                           // STRING
            int8[] bytes = this.currentBytes();
            int32 len = (int32) (this.tokenEnd - this.tokenStart);
            v.setStringOwned(#bytes, len);
        } else if (t == 6) {                           // NUMBER
            v.setNumber(this.currentNumberAsInt64());
        } else if (t == 7) {                           // BOOLEAN
            v.setBoolean(this.currentBool);
        } else if (t == 8) {                           // NULL
            v.setNull();
        } else {
            throw heap JsonParseException(
                "unexpected token while building value",
                this.pos);
        }
        return v;
    }

    // Walk object key/value pairs until END_OBJECT. Each KEY is
    // followed by exactly one value (which may be a sub-object /
    // sub-array). On entry, the reader has already produced
    // START_OBJECT; on exit, END_OBJECT has been consumed.
    void readObjectBody(JsonObject o) {
        while (true) {
            int32 t = this.next();
            if (t == 1) {                              // END_OBJECT
                return;
            }
            if (t != 4) {                              // KEY
                throw heap JsonParseException(
                    "expected key in object body",
                    this.pos);
            }
            int8[] keyBytes = this.currentBytes();
            int32 keyLen = (int32) (this.tokenEnd - this.tokenStart);
            int32 vt = this.next();
            JsonValue child = this.readValueAfter(vt);
            o.put(#keyBytes, keyLen, #child);
        }
    }

    void readArrayBody(JsonArray a) {
        while (true) {
            int32 t = this.next();
            if (t == 3) {                              // END_ARRAY
                return;
            }
            JsonValue child = this.readValueAfter(t);
            a.add(#child);
        }
    }
}
