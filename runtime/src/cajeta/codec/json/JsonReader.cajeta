package cajeta.codec.json;

import cajeta.codec.json.JsonToken;
import cajeta.lang.String;

/**
 * Pull tokenizer for RFC 8259 JSON. Walks an `int8[]` input buffer
 * once forward, emitting one `JsonToken` ordinal per `next()` call.
 * String and number tokens are recorded as byte-offset spans into
 * the input buffer (`tokenStart`, `tokenEnd`) without materialization
 * — the caller pays the parse/decode cost only when it asks for a
 * concrete value (Phase 2).
 *
 * See docs/specification/codec/json/Json.md § Tier 2.
 *
 * ## Usage
 *
 * Drive `next()` to the `JsonToken`.`END` sentinel, materializing
 * each value lazily:
 * ```cajeta
 * stack reader = JsonReader(buf, buf.count());
 * JsonToken t = reader.next();
 * while (t != JsonToken.END) {
 *     if (t == JsonToken.NUMBER) {
 *         int64 n = reader.currentNumberAsInt64();
 *     } else if (t == JsonToken.STRING) {
 *         #String s = reader.currentString();
 *     }
 *     t = reader.next();
 * }
 * ```
 * Or expand the whole document into a `JsonValue` tree in one call:
 * ```cajeta
 * stack reader = JsonReader(buf, buf.count());
 * #JsonValue root = reader.readValue();
 * ```
 * Any malformed input throws `JsonParseException` carrying the byte
 * offset of the fault.
 *
 * v1 (Phase 1) scope:
 *  - Structural tokenization for objects, arrays, separators.
 *  - Primitive literal tokens (true / false / null) with span.
 *  - Number tokenization (span only — value parsing Phase 2).
 *  - String tokenization (span only — content decoding Phase 2).
 *  - Strict RFC 8259 (no relaxed comments / trailing commas yet).
 *
 * Count is passed explicitly because primitive arrays don't yet
 * expose `.count()` as a property accessor (Cajeta arrays know their
 * count; the accessor just hasn't landed). Callers writing a one-
 * shot parse pass `(buf, buf.count())` once the property lands.
 *
 * Token ordinals (matching the JsonToken enum):
 *   0 START_OBJECT  1 END_OBJECT  2 START_ARRAY  3 END_ARRAY
 *   4 KEY           5 STRING      6 NUMBER       7 BOOLEAN
 *   8 NULL          9 END
 */
public class JsonReader {
    int8[] input;
    int64 byteCount;
    int64 pos;
    int64 tokenStart;
    int64 tokenEnd;
    JsonToken current;
    boolean currentBool;

    // Depth + per-frame state for the container nesting walk.
    // depthStack[i] = 0 for array, 1 for object.
    // frameState[i] = 0 (freshly opened), 1 (post-value), 2 (post-separator).
    int8[] depthStack;
    int8[] frameState;
    int32 depth;
    int32 maxDepth;

    // After a KEY token + ':' consumption, the next next() call
    // produces the value; that one value is not separator-gated.
    boolean afterKey;

    // One-token lookahead state. `peek()` advances by one token and
    // caches it; the very next `next()` call returns the cached token
    // instead of advancing again. Callers can `peek()` multiple times
    // in a row — every call after the first is idempotent until
    // `next()` consumes the cached value. The Tier-1 synthesizer
    // uses this to dispatch a nested-class array's elements: peek
    // either END_ARRAY (consume and exit loop) or START_OBJECT
    // (leave cached so the recursive `parseObjectFromReader<T>` sees
    // it as the first token of the inner parse).
    JsonToken peekedToken;
    boolean hasPeeked;

    /**
     * Wrap a UTF-8 byte buffer for tokenization. `byteCount` is the
     * number of valid bytes in `input` (passed explicitly until
     * primitive arrays expose `.count()`). The cursor starts before
     * the first token; call `next()` to advance.
     *
     * ```cajeta
     * stack reader = JsonReader(buf, buf.count());
     * JsonToken first = reader.next();   // e.g. START_OBJECT
     * ```
     */
    public JsonReader(int8[] input, int64 byteCount) {
        this.input = input;
        this.byteCount = byteCount;
        this.pos = 0;
        this.tokenStart = 0;
        this.tokenEnd = 0;
        this.current = JsonToken.END;
        this.currentBool = false;
        this.maxDepth = 1024;
        this.depthStack = heap int8[1024];
        this.frameState = heap int8[1024];
        this.depth = 0;
        this.afterKey = false;
        this.peekedToken = JsonToken.END;
        this.hasPeeked = false;
    }

    /**
     * Lookahead by one token without consuming it. Subsequent
     * `peek()` calls return the same cached token. The very next
     * `next()` call returns the cached token (advancing past it);
     * all later `next()` calls advance from the buffer normally.
     *
     * Use case: dispatch on token kind at a position the recursive
     * parser also expects to start at — e.g. nested-class array
     * iteration where the loop peeks each element's leading token,
     * exits on `END_ARRAY`, and otherwise hands off to a recursive
     * `parseObjectFromReader<T>` that will itself read the
     * `START_OBJECT`.
     */
    public JsonToken peek() {
        if (this.hasPeeked) {
            return this.peekedToken;
        }
        JsonToken t = this.next();
        this.peekedToken = t;
        this.hasPeeked = true;
        return t;
    }

    public JsonToken current() {
        return this.current;
    }

    public int64 position() {
        return this.pos;
    }

    public int64 tokenStart() {
        return this.tokenStart;
    }

    public int64 tokenEnd() {
        return this.tokenEnd;
    }

    public boolean currentBoolean() {
        return this.currentBool;
    }

    /**
     * Consume one complete value at the current position WITHOUT
     * materializing it — a scalar (string/number/true/false/null) or a
     * fully-nested object/array, balanced via a depth counter. The
     * subtree's bytes are skipped, not decoded: no `currentString` /
     * `currentNumber` work and no allocation for the skipped data. This
     * is the on-demand skip used by the `Json.parse<T>` synthesizer for
     * unknown keys (a struct only decodes the fields it maps). Throws
     * `JsonParseException` if the input ends mid-value.
     *
     * ```cajeta
     * // reader is positioned just before a value (e.g. after a KEY)
     * reader.skipValue();   // value + any nested subtree consumed
     * ```
     */
    public void skipValue() {
        JsonToken t = this.next();
        if (t == JsonToken.START_OBJECT || t == JsonToken.START_ARRAY) {
            int32 d = 1;
            while (d > 0) {
                JsonToken u = this.next();
                if (u == JsonToken.START_OBJECT || u == JsonToken.START_ARRAY) {
                    d = d + 1;
                } else if (u == JsonToken.END_OBJECT || u == JsonToken.END_ARRAY) {
                    d = d - 1;
                } else if (u == JsonToken.END) {
                    throw heap JsonParseException(
                        "unexpected end of input while skipping value",
                        this.pos);
                }
            }
        }
    }

    /**
     * Advance to and return the next `JsonToken`. Reading a cached
     * `peek()` returns that token without re-advancing; otherwise the
     * cursor scans forward over whitespace, separators, and container
     * brackets. Returns `JsonToken`.`END` at the top level once the
     * buffer is exhausted. Throws `JsonParseException` on malformed
     * structure (bad separator, unexpected character, truncated input,
     * or unterminated container).
     *
     * ```cajeta
     * JsonToken t = reader.next();
     * while (t != JsonToken.END) {
     *     // dispatch on t ...
     *     t = reader.next();
     * }
     * ```
     */
    public JsonToken next() {
        // Consume a cached peek if there is one — peek() already
        // advanced the buffer position past the underlying token.
        if (this.hasPeeked) {
            this.hasPeeked = false;
            this.current = this.peekedToken;
            return this.peekedToken;
        }
        this.skipWs();

        if (this.pos >= this.byteCount) {
            if (this.depth != 0) {
                throw heap JsonParseException(
                    "unexpected end of input inside container",
                    this.pos);
            }
            this.current = JsonToken.END;
            return JsonToken.END;
        }

        // In a container and NOT in the value-position right after a
        // key: handle separator / close before reading the next item.
        if (this.depth > 0) {
            if (!this.afterKey) {
                int8 frame = this.depthStack[this.depth - 1];
                int8 state = this.frameState[this.depth - 1];
                int8 c = this.input[this.pos];

                // Close brackets short-circuit (valid in both
                // freshly-opened and post-value states).
                if (frame == (int8) 0 && c == (int8) 93) {
                    return this.consumeClose(JsonToken.END_ARRAY);
                }
                if (frame == (int8) 1 && c == (int8) 125) {
                    return this.consumeClose(JsonToken.END_OBJECT);
                }

                // Post-value: must see a separator before the next item.
                if (state == (int8) 1) {
                    if (c != (int8) 44) {
                        throw heap JsonParseException(
                            "expected ',' or container close",
                            this.pos);
                    }
                    this.pos = this.pos + 1;
                    this.frameState[this.depth - 1] = (int8) 2;
                    this.skipWs();
                    if (this.pos >= this.byteCount) {
                        throw heap JsonParseException(
                            "unexpected end of input after separator",
                            this.pos);
                    }
                }
            }

            // Object frame outside the key-value gap: read a key.
            if (!this.afterKey
                    && this.depthStack[this.depth - 1] == (int8) 1) {
                return this.scanKey();
            }
        }

        this.afterKey = false;
        int8 c2 = this.input[this.pos];

        if (c2 == (int8) 123) {              // '{'
            return this.openContainer((int8) 1, JsonToken.START_OBJECT);
        }
        if (c2 == (int8) 91) {               // '['
            return this.openContainer((int8) 0, JsonToken.START_ARRAY);
        }
        if (c2 == (int8) 34) {               // '"'
            this.scanStringSpan();
            this.markValueProduced();
            this.current = JsonToken.STRING;
            return JsonToken.STRING;
        }
        if (c2 == (int8) 45
                || (c2 >= (int8) 48 && c2 <= (int8) 57)) {
            this.scanNumberSpan();
            this.markValueProduced();
            this.current = JsonToken.NUMBER;
            return JsonToken.NUMBER;
        }
        if (c2 == (int8) 116) {              // 't'
            this.expectLiteral4((int8) 116, (int8) 114,
                                (int8) 117, (int8) 101);
            this.currentBool = true;
            this.markValueProduced();
            this.current = JsonToken.BOOLEAN;
            return JsonToken.BOOLEAN;
        }
        if (c2 == (int8) 102) {              // 'f'
            this.expectLiteral5((int8) 102, (int8) 97,
                                (int8) 108, (int8) 115,
                                (int8) 101);
            this.currentBool = false;
            this.markValueProduced();
            this.current = JsonToken.BOOLEAN;
            return JsonToken.BOOLEAN;
        }
        if (c2 == (int8) 110) {              // 'n'
            this.expectLiteral4((int8) 110, (int8) 117,
                                (int8) 108, (int8) 108);
            this.markValueProduced();
            this.current = JsonToken.NULL;
            return JsonToken.NULL;
        }

        throw heap JsonParseException("unexpected character", this.pos);
    }

    /**
     * Push a new container frame (`kind` 0 = array, 1 = object),
     * record the bracket span, and emit `token`. Throws
     * `JsonParseException` if the nesting depth limit is exceeded.
     */
    JsonToken openContainer(int8 kind, JsonToken token) {
        if (this.depth >= this.maxDepth) {
            throw heap JsonParseException(
                "nesting depth limit exceeded",
                this.pos);
        }
        this.depthStack[this.depth] = kind;
        this.frameState[this.depth] = (int8) 0;
        this.depth = this.depth + 1;
        this.tokenStart = this.pos;
        this.pos = this.pos + 1;
        this.tokenEnd = this.pos;
        this.current = token;
        return token;
    }

    /**
     * Pop the current container frame, consume the closing bracket,
     * and emit `token` (`END_ARRAY` / `END_OBJECT`). Marks the closed
     * container as a produced value in its parent frame.
     */
    JsonToken consumeClose(JsonToken token) {
        this.pos = this.pos + 1;
        this.depth = this.depth - 1;
        this.markValueProduced();
        this.tokenStart = this.pos - 1;
        this.tokenEnd = this.pos;
        this.current = token;
        return token;
    }

    /** Advance the cursor past RFC 8259 whitespace (space, tab, LF, CR). */
    void skipWs() {
        while (this.pos < this.byteCount) {
            int8 c = this.input[this.pos];
            if (c == (int8) 32
                    || c == (int8) 9
                    || c == (int8) 10
                    || c == (int8) 13) {
                this.pos = this.pos + 1;
            } else {
                return;
            }
        }
    }

    /**
     * Scan an object key: a quoted string span followed by `:`. Emits
     * `KEY` and arms the after-key state so the next `next()` yields the
     * value. Throws `JsonParseException` if the `"` or `:` is missing.
     */
    JsonToken scanKey() {
        if (this.input[this.pos] != (int8) 34) {
            throw heap JsonParseException(
                "expected '\"' to begin object key",
                this.pos);
        }
        this.scanStringSpan();
        this.skipWs();
        if (this.pos >= this.byteCount || this.input[this.pos] != (int8) 58) {
            throw heap JsonParseException(
                "expected ':' after object key",
                this.pos);
        }
        this.pos = this.pos + 1;
        this.afterKey = true;
        this.current = JsonToken.KEY;
        return JsonToken.KEY;
    }

    /**
     * Record the span between the quotes of a string literal into
     * (`tokenStart`, `tokenEnd`), skipping over `\`-escapes without
     * decoding them. Throws `JsonParseException` on an unterminated
     * string or a truncated escape sequence.
     */
    void scanStringSpan() {
        // SWAR: scan 8 bytes per step for a closing '"' (0x22) or an escape
        // '\' (0x5C), via the classic byte-in-word find (uint64 wraps, so the
        // `- ones` borrow trick is trap-free). Falls to a scalar tail for the
        // final < 8 bytes. Numbers/positions match the byte-at-a-time scanner.
        int64 p = this.pos + 1;     // past opening '"'
        int64 bc = this.byteCount;
        this.tokenStart = p;
        uint64 ones = 0x0101010101010101;
        uint64 high = 0x8080808080808080;
        uint64 qq = 0x2222222222222222;   // '"' broadcast
        uint64 bs = 0x5C5C5C5C5C5C5C5C;   // '\' broadcast
        while (p + 8 <= bc) {
            uint64 w = (uint64) Cajeta.loadU64(this.input, p);
            uint64 xq = w ^ qq; uint64 mq = (xq - ones) & (~xq) & high;
            uint64 xb = w ^ bs; uint64 mb = (xb - ones) & (~xb) & high;
            uint64 m = mq | mb;
            if (m != 0) {
                int32 idx = Cajeta.ctz64((int64) m) >> 3;
                int64 at = p + (int64) idx;
                int8 c = this.input[at];
                if (c == (int8) 34) {
                    this.tokenEnd = at;
                    this.pos = at + 1;
                    return;
                }
                p = at + 2;     // backslash: skip the escaped byte
                if (p > bc) {
                    this.pos = bc;
                    throw heap JsonParseException("unterminated string", bc);
                }
            } else {
                p = p + 8;
            }
        }
        while (p < bc) {
            int8 c = this.input[p];
            if (c == (int8) 34) {
                this.tokenEnd = p;
                this.pos = p + 1;
                return;
            }
            if (c == (int8) 92) {
                p = p + 2;
                if (p > bc) {
                    this.pos = bc;
                    throw heap JsonParseException("unterminated string", bc);
                }
            } else {
                p = p + 1;
            }
        }
        this.pos = bc;
        throw heap JsonParseException("unterminated string", bc);
    }

    /**
     * Record the span of a number literal (digits, `.`, `e`/`E`, and
     * signs) into (`tokenStart`, `tokenEnd`). Span only — the value is
     * parsed lazily by the `currentNumberAs*` helpers.
     */
    void scanNumberSpan() {
        this.tokenStart = this.pos;
        int64 p = this.pos + 1;     // first char (sign/digit) is always part of it
        int64 bc = this.byteCount;
        uint64 high = 0x8080808080808080;
        // SWAR-skip runs of digits (the bulk of a number), 8 bytes/step, then
        // scalar-handle the occasional '.'/'e'/'E'/'+'/'-' and re-enter the
        // fast path. A byte is a digit iff 0x30 <= b <= 0x39: bias-add detects
        // each range edge (bytes are ASCII < 0x80 here, so no inter-byte carry).
        while (true) {
            while (p + 8 <= bc) {
                uint64 w = (uint64) Cajeta.loadU64(this.input, p);
                uint64 ge30 = (w + 0x5050505050505050) & high;   // b >= 0x30
                uint64 gt39 = (w + 0x4646464646464646) & high;   // b > 0x39
                uint64 digit = ge30 & (~gt39) & high;            // 0x80 per digit
                uint64 nd = (~digit) & high;                     // 0x80 per non-digit
                if (nd == 0) {
                    p = p + 8;
                } else {
                    int32 idx = Cajeta.ctz64((int64) nd) >> 3;
                    p = p + (int64) idx;
                    break;
                }
            }
            if (p >= bc) {
                this.tokenEnd = p;
                this.pos = p;
                return;
            }
            int8 c = this.input[p];
            boolean isDigit = c >= (int8) 48 && c <= (int8) 57;
            boolean isSpecial = c == (int8) 46 || c == (int8) 101
                || c == (int8) 69 || c == (int8) 43 || c == (int8) 45;
            if (isDigit || isSpecial) {
                p = p + 1;
            } else {
                this.tokenEnd = p;
                this.pos = p;
                return;
            }
        }
    }

    /**
     * Match a fixed 4-byte literal (`true` / `null`) at the cursor and
     * record its span. Throws `JsonParseException` if truncated or
     * mismatched.
     */
    void expectLiteral4(int8 b0, int8 b1, int8 b2, int8 b3) {
        if (this.pos + 4 > this.byteCount) {
            throw heap JsonParseException("truncated literal", this.pos);
        }
        if (this.input[this.pos] != b0
                || this.input[this.pos + 1] != b1
                || this.input[this.pos + 2] != b2
                || this.input[this.pos + 3] != b3) {
            throw heap JsonParseException("invalid literal", this.pos);
        }
        this.tokenStart = this.pos;
        this.pos = this.pos + 4;
        this.tokenEnd = this.pos;
    }

    /**
     * Match a fixed 5-byte literal (`false`) at the cursor and record
     * its span. Throws `JsonParseException` if truncated or mismatched.
     */
    void expectLiteral5(int8 b0, int8 b1, int8 b2, int8 b3, int8 b4) {
        if (this.pos + 5 > this.byteCount) {
            throw heap JsonParseException("truncated literal", this.pos);
        }
        if (this.input[this.pos] != b0
                || this.input[this.pos + 1] != b1
                || this.input[this.pos + 2] != b2
                || this.input[this.pos + 3] != b3
                || this.input[this.pos + 4] != b4) {
            throw heap JsonParseException("invalid literal", this.pos);
        }
        this.tokenStart = this.pos;
        this.pos = this.pos + 5;
        this.tokenEnd = this.pos;
    }

    /**
     * Flag the enclosing container frame as post-value, so the next
     * `next()` requires a separator or close before another item.
     */
    void markValueProduced() {
        if (this.depth > 0) {
            this.frameState[this.depth - 1] = (int8) 1;
        }
    }

    // --- Phase 2: materialization helpers ---------------------------

    /**
     * Copy the current token's bytes into a fresh `int8[]` (ownership
     * transferred to the caller). Works for `KEY`, `STRING`, `NUMBER`,
     * and the literal-spanning tokens (`BOOLEAN` / `NULL`). For string
     * tokens the escape sequences are NOT decoded — they appear verbatim
     * (`\n` stays as the two bytes `\\`, `n`). String-escape decoding
     * lands when needed.
     *
     * ```cajeta
     * if (reader.next() == JsonToken.STRING) {
     *     #int8[] raw = reader.currentBytes();
     * }
     * ```
     */
    public #int8[] currentBytes() {
        int32 len = (int32) (this.tokenEnd - this.tokenStart);
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = this.input[this.tokenStart + (int64) i];
            i = i + 1;
        }
        return out;
    }

    /**
     * Copy the current token's bytes INCLUDING the wire-form
     * delimiters. For STRING / KEY tokens that means the
     * surrounding `"` quotes; for NUMBER / BOOLEAN / NULL it's
     * identical to `currentBytes()` since those tokens have no
     * outer delimiters. Used by the @JsonRaw synthesizer arm —
     * the captured bytes must round-trip through
     * `JsonWriter.writeRaw` and re-parse as the same JSON value.
     *
     * Object / array values aren't span-captureable from a single
     * token (their tokens are the structural braces; the
     * interior is a series of nested tokens). v1 @JsonRaw covers
     * primitive token values only; nested-span capture is a
     * follow-up that requires walking the inner-token tree.
     *
     * Detection of "is this a STRING/KEY token" uses the raw
     * input byte immediately preceding the token start: if it's
     * `"` (0x22), we include both quotes; otherwise the span is
     * unchanged.
     */
    public #int8[] currentRawBytes() {
        int64 start = this.tokenStart;
        int64 end = this.tokenEnd;
        // Probe for an enclosing pair of quotes.
        boolean quoted = false;
        if (start > 0 && end < this.byteCount) {
            if (this.input[start - 1] == (int8) 34
                    && this.input[end] == (int8) 34) {
                quoted = true;
            }
        }
        int64 effStart = quoted ? (start - 1) : start;
        int64 effEnd = quoted ? (end + 1) : end;
        int32 len = (int32) (effEnd - effStart);
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = this.input[effStart + (int64) i];
            i = i + 1;
        }
        return out;
    }

    /**
     * Materialize the current token's bytes as a `cajeta.lang.String`
     * view. The String's `bytes` field points at a fresh int8[] copy
     * of the token (same copy `currentBytes()` makes); the
     * `byteLength` reflects the token's span.
     *
     * Use this when the caller wants a String for ergonomics —
     * comparison, passing to other APIs, building a key map. The
     * hot-path tokenizer code keeps using `currentBytes()` directly
     * to avoid the wrapper allocation.
     */
    public #String currentString() {
        int8[] bytes = this.currentBytes();
        int32 n = (int32) bytes.count();
        return heap String(#bytes, n);
    }

    /**
     * Parse the current `NUMBER` token's span as `int64`. v1 only
     * handles signed integers (leading `-` optional). A fractional or
     * exponent form throws `JsonParseException`, as does a value
     * outside the `int64` range. Proper float parsing lands when the
     * runtime gains a strtod-equivalent helper.
     *
     * ```cajeta
     * if (reader.next() == JsonToken.NUMBER) {
     *     int64 n = reader.currentNumberAsInt64();
     * }
     * ```
     */
    public int64 currentNumberAsInt64() {
        int64 i = this.tokenStart;
        int64 end = this.tokenEnd;
        if (i >= end) {
            throw heap JsonParseException(
                "empty number token", this.tokenStart);
        }
        boolean negative = false;
        if (this.input[i] == (int8) 45) {       // '-'
            negative = true;
            i = i + 1;
            if (i >= end) {
                throw heap JsonParseException(
                    "bare '-' is not a number", this.tokenStart);
            }
        }
        // Accumulate in uint64 so the digit-chain doesn't trip the
        // signed-overflow trap under --overflow-checks=on. Pre-check
        // each step against the appropriate positive-side limit
        // (negative numbers can reach abs(INT64_MIN) = 0x8000_0000_0000_0000;
        // positive numbers cap at INT64_MAX = 0x7FFF_FFFF_FFFF_FFFF).
        // Overflow throws JsonParseException with a clear message.
        uint64 acc = (uint64) 0;
        uint64 limit = (uint64) 9223372036854775807;     // INT64_MAX
        if (negative) {
            limit = (uint64) 9223372036854775808;        // abs(INT64_MIN)
        }
        uint64 limitDiv10 = limit / (uint64) 10;
        uint64 limitMod10 = limit - limitDiv10 * (uint64) 10;
        while (i < end) {
            int8 c = this.input[i];
            if (c < (int8) 48 || c > (int8) 57) {
                throw heap JsonParseException(
                    "non-integer number (v1 doesn't parse floats)",
                    i);
            }
            uint64 d = (uint64) (((int32) c) - 48);
            if (acc > limitDiv10
                    || (acc == limitDiv10 && d > limitMod10)) {
                throw heap JsonParseException(
                    "number out of int64 range", this.tokenStart);
            }
            acc = acc * (uint64) 10 + d;
            i = i + 1;
        }
        if (negative) {
            // The only int64 whose negation overflows is INT64_MIN.
            // Detect by comparing the positive accumulator against
            // abs(INT64_MIN) and emit the literal int64 min in that
            // case so we never feed -INT64_MAX-1 through CreateNeg
            // (which would trap under overflowChecks=On).
            if (acc == (uint64) 9223372036854775808) {
                return (int64) -9223372036854775807 - (int64) 1;
            }
            return - (int64) acc;
        }
        return (int64) acc;
    }

    /**
     * Parse the current `NUMBER` token as `int32` by delegating to
     * `currentNumberAsInt64()` and narrowing. Range checking on the
     * narrowing is the caller's responsibility for now (lands alongside
     * `JsonOverflowException` in Phase 2.5).
     */
    public int32 currentNumberAsInt32() {
        return (int32) this.currentNumberAsInt64();
    }

    /**
     * Parse the current `NUMBER` token's span as `float64`. Supports an
     * optional leading `-`, integer part, optional `.` + fractional
     * digits, and optional exponent (`e`/`E` with optional `+`/`-`). No
     * strtod-class accuracy guarantees — naive digit accumulation in
     * `float64`. For typical JSON numbers (32-bit doubles, small
     * magnitudes) this round-trips cleanly with the writer's
     * `printf`-`%.17g` formatting. Throws `JsonParseException` on an
     * empty or bare-`-` token.
     */
    public float64 currentNumberAsFloat64() {
        int64 i = this.tokenStart;
        int64 end = this.tokenEnd;
        if (i >= end) {
            throw heap JsonParseException(
                "empty number token", this.tokenStart);
        }
        boolean negative = false;
        if (this.input[i] == (int8) 45) {       // '-'
            negative = true;
            i = i + 1;
            if (i >= end) {
                throw heap JsonParseException(
                    "bare '-' is not a number", this.tokenStart);
            }
        }
        float64 intPart = 0.0;
        while (i < end) {
            int8 c = this.input[i];
            if (c < (int8) 48 || c > (int8) 57) break;
            intPart = intPart * 10.0
                + (float64) (((int32) c) - 48);
            i = i + 1;
        }
        float64 frac = 0.0;
        float64 scale = 1.0;
        if (i < end && this.input[i] == (int8) 46) {   // '.'
            i = i + 1;
            while (i < end) {
                int8 c = this.input[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                scale = scale * 10.0;
                frac = frac
                    + ((float64) (((int32) c) - 48)) / scale;
                i = i + 1;
            }
        }
        float64 r = intPart + frac;
        // Optional exponent.
        if (i < end
                && (this.input[i] == (int8) 101
                    || this.input[i] == (int8) 69)) {  // 'e' / 'E'
            i = i + 1;
            boolean expNeg = false;
            if (i < end && this.input[i] == (int8) 45) {       // '-'
                expNeg = true;
                i = i + 1;
            } else if (i < end && this.input[i] == (int8) 43) { // '+'
                i = i + 1;
            }
            int32 exp = 0;
            while (i < end) {
                int8 c = this.input[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                exp = exp * 10 + (((int32) c) - 48);
                i = i + 1;
            }
            float64 pow10 = 1.0;
            int32 ej = 0;
            while (ej < exp) {
                pow10 = pow10 * 10.0;
                ej = ej + 1;
            }
            if (expNeg) {
                r = r / pow10;
            } else {
                r = r * pow10;
            }
        }
        if (negative) {
            return - r;
        }
        return r;
    }

    // --- Phase 3: JsonValue tree materialization --------------------

    /**
     * Drive `next()` once and build a `JsonValue` for whatever value
     * sits at the current cursor position, recursively expanding arrays
     * and objects into `JsonArray` / `JsonObject`. Ownership of the
     * tree transfers to the caller, whose drop chain reclaims it.
     *
     * ```cajeta
     * stack reader = JsonReader(buf, buf.count());
     * #JsonValue root = reader.readValue();
     * ```
     */
    public #JsonValue readValue() {
        JsonToken t = this.next();
        return this.readValueAfter(t);
    }

    /**
     * Build a `JsonValue` for an already-pulled leading token `t`
     * (e.g. inside an object loop that dispatched on `KEY`, called
     * `next()` for the value, then calls this). Lets the builder reuse
     * the per-element token without double-advancing. Throws
     * `JsonParseException` if `t` cannot begin a value.
     */
    public #JsonValue readValueAfter(JsonToken t) {
        JsonValue v = heap JsonValue();
        if (t == JsonToken.START_OBJECT) {
            JsonObject o = heap JsonObject();
            this.readObjectBody(o);
            v.setObject(#o);
        } else if (t == JsonToken.START_ARRAY) {
            JsonArray a = heap JsonArray();
            this.readArrayBody(a);
            v.setArray(#a);
        } else if (t == JsonToken.STRING) {
            int8[] bytes = this.currentBytes();
            int32 len = (int32) (this.tokenEnd - this.tokenStart);
            v.setStringOwned(#bytes, len);
        } else if (t == JsonToken.NUMBER) {
            v.setNumber(this.currentNumberAsInt64());
        } else if (t == JsonToken.BOOLEAN) {
            v.setBoolean(this.currentBool);
        } else if (t == JsonToken.NULL) {
            v.setNull();
        } else {
            throw heap JsonParseException(
                "unexpected token while building value",
                this.pos);
        }
        return v;
    }

    /**
     * Walk object key/value pairs into `o` until `END_OBJECT`. Each
     * `KEY` is followed by exactly one value (possibly a sub-object or
     * sub-array). On entry `START_OBJECT` has already been produced; on
     * exit `END_OBJECT` has been consumed. Throws `JsonParseException`
     * if a non-`KEY` token appears where a key is expected.
     */
    void readObjectBody(JsonObject o) {
        while (true) {
            JsonToken t = this.next();
            if (t == JsonToken.END_OBJECT) {
                return;
            }
            if (t != JsonToken.KEY) {
                throw heap JsonParseException(
                    "expected key in object body",
                    this.pos);
            }
            int8[] keyBytes = this.currentBytes();
            int32 keyLen = (int32) (this.tokenEnd - this.tokenStart);
            JsonToken vt = this.next();
            JsonValue child = this.readValueAfter(vt);
            o.put(#keyBytes, keyLen, #child);
        }
    }

    /**
     * Append array elements into `a` until `END_ARRAY`. On entry
     * `START_ARRAY` has already been produced; on exit `END_ARRAY` has
     * been consumed. Each element is built via `readValueAfter`.
     */
    void readArrayBody(JsonArray a) {
        while (true) {
            JsonToken t = this.next();
            if (t == JsonToken.END_ARRAY) {
                return;
            }
            JsonValue child = this.readValueAfter(t);
            a.add(#child);
        }
    }
}
