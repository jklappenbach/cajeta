package cajeta.codec.json;

import cajeta.collection.ArrayList;
import cajeta.lang.Optional;
import cajeta.lang.String;

/**
 * Minimal, insertion-ordered key/value store backing `JsonValue` objects
 * (`JsonValue.OBJECT`). Keys are kept as raw `int8[]` byte buffers in a
 * `keys` array alongside a parallel `keyLens` array (since `int8[].count()`
 * isn't exposed as a property yet) and a parallel `JsonValue` array. `get`
 * scans linearly below 16 entries and probes a lazily-built hash index at or
 * above it (cajeta-llama 5.2.4 — safetensors headers and tokenizer vocabs
 * put thousands of keys through this path).
 *
 * ## Two access tiers
 * - The hot-path tokenizer uses the byte-buffer `get(bytes, len)` / `keyAt`
 *   form and tolerates a `null` result on a miss.
 * - Convenience / user code uses the typed `Optional`-returning accessors
 *   (`getString`, `getInt`, `getArray`, ...), which return `Optional.empty()`
 *   when the key is missing OR when the value's kind doesn't match.
 *
 * ## Usage
 * ```cajeta
 * JsonObject cfg = value.asObject();
 * Optional<String> name = cfg.getString("name");
 * if (name.isPresent()) {
 *     String n = name.get();
 * }
 * #ArrayList<String> ks = cfg.keys();
 * ```
 */
public final class JsonObject {
    int8[][] keys;
    int32[] keyLens;
    JsonValue[] values;
    int32 cap;
    int32 sizeCount;

    // Lazily-built open-addressed index over the entries (cajeta-llama
    // 5.2.4): entry indices keyed by FNV-1a of the key bytes, -1 = empty,
    // linear probing, load factor <= 1/2. Built by `get` once the object
    // crosses HASH_MIN entries — a safetensors header has thousands of
    // tensors and a tokenizer vocab has ~100k, where the v1 linear scan
    // made every lookup O(n) and header parsing O(n^2). Small objects
    // (configs) keep the scan: cheaper than hashing at that size.
    // `put` does not maintain the table; `slotCount` records the size at
    // build time and a mismatch triggers a rebuild on the next get, so
    // the parse-then-read pattern builds exactly once.
    int32[] slots;
    int32 slotMask;
    int32 slotCount;

    /**
     * Create an empty object with a starting capacity of 8 entries; the
     * backing arrays grow automatically as keys are added with `put`.
     *
     * ```cajeta
     * JsonObject obj = heap JsonObject();
     * obj.put(#keyBytes, keyLen, #v);
     * ```
     */
    public JsonObject() {
        this.cap = 8;
        this.keys = heap int8[8][];
        this.keyLens = heap int32[8];
        this.values = heap JsonValue[8];
        this.sizeCount = 0;
        this.slots = null;
        this.slotMask = 0;
        this.slotCount = 0;
    }

    @Inline
    public int32 count() {
        return this.sizeCount;
    }

    @Inline
    public int8[] keyAt(int32 i) {
        return this.keys[i];
    }

    @Inline
    public int32 keyLenAt(int32 i) {
        return this.keyLens[i];
    }

    @Inline
    public JsonValue valueAt(int32 i) {
        return this.values[i];
    }

    /**
     * Look up a value by `String` key — convenience overload over
     * `get(bytes, len)`. Returns `null` when the key is absent. Preferred for
     * hand-written user code; the byte-buffer form below is for the hot-path
     * tokenizer that already has the bytes + length in hand.
     *
     * ```cajeta
     * JsonValue v = cfg.get("name");
     * if (v != null) { String s = v.asString(); }
     * ```
     */
    @Inline
    public JsonValue get(String key) {
        if (key.root() == null || key.byteOffset() != (int64) 0) {
            int8[] w #= key.toBytes();
            return this.get(w, key.byteLength());
        }
        return this.get(key.root(), key.byteLength());
    }

    /**
     * Lookup by raw key bytes; returns `null` if absent. Small objects use a
     * linear scan (cheaper than hashing at config size); at `HASH_MIN`
     * entries and beyond, `get` builds the open-addressed index lazily and
     * probes it — O(1) per lookup where a safetensors header or a tokenizer
     * vocab made the scan O(n) per key and a parse-all-keys pass O(n²)
     * (cajeta-llama 5.2.4). First-match semantics for duplicate keys are
     * preserved: the index insert keeps the earliest entry for a key.
     */
    public JsonValue get(int8[] key, int32 keyLen) {
        if (this.sizeCount >= 16) {
            if (this.slots == null || this.slotCount != this.sizeCount) {
                this.buildIndex();
            }
            int32 mask = this.slotMask;
            int32 slot = JsonObject.hashKey(key, keyLen) & mask;
            int32 e = this.slots[slot];
            while (e >= 0) {
                if (this.keyEquals(e, key, keyLen)) {
                    return this.values[e];
                }
                slot = (slot + 1) & mask;
                e = this.slots[slot];
            }
            return null;
        }
        int32 i = 0;
        while (i < this.sizeCount) {
            if (this.keyEquals(i, key, keyLen)) {
                return this.values[i];
            }
            i = i + 1;
        }
        return null;
    }

    /** Entry `e`'s key equals `key[0..keyLen)`. */
    boolean keyEquals(int32 e, int8[] key, int32 keyLen) {
        if (this.keyLens[e] != keyLen) {
            return false;
        }
        int8[] k = this.keys[e];
        int32 j = 0;
        while (j < keyLen) {
            if (k[j] != key[j]) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /** FNV-1a over the key bytes. */
    static int32 hashKey(int8[] key, int32 keyLen) {
        int32 h = -2128831035;              // 0x811C9DC5, the FNV offset basis
        int32 i = 0;
        while (i < keyLen) {
            int32 b = (int32) key[i] & 255;
            h = h ^ b;
            h = h * 16777619;               // FNV prime
            i = i + 1;
        }
        return h;
    }

    /**
     * (Re)build the probe table over the current entries. Capacity is the
     * next power of two at or above 2× the entry count, so the load factor
     * never exceeds 1/2 and every probe chain ends at an empty slot. On a
     * duplicate key the FIRST entry stays in the table — `get`'s documented
     * contract for re-put keys.
     */
    void buildIndex() {
        int32 capS = 16;
        while (capS < this.sizeCount * 2) {
            capS = capS * 2;
        }
        int32[] t = heap int32[capS];
        int32 i = 0;
        while (i < capS) {
            t[i] = -1;
            i = i + 1;
        }
        int32 mask = capS - 1;
        int32 e = 0;
        while (e < this.sizeCount) {
            int32 slot = JsonObject.hashKey(this.keys[e], this.keyLens[e]) & mask;
            boolean placed = false;
            while (!placed) {
                int32 cur = t[slot];
                if (cur < 0) {
                    t[slot] = e;
                    placed = true;
                } else {
                    if (this.keyEquals(cur, this.keys[e], this.keyLens[e])) {
                        placed = true;      // duplicate key: first entry wins
                    } else {
                        slot = (slot + 1) & mask;
                    }
                }
            }
            e = e + 1;
        }
        this.slots #= t;
        this.slotMask = mask;
        this.slotCount = this.sizeCount;
    }

    /**
     * Append a key/value entry, taking ownership of the `#int8[]` key buffer
     * and the `#JsonValue` (heap transfer). Insertion order is preserved and
     * the backing arrays grow when full. Does not deduplicate — re-putting an
     * existing key appends a second entry that `get` will never reach.
     *
     * ```cajeta
     * obj.put(#keyBytes, keyLen, #v);
     * ```
     */
    public void put(#int8[] key, int32 keyLen, #JsonValue v) {
        if (this.sizeCount >= this.cap) {
            this.grow();
        }
        this.keys[this.sizeCount] #= key;
        this.keyLens[this.sizeCount] = keyLen;
        this.values[this.sizeCount] #= v;
        this.sizeCount = this.sizeCount + 1;
    }

    /** Double the backing-array capacity and copy existing entries over; called by `put` when full. */
    void grow() {
        int32 newCap = this.cap * 2;
        int8[][] dstK = heap int8[newCap][];
        int32[] dstL = heap int32[newCap];
        JsonValue[] dstV = heap JsonValue[newCap];
        int32 i = 0;
        while (i < this.sizeCount) {
            // title-stores §2.1 — FORWARDING MOVES, not plain copies: the
            // owned key buffers and JsonValues must move so the source tail
            // bits clear. A plain `=` here left the old arrays "owning"
            // every element, and the `#=` displacement below then walked
            // and FREED them — a use-after-free through the new arrays for
            // any object past its 8-entry starting capacity (found by the
            // 5.2.4 hash tests; same audit-miss as json-grow-element-uaf's
            // other three sites).
            dstK[i] #= this.keys[i];
            dstL[i] = this.keyLens[i];
            dstV[i] #= this.values[i];
            i = i + 1;
        }
        this.keys #= dstK;
        this.keyLens #= dstL;
        this.values #= dstV;
        this.cap = newCap;
    }

    // ── Typed convenience accessors ─────────────────────────────
    //
    // Symmetric Optional-returning getters over the same lookup
    // semantics as `get(key) → JsonValue`. The legacy `get` stays
    // for the byte-level / null-on-miss API that the tokenizer's
    // hot path uses; the typed getters are for plugin / user code
    // that wants `if (x.getString("field").isPresent()) { ... }`
    // without the manual kind check.
    //
    // Each accessor returns `Optional.empty()` when the key is
    // missing OR when the present value's kind doesn't match the
    // requested type. That's a deliberate choice: a malformed
    // config (`{ "min": "eighty" }`) shouldn't silently default —
    // the caller observes empty and surfaces a "wrong kind" error
    // with its own message. The kind-check helpers `containsKey`
    // and `valueKindAt` are exposed for that branch.

    /** `true` if `key` is present, regardless of its value's kind. */
    public boolean containsKey(String key) {
        return this.get(key) != null;
    }

    /**
     * Insertion-ordered list of the object's keys, decoded as
     * `cajeta.lang.String`. Allocates one String per key — fine
     * for the convenience-tier callers that iterate config
     * objects; the hot-path tokenizer should keep using `keyAt`.
     */
    public #ArrayList<String> keys() {
        ArrayList<String> out #= heap ArrayList<String>();
        int32 i = 0;
        while (i < this.sizeCount) {
            // The String byte-ctor CONSUMES its buffer — feed it a copy,
            // never the stored key (same hazard as JsonValue.asString).
            int32 kl = this.keyLens[i];
            int8[] kc = heap int8[kl];
            int32 j = 0;
            while (j < kl) {
                kc[j] = this.keys[i][j];
                j = j + 1;
            }
            out.add(#heap String(#kc, kl));
            i = i + 1;
        }
        return out;
    }

    /**
     * `String` value at `key`, or `Optional.empty()` if the key is missing
     * or its value isn't a JSON string.
     *
     * ```cajeta
     * Optional<String> name = cfg.getString("name");
     * if (name.isPresent()) { String n = name.get(); }
     * ```
     */
    public Optional<String> getString(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 3) {
            return stack Optional<String>(false, #null);
        }
        return stack Optional<String>(true, v.asString());
    }

    /** Number value at `key` as `int32`, or empty if the key is missing / not a number. */
    public Optional<int32> getInt(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 2) {
            return stack Optional<int32>(false, 0);
        }
        return stack Optional<int32>(true, v.asInt32());
    }

    /** Number value at `key` as `int64`, or empty if the key is missing / not a number. */
    public Optional<int64> getLong(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 2) {
            return stack Optional<int64>(false, 0);
        }
        return stack Optional<int64>(true, v.asInt64());
    }

    /** Boolean value at `key`, or empty if the key is missing / not a boolean. */
    public Optional<boolean> getBoolean(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 1) {
            return stack Optional<boolean>(false, false);
        }
        return stack Optional<boolean>(true, v.asBoolean());
    }

    /** `JsonArray` value at `key`, or empty if the key is missing / not an array. */
    public Optional<JsonArray> getArray(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 4) {
            return stack Optional<JsonArray>(false, #null);
        }
        return stack Optional<JsonArray>(true, v.asArray());
    }

    /** Nested `JsonObject` at `key`, or empty if the key is missing / not an object. */
    public Optional<JsonObject> getObject(String key) {
        JsonValue v = this.get(key);
        if (v == null || v.kind() != 5) {
            return stack Optional<JsonObject>(false, #null);
        }
        return stack Optional<JsonObject>(true, v.asObject());
    }

    /**
     * Collect a string-typed array into an `ArrayList<String>`.
     * Returns empty on missing key — the "list of patterns" config
     * shape almost always wants the empty-when-absent semantics.
     * A present-but-non-array value still returns empty; a present
     * array containing a non-string element returns empty for that
     * slot (caller iterates `getArray(key)` directly if the
     * stricter behavior is needed).
     */
    public #ArrayList<String> getStringArray(String key) {
        ArrayList<String> out #= heap ArrayList<String>();
        Optional<JsonArray> arr = this.getArray(key);
        if (arr.isEmpty()) { return out; }
        JsonArray a = arr.get();
        int32 i = 0;
        while (i < a.count()) {
            JsonValue v = a.get(i);
            if (v != null && v.kind() == 3) {
                out.add(v.asString());
            }
            i = i + 1;
        }
        return out;
    }
}
