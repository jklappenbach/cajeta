package cajeta.codec.json;

import cajeta.lang.String;

// Minimal key/value store backing JsonValue.OBJECT. Parallel arrays
// of int8[] keys + JsonValue values; v1 uses linear scan for get().
// Insertion order is preserved. The keyLens array stores per-key
// byte counts (since int8[].count() isn't exposed as a property yet).
public class JsonObject {
    int8[][] keys;
    int32[] keyLens;
    JsonValue[] values;
    int32 cap;
    int32 sizeCount;

    public JsonObject() {
        this.cap = 8;
        this.keys = new int8[8][];
        this.keyLens = new int32[8];
        this.values = new JsonValue[8];
        this.sizeCount = 0;
    }

    public int32 count() {
        return this.sizeCount;
    }

    public int8[] keyAt(int32 i) {
        return this.keys[i];
    }

    public int32 keyLenAt(int32 i) {
        return this.keyLens[i];
    }

    public JsonValue valueAt(int32 i) {
        return this.values[i];
    }

    // String-typed get — convenience overload over `get(bytes, len)`.
    // Preferred for hand-written user code; the byte-buffer form
    // below is for the hot-path tokenizer that already has the
    // bytes + length in hand.
    public JsonValue get(String key) {
        return this.get(key.bytes, key.byteLength);
    }

    // Linear-scan get by key bytes. Returns null if absent. v1 keeps
    // it dumb (no hashing) because the convenience tier doesn't run
    // in the hot path — Tier 1 codegen handles the perf-sensitive
    // paths field-by-field.
    public JsonValue get(int8[] key, int32 keyLen) {
        int32 i = 0;
        while (i < this.sizeCount) {
            if (this.keyLens[i] == keyLen) {
                int8[] k = this.keys[i];
                boolean eq = true;
                int32 j = 0;
                while (j < keyLen) {
                    if (k[j] != key[j]) {
                        eq = false;
                        j = keyLen;       // break
                    } else {
                        j = j + 1;
                    }
                }
                if (eq) {
                    return this.values[i];
                }
            }
            i = i + 1;
        }
        return null;
    }

    public void put(#int8[] key, int32 keyLen, #JsonValue v) {
        if (this.sizeCount >= this.cap) {
            this.grow();
        }
        this.keys[this.sizeCount] = key;
        this.keyLens[this.sizeCount] = keyLen;
        this.values[this.sizeCount] = v;
        this.sizeCount = this.sizeCount + 1;
    }

    void grow() {
        int32 newCap = this.cap * 2;
        int8[][] dstK = new int8[newCap][];
        int32[] dstL = new int32[newCap];
        JsonValue[] dstV = new JsonValue[newCap];
        int32 i = 0;
        while (i < this.sizeCount) {
            dstK[i] = this.keys[i];
            dstL[i] = this.keyLens[i];
            dstV[i] = this.values[i];
            i = i + 1;
        }
        this.keys = dstK;
        this.keyLens = dstL;
        this.values = dstV;
        this.cap = newCap;
    }
}
