package cajeta.codec.json;

import cajeta.codec.json.JsonParseException;
import cajeta.lang.String;

/**
 * Tier-1 binding engine: a two-stage SIMD deserialization substrate the
 * `Json.parse<T>` synthesizer drives instead of the per-token pull
 * `JsonReader`. Stage 1 (`build`) runs the validated `Vector<int8,16>`
 * scanner with all hot state in registers and appends only *significant
 * byte positions* (`{ } [ ] : ,`, string-opens, scalar-starts) to a
 * caller-supplied `int32[]` — a sparse structural index, ~20% of input,
 * not `int32[n+16]`. Stage 2 is the synthesizer-generated walk: a tight
 * INLINE loop over the index that dispatches on the one byte at each
 * position, decodes only the fields T maps (`decode*`), and skips
 * unmapped subtrees via `skipValue`'s index depth-walk — no `next()`
 * call boundary, so the SIMD throughput reaches the binding.
 *
 * Why this beats the pull reader: a per-token `JsonReader.next()` forces
 * parser state into a heap object the AOT compiler can't register-promote
 * (caps ~1000 MB/s, below Jackson). The index decouples the SIMD scan
 * (stage 1, register state) from the walk (stage 2, array loads + inline
 * dispatch), and the walk recurses per-OBJECT (amortized) rather than
 * per-token. Measured combined build+walk: 2-3x Jackson where the pull
 * binding was 0.4x. See plans/Json-fast-path.md.
 *
 * Decode semantics are byte-for-byte parity with `JsonReader`: strings
 * copied verbatim (escapes NOT decoded), integers with overflow-throw and
 * throw-on-fractional, float64 naive accumulation.
 */
public final class JsonIndex {

    // Scalar fallback for a 16-byte block (or the <16 tail) that contains
    // a '\' — escape-aware, so a quote inside a string isn't mistaken for
    // a structural quote. Appends significant positions to idx[] from cnt;
    // returns the new cnt. flags[0..2] = inStr / prevVal / pend carry,
    // read on entry and written on exit. Rare path: only blocks with a
    // backslash take it.
    static int32 scalarAppend(int8[] b, int64 from, int64 to,
                              int8[] flags, int32[] idx, int32 cnt) {
        boolean inStr = flags[0] != (int8)0;
        boolean prevVal = flags[1] != (int8)0;
        boolean pend = flags[2] != (int8)0;
        int64 i = from;
        if (pend) { i = i + 1; pend = false; }
        while (i < to) {
            int8 c = b[i];
            if (inStr) {
                if (c == (int8)92) { if (i + 1 >= to) { pend = true; i = to; } else { i = i + 2; } continue; }
                if (c == (int8)34) { inStr = false; }
            } else {
                boolean isWs = c==(int8)32||c==(int8)9||c==(int8)10||c==(int8)13;
                boolean isStruct = c==(int8)123||c==(int8)125||c==(int8)91||c==(int8)93||c==(int8)58||c==(int8)44;
                if (c == (int8)34) { idx[cnt]=(int32)i; cnt=cnt+1; inStr = true; prevVal = false; }
                else if (isStruct) { idx[cnt]=(int32)i; cnt=cnt+1; prevVal = false; }
                else if (isWs) { prevVal = false; }
                else { if (!prevVal) { idx[cnt]=(int32)i; cnt=cnt+1; } prevVal = true; }
            }
            i = i + 1;
        }
        flags[0] = (int8)0; if (inStr) { flags[0] = (int8)1; }
        flags[1] = (int8)0; if (prevVal) { flags[1] = (int8)1; }
        flags[2] = (int8)0; if (pend) { flags[2] = (int8)1; }
        return cnt;
    }

    /**
     * Stage 1 — build the sparse structural index. SIMD scan with all hot
     * scanner state (inStr / prevVal / cnt / p) in stack locals; syncs to
     * the `flags` scratch only around backslash blocks and the tail.
     * Returns the number of significant positions appended to `idx`, which
     * must hold at least `n + 16` entries.
     */
    public static int32 build(int8[] b, int64 n, int32[] idx) {
        int8[] flags = heap int8[3];
        int32 cnt = 0;
        boolean instr = false; boolean pval = false; boolean pend = false;
        int64 p = 0;
        while (p + 16 <= n) {
            Vector<int8,16> v = Cajeta.vload16(b, p);
            int32 bsM = v.eqMask((int8)92);
            if (bsM != 0 || pend) {
                flags[0] = (int8)0; if (instr) { flags[0] = (int8)1; }
                flags[1] = (int8)0; if (pval) { flags[1] = (int8)1; }
                flags[2] = (int8)0; if (pend) { flags[2] = (int8)1; }
                cnt = JsonIndex.scalarAppend(b, p, p + 16, flags, idx, cnt);
                instr = flags[0] != (int8)0; pval = flags[1] != (int8)0; pend = flags[2] != (int8)0;
            } else {
                int32 lb = v.eqMask((int8)123); int32 rb = v.eqMask((int8)125);
                int32 ls = v.eqMask((int8)91);  int32 rs = v.eqMask((int8)93);
                int32 col = v.eqMask((int8)58);  int32 com = v.eqMask((int8)44);
                int32 qm = v.eqMask((int8)34);
                int32 ws = v.eqMask((int8)32)|v.eqMask((int8)9)|v.eqMask((int8)10)|v.eqMask((int8)13);
                int32 structM = lb|rb|ls|rs|col|com;
                int32 carry = 0; if (instr) { carry = 65535; }
                int32 vb0 = 0; if (pval) { vb0 = 1; }
                int32 pf = qm; pf=pf^(pf<<1); pf=pf^(pf<<2); pf=pf^(pf<<4); pf=pf^(pf<<8); pf=pf&65535;
                int32 inStr = (carry ^ (pf << 1)) & 65535;
                int32 openQ = qm & (~inStr) & 65535;
                int32 valueB = (~ws & ~structM & ~qm & ~inStr) & 65535;
                int32 vbPrev = ((valueB << 1) | vb0) & 65535;
                int32 scalarStart = valueB & (~vbPrev) & 65535;
                int32 sig = ((structM & (~inStr)) | openQ | scalarStart) & 65535;
                int32 m = sig;
                while (m != 0) {
                    int64 pos = Cajeta.ctz64((int64)(m & 65535));
                    int64 off = p + pos;
                    idx[cnt] = (int32) off; cnt = cnt + 1;
                    m = m & (m - 1);
                }
                int32 par = (pf >> 15) & 1;
                instr = ((((carry & 1) ^ par) & 1) != 0);
                pval = (((valueB >> 15) & 1) != 0);
            }
            p = p + 16;
        }
        flags[0] = (int8)0; if (instr) { flags[0] = (int8)1; }
        flags[1] = (int8)0; if (pval) { flags[1] = (int8)1; }
        flags[2] = (int8)0; if (pend) { flags[2] = (int8)1; }
        cnt = JsonIndex.scalarAppend(b, p, n, flags, idx, cnt);
        return cnt;
    }

    /**
     * Skip the value whose first index entry is at cursor `ci`, returning
     * the cursor just past it. Objects/arrays depth-walk over the index
     * (their interior structural entries net to zero) with NO value decode
     * — the on-demand skip a struct uses for keys it doesn't map. Scalars
     * and strings are a single index entry.
     */
    public static int32 skipValue(int8[] b, int32[] idx, int32 ci) {
        int32 pos = idx[ci];
        int8 c = b[pos];
        if (c == (int8)123 || c == (int8)91) {
            int32 depth = 0;
            boolean go = true;
            while (go) {
                int32 q = idx[ci];
                int8 cc = b[q];
                if (cc == (int8)123 || cc == (int8)91) { depth = depth + 1; }
                else if (cc == (int8)125 || cc == (int8)93) { depth = depth - 1; }
                ci = ci + 1;
                if (depth == 0) { go = false; }
            }
            return ci;
        }
        return ci + 1;
    }

    /**
     * Does the quoted key at `keyPos` (the opening `"`) equal `name`?
     * Compares raw bytes — a key with JSON escapes won't match a literal
     * field name, the same limitation the old byte-guard had. Exact-length
     * match is enforced by requiring the closing `"` right after `name`.
     */
    public static boolean keyEq(int8[] b, int64 keyPos, String name) {
        int8[] nb = name.bytes;
        int64 no = name.byteOffset();
        int32 nlen = name.byteLength;
        int32 i = 0;
        while (i < nlen) {
            int64 bp = keyPos + 1 + (int64) i;
            int8 cb = b[bp];
            int8 nbi = nb[no + i];
            if (cb != nbi) { return false; }
            i = i + 1;
        }
        int64 endp = keyPos + 1 + (int64) nlen;
        int8 ec = b[endp];
        return ec == (int8)34;
    }

    // End of a number token starting at `pos` — first byte not part of
    // the JSON number grammar (digits, sign, '.', exponent).
    static int64 numberEnd(int8[] b, int64 pos) {
        int64 n = (int64) b.count();
        int64 i = pos;
        boolean go = true;
        while (go && i < n) {
            int8 c = b[i];
            boolean isNum = (c >= (int8)48 && c <= (int8)57)
                || c == (int8)45 || c == (int8)43 || c == (int8)46
                || c == (int8)101 || c == (int8)69;
            if (isNum) { i = i + 1; } else { go = false; }
        }
        return i;
    }

    /**
     * Decode the integer value at `pos`. Parity with
     * `JsonReader.currentNumberAsInt64`: overflow-checked uint64
     * accumulation, throws on a fractional/exponent form or out-of-range.
     */
    public static int64 decodeI64(int8[] b, int64 pos) {
        int64 i = pos;
        int64 end = JsonIndex.numberEnd(b, pos);
        if (i >= end) { throw heap JsonParseException("empty number token", pos); }
        boolean negative = false;
        if (b[i] == (int8) 45) {
            negative = true; i = i + 1;
            if (i >= end) { throw heap JsonParseException("bare '-' is not a number", pos); }
        }
        uint64 acc = (uint64) 0;
        uint64 limit = (uint64) 9223372036854775807;
        if (negative) { limit = (uint64) 9223372036854775808; }
        uint64 limitDiv10 = limit / (uint64) 10;
        uint64 limitMod10 = limit - limitDiv10 * (uint64) 10;
        while (i < end) {
            int8 c = b[i];
            if (c < (int8) 48 || c > (int8) 57) {
                throw heap JsonParseException("non-integer number (v1 doesn't parse floats)", i);
            }
            uint64 d = (uint64) (((int32) c) - 48);
            if (acc > limitDiv10 || (acc == limitDiv10 && d > limitMod10)) {
                throw heap JsonParseException("number out of int64 range", pos);
            }
            acc = acc * (uint64) 10 + d;
            i = i + 1;
        }
        if (negative) {
            if (acc == (uint64) 9223372036854775808) { return (int64) -9223372036854775807 - (int64) 1; }
            return - (int64) acc;
        }
        return (int64) acc;
    }

    /** Decode the int32 value at `pos` by narrowing `decodeI64`. */
    public static int32 decodeI32(int8[] b, int64 pos) {
        return (int32) JsonIndex.decodeI64(b, pos);
    }

    /**
     * Decode the float64 value at `pos`. Parity with
     * `JsonReader.currentNumberAsFloat64`: optional sign, integer part,
     * optional fraction, optional exponent; naive accumulation.
     */
    public static float64 decodeF64(int8[] b, int64 pos) {
        int64 i = pos;
        int64 end = JsonIndex.numberEnd(b, pos);
        if (i >= end) { throw heap JsonParseException("empty number token", pos); }
        boolean negative = false;
        if (b[i] == (int8) 45) {
            negative = true; i = i + 1;
            if (i >= end) { throw heap JsonParseException("bare '-' is not a number", pos); }
        }
        float64 intPart = 0.0;
        while (i < end) {
            int8 c = b[i];
            if (c < (int8) 48 || c > (int8) 57) break;
            intPart = intPart * 10.0 + (float64) (((int32) c) - 48);
            i = i + 1;
        }
        float64 frac = 0.0;
        float64 scale = 1.0;
        if (i < end && b[i] == (int8) 46) {
            i = i + 1;
            while (i < end) {
                int8 c = b[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                scale = scale * 10.0;
                frac = frac + ((float64) (((int32) c) - 48)) / scale;
                i = i + 1;
            }
        }
        float64 r = intPart + frac;
        if (i < end && (b[i] == (int8) 101 || b[i] == (int8) 69)) {
            i = i + 1;
            boolean expNeg = false;
            if (i < end && b[i] == (int8) 45) { expNeg = true; i = i + 1; }
            else if (i < end && b[i] == (int8) 43) { i = i + 1; }
            int32 exp = 0;
            while (i < end) {
                int8 c = b[i];
                if (c < (int8) 48 || c > (int8) 57) break;
                exp = exp * 10 + (((int32) c) - 48);
                i = i + 1;
            }
            float64 pow10 = 1.0;
            int32 ej = 0;
            while (ej < exp) { pow10 = pow10 * 10.0; ej = ej + 1; }
            if (expNeg) { r = r / pow10; } else { r = r * pow10; }
        }
        if (negative) { return - r; }
        return r;
    }

    /** Decode the boolean value at `pos` — `true` starts with 't' (0x74). */
    public static boolean decodeBool(int8[] b, int64 pos) {
        int8 c = b[pos];
        return c == (int8) 116;
    }

    // Position of the closing quote for the string opening at
    // `openQuotePos`, skipping `\`-escapes.
    static int64 strInnerEnd(int8[] b, int64 openQuotePos) {
        int64 n = (int64) b.count();
        int64 i = openQuotePos + 1;
        boolean go = true;
        while (go && i < n) {
            int8 c = b[i];
            if (c == (int8) 92) { i = i + 2; }
            else if (c == (int8) 34) { go = false; }
            else { i = i + 1; }
        }
        return i;
    }

    /**
     * Wire-form bytes of the value whose first index entry is at cursor
     * `ci`, INCLUDING delimiters (a string's surrounding quotes; an
     * object/array's full `{...}` / `[...]` subtree). Parity with
     * `JsonReader.currentRawBytes()` — backs the @JsonRaw synthesizer arm.
     * The caller advances the cursor separately via `skipValue`.
     */
    public static #int8[] valueWireBytes(int8[] b, int32[] idx, int32 ci) {
        int32 startPos = idx[ci];
        int8 sc = b[startPos];
        int64 startOff = (int64) startPos;
        int64 endOff = startOff;
        if (sc == (int8) 123 || sc == (int8) 91) {
            int32 cj = ci;
            int32 depth = 0;
            int32 lastClose = startPos;
            boolean go = true;
            while (go) {
                int32 q = idx[cj];
                int8 cc = b[q];
                if (cc == (int8) 123 || cc == (int8) 91) { depth = depth + 1; }
                else if (cc == (int8) 125 || cc == (int8) 93) { depth = depth - 1; lastClose = q; }
                cj = cj + 1;
                if (depth == 0) { go = false; }
            }
            endOff = (int64) lastClose + 1;
        } else if (sc == (int8) 34) {
            endOff = JsonIndex.strInnerEnd(b, startOff) + 1;     // include closing quote
        } else if (sc == (int8) 116 || sc == (int8) 110) {       // true / null
            endOff = startOff + 4;
        } else if (sc == (int8) 102) {                           // false
            endOff = startOff + 5;
        } else {
            endOff = JsonIndex.numberEnd(b, startOff);
        }
        int32 len = (int32) (endOff - startOff);
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            int64 q = startOff + (int64) i;
            int8 cc = b[q];
            out[i] = cc;
            i = i + 1;
        }
        return out;
    }

    /**
     * Copy the inner bytes of the string opening at `openQuotePos` into a
     * fresh owned `int8[]` — verbatim, escapes NOT decoded, parity with
     * `JsonReader.currentBytes()`. The synthesizer wraps the result in a
     * `String` via the (int8[], int32) view ctor.
     */
    public static #int8[] decodeStrBytes(int8[] b, int64 openQuotePos) {
        int64 sp = openQuotePos + 1;
        int64 e = JsonIndex.strInnerEnd(b, openQuotePos);
        int32 len = (int32) (e - sp);
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            int64 q = sp + (int64) i;
            int8 cc = b[q];
            out[i] = cc;
            i = i + 1;
        }
        return out;
    }
}
