package cajeta.codec.json;

/**
 * Growable, ordered container of `JsonValue` elements backing the
 * `JsonValue.ARRAY` kind. A geometric-growth (`cap * 2`) backing
 * `JsonValue[]` with the minimal `count` / `get` / `add` surface.
 *
 * This is the Tier 3 convenience representation of a JSON array: a
 * built `JsonArray` is handed to a `JsonValue` via `setArray`,
 * which takes ownership (`#JsonArray`).
 *
 * ## Usage
 * ```cajeta
 * JsonArray arr = heap JsonArray();
 * JsonValue one = heap JsonValue();
 * one.setNumber(1);
 * arr.add(#one);
 * JsonValue two = heap JsonValue();
 * two.setString("two");
 * arr.add(#two);
 *
 * int32 n = arr.count();      // 2
 * JsonValue first = arr.get(0);
 *
 * // wrap as a JsonValue of kind ARRAY
 * JsonValue v = heap JsonValue();
 * v.setArray(#arr);
 * ```
 *
 * Name each node before you set it. `setX` returns a borrow, and on an
 * unnamed `heap JsonValue()` that borrow dies at the end of the statement.
 *
 * v1 surface; `Stream<JsonValue>` inheritance lands when
 * `JsonValue` settles further.
 */
public final class JsonArray {
    JsonValue[] data;
    int32 cap;
    int32 sizeCount;

    /**
     * Creates an empty array with an initial capacity of 8; it grows
     * automatically on `add`.
     *
     * ```cajeta
     * JsonArray arr = heap JsonArray();
     * JsonValue nothing = heap JsonValue();
     * nothing.setNull();
     * arr.add(#nothing);
     * ```
     */
    public JsonArray() {
        this.cap = 8;
        this.data = heap JsonValue[8];
        this.sizeCount = 0;
    }

    @Inline
    public int32 count() {
        return this.sizeCount;
    }


    /** VIEW of the stored element — borrow, valid while this JsonArray lives. */
    @Inline
    public JsonValue get(int32 i) {
        return this.data[i];
    }

    /**
     * Appends `v` to the end of the array, taking ownership of it
     * (`#JsonValue`), and grows the backing store if the capacity is
     * exhausted.
     *
     * ```cajeta
     * JsonArray arr = heap JsonArray();
     * JsonValue yes = heap JsonValue();
     * yes.setBoolean(true);
     * arr.add(#yes);
     * JsonValue answer = heap JsonValue();
     * answer.setNumber(42);
     * arr.add(#answer);
     * ```
     */
    public void add(#JsonValue v) {
        if (this.sizeCount >= this.cap) {
            this.grow();
        }
        this.data[this.sizeCount] #= v;
        this.sizeCount = this.sizeCount + 1;
    }

    /** Doubles the backing capacity and copies the live elements over. */
    @NoInline
    void grow() {
        int32 newCap = this.cap * 2;
        JsonValue[] dst = heap JsonValue[newCap];
        int32 i = 0;
        while (i < this.sizeCount) {
            // title-stores §2.1 — forwarding move: a plain `=` left the old
            // array owning its JsonValues, and the `#=` displacement below
            // freed them through the element-drop walk (use-after-free for
            // any array past 8 elements; json-grow-element-uaf).
            dst[i] #= this.data[i];
            i = i + 1;
        }
        this.data #= dst;
        this.cap = newCap;
    }
}
