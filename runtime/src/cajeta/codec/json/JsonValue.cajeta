package cajeta.codec.json;

import cajeta.lang.String;

/**
 * Tagged-union JSON value (Tier 3 convenience layer). Each value
 * carries a kind discriminator (int32) plus all six possible
 * payload fields; the field matching `kind` holds the meaningful
 * value, the rest are zero/null.
 *
 * Kinds:
 *   0  NULL
 *   1  BOOLEAN  → boolVal
 *   2  NUMBER   → numVal (int64; v1 has no float support yet)
 *   3  STRING   → strBytes / strLen
 *   4  ARRAY    → arrVal (JsonArray reference)
 *   5  OBJECT   → objVal (JsonObject reference)
 *
 * Wasteful per-instance footprint (~48 bytes regardless of kind)
 * — that's the cost of the convenience tier. The fast paths
 * (Tier 1 + 2) bypass JsonValue entirely and pay zero overhead.
 */
public final class JsonValue {

    // Named constants for the kind discriminator. Match the comment
    // table above; exposed so user code can compare against
    // `JsonValue.OBJECT` / `JsonValue.STRING` etc. instead of bare
    // ints. Kept on JsonValue (rather than a separate enum class)
    // so the discriminator stays a plain int32 — no enum allocation
    // per kind check.
    public static final int32 NULL    = 0;
    public static final int32 BOOLEAN = 1;
    public static final int32 NUMBER  = 2;
    public static final int32 STRING  = 3;
    public static final int32 ARRAY   = 4;
    public static final int32 OBJECT  = 5;

    int32 kind;
    boolean boolVal;
    int64 numVal;
    // NUMBER payload is a tagged scalar: integer literals keep the exact
    // int64 in `numVal` (numIsFloat=false); fractional/exponent literals
    // store the parsed double in `floatVal` (numIsFloat=true). asInt64 /
    // asFloat64 convert across the two so callers needn't branch.
    boolean numIsFloat;
    float64 floatVal;
    int8[] strBytes;
    int32 strLen;
    JsonArray arrVal;
    JsonObject objVal;

    /**
     * Construct an empty value of kind `NULL`. Populate it with one of
     * the `setX` builders, each of which sets the discriminator and
     * returns `this` so calls chain.
     *
     * ```cajeta
     * JsonValue v = JsonValue().setNumber(42);
     * if (v.kind() == JsonValue.NUMBER) {
     *     int64 n = v.asInt64();
     * }
     * ```
     */
    public JsonValue() {
        this.kind = 0;
        this.boolVal = false;
        this.numVal = 0;
        this.numIsFloat = false;
        this.floatVal = 0.0;
        this.strBytes = null;
        this.strLen = 0;
        this.arrVal = null;
        this.objVal = null;
    }

    @Inline
    public int32 kind() {
        return this.kind;
    }

    /** True when this value is JSON `null` (kind `NULL`). */
    @Inline
    public boolean isNull() {
        return this.kind == 0;
    }

    @Inline
    public boolean asBoolean() {
        return this.boolVal;
    }

    @Inline
    public int64 asInt64() {
        if (this.numIsFloat) {
            return (int64) this.floatVal;
        }
        return this.numVal;
    }

    /** Narrowing view of the NUMBER payload — truncates the int64 to int32. */
    @Inline
    public int32 asInt32() {
        return (int32) this.asInt64();
    }

    /** True iff this NUMBER carried a fraction/exponent (parsed as float64). */
    @Inline
    public boolean isFloat() {
        return this.numIsFloat;
    }

    /**
     * The NUMBER payload as `float64`. An integer literal widens exactly;
     * a fractional/exponent literal returns the parsed double.
     */
    @Inline
    public float64 asFloat64() {
        if (this.numIsFloat) {
            return this.floatVal;
        }
        return (float64) this.numVal;
    }

    // String bytes — borrowed view, caller must not free. v1 keeps
    // escapes verbatim because the reader's currentBytes() does too.
    @Inline
    public int8[] asBytes() {
        return this.strBytes;
    }

    @Inline
    public int32 asBytesLength() {
        return this.strLen;
    }

    /**
     * Materialize this STRING value as a `cajeta.lang.String`
     * view-mode instance over the borrowed byte slice. Preferred
     * over the raw `asBytes()` / `asBytesLength()` pair when the
     * caller wants String ergonomics (equality, hashing,
     * concatenation). Returns null for non-STRING kinds — caller
     * gates on `kind()` first if that matters.
     *
     * ```cajeta
     * String s = v.asString();
     * if (s != null) {
     *     // owns the materialized `String`
     * }
     * ```
     */
    public #String asString() {
        if (this.kind != 3) {
            return null;
        }
        // The (#int8[], int32) String ctor CONSUMES its buffer (its
        // @Native core frees short inputs, adopts long ones) — it must
        // never see this value's owned strBytes. Wrap a fresh copy.
        int32 n = this.strLen;
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = this.strBytes[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    @Inline
    public JsonArray asArray() {
        return this.arrVal;
    }

    @Inline
    public JsonObject asObject() {
        return this.objVal;
    }

    // Builders. Mutate `this` and return for chaining — keeps the
    // tagged-union layout consistent (callers shouldn't construct
    // a JsonValue with the wrong kind set on its payload).

    public JsonValue setNull() {
        this.kind = 0;
        return this;
    }

    public JsonValue setBoolean(boolean v) {
        this.kind = 1;
        this.boolVal = v;
        return this;
    }

    public JsonValue setNumber(int64 v) {
        this.kind = 2;
        this.numVal = v;
        this.numIsFloat = false;
        return this;
    }

    public JsonValue setFloat(float64 v) {
        this.kind = 2;
        this.floatVal = v;
        this.numIsFloat = true;
        return this;
    }

    public JsonValue setString(int8[] bytes, int32 len) {
        this.kind = 3;
        this.strBytes #= bytes;
        this.strLen = len;
        return this;
    }

    /**
     * String-typed `setString` overload. The String's bytes are
     * stored as a BORROW — the String's lifetime must outlive this
     * JsonValue. For ownership transfer use `setStringOwned(#bytes, len)`
     * (the bytes move into this JsonValue and the caller's local
     * deactivates).
     */
    public JsonValue setString(String s) {
        if (s.root() == null || s.byteOffset() != (int64) 0) {
            // A borrow of a toBytes() temp would dangle; transfer an
            // owned window copy instead.
            int8[] w = s.toBytes();
            return this.setStringOwned(#w, s.byteLength());
        }
        return this.setString(s.root(), s.byteLength());
    }

    // # — ownership transfer. The caller's local stops being live;
    // this JsonValue becomes the owner of the array. Without the
    // transfer, the caller's local would drop the array at scope
    // exit and leave this.arrVal dangling.
    public JsonValue setArray(#JsonArray a) {
        this.kind = 4;
        this.arrVal #= a;
        return this;
    }

    public JsonValue setObject(#JsonObject o) {
        this.kind = 5;
        this.objVal #= o;
        return this;
    }

    /**
     * STRING builder that TAKES OWNERSHIP of the byte slice (`#int8[]`).
     * The caller's local deactivates and this JsonValue frees the bytes
     * at its own scope exit. Contrast `setString(bytes, len)`, which only
     * borrows and requires the bytes to outlive this value.
     */
    public JsonValue setStringOwned(#int8[] bytes, int32 len) {
        this.kind = 3;
        this.strBytes #= bytes;
        this.strLen = len;
        return this;
    }
}
