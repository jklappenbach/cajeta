package cajeta.net;

import cajeta.lang.String;

/**
 * A `bind` requested an address that is not a local interface
 * address (or a `connect`/`sendto` named an unassignable address).
 * POSIX `EADDRNOTAVAIL` / Winsock `WSAEADDRNOTAVAIL`.
 * `kind == NetException.KIND_ADDRESS_NOT_AVAIL` (6). See
 * [`docs/stdlib/net/Errors.md`](../../../../../docs/stdlib/net/Errors.md).
 */
public class AddressNotAvailableException extends NetException {
    public AddressNotAvailableException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 6;   // NetException.KIND_ADDRESS_NOT_AVAIL
    }
}
