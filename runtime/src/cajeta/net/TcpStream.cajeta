package cajeta.net;

import cajeta.lang.String;
import cajeta.net.IpAddress;
import cajeta.net.SocketAddress;
import cajeta.net.NetErrors;
import cajeta.net.NetException;
import cajeta.net.ConnectionRefusedException;
import cajeta.net.TimedOutException;
import cajeta.net.BrokenPipeException;
import cajeta.net.reactor.Reactor;

// NOTE (NET / b1 socket receiver-lowering): this is the socket surface of
// `TcpStream`. The **sync** ops (`read`/`write`/`close`/options) are
// intrinsic-lowered at the call site (see MethodCallExpression.cpp,
// `cajeta.net.TcpStream` blocks); the stub bodies exist for the parser.
//
// The **async** ops (`readAsync`/`writeAsync`/`writeAllAsync`/`readWithin`,
// NET-3.3 / b3) are pure-Cajeta readiness loops written *over* those lowered
// sync ops plus the WouldBlock classifier (`@Native` bridges below) and
// `cajeta.net.reactor.Reactor` (un-gated by b3). They run on a fiber: a
// WouldBlock parks the fiber on the reactor and retries when the fd is ready,
// so the carrier never blocks on socket I/O (the no-carrier-blocks invariant).

/**
 * A connected **TCP stream** — the blocking client/peer socket of plan item
 * **NET-1.3**. The method bodies below are **intrinsic-lowered at the call
 * site** (the compiler recognizes a `cajeta.net.TcpStream` receiver and emits
 * the matching `__cajeta_net_*` native call), exactly the way a `File`
 * receiver lowers to `__cajeta_file_*`. The stub bodies exist for the parser.
 */
public class TcpStream implements ByteChannel {
    /**
     * OS socket descriptor, or `-1` once closed. The first declared field, so
     * after the vtable slot it is struct field index 1 — the same index
     * `File.fd` uses, so the descriptor-load codegen is byte-identical.
     */
    public int32 fd;

    /**
     * Internal-only ctor: wraps an already-connected/accepted descriptor.
     * User code reaches a `TcpStream` through [`connect`](#connect) (client)
     * or `TcpListener.accept()` (server).
     */
    public TcpStream(int32 fd) {
        this.fd = fd;
    }

    /**
     * The **would-block sentinel** returned by the non-blocking I/O forms when
     * the op could not complete immediately. A value, not an exception.
     */
    public static final int64 WOULD_BLOCK = -1;

    // ----- Factory (client connect) -----

    /**
     * Open a blocking TCP connection to `addr` and return the connected
     * stream. Intrinsic-lowered to: pack `addr` via
     * `__cajeta_net_sockaddr_pack` → `__cajeta_net_socket` →
     * `__cajeta_net_connect`; on the connect failure sentinel the codegen
     * raises. Takes ownership of `addr`.
     */
    public static #TcpStream connect(#SocketAddress addr) {
        return heap TcpStream(-1);
    }

    /**
     * Open a TCP connection to `addr` **without blocking the carrier** and
     * return the connected stream. Unlike [`readAsync`](#readAsync) /
     * [`writeAsync`](#writeAsync) — readiness loops over an already-lowered
     * non-blocking op — a non-blocking connect needs its own lowering: the
     * codegen creates the socket non-blocking, issues `__cajeta_net_connect`
     * (which returns the in-progress sentinel `EINPROGRESS`/`WSAEWOULDBLOCK`),
     * parks the fiber on [`Reactor.awaitWritable`](reactor/Reactor.cajeta#awaitWritable),
     * then reads `SO_ERROR` (`__cajeta_net_connect_result`) to confirm the
     * connection succeeded. A loopback connect that completes synchronously
     * skips the park. On a hard failure (e.g. `ConnectionRefused`) the codegen
     * closes the fd and raises. Takes ownership of `addr`. *(NET-3.3.)*
     *
     * The body is a placeholder; the call is intrinsic-lowered in
     * `MethodCallExpression` (the static `TcpStream.connect`/`connectAsync`
     * block), so this returns through the codegen, never the stub.
     */
    public static #TcpStream connectAsync(#SocketAddress addr) {
        return heap TcpStream(-1);
    }

    // ----- Instance I/O -----

    /**
     * Read up to `length` bytes into `dst[offset .. offset+length)`. Returns
     * the count actually filled; `0` is an orderly peer close (EOF), not an
     * error. Intrinsic-lowered to
     * `__cajeta_net_recv(this.fd, &dst[8+offset], length, 0)`.
     */
    public int64 read(int8[] dst, int64 offset, int64 length) {
        return 0;
    }

    /**
     * Write `data[offset .. offset+length)`. Returns the count actually
     * written. Intrinsic-lowered to
     * `__cajeta_net_send(this.fd, &data[8+offset], length, 0)`.
     */
    public int64 write(int8[] data, int64 offset, int64 length) {
        return 0;
    }

    /**
     * Write **all** of `data[offset .. offset+length)`, looping over short
     * writes until every byte is sent or a write raises.
     */
    public void writeAll(int8[] data, int64 offset, int64 length) {
        int64 sent = 0;
        while (sent < length) {
            int64 n = this.write(data, offset + sent, length - sent);
            if (n <= 0) {
                throw heap BrokenPipeException(
                    "writeAll: peer stopped accepting data");
            }
            sent = sent + n;
        }
    }

    // ----- Async I/O readiness bridges (NET-3.3 / b3) -----------------------
    //
    // The non-throwing WouldBlock classifier + the normalized last-error
    // ordinal + the non-blocking toggle, bound to the NET-1.7 native shim.
    // These let the pure-Cajeta readiness loops below branch on "would-block
    // (park + retry)" vs "real error (throw)" without constructing an
    // exception on the hot path (`isWouldBlockNative` reads the platform error
    // directly). `@Native` private static forwarders: static dispatch bypasses
    // the vtable, so no `final`-class gating concern.

    /** 1 iff the last socket op failed with WouldBlock / in-progress. */
    @Native("__cajeta_net_is_wouldblock")
    private static int32 isWouldBlockNative();

    /** The normalized `cajeta_net_err` ordinal of the last socket op. */
    @Native("__cajeta_net_last_error")
    private static int32 lastErrorNative();

    /** Toggle non-blocking mode on `fd` (tracked form). Returns 0 / -1. */
    @Native("__cajeta_net_set_nonblocking_tracked")
    private static int32 setNonBlockingNative(int32 fd, int32 nonblocking);

    /**
     * Put this stream's descriptor into non-blocking mode and ensure the net
     * reactor is initialized — the idempotent one-time setup every async op
     * runs before its first readiness loop. Cheap to repeat: the fcntl/
     * ioctlsocket toggle is a no-op when already set, and
     * [`Reactor.init`](reactor/Reactor.cajeta#init) is idempotent.
     */
    void ensureAsyncReady() {
        int32 fd = this.fd;
        TcpStream.setNonBlockingNative(fd, 1);
        Reactor.init();
    }

    /**
     * Async read up to `length` bytes into `buf[offset .. offset+length)`,
     * **parking the fiber** (not the carrier) on the reactor until the socket
     * is readable — plan item **NET-3.3**. Returns the count actually read
     * (`>= 0`); `0` is an orderly peer close (EOF), the terminate-on-`0`
     * contract [`AsyncReader`](socket/AsyncReader.cajeta) drives.
     *
     * The readiness loop: a non-blocking [`read`](#read) (lowered to `recv`)
     * either returns `>= 0` (done — data or EOF), or `-1`. On `-1` the
     * [`isWouldBlockNative`](#isWouldBlockNative) classifier decides: a
     * would-block parks the fiber via
     * [`Reactor.awaitReadable`](reactor/Reactor.cajeta#awaitReadable) and
     * retries; any other error raises the mapped
     * [`NetException`](NetException.cajeta) subtype.
     */
    public int64 readAsync(int8[] buf, int64 offset, int64 length) {
        this.ensureAsyncReady();
        int32 fd = this.fd;
        int64 result = -1;
        boolean done = false;
        while (!done) {
            int64 n = this.read(buf, offset, length);
            if (n >= 0) {
                result = n;          // data (n > 0) or orderly EOF (n == 0)
                done = true;
            } else {
                if (TcpStream.isWouldBlockNative() == 1) {
                    Reactor.awaitReadable(fd);    // park; retry on readiness
                } else {
                    int32 err = TcpStream.lastErrorNative();
                    throw NetErrors.fromErrno(err, "readAsync");
                }
            }
        }
        return result;
    }

    /**
     * Async write up to `length` bytes from `data[offset .. offset+length)`,
     * **parking the fiber** until the socket's send buffer has room — plan
     * item **NET-3.3**. Returns the count actually written (`> 0`). The
     * writable twin of [`readAsync`](#readAsync): a would-block parks on
     * [`Reactor.awaitWritable`](reactor/Reactor.cajeta#awaitWritable); any
     * other error raises. A `0`-byte write (peer gone) raises
     * [`BrokenPipeException`](BrokenPipeException.cajeta).
     */
    public int64 writeAsync(int8[] data, int64 offset, int64 length) {
        this.ensureAsyncReady();
        int32 fd = this.fd;
        int64 result = -1;
        boolean done = false;
        while (!done) {
            int64 n = this.write(data, offset, length);
            if (n > 0) {
                result = n;
                done = true;
            } else {
                if (n == 0) {
                    throw heap BrokenPipeException(
                        "writeAsync: peer stopped accepting data");
                }
                if (TcpStream.isWouldBlockNative() == 1) {
                    Reactor.awaitWritable(fd);    // park; retry on room
                } else {
                    int32 err = TcpStream.lastErrorNative();
                    throw NetErrors.fromErrno(err, "writeAsync");
                }
            }
        }
        return result;
    }

    /**
     * Async write **all** of `data[offset .. offset+length)`, looping
     * [`writeAsync`](#writeAsync) over short writes (each parking the fiber
     * until the send buffer drains) until every byte is on the wire — the
     * flush primitive [`AsyncWriter`](socket/AsyncWriter.cajeta) drives. A
     * write that cannot make progress raises
     * [`BrokenPipeException`](BrokenPipeException.cajeta) (from
     * [`writeAsync`](#writeAsync)).
     */
    public void writeAllAsync(int8[] data, int64 offset, int64 length) {
        int64 sent = 0;
        while (sent < length) {
            int64 n = this.writeAsync(data, offset + sent, length - sent);
            sent = sent + n;
        }
    }

    /**
     * Deadline-bounded async read (NET-3.4 / NET-9.6 slowloris mitigation):
     * like [`readAsync`](#readAsync) but bounds the total wait by `timeoutMs`
     * milliseconds. Returns the count read (`>= 0`, `0` = EOF); raises
     * [`TimedOutException`](TimedOutException.cajeta) if the deadline elapses
     * with the peer still idle, and drops the reactor registration on every
     * exit path (no leak — the
     * [`awaitReadableTimed`](reactor/Reactor.cajeta#awaitReadableTimed)
     * bracket).
     *
     * The deadline is budgeted once (`Reactor.nowMillis() + timeoutMs`) and
     * the *remaining* budget passed to each readiness wait, so a multi-wait
     * read (short read, retry) cannot reset its own deadline (the NET-3.4
     * monotonic-budget discipline). A non-positive `timeoutMs` degenerates to
     * the unbounded [`readAsync`](#readAsync).
     */
    public int64 readWithin(int8[] buf, int64 offset, int64 length,
                            int32 timeoutMs) {
        if (timeoutMs <= 0) {
            return this.readAsync(buf, offset, length);
        }
        this.ensureAsyncReady();
        int32 fd = this.fd;
        int64 deadline = Reactor.nowMillis() + (int64) timeoutMs;
        int64 result = -1;
        boolean done = false;
        while (!done) {
            int64 n = this.read(buf, offset, length);
            if (n >= 0) {
                result = n;
                done = true;
            } else {
                if (TcpStream.isWouldBlockNative() == 1) {
                    int64 remaining = deadline - Reactor.nowMillis();
                    if (remaining <= (int64) 0) {
                        throw heap TimedOutException(
                            "readWithin: deadline elapsed before data arrived");
                    }
                    int32 budget = (int32) remaining;
                    int32 probe = Reactor.awaitReadableTimed(fd, budget);
                    if (probe == Reactor.TIMEOUT) {
                        throw heap TimedOutException(
                            "readWithin: deadline elapsed before data arrived");
                    }
                    if (probe == Reactor.ERROR) {
                        int32 err = TcpStream.lastErrorNative();
                        throw NetErrors.fromErrno(err, "readWithin");
                    }
                    // READY: loop and retry the recv.
                } else {
                    int32 err = TcpStream.lastErrorNative();
                    throw NetErrors.fromErrno(err, "readWithin");
                }
            }
        }
        return result;
    }

    // ----- Socket options (NET-1.6 / b2) -----
    //
    // Typed option methods — each is intrinsic-lowered at the call site to the
    // dedicated NET-1.6 native helper, which holds the platform `level`/
    // `optname` constant in C (`runtime/native/cajeta_net_socket_options.c`);
    // the Cajeta surface passes only a portable boolean / int.

    /**
     * Enable / disable `TCP_NODELAY` — disabling Nagle's algorithm so small
     * writes are sent immediately. Lowers to
     * `__cajeta_net_set_nodelay(this.fd, on ? 1 : 0)`.
     */
    public void setNoDelay(boolean on) {
        return;
    }

    /** Read `TCP_NODELAY` back. Lowers to
     *  `__cajeta_net_get_nodelay(this.fd) != 0`. */
    public boolean getNoDelay() {
        return false;
    }

    /**
     * Enable / disable `SO_KEEPALIVE`. Lowers to
     * `__cajeta_net_set_keepalive(this.fd, on ? 1 : 0)`.
     */
    public void setKeepAlive(boolean on) {
        return;
    }

    /** Read `SO_KEEPALIVE` back. Lowers to
     *  `__cajeta_net_get_keepalive(this.fd) != 0`. */
    public boolean getKeepAlive() {
        return false;
    }

    /**
     * Set the kernel **receive** buffer size in bytes (`SO_RCVBUF`). The kernel
     * may round/clamp; read the effective value back with
     * [`getRecvBufferSize`](#getRecvBufferSize). Lowers to
     * `__cajeta_net_set_recvbuf(this.fd, bytes)`.
     */
    public void setRecvBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_RCVBUF` size in bytes. Lowers to
     *  `__cajeta_net_get_recvbuf(this.fd)`. */
    public int32 getRecvBufferSize() {
        return 0;
    }

    /**
     * Set the kernel **send** buffer size in bytes (`SO_SNDBUF`). Same
     * round/clamp caveat as [`setRecvBufferSize`](#setRecvBufferSize). Lowers
     * to `__cajeta_net_set_sendbuf(this.fd, bytes)`.
     */
    public void setSendBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_SNDBUF` size in bytes. Lowers to
     *  `__cajeta_net_get_sendbuf(this.fd)`. */
    public int32 getSendBufferSize() {
        return 0;
    }

    /**
     * Configure `SO_LINGER`. `on == false` disables linger; `on == true` makes
     * `close()` block up to `seconds` flushing unsent data. Lowers to
     * `__cajeta_net_set_linger(this.fd, on ? 1 : 0, seconds)`.
     */
    public void setLinger(boolean on, int32 seconds) {
        return;
    }

    /** Read the `SO_LINGER` enable flag back (`true` iff linger is on). Lowers
     *  to `__cajeta_net_get_linger(this.fd, &on, &secs)` returning the `on`
     *  field. */
    public boolean getLinger() {
        return false;
    }

    /**
     * Set the outbound unicast hop limit / TTL (`IP_TTL` for IPv4,
     * `IPV6_UNICAST_HOPS` for IPv6; `0..255`). Lowers to
     * `__cajeta_net_set_ttl(this.fd, isV6, ttl)`.
     */
    public void setTtl(int32 ttl) {
        return;
    }

    /** The current outbound TTL / hop limit. Lowers to
     *  `__cajeta_net_get_ttl(this.fd, isV6)`. */
    public int32 getTtl() {
        return 0;
    }

    // ----- Lifecycle -----

    /**
     * Shut down part of the full-duplex connection without closing the
     * descriptor. `how`: `0` = read, `1` = write, `2` = both. Intrinsic-
     * lowered to `__cajeta_net_shutdown(this.fd, how)`.
     */
    public void shutdown(int32 how) {
        return;
    }

    /**
     * Close the underlying socket. Idempotent. Intrinsic-lowered to
     * `__cajeta_net_close(this.fd)`, then sets `this.fd = -1`.
     */
    public void close() {
        return;
    }

    /**
     * Destructor: closes the socket if [`close`](#close) wasn't called, so a
     * dropped `TcpStream` never leaks a descriptor.
     */
    public ~TcpStream() {
        this.close();
    }
}
