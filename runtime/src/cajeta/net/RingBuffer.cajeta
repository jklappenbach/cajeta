package cajeta.net;

/**
 * Fixed-capacity circular byte buffer with **high / low watermark**
 * backpressure signalling — the incremental-parser staging buffer.
 * See `cajeta-docs/Net.md` § *Buffer pool*.
 *
 * Bytes wrap modulo `cap` (a `head`/`tail`/`size` ring, the same
 * shape `threading.Channel` uses for items). The ring never grows:
 * its whole purpose is to bound memory and surface back-pressure
 * when the consumer falls behind the producer.
 *
 * ### Watermarks
 *
 * Two thresholds gate the producer:
 *
 * - **high watermark** — once `size() >= highWatermark`, the buffer
 *   is *over* (`isOverHighWatermark()`). The reactor stops asking
 *   the socket for more data: it pauses the read registration so
 *   the kernel's own window applies back-pressure to the peer.
 * - **low watermark** — once the consumer has drained back down to
 *   `size() <= lowWatermark`, `isUnderLowWatermark()` flips true and
 *   the reactor resumes reading.
 *
 * Splitting the two (rather than a single threshold) avoids
 * thrashing the read registration on every byte around the limit —
 * a hysteresis band. The caller is expected to track the paused/
 * resumed edge itself; this type only reports the levels.
 *
 * **Pure logic** — no syscalls, no locking (single-fiber owner per
 * connection). Owned `int8[]` storage, array-dropped on drop.
 */
public class RingBuffer {
    /** Backing ring storage. Owned; never resized. */
    int8[] data;

    /** Allocated ring length. */
    int32 cap;

    /** Index of the oldest readable byte. */
    int32 head;

    /** Index where the next written byte lands. */
    int32 tail;

    /** Number of bytes currently buffered: `0 <= size <= cap`. */
    int32 size;

    /** Producer pauses at/above this fill level. */
    int32 highWatermark;

    /** Producer resumes at/below this fill level. */
    int32 lowWatermark;

    /**
     * Build a ring of `capacity` bytes with the given watermarks.
     *
     * Watermarks are clamped into a sane band: `high` to
     * `[1, capacity]` and `low` to `[0, high]`. Passing `high ==
     * capacity` means "only pause when completely full"; `low == 0`
     * means "only resume when fully drained".
     */
    public RingBuffer(int32 capacity, int32 low, int32 high) {
        this.data = heap int8[capacity];
        this.cap = capacity;
        this.head = 0;
        this.tail = 0;
        this.size = 0;

        int32 hi = high;
        if (hi > capacity) {
            hi = capacity;
        }
        if (hi < 1) {
            hi = 1;
        }
        int32 lo = low;
        if (lo < 0) {
            lo = 0;
        }
        if (lo > hi) {
            lo = hi;
        }
        this.highWatermark = hi;
        this.lowWatermark = lo;
    }

    /** Allocated ring capacity in bytes. */
    public int32 capacity() {
        return this.cap;
    }

    /** Bytes currently buffered. */
    public int32 size() {
        return this.size;
    }

    /** Free space: `cap - size`. */
    public int32 free() {
        return this.cap - this.size;
    }

    /** True when no bytes are buffered. */
    public boolean isEmpty() {
        return this.size == 0;
    }

    /** True when the ring holds `cap` bytes. */
    public boolean isFull() {
        return this.size == this.cap;
    }

    /** Configured high watermark. */
    public int32 highWatermarkLevel() {
        return this.highWatermark;
    }

    /** Configured low watermark. */
    public int32 lowWatermarkLevel() {
        return this.lowWatermark;
    }

    /**
     * True when the fill level has reached the high watermark — the
     * reactor should pause the read registration so the peer feels
     * back-pressure.
     */
    public boolean isOverHighWatermark() {
        return this.size >= this.highWatermark;
    }

    /**
     * True when the fill level has fallen to/below the low
     * watermark — the reactor may resume reading.
     */
    public boolean isUnderLowWatermark() {
        return this.size <= this.lowWatermark;
    }

    /**
     * Append up to `len` bytes from `src[srcOff..]`, wrapping at the
     * ring boundary. Returns the count actually written —
     * `min(len, free())` — so a short write tells the producer the
     * ring is full (the back-pressure edge).
     */
    public int32 write(int8[] src, int32 srcOff, int32 len) {
        int32 room = this.cap - this.size;
        int32 n = len;
        if (n > room) {
            n = room;
        }
        int32 i = 0;
        while (i < n) {
            this.data[this.tail] = src[srcOff + i];
            this.tail = this.tail + 1;
            if (this.tail == this.cap) {
                this.tail = 0;
            }
            i = i + 1;
        }
        this.size = this.size + n;
        return n;
    }

    /**
     * Copy up to `len` bytes from the front of the ring into
     * `dst[dstOff..]`, removing them. Returns the count actually
     * copied — `min(len, size())`.
     */
    public int32 read(int8[] dst, int32 dstOff, int32 len) {
        int32 n = len;
        if (n > this.size) {
            n = this.size;
        }
        int32 i = 0;
        while (i < n) {
            dst[dstOff + i] = this.data[this.head];
            this.head = this.head + 1;
            if (this.head == this.cap) {
                this.head = 0;
            }
            i = i + 1;
        }
        this.size = this.size - n;
        return n;
    }

    /**
     * Peek at the byte `offset` positions ahead of the read cursor
     * without consuming it — incremental parsers look ahead for a
     * delimiter (`\r\n`, a frame header) before deciding to consume.
     * `offset` is relative to `head`; the caller checks
     * `offset < size()` first.
     */
    public int8 peek(int32 offset) {
        int32 idx = this.head + offset;
        if (idx >= this.cap) {
            idx = idx - this.cap;
        }
        return this.data[idx];
    }

    /**
     * Discard up to `n` buffered bytes without copying them out —
     * the consume step after a parser has peeked a complete token.
     * Returns the count actually skipped — `min(n, size())`.
     */
    public int32 skip(int32 n) {
        int32 m = n;
        if (m > this.size) {
            m = this.size;
        }
        this.head = this.head + m;
        while (this.head >= this.cap) {
            this.head = this.head - this.cap;
        }
        this.size = this.size - m;
        return m;
    }

    /** Drop all buffered bytes and reset the cursors. */
    public void clear() {
        this.head = 0;
        this.tail = 0;
        this.size = 0;
    }
}
