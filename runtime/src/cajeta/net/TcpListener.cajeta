package cajeta.net;

import cajeta.lang.String;
import cajeta.net.IpAddress;
import cajeta.net.SocketAddress;
import cajeta.net.NetErrors;
import cajeta.net.NetException;
import cajeta.net.reactor.Reactor;

/**
 * A **passive TCP listening socket** — `bind` + `listen` + a blocking
 * [`accept`](#accept) that returns one accepted connection (plan item
 * **NET-1.4**).
 *
 * ## Shape
 *
 * ```cajeta
 * TcpListener l = TcpListener.bind(SocketAddress.parse("0.0.0.0:8080"));
 * l.setReuseAddress(true);
 * TcpStream conn = l.accept();          // blocks until a client connects
 * ```
 *
 * This is the blocking, Phase-1 surface. The async `acceptAsync`
 * (NET-3.3) and the `Server` accept stacks (NET-4) build on the same
 * fd, driving it non-blocking through the reactor; the blocking
 * `accept` here parks the **carrier thread** in the syscall and is
 * meant for simple bring-up + tests, not servers (see
 * [`cajeta-docs/Net.md`](../../../../../cajeta-docs/Net.md) §The async
 * model).
 *
 * ## fd convention
 *
 * The listening descriptor is pinned at field index 1 (after the
 * vtable), the **same** index [`File.fd`](../io/file/File.cajeta) and
 * the sibling `TcpStream` (NET-1.3) use, so the intrinsic codegen
 * addresses it identically across file + socket types. `-1` is the
 * universal "closed / no socket" sentinel. The method bodies below are
 * intrinsic-lowered at the call site (exactly as `File`'s are); the
 * stub bodies exist for the parser.
 *
 * ## Errors
 *
 * Every failing primitive reads the normalized cross-platform ordinal
 * (`__cajeta_net_last_error()`, mirrored by `NetException.KIND_*`) and
 * raises the mapped [`NetException`](NetException.cajeta) subtype via
 * [`NetErrors.fromErrno`](NetErrors.cajeta), citing the bound address:
 * a `bind` to a taken port surfaces
 * [`AddressInUseException`](AddressInUseException.cajeta); a `bind` to
 * a non-local address surfaces
 * [`AddressNotAvailableException`](AddressNotAvailableException.cajeta).
 */
public class TcpListener {
    /**
     * The OS listening-socket descriptor, or `-1` once closed. Pinned
     * at field index 1 (after the vtable) so the intrinsic codegen
     * addresses it identically to `File` / `TcpStream`.
     */
    public int32 fd;

    /**
     * The local address this listener is bound to (filled by
     * [`bind`](#bind) from the post-bind `getsockname`, so an
     * ephemeral-port bind — `"0.0.0.0:0"` — reports the kernel-assigned
     * port). Field index 2.
     */
    public SocketAddress local;

    /**
     * Internal handle ctor wired by [`bind`](#bind). User code goes
     * through the static factory; the factory binds `fd` from the
     * `socket()` + `bind()` + `listen()` syscall sequence and resolves
     * `local` via `getsockname`.
     */
    public TcpListener(int32 fd) {
        this.fd = fd;
        this.local = heap SocketAddress();
    }

    // ----- bind / listen factory -------------------------------------------

    /**
     * Bind a fresh TCP listening socket to `addr` and start listening
     * with the default backlog (128). The family (IPv4 / IPv6) is taken
     * from `addr.getFamily()`.
     *
     * Lowering (the call site expands to this intrinsic sequence):
     *
     *   1. `fd = __cajeta_net_socket(family, SOCK_STREAM, 0)` — the
     *      cajeta layer maps `addr.getFamily()` → the native family
     *      constant (the same ordinal table NET-1.2's `sockaddr_pack`
     *      owns).
     *   2. `__cajeta_net_set_reuseaddr(fd, 1)` — set SO_REUSEADDR by
     *      default so a server restart does not trip `TIME_WAIT`
     *      `EADDRINUSE` (the universal server expectation; opt out with
     *      a future builder if ever needed).
     *   3. pack `addr` via `__cajeta_net_sockaddr_pack` →
     *      `__cajeta_net_bind(fd, packed, len)`.
     *   4. `__cajeta_net_listen(fd, 128)`.
     *   5. `__cajeta_net_getsockname(fd, ...)` →
     *      `__cajeta_net_sockaddr_unpack` to set `local` (resolves the
     *      ephemeral port for a `:0` bind).
     *
     * On any failing step the lowering reads `__cajeta_net_last_error()`
     * and `throw`s `NetErrors.fromErrno(err, "bind to " + addr)`.
     *
     * @param addr the local address + port to bind (port `0` ⇒ the
     *             kernel picks an ephemeral port, readable afterward via
     *             [`localAddress`](#localAddress)).
     * @return an owned, listening `TcpListener`.
     */
    public static #TcpListener bind(SocketAddress addr) {
        return heap TcpListener(-1);
    }

    /**
     * Bind with an explicit accept-queue `backlog` (the `listen(2)`
     * backlog — the kernel's cap on pending, not-yet-accepted
     * connections). Otherwise identical to [`bind`](#bind). A `backlog`
     * `<= 0` is clamped to the platform default.
     */
    public static #TcpListener bindWithBacklog(SocketAddress addr, int32 backlog) {
        return heap TcpListener(-1);
    }

    // ----- accept ----------------------------------------------------------

    /**
     * Block until a client connects, then return the accepted
     * connection as a `TcpStream` (NET-1.3). The peer address is
     * captured from the `accept` out-param so the returned stream's
     * `peerAddress()` is populated without a second syscall.
     *
     * Lowering:
     *
     *   1. size a sockaddr scratch buffer to
     *      `__cajeta_net_sockaddr_storage_size()`;
     *   2. `connFd = __cajeta_net_accept(this.fd, scratch, &len)`;
     *      `connFd < 0` ⇒ read `__cajeta_net_last_error()` and `throw`
     *      `NetErrors.fromErrno(err, "accept on " + this.local)`;
     *   3. `heap TcpStream(connFd)`, its peer set from
     *      `__cajeta_net_sockaddr_unpack(scratch, len, ...)`.
     *
     * For the async, carrier-non-blocking form use `acceptAsync`
     * (NET-3.3). The raw [`acceptFd`](#acceptFd) primitive below is the
     * fd-level half this method is built on (and the half the NET-1.4
     * golden-vector test pins independently of the NET-1.3 `TcpStream`
     * class).
     */
    public #TcpStream accept() {
        return heap TcpStream(this.acceptFd());
    }

    /**
     * The fd-level half of [`accept`](#accept): block for one
     * connection and return its **raw descriptor** (`>= 0`), or `throw`
     * the mapped [`NetException`](NetException.cajeta) on failure. This
     * is what [`accept`](#accept) wraps in a `TcpStream`; it is exposed
     * so the listener is fully usable + testable at the fd layer even
     * before the NET-1.3 `TcpStream` surface lands, and so callers that
     * want to hand the fd to a different stream type can.
     *
     * Lowering: `__cajeta_net_accept(this.fd, null, null)` (the peer
     * address is discarded on this path), with the failure → exception
     * mapping above.
     */
    public int32 acceptFd() {
        return -1;
    }

    // ----- Async accept (NET-3.3) ------------------------------------------

    /**
     * Async [`accept`](#accept): **park the fiber** (never the carrier) until a
     * client connects, then return the accepted connection as a
     * [`TcpStream`](TcpStream.cajeta). The async sibling the
     * [`Server`](../../../../cajeta-docs/Net.md) accept loop (NET-4) drives.
     *
     * Loop: ensure the listener is non-blocking →
     * [`acceptFdOrWouldBlock`](#acceptFdOrWouldBlock); while it reports
     * [`WOULD_BLOCK`](#WOULD_BLOCK) (no connection pending), park on
     * `Reactor.awaitReadable(this.fd)` — a listening socket becomes
     * **readable** when a connection is queued — then retry. The accepted
     * descriptor (`>= 0`) is wrapped in a fresh `TcpStream`. A hard `accept`
     * error still raises the mapped [`NetException`](NetException.cajeta) from
     * the non-blocking primitive, so the loop never spins on a real fault.
     *
     * The returned stream is in the kernel-default (blocking) mode; the caller
     * (or its `readAsync`/`writeAsync` first use) puts it non-blocking for its
     * own reactor loops — accepting and serving are independent fds.
     */
    public #TcpStream acceptAsync() {
        this.setNonBlocking(true);
        Reactor.init();
        while (true) {
            int32 connFd = this.acceptFdOrWouldBlock();
            if (connFd != TcpListener.WOULD_BLOCK) {
                return heap TcpStream(connFd);
            }
            if (!Reactor.awaitReadable(this.fd)) {
                throw heap NetException("acceptAsync: reactor wait failed");
            }
        }
        // Unreachable — the loop returns an accepted stream or throws.
        return heap TcpStream(-1);
    }

    // ----- Non-blocking mode (NET-1.7) -------------------------------------

    /**
     * The **would-block sentinel** [`acceptFdOrWouldBlock`](#acceptFdOrWouldBlock)
     * returns when no connection is pending and the listener is in
     * non-blocking mode (plan item **NET-1.7**). A value, **not** an
     * exception — the reactor (NET-3) drives the `acceptAsync` readiness loop
     * on it. `-1` is distinct from every accepted descriptor (which is `>= 0`).
     */
    public static final int32 WOULD_BLOCK = -1;

    /**
     * Put the listening descriptor in **non-blocking** (`on == true`) or
     * blocking mode. In non-blocking mode
     * [`acceptFdOrWouldBlock`](#acceptFdOrWouldBlock) returns
     * [`WOULD_BLOCK`](#WOULD_BLOCK) instead of parking when the accept queue is
     * empty — the foundation `acceptAsync` (NET-3.3) loops on. Intrinsic-
     * lowered to `__cajeta_net_set_nonblocking_tracked(this.fd, on ? 1 : 0)`;
     * a `-1` return raises via [`NetErrors.fromErrno`](NetErrors.cajeta).
     */
    public void setNonBlocking(boolean on) {
        return;
    }

    /**
     * `true` iff this listener is in non-blocking mode. Intrinsic-lowered to
     * `__cajeta_net_get_nonblocking(this.fd) != 0` (see
     * [`TcpStream.isNonBlocking`](TcpStream.cajeta#isNonBlocking) for the
     * platform note).
     */
    public boolean isNonBlocking() {
        return false;
    }

    /**
     * Non-blocking [`acceptFd`](#acceptFd): return the accepted connection's
     * raw descriptor (`>= 0`), or [`WOULD_BLOCK`](#WOULD_BLOCK) (`-1`) if no
     * connection is pending and this listener is in non-blocking mode. A hard
     * error still raises the mapped [`NetException`](NetException.cajeta) — only
     * the would-block case is the value (NET-1.7).
     *
     * Intrinsic-lowered to: `c = __cajeta_net_accept(this.fd, null, null)`; if
     * `c < 0` then `if (__cajeta_net_is_wouldblock())` return `WOULD_BLOCK`
     * else `throw NetErrors.fromErrno(__cajeta_net_last_error(), "accept")`.
     * This is the fd-level half the reactor's `acceptAsync` (NET-3.3) loops on.
     */
    public int32 acceptFdOrWouldBlock() {
        return -1;
    }

    // ----- options ---------------------------------------------------------

    /**
     * Enable / disable `SO_REUSEADDR` — allow `bind` to a local address
     * still lingering in `TIME_WAIT` (the canonical server-restart
     * need). [`bind`](#bind) sets it on by default; this lets a caller
     * toggle it explicitly. Lowers to
     * `__cajeta_net_set_reuseaddr(this.fd, on ? 1 : 0)`; a `-1` return
     * raises via `NetErrors.fromErrno`.
     *
     * Note: to *take effect* `SO_REUSEADDR` must be set **before**
     * `bind`, so in practice it is the default-on path in `bind` that
     * matters; this setter is here for parity with the option surface
     * and for the set-then-read-back test.
     */
    public void setReuseAddress(boolean on) {
        return;
    }

    /** Read `SO_REUSEADDR` back (`true` iff enabled). Lowers to
     *  `__cajeta_net_get_reuseaddr(this.fd) != 0`. */
    public boolean getReuseAddress() {
        return false;
    }

    /**
     * Enable / disable `SO_REUSEPORT` — load-balanced multi-socket bind
     * to the **same** port (Linux 3.9+, the BSDs, macOS). On Windows,
     * which has no distinct `SO_REUSEPORT` (its `SO_REUSEADDR` already
     * permits port sharing), this is a definitional no-op that succeeds.
     * Lowers to `__cajeta_net_set_reuseport(this.fd, on ? 1 : 0)`.
     */
    public void setReusePort(boolean on) {
        return;
    }

    /**
     * Enable / disable `IPV6_V6ONLY` on an IPv6 listening socket (NET-1.6).
     * When off, an IPv6 listener also accepts IPv4-mapped connections
     * (dual-stack `::ffff:a.b.c.d`); when on it is IPv6-only. Platform
     * defaults differ (Linux off, the BSDs/Windows on), so a server that
     * wants a definite behavior sets it explicitly. Valid only on an IPv6
     * socket; to take effect it must be set **before** [`bind`](#bind), so in
     * practice a dual-stack server would need a builder hook — this setter is
     * here for the option-surface parity + the set/read-back test. Lowers to
     * `__cajeta_net_set_only_v6(this.fd, on ? 1 : 0)`.
     */
    public void setOnlyV6(boolean on) {
        return;
    }

    /** Read `IPV6_V6ONLY` back. Lowers to
     *  `__cajeta_net_get_only_v6(this.fd) != 0`. */
    public boolean getOnlyV6() {
        return false;
    }

    // ----- address ---------------------------------------------------------

    /**
     * The local address this listener is bound to — for a `:0`
     * (ephemeral) bind this carries the kernel-assigned port, resolved
     * at [`bind`](#bind) time via `getsockname`. Reads the cached
     * [`local`](#local) field; no syscall.
     */
    public SocketAddress localAddress() {
        return this.local;
    }

    // ----- lifecycle -------------------------------------------------------

    /**
     * Close the listening socket. Idempotent — sets `this.fd = -1` so a
     * second call is a no-op (matching [`File.close`](../io/file/File.cajeta)).
     * Lowers to `__cajeta_net_close(this.fd)`; in-flight `accept` calls
     * on other carriers unblock with an error. The destructor also
     * closes.
     */
    public void close() {
        return;
    }
}
