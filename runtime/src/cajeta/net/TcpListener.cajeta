package cajeta.net;

import cajeta.lang.String;
import cajeta.net.IpAddress;
import cajeta.net.SocketAddress;
import cajeta.net.NetException;

// NOTE (NET / b1 socket receiver-lowering): the **sync** listener surface.
// `acceptAsync` depends on `cajeta.net.reactor.Reactor` (gated; un-gated by
// b3), so it is omitted here for b1. `bind` / `accept` / `acceptFd` / `close`
// are intrinsic-lowered at the call site (see MethodCallExpression.cpp,
// `cajeta.net.TcpListener` block).

/**
 * A **passive TCP listening socket** — `bind` + `listen` + a blocking
 * [`accept`](#accept) that returns one accepted connection (plan item
 * **NET-1.4**). The method bodies are intrinsic-lowered at the call site
 * (exactly as `File`'s are); the stub bodies exist for the parser.
 */
public class TcpListener {
    /**
     * The OS listening-socket descriptor, or `-1` once closed. First declared
     * field → struct field index 1 (after the vtable), the same index
     * `File` / `TcpStream` use.
     */
    public int32 fd;

    /**
     * Internal handle ctor wired by [`bind`](#bind).
     *
     * NOTE (b1): the listener carries only `fd`. The full
     * `localAddress() -> SocketAddress` accessor (which materializes a
     * `SocketAddress` object) arrives with the object-materializing lowering
     * in a later increment; b1 exposes [`boundPort`](#boundPort) instead. The
     * `bind` static lowering allocates this object directly (bypassing this
     * ctor, like `File.open`), so keeping the struct to a single `fd` field
     * avoids a non-primitive field the bypass would leave uninitialized.
     */
    public TcpListener(int32 fd) {
        this.fd = fd;
    }

    // ----- bind / listen factory -------------------------------------------

    /**
     * Bind a fresh TCP listening socket to `addr` and start listening with the
     * default backlog (128). Intrinsic-lowered to
     * `__cajeta_net_socket` → `__cajeta_net_set_reuseaddr` →
     * `__cajeta_net_sockaddr_pack` → `__cajeta_net_bind` →
     * `__cajeta_net_listen`, returning an owned, listening `TcpListener`.
     */
    public static #TcpListener bind(SocketAddress addr) {
        return heap TcpListener(-1);
    }

    // ----- accept ----------------------------------------------------------

    /**
     * Block until a client connects, then return the accepted connection as a
     * `TcpStream` (NET-1.3). Intrinsic-lowered: `connFd =
     * __cajeta_net_accept(this.fd, null, null)` → `heap TcpStream(connFd)`.
     */
    public #TcpStream accept() {
        return heap TcpStream(this.acceptFd());
    }

    /**
     * The fd-level half of [`accept`](#accept): block for one connection and
     * return its **raw descriptor** (`>= 0`), or `throw` on failure.
     * Intrinsic-lowered to `__cajeta_net_accept(this.fd, null, null)`.
     */
    public int32 acceptFd() {
        return -1;
    }

    // ----- address ---------------------------------------------------------

    /**
     * The kernel-assigned local **port** this listener is bound to (resolves
     * the ephemeral port for a `:0` bind). Intrinsic-lowered to
     * `__cajeta_net_getsockname(this.fd, scratch, &len)` →
     * `__cajeta_net_sockaddr_unpack(scratch, len, octets, &port)`, returning
     * the unpacked `port`. The lightweight port-only query the b1 loopback
     * echo uses to connect a client back to an ephemeral-port listener
     * (the full `SocketAddress`-returning `localAddress()` arrives with the
     * object-materializing lowering in a later increment).
     */
    public int32 boundPort() {
        return -1;
    }

    // ----- lifecycle -------------------------------------------------------

    /**
     * Close the listening socket. Idempotent — sets `this.fd = -1` so a second
     * call is a no-op. Lowers to `__cajeta_net_close(this.fd)`.
     */
    public void close() {
        return;
    }
}
