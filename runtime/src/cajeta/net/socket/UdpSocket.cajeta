package cajeta.net;

import cajeta.net.RecvResult;
import cajeta.net.SocketAddress;
import cajeta.net.reactor.Reactor;

/**
 * A **UDP datagram socket** (plan item **NET-1.5**) — the
 * connectionless transport peer of the connection-oriented
 * [`TcpStream`](TcpStream.cajeta) / [`TcpListener`](TcpListener.cajeta).
 *
 * ## Surface
 *
 *   - [`bind`](#bind) — create a `SOCK_DGRAM` socket and bind it to a
 *     local [`SocketAddress`](SocketAddress.cajeta). `0.0.0.0:0`
 *     (or `[::]:0`) asks the kernel for an ephemeral port + the
 *     wildcard address.
 *   - [`sendTo`](#sendTo) / [`recvFrom`](#recvFrom) — the *unconnected*
 *     datagram path: each `sendTo` names its destination explicitly,
 *     and [`recvFrom`](#recvFrom) returns a
 *     [`RecvResult`](RecvResult.cajeta) reporting both the byte count
 *     **and the sender's address** (UDP datagrams may arrive from any
 *     peer, so the caller must learn who sent each one to reply).
 *   - [`connect`](#connect) — set a **default peer**. UDP `connect`
 *     does not perform a handshake; it filters inbound datagrams to
 *     that peer and lets the *connected* [`send`](#send) /
 *     [`recv`](#recv) forms omit the address.
 *   - [`send`](#send) / [`recv`](#recv) — the *connected* path, valid
 *     only after [`connect`](#connect); they reuse the stored peer.
 *
 * ## Addressing & families
 *
 * The local [`SocketAddress`](SocketAddress.cajeta) passed to
 * [`bind`](#bind) selects the family: an IPv4 address opens an
 * `AF_INET` socket, an IPv6 address an `AF_INET6` one. The address is
 * marshalled to a raw `sockaddr` through
 * [`__cajeta_net_sockaddr_pack`](../../../native/cajeta_net_sockaddr.c)
 * (NET-1.2), and the sender address [`recvFrom`](#recvFrom) reports is
 * reconstructed via `__cajeta_net_sockaddr_unpack`. The cajeta surface
 * never sees a platform `AF_*` constant — that mapping lives in the
 * native marshalling layer, keyed on the portable
 * [`AddressFamily`](AddressFamily.cajeta) ordinal.
 *
 * ## fd ABI
 *
 * The descriptor is held in [`fd`](#fd), an `int32` pinned at the same
 * field index [`cajeta.io.file.File`](../io/file/File.cajeta) and the
 * planned `TcpStream` use, so the intrinsic codegen addresses the
 * descriptor identically across file + socket types. `fd == -1` is the
 * "closed / no socket" sentinel (matching `File`); [`close`](#close)
 * is idempotent.
 *
 * ## Blocking vs async
 *
 * The methods here are the **blocking-mode** Phase-1 primitives — they
 * park the *thread* in the syscall. The reactor (Phase 3) adds the
 * `recvFromAsync` / `sendToAsync` forms over these same intrinsics in
 * non-blocking mode, parking the *fiber* instead (see
 * [`cajeta-docs/Net.md`](../../../../../cajeta-docs/Net.md)). A socket
 * put in non-blocking mode surfaces a would-block outcome as the
 * distinct [`NetException.KIND_WOULD_BLOCK`](NetException.cajeta)
 * ordinal (NET-1.7), **not** a thrown exception, so the reactor can
 * drive readiness loops on it.
 *
 * ## Codegen status
 *
 * Like [`cajeta.io.file.File`](../io/file/File.cajeta), every method
 * body is **intrinsic-lowered at the call site** — the compiler's
 * MethodCallExpression net-receiver dispatch emits the
 * `__cajeta_net_*` calls (socket / bind / sendto / recvfrom / connect
 * / send / recv / close) and the `sockaddr` pack/unpack marshalling.
 * The stub bodies below exist for the **parser** only (they keep the
 * type checkable + the layout pinned); they are **not** the executed
 * code. That net-receiver lowering is the shared codegen the socket
 * types (NET-1.3 `TcpStream`, NET-1.4 `TcpListener`, this) all depend
 * on; until it lands the surface parses + type-checks but the
 * Cajeta-level round-trip is pinned at the **native** layer by
 * `NetUdpSocketTests` (the same way NET-1.1's `NetSocketTests` pins
 * the blocking socket path before the surface is wired).
 */
public class UdpSocket {
    /**
     * OS socket descriptor, or `-1` once closed. Pinned at field
     * index 1 (after the vtable) so the intrinsic codegen addresses it
     * identically to [`File`](../io/file/File.cajeta) /
     * `TcpStream` — the `fd` field-index convention NET-1.3 fixes.
     */
    public int32 fd;

    /**
     * Internal-only ctor wired by [`bind`](#bind). User code goes
     * through the static factory, which binds `fd` from the
     * `socket()` + `bind()` syscalls.
     */
    public UdpSocket(int32 fd) {
        this.fd = fd;
    }

    // -- factory ------------------------------------------------------------

    /**
     * Open a UDP socket and bind it to `local`. The address family of
     * `local` (`V4` / `V6`) selects the socket family. `0.0.0.0:0`
     * (IPv4 wildcard, ephemeral port) is the common "any local
     * endpoint" choice; the kernel-assigned port is then readable via
     * [`localAddress`](#localAddress).
     *
     * Intrinsic-lowered to
     * `__cajeta_net_socket(family, SOCK_DGRAM, 0)` followed by
     * `__cajeta_net_bind(fd, packed(local))`; a failure of either is
     * classified through [`NetErrors.fromErrno`](NetErrors.cajeta) and
     * thrown as the matching [`NetException`](NetException.cajeta)
     * subtype (e.g. `AddressInUse`, `AddressNotAvailable`).
     */
    public static #UdpSocket bind(SocketAddress local) {
        return heap UdpSocket(-1);
    }

    // -- unconnected datagram path ------------------------------------------

    /**
     * Send `data[offset .. offset+length)` as one datagram to the
     * explicit destination `dest`. Returns the byte count handed to
     * the kernel (a UDP send is all-or-nothing per datagram). Throws a
     * [`NetException`](NetException.cajeta) subtype on a hard error;
     * on a non-blocking socket a would-block outcome surfaces as the
     * `KIND_WOULD_BLOCK` ordinal (NET-1.7).
     *
     * Intrinsic-lowered to
     * `__cajeta_net_sendto(this.fd, &data[8+offset], length, 0,
     * packed(dest))`.
     */
    public int32 sendTo(int8[] data, int32 offset, int32 length,
                        SocketAddress dest) {
        return 0;
    }

    /**
     * Receive one datagram into `dst[offset .. offset+capacity)`,
     * returning a [`RecvResult`](RecvResult.cajeta) carrying the byte
     * count **and** the sender's [`SocketAddress`](SocketAddress.cajeta).
     * A `0` count is a legal empty datagram, **not** end-of-stream.
     * A datagram larger than `capacity` is truncated (the excess is
     * discarded, per UDP semantics).
     *
     * Intrinsic-lowered to
     * `__cajeta_net_recvfrom(this.fd, &dst[8+offset], capacity, 0,
     * sockaddrOut, lenOut)`, with the reported `sockaddr` unpacked via
     * `__cajeta_net_sockaddr_unpack` into the result's `from`.
     */
    public #RecvResult recvFrom(int8[] dst, int32 offset, int32 capacity) {
        return heap RecvResult();
    }

    // -- connected datagram path --------------------------------------------

    /**
     * Set a **default peer**. UDP `connect` performs no handshake — it
     * records `peer` so the kernel (a) filters inbound datagrams to
     * that peer and (b) lets the address-less [`send`](#send) /
     * [`recv`](#recv) forms be used. Calling `connect` again re-points
     * the default peer; the spec's "connect (set default peer)" form.
     *
     * Intrinsic-lowered to `__cajeta_net_connect(this.fd, packed(peer))`.
     */
    public void connect(SocketAddress peer) {
        return;
    }

    /**
     * Send `data[offset .. offset+length)` to the
     * [`connect`](#connect)-stored default peer. Returns the byte
     * count. Valid only after [`connect`](#connect) — on an
     * unconnected socket the kernel reports a "destination address
     * required" error, classified to a [`NetException`](NetException.cajeta).
     *
     * Intrinsic-lowered to
     * `__cajeta_net_send(this.fd, &data[8+offset], length, 0)`.
     */
    public int32 send(int8[] data, int32 offset, int32 length) {
        return 0;
    }

    /**
     * Receive one datagram from the [`connect`](#connect)-stored peer
     * into `dst[offset .. offset+capacity)`, returning the byte count
     * (`0` = empty datagram, not EOF). On a connected UDP socket the
     * kernel already filters to the default peer, so no sender address
     * is reported — use [`recvFrom`](#recvFrom) when the peer varies.
     *
     * Intrinsic-lowered to
     * `__cajeta_net_recv(this.fd, &dst[8+offset], capacity, 0)`.
     */
    public int32 recv(int8[] dst, int32 offset, int32 capacity) {
        return 0;
    }

    // -- non-blocking mode (NET-1.7) ----------------------------------------

    /**
     * The **would-block sentinel** the non-blocking receive forms
     * ([`recvOrWouldBlock`](#recvOrWouldBlock) /
     * [`recvFromOrWouldBlock`](#recvFromOrWouldBlock)) report when no datagram
     * is queued and the socket is in non-blocking mode (plan item **NET-1.7**).
     * A value, **not** an exception — the reactor (NET-3) drives the
     * `recvFromAsync` readiness loop on it. `-1` is distinct from every legal
     * datagram length (`>= 0`; `0` is a legal empty datagram, not EOF).
     */
    public static final int32 WOULD_BLOCK = -1;

    /**
     * Put this socket's descriptor in **non-blocking** (`on == true`) or
     * blocking mode. In non-blocking mode the receive forms return
     * [`WOULD_BLOCK`](#WOULD_BLOCK) instead of parking when no datagram is
     * ready — the foundation the reactor (NET-3) loops on. Intrinsic-lowered
     * to `__cajeta_net_set_nonblocking_tracked(this.fd, on ? 1 : 0)`; a `-1`
     * return raises via [`NetErrors.fromErrno`](NetErrors.cajeta).
     */
    public void setNonBlocking(boolean on) {
        return;
    }

    /**
     * `true` iff this socket is in non-blocking mode. Intrinsic-lowered to
     * `__cajeta_net_get_nonblocking(this.fd) != 0` (see
     * [`TcpStream.isNonBlocking`](TcpStream.cajeta#isNonBlocking) for the
     * platform note).
     */
    public boolean isNonBlocking() {
        return false;
    }

    /**
     * Non-blocking [`recv`](#recv): receive one datagram from the connected
     * peer, returning the byte count (`>= 0`, `0` = empty datagram), or
     * [`WOULD_BLOCK`](#WOULD_BLOCK) (`-1`) if none is queued and this socket is
     * in non-blocking mode. A hard error still raises the mapped
     * [`NetException`](NetException.cajeta) — only the would-block case is the
     * value (NET-1.7).
     *
     * Intrinsic-lowered to: `n = __cajeta_net_recv(this.fd, &dst[8+offset],
     * capacity, 0)`; if `n < 0` then `if (__cajeta_net_is_wouldblock())` return
     * `WOULD_BLOCK` else `throw NetErrors.fromErrno(...)`.
     */
    public int32 recvOrWouldBlock(int8[] dst, int32 offset, int32 capacity) {
        return 0;
    }

    /**
     * Non-blocking [`recvFrom`](#recvFrom): like
     * [`recvFrom`](#recvFrom) but, when no datagram is queued and this socket
     * is in non-blocking mode, the returned [`RecvResult`](RecvResult.cajeta)
     * carries [`count`](RecvResult.cajeta#count) == [`WOULD_BLOCK`](#WOULD_BLOCK)
     * (`-1`) and a wildcard `from`, rather than throwing. The reactor's
     * `recvFromAsync` (NET-3.3) loops on that sentinel count. A hard error
     * still raises.
     *
     * Intrinsic-lowered over `__cajeta_net_recvfrom` with the would-block
     * branch built from [`__cajeta_net_is_wouldblock`](../../../native/cajeta_net_nonblocking.c).
     */
    public #RecvResult recvFromOrWouldBlock(int8[] dst, int32 offset,
                                            int32 capacity) {
        return heap RecvResult();
    }

    /**
     * Non-blocking [`sendTo`](#sendTo): send one datagram to `dest`, returning
     * the byte count handed to the kernel (`>= 0`), or
     * [`WOULD_BLOCK`](#WOULD_BLOCK) (`-1`) if the send buffer is momentarily
     * full and this socket is in non-blocking mode. A hard error (e.g. a
     * broadcast send without [`setBroadcast`](#setBroadcast)) still raises the
     * mapped [`NetException`](NetException.cajeta) — only the would-block case
     * is the value (NET-1.7). The fd-level half the reactor's
     * [`sendToAsync`](#sendToAsync) (NET-3.3) loops on.
     *
     * Intrinsic-lowered to: `n = __cajeta_net_sendto(this.fd, &data[8+offset],
     * length, 0, packed(dest))`; if `n < 0` then `if
     * (__cajeta_net_is_wouldblock())` return `WOULD_BLOCK` else
     * `throw NetErrors.fromErrno(...)`.
     */
    public int32 sendToOrWouldBlock(int8[] data, int32 offset, int32 length,
                                    SocketAddress dest) {
        return 0;
    }

    // -- async datagram I/O (NET-3.3) ---------------------------------------
    //
    // The fiber-parking async datagram forms. Each is the NET-3.3 readiness
    // loop over the NET-1.7 non-blocking primitives + the
    // [`Reactor`](reactor/Reactor.cajeta): try the non-blocking syscall; on
    // [`WOULD_BLOCK`](#WOULD_BLOCK) park the **fiber** (not the carrier) on
    // readiness/writability and retry. A hard error raises through the
    // non-blocking primitive, so the loop never spins on a real fault. The
    // socket is put in non-blocking mode by the async form itself (idempotent),
    // so a caller need not remember to.

    /**
     * Async [`recvFrom`](#recvFrom): **park the fiber** until a datagram
     * arrives, then return a [`RecvResult`](RecvResult.cajeta) carrying the
     * byte count **and** the sender's address. A `0` count is a legal empty
     * datagram, not EOF (UDP has no orderly close), so an `await`-driven
     * receive loop keeps going.
     *
     * Loop: ensure non-blocking → [`recvFromOrWouldBlock`](#recvFromOrWouldBlock);
     * while the result's [`count`](RecvResult.cajeta#count) is
     * [`WOULD_BLOCK`](#WOULD_BLOCK), park on `Reactor.awaitReadable(this.fd)`
     * (a datagram socket is **readable** when a datagram is queued), then retry.
     */
    public #RecvResult recvFromAsync(int8[] dst, int32 offset, int32 capacity) {
        this.setNonBlocking(true);
        Reactor.init();
        while (true) {
            RecvResult r = this.recvFromOrWouldBlock(dst, offset, capacity);
            if (r.getCount() != UdpSocket.WOULD_BLOCK) {
                return #r;
            }
            if (!Reactor.awaitReadable(this.fd)) {
                throw heap NetException("recvFromAsync: reactor wait failed");
            }
        }
        // Unreachable — the loop returns a settled result or throws.
        return heap RecvResult();
    }

    /**
     * Async [`sendTo`](#sendTo): send one datagram to `dest`, **parking the
     * fiber** until the send buffer has room (a UDP send only transiently
     * blocks, e.g. under `ENOBUFS`). Returns the byte count handed to the
     * kernel (a UDP send is all-or-nothing per datagram).
     *
     * Loop: ensure non-blocking → [`sendToOrWouldBlock`](#sendToOrWouldBlock);
     * while it reports [`WOULD_BLOCK`](#WOULD_BLOCK), park on
     * `Reactor.awaitWritable(this.fd)`, then retry. Takes a borrow of `dest`
     * (the datagram is copied into the kernel before return).
     */
    public int32 sendToAsync(int8[] data, int32 offset, int32 length,
                             SocketAddress dest) {
        this.setNonBlocking(true);
        Reactor.init();
        while (true) {
            int32 n = this.sendToOrWouldBlock(data, offset, length, dest);
            if (n != UdpSocket.WOULD_BLOCK) {
                return n;
            }
            if (!Reactor.awaitWritable(this.fd)) {
                throw heap NetException("sendToAsync: reactor wait failed");
            }
        }
        // Unreachable — the loop returns a sent count or throws.
        return 0;
    }

    // -- introspection ------------------------------------------------------

    /**
     * The local address this socket is bound to (resolving the
     * kernel-assigned ephemeral port after a `bind(..,:0)`).
     *
     * Intrinsic-lowered to `__cajeta_net_getsockname(this.fd)` then
     * `__cajeta_net_sockaddr_unpack`. (The `getsockname` intrinsic is
     * NET-1.3's; UDP shares it.)
     */
    public #SocketAddress localAddress() {
        return heap SocketAddress();
    }

    // -- socket options (NET-1.6) -------------------------------------------
    //
    // Typed option methods keyed by [`SocketOption`](SocketOption.cajeta) —
    // the "typed enum keys, not raw ints" surface
    // ([`cajeta-docs/Net.md`](../../../../../cajeta-docs/Net.md) §Sockets).
    // Each lowers to the dedicated NET-1.6 native helper that holds the
    // platform `level`/`optname` in C
    // (`runtime/native/cajeta_net_socket_options.c`); a `-1` native return
    // raises via [`NetErrors.fromErrno`](NetErrors.cajeta). These are the
    // UDP-relevant subset (broadcast + TTL for multicast/datagram tuning,
    // buffer sizes, reuse-address for multicast group sharing, IPv6-only);
    // the TCP-only `NO_DELAY` lives on [`TcpStream`](TcpStream.cajeta).

    /**
     * Enable / disable `SO_BROADCAST` — permit this datagram socket to send
     * to a broadcast address. Off by default; a broadcast
     * [`sendTo`](#sendTo) without it is rejected by the kernel. Lowers to
     * `__cajeta_net_set_broadcast(this.fd, on ? 1 : 0)`.
     */
    public void setBroadcast(boolean on) {
        return;
    }

    /** Read `SO_BROADCAST` back. Lowers to
     *  `__cajeta_net_get_broadcast(this.fd) != 0`. */
    public boolean getBroadcast() {
        return false;
    }

    /**
     * Set the outbound unicast hop limit / TTL on datagrams (`IP_TTL` for
     * IPv4, `IPV6_UNICAST_HOPS` for IPv6; `0..255`). The native helper picks
     * the family-specific option from this socket's address family. Lowers to
     * `__cajeta_net_set_ttl(this.fd, isV6, ttl)`.
     */
    public void setTtl(int32 ttl) {
        return;
    }

    /** The current outbound TTL / hop limit. Lowers to
     *  `__cajeta_net_get_ttl(this.fd, isV6)`. */
    public int32 getTtl() {
        return 0;
    }

    /**
     * Enable / disable `SO_REUSEADDR` — for UDP this is the canonical way to
     * let multiple sockets share a multicast group port. Lowers to
     * `__cajeta_net_set_reuseaddr(this.fd, on ? 1 : 0)` (the NET-1.4
     * intrinsic, reused).
     */
    public void setReuseAddress(boolean on) {
        return;
    }

    /** Read `SO_REUSEADDR` back. Lowers to
     *  `__cajeta_net_get_reuseaddr(this.fd) != 0`. */
    public boolean getReuseAddress() {
        return false;
    }

    /**
     * Set the kernel **receive** buffer size in bytes (`SO_RCVBUF`) — raise
     * it to absorb datagram bursts without drops. The kernel may round/clamp;
     * read it back with [`getRecvBufferSize`](#getRecvBufferSize). Lowers to
     * `__cajeta_net_set_recvbuf(this.fd, bytes)`.
     */
    public void setRecvBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_RCVBUF` size in bytes. Lowers to
     *  `__cajeta_net_get_recvbuf(this.fd)`. */
    public int32 getRecvBufferSize() {
        return 0;
    }

    /**
     * Set the kernel **send** buffer size in bytes (`SO_SNDBUF`). Same
     * round/clamp caveat as [`setRecvBufferSize`](#setRecvBufferSize). Lowers
     * to `__cajeta_net_set_sendbuf(this.fd, bytes)`.
     */
    public void setSendBufferSize(int32 bytes) {
        return;
    }

    /** The effective `SO_SNDBUF` size in bytes. Lowers to
     *  `__cajeta_net_get_sendbuf(this.fd)`. */
    public int32 getSendBufferSize() {
        return 0;
    }

    /**
     * Enable / disable `IPV6_V6ONLY` on an IPv6 socket — when off, the socket
     * also receives IPv4-mapped datagrams (dual-stack). Valid only on an IPv6
     * socket. Lowers to `__cajeta_net_set_only_v6(this.fd, on ? 1 : 0)`.
     */
    public void setOnlyV6(boolean on) {
        return;
    }

    /** Read `IPV6_V6ONLY` back. Lowers to
     *  `__cajeta_net_get_only_v6(this.fd) != 0`. */
    public boolean getOnlyV6() {
        return false;
    }

    // -- lifecycle ----------------------------------------------------------

    /**
     * Close the underlying socket. Idempotent; sets `this.fd = -1` so
     * subsequent calls are no-ops (matching [`File.close`](../io/file/File.cajeta)).
     * The destructor also calls this.
     *
     * Intrinsic-lowered to `__cajeta_net_close(this.fd)`.
     */
    public void close() {
        return;
    }
}
