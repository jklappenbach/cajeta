package cajeta.net;

import cajeta.lang.String;

/**
 * Thrown by [`IpAddress.parse`](IpAddress.cajeta) and
 * [`SocketAddress.parse`](SocketAddress.cajeta) when the input text is
 * not a well-formed IP address or `host:port` socket address.
 *
 * The `position` field carries the 0-based byte offset at which the
 * parser noticed the problem (an illegal character, a missing closing
 * `]`, an out-of-range octet or port), so the caller can point at the
 * offending character. `-1` is used when the failure is not tied to a
 * single position (e.g. a wholly empty or null input).
 *
 * ## Hierarchy note
 *
 * The networking spec ([`docs/Net.md`](../../../../docs/Net.md))
 * roots every `cajeta.net` failure under
 * [`cajeta.net.NetException`](NetException.cajeta) (plan item
 * **NET-1.8**). That base is now built, so — as part of the **NET-11.6**
 * taxonomy consolidation (see
 * [`docs/stdlib/net/Errors.md`](../../../../docs/stdlib/net/Errors.md))
 * — this exception hangs off `NetException` like every other
 * `cajeta.net` failure. The `(message, position)` constructor contract
 * is unchanged. As a parse failure (not an errno-derived socket
 * error), it is classified to
 * [`NetException.KIND_INVALID`](NetException.cajeta) (12) — the same
 * "invalid input" bucket
 * [`MalformedUriException`](uri/MalformedUriException.cajeta) uses — so
 * a single `catch (NetException e)` can still branch on `e.kind`; the
 * precise byte offset lives in `position`.
 *
 * Recoverable, not Unrecoverable: callers either catch it or declare
 * it in their throws clause, mirroring the
 * [`cajeta.io.file`](../io/file/IoException.cajeta) discipline.
 */
public class MalformedAddressException extends NetException {
    /**
     * Byte offset (0-based) into the original input at which the
     * parser rejected the address. `-1` when the failure is not tied
     * to a single position (empty / null input).
     */
    public int64 position;

    public MalformedAddressException(String message, int64 position) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;   // NetException.KIND_INVALID — parse failure, not an errno-classified socket error
        this.position = position;
    }
}
