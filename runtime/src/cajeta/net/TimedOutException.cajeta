package cajeta.net;

import cajeta.lang.String;

/**
 * A socket operation exceeded its deadline at the OS level — e.g. a
 * `connect` that never completed, or an op on a socket with a
 * `SO_RCVTIMEO`/`SO_SNDTIMEO` timeout. POSIX `ETIMEDOUT` / Winsock
 * `WSAETIMEDOUT`. `kind == NetException.KIND_TIMED_OUT` (10).
 *
 * Note: application-level deadlines composed via
 * `Tasks.withTimeout(...)` (see [`cajeta-docs/Net.md`](../../../../../cajeta-docs/Net.md))
 * surface through the concurrency cancellation path, **not** this
 * exception; `TimedOutException` is specifically the *OS-reported*
 * timeout. See
 * [`cajeta-docs/stdlib/net/Errors.md`](../../../../../cajeta-docs/stdlib/net/Errors.md).
 */
public class TimedOutException extends NetException {
    public TimedOutException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 10;   // NetException.KIND_TIMED_OUT
    }
}
