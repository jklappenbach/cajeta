package cajeta.net.http;

import cajeta.lang.String;

/**
 * The streaming HTTP/1.1 **body decoder** (NET-7.4) — the layer that
 * consumes the message body *per the framing decision* the incremental
 * parser ([`HttpParser`](HttpParser.cajeta), NET-7.3) emits as a
 * [`BodyFraming`](BodyFraming.cajeta). Where the head parser stops at
 * the `CRLFCRLF` head terminator, the `BodyReader` picks up from the
 * leftover bytes and **streams** the decoded body: it never buffers the
 * whole payload, so a multi-gigabyte download or upload flows through
 * bounded memory.
 *
 * It is **pure logic** over `int8[]` — no sockets, no native intrinsics
 * — so it tests directly over the JIT with the chunked golden corpus
 * under `test/net/golden/http/chunked.vectors` (the same discipline as
 * [`HttpParser`](HttpParser.cajeta) and [`Headers`](../Headers.cajeta)).
 * The async transport (`AsyncReader` driving `feed`, NET-3.5) layers
 * over this codec later; the codec itself is transport-agnostic.
 *
 * ## The three framings (RFC 7230 §3.3.3 / §4.1)
 *
 *   - **`KIND_CONTENT_LENGTH`** — exactly `length` body bytes are
 *     consumed; the reader completes the instant the Nth byte arrives.
 *     Bytes beyond the Nth (a pipelined next message on a keep-alive
 *     connection) are captured as [`leftover`](#).
 *   - **`KIND_CHUNKED`** — the body is a sequence of `<hex-size> CRLF
 *     <data> CRLF` chunks terminated by a zero-size chunk; the decoder
 *     emits only the **data** bytes (size lines, the per-chunk CRLFs,
 *     **chunk-extensions** after a `;`, and the **trailer** section are
 *     all consumed but never part of the decoded body). It completes at
 *     the trailers' terminating blank line.
 *   - **`KIND_CLOSE`** — the body runs until the producer signals
 *     end-of-stream via [`endInput`](#); every fed byte is body. A
 *     close-delimited body has no in-band terminator, so it never
 *     completes from `feed` alone.
 *   - **`KIND_NONE`** — there is no body; the reader is complete from
 *     construction and any fed byte is immediately [`leftover`](#).
 *
 * ## Lifecycle
 *
 * ```cajeta
 * BodyReader br = BodyReader.forFraming(parser.getFraming());
 * br.feed(parser.leftover(), parser.leftoverLength());   // body bytes from the head chunk
 * while (!br.isComplete()) {
 *     int32 n = conn.read(buf);
 *     if (n == 0) { br.endInput(); break; }              // peer closed
 *     br.feed(buf, n);
 *     int8[] piece = br.drain();                         // consume what's decoded so far
 *     sink.write(piece, piece.count());
 * }
 * int8[] tail = br.leftover();                           // start of the next pipelined message
 * ```
 *
 *   - [`feed`](#) — append the next raw body bytes; decode incrementally.
 *     Returns `true` once the body is complete. Idempotent after
 *     completion (extra bytes accrue to the leftover buffer).
 *   - [`drain`](#) — take + clear the decoded bytes buffered so far, so
 *     a consumer streams without the reader holding the whole body.
 *   - [`isComplete`](#) — the full body has been received.
 *   - [`endInput`](#) — assert end-of-stream. Completes a `KIND_CLOSE`
 *     body; raises
 *     [`UnexpectedEofException`](UnexpectedEofException.cajeta) if a
 *     `Content-Length` or `chunked` body was truncated.
 *
 * ## Abuse resistance (chunked)
 *
 * A malformed chunk stream — a non-hex size line, a size that overflows
 * the length counter, a chunk not followed by its `CRLF`, or an
 * unterminated trailer section — raises
 * [`InvalidChunkEncodingException`](InvalidChunkEncodingException.cajeta)
 * citing the body-stream byte offset, rather than silently mis-framing.
 */
public class BodyReader {
    // -- chunked sub-states -------------------------------------------------
    // The chunked decoder is itself a small resumable state machine,
    // tracked across `feed` calls so a chunk (or its size line) split
    // over reads decodes identically to a one-shot feed.

    /** Reading the `<hex-size>[;ext]` line up to its CRLF. */
    public static final int32 CH_SIZE      = 0;
    /** Copying `remaining` data bytes of the current chunk. */
    public static final int32 CH_DATA      = 1;
    /** Consuming the CR of the CRLF that trails a chunk's data. */
    public static final int32 CH_DATA_CR   = 2;
    /** Consuming the LF of the CRLF that trails a chunk's data. */
    public static final int32 CH_DATA_LF   = 3;
    /** After the zero-size chunk: reading trailer lines until a blank line. */
    public static final int32 CH_TRAILER   = 4;
    /** Fully decoded (zero chunk + trailers' blank line seen). */
    public static final int32 CH_DONE      = 5;

    // -- configuration ------------------------------------------------------

    /** The framing this reader decodes (`BodyFraming.KIND_*`). */
    int32 kind;
    /** Fixed body length for `KIND_CONTENT_LENGTH` (else unused). */
    int64 contentLength;

    // -- completion ---------------------------------------------------------

    /** True once the entire body has been decoded/consumed. */
    boolean complete;
    /** Running count of body-stream bytes fed (for error positions). */
    int64 streamPos;

    // -- content-length state ----------------------------------------------

    /** Body bytes still expected for `KIND_CONTENT_LENGTH`. */
    int64 clRemaining;

    // -- chunked state ------------------------------------------------------

    /** Current chunked sub-state (`CH_*`). */
    int32 chState;
    /** Bytes still to copy out of the current chunk's data. */
    int64 chRemaining;
    /** Accumulated value of the hex size line being parsed. */
    int64 chSize;
    /** True once at least one hex digit has been seen on the size line. */
    boolean chSawSizeDigit;
    /** True once a `;` started the chunk-extension portion of a size line. */
    boolean chInExtension;
    /** Length of the trailer line currently being accumulated. */
    int32 chTrailerLineLen;

    // -- decoded output buffer (drained incrementally) ----------------------

    int8[] out;
    int32 outLen;
    int32 outCap;

    // -- leftover (bytes after the body boundary: next pipelined message) ---

    int8[] tail;
    int32 tailLen;
    int32 tailCap;

    // -----------------------------------------------------------------------

    BodyReader() {
        this.kind = 0;              // KIND_NONE
        this.contentLength = (int64) 0;
        this.complete = false;
        this.streamPos = (int64) 0;
        this.clRemaining = (int64) 0;
        this.chState = 0;           // CH_SIZE
        this.chRemaining = (int64) 0;
        this.chSize = (int64) 0;
        this.chSawSizeDigit = false;
        this.chInExtension = false;
        this.chTrailerLineLen = 0;
        this.outCap = 0;
        this.out = new int8[0];
        this.outLen = 0;
        this.tailCap = 0;
        this.tail = new int8[0];
        this.tailLen = 0;
    }

    /**
     * Build a reader for a parser's body-framing decision. Dispatches on
     * [`BodyFraming.kind`](BodyFraming.cajeta):
     *
     *   - `KIND_NONE` → an already-complete reader (no body bytes).
     *   - `KIND_CONTENT_LENGTH` → a fixed-length reader for
     *     `framing.length` bytes (a length of `0` completes immediately).
     *   - `KIND_CHUNKED` → the chunked decoder.
     *   - `KIND_CLOSE` → a close-delimited reader (completes on
     *     [`endInput`](#)).
     */
    public static #BodyReader forFraming(BodyFraming framing) {
        BodyReader br = heap BodyReader();
        br.kind = framing.kind;
        if (framing.kind == BodyFraming.KIND_NONE) {
            br.complete = true;
        } else if (framing.kind == BodyFraming.KIND_CONTENT_LENGTH) {
            br.contentLength = framing.length;
            br.clRemaining = framing.length;
            if (framing.length == (int64) 0) {
                br.complete = true;     // present-but-empty fixed body
            }
        }
        // KIND_CHUNKED / KIND_CLOSE start incomplete; nothing to seed.
        return #br;
    }

    /** A `Content-Length` reader for exactly `length` bytes. */
    public static #BodyReader forContentLength(int64 length) {
        BodyReader br = heap BodyReader();
        br.kind = BodyFraming.KIND_CONTENT_LENGTH;
        br.contentLength = length;
        br.clRemaining = length;
        if (length <= (int64) 0) {
            br.complete = true;
        }
        return #br;
    }

    /** A chunked transfer-decoding reader. */
    public static #BodyReader forChunked() {
        BodyReader br = heap BodyReader();
        br.kind = BodyFraming.KIND_CHUNKED;
        return #br;
    }

    /** A connection-close-delimited reader (read to EOF). */
    public static #BodyReader forClose() {
        BodyReader br = heap BodyReader();
        br.kind = BodyFraming.KIND_CLOSE;
        return #br;
    }

    // -- feeding ------------------------------------------------------------

    /**
     * Append the first `length` bytes of `data` to the body stream and
     * decode incrementally. Returns `true` once the whole body is
     * complete. Bytes past the body boundary (a `Content-Length`
     * overshoot, or anything after a chunked body's trailers — the next
     * pipelined message on a keep-alive connection) are captured into the
     * [`leftover`](#) buffer rather than the decoded output.
     *
     * Raises
     * [`InvalidChunkEncodingException`](InvalidChunkEncodingException.cajeta)
     * on a malformed chunk stream.
     */
    public boolean feed(int8[] data, int32 length) {
        int32 i = 0;
        while (i < length) {
            if (this.complete) {
                // Past the body boundary: everything is the next message.
                int8 tb = data[i];
                this.appendTail(tb);
                i = i + 1;
                continue;
            }
            int8 c = data[i];
            this.streamPos = this.streamPos + ((int64) 1);
            if (this.kind == BodyFraming.KIND_CONTENT_LENGTH) {
                this.feedContentLength(c);
            } else if (this.kind == BodyFraming.KIND_CHUNKED) {
                this.feedChunked(c);
            } else if (this.kind == BodyFraming.KIND_CLOSE) {
                this.appendOut(c);          // every byte is body; no in-band end
            } else {
                // KIND_NONE was complete from construction; defensive.
                this.complete = true;
                this.appendTail(c);
            }
            i = i + 1;
        }
        return this.complete;
    }

    /**
     * Assert the producer reached end-of-stream. For a `KIND_CLOSE` body
     * the connection close **is** the body terminator, so this completes
     * the reader. For a `Content-Length` or `chunked` body still in
     * flight, the stream was truncated — raise
     * [`UnexpectedEofException`](UnexpectedEofException.cajeta). A no-op
     * once already complete.
     */
    public void endInput() {
        if (this.complete) {
            return;
        }
        if (this.kind == BodyFraming.KIND_CLOSE) {
            this.complete = true;
            return;
        }
        throw heap UnexpectedEofException(
            "stream ended before the HTTP body was fully received",
            this.streamPos);
    }

    // -- content-length decoding -------------------------------------------

    void feedContentLength(int8 c) {
        if (this.clRemaining > (int64) 0) {
            this.appendOut(c);
            this.clRemaining = this.clRemaining - ((int64) 1);
            if (this.clRemaining == (int64) 0) {
                this.complete = true;
            }
        } else {
            // Should not happen (complete flips at zero), but stay safe.
            this.complete = true;
            this.appendTail(c);
        }
    }

    // -- chunked decoding ---------------------------------------------------

    void feedChunked(int8 c) {
        if (this.chState == BodyReader.CH_SIZE) {
            this.feedChunkSize(c);
        } else if (this.chState == BodyReader.CH_DATA) {
            this.feedChunkData(c);
        } else if (this.chState == BodyReader.CH_DATA_CR) {
            this.feedChunkDataCr(c);
        } else if (this.chState == BodyReader.CH_DATA_LF) {
            this.feedChunkDataLf(c);
        } else if (this.chState == BodyReader.CH_TRAILER) {
            this.feedTrailer(c);
        } else {
            // CH_DONE — body already terminated; treat as leftover.
            this.complete = true;
            this.appendTail(c);
        }
    }

    /**
     * Accumulate the `<hex-size>[;chunk-ext]` line. Hex digits build the
     * size; a `;` switches to consuming (and ignoring) the extension; a
     * `CR`/`LF` closes the line. On the LF, a zero size moves to the
     * trailer section, a non-zero size begins copying that many data
     * bytes.
     */
    void feedChunkSize(int8 c) {
        int32 b = ((int32) c) & 255;
        if (b == 13) {                          // CR — ignore; LF closes line
            return;
        }
        if (b == 10) {                          // LF — size line complete
            if (!this.chSawSizeDigit) {
                throw heap InvalidChunkEncodingException(
                    "chunk size line has no hex digit",
                    this.streamPos - ((int64) 1));
            }
            int64 size = this.chSize;
            // Reset size-line accumulators for the next size line.
            this.chSize = (int64) 0;
            this.chSawSizeDigit = false;
            this.chInExtension = false;
            if (size == (int64) 0) {
                this.chState = BodyReader.CH_TRAILER;
                this.chTrailerLineLen = 0;
            } else {
                this.chRemaining = size;
                this.chState = BodyReader.CH_DATA;
            }
            return;
        }
        if (this.chInExtension) {
            return;                             // ignore chunk-extension bytes
        }
        if (b == 59) {                          // ';' — chunk-extension start
            this.chInExtension = true;
            return;
        }
        int32 digit = this.hexValue(b);
        if (digit < 0) {
            throw heap InvalidChunkEncodingException(
                "non-hex character in chunk size line",
                this.streamPos - ((int64) 1));
        }
        // Overflow guard: refuse a size that would exceed int63 range.
        if (this.chSize > (((int64) 1 << 59))) {
            throw heap InvalidChunkEncodingException(
                "chunk size overflows", this.streamPos - ((int64) 1));
        }
        this.chSize = (this.chSize << 4) + ((int64) digit);
        this.chSawSizeDigit = true;
    }

    /** Copy one byte of chunk data; at the end, expect the trailing CRLF. */
    void feedChunkData(int8 c) {
        this.appendOut(c);
        this.chRemaining = this.chRemaining - ((int64) 1);
        if (this.chRemaining == (int64) 0) {
            this.chState = BodyReader.CH_DATA_CR;
        }
    }

    /** The CR of the CRLF that must follow a chunk's data. */
    void feedChunkDataCr(int8 c) {
        int32 b = ((int32) c) & 255;
        if (b != 13) {                          // CR
            throw heap InvalidChunkEncodingException(
                "chunk data not terminated by CRLF (expected CR)",
                this.streamPos - ((int64) 1));
        }
        this.chState = BodyReader.CH_DATA_LF;
    }

    /** The LF of the CRLF that must follow a chunk's data. */
    void feedChunkDataLf(int8 c) {
        int32 b = ((int32) c) & 255;
        if (b != 10) {                          // LF
            throw heap InvalidChunkEncodingException(
                "chunk data not terminated by CRLF (expected LF)",
                this.streamPos - ((int64) 1));
        }
        this.chState = BodyReader.CH_SIZE;      // next chunk size line
    }

    /**
     * Consume trailer lines after the zero-size chunk. Trailers are
     * `field-line CRLF` repeated, ended by an empty line (a bare CRLF).
     * A CR is ignored; an LF on an empty line terminates the body, an LF
     * on a non-empty line ends one trailer and resets for the next.
     */
    void feedTrailer(int8 c) {
        int32 b = ((int32) c) & 255;
        if (b == 13) {                          // CR — ignore
            return;
        }
        if (b == 10) {                          // LF — end of a trailer line
            if (this.chTrailerLineLen == 0) {
                // Blank line: trailers (if any) done -> body complete.
                this.chState = BodyReader.CH_DONE;
                this.complete = true;
            } else {
                this.chTrailerLineLen = 0;      // one trailer consumed
            }
            return;
        }
        this.chTrailerLineLen = this.chTrailerLineLen + 1;
    }

    /** Hex digit value of `b` (`0`-`9`/`a`-`f`/`A`-`F`), or `-1`. */
    int32 hexValue(int32 b) {
        if (b >= 48 && b <= 57) {               // '0'..'9'
            return b - 48;
        }
        if (b >= 97 && b <= 102) {              // 'a'..'f'
            return b - 97 + 10;
        }
        if (b >= 65 && b <= 70) {               // 'A'..'F'
            return b - 65 + 10;
        }
        return -1;
    }

    // -- results ------------------------------------------------------------

    /** True once the entire body has been decoded/consumed. */
    public boolean isComplete() {
        return this.complete;
    }

    /** Number of decoded body bytes currently buffered (drainable). */
    public int32 decodedLength() {
        return this.outLen;
    }

    /**
     * Take **and clear** the decoded body bytes buffered so far — a
     * fresh owned `int8[]` of exactly [`decodedLength`](#) bytes — so a
     * consumer streams the body without the reader retaining it. After
     * `drain`, the decoded buffer is empty; subsequent decoded bytes
     * accumulate from there. Call repeatedly across `feed`s for true
     * streaming consumption.
     */
    public #int8[] drain() {
        int32 n = this.outLen;
        int8[] piece = new int8[n];
        int32 i = 0;
        while (i < n) {
            piece[i] = this.out[i];
            i = i + 1;
        }
        this.outLen = 0;                        // reset; capacity is retained
        return #piece;
    }

    /**
     * Body bytes that arrived **after** the body boundary — a
     * `Content-Length` overshoot, or anything after a chunked body's
     * terminating blank line: the start of the next pipelined message on
     * a keep-alive connection. A fresh owned copy of exactly
     * [`leftoverLength`](#) bytes.
     */
    public #int8[] leftover() {
        int32 n = this.tailLen;
        int8[] lo = new int8[n];
        int32 i = 0;
        while (i < n) {
            lo[i] = this.tail[i];
            i = i + 1;
        }
        return #lo;
    }

    /** Number of post-body leftover bytes captured. */
    public int32 leftoverLength() {
        return this.tailLen;
    }

    // -- output buffer helpers ---------------------------------------------

    void appendOut(int8 c) {
        if (this.outLen >= this.outCap) {
            this.growOut();
        }
        this.out[this.outLen] = c;
        this.outLen = this.outLen + 1;
    }

    void growOut() {
        int32 newCap = this.outCap == 0 ? 64 : this.outCap * 2;
        int8[] dst = new int8[newCap];
        int32 i = 0;
        while (i < this.outLen) {
            dst[i] = this.out[i];
            i = i + 1;
        }
        this.out = #dst;
        this.outCap = newCap;
    }

    void appendTail(int8 c) {
        if (this.tailLen >= this.tailCap) {
            this.growTail();
        }
        this.tail[this.tailLen] = c;
        this.tailLen = this.tailLen + 1;
    }

    void growTail() {
        int32 newCap = this.tailCap == 0 ? 32 : this.tailCap * 2;
        int8[] dst = new int8[newCap];
        int32 i = 0;
        while (i < this.tailLen) {
            dst[i] = this.tail[i];
            i = i + 1;
        }
        this.tail = #dst;
        this.tailCap = newCap;
    }
}
