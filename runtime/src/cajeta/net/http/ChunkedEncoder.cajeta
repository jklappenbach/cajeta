package cajeta.net.http;

/**
 * The streaming HTTP/1.1 **chunked transfer-*encoding*** primitive
 * (NET-9.4) — the encode-side mirror of the chunked
 * [`BodyReader`](BodyReader.cajeta) (NET-7.4). Where the
 * [`HttpSerializer`](HttpSerializer.cajeta) (NET-7.5) frames a
 * *buffered* body as one chunk in a single call, this encoder frames the
 * body **one chunk at a time**, so a handler that produces its response
 * body incrementally — a generated report, a proxied upstream, a
 * file-backed download — writes each piece as it is ready without ever
 * holding the whole payload in memory.
 *
 * It is **pure logic** over `int8[]` — no sockets, no native intrinsics
 * — so it tests directly over the JIT against the chunked golden corpus
 * (`test/net/golden/http/chunked.vectors`, the same discipline as
 * [`BodyReader`](BodyReader.cajeta) and [`HttpSerializer`](HttpSerializer.cajeta)).
 * The socket-facing [`ResponseBodyWriter`](ResponseBodyWriter.cajeta)
 * layers an [`AsyncWriter`](../AsyncWriter.cajeta) over this codec; the
 * codec itself is transport-agnostic and a perfect round-trip witness for
 * the decoder — `decode(encode(x)) == x`.
 *
 * ## The wire grammar (RFC 7230 §4.1)
 *
 * ```
 * chunked-body = *chunk last-chunk trailer-part CRLF
 * chunk        = chunk-size CRLF chunk-data CRLF
 * last-chunk   = 1*"0" CRLF
 * ```
 *
 *   - [`encodeChunk`](#encodeChunk) frames one non-empty data chunk:
 *     `<hex-size> CRLF <data> CRLF`. A **zero-length** piece would frame
 *     as `0 CRLF CRLF` — the *last-chunk* marker — and prematurely
 *     terminate the stream, so `encodeChunk` of an empty piece emits
 *     **nothing** (the caller streams zero bytes harmlessly).
 *   - [`encodeLast`](#encodeLast) frames the terminator `0 CRLF CRLF`
 *     (no trailers) that closes the body. Exactly one call ends the
 *     stream; the [`ResponseBodyWriter`](ResponseBodyWriter.cajeta)'s
 *     `finish` emits it.
 *
 * ## Why a separate type from `HttpSerializer`
 *
 * `HttpSerializer.writeBody(..., chunked = true)` frames an
 * **already-buffered** body as a single chunk — the right primitive for
 * a body whose length the handler happens to know but chose chunked
 * framing for. This encoder is the **streaming** counterpart: the handler
 * does *not* have the whole body, and calls [`encodeChunk`](#encodeChunk)
 * repeatedly as pieces arrive. Factoring it out keeps the serializer a
 * one-shot codec and gives the incremental path its own golden-testable
 * unit (and a stable hex-size helper shared with neither's internals).
 */
public final class ChunkedEncoder {
    /**
     * Frame `data[0 .. length)` as a single chunked-transfer **chunk** —
     * `<hex-size> CRLF <data> CRLF` — returning the owned wire bytes.
     *
     * A `length` of `0` (or negative) returns an **empty** array: a
     * zero-size chunk is the *last-chunk* terminator
     * ([`encodeLast`](#encodeLast)), so framing an empty piece as a chunk
     * would corrupt the stream. Emitting nothing lets a producer that
     * happens to have a zero-byte piece in hand stream it as a no-op.
     */
    public static #int8[] encodeChunk(int8[] data, int32 length) {
        if (length <= 0) {
            return heap int8[0];
        }
        int8[] sizeLine = ChunkedEncoder.hexBytes(length);
        int32 sizeLen = sizeLine.count();
        // size-line + CRLF + data + CRLF
        int32 total = sizeLen + 2 + length + 2;
        int8[] out = heap int8[total];
        int32 w = 0;
        int32 i = 0;
        while (i < sizeLen) {
            out[w] = sizeLine[i];
            w = w + 1;
            i = i + 1;
        }
        out[w] = (int8) 13;                 // CR
        w = w + 1;
        out[w] = (int8) 10;                 // LF
        w = w + 1;
        i = 0;
        while (i < length) {
            out[w] = data[i];
            w = w + 1;
            i = i + 1;
        }
        out[w] = (int8) 13;                 // CR
        w = w + 1;
        out[w] = (int8) 10;                 // LF
        w = w + 1;
        return #out;
    }

    /**
     * The **last-chunk** terminator that closes a chunked body —
     * `0 CRLF CRLF` (a zero-size chunk and an empty trailer section). One
     * call ends the stream; after it the connection head is reusable for
     * the next keep-alive request. Returns the owned five wire bytes
     * `"0\r\n\r\n"`.
     */
    public static #int8[] encodeLast() {
        int8[] out = heap int8[5];
        out[0] = (int8) 48;                 // '0'
        out[1] = (int8) 13;                 // CR
        out[2] = (int8) 10;                 // LF
        out[3] = (int8) 13;                 // CR
        out[4] = (int8) 10;                 // LF
        return #out;
    }

    /**
     * Render a non-negative `int32` as **lowercase hexadecimal** ASCII
     * with no leading zeros — the chunk-size line value. `0` renders as
     * `"0"` (though [`encodeChunk`](#encodeChunk) never frames a zero
     * size). Mirrors [`HttpSerializer.appendHex`](HttpSerializer.cajeta)'s
     * digit loop, returning an owned `int8[]` rather than appending.
     */
    static #int8[] hexBytes(int32 value) {
        if (value <= 0) {
            int8[] z = heap int8[1];
            z[0] = (int8) 48;               // '0'
            return #z;
        }
        int8[] tmp = heap int8[8];
        int32 nd = 0;
        int32 v = value;
        while (v > 0) {
            int32 d = v % 16;
            int8 c = (int8) (48 + d);       // '0'..'9'
            if (d >= 10) {
                c = (int8) (97 + (d - 10)); // 'a'..'f'
            }
            tmp[nd] = c;
            v = v / 16;
            nd = nd + 1;
        }
        int8[] out = heap int8[nd];
        int32 i = 0;
        while (i < nd) {
            out[i] = tmp[nd - 1 - i];       // emit high-to-low
            i = i + 1;
        }
        return #out;
    }
}
