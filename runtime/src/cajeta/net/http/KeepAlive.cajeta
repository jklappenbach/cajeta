package cajeta.net.http;

import cajeta.lang.String;
import cajeta.net.Headers;

/**
 * HTTP/1.1 **keep-alive policy** (NET-7.6) — the connection-reuse
 * *decision* layer that sits over the per-message `Connection` read the
 * incremental parser ([`HttpParser`](HttpParser.cajeta), NET-7.3) already
 * performs and the `Connection` *emit* the serializer
 * ([`HttpSerializer`](HttpSerializer.cajeta), NET-7.5) writes.
 *
 * The parser tells you whether a *single* message *said* keep-alive
 * ([`BodyFraming.keepAlive`](BodyFraming.cajeta)); this type decides the
 * thing the connection layer actually needs to know — **may I reuse this
 * socket for the next request, or must I close it?** — by combining the
 * request's and the response's `Connection` semantics with the HTTP
 * version defaults (RFC 7230 §6.3). It also computes the canonical
 * `Connection` header *value* a sender should emit so a request or
 * response advertises its intent on the wire. The HTTP client's
 * connection pool (NET-8.2) and the HTTP server's keep-alive loop
 * (NET-9.1) both call this — they are the consumers the plan names.
 *
 * It is **pure logic** over [`Headers`](../Headers.cajeta) +
 * `cajeta.lang.String` — no sockets, no native intrinsics — so it tests
 * directly over the JIT with a vector table (the same discipline as
 * [`HttpParser`](HttpParser.cajeta) and [`Headers`](../Headers.cajeta)),
 * pinning the NET-7.6 acceptance row `reuseDecisionVectors`.
 *
 * ## The version defaults (RFC 7230 §6.3)
 *
 *   - **HTTP/1.1** is *persistent by default*: the connection stays open
 *     for reuse **unless** a message carries `Connection: close`.
 *   - **HTTP/1.0** is *non-persistent by default*: the connection closes
 *     after the message **unless** a message carries
 *     `Connection: keep-alive`.
 *
 * A version string this layer doesn't recognize is treated as HTTP/1.1
 * (persistent) — the modern, safe default; an `HTTP/0.9`-style request
 * would never reach here.
 *
 * ## Token parsing
 *
 * The `Connection` header is a comma-separated list of case-insensitive
 * connection-option tokens (RFC 7230 §6.1). This layer matches `close`
 * and `keep-alive` as **whole list tokens** (delimited by comma, space,
 * or tab) so a value like `keep-alive, Upgrade` is recognized as
 * keep-alive, and a token is never matched as a substring of a larger
 * word. `close` **wins** over `keep-alive` if a single header somehow
 * carries both (a sender error, but `close` is the conservative read —
 * never reuse a socket a peer asked to close).
 *
 * ## The reuse decision
 *
 * For a request/response exchange, the connection is reusable **iff
 * both** the request and the response permit it. Either side asking to
 * close, or either side defaulting to close (HTTP/1.0 without explicit
 * keep-alive), closes the connection. This is the conjunction the pool +
 * server loop need: a single peer's `close` ends reuse regardless of
 * what the other side wanted.
 */
public final class KeepAlive {
    // No instance state and no constructor — a stateless static-method
    // utility (the `PercentCodec` / `HttpSerializer.lit` precedent). The
    // methods are static; the type groups them under the keep-alive
    // concern.

    // -- per-message read ---------------------------------------------------

    /**
     * Does a single message with `version` + its `headers` permit
     * connection reuse, per the RFC 7230 §6.3 version default and its
     * `Connection` tokens? `close` forces `false`; an explicit
     * `keep-alive` forces `true`; otherwise the version default decides
     * (HTTP/1.1 → reusable, HTTP/1.0 → not).
     *
     * This mirrors the parser's per-message
     * [`decideKeepAlive`](HttpParser.cajeta) but is reusable by the
     * serializer/client/server without holding a parser.
     */
    public static boolean messageAllowsReuse(String version, Headers headers) {
        boolean isHttp10 = KeepAlive.isHttp10(version);
        String conn = headers.get("connection");
        if (conn != null) {
            String lc = conn.toLowerCase();
            // close wins over keep-alive (conservative).
            if (KeepAlive.tokenContains(lc, "close")) {
                return false;
            }
            if (KeepAlive.tokenContains(lc, "keep-alive")) {
                return true;
            }
        }
        return !isHttp10;
    }

    // -- the exchange-level reuse decision ----------------------------------

    /**
     * May the connection that carried `request` (with `requestVersion`)
     * and `response` (with `responseVersion`) be **reused** for the next
     * request? True **iff both** the request and the response permit
     * reuse (see [`messageAllowsReuse`](#)). Either side's `close`, or
     * either side's HTTP/1.0-without-keep-alive default, ends reuse.
     *
     * This is the predicate the connection pool (NET-8.2) and the server
     * keep-alive loop (NET-9.1) gate socket reuse on.
     */
    public static boolean canReuse(String requestVersion, Headers requestHeaders,
                                   String responseVersion, Headers responseHeaders) {
        boolean reqOk = KeepAlive.messageAllowsReuse(requestVersion, requestHeaders);
        boolean respOk = KeepAlive.messageAllowsReuse(responseVersion, responseHeaders);
        return reqOk && respOk;
    }

    /**
     * The response-only reuse read a *client* uses after receiving a
     * response to a request it knows it sent keep-alive: given the
     * request already permitted reuse, the connection is reusable iff the
     * response also permits it. A thin convenience over
     * [`messageAllowsReuse`](#) for the common client path where the
     * request side is already known-good.
     */
    public static boolean responseAllowsReuse(String responseVersion,
                                              Headers responseHeaders) {
        return KeepAlive.messageAllowsReuse(responseVersion, responseHeaders);
    }

    // -- emit ---------------------------------------------------------------

    /**
     * The canonical `Connection` header **value** a sender should emit to
     * advertise its keep-alive intent on `version`, or `null` when the
     * version default already conveys the intent (so no header is needed):
     *
     *   - want reuse on **HTTP/1.1** → `null` (1.1 is persistent by
     *     default; emitting `keep-alive` is redundant, RFC 7230 §6.3).
     *   - want reuse on **HTTP/1.0** → `"keep-alive"` (must opt in).
     *   - want **close** on **HTTP/1.1** → `"close"` (must opt out).
     *   - want close on **HTTP/1.0** → `null` (close is the 1.0 default).
     *
     * A `null` return means "emit no `Connection` header." Callers that
     * always want an explicit header use
     * [`connectionTokenExplicit`](#).
     */
    public static #String connectionToken(String version, boolean wantReuse) {
        boolean isHttp10 = KeepAlive.isHttp10(version);
        if (wantReuse) {
            if (isHttp10) {
                return KeepAlive.lit("keep-alive");
            }
            return null;            // 1.1 default — no header needed
        }
        // want close
        if (isHttp10) {
            return null;            // 1.0 default — no header needed
        }
        return KeepAlive.lit("close");
    }

    /**
     * The explicit `Connection` token regardless of the version default:
     * `"keep-alive"` for reuse, `"close"` otherwise. For callers (and
     * proxies) that prefer to always state the intent on the wire rather
     * than rely on the version default. Never `null`.
     */
    public static #String connectionTokenExplicit(boolean wantReuse) {
        if (wantReuse) {
            return KeepAlive.lit("keep-alive");
        }
        return KeepAlive.lit("close");
    }

    /**
     * Set the `Connection` header on `headers` to advertise `wantReuse`
     * on `version`, **or remove it** when the version default already
     * conveys the intent (so the wire stays minimal — see
     * [`connectionToken`](#)). Last-write-wins: any existing `Connection`
     * header is replaced (or dropped). Mutates `headers` in place.
     */
    public static void applyConnectionHeader(Headers headers, String version,
                                             boolean wantReuse) {
        String token = KeepAlive.connectionToken(version, wantReuse);
        if (token == null) {
            headers.remove("Connection");
            return;
        }
        headers.set("Connection", token);
    }

    // -- helpers ------------------------------------------------------------

    /** True iff `version` is exactly `"HTTP/1.0"`. */
    static boolean isHttp10(String version) {
        return version.equals("HTTP/1.0");
    }

    /** Copy a literal into a fresh owned `String` (the emitted token). */
    static #String lit(String s) {
        return heap String(s.bytes, s.byteLength);
    }

    /**
     * True iff `token` appears in the (already-lowercased) `value` as a
     * whole comma/space/tab-delimited list token — so `keep-alive` is not
     * matched as a substring and `close` matches `Connection: close` but
     * not a larger word that merely contains those letters. Mirrors the
     * parser's `tokenContains` (RFC 7230 §6.1 connection-option list).
     */
    static boolean tokenContains(String value, String token) {
        int32 vlen = value.byteLength;
        int32 tlen = token.byteLength;
        if (tlen == 0 || tlen > vlen) {
            return false;
        }
        int32 i = 0;
        while (i + tlen <= vlen) {
            if (KeepAlive.matchesAt(value, i, token, tlen)) {
                boolean leftOk = i == 0 || KeepAlive.isDelim(value.byteAt(i - 1));
                int32 after = i + tlen;
                boolean rightOk = after == vlen
                    || KeepAlive.isDelim(value.byteAt(after));
                if (leftOk && rightOk) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    static boolean matchesAt(String value, int32 at, String token, int32 tlen) {
        int32 j = 0;
        while (j < tlen) {
            if (value.byteAt(at + j) != token.byteAt(j)) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /** Token delimiter: comma, space, or tab (the list-rule separators). */
    static boolean isDelim(int8 b) {
        int32 c = ((int32) b) & 255;
        return c == 44 || c == 32 || c == 9;    // ',' ' ' '\t'
    }
}
