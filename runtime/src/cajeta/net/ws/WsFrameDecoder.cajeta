package cajeta.net.ws;

/**
 * The **incremental WebSocket frame decoder** (RFC 6455 §5.2) — the
 * decode half of the frame codec (**NET-10.3**). A resumable state
 * machine fed arbitrary byte chunks: a frame split across several socket
 * reads decodes identically to a one-shot feed, exactly the discipline
 * the HTTP incremental parser ([`HttpParser`](../http/HttpParser.cajeta))
 * and streaming body decoder ([`BodyReader`](../http/BodyReader.cajeta))
 * use. Pure logic over `int8[]` — no I/O — so it pins against the
 * `ws/frames.vectors` golden corpus; the async transport
 * ([`AsyncReader`](../AsyncReader.cajeta), NET-3.5) drives
 * [`feed`](#feed) later.
 *
 * ## Lifecycle
 *
 * ```cajeta
 * WsFrameDecoder dec = WsFrameDecoder.forServer();   // expects masked client frames
 * dec.feed(bytes, n);
 * while (dec.hasFrame()) {
 *     WsFrame f = dec.nextFrame();
 *     // dispatch on f.getOpcode() / f.isFin() ...
 * }
 * ```
 *
 *   - [`feed`](#feed) — append the next raw bytes; decode as many
 *     complete frames as the buffered bytes allow, queuing each. A
 *     partial trailing frame stays buffered for the next `feed`.
 *   - [`hasFrame`](#hasFrame) / [`nextFrame`](#nextFrame) — drain the
 *     decoded-frame queue (FIFO).
 *
 * ## Masking direction (RFC 6455 §5.1)
 *
 * The decoder is built for one direction:
 *
 *   - [`forServer`](#forServer) — decoding **client→server** frames: each
 *     frame **MUST be masked**; an unmasked frame is a
 *     [`ProtocolViolationException`](ProtocolViolationException.cajeta).
 *   - [`forClient`](#forClient) — decoding **server→client** frames: each
 *     frame **MUST NOT be masked**; a masked frame is a violation.
 *
 * Either way the emitted [`WsFrame.payload`](WsFrame.cajeta) is the
 * **unmasked** application bytes — the decoder applies the masking key
 * (`payload[i] ^ key[i % 4]`, RFC 6455 §5.3) on the way in.
 *
 * ## Protocol violations (RFC 6455 §5.2 / §5.5)
 *
 * The decoder *Fails the Connection* (raises
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta)
 * citing the stream byte offset) on: a reserved opcode, any set RSV bit
 * (no extension negotiated), a mask-direction mismatch, a fragmented
 * control frame (`FIN == 0` on a control opcode), a control frame with a
 * payload `> 125` bytes, or a 64-bit length with its high bit set.
 *
 * ## Frame-size guard
 *
 * A [`maxFrameLength`](#maxFrameLength) cap bounds a single frame's
 * payload so a hostile `127`-form length cannot force an unbounded
 * allocation; exceeding it raises a
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta). (The
 * *message*-level max-size limit across reassembled fragments is the
 * fragmentation layer's concern, NET-10.4; this is the per-frame floor.)
 */
public class WsFrameDecoder {
    // -- decode sub-states (a resumable header→payload state machine) -------

    /** Reading byte 0 (FIN + RSV + opcode). */
    static final int32 ST_B0       = 0;
    /** Reading byte 1 (MASK + 7-bit length code). */
    static final int32 ST_B1       = 1;
    /** Reading the 2-byte (16-bit) extended length. */
    static final int32 ST_LEN16    = 2;
    /** Reading the 8-byte (64-bit) extended length. */
    static final int32 ST_LEN64    = 3;
    /** Reading the 4-byte masking key. */
    static final int32 ST_MASK     = 4;
    /** Copying the payload bytes (unmasking as they arrive). */
    static final int32 ST_PAYLOAD  = 5;

    /** Default per-frame payload cap (16 MiB) when the caller doesn't pick one. */
    public static final int32 DEFAULT_MAX_FRAME = 16777216;

    // -- configuration ------------------------------------------------------

    /**
     * `true` when decoding **client→server** frames (masking required);
     * `false` for **server→client** (masking forbidden).
     */
    boolean expectMasked;
    /** Per-frame payload cap in bytes (see [`maxFrameLength`](#maxFrameLength)). */
    int32 maxFrame;

    // -- current-frame header accumulators ----------------------------------

    int32 state;
    boolean curFin;
    int32 curOpcode;
    boolean curMasked;
    /** 7-bit length code (0..127) from byte 1. */
    int32 lenCode;
    /** Bytes already read of a multi-byte extended length. */
    int32 lenBytesRead;
    /** The resolved payload length. */
    int64 payloadLen;
    /** The 4 masking-key bytes (valid when `curMasked`). */
    int8[] maskKey;
    /** Bytes already read of the masking key. */
    int32 maskBytesRead;

    // -- current-frame payload buffer (filled as bytes arrive) --------------

    int8[] payBuf;
    int64 payRead;

    /** Running count of frame-stream bytes consumed (for error offsets). */
    int64 streamPos;

    // -- decoded-frame queue (FIFO; ring of references) ---------------------

    WsFrame[] queue;
    int32 qHead;
    int32 qTail;
    int32 qCount;
    int32 qCap;

    // -----------------------------------------------------------------------

    WsFrameDecoder() {
        this.expectMasked = true;
        this.maxFrame = WsFrameDecoder.DEFAULT_MAX_FRAME;
        this.state = WsFrameDecoder.ST_B0;
        this.curFin = false;
        this.curOpcode = 0;
        this.curMasked = false;
        this.lenCode = 0;
        this.lenBytesRead = 0;
        this.payloadLen = (int64) 0;
        this.maskKey = new int8[4];
        this.maskBytesRead = 0;
        this.payBuf = new int8[0];
        this.payRead = (int64) 0;
        this.streamPos = (int64) 0;
        this.qCap = 8;
        this.queue = new WsFrame[8];
        this.qHead = 0;
        this.qTail = 0;
        this.qCount = 0;
    }

    /**
     * A decoder for **client→server** frames (server side of a
     * connection): every incoming frame MUST be masked. Uses the default
     * per-frame cap ([`DEFAULT_MAX_FRAME`](#DEFAULT_MAX_FRAME)).
     */
    public static #WsFrameDecoder forServer() {
        WsFrameDecoder d = heap WsFrameDecoder();
        d.expectMasked = true;
        return #d;
    }

    /**
     * A decoder for **server→client** frames (client side of a
     * connection): every incoming frame MUST NOT be masked.
     */
    public static #WsFrameDecoder forClient() {
        WsFrameDecoder d = heap WsFrameDecoder();
        d.expectMasked = false;
        return #d;
    }

    /**
     * Set the per-frame payload cap (bytes). A frame whose declared
     * length exceeds this raises a
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta)
     * rather than allocating. Returns `this` for chaining.
     */
    public WsFrameDecoder withMaxFrameLength(int32 maxBytes) {
        if (maxBytes < 0) {
            maxBytes = 0;
        }
        this.maxFrame = maxBytes;
        return this;
    }

    // -- feeding ------------------------------------------------------------

    /**
     * Append the first `length` bytes of `data` to the frame stream and
     * decode as many complete frames as the buffered bytes allow, queuing
     * each (drain via [`hasFrame`](#hasFrame) / [`nextFrame`](#nextFrame)).
     * A frame split mid-header or mid-payload simply leaves the decoder
     * parked in the matching sub-state; the next `feed` resumes it.
     *
     * Raises
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta) on
     * a malformed frame (reserved opcode, set RSV bit, mask-direction
     * mismatch, fragmented/oversize control frame, bad 64-bit length, or
     * an over-cap payload).
     */
    public void feed(int8[] data, int32 length) {
        int32 i = 0;
        while (i < length) {
            int8 c = data[i];
            this.streamPos = this.streamPos + ((int64) 1);
            if (this.state == WsFrameDecoder.ST_B0) {
                this.feedByte0(c);
            } else if (this.state == WsFrameDecoder.ST_B1) {
                this.feedByte1(c);
            } else if (this.state == WsFrameDecoder.ST_LEN16) {
                this.feedLen16(c);
            } else if (this.state == WsFrameDecoder.ST_LEN64) {
                this.feedLen64(c);
            } else if (this.state == WsFrameDecoder.ST_MASK) {
                this.feedMaskByte(c);
            } else {
                this.feedPayloadByte(c);
            }
            i = i + 1;
        }
    }

    // -- header decoding ----------------------------------------------------

    /** Byte 0: FIN (high bit) + 3 RSV bits (must be 0) + 4-bit opcode. */
    void feedByte0(int8 c) {
        int32 b = ((int32) c) & 255;
        this.curFin = (b & 128) != 0;
        // RSV1/2/3 — bits 0x40/0x20/0x10. No extension negotiated, so any
        // set RSV bit is a protocol violation (RFC 6455 §5.2).
        if ((b & 112) != 0) {
            throw heap ProtocolViolationException(
                "RSV bit set with no negotiated extension",
                this.streamPos - ((int64) 1));
        }
        int32 op = b & 15;
        if (WsOpcode.isReserved(op)) {
            throw heap ProtocolViolationException(
                "reserved opcode", this.streamPos - ((int64) 1));
        }
        // A control frame MUST NOT be fragmented (RFC 6455 §5.5).
        if (WsOpcode.isControl(op) && !this.curFin) {
            throw heap ProtocolViolationException(
                "fragmented control frame", this.streamPos - ((int64) 1));
        }
        this.curOpcode = op;
        this.state = WsFrameDecoder.ST_B1;
    }

    /** Byte 1: MASK bit (high) + 7-bit length code. */
    void feedByte1(int8 c) {
        int32 b = ((int32) c) & 255;
        this.curMasked = (b & 128) != 0;
        // Masking-direction enforcement (RFC 6455 §5.1).
        if (this.expectMasked && !this.curMasked) {
            throw heap ProtocolViolationException(
                "client frame is not masked", this.streamPos - ((int64) 1));
        }
        if (!this.expectMasked && this.curMasked) {
            throw heap ProtocolViolationException(
                "server frame is masked", this.streamPos - ((int64) 1));
        }
        this.lenCode = b & 127;
        // A control frame's payload MUST be <= 125 bytes (RFC 6455 §5.5):
        // it cannot use the 126/127 extended-length forms.
        if (WsOpcode.isControl(this.curOpcode) && this.lenCode > 125) {
            throw heap ProtocolViolationException(
                "control frame payload exceeds 125 bytes",
                this.streamPos - ((int64) 1));
        }
        if (this.lenCode <= 125) {
            this.payloadLen = (int64) this.lenCode;
            this.beginPayloadOrMask();
        } else if (this.lenCode == 126) {
            this.payloadLen = (int64) 0;
            this.lenBytesRead = 0;
            this.state = WsFrameDecoder.ST_LEN16;
        } else {
            this.payloadLen = (int64) 0;
            this.lenBytesRead = 0;
            this.state = WsFrameDecoder.ST_LEN64;
        }
    }

    /** Accumulate the 2-byte (16-bit) big-endian extended length. */
    void feedLen16(int8 c) {
        int32 b = ((int32) c) & 255;
        this.payloadLen = (this.payloadLen << 8) | ((int64) b);
        this.lenBytesRead = this.lenBytesRead + 1;
        if (this.lenBytesRead == 2) {
            this.beginPayloadOrMask();
        }
    }

    /** Accumulate the 8-byte (64-bit) big-endian extended length. */
    void feedLen64(int8 c) {
        int32 b = ((int32) c) & 255;
        // The most significant bit of a 64-bit length MUST be 0 (RFC 6455
        // §5.2): reject it on the first (high) byte.
        if (this.lenBytesRead == 0 && (b & 128) != 0) {
            throw heap ProtocolViolationException(
                "64-bit payload length has its high bit set",
                this.streamPos - ((int64) 1));
        }
        this.payloadLen = (this.payloadLen << 8) | ((int64) b);
        this.lenBytesRead = this.lenBytesRead + 1;
        if (this.lenBytesRead == 8) {
            this.beginPayloadOrMask();
        }
    }

    /**
     * The length is resolved: enforce the per-frame cap, allocate the
     * payload buffer, then either read the 4-byte mask key (masked) or go
     * straight to the payload (unmasked). A zero-length payload finishes
     * the frame immediately.
     */
    void beginPayloadOrMask() {
        if (this.payloadLen > ((int64) this.maxFrame)) {
            throw heap ProtocolViolationException(
                "frame payload exceeds the configured maximum",
                this.streamPos - ((int64) 1));
        }
        int32 n = (int32) this.payloadLen;
        this.payBuf = new int8[n];
        this.payRead = (int64) 0;
        if (this.curMasked) {
            this.maskBytesRead = 0;
            this.state = WsFrameDecoder.ST_MASK;
        } else {
            this.state = WsFrameDecoder.ST_PAYLOAD;
            this.finishIfPayloadComplete();
        }
    }

    /** Accumulate the 4-byte masking key, then move to the payload. */
    void feedMaskByte(int8 c) {
        this.maskKey[this.maskBytesRead] = c;
        this.maskBytesRead = this.maskBytesRead + 1;
        if (this.maskBytesRead == 4) {
            this.state = WsFrameDecoder.ST_PAYLOAD;
            this.finishIfPayloadComplete();
        }
    }

    /** Copy one payload byte, unmasking it (XOR with `key[i % 4]`) if masked. */
    void feedPayloadByte(int8 c) {
        int32 idx = (int32) this.payRead;
        if (this.curMasked) {
            int32 k = ((int32) this.maskKey[idx & 3]) & 255;
            int32 v = (((int32) c) & 255) ^ k;
            this.payBuf[idx] = (int8) v;
        } else {
            this.payBuf[idx] = c;
        }
        this.payRead = this.payRead + ((int64) 1);
        this.finishIfPayloadComplete();
    }

    /** Emit the frame + reset for the next one once the payload is full. */
    void finishIfPayloadComplete() {
        if (this.payRead >= this.payloadLen) {
            // Move the completed payload out of the field first (replacing
            // it with a fresh empty buffer) so the decoder no longer
            // aliases the bytes it is about to hand to the frame — the
            // BufferPool.acquire hand-off discipline.
            int8[] pay = this.payBuf;
            this.payBuf = new int8[0];
            // Bind the boolean/int header fields to named locals before the
            // call — a boolean field loaded directly into a call argument can
            // mistype (the same family as the array-element-as-arg bug).
            boolean fin = this.curFin;
            int32 op = this.curOpcode;
            boolean masked = this.curMasked;
            WsFrame f = WsFrame.of(fin, op, masked, #pay);
            // TRANSFER the frame into the queue (`#f`) — without it the local
            // `f` is still an active owner and its scope-exit drop reclaims the
            // frame the queue now references, so nextFrame() later hands the
            // caller a freed frame (a double-free / use-after-free that only
            // surfaces under heap churn).
            this.enqueue(#f);
            // Reset header accumulators for the next frame.
            this.payRead = (int64) 0;
            this.state = WsFrameDecoder.ST_B0;
        }
    }

    // -- decoded-frame queue ------------------------------------------------

    /** `true` when a fully decoded frame is waiting to be drained. */
    public boolean hasFrame() {
        return this.qCount > 0;
    }

    /** Number of decoded frames waiting in the queue. */
    public int32 frameCount() {
        return this.qCount;
    }

    /**
     * Remove + return the oldest decoded frame (FIFO), or `null` when the
     * queue is empty (test [`hasFrame`](#hasFrame) first). Ownership
     * transfers to the caller: the queue slot is nulled so the decoder no
     * longer aliases the frame it just handed off — the
     * [`BufferPool.acquire`](../BufferPool.cajeta) hand-off discipline.
     */
    public #WsFrame nextFrame() {
        if (this.qCount == 0) {
            return null;
        }
        // TRANSFER ownership out of the queue: read the element, null the slot
        // (so the decoder's queue-drop won't reclaim it), and `#`-return it to
        // the caller. The signature is `#WsFrame` so the caller becomes the
        // sole owner — the hand-off discipline the doc above describes.
        WsFrame f = this.queue[this.qHead];
        this.queue[this.qHead] = null;
        this.qHead = (this.qHead + 1) % this.qCap;
        this.qCount = this.qCount - 1;
        return #f;
    }

    void enqueue(#WsFrame f) {
        if (this.qCount == this.qCap) {
            this.growQueue();
        }
        // `#f` transfers the frame into the queue slot so the caller
        // (finishIfPayloadComplete) no longer owns/drops it — the queue is now
        // the sole owner until nextFrame() hands it back out.
        this.queue[this.qTail] = #f;
        this.qTail = (this.qTail + 1) % this.qCap;
        this.qCount = this.qCount + 1;
    }

    void growQueue() {
        int32 newCap = this.qCap * 2;
        WsFrame[] grown = new WsFrame[newCap];
        int32 i = 0;
        while (i < this.qCount) {
            grown[i] = this.queue[(this.qHead + i) % this.qCap];
            i = i + 1;
        }
        // `#grown` transfers ownership of the fresh backing store into the
        // field so the local's scope-exit drop doesn't reclaim the array
        // we just installed — the Headers.grow ownership-marker discipline.
        this.queue = #grown;
        this.qCap = newCap;
        this.qHead = 0;
        this.qTail = this.qCount;
    }
}
