package cajeta.net.ws;

import cajeta.lang.String;

/**
 * The **WebSocket read-side protocol engine** (RFC 6455 §5.4 / §5.5) —
 * plan item **NET-10.6**, the pure-logic core the
 * [`WebSocket`](WebSocket.cajeta) façade drives. It threads each decoded
 * [`WsFrame`](WsFrame.cajeta) through three already-landed pure layers —
 * the fragmentation reassembler ([`WsMessageAssembler`](WsMessageAssembler.cajeta),
 * NET-10.4), the control-frame logic ([`WsControlFrames`](WsControlFrames.cajeta),
 * NET-10.5), and the opcode classifier ([`WsOpcode`](WsOpcode.cajeta)) —
 * and returns a [`WsReadAction`](WsReadAction.cajeta) telling the transport
 * what to do: deliver a message, write an auto-pong, complete the close
 * handshake, or read on.
 *
 * ## Why a separate engine
 *
 * The decision *what to do with an inbound frame* is RFC protocol logic
 * with no I/O — assemble fragments, auto-pong a ping, reply to a close —
 * while the *doing* (socket writes under the write lock) is the façade's.
 * Splitting them lets this engine pin against golden frame sequences the
 * way [`WsMessageAssembler`](WsMessageAssembler.cajeta) and
 * [`WsControlFrameTests`](../../../../../test/parser/WsControlFrameTests.cpp)
 * pin theirs — `feed a WsFrame, assert the WsReadAction` — without a live
 * socket, while the [`WebSocket`](WebSocket.cajeta) read loop stays a thin
 * `decode → onFrame → act` wrapper.
 *
 * ## Auto-pong (RFC 6455 §5.5.2 / §5.5.3)
 *
 * By default an inbound `PING` yields a [`WsReadAction.SEND_FRAME`](WsReadAction.cajeta)
 * carrying the [`WsControlFrames.pongFor`](WsControlFrames.cajeta) auto-pong
 * (the ping's payload echoed). An application that wants to answer pings
 * itself disables auto-pong ([`withAutoPong(false)`](#withAutoPong)); a
 * `PING` then surfaces as [`WsReadAction.PING`](WsReadAction.cajeta).
 * Inbound `PONG` frames are always swallowed ([`WsReadAction.NONE`](WsReadAction.cajeta))
 * — they are the reply to a ping the engine does not otherwise track.
 *
 * ## Close handshake (RFC 6455 §5.5.1 / §7)
 *
 * The first inbound `CLOSE` is parsed
 * ([`WsControlFrames.parseClose`](WsControlFrames.cajeta)) into a
 * [`WsCloseReason`](WsCloseReason.cajeta) and yields a
 * [`WsReadAction.CLOSED`](WsReadAction.cajeta):
 *
 *   - if the **local side has not yet sent a close**
 *     ([`localCloseSent`](#localCloseSent) is `false`), the action carries
 *     the [`WsControlFrames.reciprocalClose`](WsControlFrames.cajeta) reply
 *     the loop must write before tearing down (and the engine marks the
 *     local close sent so a second inbound close is idempotent);
 *   - if the **local side already sent its close**, the action carries no
 *     reply (`frame == null`) — the handshake is complete, just tear down.
 *
 * After a close is seen the engine is **terminal**: [`isClosed`](#isClosed)
 * is `true`, the peer's reason is retained in [`closeReason`](#closeReason),
 * and any further [`onFrame`](#onFrame) is a no-op `CLOSED`.
 *
 * ## Sequencing faults
 *
 * A malformed close payload, an out-of-sequence data fragment, or an
 * over-cap reassembled message surface as the same exceptions the
 * underlying layers raise —
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta)
 * (RFC 6455 §5.4 sequencing, §5.5.1 bad close payload) or
 * [`MessageTooLargeException`](MessageTooLargeException.cajeta)
 * (§7.4.1 `1009`) — so the façade maps them to the right `Fail the
 * Connection` close code uniformly.
 */
public class WsProtocol {
    // -- configuration ------------------------------------------------------

    /** `true` (default) to auto-pong an inbound ping; `false` to surface it. */
    boolean autoPong;

    // -- delegated reassembly ----------------------------------------------

    /** The fragmentation reassembler (NET-10.4) for data frames. */
    WsMessageAssembler assembler;

    // -- close-handshake state ---------------------------------------------

    /** `true` once the local side has emitted (or queued) its own `CLOSE`. */
    boolean localCloseSent;
    /** `true` once a peer `CLOSE` has been observed — the engine is then terminal. */
    boolean peerClosed;
    /** The peer's parsed close reason once `peerClosed`; else `null`. */
    WsCloseReason closeReason;

    // -----------------------------------------------------------------------

    WsProtocol() {
        this.autoPong = true;
        this.assembler = WsMessageAssembler.create();
        this.localCloseSent = false;
        this.peerClosed = false;
        this.closeReason = null;
    }

    /** A read engine with auto-pong on and the default per-message cap. */
    public static #WsProtocol create() {
        WsProtocol p = heap WsProtocol();
        return #p;
    }

    /**
     * Enable (default) or disable **auto-pong**. With it off, an inbound
     * ping surfaces as [`WsReadAction.PING`](WsReadAction.cajeta) instead of
     * being answered for the application. Returns `this` for chaining.
     */
    public WsProtocol withAutoPong(boolean enabled) {
        this.autoPong = enabled;
        return this;
    }

    /**
     * Set the per-message reassembly cap (bytes), delegated to the
     * underlying [`WsMessageAssembler`](WsMessageAssembler.cajeta). A
     * message whose reassembled total would exceed this raises a
     * [`MessageTooLargeException`](MessageTooLargeException.cajeta). Returns
     * `this` for chaining.
     */
    public WsProtocol withMaxMessageLength(int64 maxBytes) {
        this.assembler.withMaxMessageLength(maxBytes);
        return this;
    }

    // -- close-state observers ---------------------------------------------

    /**
     * Mark that the **local side has sent (or is sending) a `CLOSE`** — the
     * façade calls this from [`WebSocket.close`](WebSocket.cajeta) so that a
     * subsequently received peer close is recognized as completing a
     * handshake the local side initiated (no reciprocal needed).
     */
    public void markLocalCloseSent() {
        this.localCloseSent = true;
    }

    /** `true` once a peer `CLOSE` frame has been observed (terminal state). */
    public boolean isClosed() {
        return this.peerClosed;
    }

    /** The peer's parsed close `{ code, reason }` once closed; else `null`. */
    public WsCloseReason getCloseReason() {
        return this.closeReason;
    }

    /** `true` while a fragmented data message is mid-assembly. */
    public boolean isAssembling() {
        return this.assembler.isAssembling();
    }

    // -- the dispatch -------------------------------------------------------

    /**
     * Consume one decoded [`WsFrame`](WsFrame.cajeta) and return the
     * [`WsReadAction`](WsReadAction.cajeta) the transport must act on:
     *
     *   - a **data frame** (text/binary/continuation) → the reassembler:
     *     [`WsReadAction.MESSAGE`](WsReadAction.cajeta) when it completes a
     *     message, else [`WsReadAction.NONE`](WsReadAction.cajeta);
     *   - a **`PING`** → an auto-pong [`WsReadAction.SEND_FRAME`](WsReadAction.cajeta)
     *     (auto-pong on) or [`WsReadAction.PING`](WsReadAction.cajeta) (off);
     *   - a **`PONG`** → [`WsReadAction.NONE`](WsReadAction.cajeta) (swallowed);
     *   - a **`CLOSE`** → [`WsReadAction.CLOSED`](WsReadAction.cajeta) with
     *     the parsed reason and, if the local side had not yet closed, the
     *     reciprocal close to write.
     *
     * Once a peer close has been seen this is terminal: every further call
     * returns a reply-less `CLOSED` carrying the retained
     * [`closeReason`](#closeReason).
     *
     * Raises [`ProtocolViolationException`](ProtocolViolationException.cajeta)
     * on an out-of-sequence fragment or a malformed close payload, or
     * [`MessageTooLargeException`](MessageTooLargeException.cajeta) when a
     * reassembled message exceeds the cap — the underlying layers' faults,
     * propagated unchanged.
     */
    public #WsReadAction onFrame(WsFrame frame) {
        // Terminal: a peer close was already observed. Stay closed.
        if (this.peerClosed) {
            WsCloseReason rc = WsProtocol.copyReason(this.closeReason);
            WsFrame noReply = null;
            return WsReadAction.closed(#rc, #noReply);
        }

        int32 op = frame.getOpcode();

        // --- control frames (RFC 6455 §5.5) ---
        if (WsOpcode.isControl(op)) {
            if (op == WsOpcode.CLOSE) {
                return this.onClose(frame);
            }
            if (op == WsOpcode.PING) {
                if (this.autoPong) {
                    WsFrame pong = WsControlFrames.pongFor(frame);
                    return WsReadAction.sendFrame(#pong);
                }
                // Surface the ping for the application (auto-pong disabled).
                // Hand the action a *copy* (not the caller's still-owned
                // decoded `frame`), so the action owns its payload cleanly.
                WsFrame pingCopy = WsProtocol.copyFrame(frame);
                return WsReadAction.ping(#pingCopy);
            }
            // PONG (or any other control opcode the codec let through):
            // swallow — a pong is the reply to a ping we do not track.
            return WsReadAction.none();
        }

        // --- data frames (RFC 6455 §5.4) → the reassembler ---
        WsMessage m = this.assembler.accept(frame);
        if (m != null) {
            return WsReadAction.message(#m);
        }
        return WsReadAction.none();
    }

    /**
     * Handle an inbound `CLOSE`: parse it, retain the reason, flip to the
     * terminal closed state, and emit a [`WsReadAction.CLOSED`](WsReadAction.cajeta)
     * carrying the reciprocal close to write (unless the local side already
     * sent its own close).
     */
    #WsReadAction onClose(WsFrame frame) {
        // parseClose validates the close payload (§5.5.1): a 1-byte payload
        // or a never-on-the-wire status code raises ProtocolViolationException.
        WsCloseReason reason = WsControlFrames.parseClose(frame);
        this.peerClosed = true;

        // Build the action's reply + reason copies from the freshly parsed
        // `reason` *before* moving it into the retained field — the field
        // takes ownership via `#reason`, after which the local must not be
        // read (the WsMessageAssembler ownership-marker discipline).
        boolean alreadyClosing = this.localCloseSent;
        WsCloseReason reasonCopy = WsProtocol.copyReason(reason);

        // Build the reciprocal reply (if needed) from `reason` *before* moving
        // it into the retained field — a single move site (`#reason`) follows,
        // after which the local is never read again on any path.
        WsFrame reply = null;
        if (!alreadyClosing) {
            // Reply with the reciprocal close (RFC 6455 §5.5.1) and record the
            // local close as (about to be) sent so a duplicate inbound close is
            // idempotent.
            reply = WsControlFrames.reciprocalClose(reason);
            this.localCloseSent = true;
        }
        // Retain the parsed reason for getCloseReason() (ownership moves into
        // the field; `reason` is not read after this on any path).
        this.closeReason = #reason;
        return WsReadAction.closed(#reasonCopy, #reply);
    }

    /**
     * A fresh owned copy of `src`'s close `{ code, reason }`, so each
     * `CLOSED` action owns its reason independently of the engine's retained
     * one (the engine keeps [`closeReason`](#closeReason) alive for
     * [`getCloseReason`](#getCloseReason)). A null or code-less `src` copies
     * to a [`WsCloseReason.noStatus`](WsCloseReason.cajeta) placeholder.
     */
    static #WsCloseReason copyReason(WsCloseReason src) {
        if (src == null) {
            return WsCloseReason.noStatus();
        }
        if (!src.hasCode()) {
            return WsCloseReason.noStatus();
        }
        // Copy the reason String's bytes into a fresh owned String.
        String text = src.getReason();
        int32 n = text.byteLength;
        int8[] rb = heap int8[n];
        int32 i = 0;
        while (i < n) {
            rb[i] = text.bytes[i];
            i = i + 1;
        }
        String reasonCopy = heap String(#rb, n);
        return WsCloseReason.of(src.getCode(), #reasonCopy);
    }

    /**
     * A fresh owned [`WsFrame`](WsFrame.cajeta) with the same fin / opcode /
     * masked flags and a **copy** of `src`'s payload — used to hand a
     * surfaced ping to a [`WsReadAction`](WsReadAction.cajeta) without moving
     * the caller's still-owned decoded frame (the
     * [`WsControlFrames.pongFor`](WsControlFrames.cajeta) copy discipline).
     */
    static #WsFrame copyFrame(WsFrame src) {
        int8[] sp = src.getPayload();
        int32 n = sp.count();
        int8[] pay = heap int8[n];
        int32 i = 0;
        while (i < n) {
            pay[i] = sp[i];
            i = i + 1;
        }
        return WsFrame.of(src.isFin(), src.getOpcode(), src.isMasked(), #pay);
    }
}
