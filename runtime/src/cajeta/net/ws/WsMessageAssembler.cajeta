package cajeta.net.ws;

/**
 * The **WebSocket message-fragmentation reassembler** (RFC 6455 §5.4) —
 * **NET-10.4**. Sits one layer above the frame codec
 * ([`WsFrameDecoder`](WsFrameDecoder.cajeta), **NET-10.3**): the decoder
 * hands up one [`WsFrame`](WsFrame.cajeta) per on-wire fragment, and this
 * assembler stitches a data frame plus its trailing continuation frames
 * back into a single logical [`WsMessage`](WsMessage.cajeta), enforcing a
 * total-bytes ceiling along the way. Pure logic over `WsFrame` (no I/O),
 * so it pins against fixture vectors exactly as the codec pins
 * `ws/frames.vectors`; the async transport drives it with decoded frames
 * later (NET-10.6).
 *
 * ## Lifecycle
 *
 * ```cajeta
 * WsMessageAssembler asm = WsMessageAssembler.create();
 * while (dec.hasFrame()) {
 *     WsFrame f = dec.nextFrame();
 *     if (f.isControl()) {
 *         // ping / pong / close — handled by the control layer (NET-10.5);
 *         // a control frame may interleave between data fragments and
 *         // MUST NOT disturb the message in progress. accept() returns
 *         // null for it, leaving any partial message intact.
 *         asm.accept(f);
 *         continue;
 *     }
 *     WsMessage m = asm.accept(f);
 *     if (m != null) {
 *         // a whole text/binary message is ready
 *     }
 * }
 * ```
 *
 * [`accept`](#accept) takes the next decoded frame and returns a
 * completed [`WsMessage`](WsMessage.cajeta) when that frame finishes a
 * message (`FIN == 1` on a data/continuation frame), or `null` while a
 * message is still being assembled (or for a control frame, which is
 * passed straight through untouched).
 *
 * ## Fragmentation rules (RFC 6455 §5.4)
 *
 * The assembler *Fails the WebSocket Connection* with a
 * [`ProtocolViolationException`](ProtocolViolationException.cajeta) on any
 * of the §5.4 sequencing faults:
 *
 *   - a **`CONTINUATION` frame with no message in progress** — a
 *     continuation must follow an opened (`FIN == 0`) data frame;
 *   - a **new data frame (`TEXT`/`BINARY`) while a fragmented message is
 *     still open** — a message's fragments MUST NOT be interleaved with
 *     another data message's fragments (only control frames may
 *     interleave);
 *   - a frame whose opcode is neither control, continuation, nor a
 *     recognized data opcode (the codec already rejects reserved
 *     opcodes, so this is a defensive guard).
 *
 * Control frames (`isControl()`) are never reassembled: they carry no
 * message data and may appear between data fragments, so
 * [`accept`](#accept) returns `null` for them and leaves the in-progress
 * message buffer exactly as it was.
 *
 * ## Max-message-size limit
 *
 * A [`maxMessageLength`](#maxMessageLength) cap bounds the **running
 * total** of a message's reassembled bytes across all its fragments. A
 * hostile peer can stay under the per-frame
 * [`WsFrameDecoder`](WsFrameDecoder.cajeta) cap yet stream an unbounded
 * number of small continuation frames; this ceiling stops that. Crossing
 * it raises a
 * [`MessageTooLargeException`](MessageTooLargeException.cajeta) (RFC 6455
 * §7.4.1 close code `1009`). The cap is checked *before* each fragment's
 * bytes are copied, so the accumulator never grows past the limit.
 */
public class WsMessageAssembler {
    /** Default max reassembled message size (64 MiB) when the caller doesn't pick one. */
    public static final int64 DEFAULT_MAX_MESSAGE = (int64) 67108864;

    // -- configuration ------------------------------------------------------

    /** Max total reassembled bytes per message (see [`maxMessageLength`](#maxMessageLength)). */
    int64 maxMessage;

    // -- in-progress message state ------------------------------------------

    /** `true` while a fragmented message is open (its first frame had `FIN == 0`). */
    boolean inProgress;
    /** The opcode of the message being assembled (the first frame's opcode). */
    int32 msgOpcode;
    /** Growable accumulator for the reassembled payload. */
    int8[] buf;
    /** Number of valid bytes in [`buf`](#buf). */
    int32 bufLen;

    // -----------------------------------------------------------------------

    WsMessageAssembler() {
        this.maxMessage = WsMessageAssembler.DEFAULT_MAX_MESSAGE;
        this.inProgress = false;
        this.msgOpcode = 0;
        this.buf = new int8[0];
        this.bufLen = 0;
    }

    /**
     * A reassembler with the default per-message cap
     * ([`DEFAULT_MAX_MESSAGE`](#DEFAULT_MAX_MESSAGE)).
     */
    public static #WsMessageAssembler create() {
        WsMessageAssembler a = heap WsMessageAssembler();
        return #a;
    }

    /**
     * Set the per-message reassembly cap (bytes). A message whose
     * reassembled total would exceed this raises a
     * [`MessageTooLargeException`](MessageTooLargeException.cajeta) rather
     * than growing the accumulator. Returns `this` for chaining.
     */
    public WsMessageAssembler withMaxMessageLength(int64 maxBytes) {
        if (maxBytes < ((int64) 0)) {
            maxBytes = (int64) 0;
        }
        this.maxMessage = maxBytes;
        return this;
    }

    /** The configured per-message cap (bytes). */
    public int64 maxMessageLength() {
        return this.maxMessage;
    }

    /** `true` while a fragmented message is mid-assembly (awaiting its `FIN == 1`). */
    public boolean isAssembling() {
        return this.inProgress;
    }

    // -- frame intake -------------------------------------------------------

    /**
     * Feed the next decoded [`WsFrame`](WsFrame.cajeta). Returns a
     * finished [`WsMessage`](WsMessage.cajeta) when `frame` completes a
     * message, or `null` when more fragments are still expected (or when
     * `frame` is a control frame — those are passed straight through and
     * never reassembled).
     *
     * Raises a
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta) on
     * an out-of-sequence fragment (RFC 6455 §5.4), or a
     * [`MessageTooLargeException`](MessageTooLargeException.cajeta) when
     * the reassembled total would exceed
     * [`maxMessageLength`](#maxMessageLength).
     */
    public WsMessage accept(WsFrame frame) {
        int32 op = frame.getOpcode();

        // Control frames (close/ping/pong) carry no message data and may
        // interleave between data fragments (RFC 6455 §5.4): pass them
        // through without touching the in-progress message buffer.
        if (WsOpcode.isControl(op)) {
            return null;
        }

        boolean fin = frame.isFin();
        int8[] pay = frame.getPayload();
        int32 payLen = pay.count();

        if (op == WsOpcode.CONTINUATION) {
            // A continuation must follow an opened data frame.
            if (!this.inProgress) {
                throw heap ProtocolViolationException(
                    "continuation frame with no message in progress");
            }
            this.appendPayload(pay, payLen);
            if (fin) {
                return this.finishMessage();
            }
            return null;
        }

        // A data opcode (TEXT or BINARY). The codec has already rejected
        // reserved opcodes, but guard defensively against anything that is
        // neither control, continuation, nor a known data opcode.
        if (!WsOpcode.isData(op)) {
            throw heap ProtocolViolationException(
                "unexpected non-data opcode at message start");
        }

        // A new data frame must not interrupt an open fragmented message
        // (only control frames may interleave) — RFC 6455 §5.4.
        if (this.inProgress) {
            throw heap ProtocolViolationException(
                "new data frame while a fragmented message is in progress");
        }

        if (fin) {
            // Unfragmented single-frame message: validate the size and
            // emit directly, copying the payload so the message owns its
            // own bytes (the frame's payload is dropped with the frame).
            this.checkLimit((int64) payLen);
            int8[] out = new int8[payLen];
            int32 i = 0;
            while (i < payLen) {
                out[i] = pay[i];
                i = i + 1;
            }
            return WsMessage.of(op, #out);
        }

        // First frame of a fragmented message: open assembly.
        this.inProgress = true;
        this.msgOpcode = op;
        this.bufLen = 0;
        this.buf = new int8[0];
        this.appendPayload(pay, payLen);
        return null;
    }

    // -- accumulator --------------------------------------------------------

    /**
     * Append `n` bytes of `pay` to the reassembly buffer, enforcing the
     * per-message cap first, growing the backing store as needed.
     */
    void appendPayload(int8[] pay, int32 n) {
        if (n <= 0) {
            return;
        }
        int64 total = ((int64) this.bufLen) + ((int64) n);
        this.checkLimit(total);
        this.ensureCapacity(this.bufLen + n);
        int32 i = 0;
        while (i < n) {
            this.buf[this.bufLen + i] = pay[i];
            i = i + 1;
        }
        this.bufLen = this.bufLen + n;
    }

    /** Raise if `total` reassembled bytes would exceed the message cap. */
    void checkLimit(int64 total) {
        if (total > this.maxMessage) {
            throw heap MessageTooLargeException(
                "reassembled WebSocket message exceeds the configured maximum",
                this.maxMessage);
        }
    }

    /** Grow [`buf`](#buf) so it holds at least `need` bytes, copying the live prefix. */
    void ensureCapacity(int32 need) {
        int32 cap = this.buf.count();
        if (cap >= need) {
            return;
        }
        int32 newCap = cap * 2;
        if (newCap < 64) {
            newCap = 64;
        }
        while (newCap < need) {
            newCap = newCap * 2;
        }
        int8[] grown = new int8[newCap];
        int32 i = 0;
        while (i < this.bufLen) {
            grown[i] = this.buf[i];
            i = i + 1;
        }
        // `#grown` transfers ownership of the fresh backing store into the
        // field so the local's scope-exit drop doesn't reclaim the array we
        // just installed — the Headers.grow / WsFrameDecoder.growQueue
        // ownership-marker discipline.
        this.buf = #grown;
    }

    /**
     * Snip the exact reassembled bytes out of the (possibly over-allocated)
     * accumulator into an owned message and reset for the next message.
     */
    WsMessage finishMessage() {
        int32 n = this.bufLen;
        int8[] out = new int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.buf[i];
            i = i + 1;
        }
        int32 op = this.msgOpcode;
        // Reset for the next message; drop the spent accumulator.
        this.inProgress = false;
        this.msgOpcode = 0;
        this.bufLen = 0;
        this.buf = new int8[0];
        return WsMessage.of(op, #out);
    }
}
