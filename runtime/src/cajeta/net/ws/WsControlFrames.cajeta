package cajeta.net.ws;

import cajeta.lang.String;

/**
 * The **WebSocket control-frame logic** (RFC 6455 §5.5) — building and
 * interpreting the three control frames (`ping` `0x9`, `pong` `0xA`,
 * `close` `0x8`), plus the two protocol *policies* control frames carry:
 * **auto-pong** (a received ping is answered with a pong echoing its
 * payload) and the **bidirectional close handshake** (an endpoint that
 * receives a close frame replies with its own close, then the connection
 * is torn down). The control-frame deliverable **NET-10.5**, built atop
 * the frame codec ([`WsFrame`](WsFrame.cajeta) /
 * [`WsFrameDecoder`](WsFrameDecoder.cajeta) /
 * [`WsFrameEncoder`](WsFrameEncoder.cajeta), **NET-10.3**).
 *
 * A pure constants + classifiers + factories holder (no instances, no
 * I/O): every method produces or inspects a [`WsFrame`](WsFrame.cajeta) or
 * a [`WsCloseReason`](WsCloseReason.cajeta), so it pins against golden
 * vectors exactly the way the codec does. The async transport
 * ([`AsyncWriter`](../AsyncWriter.cajeta), NET-3.5) serializes the built
 * frame later; the `WebSocket` façade (**NET-10.6**) wires the policy into
 * its read loop (auto-pong unless the app opted to handle pings; the close
 * exchange on a received close).
 *
 * ## Control-frame constraints (RFC 6455 §5.5)
 *
 * Every control frame this layer builds is **unfragmented** (`FIN == 1`)
 * and carries a payload `<= 125` bytes — the codec rejects anything else
 * on decode, and these builders never produce an over-cap or fragmented
 * control frame. A ping or pong MAY carry an arbitrary `<= 125`-byte
 * "application data" payload; a pong sent in reply to a ping MUST echo the
 * ping's payload **identically** (RFC 6455 §5.5.3), which
 * [`pongFor`](#pongFor) does.
 *
 * ## Masking
 *
 * Like every [`WsFrame`](WsFrame.cajeta), a control frame produced here
 * carries the **unmasked** application payload; the masking decision is
 * the encoder's (a client masks, a server does not —
 * [`WsFrameEncoder.encode`](WsFrameEncoder.cajeta)). These builders are
 * therefore direction-agnostic: the same `close(...)`/`ping(...)` serves
 * both ends.
 */
public class WsControlFrames {
    /**
     * The maximum reason-text length (bytes) in a close frame: the
     * `125`-byte control-frame payload cap (RFC 6455 §5.5) minus the
     * 2-byte status code = **123** bytes of UTF-8 reason.
     */
    public static final int32 MAX_CLOSE_REASON = 123;

    // -- ping / pong --------------------------------------------------------

    /**
     * A **ping** frame ([`WsOpcode.PING`](WsOpcode.cajeta), `FIN == 1`)
     * carrying `payload` as its application data. `payload` MUST be `<= 125`
     * bytes (RFC 6455 §5.5) and is **not** copied — the frame takes
     * ownership of it. Pass an empty array for a bare heartbeat ping.
     *
     * Raises [`ProtocolViolationException`](ProtocolViolationException.cajeta)
     * if `payload` exceeds 125 bytes (a control frame cannot be that large),
     * catching the mistake at build time rather than on the wire.
     */
    public static #WsFrame ping(#int8[] payload) {
        WsControlFrames.requireControlPayload(payload.count());
        return WsFrame.of(true, WsOpcode.PING, false, #payload);
    }

    /**
     * A **pong** frame ([`WsOpcode.PONG`](WsOpcode.cajeta), `FIN == 1`)
     * carrying `payload` as its application data, owned by the frame. Used
     * both for an unsolicited pong (a unidirectional heartbeat, RFC 6455
     * §5.5.3) and — via [`pongFor`](#pongFor) — as the auto-pong reply to a
     * ping. `payload` MUST be `<= 125` bytes.
     */
    public static #WsFrame pong(#int8[] payload) {
        WsControlFrames.requireControlPayload(payload.count());
        return WsFrame.of(true, WsOpcode.PONG, false, #payload);
    }

    /**
     * The **auto-pong** reply to a received ping (RFC 6455 §5.5.3): a pong
     * whose payload is a **copy** of the ping's payload, echoed identically.
     * `ping` MUST be a [`WsOpcode.PING`](WsOpcode.cajeta) frame (its opcode
     * is asserted). The ping's payload is *copied* — the caller keeps
     * ownership of the decoded ping frame, and the returned pong owns its
     * own fresh buffer.
     *
     * This is the auto-pong primitive the `WebSocket` read loop
     * (**NET-10.6**) calls for every inbound ping unless the application has
     * opted to handle pings itself.
     *
     * Raises [`ProtocolViolationException`](ProtocolViolationException.cajeta)
     * if `ping` is not a ping frame.
     */
    public static #WsFrame pongFor(WsFrame ping) {
        if (ping.getOpcode() != WsOpcode.PING) {
            throw heap ProtocolViolationException(
                "pongFor requires a ping frame", (int64) -1);
        }
        int8[] src = ping.getPayload();
        int32 n = src.count();
        int8[] echo = heap int8[n];
        int32 i = 0;
        while (i < n) {
            echo[i] = src[i];
            i = i + 1;
        }
        return WsFrame.of(true, WsOpcode.PONG, false, #echo);
    }

    // -- close --------------------------------------------------------------

    /**
     * A **close** frame ([`WsOpcode.CLOSE`](WsOpcode.cajeta), `FIN == 1`)
     * with a 2-byte big-endian status `code` followed by the UTF-8 bytes of
     * `reason` (RFC 6455 §5.5.1). The payload layout is
     * `[code-high][code-low][reason-utf8...]`.
     *
     * `code` MUST be a code an endpoint may transmit
     * ([`WsCloseCode.isSendable`](WsCloseCode.cajeta) — e.g. `1000` normal,
     * not the local-only `1005`/`1006`/`1015`), and the UTF-8 `reason` MUST
     * be `<= 123` bytes so the whole control payload stays within the
     * 125-byte cap. Both are checked, raising
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta) on
     * violation. `reason` is read but not retained (its bytes are copied
     * into the frame payload).
     */
    public static #WsFrame close(int32 code, String reason) {
        if (!WsCloseCode.isSendable(code)) {
            throw heap ProtocolViolationException(
                "close code is not valid to send", (int64) code);
        }
        int32 rLen = 0;
        if (reason != null) {
            rLen = reason.byteLength;
        }
        if (rLen > WsControlFrames.MAX_CLOSE_REASON) {
            throw heap ProtocolViolationException(
                "close reason exceeds 123 bytes", (int64) rLen);
        }
        int8[] pay = heap int8[2 + rLen];
        pay[0] = (int8) ((code >> 8) & 255);
        pay[1] = (int8) (code & 255);
        int32 i = 0;
        while (i < rLen) {
            pay[2 + i] = reason.bytes[i];
            i = i + 1;
        }
        return WsFrame.of(true, WsOpcode.CLOSE, false, #pay);
    }

    /**
     * A close frame carrying a status `code` and **no reason** — the common
     * case (`close(code, "")`). `code` MUST be sendable; see
     * [`close`](#close).
     */
    public static #WsFrame closeCode(int32 code) {
        if (!WsCloseCode.isSendable(code)) {
            throw heap ProtocolViolationException(
                "close code is not valid to send", (int64) code);
        }
        int8[] pay = heap int8[2];
        pay[0] = (int8) ((code >> 8) & 255);
        pay[1] = (int8) (code & 255);
        return WsFrame.of(true, WsOpcode.CLOSE, false, #pay);
    }

    /**
     * An **empty close** frame — a close with no status code and no reason
     * (RFC 6455 §5.5.1 permits a zero-length close payload). A peer parsing
     * it sees [`WsCloseReason.noStatus`](WsCloseReason.cajeta) (`1005`,
     * `hasCode == false`). Useful as the reply when the local side has no
     * specific code to report.
     */
    public static #WsFrame closeEmpty() {
        return WsFrame.of(true, WsOpcode.CLOSE, false, heap int8[0]);
    }

    /**
     * Parse a received **close** frame into its
     * [`WsCloseReason`](WsCloseReason.cajeta) (`{ code, reason }`):
     *
     *   - an **empty** payload → [`WsCloseReason.noStatus`](WsCloseReason.cajeta)
     *     (`1005`, `hasCode == false`, empty reason);
     *   - a **>= 2-byte** payload → the 2-byte big-endian status code + the
     *     remaining bytes as the UTF-8 reason.
     *
     * `frame` MUST be a [`WsOpcode.CLOSE`](WsOpcode.cajeta) frame. A
     * **1-byte** payload is malformed (a status code is a whole 2 bytes,
     * RFC 6455 §5.5.1) and an **on-wire status code that an endpoint MUST
     * NOT send** ([`WsCloseCode.isSendable`](WsCloseCode.cajeta) is `false`
     * — `1005`/`1006`/`1015`, or an unassigned reserved code) is a protocol
     * error: both raise
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta), the
     * fault the close handshake answers with a `1002` close.
     *
     * Note the reason bytes are validated for length only here; UTF-8
     * well-formedness validation is the `WebSocket` layer's concern (a bad
     * UTF-8 reason maps to a `1007` close), kept out of this pure builder.
     */
    public static #WsCloseReason parseClose(WsFrame frame) {
        if (frame.getOpcode() != WsOpcode.CLOSE) {
            throw heap ProtocolViolationException(
                "parseClose requires a close frame", (int64) -1);
        }
        int8[] pay = frame.getPayload();
        int32 n = pay.count();
        if (n == 0) {
            return WsCloseReason.noStatus();
        }
        if (n == 1) {
            throw heap ProtocolViolationException(
                "close payload of 1 byte: status code must be 2 bytes",
                (int64) 1);
        }
        int32 code = ((((int32) pay[0]) & 255) << 8) | (((int32) pay[1]) & 255);
        if (!WsCloseCode.isSendable(code)) {
            throw heap ProtocolViolationException(
                "peer sent a close code it must not transmit", (int64) code);
        }
        int32 rLen = n - 2;
        int8[] rBytes = heap int8[rLen];
        int32 i = 0;
        while (i < rLen) {
            rBytes[i] = pay[2 + i];
            i = i + 1;
        }
        String reason = heap String(#rBytes, rLen);
        return WsCloseReason.of(code, #reason);
    }

    /**
     * The **reciprocal close** frame for the bidirectional close handshake
     * (RFC 6455 §5.5.1): when an endpoint receives a peer's close
     * (`received`), it SHOULD reply with a close frame echoing the same
     * status code. This builds that reply:
     *
     *   - if the peer's close had a real status code
     *     ([`WsCloseReason.hasCode`](WsCloseReason.cajeta)), reply with that
     *     same code and no reason;
     *   - if the peer's close was *empty* (no code), reply with a normal
     *     [`WsCloseCode.NORMAL`](WsCloseCode.cajeta) (`1000`) close — the
     *     conventional acknowledgement of a code-less close.
     *
     * The reply never echoes the peer's *reason* text (a reason is the
     * sender's own free-text and is not mirrored), only the code.
     */
    public static #WsFrame reciprocalClose(WsCloseReason received) {
        if (received.hasCode()) {
            return WsControlFrames.closeCode(received.getCode());
        }
        return WsControlFrames.closeCode(WsCloseCode.NORMAL);
    }

    // -- helpers ------------------------------------------------------------

    /**
     * Assert a control-frame payload length is within the RFC 6455 §5.5
     * 125-byte cap, raising
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta)
     * otherwise. Shared by [`ping`](#ping) / [`pong`](#pong).
     */
    static void requireControlPayload(int32 length) {
        if (length > 125) {
            throw heap ProtocolViolationException(
                "control frame payload exceeds 125 bytes", (int64) length);
        }
    }
}
