package cajeta.net.ws;

/**
 * The **RFC 6455 §5.2 frame opcodes** — the 4-bit operation code that
 * occupies the low nibble of a WebSocket frame's first byte. A pure
 * constants + classifiers holder (no instances), the WS analogue of the
 * `BodyFraming.KIND_*` discriminants the HTTP layer uses.
 *
 * ## The opcode space (RFC 6455 §5.2)
 *
 *   - **`0x0` continuation** — a non-first fragment of a fragmented
 *     message; carries the opcode of the message's first frame
 *     implicitly. A `0x0` as the *first* frame of a message is a
 *     protocol violation (handled at the fragmentation layer, NET-10.4).
 *   - **`0x1` text** — a (possibly fragmented) UTF-8 text message.
 *   - **`0x2` binary** — a (possibly fragmented) binary message.
 *   - **`0x3`–`0x7`** — reserved non-control opcodes (a violation today).
 *   - **`0x8` close** — the close control frame (optional 2-byte close
 *     code + UTF-8 reason).
 *   - **`0x9` ping** / **`0xA` pong** — the heartbeat control frames.
 *   - **`0xB`–`0xF`** — reserved control opcodes (a violation today).
 *
 * ## Control vs. data
 *
 * Opcodes `>= 0x8` are **control** frames; `<= 0x2` are **data** frames.
 * RFC 6455 §5.5 constrains control frames: they MUST NOT be fragmented
 * (`FIN` must be set) and their payload MUST be `<= 125` bytes — the
 * codec ([`WsFrameDecoder`](WsFrameDecoder.cajeta)) enforces both.
 */
public class WsOpcode {
    /** `0x0` — a continuation fragment of a prior data message. */
    public static final int32 CONTINUATION = 0;
    /** `0x1` — a UTF-8 text data frame. */
    public static final int32 TEXT         = 1;
    /** `0x2` — a binary data frame. */
    public static final int32 BINARY       = 2;
    /** `0x8` — the close control frame. */
    public static final int32 CLOSE        = 8;
    /** `0x9` — the ping control frame. */
    public static final int32 PING         = 9;
    /** `0xA` — the pong control frame. */
    public static final int32 PONG         = 10;

    /**
     * `true` if `opcode` is a **control** opcode (`>= 0x8`): close, ping,
     * pong, or a reserved control opcode. Control frames carry protocol
     * signalling, never application message data, and may be interleaved
     * between the fragments of a data message (RFC 6455 §5.4).
     */
    public static boolean isControl(int32 opcode) {
        return opcode >= 8;
    }

    /**
     * `true` if `opcode` is a **data** opcode the codec recognizes:
     * continuation (`0x0`), text (`0x1`), or binary (`0x2`).
     */
    public static boolean isData(int32 opcode) {
        return opcode <= 2;
    }

    /**
     * `true` if `opcode` is a **reserved** (currently undefined) opcode —
     * the non-control range `0x3`–`0x7` and the control range
     * `0xB`–`0xF`. Receiving one is a protocol violation (RFC 6455 §5.2),
     * which the codec rejects with
     * [`ProtocolViolationException`](ProtocolViolationException.cajeta).
     */
    public static boolean isReserved(int32 opcode) {
        if (opcode >= 3 && opcode <= 7) {
            return true;
        }
        if (opcode >= 11 && opcode <= 15) {
            return true;
        }
        return false;
    }
}
