package cajeta.net.ws;

/**
 * The **decision the WebSocket read loop must act on** after the protocol
 * engine ([`WsProtocol`](WsProtocol.cajeta), **NET-10.6**) consumes one
 * decoded [`WsFrame`](WsFrame.cajeta). A pure value type (no I/O): the
 * engine classifies each inbound frame against the RFC 6455 fragmentation
 * (§5.4) + control-frame (§5.5) rules and emits a `WsReadAction` saying
 * **what the transport should do next** — deliver a finished message, write
 * a reply frame, surface a close, or just read more. Keeping the *decision*
 * separate from the *I/O* is what lets the engine pin against golden
 * vectors exactly the way [`WsMessageAssembler`](WsMessageAssembler.cajeta)
 * does, while the [`WebSocket`](WebSocket.cajeta) façade does the actual
 * socket writes.
 *
 * ## The kinds
 *
 *   - [`NONE`](#NONE) — the frame was consumed but produced nothing the
 *     caller must act on (a non-final data fragment buffered, or a `PONG`
 *     swallowed). The read loop simply pulls the next frame.
 *   - [`MESSAGE`](#MESSAGE) — a whole text/binary message reassembled;
 *     [`message`](#message) carries it and [`receive`](WebSocket.cajeta)
 *     returns it to the application.
 *   - [`SEND_FRAME`](#SEND_FRAME) — the engine built a reply frame the loop
 *     must write to the peer under the write lock: an **auto-pong** for an
 *     inbound ping, or the **reciprocal close** that completes the close
 *     handshake. [`frame`](#frame) carries the frame to emit.
 *   - [`PING`](#PING) — an inbound ping the application asked to handle
 *     itself (auto-pong disabled). [`frame`](#frame) carries the ping; the
 *     façade surfaces it (a later sub-phase) or the loop ignores it.
 *   - [`CLOSED`](#CLOSED) — the peer's `CLOSE` was received (and, if the
 *     local side had not already initiated, its reciprocal is in
 *     [`frame`](#frame) to send before tearing down). [`closeReason`](#closeReason)
 *     carries the `{ code, reason }`; the façade raises
 *     [`ConnectionClosedException`](ConnectionClosedException.cajeta) with
 *     that code from `receive`.
 *
 * A `SEND_FRAME` accompanying a `CLOSED` is expressed as `CLOSED` with a
 * non-null [`frame`](#frame): the loop writes the frame (the reciprocal
 * close) *then* reports the close. The engine never needs to both deliver a
 * message and act on a control frame from one decoded frame, so a single
 * discriminant suffices.
 */
public class WsReadAction {
    /** Nothing to surface — buffered a fragment or swallowed a pong. */
    public static final int32 NONE       = 0;
    /** A whole message reassembled — see [`message`](#message). */
    public static final int32 MESSAGE    = 1;
    /** Write [`frame`](#frame) to the peer (auto-pong / reciprocal close). */
    public static final int32 SEND_FRAME = 2;
    /** An inbound ping the app opted to handle — see [`frame`](#frame). */
    public static final int32 PING       = 3;
    /** The peer closed — see [`closeReason`](#closeReason) (+ optional reply [`frame`](#frame)). */
    public static final int32 CLOSED     = 4;

    /** Which kind of action this is (one of the `WsReadAction.*` constants). Field 0. */
    public int32 kind;
    /**
     * The reassembled message for [`MESSAGE`](#MESSAGE); `null` otherwise.
     * Field 1.
     */
    public WsMessage message;
    /**
     * The frame to write for [`SEND_FRAME`](#SEND_FRAME) (an auto-pong or a
     * reciprocal close) or to surface for [`PING`](#PING); `null`
     * otherwise. For [`CLOSED`](#CLOSED) it is the reciprocal close the loop
     * should send before tearing down, or `null` when the local side had
     * already sent its close. Field 2.
     */
    public WsFrame frame;
    /**
     * The parsed `{ code, reason }` for a [`CLOSED`](#CLOSED) action; `null`
     * otherwise. Field 3.
     */
    public WsCloseReason closeReason;

    /**
     * Field-pinning no-arg constructor: a [`NONE`](#NONE) action with all
     * payload references null. The engine builds populated instances; this
     * keeps the layout constructible and free of dangling state.
     */
    public WsReadAction() {
        this.kind = 0;              // NONE
        this.message = null;
        this.frame = null;
        this.closeReason = null;
    }

    /** A [`NONE`](#NONE) action — nothing for the loop to do. */
    public static #WsReadAction none() {
        WsReadAction a = heap WsReadAction();
        a.kind = WsReadAction.NONE;
        return #a;
    }

    /** A [`MESSAGE`](#MESSAGE) action carrying the reassembled `message`. */
    public static #WsReadAction message(#WsMessage message) {
        WsReadAction a = heap WsReadAction();
        a.kind = WsReadAction.MESSAGE;
        a.message = message;
        return #a;
    }

    /** A [`SEND_FRAME`](#SEND_FRAME) action carrying the `frame` to write. */
    public static #WsReadAction sendFrame(#WsFrame frame) {
        WsReadAction a = heap WsReadAction();
        a.kind = WsReadAction.SEND_FRAME;
        a.frame = frame;
        return #a;
    }

    /** A [`PING`](#PING) action carrying the inbound `ping` for the app. */
    public static #WsReadAction ping(#WsFrame ping) {
        WsReadAction a = heap WsReadAction();
        a.kind = WsReadAction.PING;
        a.frame = ping;
        return #a;
    }

    /**
     * A [`CLOSED`](#CLOSED) action: the peer's `reason`, plus the
     * reciprocal close `reply` to send before tearing down (`null` when the
     * local side already initiated the close).
     */
    public static #WsReadAction closed(#WsCloseReason reason, #WsFrame reply) {
        WsReadAction a = heap WsReadAction();
        a.kind = WsReadAction.CLOSED;
        a.closeReason = reason;
        a.frame = reply;
        return #a;
    }

    /** Which kind of action this is. */
    public int32 getKind() {
        return this.kind;
    }

    /** `true` when this delivers a reassembled message. */
    public boolean isMessage() {
        return this.kind == WsReadAction.MESSAGE;
    }

    /** `true` when the loop must write [`frame`](#frame) to the peer. */
    public boolean isSendFrame() {
        return this.kind == WsReadAction.SEND_FRAME;
    }

    /** `true` when the peer closed the connection. */
    public boolean isClosed() {
        return this.kind == WsReadAction.CLOSED;
    }

    /** The reassembled message ([`MESSAGE`](#MESSAGE) only; else `null`). */
    public WsMessage getMessage() {
        return this.message;
    }

    /** The frame to write or surface (else `null`). */
    public WsFrame getFrame() {
        return this.frame;
    }

    /**
     * **Detach** and return the reassembled message, nulling the field so
     * the action no longer aliases the bytes it hands off — the
     * [`WsFrameDecoder.nextFrame`](WsFrameDecoder.cajeta) hand-off
     * discipline. The caller ([`WebSocket.receive`](WebSocket.cajeta)) takes
     * ownership and returns it to the application. `null` if this is not a
     * [`MESSAGE`](#MESSAGE) action.
     */
    public WsMessage takeMessage() {
        WsMessage m = this.message;
        this.message = null;
        return m;
    }

    /**
     * **Detach** and return the frame to write, nulling the field so the
     * action no longer aliases it. The caller writes the frame to the peer.
     * `null` if this action carries no frame.
     */
    public WsFrame takeFrame() {
        WsFrame f = this.frame;
        this.frame = null;
        return f;
    }

    /** The parsed close `{ code, reason }` ([`CLOSED`](#CLOSED) only; else `null`). */
    public WsCloseReason getCloseReason() {
        return this.closeReason;
    }
}
