package cajeta.math;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Workgroup;
import cajeta.xpu.CooperativeMatrix;
import cajeta.xpu.Capability;
import cajeta.xpu.Device;

/**
 * Elementwise GPU lowering for the `Tensor` ufunc surface (numpy-porting-plan
 * Phase 3, deliverable 3f) — a `cajeta.xpu` device kernel plus the portable CPU
 * floor, the two cross-checked (3c). It is the reusable op+lowering pattern every
 * later kernel-expressible phase follows: an op routes on **operand placement** —
 * both tensors on-device → the GPU kernel over their device buffers; otherwise the
 * CPU loop — and a `cajeta.xpu` CPU backend backs the buffer when no GPU is present,
 * so it runs everywhere.
 *
 * The lowering is **per-concrete-dtype**: a generic `@Kernel` does not monomorphize
 * at the launch site (the launch receiver takes no explicit type args, and an
 * inferred generic instantiation lowers to a no-op), so each dtype family member is
 * its own kernel. `float32` is the first member — the workhorse dtype. The generic,
 * broadcasting, dtype-promoting surface stays the `Tensor` CPU binop family; this
 * fast-path requires **equal-shaped** operands (no broadcast, contiguous).
 *
 * `op` selects the arithmetic: `0`=add, `1`=sub, `2`=mul, `3`=div — the same op
 * codes as the CPU `Tensor.binop`, so device and host compute the identical IEEE
 * operation and agree bit-for-bit on the exact ops (and to the last ULP on div).
 */
public final class Ewise {

    /** Fused float32 elementwise-arithmetic kernel: `out[i] = a[i] <op> b[i]`. */
    @Kernel
    public static void arithF32(KernelBuffer<float32> out, KernelBuffer<float32> a,
                                KernelBuffer<float32> b, uint32 n, int32 op) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            float32 va = a[i];
            float32 vb = b[i];
            float32 vc = va + vb;
            if (op == 1) { vc = va - vb; }
            if (op == 2) { vc = va * vb; }
            if (op == 3) { vc = va / vb; }
            out[i] = vc;
        }
    }

    /**
     * Elementwise arithmetic on two equal-shaped `float32` tensors, routed on
     * placement: both on-device → the {@link #arithF32} GPU kernel; otherwise the
     * CPU loop. Returns a fresh C-order `float32` tensor (on the device when the
     * GPU path ran — call {@code cpu()} to read it on the host). `op`: 0=add,
     * 1=sub, 2=mul, 3=div.
     */
    public static #Tensor<float32> arithF32Op(Tensor<float32> a, Tensor<float32> b, int32 op) {
        Tensor<float32> out #= Tensor.zerosLike<float32>(a);
        int64 n = a.size();
        if (Placement.pair("arith", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            arithF32.launch(s, grid: [(un + 63) / 64], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), un, op);
            s.sync();
        } else {
            int64 i = 0;
            while (i < n) {
                float32 va = a.flatGet(i);
                float32 vb = b.flatGet(i);
                float32 vc = va + vb;
                if (op == 1) { vc = va - vb; }
                if (op == 2) { vc = va * vb; }
                if (op == 3) { vc = va / vb; }
                out.flatSet(i, vc);
                i = i + 1;
            }
        }
        return #out;
    }

    /** {@link #arithF32} at **float16** storage (cajeta-llama 2.2.2): `out[i] = a[i] <op> b[i]`, computed and stored at f16 — elementwise has no accumulation, so the storage dtype is the honest compute dtype. */
    @Kernel
    public static void arithF16(KernelBuffer<float16> out, KernelBuffer<float16> a,
                                KernelBuffer<float16> b, uint32 n, int32 op) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            float16 va = a[i];
            float16 vb = b[i];
            float16 vc = va + vb;
            if (op == 1) { vc = va - vb; }
            if (op == 2) { vc = va * vb; }
            if (op == 3) { vc = va / vb; }
            out[i] = vc;
        }
    }

    /** {@link #arithF32} at **bfloat16** storage (cajeta-llama 2.2.2). */
    @Kernel
    public static void arithBf16(KernelBuffer<bfloat16> out, KernelBuffer<bfloat16> a,
                                 KernelBuffer<bfloat16> b, uint32 n, int32 op) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            bfloat16 va = a[i];
            bfloat16 vb = b[i];
            bfloat16 vc = va + vb;
            if (op == 1) { vc = va - vb; }
            if (op == 2) { vc = va * vb; }
            if (op == 3) { vc = va / vb; }
            out[i] = vc;
        }
    }

    /**
     * Elementwise arithmetic on two equal-shaped `float16` tensors — {@link #arithF32Op}
     * at f16, through the {@link #arithF16} kernel. Same placement routing and op codes.
     */
    public static #Tensor<float16> arithF16Op(Tensor<float16> a, Tensor<float16> b, int32 op) {
        Tensor<float16> out #= Tensor.zerosLike<float16>(a);
        int64 n = a.size();
        if (Placement.pair("arithF16", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            arithF16.launch(s, grid: [(un + 63) / 64], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), un, op);
            s.sync();
        } else {
            int64 i = 0;
            while (i < n) {
                float16 va = a.flatGet(i);
                float16 vb = b.flatGet(i);
                float16 vc = va + vb;
                if (op == 1) { vc = va - vb; }
                if (op == 2) { vc = va * vb; }
                if (op == 3) { vc = va / vb; }
                out.flatSet(i, vc);
                i = i + 1;
            }
        }
        return #out;
    }

    /** {@link #arithF16Op} at **bfloat16**, through the {@link #arithBf16} kernel. */
    public static #Tensor<bfloat16> arithBf16Op(Tensor<bfloat16> a, Tensor<bfloat16> b, int32 op) {
        Tensor<bfloat16> out #= Tensor.zerosLike<bfloat16>(a);
        int64 n = a.size();
        if (Placement.pair("arithBf16", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            arithBf16.launch(s, grid: [(un + 63) / 64], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), un, op);
            s.sync();
        } else {
            int64 i = 0;
            while (i < n) {
                bfloat16 va = a.flatGet(i);
                bfloat16 vb = b.flatGet(i);
                bfloat16 vc = va + vb;
                if (op == 1) { vc = va - vb; }
                if (op == 2) { vc = va * vb; }
                if (op == 3) { vc = va / vb; }
                out.flatSet(i, vc);
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * Atomic parallel-sum reduction kernel: every thread adds its element into the
     * single accumulator `out[0]` via `atomicAdd` (numpy-porting Phase 4, 4e — the
     * GPU reduction primitive; the cajeta.xpu CPU backend lowers it to a native
     * atomic RMW). The accumulator must be pre-zeroed.
     */
    @Kernel
    public static void reduceSumF32(KernelBuffer<float32> out, KernelBuffer<float32> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicAdd(0, in[i]); }
    }

    /**
     * Full-array sum of a **contiguous** `float32` tensor, routed on placement: when
     * on-device → the {@link #reduceSumF32} atomic GPU reduction over a 1-element
     * accumulator; otherwise the CPU loop. The two agree (the Phase-4 reduction
     * cross-check). Sum is exact (order-independent) for integer-valued floats whose
     * total stays below 2^24, so the atomic order does not perturb agreement there.
     */
    public static float32 sumF32(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);   // accumulator out[0] = 0
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceSumF32.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return acc.get1(0);
        }
        float32 sum = 0.0f;
        int64 i = 0;
        while (i < n) {
            sum = sum + t.flatGet(i);
            i = i + 1;
        }
        return sum;
    }

    /**
     * Sum-reduction over **float16** storage into a **float32** accumulator
     * (cajeta-llama 2.2.2 / 2.1.4 on the device path): each element widens to f32
     * before the atomic add, so the accumulator never stalls at f16's 2^11
     * integer ceiling. The accumulator buffer is f32 by signature — the width is
     * stated, not incidental (2.3.2).
     */
    @Kernel
    public static void reduceSumF16(KernelBuffer<float32> out, KernelBuffer<float16> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicAdd(0, (float32) in[i]); }
    }

    /** {@link #reduceSumF16} at **bfloat16** storage — same f32 accumulator. */
    @Kernel
    public static void reduceSumBf16(KernelBuffer<float32> out, KernelBuffer<bfloat16> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicAdd(0, (float32) in[i]); }
    }

    /**
     * Full-array sum of a contiguous `float16` tensor, returning **float32** —
     * {@link #sumF32} at f16 storage, through the {@link #reduceSumF16} widening
     * reduction on the device path; the CPU floor accumulates at f32 for the same
     * numerics.
     */
    public static float32 sumF16(Tensor<float16> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceSumF16.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return acc.get1(0);
        }
        float32 sum = 0.0f;
        int64 i = 0;
        while (i < n) {
            sum = sum + (float32) t.flatGet(i);
            i = i + 1;
        }
        return sum;
    }

    /** {@link #sumF16} at **bfloat16** storage, through {@link #reduceSumBf16}. */
    public static float32 sumBf16(Tensor<bfloat16> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceSumBf16.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return acc.get1(0);
        }
        float32 sum = 0.0f;
        int64 i = 0;
        while (i < n) {
            sum = sum + (float32) t.flatGet(i);
            i = i + 1;
        }
        return sum;
    }

    /** Min-reduction kernel: `out[0] = min(out[0], in[i])` via a float atomic-min. */
    @Kernel
    public static void reduceMinF32(KernelBuffer<float32> out, KernelBuffer<float32> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicMin(0, in[i]); }
    }

    /** Max-reduction kernel: `out[0] = max(out[0], in[i])` via a float atomic-max. */
    @Kernel
    public static void reduceMaxF32(KernelBuffer<float32> out, KernelBuffer<float32> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicMax(0, in[i]); }
    }

    /**
     * Full-array minimum of a contiguous `float32` tensor, routed on placement: on-device
     * → the {@link #reduceMinF32} atomic-min reduction (accumulator seeded to `+FLT_MAX`
     * so it's order-independent); otherwise the CPU loop. The Phase-4 min/max cross-check.
     * (The seed is a large sentinel — valid for data within `±3.4e38`.)
     */
    public static float32 minF32(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);
            acc.set1(0, 3.4e38f);                      // +FLT_MAX sentinel
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceMinF32.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return acc.get1(0);
        }
        float32 m = t.flatGet(0);
        int64 i = 1;
        while (i < n) {
            float32 v = t.flatGet(i);
            if (v < m) { m = v; }
            i = i + 1;
        }
        return m;
    }

    /** Full-array maximum (companion to {@link #minF32}; accumulator seeded to `-FLT_MAX`). */
    public static float32 maxF32(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);
            acc.set1(0, -3.4e38f);                     // -FLT_MAX sentinel
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceMaxF32.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return acc.get1(0);
        }
        float32 m = t.flatGet(0);
        int64 i = 1;
        while (i < n) {
            float32 v = t.flatGet(i);
            if (v > m) { m = v; }
            i = i + 1;
        }
        return m;
    }

    /**
     * Gather kernel: `out[i] = in[idx[i]]` (numpy-porting Phase 5, 5e — the GPU
     * indexing primitive; each thread reads one source element through its index).
     */
    @Kernel
    public static void gatherF32(KernelBuffer<float32> out, KernelBuffer<float32> in,
                                 KernelBuffer<int64> idx, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[i] = in[idx[i]]; }
    }

    /**
     * Gather along axis 0 of a **contiguous** `float32` tensor by an index tensor
     * (numpy `take`), routed on placement: both on-device → the {@link #gatherF32}
     * GPU kernel; otherwise the CPU loop. The two agree (the Phase-5 indexing
     * cross-check). Returns a 1-D `float32` tensor of length `idx.size()`.
     */
    public static #Tensor<float32> takeF32(Tensor<float32> t, Tensor<int64> idx) {
        int64 m = idx.size();
        int64[] os = heap int64[1];
        os[0] = m;
        Tensor<float32> out #= Tensor.zeros<float32>(os);
        if (Placement.pair("take", "t", t.isOnGpu(), "idx", idx.isOnGpu())) {
            out.gpu();
            uint32 um = (uint32) m;
            KernelStream s #= KernelStream.current();
            gatherF32.launch(s, grid: [(um + 63) / 64], block: [64])
                (out.deviceBuffer(), t.deviceBuffer(), idx.deviceBuffer(), um);
            s.sync();
        } else {
            int64 i = 0;
            while (i < m) {
                out.flatSet(i, t.flatGet(idx.flatGet(i)));
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * Scatter kernel: `out[idx[i]] = in[i]` (numpy-porting Phase 5, 5e — the inverse of
     * {@link #gatherF32}; each thread writes one source element to its target slot).
     * Indices must be distinct (no two threads write the same slot) for a defined result.
     */
    @Kernel
    public static void scatterF32(KernelBuffer<float32> out, KernelBuffer<float32> in,
                                  KernelBuffer<int64> idx, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[idx[i]] = in[i]; }
    }

    /**
     * Scatter `values` into a fresh length-`outLen` `float32` tensor at positions `idx`
     * (`out[idx[i]] = values[i]`; unwritten slots stay 0), routed on placement: both
     * on-device → the {@link #scatterF32} GPU kernel; otherwise the CPU loop. The two
     * agree (the Phase-5 scatter cross-check). Indices are assumed distinct.
     */
    public static #Tensor<float32> scatterF32Op(Tensor<float32> values, Tensor<int64> idx, int64 outLen) {
        int64 m = values.size();
        int64[] os = heap int64[1];
        os[0] = outLen;
        Tensor<float32> out #= Tensor.zeros<float32>(os);
        if (Placement.pair("scatter", "values", values.isOnGpu(), "idx", idx.isOnGpu())) {
            out.gpu();                                 // uploads the zero-init buffer
            uint32 um = (uint32) m;
            KernelStream s #= KernelStream.current();
            scatterF32.launch(s, grid: [(um + 63) / 64], block: [64])
                (out.deviceBuffer(), values.deviceBuffer(), idx.deviceBuffer(), um);
            s.sync();
        } else {
            int64 i = 0;
            while (i < m) {
                out.flatSet(idx.flatGet(i), values.flatGet(i));
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * Bincount kernel: `counts[vals[i]] += 1` via an atomic scatter (numpy-porting
     * Phase 10 — the atomic-scatter primitive; concurrent threads hitting the same
     * bin serialize through the atomic RMW, so the result is order-independent).
     */
    @Kernel
    public static void bincountI32(KernelBuffer<int32> counts, KernelBuffer<int64> vals, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { counts.atomicAdd(vals[i], 1); }
    }

    /**
     * Count occurrences of each value in `[0, outLen)` of a non-negative `int64` tensor
     * (numpy `bincount`) into an `int32` histogram, routed on placement: on-device → the
     * {@link #bincountI32} atomic scatter; otherwise the CPU loop. The two agree (the
     * Phase-10 atomic-scatter cross-check) — the atomic makes concurrent same-bin
     * increments order-independent. Counts are `int32` (integer atomics are int32/uint32).
     */
    public static #Tensor<int32> bincountI32Op(Tensor<int64> t, int64 outLen) {
        int64[] os = heap int64[1];
        os[0] = outLen;
        Tensor<int32> counts #= Tensor.zeros<int32>(os);
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            counts.gpu();                              // uploads the zero-init histogram
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            bincountI32.launch(s, grid: [(un + 63) / 64], block: [64])
                (counts.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
        } else {
            int64 i = 0;
            while (i < n) {
                int64 v = t.flatGet(i);
                int32 cur = counts.flatGet(v);
                counts.flatSet(v, cur + 1);
                i = i + 1;
            }
        }
        return #counts;
    }

    /**
     * Copy an `(irows, icols)` matrix into the top-left corner of an
     * `(orows, ocols)` one, zero-filling the rest (spec §2.6 support). The tiled
     * GEMM below owns whole 16x16 tiles, so a ragged shape is squared up here
     * rather than by teaching every tile load a bounds check: zeros contribute
     * nothing to a dot product, so the padded product's leading `(m, n)` block is
     * exactly the unpadded answer.
     */
    @Kernel
    public static void padF32(KernelBuffer<float32> out, KernelBuffer<float32> in,
                              uint32 orows, uint32 ocols, uint32 irows, uint32 icols) {
        uint32 i = KernelThread.globalIdX();
        if (i < orows * ocols) {
            uint32 r = i / ocols;
            uint32 c = i % ocols;
            float32 v = 0.0f;
            if (r < irows) {
                if (c < icols) { v = in[r * icols + c]; }
            }
            out[i] = v;
        }
    }

    /**
     * The inverse of {@link #padF32}: copy the leading `(orows, ocols)` block out of
     * a matrix whose row stride is `icols`.
     */
    @Kernel
    public static void cropF32(KernelBuffer<float32> out, KernelBuffer<float32> in,
                               uint32 orows, uint32 ocols, uint32 icols) {
        uint32 i = KernelThread.globalIdX();
        if (i < orows * ocols) {
            uint32 r = i / ocols;
            uint32 c = i % ocols;
            out[i] = in[r * icols + c];
        }
    }

    /**
     * {@link #padF32} at float16 — the ragged f16 device GEMM's square-up
     * (cajeta-llama 2.2.5). Only the OPERANDS need an f16 pad: the f16 GEMM's
     * output buffer is float32 (the accumulator's dtype), so its crop-back is
     * {@link #cropF32}.
     */
    @Kernel
    public static void padF16(KernelBuffer<float16> out, KernelBuffer<float16> in,
                              uint32 orows, uint32 ocols, uint32 irows, uint32 icols) {
        uint32 i = KernelThread.globalIdX();
        if (i < orows * ocols) {
            uint32 r = i / ocols;
            uint32 c = i % ocols;
            float16 v = (float16) 0.0;
            if (r < irows) {
                if (c < icols) { v = in[r * icols + c]; }
            }
            out[i] = v;
        }
    }

    /** {@link #padF32} at bfloat16 (cajeta-llama 2.2.5). */
    @Kernel
    public static void padBf16(KernelBuffer<bfloat16> out, KernelBuffer<bfloat16> in,
                               uint32 orows, uint32 ocols, uint32 irows, uint32 icols) {
        uint32 i = KernelThread.globalIdX();
        if (i < orows * ocols) {
            uint32 r = i / ocols;
            uint32 c = i % ocols;
            bfloat16 v = (bfloat16) 0.0;
            if (r < irows) {
                if (c < icols) { v = in[r * icols + c]; }
            }
            out[i] = v;
        }
    }

    /**
     * {@link #cropF32} at bfloat16 — the crop-back for the ragged ALL-bf16
     * GEMM, whose padded product carries the bf16 accumulator dtype
     * (cajeta-llama 2.2.5).
     */
    @Kernel
    public static void cropBf16(KernelBuffer<bfloat16> out, KernelBuffer<bfloat16> in,
                                uint32 orows, uint32 ocols, uint32 icols) {
        uint32 i = KernelThread.globalIdX();
        if (i < orows * ocols) {
            uint32 r = i / ocols;
            uint32 c = i % ocols;
            out[i] = in[r * icols + c];
        }
    }

    /**
     * Tiled float32 GEMM `C = A·B` on the matrix cores (numpy-porting Phase 6, 6e
     * — the `matmul` GPU lowering). Each workgroup owns one 16x16 output tile,
     * decoded from {@link Workgroup#x()}: zero an accumulator tile, then K-loop
     * one `mma` per 16-wide depth slice — the canonical {@link CooperativeMatrix}
     * matmul. `rows`/`cols`/`depth` (M/N/K) must be multiples of 16. float32 has no
     * native matrix-core config, so it takes the **portable software tile-matmul
     * tier** (a `note: [mma-tiering]`) — bit-identical to the CPU floor, and the
     * SAME kernel auto-promotes to the hardware cores for the configs a backend
     * exposes (f16/bf16/int8 WMMA on AMD). [[cajeta-kernel-no-generic-monomorph]]
     */
    @Kernel
    public static void matmulF32(KernelBuffer<float32> c, KernelBuffer<float32> a,
                                 KernelBuffer<float32> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;          // output row-tile
        uint32 nj = wid % ntiles;          // output col-tile
        uint32 ktiles = depth / 16;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<float32,16,16,0> ma;
        CooperativeMatrix<float32,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);   // A tile (mi,kk), stride K
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);     // B tile (kk,nj), stride N
            mc.mma(ma, mb);                                     // C += A_k · B_k
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * 2-D float32 matrix product `(m,k)·(k,n) → (m,n)`, routed on placement: both
     * on-device → the {@link #matmulF32} cooperative-matrix tiled GEMM (one
     * workgroup per 16x16 output tile); otherwise the CPU triple-loop floor. The
     * two agree (the Phase-6 contraction cross-check), and the device result equals
     * the generic {@link Tensor#matmul} floor. The GPU path requires `m`/`n`/`k`
     * to be multiples of 16 (the tile size); the CPU path has no such restriction.
     * Returns a fresh C-order `float32` tensor (on the device when the GPU path ran
     * — call `cpu()` to read it on the host).
     */
    public static #Tensor<float32> matmulF32Op(Tensor<float32> a, Tensor<float32> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<float32> out #= Tensor.zeros<float32>(shp);
        if (Placement.pair("matmulF32", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            Ewise.matmulF32Into(out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), m, n, k);
        } else {
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    float32 acc = 0.0f;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + a.get2(i, p) * b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, acc);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * The device GEMM, writing into a **caller-provided** output buffer (spec §2.1).
     *
     * A kernel can only be launched from the class that declares it (`XPU-N02`), so
     * the launches have to live here. Taking the destination as a `KernelBuffer`
     * rather than returning a fresh `Tensor<float32>` is what lets a dtype-generic
     * caller — `Tensor.matmul<E>` — allocate its own `Tensor<E>`, hand over its
     * buffer, and never have to retype a foreign result on the way back. Retyping an
     * owned result is the hazard that sinks the obvious alternative: every rebuild
     * helper produces a `markSharedView` handle, so the source tensor's drop would
     * free the buffer out from under it.
     *
     * Handles ragged shapes by padding (see {@link #padF32}); tile-aligned shapes
     * take the single-launch path.
     */
    public static void matmulF32Into(KernelBuffer<float32> c, KernelBuffer<float32> a,
                                     KernelBuffer<float32> b, int64 m, int64 n, int64 k) {
            KernelStream s #= KernelStream.current();
            int64 mp = ((m + 15) / 16) * 16;
            int64 np = ((n + 15) / 16) * 16;
            int64 kp = ((k + 15) / 16) * 16;
            if (mp == m && np == n && kp == k) {
                uint32 um = (uint32) m;
                uint32 un = (uint32) n;
                uint32 uk = (uint32) k;
                matmulF32.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                    (c, a, b, um, un, uk);
                s.sync();
            } else {
                // Ragged shape (spec §2.6). The kernel owns whole 16x16 tiles and
                // truncates on every dimension — grid drops the partial row/col
                // tiles and the K-loop drops the partial depth slice — so a 17x17
                // multiply would silently compute a 16x16 one. Square the operands
                // up with zero padding, multiply, crop back.
                int64[] ashp = heap int64[2];
                ashp[0] = mp;
                ashp[1] = kp;
                Tensor<float32> ap #= Tensor.zeros<float32>(ashp);
                ap.gpu();
                int64[] bshp = heap int64[2];
                bshp[0] = kp;
                bshp[1] = np;
                Tensor<float32> bp #= Tensor.zeros<float32>(bshp);
                bp.gpu();
                int64[] cshp = heap int64[2];
                cshp[0] = mp;
                cshp[1] = np;
                Tensor<float32> cp #= Tensor.zeros<float32>(cshp);
                cp.gpu();
                uint32 ump = (uint32) mp;
                uint32 unp = (uint32) np;
                uint32 ukp = (uint32) kp;
                uint32 um = (uint32) m;
                uint32 un = (uint32) n;
                uint32 uk = (uint32) k;
                uint32 an = ump * ukp;
                padF32.launch(s, grid: [(an + 63) / 64], block: [64])
                    (ap.deviceBuffer(), a, ump, ukp, um, uk);
                uint32 bn = ukp * unp;
                padF32.launch(s, grid: [(bn + 63) / 64], block: [64])
                    (bp.deviceBuffer(), b, ukp, unp, uk, un);
                s.sync();
                matmulF32.launch(s, grid: [(ump / 16) * (unp / 16)], block: [64])
                    (cp.deviceBuffer(), ap.deviceBuffer(), bp.deviceBuffer(), ump, unp, ukp);
                s.sync();
                uint32 on = um * un;
                cropF32.launch(s, grid: [(on + 63) / 64], block: [64])
                    (c, cp.deviceBuffer(), um, un, unp);
                s.sync();
            }
    }

    /**
     * Tiled **float64** GEMM — the {@link #matmulF32} cooperative-matrix kernel replicated
     * for a second dtype (numpy-porting Phase 6.6, coop GEMM non-f32). The software
     * cooperative-matrix tier is dtype-generic, so the same 16x16 tile / K-loop `mma`
     * structure lowers for `float64` (a `note: [mma-tiering]` since f64 has no native
     * config). `rows`/`cols`/`depth` multiples of 16.
     */
    @Kernel
    public static void matmulF64(KernelBuffer<float64> c, KernelBuffer<float64> a,
                                 KernelBuffer<float64> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid % ntiles;
        uint32 ktiles = depth / 16;
        CooperativeMatrix<float64,16,16,2> mc;
        mc.splat(0.0);
        CooperativeMatrix<float64,16,16,0> ma;
        CooperativeMatrix<float64,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);
            mc.mma(ma, mb);
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * 2-D **float64** matrix product routed on placement: both on-device → the
     * {@link #matmulF64} coop GEMM; otherwise the CPU triple-loop. Agrees with the generic
     * {@link Tensor#matmul} float64 floor (Phase-6.6 non-f32 coop cross-check). GPU path
     * needs `m`/`n`/`k` multiples of 16.
     */
    public static #Tensor<float64> matmulF64Op(Tensor<float64> a, Tensor<float64> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<float64> out #= Tensor.zeros<float64>(shp);
        if (Placement.pair("matmulF64", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            KernelStream s #= KernelStream.current();
            matmulF64.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), um, un, uk);
            s.sync();
        } else {
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    float64 acc = 0.0;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + a.get2(i, p) * b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, acc);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * Tiled **float16** GEMM with a **float32 accumulator** (cajeta-llama 2.2.2).
     * Same 16x16 tile / K-loop `mma` structure as {@link #matmulF32}, but the
     * operand tiles are `float16` while the accumulator tile is `float32` — the
     * matrix-core shape the hardware exposes (f16 WMMA is a native config on AMD,
     * so this kernel takes the hardware tier where {@link #matmulF32} takes the
     * software one; on backends with no native config it tiers to software and
     * still agrees). The output buffer is `float32` because `store` writes the
     * accumulator's dtype: the device produces f32, and narrowing back to f16 is
     * the caller's explicit choice rather than a loss baked into the GEMM.
     * `rows`/`cols`/`depth` multiples of 16.
     */
    @Kernel
    public static void matmulF16(KernelBuffer<float32> c, KernelBuffer<float16> a,
                                 KernelBuffer<float16> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid % ntiles;
        uint32 ktiles = depth / 16;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<float16,16,16,0> ma;
        CooperativeMatrix<float16,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);
            mc.mma(ma, mb);
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * The {@link #matmulF16} GEMM at **bfloat16** (cajeta-llama 2.2.3) — but with a
     * **bfloat16 accumulator**, unlike f16's f32 one. A coverage choice, not a
     * numerics one: with an f32 accumulator this kernel is mixed-tier wherever
     * bf16 A/B has no native config — no Vulkan driver exposes one — so on
     * SPIR-V it would take the `[xpu-kernel-skipped]` note and leave Vulkan-only
     * machines with no bf16 device path at all. All-bf16 stays one tier where
     * coverage matters: portable, and working, on Vulkan and CPU. The flip
     * side: NVIDIA and AMD have bf16 as a native OPERAND tile only — their
     * native accumulator sets are f32/i32 (`NvptxKernelLowering` /
     * `AmdgpuKernelLowering` `.coopMatrixTier`) — so THERE this kernel is the
     * mixed-tier one and takes the skip note (observed on the WSL/NVIDIA runner
     * 2026-08-10), the same standing situation as {@link #matmulF32} on those
     * backends. The bf16-operand/f32-accumulator shape is native silicon on
     * both — its NVPTX lowering abort is fixed
     * (specs/nvptx-coop-bf16-fragment-abort, PR #3) — but has no Vulkan device
     * path; the per-backend split LANDED as plan 2.2.6: {@link #matmulBf16Op}
     * routes to {@link #matmulBf16Wide} wherever
     * `Capability.CoopMatrixBf16F32Acc` reports launchable, so this kernel now
     * runs only where that answers false (Vulkan). The cost, stated per
     * 2.3.2: the portable tier accumulates at bf16 per K-step (8 mantissa
     * bits), so large-K products of inexact values round harder than
     * {@link #matmulF16}'s — callers needing a wide accumulator at bf16 storage
     * should widen to f32 and use {@link #matmulF32}.
     */
    @Kernel
    public static void matmulBf16(KernelBuffer<bfloat16> c, KernelBuffer<bfloat16> a,
                                  KernelBuffer<bfloat16> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid % ntiles;
        uint32 ktiles = depth / 16;
        CooperativeMatrix<bfloat16,16,16,2> mc;
        mc.splat((bfloat16) 0.0);
        CooperativeMatrix<bfloat16,16,16,0> ma;
        CooperativeMatrix<bfloat16,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);
            mc.mma(ma, mb);
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * The bf16(A/B) + **float32 accumulator** GEMM — cajeta-llama 2.2.6, the
     * shape that is native silicon on NVIDIA sm_80+ and AMD RDNA3+ (its NVPTX
     * bf16 fragment-layout abort is fixed: specs/nvptx-coop-bf16-fragment-abort,
     * cajeta PR #3). No Vulkan driver exposes a bf16 coop-matrix config, so the
     * SPIR-V lowering SKIPS this kernel (mixed-tier) — every dispatch is gated
     * on `Device.supports(Capability.CoopMatrixBf16F32Acc)`, which answers
     * false exactly where the skip happened. The CPU software tier runs the
     * mix (and answers true), which is what gives the wide path its in-process
     * test coverage. Output buffer is float32 — `store` writes the
     * accumulator's dtype. `rows`/`cols`/`depth` multiples of 16.
     */
    @Kernel
    public static void matmulBf16Wide(KernelBuffer<float32> c, KernelBuffer<bfloat16> a,
                                      KernelBuffer<bfloat16> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid % ntiles;
        uint32 ktiles = depth / 16;
        CooperativeMatrix<float32,16,16,2> mc;
        mc.splat(0.0f);
        CooperativeMatrix<bfloat16,16,16,0> ma;
        CooperativeMatrix<bfloat16,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);
            mc.mma(ma, mb);
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * Tiled **int8 → int32** GEMM (cajeta-llama 18.2.3): int8 A/B operand
     * tiles with an int32 accumulator — the quantized-weight compute shape
     * (spec §10: sub-byte formats unpack to int8 and multiply THERE). Native
     * on RDNA3 (`v_wmma_i32_16x16x16_iu8`); the portable software tier runs
     * it everywhere else, bit-identically — integer accumulation has no
     * rounding to diverge on, so tiers agree EXACTLY, not within tolerance.
     * `rows`/`cols`/`depth` multiples of 16.
     */
    @Kernel
    public static void matmulI8(KernelBuffer<int32> c, KernelBuffer<int8> a,
                                KernelBuffer<int8> b, uint32 rows, uint32 cols, uint32 depth) {
        uint32 ntiles = cols / 16;
        uint32 wid = Workgroup.x();
        uint32 mi = wid / ntiles;
        uint32 nj = wid % ntiles;
        uint32 ktiles = depth / 16;
        CooperativeMatrix<int32,16,16,2> mc;
        mc.splat(0);
        CooperativeMatrix<int8,16,16,0> ma;
        CooperativeMatrix<int8,16,16,1> mb;
        uint32 kk = 0;
        while (kk < ktiles) {
            ma.load(a, mi * 16 * depth + kk * 16, 0, depth);
            mb.load(b, kk * 16 * cols + nj * 16, 0, cols);
            mc.mma(ma, mb);
            kk = kk + 1;
        }
        mc.store(c, mi * 16 * cols + nj * 16, 0, cols);
    }

    /**
     * 2-D int8 matrix product returning **int32**, routed on placement:
     * both on-device and 16-aligned → the {@link #matmulI8} coop GEMM;
     * otherwise the CPU triple-loop floor at int32. Integer math: floor and
     * every tier agree bit-for-bit (cajeta-llama 18.1.8).
     */
    public static #Tensor<int32> matmulI8Op(Tensor<int8> a, Tensor<int8> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<int32> out #= Tensor.zeros<int32>(shp);
        boolean aligned = (m % 16 == 0) && (n % 16 == 0) && (k % 16 == 0);
        boolean onDevice = Placement.pair("matmulI8", "a", a.isOnGpu(), "b", b.isOnGpu());
        if (onDevice && aligned) {
            out.gpu();
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            KernelStream s #= KernelStream.current();
            matmulI8.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), um, un, uk);
            s.sync();
        } else {
            boolean staged = onDevice;   // ragged int8 stays on the floor (no pad family yet)
            if (staged) { a.cpu(); b.cpu(); }
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    int32 acc = 0;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + (int32) a.get2(i, p) * (int32) b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, acc);
                    j = j + 1;
                }
                i = i + 1;
            }
            if (staged) { a.gpu(); b.gpu(); }
        }
        return #out;
    }

    /**
     * Elementwise narrow, float32 → bfloat16 — the wide GEMM's device result
     * back to the storage dtype (cajeta-llama 2.2.6): ONE rounding at the
     * store, the same numerics as the CPU floor's accumulate-wide/narrow-once.
     */
    @Kernel
    public static void narrowF32ToBf16(KernelBuffer<bfloat16> out, KernelBuffer<float32> in,
                                       uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            out[i] = (bfloat16) in[i];
        }
    }

    /**
     * 2-D **float16** matrix product `(m,k)·(k,n) → (m,n)`, returning **float32**
     * (the accumulator's dtype — see {@link #matmulF16}), routed on placement:
     * both on-device and 16-aligned → the {@link #matmulF16} coop GEMM; otherwise
     * the CPU triple-loop floor, which accumulates at `float32` for the same
     * numerics (cajeta-llama 2.1.4). Ragged on-device shapes square up with
     * zero padding on the device, multiply, and crop back (plan 2.2.5, the
     * {@link #matmulF32Into} recipe) — never a silent tile truncation
     * (spec §2.6).
     */
    public static #Tensor<float32> matmulF16Op(Tensor<float16> a, Tensor<float16> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<float32> out #= Tensor.zeros<float32>(shp);
        boolean aligned = (m % 16 == 0) && (n % 16 == 0) && (k % 16 == 0);
        boolean onDevice = Placement.pair("matmulF16", "a", a.isOnGpu(), "b", b.isOnGpu());
        if (onDevice && aligned) {
            out.gpu();
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            KernelStream s #= KernelStream.current();
            matmulF16.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), um, un, uk);
            s.sync();
        } else if (onDevice) {
            // Ragged on-device shape (2.2.5): pad operands to 16-multiples on
            // the device, multiply, crop the leading (m, n) block back. The
            // padded product is float32 — the accumulator/output dtype — so
            // the crop is cropF32; only the operands need the f16 pad.
            out.gpu();
            KernelStream s #= KernelStream.current();
            int64 mp = ((m + 15) / 16) * 16;
            int64 np = ((n + 15) / 16) * 16;
            int64 kp = ((k + 15) / 16) * 16;
            int64[] ashp = heap int64[2];
            ashp[0] = mp;
            ashp[1] = kp;
            Tensor<float16> ap #= Tensor.zeros<float16>(ashp);
            ap.gpu();
            int64[] bshp = heap int64[2];
            bshp[0] = kp;
            bshp[1] = np;
            Tensor<float16> bp #= Tensor.zeros<float16>(bshp);
            bp.gpu();
            int64[] cshp = heap int64[2];
            cshp[0] = mp;
            cshp[1] = np;
            Tensor<float32> cp #= Tensor.zeros<float32>(cshp);
            cp.gpu();
            uint32 ump = (uint32) mp;
            uint32 unp = (uint32) np;
            uint32 ukp = (uint32) kp;
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            uint32 an = ump * ukp;
            padF16.launch(s, grid: [(an + 63) / 64], block: [64])
                (ap.deviceBuffer(), a.deviceBuffer(), ump, ukp, um, uk);
            uint32 bn = ukp * unp;
            padF16.launch(s, grid: [(bn + 63) / 64], block: [64])
                (bp.deviceBuffer(), b.deviceBuffer(), ukp, unp, uk, un);
            s.sync();
            matmulF16.launch(s, grid: [(ump / 16) * (unp / 16)], block: [64])
                (cp.deviceBuffer(), ap.deviceBuffer(), bp.deviceBuffer(), ump, unp, ukp);
            s.sync();
            uint32 on = um * un;
            cropF32.launch(s, grid: [(on + 63) / 64], block: [64])
                (out.deviceBuffer(), cp.deviceBuffer(), um, un, unp);
            s.sync();
        } else {
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    float32 acc = 0.0f;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + (float32) a.get2(i, p) * (float32) b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, acc);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * 2-D **bfloat16** matrix product returning **bfloat16**, routed per
     * backend (cajeta-llama 2.2.6, option c). Where the wide bf16/f32 shape is
     * launchable — `Device.supports(Capability.CoopMatrixBf16F32Acc)`: NVIDIA
     * sm_80+ and AMD RDNA3+ natively, the CPU software tier portably — the
     * device path runs {@link #matmulBf16Wide} and narrows ONCE through
     * {@link #narrowF32ToBf16}, matching the CPU floor's numerics. Elsewhere
     * (Vulkan, which has no bf16 coop config) it stays on the all-bf16
     * {@link #matmulBf16} kernel, keeping a device path at the documented
     * per-K-step bf16-accumulation cost. Ragged shapes pad/crop on the device
     * in both branches (2.2.5); the CPU floor accumulates at f32 and narrows
     * once at the store.
     */
    public static #Tensor<bfloat16> matmulBf16Op(Tensor<bfloat16> a, Tensor<bfloat16> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<bfloat16> out #= Tensor.zeros<bfloat16>(shp);
        boolean aligned = (m % 16 == 0) && (n % 16 == 0) && (k % 16 == 0);
        boolean onDevice = Placement.pair("matmulBf16", "a", a.isOnGpu(), "b", b.isOnGpu());
        if (onDevice && Device.supports(Capability.CoopMatrixBf16F32Acc)) {
            // Wide branch (2.2.6): f32 accumulation through the wide GEMM
            // (which handles its own ragged padding), one narrow at the end.
            Tensor<float32> w #= matmulBf16WideOp(a, b);
            out.gpu();
            KernelStream s #= KernelStream.current();
            uint32 umn = (uint32) (m * n);
            narrowF32ToBf16.launch(s, grid: [(umn + 63) / 64], block: [64])
                (out.deviceBuffer(), w.deviceBuffer(), umn);
            s.sync();
        } else if (onDevice && aligned) {
            out.gpu();
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            KernelStream s #= KernelStream.current();
            matmulBf16.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), um, un, uk);
            s.sync();
        } else if (onDevice) {
            // Ragged all-bf16 (2.2.5): pad, multiply, crop — everything at
            // bf16, the kernel's accumulator dtype.
            out.gpu();
            KernelStream s #= KernelStream.current();
            int64 mp = ((m + 15) / 16) * 16;
            int64 np = ((n + 15) / 16) * 16;
            int64 kp = ((k + 15) / 16) * 16;
            int64[] ashp = heap int64[2];
            ashp[0] = mp;
            ashp[1] = kp;
            Tensor<bfloat16> ap #= Tensor.zeros<bfloat16>(ashp);
            ap.gpu();
            int64[] bshp = heap int64[2];
            bshp[0] = kp;
            bshp[1] = np;
            Tensor<bfloat16> bp #= Tensor.zeros<bfloat16>(bshp);
            bp.gpu();
            int64[] cshp = heap int64[2];
            cshp[0] = mp;
            cshp[1] = np;
            Tensor<bfloat16> cp #= Tensor.zeros<bfloat16>(cshp);
            cp.gpu();
            uint32 ump = (uint32) mp;
            uint32 unp = (uint32) np;
            uint32 ukp = (uint32) kp;
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            uint32 an = ump * ukp;
            padBf16.launch(s, grid: [(an + 63) / 64], block: [64])
                (ap.deviceBuffer(), a.deviceBuffer(), ump, ukp, um, uk);
            uint32 bn = ukp * unp;
            padBf16.launch(s, grid: [(bn + 63) / 64], block: [64])
                (bp.deviceBuffer(), b.deviceBuffer(), ukp, unp, uk, un);
            s.sync();
            matmulBf16.launch(s, grid: [(ump / 16) * (unp / 16)], block: [64])
                (cp.deviceBuffer(), ap.deviceBuffer(), bp.deviceBuffer(), ump, unp, ukp);
            s.sync();
            uint32 on = um * un;
            cropBf16.launch(s, grid: [(on + 63) / 64], block: [64])
                (out.deviceBuffer(), cp.deviceBuffer(), um, un, unp);
            s.sync();
        } else {
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    float32 acc = 0.0f;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + (float32) a.get2(i, p) * (float32) b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, (bfloat16) acc);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return #out;
    }

    /**
     * 2-D bfloat16 matrix product ACCUMULATED AND RETURNED at **float32** —
     * the caller-facing wide op (cajeta-llama 2.2.6), the documented escape
     * hatch for large-K products over bf16 storage ({@link #matmulBf16}'s
     * accumulator caveat). Device path where
     * `Device.supports(Capability.CoopMatrixBf16F32Acc)` reports launchable
     * (NVIDIA sm_80+, AMD RDNA3+, the CPU software tier), with ragged shapes
     * padded and cropped on the device (2.2.5). Where the wide kernel is
     * compile-skipped — Vulkan today — device operands stage to the host
     * floor and their placement is restored.
     */
    public static #Tensor<float32> matmulBf16WideOp(Tensor<bfloat16> a, Tensor<bfloat16> b) {
        int64 m = a.shapeAt(0);
        int64 k = a.shapeAt(1);
        int64 n = b.shapeAt(1);
        int64[] shp = heap int64[2];
        shp[0] = m;
        shp[1] = n;
        Tensor<float32> out #= Tensor.zeros<float32>(shp);
        boolean aligned = (m % 16 == 0) && (n % 16 == 0) && (k % 16 == 0);
        boolean onDevice = Placement.pair("matmulBf16Wide", "a", a.isOnGpu(), "b", b.isOnGpu());
        boolean launchable = Device.supports(Capability.CoopMatrixBf16F32Acc);
        if (onDevice && launchable && aligned) {
            out.gpu();
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            KernelStream s #= KernelStream.current();
            matmulBf16Wide.launch(s, grid: [(um / 16) * (un / 16)], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), b.deviceBuffer(), um, un, uk);
            s.sync();
        } else if (onDevice && launchable) {
            out.gpu();
            KernelStream s #= KernelStream.current();
            int64 mp = ((m + 15) / 16) * 16;
            int64 np = ((n + 15) / 16) * 16;
            int64 kp = ((k + 15) / 16) * 16;
            int64[] ashp = heap int64[2];
            ashp[0] = mp;
            ashp[1] = kp;
            Tensor<bfloat16> ap #= Tensor.zeros<bfloat16>(ashp);
            ap.gpu();
            int64[] bshp = heap int64[2];
            bshp[0] = kp;
            bshp[1] = np;
            Tensor<bfloat16> bp #= Tensor.zeros<bfloat16>(bshp);
            bp.gpu();
            int64[] cshp = heap int64[2];
            cshp[0] = mp;
            cshp[1] = np;
            Tensor<float32> cp #= Tensor.zeros<float32>(cshp);
            cp.gpu();
            uint32 ump = (uint32) mp;
            uint32 unp = (uint32) np;
            uint32 ukp = (uint32) kp;
            uint32 um = (uint32) m;
            uint32 un = (uint32) n;
            uint32 uk = (uint32) k;
            uint32 an = ump * ukp;
            padBf16.launch(s, grid: [(an + 63) / 64], block: [64])
                (ap.deviceBuffer(), a.deviceBuffer(), ump, ukp, um, uk);
            uint32 bn = ukp * unp;
            padBf16.launch(s, grid: [(bn + 63) / 64], block: [64])
                (bp.deviceBuffer(), b.deviceBuffer(), ukp, unp, uk, un);
            s.sync();
            matmulBf16Wide.launch(s, grid: [(ump / 16) * (unp / 16)], block: [64])
                (cp.deviceBuffer(), ap.deviceBuffer(), bp.deviceBuffer(), ump, unp, ukp);
            s.sync();
            uint32 on = um * un;
            cropF32.launch(s, grid: [(on + 63) / 64], block: [64])
                (out.deviceBuffer(), cp.deviceBuffer(), um, un, unp);
            s.sync();
        } else {
            boolean staged = onDevice;   // no wide device path here (Vulkan)
            if (staged) { a.cpu(); b.cpu(); }
            int64 i = 0;
            while (i < m) {
                int64 j = 0;
                while (j < n) {
                    float32 acc = 0.0f;
                    int64 p = 0;
                    while (p < k) {
                        acc = acc + (float32) a.get2(i, p) * (float32) b.get2(p, j);
                        p = p + 1;
                    }
                    out.flatSet(i * n + j, acc);
                    j = j + 1;
                }
                i = i + 1;
            }
            if (staged) { a.gpu(); b.gpu(); }  // restore the caller's placement invariant
        }
        return #out;
    }

    /**
     * One compare-exchange stage of a bitonic sort over `data` (numpy-porting Phase
     * 7, 7b — the GPU sort primitive). Each thread `i` pairs with `i ^ j`; the
     * partner with the higher index does the swap, ascending when `(i & k) == 0`
     * and descending otherwise — the standard bitonic network. The host drives the
     * `(k, j)` stage schedule (`k` doubling, `j` halving) and re-launches this once
     * per stage. `n` must be a power of two.
     */
    @Kernel
    public static void bitonicStepF32(KernelBuffer<float32> data, uint32 n, uint32 k, uint32 j) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            uint32 ixj = i ^ j;
            if (ixj > i) {
                float32 vi = data[i];
                float32 vj = data[ixj];
                boolean ascending = (i & k) == 0;
                boolean swap = false;
                if (ascending) { if (vi > vj) { swap = true; } }
                else { if (vi < vj) { swap = true; } }
                if (swap) {
                    data[i] = vj;
                    data[ixj] = vi;
                }
            }
        }
    }

    /**
     * Ascending sort of a 1-D **power-of-two-length** `float32` tensor, routed on
     * placement: on-device → the {@link #bitonicStepF32} bitonic network (the host
     * issues the `O(log^2 n)` compare-exchange stages over the device buffer);
     * otherwise the {@link Tensor#sort} CPU floor. The two agree (the Phase-7 sort
     * cross-check). Returns a fresh 1-D `float32` tensor; on the device path the
     * sort runs on the device (host staging of the input is incidental data
     * movement). The bitonic network is not stable — fine for distinct keys.
     */
    public static #Tensor<float32> sortF32Op(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            t.cpu();                                   // stage input to host to seed the copy
            int64[] shp = heap int64[1];
            shp[0] = n;
            Tensor<float32> out #= Tensor.zeros<float32>(shp);
            int64 c = 0;
            while (c < n) {
                out.flatSet(c, t.flatGet(c));
                c = c + 1;
            }
            t.gpu();                                   // restore caller's placement invariant
            out.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            uint32 k = 2;
            while (k <= un) {
                uint32 j = k / 2;
                while (j > 0) {
                    bitonicStepF32.launch(s, grid: [(un + 63) / 64], block: [64])
                        (out.deviceBuffer(), un, k, j);
                    s.sync();
                    j = j / 2;
                }
                k = k * 2;
            }
            return #out;
        }
        return Tensor.sort<float32>(t, 0);
    }

    /**
     * One Hillis-Steele inclusive-scan pass: `out[i] = in[i] + in[i-offset]` (or `in[i]`
     * when `i < offset`), reading and writing *different* buffers so there's no race
     * (numpy-porting Phase 4 — the GPU prefix-scan primitive; the host ping-pongs two
     * buffers and doubles `offset` each of the `⌈log2 n⌉` passes).
     */
    @Kernel
    public static void scanStepF32(KernelBuffer<float32> out, KernelBuffer<float32> in, uint32 n, uint32 offset) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) {
            if (i >= offset) { out[i] = in[i] + in[i - offset]; }
            else { out[i] = in[i]; }
        }
    }

    /**
     * Inclusive prefix sum of a 1-D `float32` tensor (numpy `cumsum`), routed on
     * placement: on-device → the {@link #scanStepF32} Hillis-Steele scan (the host issues
     * `⌈log2 n⌉` ping-ponged passes over two device buffers); otherwise the CPU running
     * sum. The two agree (the Phase-4 scan cross-check). Returns a fresh 1-D tensor.
     */
    public static #Tensor<float32> cumsumF32Op(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            t.cpu();                                   // stage input to seed buffer A
            int64[] sa = heap int64[1]; sa[0] = n;
            Tensor<float32> a #= Tensor.zeros<float32>(sa);
            int64 c = 0;
            while (c < n) { a.flatSet(c, t.flatGet(c)); c = c + 1; }
            t.gpu();
            a.gpu();
            int64[] sb = heap int64[1]; sb[0] = n;
            Tensor<float32> b #= Tensor.zeros<float32>(sb);
            b.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            boolean srcIsA = true;                     // `a` holds the latest result
            uint32 offset = 1;
            while (offset < un) {
                if (srcIsA) {
                    scanStepF32.launch(s, grid: [(un + 63) / 64], block: [64])
                        (b.deviceBuffer(), a.deviceBuffer(), un, offset);
                } else {
                    scanStepF32.launch(s, grid: [(un + 63) / 64], block: [64])
                        (a.deviceBuffer(), b.deviceBuffer(), un, offset);
                }
                s.sync();
                srcIsA = !srcIsA;                      // the just-written buffer is now src
                offset = offset * 2;
            }
            if (srcIsA) { return #a; } else { return #b; }
        }
        int64[] os = heap int64[1]; os[0] = n;
        Tensor<float32> out #= Tensor.zeros<float32>(os);
        float32 acc = 0.0f;
        int64 i = 0;
        while (i < n) {
            acc = acc + t.flatGet(i);
            out.flatSet(i, acc);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Range-copy kernel: `out[i+dstOff] = in[i+srcOff]` for `i < n` (numpy-porting Phase
     * 5c — the structural-op primitive that concatenate/stack/split all reduce to: each
     * thread copies one element from a source window to a destination window).
     */
    @Kernel
    public static void copyRangeF32(KernelBuffer<float32> out, KernelBuffer<float32> in,
                                    uint32 n, uint32 srcOff, uint32 dstOff) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out[i + dstOff] = in[i + srcOff]; }
    }

    /**
     * Concatenate two 1-D `float32` tensors (numpy `concatenate`), routed on placement:
     * both on-device → two {@link #copyRangeF32} launches into one output buffer;
     * otherwise the CPU loop. The two agree (the Phase-5c structural cross-check).
     * `stack` of two rows is the same copy into a `(2, n)` output shape.
     */
    public static #Tensor<float32> concatF32Op(Tensor<float32> a, Tensor<float32> b) {
        int64 na = a.size();
        int64 nb = b.size();
        int64[] os = heap int64[1];
        os[0] = na + nb;
        Tensor<float32> out #= Tensor.zeros<float32>(os);
        if (Placement.pair("concat", "a", a.isOnGpu(), "b", b.isOnGpu())) {
            out.gpu();
            uint32 una = (uint32) na;
            uint32 unb = (uint32) nb;
            KernelStream s #= KernelStream.current();
            copyRangeF32.launch(s, grid: [(una + 63) / 64], block: [64])
                (out.deviceBuffer(), a.deviceBuffer(), una, 0, 0);
            copyRangeF32.launch(s, grid: [(unb + 63) / 64], block: [64])
                (out.deviceBuffer(), b.deviceBuffer(), unb, 0, una);
            s.sync();
        } else {
            int64 i = 0;
            while (i < na) { out.flatSet(i, a.flatGet(i)); i = i + 1; }
            int64 j = 0;
            while (j < nb) { out.flatSet(na + j, b.flatGet(j)); j = j + 1; }
        }
        return #out;
    }

    /**
     * The `[start, start+len)` slice of a 1-D `float32` tensor (numpy slice / one half of
     * `split`), routed on placement: on-device → a single {@link #copyRangeF32} from the
     * source window; otherwise the CPU loop. Agrees CPU/GPU (Phase-5c). A `split` is two
     * such slices.
     */
    public static #Tensor<float32> sliceF32Op(Tensor<float32> t, int64 start, int64 len) {
        int64[] os = heap int64[1];
        os[0] = len;
        Tensor<float32> out #= Tensor.zeros<float32>(os);
        if (Placement.single(t.isOnGpu())) {
            out.gpu();
            uint32 ul = (uint32) len;
            uint32 us = (uint32) start;
            KernelStream s #= KernelStream.current();
            copyRangeF32.launch(s, grid: [(ul + 63) / 64], block: [64])
                (out.deviceBuffer(), t.deviceBuffer(), ul, us, 0);
            s.sync();
        } else {
            int64 i = 0;
            while (i < len) { out.flatSet(i, t.flatGet(start + i)); i = i + 1; }
        }
        return #out;
    }

    /** Sum-of-squares reduction kernel: `out[0] += in[i]*in[i]` via a float atomic-add. */
    @Kernel
    public static void reduceSumSqF32(KernelBuffer<float32> out, KernelBuffer<float32> in, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { out.atomicAdd(0, in[i] * in[i]); }
    }

    /**
     * Frobenius norm `sqrt(Σ xᵢ²)` of a `float32` tensor (numpy `linalg.norm`; the norm
     * behind `linalg.cond`/`lstsq`), routed on placement: on-device → the
     * {@link #reduceSumSqF32} atomic sum-of-squares then a host `sqrt`; otherwise the CPU
     * loop. The two agree (a Phase-11 linalg GPU cross-check — the reduction-shaped linalg
     * primitives lower to the same atomic-reduction template as `sumF32`).
     */
    public static float32 normFroF32(Tensor<float32> t) {
        int64 n = t.size();
        if (Placement.single(t.isOnGpu())) {
            int64[] os = heap int64[1];
            os[0] = 1;
            Tensor<float32> acc #= Tensor.zeros<float32>(os);
            acc.gpu();
            uint32 un = (uint32) n;
            KernelStream s #= KernelStream.current();
            reduceSumSqF32.launch(s, grid: [(un + 63) / 64], block: [64])
                (acc.deviceBuffer(), t.deviceBuffer(), un);
            s.sync();
            acc.cpu();
            return Math.sqrt(acc.get1(0));
        }
        float32 sum = 0.0f;
        int64 i = 0;
        while (i < n) {
            float32 v = t.flatGet(i);
            sum = sum + v * v;
            i = i + 1;
        }
        return Math.sqrt(sum);
    }
}
