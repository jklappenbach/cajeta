package cajeta.math;

import cajeta.lang.String;
import cajeta.lang.StringBuilder;
import cajeta.xpu.Device;

/**
 * The placement decision for a tensor op, in one place (spec §2.1, §2.2).
 *
 * Every routed op asks the same question — kernel path or host path? — and a
 * split pair (one operand on each side) is rejected rather than reconciled:
 * migrating either operand would spend bandwidth the caller did not ask for or
 * read {@link Storage}'s stale host mirror. An op with no kernel for
 * device-resident operands is refused by name (`guard*`); it never moves the
 * caller's tensors.
 *
 * This is a decision helper, not a dispatcher: it answers *which path*, and the
 * op still writes both. That keeps kernel launches at their call sites, where
 * the grid and block shapes live.
 */
public final class Placement {
    public Placement() { }

    /**
     * The path for a two-operand op. `true` — both operands are device-resident,
     * take the kernel path. `false` — both are on the host, take the CPU floor.
     * A split pair throws {@link PlacementException} naming both operands and
     * their residency, rather than picking either arm (spec §2.2, decision
     * 13.1).
     *
     * `op` names the operation and `aName`/`bName` the parameters as the caller
     * declares them, so the message points at something the caller can act on.
     */
    public static boolean pair(String op, String aName, boolean aOnGpu,
                               String bName, boolean bOnGpu) {
        if (aOnGpu && bOnGpu) { return true; }
        if (!aOnGpu && !bOnGpu) { return false; }
        StringBuilder sb = stack StringBuilder();
        sb.append(op);
        sb.append(": operands are split across host and device — ");
        sb.append(aName);
        if (aOnGpu) {
            sb.append(" is device-resident, ");
        } else {
            sb.append(" is on the host, ");
        }
        sb.append(bName);
        if (bOnGpu) {
            sb.append(" is device-resident");
        } else {
            sb.append(" is on the host");
        }
        sb.append(". Move both to the same place first — gpu() or cpu(). This op ");
        sb.append("does not migrate: it would either spend bandwidth you did not ");
        sb.append("ask for, or read a stale host mirror.");
        throw heap PlacementException(sb.toString());
    }

    /**
     * The path for a single-operand op. There is no split to reject, so this is
     * the operand's own residency — routed through here anyway so that every op
     * reads the same way and a future policy change lands in one place.
     */
    public static boolean single(boolean tOnGpu) {
        return tOnGpu;
    }

    // ───────────────────────────── refusals (spec §3.6) ───────────────────────

    /**
     * The dtype's spelling for a diagnostic — `float64`, `int32`, `bfloat16`.
     * {@link DType} carries kind/width/variant codes but no name, and a note that
     * says "kind 3 width 64" is not a note anyone can act on.
     */
    public static String dtypeName(DType d) {
        if (d.isBool()) { return "boolean"; }
        int32 bits = d.bits();
        if (d.isFloating()) {
            int32 v = d.variant();
            if (v == DType.VAR_BF16) { return "bfloat16"; }
            if (v != DType.VAR_STD)  { return "float8/6/4"; }
            if (bits == 16)  { return "float16"; }
            if (bits == 32)  { return "float32"; }
            if (bits == 64)  { return "float64"; }
            if (bits == 128) { return "float128"; }
            return "float";
        }
        if (d.isUnsignedInt()) {
            if (bits == 8)   { return "uint8"; }
            if (bits == 16)  { return "uint16"; }
            if (bits == 32)  { return "uint32"; }
            if (bits == 64)  { return "uint64"; }
            if (bits == 128) { return "uint128"; }
            return "uint";
        }
        if (bits == 8)   { return "int8"; }
        if (bits == 16)  { return "int16"; }
        if (bits == 32)  { return "int32"; }
        if (bits == 64)  { return "int64"; }
        if (bits == 128) { return "int128"; }
        return "int";
    }

    /**
     * Refuse `op`: it has no device kernel for its operands. Names the op, the dtype
     * and `why` ("for broadcast shapes", "for this op"); the operands stay put.
     */
    public static void noKernel(String op, DType d, String why) {
        StringBuilder sb = stack StringBuilder();
        sb.append(op);
        sb.append(" on ");
        sb.append(Placement.dtypeName(d));
        sb.append(": no device kernel ");
        sb.append(why);
        sb.append(". The operands stay on the device; bring them to the host with ");
        sb.append("cpu() to run the host path.");
        throw heap PlacementException(sb.toString());
    }

    /**
     * Refuse `op` unless the generic kernel `kernel`'s instantiation for `d`
     * (registered as `kernel_dtype`) has device code on the active backend.
     */
    public static void requireKernel(String op, String kernel, DType d) {
        StringBuilder nb = stack StringBuilder();
        nb.append(kernel);
        nb.append("_");
        nb.append(Placement.dtypeName(d));
        String name #= nb.toString();
        if (Device.kernelAvailable(name)) {
            return;
        }
        StringBuilder why = stack StringBuilder();
        why.append("for this dtype on the ");
        why.append(Device.activeBackend());
        why.append(" backend (");
        why.append(Device.kernelUnavailableReason(name));
        why.append(")");
        Placement.noKernel(op, d, why.toString());
    }

    /**
     * The path for a two-operand generic op that has a device kernel: `true` for a
     * device-resident pair, `false` for a host pair; a split pair throws.
     */
    public static boolean devicePair<E>(String op, Tensor<E> a, Tensor<E> b) {
        return Placement.pair(op, "a", a.isOnGpu(), "b", b.isOnGpu());
    }

    /**
     * The guard for a two-operand generic op with no device kernel: a split pair
     * throws, a device-resident pair is refused by name, a host pair proceeds.
     * Operands are named `a` and `b`, the parameter names most of these ops use.
     */
    public static void guardPair<E>(String op, Tensor<E> a, Tensor<E> b) {
        Placement.guardPair<E>(op, "a", a, "b", b);
    }

    /** {@link #guardPair} for an op whose operands are not called `a` and `b`;
     *  the names reach the split message. */
    public static void guardPair<E>(String op, String aName, Tensor<E> a,
                                    String bName, Tensor<E> b) {
        if (Placement.pair(op, aName, a.isOnGpu(), bName, b.isOnGpu())) {
            Placement.noKernel(op, DType.of<E>(), "for this op");
        }
    }

    /** {@link #guardPair} for a cross-dtype op; the refusal names `A`'s dtype. */
    public static void guardPair2<A, B>(String op, Tensor<A> a, Tensor<B> b) {
        if (Placement.pair(op, "a", a.isOnGpu(), "b", b.isOnGpu())) {
            Placement.noKernel(op, DType.of<A>(), "for this op");
        }
    }

    /** {@link #guardPair} for a one-operand generic op with no device kernel. */
    public static void guardSingle<E>(String op, Tensor<E> t) {
        if (t.isOnGpu()) {
            Placement.noKernel(op, DType.of<E>(), "for this op");
        }
    }

    /**
     * The placement guard for an op taking an **array** of tensors —
     * `concatenate`, `stackTensors`, `choose`, `einsum`.
     *
     * {@link #guardPair} cannot express this: the split can sit anywhere in the
     * array rather than between two named parameters, so the question is "are
     * they all in the same place?" and the message has to say which ones
     * disagree. An empty array is a no-op — the op's own shape validation owns
     * that case.
     */
    public static void guardMany<E>(String op, Tensor<E>[] parts) {
        int64 n = (int64) parts.count();
        if (n == 0) {
            return;
        }
        int64 onDevice = 0;
        int64 i = 0;
        while (i < n) {
            if (parts[i].isOnGpu()) { onDevice = onDevice + 1; }
            i = i + 1;
        }
        if (onDevice == 0) {
            return;
        }
        if (onDevice < n) {
            StringBuilder sb = stack StringBuilder();
            sb.append(op);
            sb.append(": operands are split across host and device — ");
            i = 0;
            while (i < n) {
                if (i > 0) { sb.append(", "); }
                sb.append("[");
                sb.append(Placement.indexName(i));
                sb.append("] is ");
                if (parts[i].isOnGpu()) {
                    sb.append("device-resident");
                } else {
                    sb.append("on the host");
                }
                i = i + 1;
            }
            sb.append(". Move them all to the same place first — gpu() or cpu(). ");
            sb.append("This op does not migrate: it would either spend bandwidth ");
            sb.append("you did not ask for, or read a stale host mirror.");
            throw heap PlacementException(sb.toString());
        }
        Placement.noKernel(op, DType.of<E>(), "for this op");
    }

    /** A small non-negative index as text, for {@link #guardMany}'s message.
     *  `StringBuilder.append` takes a `String` only, and these arrays are short. */
    public static String indexName(int64 i) {
        if (i == 0) { return "0"; }
        if (i == 1) { return "1"; }
        if (i == 2) { return "2"; }
        if (i == 3) { return "3"; }
        if (i == 4) { return "4"; }
        if (i == 5) { return "5"; }
        if (i == 6) { return "6"; }
        if (i == 7) { return "7"; }
        return "n";
    }
}
