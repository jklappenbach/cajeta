package cajeta.math;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/**
 * Thrown when two tensor shapes cannot be broadcast against each other
 * (tensor-spec.md §5) — i.e. some right-aligned axis pair has two distinct
 * extents neither of which is 1 — or when {@link Tensor#broadcastTo} is asked
 * for a target with fewer dimensions than the source. The cajeta analogue of
 * numpy's broadcasting `ValueError`.
 *
 * Recoverable: shape mismatches are a normal, caller-handleable condition
 * (mirrors {@link cajeta.codec.Base64Exception}'s discipline).
 */
public class BroadcastException extends RecoverableException {
    public BroadcastException(#String message) {
        this.message = message;
        this.cause = 0;
    }
}
