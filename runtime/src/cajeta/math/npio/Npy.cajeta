package cajeta.math.npio;

import cajeta.math.Tensor;
import cajeta.io.file.File;
import cajeta.lang.String;

/**
 * `cajeta.math.npio` — NumPy `.npy` binary array I/O (numpy-porting-plan Phase 10.5).
 * Reads/writes the NumPy v1.0 `.npy` format: a 6-byte magic `\x93NUMPY`, a 2-byte
 * version, a little-endian `uint16` header length, then an ASCII Python-dict header
 * (`descr`/`fortran_order`/`shape`) padded with spaces to a 64-byte boundary and
 * terminated by `\n`, followed by the raw little-endian element bytes in C-order.
 *
 * Four dtypes are supported, each a typed save/load pair (cajeta is statically typed,
 * so the caller picks the loader matching the file's dtype):
 *   float32 `'<f4'` · float64 `'<f8'` · int32 `'<i4'` · int64 `'<i8'`.
 * Float element bytes use the `Cajeta.f32ToBits`/`bitsToF32` / `f64ToBits`/`bitsToF64`
 * reinterpret intrinsics (no value conversion); the 8-byte little-endian path reuses
 * `Cajeta.storeU64`/`loadU64`. File bytes go through the intrinsic-lowered
 * `File.writeAllBytes`/`readAllBytes`.
 */
public final class Npy {

    // ---- low-level byte helpers ------------------------------------------------

    /** Write the ASCII bytes of `s` into `buf` at `off`; return the next offset. */
    static int64 putStr(int8[] buf, int64 off, String s) {
        int64 n = s.count();
        int32 i = 0;
        while ((int64) i < n) {
            buf[off] = s.charAt(i);
            off = off + 1;
            i = i + 1;
        }
        return off;
    }

    /** Write the decimal digits of `v` (`v >= 0`); return the next offset. */
    static int64 putDecimal(int8[] buf, int64 off, int64 v) {
        if (v == 0) {
            buf[off] = (int8) 48;                 // '0'
            return off + 1;
        }
        int64 nd = 0;
        int64 tmp = v;
        while (tmp > 0) { nd = nd + 1; tmp = tmp / 10; }
        int64 i = nd - 1;
        while (i >= 0) {
            int64 d = v % 10;
            buf[off + i] = (int8) (48 + d);
            v = v / 10;
            i = i - 1;
        }
        return off + nd;
    }

    // ---- header build / parse (dtype-independent) ------------------------------

    /** Emit the ASCII header dict into `buf` at `off`; return the next offset. */
    static int64 emitDict(int8[] buf, int64 off, int32 nd, int64[] shape, String descr) {
        off = Npy.putStr(buf, off, "{'descr': '");
        off = Npy.putStr(buf, off, descr);
        off = Npy.putStr(buf, off, "', 'fortran_order': False, 'shape': (");
        int32 i = 0;
        while (i < nd) {
            off = Npy.putDecimal(buf, off, shape[i]);
            if (i < nd - 1) { off = Npy.putStr(buf, off, ", "); }
            i = i + 1;
        }
        if (nd == 1) { off = Npy.putStr(buf, off, ","); }
        off = Npy.putStr(buf, off, "), }");
        return off;
    }

    /** Padded header total (= the data start offset): a multiple of 64. */
    static int64 headerTotal(int32 nd, int64[] shape, String descr) {
        int8[] hdr = heap int8[256];
        int64 dlen = Npy.emitDict(hdr, 0, nd, shape, descr);
        int64 base = 10 + dlen + 1;               // 10-byte preamble + dict + '\n'
        return ((base + 63) / 64) * 64;
    }

    /** Write the full magic/version/length/dict/pad header into `buf[0..total)`. */
    static void writeHeader(int8[] buf, int32 nd, int64[] shape, String descr, int64 total) {
        buf[0] = (int8) 147;                       // 0x93
        Npy.putStr(buf, 1, "NUMPY");
        buf[6] = (int8) 1;                         // major
        buf[7] = (int8) 0;                         // minor
        int64 hlen = total - 10;
        buf[8] = (int8) (hlen & 255);
        buf[9] = (int8) ((hlen / 256) & 255);
        int64 off = Npy.emitDict(buf, 10, nd, shape, descr);
        int64 q = off;
        while (q < total - 1) { buf[q] = (int8) 32; q = q + 1; }   // ' '
        buf[total - 1] = (int8) 10;                // '\n'
    }

    /** Read the data start offset (`10 + uint16 header length`) from `buf`. */
    static int64 dataOffset(int8[] buf) {
        int32 hlen = ((int32) buf[8] & 255) | (((int32) buf[9] & 255) << 8);
        return 10 + (int64) hlen;
    }

    /** Parse the shape tuple from the header dict into `dims`; return the ndim. */
    static int32 parseShape(int8[] buf, int64[] dims) {
        int64 p = 10;
        while (buf[p] != (int8) 40) { p = p + 1; }   // scan to '('
        p = p + 1;
        int32 ndp = 0;
        boolean done = false;
        while (!done) {
            int8 ch = buf[p];
            if (ch == (int8) 41) {                   // ')'
                done = true;
            } else if (ch >= (int8) 48 && ch <= (int8) 57) {
                int64 v = 0;
                boolean inNum = true;
                while (inNum) {
                    int8 dch = buf[p];
                    if (dch >= (int8) 48 && dch <= (int8) 57) {
                        int32 digit = (int32) dch - 48;
                        v = v * 10 + (int64) digit;
                        p = p + 1;
                    } else {
                        inNum = false;
                    }
                }
                dims[ndp] = v;
                ndp = ndp + 1;
            } else {
                p = p + 1;                           // skip space / comma
            }
        }
        return ndp;
    }

    /** Element count = product of `dims[0..nd)`. */
    static int64 elemCount(int64[] dims, int32 nd) {
        int64 n = 1;
        int32 i = 0;
        while (i < nd) { n = n * dims[i]; i = i + 1; }
        return n;
    }

    /** Fill `shape[0..nd)` from `t`'s dimensions; returns nd. */
    static int32 fillShape(Tensor<float32> t, int64[] shape) {
        int32 nd = t.ndim();
        int32 si = 0;
        while (si < nd) { shape[si] = t.shapeAt(si); si = si + 1; }
        return nd;
    }

    // ---- float32 ('<f4') -------------------------------------------------------

    /** Serialize a `float32` tensor to its full `.npy` byte image (`'<f4'`). */
    public static #int8[] encodeF32(Tensor<float32> t) {
        int64 n = t.size();
        int64[] shape = heap int64[t.ndim()];
        int32 nd = Npy.fillShape(t, shape);
        int64 total = Npy.headerTotal(nd, shape, "<f4");
        int64 fileLen = total + n * 4;
        int8[] buf = heap int8[fileLen];
        Npy.writeHeader(buf, nd, shape, "<f4", total);
        Tensor<float32> c = t.copy();
        int64 e = 0;
        while (e < n) {
            int32 bits = Cajeta.f32ToBits(c.flatGet(e));
            int64 bo = total + e * 4;
            buf[bo + 0] = (int8) (bits & 255);
            buf[bo + 1] = (int8) ((bits >> 8) & 255);
            buf[bo + 2] = (int8) ((bits >> 16) & 255);
            buf[bo + 3] = (int8) ((bits >> 24) & 255);
            e = e + 1;
        }
        return #buf;
    }

    /** Decode a `float32` `.npy` byte image (starting at offset 0). */
    public static #Tensor<float32> decodeF32(int8[] buf) {
        int64 dataOff = Npy.dataOffset(buf);
        int64[] dims = heap int64[8];
        int32 nd = Npy.parseShape(buf, dims);
        int64[] shape = heap int64[nd];
        int32 a = 0;
        while (a < nd) { shape[a] = dims[a]; a = a + 1; }
        int64 n = Npy.elemCount(shape, nd);
        Tensor<float32> out = Tensor.zeros<float32>(shape);
        int64 e = 0;
        while (e < n) {
            int64 bo = dataOff + e * 4;
            int32 b0 = (int32) buf[bo + 0] & 255;
            int32 b1 = (int32) buf[bo + 1] & 255;
            int32 b2 = (int32) buf[bo + 2] & 255;
            int32 b3 = (int32) buf[bo + 3] & 255;
            int32 bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            out.flatSet(e, Cajeta.bitsToF32(bits));
            e = e + 1;
        }
        return #out;
    }

    /** Save a `float32` tensor to `path` as a `.npy` (`'<f4'`, C-order). */
    public static void saveF32(String path, Tensor<float32> t) {
        int8[] buf = Npy.encodeF32(t);
        int64 len = buf.count();
        File.writeAllBytes(path, buf, (int32) len);
    }

    /** Load a `float32` `.npy` from `path`. */
    public static #Tensor<float32> loadF32(String path) {
        int8[] buf = File.readAllBytes(path);
        return Npy.decodeF32(buf);
    }

    // ---- float64 ('<f8') -------------------------------------------------------

    /** Serialize a `float64` tensor to its full `.npy` byte image (`'<f8'`). */
    public static #int8[] encodeF64(Tensor<float64> t) {
        int64 n = t.size();
        int64[] shape = heap int64[t.ndim()];
        int32 nd = t.ndim();
        int32 si = 0;
        while (si < nd) { shape[si] = t.shapeAt(si); si = si + 1; }
        int64 total = Npy.headerTotal(nd, shape, "<f8");
        int64 fileLen = total + n * 8;
        int8[] buf = heap int8[fileLen];
        Npy.writeHeader(buf, nd, shape, "<f8", total);
        Tensor<float64> c = t.copy();
        int64 e = 0;
        while (e < n) {
            Cajeta.storeU64(buf, total + e * 8, Cajeta.f64ToBits(c.flatGet(e)));
            e = e + 1;
        }
        return #buf;
    }

    /** Decode a `float64` `.npy` byte image (starting at offset 0). */
    public static #Tensor<float64> decodeF64(int8[] buf) {
        int64 dataOff = Npy.dataOffset(buf);
        int64[] dims = heap int64[8];
        int32 nd = Npy.parseShape(buf, dims);
        int64[] shape = heap int64[nd];
        int32 a = 0;
        while (a < nd) { shape[a] = dims[a]; a = a + 1; }
        int64 n = Npy.elemCount(shape, nd);
        Tensor<float64> out = Tensor.zeros<float64>(shape);
        int64 e = 0;
        while (e < n) {
            out.flatSet(e, Cajeta.bitsToF64(Cajeta.loadU64(buf, dataOff + e * 8)));
            e = e + 1;
        }
        return #out;
    }

    /** Save a `float64` tensor to `path` as a `.npy` (`'<f8'`, C-order). */
    public static void saveF64(String path, Tensor<float64> t) {
        int8[] buf = Npy.encodeF64(t);
        int64 len = buf.count();
        File.writeAllBytes(path, buf, (int32) len);
    }

    /** Load a `float64` `.npy` from `path`. */
    public static #Tensor<float64> loadF64(String path) {
        int8[] buf = File.readAllBytes(path);
        return Npy.decodeF64(buf);
    }

    // ---- int32 ('<i4') ---------------------------------------------------------

    /** Serialize an `int32` tensor to its full `.npy` byte image (`'<i4'`). */
    public static #int8[] encodeI32(Tensor<int32> t) {
        int64 n = t.size();
        int64[] shape = heap int64[t.ndim()];
        int32 nd = t.ndim();
        int32 si = 0;
        while (si < nd) { shape[si] = t.shapeAt(si); si = si + 1; }
        int64 total = Npy.headerTotal(nd, shape, "<i4");
        int64 fileLen = total + n * 4;
        int8[] buf = heap int8[fileLen];
        Npy.writeHeader(buf, nd, shape, "<i4", total);
        Tensor<int32> c = t.copy();
        int64 e = 0;
        while (e < n) {
            int32 v = c.flatGet(e);
            int64 bo = total + e * 4;
            buf[bo + 0] = (int8) (v & 255);
            buf[bo + 1] = (int8) ((v >> 8) & 255);
            buf[bo + 2] = (int8) ((v >> 16) & 255);
            buf[bo + 3] = (int8) ((v >> 24) & 255);
            e = e + 1;
        }
        return #buf;
    }

    /** Decode an `int32` `.npy` byte image (starting at offset 0). */
    public static #Tensor<int32> decodeI32(int8[] buf) {
        int64 dataOff = Npy.dataOffset(buf);
        int64[] dims = heap int64[8];
        int32 nd = Npy.parseShape(buf, dims);
        int64[] shape = heap int64[nd];
        int32 a = 0;
        while (a < nd) { shape[a] = dims[a]; a = a + 1; }
        int64 n = Npy.elemCount(shape, nd);
        Tensor<int32> out = Tensor.zeros<int32>(shape);
        int64 e = 0;
        while (e < n) {
            int64 bo = dataOff + e * 4;
            int32 b0 = (int32) buf[bo + 0] & 255;
            int32 b1 = (int32) buf[bo + 1] & 255;
            int32 b2 = (int32) buf[bo + 2] & 255;
            int32 b3 = (int32) buf[bo + 3] & 255;
            int32 v = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            out.flatSet(e, v);
            e = e + 1;
        }
        return #out;
    }

    /** Save an `int32` tensor to `path` as a `.npy` (`'<i4'`, C-order). */
    public static void saveI32(String path, Tensor<int32> t) {
        int8[] buf = Npy.encodeI32(t);
        int64 len = buf.count();
        File.writeAllBytes(path, buf, (int32) len);
    }

    /** Load an `int32` `.npy` from `path`. */
    public static #Tensor<int32> loadI32(String path) {
        int8[] buf = File.readAllBytes(path);
        return Npy.decodeI32(buf);
    }

    // ---- int64 ('<i8') ---------------------------------------------------------

    /** Serialize an `int64` tensor to its full `.npy` byte image (`'<i8'`). */
    public static #int8[] encodeI64(Tensor<int64> t) {
        int64 n = t.size();
        int64[] shape = heap int64[t.ndim()];
        int32 nd = t.ndim();
        int32 si = 0;
        while (si < nd) { shape[si] = t.shapeAt(si); si = si + 1; }
        int64 total = Npy.headerTotal(nd, shape, "<i8");
        int64 fileLen = total + n * 8;
        int8[] buf = heap int8[fileLen];
        Npy.writeHeader(buf, nd, shape, "<i8", total);
        Tensor<int64> c = t.copy();
        int64 e = 0;
        while (e < n) {
            Cajeta.storeU64(buf, total + e * 8, c.flatGet(e));
            e = e + 1;
        }
        return #buf;
    }

    /** Decode an `int64` `.npy` byte image (starting at offset 0). */
    public static #Tensor<int64> decodeI64(int8[] buf) {
        int64 dataOff = Npy.dataOffset(buf);
        int64[] dims = heap int64[8];
        int32 nd = Npy.parseShape(buf, dims);
        int64[] shape = heap int64[nd];
        int32 a = 0;
        while (a < nd) { shape[a] = dims[a]; a = a + 1; }
        int64 n = Npy.elemCount(shape, nd);
        Tensor<int64> out = Tensor.zeros<int64>(shape);
        int64 e = 0;
        while (e < n) {
            out.flatSet(e, Cajeta.loadU64(buf, dataOff + e * 8));
            e = e + 1;
        }
        return #out;
    }

    /** Save an `int64` tensor to `path` as a `.npy` (`'<i8'`, C-order). */
    public static void saveI64(String path, Tensor<int64> t) {
        int8[] buf = Npy.encodeI64(t);
        int64 len = buf.count();
        File.writeAllBytes(path, buf, (int32) len);
    }

    /** Load an `int64` `.npy` from `path`. */
    public static #Tensor<int64> loadI64(String path) {
        int8[] buf = File.readAllBytes(path);
        return Npy.decodeI64(buf);
    }
}
