package cajeta.math;

/**
 * Matrix — a fixed-shape, register-resident numeric matrix `Matrix<T, R, C>`
 * (R rows, C columns of element type T), the first linear-algebra value type
 * in the standard library (B1).
 *
 * HYBRID value type. This declared class is the user-facing, Pythonic operator
 * surface — `a + b`, `a * b` (matrix multiply!), `m[r][c]`, `m.transpose()` —
 * declared per docs/OperatorOverloading.md. But a concrete `Matrix<...>`
 * type REFERENCE resolves to the compiler's flat row-major representation (a
 * `<R*C x T>`, element (r,c) at lane r*C+c — CajetaMatrix), and the operators
 * are lowered as register-native vector intrinsics in BOTH the host expression
 * codegen and the device kernel lowerer. So the syntax is library-owned while
 * the generated code is identical to a pure-intrinsic value type.
 *
 * The method/operator BODIES below are resolution placeholders — exactly like
 * {@link cajeta.gpu.CooperativeMatrix} and {@link cajeta.gpu.RayQuery}.
 * They are never emitted as real calls: each operator is intercepted at its use
 * site and the result SHAPE is computed by the interceptor. (Deepening to real
 * dispatch, and lifting the method-templated-operator restriction that a truly
 * K-generic `matmul` needs, are scoped follow-ons — see the B1 plan.)
 *
 * Operator semantics (locked design):
 *   - `a + b`, `a - b`, `a / b` : element-wise, same shape.
 *   - `a * b` : MATRIX MULTIPLY. `Matrix<T,R,K> * Matrix<T,K,C>` -> `Matrix<T,R,C>`
 *     (inner dim K checked); `Matrix<T,R,C> * Vector<T,C>` -> `Vector<T,R>`;
 *     `Matrix * scalar` / `scalar * Matrix` -> element-wise scale. Hadamard
 *     (element-wise product) is the `hadamard(b)` method, not `*`.
 *   - `m[r]` -> `Vector<T,C>` row; `m[r][c]` -> element; `m[r][c] = v` -> assign.
 *   - comparisons (`== != < <= > >=`) : a **per-lane mask** `Matrix<boolean,R,C>`
 *     (the value-type comparison rule — NOT a reduced boolean). Whole-matrix
 *     equality is `(a == b).all()`; blend with `mask.select(a, b)`. A scalar RHS
 *     broadcasts. See docs/MaskSelect.md.
 *
 * The matrix-multiply and matrix*vector forms are shape/K-generic and so are
 * handled purely by codegen interception (they cannot be expressed as a single
 * non-templated operator declaration); only the scalar-scale `*` is declared.
 *
 * ## Methods (compiler intrinsics; float-element where noted)
 *
 * `transpose()`, `identity()` (square), `row(i)`, `col(j)`, `hadamard(b)`
 * (element-wise product); for square 2x2/3x3/4x4 — `determinant()` (scalar) and
 * `inverse()` (`Matrix<T,N,N>`). A comparison mask adds `all()`/`any()`/`select`.
 *
 * ```
 * Matrix<float32,2,2> a = stack Matrix<float32,2,2>(1.0f, 2.0f, 3.0f, 4.0f);
 * Matrix<float32,2,2> b = stack Matrix<float32,2,2>(5.0f, 6.0f, 7.0f, 8.0f);
 * Matrix<float32,2,2> c = a * b;             // matrix multiply -> [19 22; 43 50]
 * float32 d = a.determinant();               // -2
 * Matrix<float32,2,2> x = a.inverse() * b;   // solve a*x = b
 * boolean same = (a == a).all();             // whole-matrix equality
 * Matrix<float32,2,2> kept = (a > 1.0f).select(a, b);   // per-lane blend
 * ```
 *
 * Runs identically on CPU, Vulkan, and AMD — see samples/Tour (LinearAlgebraDemo
 * + the XPU `linalgk` kernel) and docs/MatrixDeterminantInverse.md.
 */
public final class Matrix<T, uint32 R, uint32 C> {
    // Placeholder field. A Matrix reference resolves to the flat CajetaMatrix
    // representation, so the host front-end never lays this class out for real
    // (and the declared body is intercepted) — but a zero-field class has no
    // valid LLVM type, so one reserved word gives the declaration a layout.
    T reserved;

    /**
     * Subscript: `m[r]` selects row r as a `Vector<T, C>` (the row's C elements,
     * flat lanes [r*C, r*C+C)). `m[r][c]` then composes with the vector index
     * path to read/assign the element at flat lane r*C+c. Intercepted.
     */
    public Vector<T, C> operator[] (uint32 r) {
        return this.row(r);
    }

    /** Element-wise sum, same shape. Intercepted (flat-vector fadd/add). */
    public static Matrix<T, R, C> operator+ (Matrix<T, R, C> a,
                                             Matrix<T, R, C> b) {
        return a;
    }

    /** Element-wise difference, same shape. Intercepted. */
    public static Matrix<T, R, C> operator- (Matrix<T, R, C> a,
                                             Matrix<T, R, C> b) {
        return a;
    }

    /**
     * Scalar scale: `m * s` multiplies every element by s. (Matrix*Matrix and
     * Matrix*Vector are matrix multiply, handled by codegen interception — they
     * are K-generic and cannot be one non-templated declaration.) Intercepted.
     */
    public static Matrix<T, R, C> operator* (Matrix<T, R, C> a, T s) {
        return a;
    }

    /**
     * Comparison. Intercepted — the real result is a per-lane mask
     * `Matrix<boolean,R,C>` (the value-type comparison rule), NOT the boolean
     * this placeholder signature shows. Whole-matrix equality is `(a==b).all()`.
     */
    public static boolean operator== (Matrix<T, R, C> a, Matrix<T, R, C> b) {
        return true;
    }

    /** Row r as a `Vector<T, C>` (flat lanes [r*C, r*C+C)). Intercepted. */
    public Vector<T, C> row(uint32 r) {
        Vector<T, C> result;
        return result;
    }

    /** Column c as a `Vector<T, R>` (flat lanes c, c+C, c+2C, ...). Intercepted. */
    public Vector<T, R> col(uint32 c) {
        Vector<T, R> result;
        return result;
    }

    /** Transpose -> `Matrix<T, C, R>` (element (i,j) becomes (j,i)). Intercepted. */
    public Matrix<T, C, R> transpose() {
        Matrix<T, C, R> result;
        return result;
    }

    /**
     * Hadamard (element-wise) product with a same-shape matrix. The `*` operator
     * is matrix multiply, so the element-wise product is this named method.
     * Intercepted.
     */
    public Matrix<T, R, C> hadamard(Matrix<T, R, C> b) {
        return this;
    }
}
