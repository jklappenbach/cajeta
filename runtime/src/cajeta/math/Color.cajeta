package cajeta.math;

import cajeta.lang.Math;

/**
 * Color — an RGBA color, the value type a renderer passes between sRGB-encoded
 * texture/UI space and linear light space (cajeta-gfx plan §1.d). A record —
 * a value type over four `float32` channels (r, g, b, a), each in [0,1] —
 * with structural equality and the flat no-header layout (records-spec §1.4).
 *
 * sRGB is a non-linear encoding: shading must happen in LINEAR light, but
 * textures and UI colors are usually sRGB-encoded. `toLinear()` decodes sRGB ->
 * linear; `toSrgb()` encodes linear -> sRGB. Both use the standard IEC
 * 61966-2-1 piecewise transfer function (a small linear segment near black, a
 * gamma-2.4 power curve above). Alpha is linear and passes through unchanged.
 *
 * ```cajeta
 * Color albedo = stack Color(0.5f, 0.25f, 0.1f, 1.0f);  // sRGB from a texture
 * Color lit = albedo.toLinear();                        // shade in linear light
 * Color out = lit.toSrgb();                             // encode for the display
 * ```
 */
public record Color {
    public float32 r;
    public float32 g;
    public float32 b;
    public float32 a;

    /**
     * Build a color from its r, g, b, a channels, each in [0,1].
     *
     * @EntryPoint
     */
    public Color(float32 r, float32 g, float32 b, float32 a) {
        this.r = r;
        this.g = g;
        this.b = b;
        this.a = a;
    }

    /** Red channel. */
    public float32 r() {
        return this.r;
    }

    /** Green channel. */
    public float32 g() {
        return this.g;
    }

    /** Blue channel. */
    public float32 b() {
        return this.b;
    }

    /** Alpha channel. */
    public float32 a() {
        return this.a;
    }

    /** Decode one sRGB-encoded channel to linear light. */
    public static float32 srgbToLinearChannel(float32 c) {
        if (c <= 0.04045f) {
            return c / 12.92f;
        }
        float32 num = c + 0.055f;
        float32 base = num / 1.055f;
        return Math.pow(base, 2.4f);
    }

    /** Encode one linear-light channel to sRGB. */
    public static float32 linearToSrgbChannel(float32 c) {
        if (c <= 0.0031308f) {
            return c * 12.92f;
        }
        float32 p = Math.pow(c, 0.41666667f);   // 1 / 2.4
        float32 s = 1.055f * p;
        return s - 0.055f;
    }

    /** This color decoded from sRGB to linear light (alpha unchanged). */
    public Color toLinear() {
        float32 lr = Color.srgbToLinearChannel(this.r);
        float32 lg = Color.srgbToLinearChannel(this.g);
        float32 lb = Color.srgbToLinearChannel(this.b);
        return stack Color(lr, lg, lb, this.a);
    }

    /** This color encoded from linear light to sRGB (alpha unchanged). */
    public Color toSrgb() {
        float32 sr = Color.linearToSrgbChannel(this.r);
        float32 sg = Color.linearToSrgbChannel(this.g);
        float32 sb = Color.linearToSrgbChannel(this.b);
        return stack Color(sr, sg, sb, this.a);
    }

    // ─────────────────────────────── OKLab (stdlib-completion §6) ─────────────
    // The sRGB->OKLab direction lives on the destination type as
    // Oklab.fromColor (specs/record-cross-type-return: a stdlib method
    // returning a record other than its own type mis-compiles the bundle).

    /**
     * The sRGB color at OKLab coordinates `lab` (alpha supplied). Channels
     * are NOT clipped: an out-of-gamut `lab` yields channels outside
     * `[0, 1]`, and {@link #inSrgbGamut} is the explicit query (§6.5) —
     * silent clipping would hide exactly the condition palette generators
     * probe for.
     */
    public static Color fromOklab(Oklab lab, float32 alpha) {
        float64 lp = lab.l + 0.3963377774 * lab.a + 0.2158037573 * lab.b;
        float64 mp = lab.l - 0.1055613458 * lab.a - 0.0638541728 * lab.b;
        float64 sp = lab.l - 0.0894841775 * lab.a - 1.2914855480 * lab.b;
        float64 l = lp * lp * lp;
        float64 m = mp * mp * mp;
        float64 s = sp * sp * sp;
        float64 lr = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
        float64 lg = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
        float64 lb = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s;
        float32 sr = Color.linearToSrgbChannel((float32) lr);
        float32 sg = Color.linearToSrgbChannel((float32) lg);
        float32 sb = Color.linearToSrgbChannel((float32) lb);
        return stack Color(sr, sg, sb, alpha);
    }

    /**
     * Whether every channel lies in the sRGB gamut, within a `1e-4`
     * round-trip margin. The explicit out-of-gamut query for
     * {@link #fromOklab}'s unclipped result (§6.5).
     */
    public boolean inSrgbGamut() {
        float32 lo = -0.0001f;
        float32 hi = 1.0001f;
        if (this.r < lo || this.r > hi) { return false; }
        if (this.g < lo || this.g > hi) { return false; }
        if (this.b < lo || this.b > hi) { return false; }
        return true;
    }
}
