package cajeta.math.fft;

import cajeta.math.Tensor;

/**
 * `cajeta.math.fft` — the discrete Fourier transform surface (numpy-porting-plan
 * Phase 8). Complex signals are carried as an **interleaved `float32` tensor**: a
 * length-`N` complex signal is a `Tensor<float32>` of length `2N` with `[2i]` = real
 * and `[2i+1]` = imaginary (the forever-API decision for Milestone B — cajeta has no
 * complex primitive yet; this is exactly the byte layout a future `complex64` dtype
 * would use, so a typed view can layer on later). See the plan §8.
 *
 * `fft`/`ifft` are the radix-2 Cooley-Tukey core (length a power of two): an
 * in-place iterative transform — bit-reversal permutation, then `log2(N)` butterfly
 * stages with twiddle factors `exp(∓2πi·k/len)`. `ifft` conjugates the twiddles
 * (positive sign) and scales by `1/N`, so `ifft(fft(x)) ≈ x`. The CPU floor; the
 * GPU butterfly lowering is a later cross-checked unit. Accumulates in `float32`, so
 * results match a reference DFT to a float tolerance (not bit-exact).
 */
public final class Fft {

    static final float32 TWO_PI = 6.2831853071795864769f;

    /** Forward DFT of an interleaved-`float32` complex signal (length `2N`, `N` a
     *  power of two) → interleaved `float32` of the same length.
     *
     * @EntryPoint
     */
    public static #Tensor<float32> fft(Tensor<float32> x) {
        return Fft.transform(x, false);
    }

    /** Inverse DFT (numpy `ifft`): conjugate twiddles + `1/N` scaling, so
     *  `ifft(fft(x)) ≈ x`. Interleaved `float32` in and out.
     *
     * @EntryPoint
     */
    public static #Tensor<float32> ifft(Tensor<float32> x) {
        return Fft.transform(x, true);
    }

    /** Radix-2 Cooley-Tukey core over an interleaved-`float32` buffer; `inverse`
     *  selects the twiddle sign and the `1/N` epilogue. */
    static #Tensor<float32> transform(Tensor<float32> x, boolean inverse) {
        int64 len2 = x.size();
        int64 n = len2 / 2;
        int64[] shp = heap int64[1];
        shp[0] = len2;
        Tensor<float32> out = Tensor.zeros<float32>(shp);
        int64 c = 0;
        while (c < len2) {
            out.set1(c, x.get1(c));
            c = c + 1;
        }
        // bits = log2(n)
        int32 bits = 0;
        int64 tmp = n;
        while (tmp > 1) {
            tmp = tmp / 2;
            bits = bits + 1;
        }
        // bit-reversal permutation over the n complex samples
        int64 i = 0;
        while (i < n) {
            int64 rev = 0;
            int64 xx = i;
            int32 b = 0;
            while (b < bits) {
                rev = (rev << 1) | (xx & 1);
                xx = xx >> 1;
                b = b + 1;
            }
            if (i < rev) {
                int64 ia = 2 * i;
                int64 ib = 2 * rev;
                float32 ar = out.get1(ia);
                float32 ai = out.get1(ia + 1);
                float32 br = out.get1(ib);
                float32 bi = out.get1(ib + 1);
                out.set1(ia, br);
                out.set1(ia + 1, bi);
                out.set1(ib, ar);
                out.set1(ib + 1, ai);
            }
            i = i + 1;
        }
        // butterfly stages: len = 2, 4, ..., n
        float32 sign = -1.0f;
        if (inverse) { sign = 1.0f; }
        int64 len = 2;
        while (len <= n) {
            int64 half = len / 2;
            float32 flen = (float32) len;
            int64 start = 0;
            while (start < n) {
                int64 k = 0;
                while (k < half) {
                    float32 fk = (float32) k;
                    float32 theta = sign * Fft.TWO_PI * fk / flen;
                    float32 wr = Math.cos(theta);
                    float32 wi = Math.sin(theta);
                    int64 ai = 2 * (start + k);
                    int64 bi = 2 * (start + k + half);
                    float32 ur = out.get1(ai);
                    float32 ui = out.get1(ai + 1);
                    float32 vr = out.get1(bi);
                    float32 vi = out.get1(bi + 1);
                    float32 tr = wr * vr - wi * vi;
                    float32 ti = wr * vi + wi * vr;
                    out.set1(ai, ur + tr);
                    out.set1(ai + 1, ui + ti);
                    out.set1(bi, ur - tr);
                    out.set1(bi + 1, ui - ti);
                    k = k + 1;
                }
                start = start + len;
            }
            len = len * 2;
        }
        if (inverse) {
            float32 invN = 1.0f / (float32) n;
            int64 d = 0;
            while (d < len2) {
                float32 v = out.get1(d) * invN;
                out.set1(d, v);
                d = d + 1;
            }
        }
        return #out;
    }

    /**
     * Sample frequencies for an `n`-point DFT with sample spacing `d` (numpy
     * `fftfreq`): a real `float32` tensor `[0, 1, …, ⌈n/2⌉-1, -⌊n/2⌋, …, -1] / (n·d)`.
     * The non-negative frequencies come first, then the negative ones (numpy order).
     */
    public static #Tensor<float32> fftfreq(int64 n, float32 d) {
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<float32> out = Tensor.zeros<float32>(sh);
        float32 scale = 1.0f / ((float32) n * d);
        int64 half = (n + 1) / 2;          // count of non-negative freqs
        int64 i = 0;
        while (i < n) {
            int64 fval = i;
            if (i >= half) { fval = i - n; }
            float32 v = (float32) fval * scale;
            out.set1(i, v);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Shift the zero-frequency component to the centre of a 1-D real spectrum
     * (numpy `fftshift`): a right roll by `⌊n/2⌋`, so `out[i] = x[(i - ⌊n/2⌋) mod n]`.
     * The `fftfreq` companion for plotting a centred spectrum.
     */
    public static #Tensor<float32> fftshift(Tensor<float32> x) {
        int64 n = x.size();
        int64 s = n / 2;
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<float32> out = Tensor.zeros<float32>(sh);
        int64 i = 0;
        while (i < n) {
            int64 src = (i + n - s) % n;
            float32 v = x.get1(src);
            out.set1(i, v);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Forward DFT of a **real** `float32` signal of length `n` (numpy `rfft`): widens
     * to interleaved (imag = 0), transforms, and returns the non-redundant half
     * spectrum — the first `n/2 + 1` complex bins, as interleaved `float32` of length
     * `2·(n/2+1)`. (`n` a power of two.)
     *
     * @EntryPoint
     */
    public static #Tensor<float32> rfft(Tensor<float32> real) {
        int64 n = real.size();
        int64[] ish = heap int64[1];
        ish[0] = 2 * n;
        Tensor<float32> inter = Tensor.zeros<float32>(ish);
        int64 i = 0;
        while (i < n) {
            float32 rv = real.get1(i);
            inter.set1(2 * i, rv);
            i = i + 1;
        }
        Tensor<float32> full = Fft.fft(inter);
        int64 nb = n / 2 + 1;
        int64[] osh = heap int64[1];
        osh[0] = 2 * nb;
        Tensor<float32> out = Tensor.zeros<float32>(osh);
        int64 k = 0;
        while (k < nb) {
            float32 re = full.get1(2 * k);
            float32 im = full.get1(2 * k + 1);
            out.set1(2 * k, re);
            out.set1(2 * k + 1, im);
            k = k + 1;
        }
        return #out;
    }

    /**
     * Inverse of {@link #rfft} (numpy `irfft`): reconstructs the `n` real samples
     * from the half spectrum `half` (`n/2+1` interleaved complex bins) by restoring
     * the Hermitian-symmetric upper half (`bin[n-k] = conj(bin[k])`), running
     * {@link #ifft}, and taking the real parts. `n` is the original (power-of-two)
     * real length.
     */
    public static #Tensor<float32> irfft(Tensor<float32> half, int64 n) {
        int64[] fsh = heap int64[1];
        fsh[0] = 2 * n;
        Tensor<float32> full = Tensor.zeros<float32>(fsh);
        int64 nh = n / 2;
        int64 k = 0;
        while (k <= nh) {
            float32 re = half.get1(2 * k);
            float32 im = half.get1(2 * k + 1);
            full.set1(2 * k, re);
            full.set1(2 * k + 1, im);
            k = k + 1;
        }
        k = 1;
        while (k < nh) {
            int64 dst = n - k;
            float32 re = half.get1(2 * k);
            float32 im = half.get1(2 * k + 1);
            float32 nim = -im;
            full.set1(2 * dst, re);
            full.set1(2 * dst + 1, nim);
            k = k + 1;
        }
        Tensor<float32> time = Fft.ifft(full);
        int64[] rsh = heap int64[1];
        rsh[0] = n;
        Tensor<float32> out = Tensor.zeros<float32>(rsh);
        int64 i = 0;
        while (i < n) {
            float32 rv = time.get1(2 * i);
            out.set1(i, rv);
            i = i + 1;
        }
        return #out;
    }

    /**
     * N-dimensional DFT (numpy `fftn`/`ifftn`): an interleaved-`float32` complex tensor
     * whose logical complex shape is `dims[0..nd)` (row-major, length `2·∏dims`), FFT'd
     * along every axis in turn. Each axis is a strided walk over its "lines" (fix all
     * other axindices), each line gathered contiguous, transformed by the 1-D core, and
     * scattered back. `ifftn` uses the inverse core, so its per-axis `1/dims[a]` factors
     * accumulate to the numpy `1/∏dims` scaling. Every `dims[a]` must be a power of two.
     */
    static #Tensor<float32> transformN(Tensor<float32> x, int64[] dims, int32 nd, boolean inverse) {
        int64 total = 1;
        int32 d = 0;
        while (d < nd) { total = total * dims[d]; d = d + 1; }
        int64 len = 2 * total;
        int64[] shp = heap int64[1];
        shp[0] = len;
        Tensor<float32> out = Tensor.zeros<float32>(shp);
        int64 c = 0;
        while (c < len) { out.set1(c, x.get1(c)); c = c + 1; }
        int32 a = 0;
        while (a < nd) {
            int64 na = dims[a];
            int64 stride = 1;                              // complex stride along axis a
            int32 j = a + 1;
            while (j < nd) { stride = stride * dims[j]; j = j + 1; }
            int64 blocks = total / (na * stride);          // ∏dims[0..a)
            int64 hi = 0;
            while (hi < blocks) {
                int64 low = 0;
                while (low < stride) {
                    int64 base = hi * (na * stride) + low; // complex index of sample 0
                    int64[] tsh = heap int64[1];
                    tsh[0] = 2 * na;
                    Tensor<float32> line = Tensor.zeros<float32>(tsh);
                    int64 s = 0;
                    while (s < na) {
                        int64 ci = base + s * stride;
                        line.set1(2 * s, out.get1(2 * ci));
                        line.set1(2 * s + 1, out.get1(2 * ci + 1));
                        s = s + 1;
                    }
                    Tensor<float32> fl = Fft.transform(line, inverse);
                    s = 0;
                    while (s < na) {
                        int64 ci = base + s * stride;
                        out.set1(2 * ci, fl.get1(2 * s));
                        out.set1(2 * ci + 1, fl.get1(2 * s + 1));
                        s = s + 1;
                    }
                    low = low + 1;
                }
                hi = hi + 1;
            }
            a = a + 1;
        }
        return #out;
    }

    /** Forward N-D DFT over an interleaved-`float32` tensor of complex shape `dims`. */
    public static #Tensor<float32> fftn(Tensor<float32> x, int64[] dims, int32 nd) {
        return Fft.transformN(x, dims, nd, false);
    }

    /** Inverse N-D DFT (numpy `ifftn`); `1/∏dims` scaled. */
    public static #Tensor<float32> ifftn(Tensor<float32> x, int64[] dims, int32 nd) {
        return Fft.transformN(x, dims, nd, true);
    }

    /** 2-D DFT (numpy `fft2`) of a `rows×cols` interleaved-complex matrix. */
    public static #Tensor<float32> fft2(Tensor<float32> x, int64 rows, int64 cols) {
        int64[] dd = heap int64[2];
        dd[0] = rows;
        dd[1] = cols;
        return Fft.transformN(x, dd, 2, false);
    }

    /** Inverse 2-D DFT (numpy `ifft2`). */
    public static #Tensor<float32> ifft2(Tensor<float32> x, int64 rows, int64 cols) {
        int64[] dd = heap int64[2];
        dd[0] = rows;
        dd[1] = cols;
        return Fft.transformN(x, dd, 2, true);
    }

    /**
     * FFT of a Hermitian-symmetric spectrum → a real signal of length `n` (numpy
     * `hfft`). Uses the identity `hfft(a, n) == irfft(conj(a), n) · n`: conjugate the
     * half spectrum, run {@link #irfft}, and undo its `1/n` by scaling back up.
     */
    public static #Tensor<float32> hfft(Tensor<float32> half, int64 n) {
        int64 m = half.size() / 2;                        // complex bins in `half`
        int64[] hsh = heap int64[1];
        hsh[0] = 2 * m;
        Tensor<float32> conj = Tensor.zeros<float32>(hsh);
        int64 k = 0;
        while (k < m) {
            conj.set1(2 * k, half.get1(2 * k));
            conj.set1(2 * k + 1, -half.get1(2 * k + 1));
            k = k + 1;
        }
        Tensor<float32> r = Fft.irfft(conj, n);
        int64[] rsh = heap int64[1];
        rsh[0] = n;
        Tensor<float32> out = Tensor.zeros<float32>(rsh);
        float32 fn = (float32) n;
        int64 i = 0;
        while (i < n) {
            out.set1(i, r.get1(i) * fn);
            i = i + 1;
        }
        return #out;
    }
}
