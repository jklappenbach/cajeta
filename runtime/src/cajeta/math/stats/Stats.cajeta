package cajeta.math.stats;

import cajeta.math.Tensor;

/**
 * `cajeta.math.stats` — the descriptive-statistics surface (numpy-porting-plan Phase 10):
 * `histogram`/`bincount`/`digitize` (this unit), then `cov`/`corrcoef` and the
 * order-statistics (`quantile`/`percentile`/`median`) in later units. CPU floor; the
 * scatter-heavy ops (`bincount`) have a GPU atomic-scatter lowering as a follow-on.
 */
public final class Stats {

    /**
     * Histogram of `t` over `bins` equal-width buckets spanning `[lo, hi]` (numpy
     * `histogram` counts): a `Tensor<int64>` of length `bins`. Values outside `[lo, hi]`
     * are dropped; a value equal to `hi` falls in the last bin (numpy's closed-right
     * final edge). Flattens the input in C-order.
     *
     * @EntryPoint
     */
    public static #Tensor<int64> histogram<E extends Numeric>(Tensor<E> t, int32 bins, E lo, E hi) {
        int64[] sh = heap int64[1];
        sh[0] = bins;
        Tensor<int64> counts #= Tensor.zeros<int64>(sh);
        E span = hi - lo;
        float32 fspan = (float32) span;
        float32 fbins = (float32) bins;
        int32 nd = t.ndim();
        int64[] idx = heap int64[nd];
        int32 z = 0;
        while (z < nd) { idx[z] = 0; z = z + 1; }
        int64 n = t.size();
        int64 c = 0;
        while (c < n) {
            E x = t.getAt(idx);
            if (x >= lo && x <= hi) {
                E diff = x - lo;
                float32 fd = (float32) diff;
                float32 frac = fd / fspan;
                float32 scaled = frac * fbins;
                int32 b = (int32) scaled;
                if (b == bins) { b = bins - 1; }
                if (b >= 0 && b < bins) {
                    int64 cur = counts.get1(b);
                    counts.set1(b, cur + 1);
                }
            }
            c = c + 1;
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= t.shapeAt(ax)) { idx[ax] = 0; ax = ax - 1; }
                else { carry = false; }
            }
        }
        return #counts;
    }

    /**
     * Count of each non-negative integer value in the 1-D `t` (numpy `bincount`): a
     * `Tensor<int64>` of length `max(t)+1` where `out[v]` is the number of times `v`
     * appears. (Atomic-scatter on the GPU is a later lowering.)
     */
    public static #Tensor<int64> bincount(Tensor<int64> t) {
        int64 n = t.size();
        int64 mx = 0;
        int64 i = 0;
        while (i < n) {
            int64 v = t.get1(i);
            if (v > mx) { mx = v; }
            i = i + 1;
        }
        int64[] sh = heap int64[1];
        sh[0] = mx + 1;
        Tensor<int64> counts #= Tensor.zeros<int64>(sh);
        i = 0;
        while (i < n) {
            int64 v = t.get1(i);
            int64 cur = counts.get1(v);
            counts.set1(v, cur + 1);
            i = i + 1;
        }
        return #counts;
    }

    /**
     * Bin index of each element of the 1-D `t` relative to the monotonically-increasing
     * `edges` (numpy `digitize`, `right=False`): `out[i]` is the count of edges `<= t[i]`,
     * i.e. the `j` with `edges[j-1] <= t[i] < edges[j]`. Returns a `Tensor<int64>` of the
     * same length as `t`.
     */
    public static #Tensor<int64> digitize<E extends Numeric>(Tensor<E> t, Tensor<E> edges) {
        int64 n = t.size();
        int64 ne = edges.size();
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<int64> out #= Tensor.zeros<int64>(sh);
        int64 i = 0;
        while (i < n) {
            E x = t.get1(i);
            int64 cnt = 0;
            int64 e = 0;
            while (e < ne) {
                E ev = edges.get1(e);
                if (ev <= x) { cnt = cnt + 1; }
                e = e + 1;
            }
            out.set1(i, cnt);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Covariance matrix of `m` shaped `(variables, observations)` (numpy `cov`,
     * `rowvar=True`): a `(variables, variables)` `Tensor<E>` with
     * `cov[i,j] = Σ_k (x_i[k]-μ_i)(x_j[k]-μ_j) / (N-1)` (the unbiased `ddof=1`
     * estimator). `E` is `Floating` (the division and means need it).
     */
    public static #Tensor<E> cov<E extends Floating>(Tensor<E> m) {
        int64 v = m.shapeAt(0);
        int64 nobs = m.shapeAt(1);
        int64[] msh = heap int64[1];
        msh[0] = v;
        Tensor<E> means #= Tensor.zeros<E>(msh);
        int64 i = 0;
        while (i < v) {
            E s = (E) 0;
            int64 k = 0;
            while (k < nobs) {
                s = s + m.get2(i, k);
                k = k + 1;
            }
            E mv = s / (E) nobs;
            means.set1(i, mv);
            i = i + 1;
        }
        int64 denom = nobs - 1;
        int64[] sh = heap int64[2];
        sh[0] = v;
        sh[1] = v;
        Tensor<E> out #= Tensor.zeros<E>(sh);
        i = 0;
        while (i < v) {
            E mi = means.get1(i);
            int64 j = 0;
            while (j < v) {
                E mj = means.get1(j);
                E acc = (E) 0;
                int64 k = 0;
                while (k < nobs) {
                    E a = m.get2(i, k) - mi;
                    E b = m.get2(j, k) - mj;
                    acc = acc + a * b;
                    k = k + 1;
                }
                E val = acc / (E) denom;
                out.flatSet(i * v + j, val);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /**
     * Pearson correlation matrix of `m` `(variables, observations)` (numpy
     * `corrcoef`): the covariance normalized by the per-variable standard deviations,
     * `corr[i,j] = cov[i,j] / sqrt(cov[i,i]·cov[j,j])`, so the diagonal is 1 and all
     * entries lie in `[-1, 1]`.
     */
    public static #Tensor<E> corrcoef<E extends Floating>(Tensor<E> m) {
        Tensor<E> c #= Stats.cov<E>(m);
        int64 v = c.shapeAt(0);
        int64[] sh = heap int64[2];
        sh[0] = v;
        sh[1] = v;
        Tensor<E> out #= Tensor.zeros<E>(sh);
        int64 i = 0;
        while (i < v) {
            E cii = c.get2(i, i);
            int64 j = 0;
            while (j < v) {
                E cjj = c.get2(j, j);
                E denom = Math.sqrt(cii * cjj);
                E val = c.get2(i, j) / denom;
                out.flatSet(i * v + j, val);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /**
     * The `q`-th quantile of the flattened input (`q` in `[0,1]`, numpy `quantile`
     * with the default linear interpolation): sorts, then linearly interpolates at
     * position `q·(n-1)`. Returns a scalar `E` (`Floating`).
     *
     * @EntryPoint
     */
    public static E quantile<E extends Floating>(Tensor<E> t, E q) {
        int64 n = t.size();
        int64[] sh = heap int64[1];
        sh[0] = n;
        Tensor<E> flat #= Tensor.zeros<E>(sh);
        int32 nd = t.ndim();
        int64[] idx = heap int64[nd];
        int32 z = 0;
        while (z < nd) { idx[z] = 0; z = z + 1; }
        int64 c = 0;
        while (c < n) {
            flat.set1(c, t.getAt(idx));
            c = c + 1;
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= t.shapeAt(ax)) { idx[ax] = 0; ax = ax - 1; }
                else { carry = false; }
            }
        }
        Tensor<E> s #= Tensor.sort<E>(flat, 0);
        int64 nm1 = n - 1;
        E en = (E) nm1;
        E pos = q * en;
        int64 lo = (int64) pos;
        E elo = (E) lo;
        E frac = pos - elo;
        E vlo = s.get1(lo);
        int64 hi = lo + 1;
        if (hi >= n) {
            return vlo;
        }
        E vhi = s.get1(hi);
        return vlo + frac * (vhi - vlo);
    }

    /** The `p`-th percentile (`p` in `[0,100]`, numpy `percentile`) — `quantile(t, p/100)`. */
    public static E percentile<E extends Floating>(Tensor<E> t, E p) {
        E hundred = (E) 100;
        E q = p / hundred;
        return Stats.quantile<E>(t, q);
    }

    /** The median of the flattened input (numpy `median`) — `quantile(t, 0.5)`. */
    public static E median<E extends Floating>(Tensor<E> t) {
        E half = (E) 0.5f;
        return Stats.quantile<E>(t, half);
    }

    // ------------------------------------------------------------------
    // Special functions (cajeta-ml plan Unit 2; scipy.special parity).
    // Scalar float64, pure cajeta — no compiler intrinsics, no new package
    // (decided 2026-07-29: `cajeta.lang.Math` is the intrinsic registry;
    // these are statistics functions). erf/erfc ride the regularized
    // incomplete gamma (series + Lentz continued fraction over a Lanczos
    // log-gamma) rather than transcribed rational-approximation tables —
    // formulaic and machine-precision at every argument.
    // ------------------------------------------------------------------

    /**
     * Natural log of the gamma function for `x > 0` (scipy `gammaln`) —
     * Lanczos approximation (g=5, n=6), ~1e-15 relative.
     */
    public static float64 gammaLn(float64 x) {
        float64 xx = x;
        float64 y = xx;
        float64 tmp = xx + 5.5;
        tmp = tmp - (xx + 0.5) * Math.log(xx + 5.5);
        float64 ser = 1.000000000190015;
        float64[] cof = [ 76.18009172947146, -86.50532032941677, 24.01409824083091,
                          -1.231739572450155, 0.001208650973866179, -0.000005395239384953 ];
        int64 j = 0;
        while (j < 6) {
            y = y + 1.0;
            ser = ser + cof[j] / y;
            j = j + 1;
        }
        return -tmp + Math.log(2.5066282746310005 * ser / xx);
    }

    /** Regularized lower incomplete gamma P(a,x) by series (x < a+1 regime). */
    static float64 gammPSeries(float64 a, float64 x) {
        float64 ap = a;
        float64 sum = 1.0 / a;
        float64 del = sum;
        int64 n = 0;
        while (n < 200) {
            ap = ap + 1.0;
            del = del * x / ap;
            sum = sum + del;
            float64 ad = del;
            if (ad < 0.0) { ad = -ad; }
            float64 asum = sum;
            if (asum < 0.0) { asum = -asum; }
            if (ad < asum * 0.000000000000001) { break; }
            n = n + 1;
        }
        return sum * Math.exp(-x + a * Math.log(x) - Stats.gammaLn(a));
    }

    /** Regularized upper incomplete gamma Q(a,x) by Lentz continued fraction (x >= a+1). */
    static float64 gammQContinued(float64 a, float64 x) {
        float64 tiny = 0.000000000000000000000000000001;   // 1e-30 floor
        float64 b = x + 1.0 - a;
        float64 c = 1.0 / tiny;
        float64 d = 1.0 / b;
        float64 h = d;
        int64 i = 1;
        while (i <= 200) {
            float64 an = -(float64) i * ((float64) i - a);
            b = b + 2.0;
            d = an * d + b;
            float64 adv = d;
            if (adv < 0.0) { adv = -adv; }
            if (adv < tiny) { d = tiny; }
            c = b + an / c;
            float64 acv = c;
            if (acv < 0.0) { acv = -acv; }
            if (acv < tiny) { c = tiny; }
            d = 1.0 / d;
            float64 del = d * c;
            h = h * del;
            float64 dd = del - 1.0;
            if (dd < 0.0) { dd = -dd; }
            if (dd < 0.000000000000001) { break; }
            i = i + 1;
        }
        return Math.exp(-x + a * Math.log(x) - Stats.gammaLn(a)) * h;
    }

    /**
     * The error function (scipy `erf`): `2/√π ∫₀ˣ e^(−t²) dt`, via
     * `sign(x)·P(1/2, x²)`.
     */
    public static float64 erf(float64 x) {
        if (x == 0.0) { return 0.0; }
        float64 x2 = x * x;
        float64 p = 0.0;
        if (x2 < 1.5) {
            p = Stats.gammPSeries(0.5, x2);
        } else {
            p = 1.0 - Stats.gammQContinued(0.5, x2);
        }
        if (x < 0.0) { return -p; }
        return p;
    }

    /**
     * The complementary error function (scipy `erfc`): `1 − erf(x)`, computed
     * without cancellation in the far tail (`erfc(26) ≈ 5.7e-296` is exact to
     * relative precision, where `1 − erf` would round to 0).
     */
    public static float64 erfc(float64 x) {
        if (x == 0.0) { return 1.0; }
        float64 x2 = x * x;
        if (x < 0.0) {
            if (x2 < 1.5) { return 1.0 + Stats.gammPSeries(0.5, x2); }
            return 2.0 - Stats.gammQContinued(0.5, x2);
        }
        if (x2 < 1.5) { return 1.0 - Stats.gammPSeries(0.5, x2); }
        return Stats.gammQContinued(0.5, x2);
    }

    /**
     * The logistic sigmoid (scipy `expit`): `1/(1+e^(−x))`, branch-split so
     * neither tail overflows (`expit(750) = 1`, `expit(−750) = 0`, exactly
     * scipy's saturation).
     */
    public static float64 expit(float64 x) {
        if (x >= 0.0) {
            return 1.0 / (1.0 + Math.exp(-x));
        }
        float64 e = Math.exp(x);
        return e / (1.0 + e);
    }

    /** Lentz continued fraction for the incomplete beta (NR `betacf`). */
    static float64 betaContinued(float64 a, float64 b, float64 x) {
        float64 tiny = 0.000000000000000000000000000001;   // 1e-30 floor
        float64 qab = a + b;
        float64 qap = a + 1.0;
        float64 qam = a - 1.0;
        float64 c = 1.0;
        float64 d = 1.0 - qab * x / qap;
        float64 adv = d;
        if (adv < 0.0) { adv = -adv; }
        if (adv < tiny) { d = tiny; }
        d = 1.0 / d;
        float64 h = d;
        int64 m = 1;
        while (m <= 200) {
            float64 fm = (float64) m;
            float64 m2 = 2.0 * fm;
            float64 aa = fm * (b - fm) * x / ((qam + m2) * (a + m2));
            d = 1.0 + aa * d;
            adv = d;
            if (adv < 0.0) { adv = -adv; }
            if (adv < tiny) { d = tiny; }
            c = 1.0 + aa / c;
            float64 acv = c;
            if (acv < 0.0) { acv = -acv; }
            if (acv < tiny) { c = tiny; }
            d = 1.0 / d;
            h = h * d * c;
            aa = -(a + fm) * (qab + fm) * x / ((a + m2) * (qap + m2));
            d = 1.0 + aa * d;
            adv = d;
            if (adv < 0.0) { adv = -adv; }
            if (adv < tiny) { d = tiny; }
            c = 1.0 + aa / c;
            acv = c;
            if (acv < 0.0) { acv = -acv; }
            if (acv < tiny) { c = tiny; }
            d = 1.0 / d;
            float64 del = d * c;
            h = h * del;
            float64 dd = del - 1.0;
            if (dd < 0.0) { dd = -dd; }
            if (dd < 0.000000000000001) { break; }
            m = m + 1;
        }
        return h;
    }

    /**
     * The regularized incomplete beta function `I_x(a, b)` (scipy `betainc`)
     * — the workhorse behind the Student-t and F CDFs. NR `betai`: the
     * continued fraction taken on whichever of `x` / `1−x` converges fast.
     * Accuracy class ~1e-10 absolute (the Lanczos prefactor loses a few
     * e-12 through `exp(gammaLn(a+b)−…)` at moderate a,b) — ample for
     * p-values; a higher-order Lanczos is the upgrade path if a consumer
     * ever needs more.
     */
    public static float64 betainc(float64 a, float64 b, float64 x) {
        if (x <= 0.0) { return 0.0; }
        if (x >= 1.0) { return 1.0; }
        float64 lbt = Stats.gammaLn(a + b) - Stats.gammaLn(a) - Stats.gammaLn(b)
                    + a * Math.log(x) + b * Math.log(1.0 - x);
        float64 bt = Math.exp(lbt);
        if (x < (a + 1.0) / (a + b + 2.0)) {
            return bt * Stats.betaContinued(a, b, x) / a;
        }
        return 1.0 - bt * Stats.betaContinued(b, a, 1.0 - x) / b;
    }

    /** Standard normal CDF (scipy `norm.cdf`): `erfc(−x/√2)/2` — tail-safe. */
    public static float64 normalCdf(float64 x) {
        return 0.5 * Stats.erfc(-x / 1.4142135623730951);
    }

    /**
     * Student-t CDF with `df` degrees of freedom (scipy `t.cdf`), via the
     * incomplete beta: the exact p-value backbone for regression inference
     * (cajeta-ml `summary()`).
     */
    public static float64 tCdf(float64 x, float64 df) {
        float64 p = 0.5 * Stats.betainc(0.5 * df, 0.5, df / (df + x * x));
        if (x > 0.0) { return 1.0 - p; }
        return p;
    }
}
