package cajeta.math;

import cajeta.xpu.KernelBuffer;

/**
 * `Storage<T>` — the owning host backing of a `Tensor<T>` (tensor-spec.md §4).
 * One contiguous `T[]` buffer that one *or more* `Tensor` views share; per
 * cajeta's "one axis, one model" (stack = copy / heap = ref), a `heap Storage<T>`
 * is auto-dropped and the global live-set claim frees the buffer exactly once
 * (even when several views share it) — no manual refcount field is needed.
 *
 * ## Device residency (Phase 6, coherence per cajeta-llama Unit 3)
 * A `Storage` also carries an optional **device mirror** — a `cajeta.xpu`
 * `KernelBuffer<T>` (null until first placed on a device). {@link #toDevice}
 * uploads the host buffer, **releases the host mirror** (spec §2.4 — a
 * device-resident model must not also cost full host RAM), and flips
 * `onDevice`; {@link #toHost} reallocates the host buffer lazily and downloads
 * into it. While the data is device-resident, every host accessor faults with
 * a {@link PlacementException} rather than returning stale bytes (spec §2.3) —
 * the host mirror does not exist then, and before it was released the mirror
 * silently served pre-upload values. v1 policy is **eager** (explicit
 * `to`/`cpu`/`gpu`); a no-GPU build still works — the `cajeta.xpu` CPU backend
 * backs the buffer.
 *
 * ## Borrowed slices (spec §4.10, decision 13.12)
 * The borrowing constructor builds a no-copy window over a parent's elements —
 * the host-side mirror of `KernelBuffer.slice(offset, count)`, with the same
 * `owned` flag so the drop chain cannot free a parent's buffer through a
 * slice. The prefill arena carves per-intermediate scratch out of one block
 * with it. A slice is host-only: it cannot move to the device independently
 * (move the owning parent instead; device-side sub-ranges are
 * `KernelBuffer.slice`'s job). Parent-outlives-slice is the caller's
 * responsibility — the same interim borrow-soundness deferral as
 * `KernelBuffer` views.
 *
 * Internal — user code constructs tensors through the `Tensor` factories.
 */
public class Storage<T> {
    T[] host;               // null while the data is device-resident (mirror released)
    int64 length;
    int64 offset;           // element offset into `host` — 0 for owners, the window
                            // start for borrowed slices
    KernelBuffer<T> dev;    // device mirror; null until placed on a device
    boolean onDevice;       // true when the live data is on the device
    boolean owned;          // false for a borrowed slice: drop must not free `host`

    /** Allocate a zero-initialized host buffer of `length` elements (host-resident). */
    public Storage(int64 length) {
        this.length = length;
        this.host = heap T[length];
        this.offset = 0;
        this.dev = null;
        this.onDevice = false;
        this.owned = true;
    }

    /**
     * Borrow a `length`-element window of `parent`'s buffer starting at element
     * `offset` (relative to the parent's own window). No copy: reads and writes
     * through the slice alias the parent's elements. The slice never frees the
     * shared buffer — the plain (non-transfer) field store leaves the field's
     * owned bit clear, so the drop chain's claim skips it; `owned` records the
     * borrow for the residency guards. Offsets accumulate through chained
     * slices, mirroring the mode-2 String window rule (slice-spec §7.1).
     */
    public Storage(Storage<T> parent, int64 offset, int64 length) {
        this.host = parent.host;
        this.length = length;
        this.offset = parent.offset + offset;
        this.dev = null;
        this.onDevice = false;
        this.owned = false;
    }

    /** Element count of the backing buffer (the window, for a borrowed slice). */
    public int64 size() {
        return this.length;
    }

    /** Read the element at linear buffer index `i`. Faults if device-resident.
     *  VIEW of the stored element — borrow, valid while this Storage lives. */
    public T get(int64 i) {
        if (this.onDevice) {
            throw heap PlacementException("Storage.get: the data is device-resident and the host mirror was released — a host read here would return stale bytes. Bring it back with cpu()/toHost() first.");
        }
        return this.host[this.offset + i];
    }

    /** Write `v` to linear buffer index `i`. Faults if device-resident. */
    public void set(int64 i, T v) {
        if (this.onDevice) {
            throw heap PlacementException("Storage.set: the data is device-resident and the host mirror was released — a host write here would be lost on the next download. Bring it back with cpu()/toHost() first.");
        }
        this.host[this.offset + i] = v;
    }

    /**
     * Upload the host buffer to the device (allocating the `KernelBuffer` on
     * first call), RELEASE the host mirror, and mark the data device-resident.
     * Idempotent. Eager-transfer (v1). The release is the point (spec §2.4):
     * keeping both mirrors made a device-resident model cost full host RAM for
     * its lifetime. Borrowed slices cannot move independently — their buffer
     * belongs to the parent.
     */
    public void toDevice() {
        if (this.onDevice) {
            return;
        }
        if (!this.owned) {
            throw heap PlacementException("Storage.toDevice: a borrowed slice cannot move to the device independently — its buffer belongs to the parent. Move the owning Storage, or take a device-side sub-range with KernelBuffer.slice.");
        }
        if (this.dev == null) {
            this.dev = heap KernelBuffer<T>((uint64) this.length);
        }
        this.dev.upload(this.host);
        // Displaced-value release: the field's owned bit is set (the ctor's
        // `heap T[...]` store), so this store frees the mirror.
        this.host = null;
        this.onDevice = true;
    }

    /**
     * Bring the device buffer's contents back to the host and mark
     * host-resident. The host buffer is reallocated lazily — it was released
     * at {@link #toDevice} — then filled by the download.
     */
    public void toHost() {
        if (!this.onDevice) {
            return;
        }
        if (this.host == null) {
            this.host = heap T[this.length];
        }
        this.dev.download(this.host);
        this.onDevice = false;
    }

    /**
     * The HOST buffer, for the op-dispatch seam's host path — the mirror of
     * {@link #deviceBuffer}. Faults if device-resident, exactly as
     * {@link #get} does, so the placement contract is unchanged; the point
     * is that the check happens ONCE per call instead of once per element.
     *
     * VIEW of the host buffer — borrow, valid while this Storage lives, and
     * NOT the window start: pair it with {@link #hostOffset}. A per-element
     * `get(i)` through the generic accessor measured ~12x the cost of the
     * same arithmetic over the raw array, which is the whole reason this
     * exists (cajeta-llama bench/MatvecProbe).
     */
    public T[] hostBuffer() {
        if (this.onDevice) {
            throw heap PlacementException("Storage.hostBuffer: the data is device-resident and the host mirror was released — a host read here would return stale bytes. Bring it back with cpu()/toHost() first.");
        }
        return this.host;
    }

    /** Element offset of this Storage's window into {@link #hostBuffer}. */
    public int64 hostOffset() {
        return this.offset;
    }

    /** `true` when the live data currently resides on the device. */
    public boolean isOnDevice() {
        return this.onDevice;
    }

    /** The device buffer (null until {@link #toDevice}) — for the op-dispatch seam.
     *  VIEW of the device buffer — borrow, valid while this Storage lives. */
    public KernelBuffer<T> deviceBuffer() {
        return this.dev;
    }

    // nucleo-column: the host buffer's data address, for the Arrow interop
    // seam (aligned-offset computation and C-Data export; nucleo-column-spec
    // §4/§6). Instance @Native per the KernelBuffer precedent — a static on a
    // generic class resolves to the uninstantiated template.
    @Native("__cajeta_arrow_addr")
    private int64 dataAddr(T[] a);

    /** Data address of the host buffer (Arrow interop / alignment probes). */
    public int64 hostAddress() {
        return this.dataAddr(this.host);
    }
}
