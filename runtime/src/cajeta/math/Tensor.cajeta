package cajeta.math;

/**
 * `Tensor<T>` — the keystone n-dimensional array (tensor-spec.md). A **strided
 * view** over a shared, refcounted {@link Storage}: `{ Storage<T> data; int64
 * offset; int64[] shape; int64[] strides; }`. The element type is the static,
 * reified type parameter `T` (the dtype lives in `T`; see {@link DType}); the
 * rank and shape are **runtime** (numpy's model — `ndim`/`shape`/`strides` are
 * fields, so `reshape`/variable dims are expressible).
 *
 * This is the Phase 2 core: the type itself + host storage + the construction
 * surface + accessors + RAII ownership. Views/broadcasting/indexing/device are
 * later phases; the only view here is {@link #alias} (a whole-array share, used
 * to exercise the refcount drop-chain). The op library (elementwise/reductions/
 * linalg) is layered on this in `numpy-porting-plan.md`, not here.
 *
 * ## Construction
 * `zeros`/`ones`/`full`/`empty`/`arange`/`of` (+ the `_like` forms) are
 * **method-templated statics** — call them with an explicit element type:
 *
 * ```cajeta
 * int64[] shape = heap int64[2];
 * shape[0] = 2;
 * shape[1] = 3;
 * Tensor<float32> a = Tensor.zeros<float32>(shape);   // 2x3, C-order
 * Tensor<int32>   r = Tensor.arange<int32>(6);        // [0,1,2,3,4,5]
 * ```
 *
 * ## Ownership (RAII)
 * A `Tensor` value is an ordinary handle over its `Storage`. The factories
 * return an owned `#Tensor<T>`; multiple tensors over one `Storage` (an
 * {@link #alias}) share the buffer by refcount, and it frees only when the last
 * drops. C-order is the layout default; {@link #emptyOrdered} builds F-order.
 */
public class Tensor<T> {
    Storage<T> store;
    int64 offsetVal;
    int64[] shapeDims;
    int64[] strideDims;
    boolean viewFlag;
    Tensor<T> baseTensor;

    /**
     * Wrap a `Storage` with an offset + shape + strides. Copies `shape`/`strides`
     * into freshly-owned arrays (so the caller's locals drop cleanly). Takes
     * ownership of `store` (the factories `#`-move it in); a view shares an
     * existing tensor's `store` as a borrow (see {@link #alias}). Internal — use
     * the factories.
     */
    public Tensor(Storage<T> store, int64 offset, int64[] shape, int64[] strides) {
        this.store = store;
        this.offsetVal = offset;
        int32 nd = (int32) shape.count();
        this.shapeDims = heap int64[nd];
        this.strideDims = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            this.shapeDims[i] = shape[i];
            this.strideDims[i] = strides[i];
            i = i + 1;
        }
        this.viewFlag = false;
        this.baseTensor = null;
    }

    // ────────────────────────────── helpers (non-templated) ──────────────────

    /** Product of the dims — the element count of a tensor with this shape. */
    public static int64 productOf(int64[] shape) {
        int64 n = 1;
        int32 nd = (int32) shape.count();
        int32 i = 0;
        while (i < nd) {
            n = n * shape[i];
            i = i + 1;
        }
        return n;
    }

    /**
     * Contiguous strides (in elements) for `shape`: C-order (row-major, the last
     * axis varies fastest) or F-order (column-major, the first axis fastest).
     */
    public static #int64[] contigStrides(int64[] shape, MemoryOrder order) {
        int32 nd = (int32) shape.count();
        int64[] s = heap int64[nd];
        int64 acc = 1;
        if (order == MemoryOrder.F) {
            int32 j = 0;
            while (j < nd) {
                s[j] = acc;
                acc = acc * shape[j];
                j = j + 1;
            }
        } else {
            int32 j = nd - 1;
            while (j >= 0) {
                s[j] = acc;
                acc = acc * shape[j];
                j = j - 1;
            }
        }
        return #s;
    }

    // ────────────────────────────── factories ────────────────────────────────

    /** Uninitialized tensor of `shape` (C-order). Host buffer is zero-filled. */
    public static #Tensor<E> empty<E>(int64[] shape) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        int64[] strides = Tensor.contigStrides(shape, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** Tensor of `shape` in the given {@link MemoryOrder} (`C`/`F`). */
    public static #Tensor<E> emptyOrdered<E>(int64[] shape, MemoryOrder order) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        int64[] strides = Tensor.contigStrides(shape, order);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** Tensor of `shape` filled with the element zero (C-order). */
    public static #Tensor<E> zeros<E>(int64[] shape) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        int64[] strides = Tensor.contigStrides(shape, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** Tensor of `shape` filled with the element one (C-order). */
    public static #Tensor<E> ones<E>(int64[] shape) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        E one = (E) 1;
        int64 i = 0;
        while (i < n) {
            st.set(i, one);
            i = i + 1;
        }
        int64[] strides = Tensor.contigStrides(shape, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** Tensor of `shape` filled with `value` (C-order). */
    public static #Tensor<E> full<E>(int64[] shape, E value) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        int64 i = 0;
        while (i < n) {
            st.set(i, value);
            i = i + 1;
        }
        int64[] strides = Tensor.contigStrides(shape, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** 1-D tensor `[0, 1, …, n-1]` cast to `E`. */
    public static #Tensor<E> arange<E>(int64 n) {
        Storage<E> st = heap Storage<E>(n);
        int64 i = 0;
        while (i < n) {
            E v = (E) i;
            st.set(i, v);
            i = i + 1;
        }
        int64[] shape = heap int64[1];
        shape[0] = n;
        int64[] strides = heap int64[1];
        strides[0] = 1;
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    /** Tensor of `shape` (C-order) holding a copy of the first `size` of `data`. */
    public static #Tensor<E> of<E>(E[] data, int64[] shape) {
        int64 n = Tensor.productOf(shape);
        Storage<E> st = heap Storage<E>(n);
        int64 i = 0;
        while (i < n) {
            E v = data[(int32) i];
            st.set(i, v);
            i = i + 1;
        }
        int64[] strides = Tensor.contigStrides(shape, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shape, strides);
    }

    // `_like` forms — a fresh tensor matching the shape of `src` (C-order).

    public static #int64[] shapeOf<E>(Tensor<E> src) {
        int32 nd = src.ndim();
        int64[] shp = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            shp[i] = src.shapeAt(i);
            i = i + 1;
        }
        return #shp;
    }

    public static #Tensor<E> zerosLike<E>(Tensor<E> src) {
        int64[] shp = Tensor.shapeOf<E>(src);
        int64 n = Tensor.productOf(shp);
        Storage<E> st = heap Storage<E>(n);
        int64[] strides = Tensor.contigStrides(shp, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shp, strides);
    }

    public static #Tensor<E> onesLike<E>(Tensor<E> src) {
        int64[] shp = Tensor.shapeOf<E>(src);
        int64 n = Tensor.productOf(shp);
        Storage<E> st = heap Storage<E>(n);
        E one = (E) 1;
        int64 i = 0;
        while (i < n) {
            st.set(i, one);
            i = i + 1;
        }
        int64[] strides = Tensor.contigStrides(shp, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shp, strides);
    }

    public static #Tensor<E> fullLike<E>(Tensor<E> src, E value) {
        int64[] shp = Tensor.shapeOf<E>(src);
        int64 n = Tensor.productOf(shp);
        Storage<E> st = heap Storage<E>(n);
        int64 i = 0;
        while (i < n) {
            st.set(i, value);
            i = i + 1;
        }
        int64[] strides = Tensor.contigStrides(shp, MemoryOrder.C);
        return heap Tensor<E>(#st, 0, shp, strides);
    }

    // ────────────────────────────── accessors ────────────────────────────────

    /** Number of dimensions. */
    public int32 ndim() {
        return (int32) this.shapeDims.count();
    }

    /** Total element count (product of the shape). */
    public int64 size() {
        return Tensor.productOf(this.shapeDims);
    }

    /** Extent of axis `axis`. */
    public int64 shapeAt(int32 axis) {
        return this.shapeDims[axis];
    }

    /** Stride (in elements) of axis `axis`. */
    public int64 strideAt(int32 axis) {
        return this.strideDims[axis];
    }

    /** Element offset of this tensor into its `Storage`. */
    public int64 offset() {
        return this.offsetVal;
    }

    /** A fresh, owned copy of the shape vector. */
    public #int64[] shape() {
        int32 nd = (int32) this.shapeDims.count();
        int64[] out = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            out[i] = this.shapeDims[i];
            i = i + 1;
        }
        return #out;
    }

    /** The dtype descriptor of `T` (reified, via {@link DType#of}). */
    public #DType dtype() {
        return DType.of<T>();
    }

    /** Bytes per element. */
    public int32 itemsize() {
        DType d = DType.of<T>();
        return d.bytes();
    }

    /** Total bytes of the elements (`size * itemsize`). */
    public int64 nbytes() {
        return this.size() * (int64) this.itemsize();
    }

    /** `true` if this is a view sharing another tensor's `Storage`. */
    public boolean isView() {
        return this.viewFlag;
    }

    /** The tensor this view shares storage with, or `null` if it owns its storage. */
    public Tensor<T> base() {
        return this.baseTensor;
    }

    /** `true` if the strides are C-contiguous (row-major, no gaps). */
    public boolean isContiguous() {
        int32 nd = (int32) this.shapeDims.count();
        int64 acc = 1;
        int32 j = nd - 1;
        while (j >= 0) {
            if (this.strideDims[j] != acc) {
                return false;
            }
            acc = acc * this.shapeDims[j];
            j = j - 1;
        }
        return true;
    }

    // ────────────────────────────── element access ───────────────────────────

    /** Read the element at multi-index `idx` (length must equal `ndim`). */
    public T getAt(int64[] idx) {
        int64 off = this.offsetVal;
        int32 nd = (int32) this.shapeDims.count();
        int32 i = 0;
        while (i < nd) {
            off = off + idx[i] * this.strideDims[i];
            i = i + 1;
        }
        return this.store.get(off);
    }

    /** Write `v` to the element at multi-index `idx`. */
    public void setAt(int64[] idx, T v) {
        int64 off = this.offsetVal;
        int32 nd = (int32) this.shapeDims.count();
        int32 i = 0;
        while (i < nd) {
            off = off + idx[i] * this.strideDims[i];
            i = i + 1;
        }
        this.store.set(off, v);
    }

    /** 1-D element read. */
    public T get1(int64 i) {
        return this.store.get(this.offsetVal + i * this.strideDims[0]);
    }

    /** 1-D element write. */
    public void set1(int64 i, T v) {
        this.store.set(this.offsetVal + i * this.strideDims[0], v);
    }

    /** 2-D element read. */
    public T get2(int64 r, int64 c) {
        return this.store.get(this.offsetVal + r * this.strideDims[0] + c * this.strideDims[1]);
    }

    /** 2-D element write. */
    public void set2(int64 r, int64 c, T v) {
        this.store.set(this.offsetVal + r * this.strideDims[0] + c * this.strideDims[1], v);
    }

    // ────────────────────────────── views (Phase 3) ──────────────────────────

    void markView(Tensor<T> base) {
        this.viewFlag = true;
        this.baseTensor = base;
    }

    /**
     * Build a view of this tensor: a new `Tensor` sharing this tensor's `Storage`
     * (no copy, borrowed) with the given offset/shape/strides. `base()` of the
     * result is the owning root (this, or this's base if this is itself a view).
     * Internal — the structural ops below use it.
     */
    #Tensor<T> makeView(int64 newOffset, int64[] newShape, int64[] newStrides) {
        Tensor<T> v = heap Tensor<T>(this.store, newOffset, newShape, newStrides);
        if (this.viewFlag) {
            v.markView(this.baseTensor);
        } else {
            v.markView(this);
        }
        return #v;
    }

    /**
     * A whole-array view sharing this tensor's `Storage` (no copy) — the simplest
     * view, used to exercise the shared-storage drop-chain. The structural ops
     * (`reshape`/`transpose`/`slice`/`squeeze`/`expandDims`) produce views too.
     */
    public #Tensor<T> alias() {
        return this.makeView(this.offsetVal, this.shapeDims, this.strideDims);
    }

    /**
     * Materialize this tensor's logical elements (C-order) into a fresh, owning,
     * contiguous tensor of `outShape` (which must have the same element count).
     * The backing `Storage` is independent — the source for `copy()` and the
     * non-contiguous `reshape` copy path.
     */
    #Tensor<T> materialize(int64[] outShape) {
        int64 n = this.size();
        Storage<T> st = heap Storage<T>(n);
        int32 nd = (int32) this.shapeDims.count();
        int64[] idx = heap int64[nd];
        int32 k = 0;
        while (k < nd) {
            idx[k] = 0;
            k = k + 1;
        }
        int64 lin = 0;
        while (lin < n) {
            int64 off = this.offsetVal;
            int32 a = 0;
            while (a < nd) {
                off = off + idx[a] * this.strideDims[a];
                a = a + 1;
            }
            T val = this.store.get(off);
            st.set(lin, val);
            lin = lin + 1;
            // increment the multi-index, C-order (last axis varies fastest)
            int32 ax = nd - 1;
            boolean carry = true;
            while (ax >= 0 && carry) {
                idx[ax] = idx[ax] + 1;
                if (idx[ax] >= this.shapeDims[ax]) {
                    idx[ax] = 0;
                    ax = ax - 1;
                } else {
                    carry = false;
                }
            }
        }
        int64[] outStrides = Tensor.contigStrides(outShape, MemoryOrder.C);
        return heap Tensor<T>(#st, 0, outShape, outStrides);
    }

    /**
     * An independent, contiguous (C-order) copy of this tensor — own `Storage`,
     * not a view (mutations do not show through to the source).
     */
    public #Tensor<T> copy() {
        int32 nd = (int32) this.shapeDims.count();
        int64[] shp = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            shp[i] = this.shapeDims[i];
            i = i + 1;
        }
        return this.materialize(shp);
    }

    /**
     * Same data, new shape (same element count). **View** when this tensor is
     * C-contiguous (shares `Storage`); a **copy** otherwise (materialized in
     * logical order) — the documented view/copy contract (tensor-spec.md §4).
     */
    public #Tensor<T> reshape(int64[] newShape) {
        if (this.isContiguous()) {
            int64[] ns = Tensor.contigStrides(newShape, MemoryOrder.C);
            return this.makeView(this.offsetVal, newShape, ns);
        }
        return this.materialize(newShape);
    }

    /**
     * Reverse the axes (full transpose): a **view** with shape and strides
     * reversed. For a 2-D tensor this is the matrix transpose. Shares `Storage`.
     */
    public #Tensor<T> transpose() {
        int32 nd = (int32) this.shapeDims.count();
        int64[] ns = heap int64[nd];
        int64[] nst = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            ns[i] = this.shapeDims[nd - 1 - i];
            nst[i] = this.strideDims[nd - 1 - i];
            i = i + 1;
        }
        return this.makeView(this.offsetVal, ns, nst);
    }

    /**
     * A **view** of the half-open range `[start, stop)` along `axis` (step 1).
     * Shares `Storage`; the offset advances by `start * stride[axis]` and the
     * axis extent becomes `stop - start`. (Negative indices / step land in the
     * full indexing surface, Phase 5.)
     */
    public #Tensor<T> slice(int32 axis, int64 start, int64 stop) {
        int32 nd = (int32) this.shapeDims.count();
        int64[] ns = heap int64[nd];
        int64[] nst = heap int64[nd];
        int32 i = 0;
        while (i < nd) {
            ns[i] = this.shapeDims[i];
            nst[i] = this.strideDims[i];
            i = i + 1;
        }
        ns[axis] = stop - start;
        int64 newOff = this.offsetVal + start * this.strideDims[axis];
        return this.makeView(newOff, ns, nst);
    }

    /**
     * A **view** with every size-1 axis removed (an all-ones tensor squeezes to
     * 1-D `[1]`). Shares `Storage`.
     */
    public #Tensor<T> squeeze() {
        int32 nd = (int32) this.shapeDims.count();
        int32 cnt = 0;
        int32 i = 0;
        while (i < nd) {
            if (this.shapeDims[i] != 1) {
                cnt = cnt + 1;
            }
            i = i + 1;
        }
        if (cnt == 0) {
            cnt = 1;
        }
        int64[] ns = heap int64[cnt];
        int64[] nst = heap int64[cnt];
        ns[0] = 1;
        nst[0] = 1;
        int32 j = 0;
        i = 0;
        while (i < nd) {
            if (this.shapeDims[i] != 1) {
                ns[j] = this.shapeDims[i];
                nst[j] = this.strideDims[i];
                j = j + 1;
            }
            i = i + 1;
        }
        return this.makeView(this.offsetVal, ns, nst);
    }

    /**
     * A **view** with a new size-1 axis inserted at position `axis`. Shares
     * `Storage` (the new axis carries stride 1 — irrelevant for an extent of 1).
     */
    public #Tensor<T> expandDims(int32 axis) {
        int32 nd = (int32) this.shapeDims.count();
        int64[] ns = heap int64[nd + 1];
        int64[] nst = heap int64[nd + 1];
        int32 r = 0;
        int32 w = 0;
        while (w < nd + 1) {
            if (w == axis) {
                ns[w] = 1;
                nst[w] = 1;
            } else {
                ns[w] = this.shapeDims[r];
                nst[w] = this.strideDims[r];
                r = r + 1;
            }
            w = w + 1;
        }
        return this.makeView(this.offsetVal, ns, nst);
    }

    // ────────────────────────────── broadcasting (Phase 4) ───────────────────

    /**
     * The broadcast result-shape of `a` and `b` under the standard right-aligned
     * rule (tensor-spec.md §5): aligning from the trailing axis, each pair must be
     * equal or one must be 1 (or absent), and the result takes the larger. Throws
     * {@link BroadcastException} if any pair is incompatible. The shared primitive
     * every binary op reuses.
     */
    public static #int64[] broadcastShape<E>(int64[] a, int64[] b) {
        int32 na = (int32) a.count();
        int32 nb = (int32) b.count();
        int32 nr = na;
        if (nb > nr) {
            nr = nb;
        }
        int64[] out = heap int64[nr];
        int32 i = 0;
        while (i < nr) {
            int32 ia = na - 1 - i;
            int32 ib = nb - 1 - i;
            int64 da = 1;
            int64 db = 1;
            if (ia >= 0) {
                da = a[ia];
            }
            if (ib >= 0) {
                db = b[ib];
            }
            int64 d = da;
            if (da == db) {
                d = da;
            } else if (da == 1) {
                d = db;
            } else if (db == 1) {
                d = da;
            } else {
                throw heap BroadcastException("incompatible shapes for broadcast");
            }
            out[nr - 1 - i] = d;
            i = i + 1;
        }
        return #out;
    }

    /**
     * A zero-copy **view** of this tensor stretched to `targetShape` (tensor-spec.md
     * §5): right-aligned, each stretched axis (source extent 1, or a missing leading
     * axis) is given **stride 0** so every index along it reads the same element.
     * Shares `Storage`. Throws {@link BroadcastException} if `targetShape` has fewer
     * dims than this tensor or an axis is incompatible (source extent ≠ target and
     * ≠ 1). Self-overlapping (the stride-0 axes alias) — reads are well-defined;
     * in-place writes through it are not, per the §4 aliasing contract.
     */
    public #Tensor<T> broadcastTo(int64[] targetShape) {
        int32 tnd = (int32) targetShape.count();
        int32 nd = (int32) this.shapeDims.count();
        if (nd > tnd) {
            throw heap BroadcastException("cannot broadcast to fewer dimensions");
        }
        int32 lead = tnd - nd;
        int64[] ns = heap int64[tnd];
        int64[] nst = heap int64[tnd];
        int32 i = 0;
        while (i < tnd) {
            int64 tdim = targetShape[i];
            int32 srcAxis = i - lead;
            if (srcAxis < 0) {
                ns[i] = tdim;
                nst[i] = 0;
            } else {
                int64 sdim = this.shapeDims[srcAxis];
                if (sdim == tdim) {
                    ns[i] = tdim;
                    nst[i] = this.strideDims[srcAxis];
                } else if (sdim == 1) {
                    ns[i] = tdim;
                    nst[i] = 0;
                } else {
                    throw heap BroadcastException("incompatible broadcast dimension");
                }
            }
            i = i + 1;
        }
        return this.makeView(this.offsetVal, ns, nst);
    }
}
