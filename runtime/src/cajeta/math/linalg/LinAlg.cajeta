package cajeta.math.linalg;

import cajeta.math.Tensor;

/**
 * `cajeta.math.linalg` — native-cajeta linear-algebra factorizations (numpy-porting-plan
 * Phase 11). Per the approved decision, the backend is **native cajeta over the Tensor/
 * GEMM core — no foreign BLAS/LAPACK** (the "cajeta owns its math" ethos). This unit is
 * the Gaussian-elimination foundation: `solve` (Ax=b), `det`, `inv` — LU with partial
 * pivoting. `qr`/`cholesky`/`lu`/`svd`/`eig` build on this in later units.
 *
 * CPU floor; `E` is `Floating` (elimination needs division). Matrices are 2-D `(n,n)`
 * row-major `Tensor<E>`; the work copies are contiguous so `flatSet(r*n+c, …)` writes
 * and `get2(r,c)` reads address the same layout.
 */
public final class LinAlg {

    /**
     * Solve the square linear system `A·X = B` (numpy `linalg.solve`) by Gaussian
     * elimination with partial pivoting + back-substitution. `A` is `(n,n)`; `B` is
     * `(n,)` or `(n,k)` (multi-RHS — one elimination, `k` back-substitutions); the
     * result has `B`'s shape. The inputs are not modified (works on copies). Throws
     * {@link LinAlgException} on a non-square `A` or a row-count mismatch.
     *
     * @EntryPoint
     */
    public static #Tensor<E> solve<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        if (a.ndim() != 2 || a.shapeAt(0) != a.shapeAt(1)) {
            throw heap LinAlgException("solve: a must be square (n,n)");
        }
        int64 n = a.shapeAt(0);
        if (b.ndim() < 1 || b.ndim() > 2 || b.shapeAt(0) != n) {
            throw heap LinAlgException("solve: b must be (n,) or (n,k) with rows matching a");
        }
        int64 k = 1;
        if (b.ndim() == 2) { k = b.shapeAt(1); }
        Tensor<E> m = a.copy();
        Tensor<E> x = b.copy();
        int64 col = 0;
        while (col < n) {
            // partial pivot: row with the largest |m[r,col]| at or below the diagonal
            int64 piv = col;
            E maxv = LinAlg.absE<E>(m.get2(col, col));
            int64 r = col + 1;
            while (r < n) {
                E av = LinAlg.absE<E>(m.get2(r, col));
                if (av > maxv) { maxv = av; piv = r; }
                r = r + 1;
            }
            if (piv != col) {
                LinAlg.swapRows<E>(m, n, piv, col);
                int64 sc = 0;
                while (sc < k) {
                    E xp = x.flatGet(piv * k + sc);
                    E xc = x.flatGet(col * k + sc);
                    x.flatSet(piv * k + sc, xc);
                    x.flatSet(col * k + sc, xp);
                    sc = sc + 1;
                }
            }
            E diag = m.get2(col, col);
            r = col + 1;
            while (r < n) {
                E factor = m.get2(r, col) / diag;
                int64 c = col;
                while (c < n) {
                    E v = m.get2(r, c) - factor * m.get2(col, c);
                    m.flatSet(r * n + c, v);
                    c = c + 1;
                }
                int64 rc = 0;
                while (rc < k) {
                    E xv = x.flatGet(r * k + rc) - factor * x.flatGet(col * k + rc);
                    x.flatSet(r * k + rc, xv);
                    rc = rc + 1;
                }
                r = r + 1;
            }
            col = col + 1;
        }
        // back-substitution, per RHS column
        int64 bc = 0;
        while (bc < k) {
            int64 i = n - 1;
            while (i >= 0) {
                E s = x.flatGet(i * k + bc);
                int64 c = i + 1;
                while (c < n) {
                    s = s - m.get2(i, c) * x.flatGet(c * k + bc);
                    c = c + 1;
                }
                E xi = s / m.get2(i, i);
                x.flatSet(i * k + bc, xi);
                i = i - 1;
            }
            bc = bc + 1;
        }
        return #x;
    }

    /**
     * Solve the triangular system `T·x = b` (scipy `solve_triangular`) by forward or
     * back substitution — the factor-application primitive `choSolve`/`luSolve` and
     * QR-based `lstsq` stand on. `t` is `(n,n)` with its significant triangle chosen
     * by `lower`; `b` is `(n,)` or `(n,k)` (multi-RHS); the result has `b`'s shape.
     * `unitDiag` treats the diagonal as 1 (stored diagonal values are ignored);
     * `transposed` solves `Tᵀ·x = b` without materializing the transpose. Inputs are
     * not modified. Throws {@link LinAlgException} on a non-square `t`, a row-count
     * mismatch, or — unless `unitDiag` — a zero diagonal (singular).
     *
     * @EntryPoint
     */
    public static #Tensor<E> solveTriangular<E extends Floating>(
            Tensor<E> t, Tensor<E> b, boolean lower, boolean unitDiag, boolean transposed) {
        if (t.ndim() != 2 || t.shapeAt(0) != t.shapeAt(1)) {
            throw heap LinAlgException("solveTriangular: t must be square (n,n)");
        }
        int64 n = t.shapeAt(0);
        if (b.ndim() < 1 || b.ndim() > 2 || b.shapeAt(0) != n) {
            throw heap LinAlgException("solveTriangular: b must be (n,) or (n,k) with rows matching t");
        }
        if (!unitDiag) {
            int64 dc = 0;
            while (dc < n) {
                if (t.get2(dc, dc) == (E) 0) {
                    throw heap LinAlgException("solveTriangular: zero diagonal (singular)");
                }
                dc = dc + 1;
            }
        }
        int64 k = 1;
        if (b.ndim() == 2) { k = b.shapeAt(1); }
        // Transposing swaps the roles of the triangles: solving Lᵀx=b is an
        // upper-triangular (backward) pass reading t[j,i] in place of t[i,j].
        boolean effLower = lower;
        if (transposed) { effLower = !lower; }
        Tensor<E> x = b.copy();
        int64 c = 0;
        while (c < k) {
            if (effLower) {
                // forward substitution
                int64 i = 0;
                while (i < n) {
                    E s = x.flatGet(i * k + c);
                    int64 j = 0;
                    while (j < i) {
                        E tij = t.get2(i, j);
                        if (transposed) { tij = t.get2(j, i); }
                        s = s - tij * x.flatGet(j * k + c);
                        j = j + 1;
                    }
                    if (!unitDiag) { s = s / t.get2(i, i); }
                    x.flatSet(i * k + c, s);
                    i = i + 1;
                }
            } else {
                // back substitution
                int64 i = n - 1;
                while (i >= 0) {
                    E s = x.flatGet(i * k + c);
                    int64 j = i + 1;
                    while (j < n) {
                        E tij = t.get2(i, j);
                        if (transposed) { tij = t.get2(j, i); }
                        s = s - tij * x.flatGet(j * k + c);
                        j = j + 1;
                    }
                    if (!unitDiag) { s = s / t.get2(i, i); }
                    x.flatSet(i * k + c, s);
                    i = i - 1;
                }
            }
            c = c + 1;
        }
        return #x;
    }

    /**
     * Determinant of a square `A` (numpy `linalg.det`) — the product of the pivots from
     * LU with partial pivoting, with the sign flipped once per row swap. Returns a
     * scalar `E`.
     *
     * @EntryPoint
     */
    public static E det<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        Tensor<E> m = a.copy();
        E sign = (E) 1;
        int64 col = 0;
        while (col < n) {
            int64 piv = col;
            E maxv = LinAlg.absE<E>(m.get2(col, col));
            int64 r = col + 1;
            while (r < n) {
                E av = LinAlg.absE<E>(m.get2(r, col));
                if (av > maxv) { maxv = av; piv = r; }
                r = r + 1;
            }
            if (piv != col) {
                LinAlg.swapRows<E>(m, n, piv, col);
                sign = (E) 0 - sign;          // flip sign per row swap
            }
            E diag = m.get2(col, col);
            r = col + 1;
            while (r < n) {
                E factor = m.get2(r, col) / diag;
                int64 c = col;
                while (c < n) {
                    E v = m.get2(r, c) - factor * m.get2(col, c);
                    m.flatSet(r * n + c, v);
                    c = c + 1;
                }
                r = r + 1;
            }
            col = col + 1;
        }
        E prod = sign;
        int64 d = 0;
        while (d < n) {
            prod = prod * m.get2(d, d);
            d = d + 1;
        }
        return prod;
    }

    /**
     * Inverse of a square `A` (numpy `linalg.inv`) — one multi-RHS solve of
     * `A·X = I` (one elimination, `n` back-substitutions; formerly `n` full
     * per-column solves). Returns the `(n,n)` inverse.
     *
     * @EntryPoint
     */
    public static #Tensor<E> inv<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        Tensor<E> ident = Tensor.eye<E>(n);
        Tensor<E> x = LinAlg.solve<E>(a, ident);
        return #x;
    }

    /**
     * Cholesky factorization of a symmetric positive-definite `A` (numpy
     * `linalg.cholesky`): the lower-triangular `L` with `L·Lᵀ = A`. Computed by the
     * standard Cholesky-Banachiewicz recurrence; the strict upper triangle is zero.
     * Returns the `(n,n)` `L`.
     */
    public static #Tensor<E> cholesky<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = n;
        Tensor<E> l = Tensor.zeros<E>(sh);
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j <= i) {
                E sum = a.get2(i, j);
                int64 k = 0;
                while (k < j) {
                    sum = sum - l.get2(i, k) * l.get2(j, k);
                    k = k + 1;
                }
                if (i == j) {
                    E d = Math.sqrt(sum);
                    l.flatSet(i * n + j, d);
                } else {
                    E ljj = l.get2(j, j);
                    E v = sum / ljj;
                    l.flatSet(i * n + j, v);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return #l;
    }

    /**
     * LU factorization with partial pivoting (numpy/scipy `lu`): returns `[P, L, U]`
     * with `A = P·L·U`, where `P` is a permutation matrix, `L` is unit lower-triangular
     * (1s on the diagonal), and `U` is upper-triangular. Native Doolittle elimination on
     * a contiguous copy, storing the multipliers in the strict lower triangle.
     */
    public static #Tensor<E>[] lu<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        Tensor<E> m = a.copy();
        int64[] perm = heap int64[n];
        int64 t = 0;
        while (t < n) { perm[t] = t; t = t + 1; }
        int64 col = 0;
        while (col < n) {
            // partial pivot
            int64 piv = col;
            E maxv = LinAlg.absE<E>(m.get2(col, col));
            int64 r = col + 1;
            while (r < n) {
                E av = LinAlg.absE<E>(m.get2(r, col));
                if (av > maxv) { maxv = av; piv = r; }
                r = r + 1;
            }
            if (piv != col) {
                LinAlg.swapRows<E>(m, n, piv, col);
                int64 pp = perm[piv];
                int64 pc = perm[col];
                perm[piv] = pc;
                perm[col] = pp;
            }
            E diag = m.get2(col, col);
            r = col + 1;
            while (r < n) {
                E factor = m.get2(r, col) / diag;
                m.flatSet(r * n + col, factor);          // multiplier stored in L's slot
                int64 c = col + 1;
                while (c < n) {
                    E v = m.get2(r, c) - factor * m.get2(col, c);
                    m.flatSet(r * n + c, v);
                    c = c + 1;
                }
                r = r + 1;
            }
            col = col + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = n;
        Tensor<E>[] out = heap Tensor<E>[3];
        out[0] = Tensor.zeros<E>(sh);                    // P
        out[1] = Tensor.zeros<E>(sh);                    // L
        out[2] = Tensor.zeros<E>(sh);                    // U
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < n) {
                E mij = m.get2(i, j);
                if (i > j) {
                    out[1].flatSet(i * n + j, mij);
                } else {
                    out[2].flatSet(i * n + j, mij);
                    if (i == j) { out[1].flatSet(i * n + j, (E) 1); }
                }
                j = j + 1;
            }
            // A = P·L·U with (L·U) = the row-permuted A, so P[perm[i]][i] = 1
            int64 pr = perm[i];
            out[0].flatSet(pr * n + i, (E) 1);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Solve the SPD system `A·x = B` from its Cholesky factor (scipy `cho_solve`):
     * `L·y = B` forward, then `Lᵀ·x = y` backward — factor once with
     * {@link #cholesky}, solve many, at half the cost of LU and with no re-factor.
     * `l` is the `(n,n)` lower factor; `b` is `(n,)` or `(n,k)`.
     *
     * @EntryPoint
     */
    public static #Tensor<E> choSolve<E extends Floating>(Tensor<E> l, Tensor<E> b) {
        Tensor<E> y = LinAlg.solveTriangular<E>(l, b, true, false, false);
        Tensor<E> x = LinAlg.solveTriangular<E>(l, y, true, false, true);
        return #x;
    }

    /**
     * Solve `A·x = B` from the `[P, L, U]` bag of {@link #lu} (scipy `lu_solve`):
     * `A = P·L·U`, so apply `Pᵀ` to `B`, forward-substitute through the
     * unit-lower `L`, back-substitute through `U`. `b` is `(n,)` or `(n,k)`.
     *
     * @EntryPoint
     */
    public static #Tensor<E> luSolve<E extends Floating>(
            Tensor<E> p, Tensor<E> l, Tensor<E> u, Tensor<E> b) {
        int64 n = l.shapeAt(0);
        if (b.ndim() < 1 || b.ndim() > 2 || b.shapeAt(0) != n) {
            throw heap LinAlgException("luSolve: b must be (n,) or (n,k) with rows matching l");
        }
        int64 k = 1;
        if (b.ndim() == 2) { k = b.shapeAt(1); }
        Tensor<E> bsrc = b.copy();
        Tensor<E> bp = b.copy();
        // bp = Pᵀ·B (P has exactly one 1 per column: P[perm[i]][i] = 1)
        int64 i = 0;
        while (i < n) {
            int64 c = 0;
            while (c < k) {
                E acc = (E) 0;
                int64 r = 0;
                while (r < n) {
                    acc = acc + p.get2(r, i) * bsrc.flatGet(r * k + c);
                    r = r + 1;
                }
                bp.flatSet(i * k + c, acc);
                c = c + 1;
            }
            i = i + 1;
        }
        Tensor<E> y = LinAlg.solveTriangular<E>(l, bp, true, false, false);
        Tensor<E> x = LinAlg.solveTriangular<E>(u, y, false, false, false);
        return #x;
    }

    /**
     * QR factorization (numpy `linalg.qr`, reduced mode) of a `(m,n)` matrix via
     * Householder reflections. Returns `[Q, R]` with `A = Q·R`: `Q (m,r)` has
     * orthonormal columns, `R (r,n)` is upper-triangular, `r = min(m,n)`. Householder
     * (LAPACK's algorithm) replaces the earlier modified Gram-Schmidt body: MGS loses
     * orthogonality in proportion to `cond(A)`; Householder keeps `‖QᵀQ−I‖ ~ m·ε`
     * regardless. The diagonal of `R` is normalized non-negative (this function's
     * historical convention — MGS produced positive norms; numpy leaves signs free,
     * so compare against numpy up to a per-column sign). Throws
     * {@link LinAlgException} if `a` is not 2-D.
     */
    public static #Tensor<E>[] qr<E extends Floating>(Tensor<E> a) {
        if (a.ndim() != 2) {
            throw heap LinAlgException("qr: a must be 2-D (m,n)");
        }
        int64 m = a.shapeAt(0);
        int64 n = a.shapeAt(1);
        int64 rk = m;
        if (n < m) { rk = n; }
        Tensor<E> w = a.copy();
        int64[] tsh = heap int64[1];
        tsh[0] = rk;
        Tensor<E> tau = Tensor.zeros<E>(tsh);
        // Factor: reflector j (H = I - tau·v·vᵀ, v[j] = 1) zeroes w[j+1.., j].
        // v's tail is stored below the diagonal of column j; R accumulates in
        // the upper triangle of w.
        int64 j = 0;
        while (j < rk) {
            E ss = (E) 0;
            int64 i = j;
            while (i < m) {
                E xv = w.get2(i, j);
                ss = ss + xv * xv;
                i = i + 1;
            }
            E nrm = Math.sqrt(ss);
            if (nrm != (E) 0) {
                E x0 = w.get2(j, j);
                E alpha = nrm;
                if (x0 >= (E) 0) { alpha = (E) 0 - nrm; }   // avoid cancellation in v0
                E v0 = x0 - alpha;
                E tj = ((E) 0 - v0) / alpha;                 // tau = (alpha - x0)/alpha
                tau.set1(j, tj);
                i = j + 1;
                while (i < m) {
                    w.flatSet(i * n + j, w.get2(i, j) / v0); // store v (v[j]=1 implicit)
                    i = i + 1;
                }
                w.flatSet(j * n + j, alpha);                 // R[j,j] pre-normalization
                // apply H_j to the trailing columns
                int64 c = j + 1;
                while (c < n) {
                    E s = w.get2(j, c);
                    i = j + 1;
                    while (i < m) {
                        s = s + w.get2(i, j) * w.get2(i, c);
                        i = i + 1;
                    }
                    s = s * tj;
                    w.flatSet(j * n + c, w.get2(j, c) - s);
                    i = j + 1;
                    while (i < m) {
                        w.flatSet(i * n + c, w.get2(i, c) - s * w.get2(i, j));
                        i = i + 1;
                    }
                    c = c + 1;
                }
            }
            j = j + 1;
        }
        int64[] qsh = heap int64[2];
        qsh[0] = m;
        qsh[1] = rk;
        int64[] rsh = heap int64[2];
        rsh[0] = rk;
        rsh[1] = n;
        Tensor<E>[] out = heap Tensor<E>[2];
        out[0] = Tensor.zeros<E>(qsh);                       // Q
        out[1] = Tensor.zeros<E>(rsh);                       // R
        int64 ri = 0;
        while (ri < rk) {
            int64 rc = ri;
            while (rc < n) {
                out[1].flatSet(ri * n + rc, w.get2(ri, rc));
                rc = rc + 1;
            }
            ri = ri + 1;
        }
        // Q = H_0 · … · H_{rk-1} applied to the first rk columns of I(m):
        // reflectors in reverse order over the growing identity block.
        int64 qc = 0;
        while (qc < rk) {
            out[0].flatSet(qc * rk + qc, (E) 1);
            qc = qc + 1;
        }
        j = rk - 1;
        while (j >= 0) {
            E tj = tau.get1(j);
            if (tj != (E) 0) {
                int64 c = 0;
                while (c < rk) {
                    E s = out[0].flatGet(j * rk + c);
                    int64 i = j + 1;
                    while (i < m) {
                        s = s + w.get2(i, j) * out[0].flatGet(i * rk + c);
                        i = i + 1;
                    }
                    s = s * tj;
                    out[0].flatSet(j * rk + c, out[0].flatGet(j * rk + c) - s);
                    i = j + 1;
                    while (i < m) {
                        out[0].flatSet(i * rk + c, out[0].flatGet(i * rk + c) - s * w.get2(i, j));
                        i = i + 1;
                    }
                    c = c + 1;
                }
            }
            j = j - 1;
        }
        // normalize diag(R) >= 0: flip R's row j and Q's column j together
        int64 dj = 0;
        while (dj < rk) {
            if (out[1].get2(dj, dj) < (E) 0) {
                int64 rc = dj;
                while (rc < n) {
                    out[1].flatSet(dj * n + rc, (E) 0 - out[1].get2(dj, rc));
                    rc = rc + 1;
                }
                int64 qi = 0;
                while (qi < m) {
                    out[0].flatSet(qi * rk + dj, (E) 0 - out[0].get2(qi, dj));
                    qi = qi + 1;
                }
            }
            dj = dj + 1;
        }
        return #out;
    }

    /**
     * Symmetric eigendecomposition (numpy `linalg.eigh`) by the cyclic **Jacobi**
     * rotation method: for a symmetric `A`, returns `[w, V]` with ascending eigenvalues
     * `w` (length-`n` vector) and orthonormal eigenvector columns `V` (`n,n`), so
     * `A·V = V·diag(w)`. Each sweep zeros every off-diagonal in turn via a 2-sided
     * Givens rotation; converges quadratically. Native — no foreign LAPACK.
     */
    public static #Tensor<E>[] eigh<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        Tensor<E> m = a.copy();
        Tensor<E> v = Tensor.eye<E>(n);
        E eps = (E) 1 / (E) 10000000;            // off-diagonal convergence floor (~1e-7)
        E eps2 = (E) 1 / (E) 100000000;          // per-element skip floor (~1e-8)
        int64 sweep = 0;
        while (sweep < 100) {
            E off = (E) 0;
            int64 p = 0;
            while (p < n) {
                int64 q = p + 1;
                while (q < n) {
                    E mpq = m.get2(p, q);
                    E ampq = mpq;
                    if (ampq < (E) 0) { ampq = (E) 0 - ampq; }
                    off = off + ampq;
                    q = q + 1;
                }
                p = p + 1;
            }
            if (off < eps) {
                sweep = 100;                       // converged → exit the sweep loop
            } else {
                p = 0;
                while (p < n) {
                    int64 q = p + 1;
                    while (q < n) {
                        E apq = m.get2(p, q);
                        E aapq = apq;
                        if (aapq < (E) 0) { aapq = (E) 0 - aapq; }
                        if (aapq > eps2) {
                            E app = m.get2(p, p);
                            E aqq = m.get2(q, q);
                            E tau = (aqq - app) / (apq + apq);
                            E denom = Math.sqrt((E) 1 + tau * tau);
                            E t = (E) 0;
                            if (tau >= (E) 0) { t = (E) 1 / (tau + denom); }
                            else { t = (E) 0 - ((E) 1 / (denom - tau)); }
                            E c = (E) 1 / Math.sqrt((E) 1 + t * t);
                            E s = t * c;
                            // rotate columns p,q of m
                            int64 i = 0;
                            while (i < n) {
                                E mip = m.get2(i, p);
                                E miq = m.get2(i, q);
                                m.flatSet(i * n + p, c * mip - s * miq);
                                m.flatSet(i * n + q, s * mip + c * miq);
                                i = i + 1;
                            }
                            // rotate rows p,q of m
                            i = 0;
                            while (i < n) {
                                E mpi = m.get2(p, i);
                                E mqi = m.get2(q, i);
                                m.flatSet(p * n + i, c * mpi - s * mqi);
                                m.flatSet(q * n + i, s * mpi + c * mqi);
                                i = i + 1;
                            }
                            // accumulate the rotation into the eigenvector matrix
                            i = 0;
                            while (i < n) {
                                E vip = v.get2(i, p);
                                E viq = v.get2(i, q);
                                v.flatSet(i * n + p, c * vip - s * viq);
                                v.flatSet(i * n + q, s * vip + c * viq);
                                i = i + 1;
                            }
                        }
                        q = q + 1;
                    }
                    p = p + 1;
                }
            }
            sweep = sweep + 1;
        }
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = n;
        int64[] vs = heap int64[1];
        vs[0] = n;
        Tensor<E>[] out = heap Tensor<E>[2];
        out[0] = Tensor.zeros<E>(vs);            // eigenvalues w
        out[1] = Tensor.zeros<E>(sh);            // eigenvectors V (columns)
        int64 d = 0;
        while (d < n) {
            E dv = m.get2(d, d);
            out[0].set1(d, dv);
            int64 rr = 0;
            while (rr < n) {
                E vv = v.get2(rr, d);
                out[1].flatSet(rr * n + d, vv);
                rr = rr + 1;
            }
            d = d + 1;
        }
        // sort eigenvalues ascending, carrying eigenvector columns (numpy eigh order)
        int64 ii = 0;
        while (ii < n) {
            int64 mn = ii;
            E mnv = out[0].get1(ii);
            int64 jj = ii + 1;
            while (jj < n) {
                E cand = out[0].get1(jj);
                if (cand < mnv) { mnv = cand; mn = jj; }
                jj = jj + 1;
            }
            if (mn != ii) {
                E a0 = out[0].get1(ii);
                E a1 = out[0].get1(mn);
                out[0].set1(ii, a1);
                out[0].set1(mn, a0);
                int64 rr = 0;
                while (rr < n) {
                    E c0 = out[1].get2(rr, ii);
                    E c1 = out[1].get2(rr, mn);
                    out[1].flatSet(rr * n + ii, c1);
                    out[1].flatSet(rr * n + mn, c0);
                    rr = rr + 1;
                }
            }
            ii = ii + 1;
        }
        return #out;
    }

    /** `sqrt(a² + b²)` without destructive under/overflow (NR `pythag`). */
    private static E pythag<E extends Floating>(E a, E b) {
        E aa = LinAlg.absE<E>(a);
        E ab = LinAlg.absE<E>(b);
        if (aa > ab) {
            E r = ab / aa;
            return aa * Math.sqrt((E) 1 + r * r);
        }
        if (ab == (E) 0) {
            return (E) 0;
        }
        E r2 = aa / ab;
        return ab * Math.sqrt((E) 1 + r2 * r2);
    }

    /** Machine epsilon of `E`, computed at runtime (2⁻⁵² f64, 2⁻²³ f32). */
    private static E machEps<E extends Floating>() {
        E eps = (E) 1;
        E half = (E) 1 / (E) 2;
        while ((E) 1 + eps * half != (E) 1) {
            eps = eps * half;
        }
        return eps;
    }

    /**
     * Singular value decomposition (numpy `linalg.svd`, reduced mode) of a `(m,n)`
     * matrix: `[U (m,r), S (r,), Vt (r,n)]`, `r = min(m,n)`, `A = U·diag(S)·Vt`,
     * `S` **descending**, `U`/`V` orthonormal columns. Golub–Kahan–Reinsch: Householder
     * bidiagonalization + implicit-shift QR on the bidiagonal (the NR `svdcmp`
     * algorithm) — full accuracy at every conditioning, unlike the earlier
     * `eigh(AᵀA)` route, whose Gram matrix squares the condition number and loses
     * half the digits of the small singular values. `m < n` is handled by
     * factoring `Aᵀ` and swapping the factors. Throws {@link LinAlgException} if
     * `a` is not 2-D or the QR iteration fails to converge (30-sweep cap).
     *
     * @EntryPoint
     */
    public static #Tensor<E>[] svd<E extends Floating>(Tensor<E> a) {
        if (a.ndim() != 2) {
            throw heap LinAlgException("svd: a must be 2-D (m,n)");
        }
        int64 am = a.shapeAt(0);
        int64 an = a.shapeAt(1);
        if (am >= an) {
            Tensor<E> w = a.copy();
            Tensor<E>[] core = LinAlg.svdCore<E>(w, am, an);
            return #core;
        }
        // m < n: factor Aᵀ (n,m), then A = U·S·Vt with U = V'ᵀᵀ… i.e. swap:
        // Aᵀ = U'·S·Vt'  ⇒  A = Vt'ᵀ·S·U'ᵀ
        int64[] tsh = heap int64[2];
        tsh[0] = an;
        tsh[1] = am;
        Tensor<E> at = Tensor.zeros<E>(tsh);
        int64 ti = 0;
        while (ti < an) {
            int64 tj = 0;
            while (tj < am) {
                at.flatSet(ti * am + tj, a.get2(tj, ti));
                tj = tj + 1;
            }
            ti = ti + 1;
        }
        Tensor<E>[] core = LinAlg.svdCore<E>(at, an, am);   // U' (n,m), S (m), Vt' (m,m)
        int64 r = am;
        int64[] ush = heap int64[2];
        ush[0] = am;
        ush[1] = r;
        int64[] vsh = heap int64[2];
        vsh[0] = r;
        vsh[1] = an;
        int64[] ssh = heap int64[1];
        ssh[0] = r;
        Tensor<E>[] out = heap Tensor<E>[3];
        out[0] = Tensor.zeros<E>(ush);                       // U = Vt'ᵀ (m,r)
        out[1] = Tensor.zeros<E>(ssh);                       // S (copied: core owns its element)
        out[2] = Tensor.zeros<E>(vsh);                       // Vt = U'ᵀ (r,n)
        int64 si = 0;
        while (si < r) {
            out[1].set1(si, core[1].get1(si));
            si = si + 1;
        }
        int64 i = 0;
        while (i < am) {
            int64 j = 0;
            while (j < r) {
                out[0].flatSet(i * r + j, core[2].get2(j, i));
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < r) {
            int64 j = 0;
            while (j < an) {
                out[2].flatSet(i * an + j, core[0].get2(j, i));
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /**
     * Golub–Kahan–Reinsch worker for `m ≥ n`: consumes the `(m,n)` working copy `u`
     * (overwritten with the left vectors), returns `[U (m,n), S (n,), Vt (n,n)]`
     * sorted descending. 0-indexed port of the NR `svdcmp` recurrence.
     */
    private static #Tensor<E>[] svdCore<E extends Floating>(Tensor<E> u, int64 m, int64 n) {
        int64[] vs = heap int64[1];
        vs[0] = n;
        Tensor<E> w = Tensor.zeros<E>(vs);                   // singular values
        Tensor<E> rv1 = Tensor.zeros<E>(vs);                 // superdiagonal workspace
        int64[] vsh = heap int64[2];
        vsh[0] = n;
        vsh[1] = n;
        Tensor<E> v = Tensor.zeros<E>(vsh);
        E g = (E) 0;
        E scale = (E) 0;
        E anorm = (E) 0;
        // --- Householder bidiagonalization ---
        int64 i = 0;
        int64 l = 0;
        while (i < n) {
            l = i + 1;
            rv1.set1(i, scale * g);
            g = (E) 0;
            scale = (E) 0;
            if (i < m) {
                int64 k = i;
                while (k < m) {
                    scale = scale + LinAlg.absE<E>(u.get2(k, i));
                    k = k + 1;
                }
                if (scale != (E) 0) {
                    E s = (E) 0;
                    k = i;
                    while (k < m) {
                        E uk = u.get2(k, i) / scale;
                        u.flatSet(k * n + i, uk);
                        s = s + uk * uk;
                        k = k + 1;
                    }
                    E f = u.get2(i, i);
                    g = Math.sqrt(s);
                    if (f >= (E) 0) { g = (E) 0 - g; }       // g = -SIGN(sqrt(s), f)
                    E h = f * g - s;
                    u.flatSet(i * n + i, f - g);
                    int64 j = l;
                    while (j < n) {
                        E s2 = (E) 0;
                        k = i;
                        while (k < m) {
                            s2 = s2 + u.get2(k, i) * u.get2(k, j);
                            k = k + 1;
                        }
                        E f2 = s2 / h;
                        k = i;
                        while (k < m) {
                            u.flatSet(k * n + j, u.get2(k, j) + f2 * u.get2(k, i));
                            k = k + 1;
                        }
                        j = j + 1;
                    }
                    k = i;
                    while (k < m) {
                        u.flatSet(k * n + i, u.get2(k, i) * scale);
                        k = k + 1;
                    }
                }
            }
            w.set1(i, scale * g);
            g = (E) 0;
            scale = (E) 0;
            if (i < m && i != n - 1) {
                int64 k = l;
                while (k < n) {
                    scale = scale + LinAlg.absE<E>(u.get2(i, k));
                    k = k + 1;
                }
                if (scale != (E) 0) {
                    E s = (E) 0;
                    k = l;
                    while (k < n) {
                        E uk = u.get2(i, k) / scale;
                        u.flatSet(i * n + k, uk);
                        s = s + uk * uk;
                        k = k + 1;
                    }
                    E f = u.get2(i, l);
                    g = Math.sqrt(s);
                    if (f >= (E) 0) { g = (E) 0 - g; }
                    E h = f * g - s;
                    u.flatSet(i * n + l, f - g);
                    k = l;
                    while (k < n) {
                        rv1.set1(k, u.get2(i, k) / h);
                        k = k + 1;
                    }
                    int64 j = l;
                    while (j < m) {
                        E s2 = (E) 0;
                        k = l;
                        while (k < n) {
                            s2 = s2 + u.get2(j, k) * u.get2(i, k);
                            k = k + 1;
                        }
                        k = l;
                        while (k < n) {
                            u.flatSet(j * n + k, u.get2(j, k) + s2 * rv1.get1(k));
                            k = k + 1;
                        }
                        j = j + 1;
                    }
                    k = l;
                    while (k < n) {
                        u.flatSet(i * n + k, u.get2(i, k) * scale);
                        k = k + 1;
                    }
                }
            }
            E cn = LinAlg.absE<E>(w.get1(i)) + LinAlg.absE<E>(rv1.get1(i));
            if (cn > anorm) { anorm = cn; }
            i = i + 1;
        }
        // --- accumulate right-hand transforms V ---
        i = n - 1;
        while (i >= 0) {
            if (i < n - 1) {
                if (g != (E) 0) {
                    int64 j = l;
                    while (j < n) {
                        v.flatSet(j * n + i, (u.get2(i, j) / u.get2(i, l)) / g);
                        j = j + 1;
                    }
                    j = l;
                    while (j < n) {
                        E s = (E) 0;
                        int64 k = l;
                        while (k < n) {
                            s = s + u.get2(i, k) * v.get2(k, j);
                            k = k + 1;
                        }
                        k = l;
                        while (k < n) {
                            v.flatSet(k * n + j, v.get2(k, j) + s * v.get2(k, i));
                            k = k + 1;
                        }
                        j = j + 1;
                    }
                }
                int64 j2 = l;
                while (j2 < n) {
                    v.flatSet(i * n + j2, (E) 0);
                    v.flatSet(j2 * n + i, (E) 0);
                    j2 = j2 + 1;
                }
            }
            v.flatSet(i * n + i, (E) 1);
            g = rv1.get1(i);
            l = i;
            i = i - 1;
        }
        // --- accumulate left-hand transforms U ---
        i = n - 1;
        while (i >= 0) {
            l = i + 1;
            g = w.get1(i);
            int64 j = l;
            while (j < n) {
                u.flatSet(i * n + j, (E) 0);
                j = j + 1;
            }
            if (g != (E) 0) {
                g = (E) 1 / g;
                j = l;
                while (j < n) {
                    E s = (E) 0;
                    int64 k = l;
                    while (k < m) {
                        s = s + u.get2(k, i) * u.get2(k, j);
                        k = k + 1;
                    }
                    E f = (s / u.get2(i, i)) * g;
                    k = i;
                    while (k < m) {
                        u.flatSet(k * n + j, u.get2(k, j) + f * u.get2(k, i));
                        k = k + 1;
                    }
                    j = j + 1;
                }
                j = i;
                while (j < m) {
                    u.flatSet(j * n + i, u.get2(j, i) * g);
                    j = j + 1;
                }
            } else {
                j = i;
                while (j < m) {
                    u.flatSet(j * n + i, (E) 0);
                    j = j + 1;
                }
            }
            u.flatSet(i * n + i, u.get2(i, i) + (E) 1);
            i = i - 1;
        }
        // --- diagonalize the bidiagonal form (implicit-shift QR) ---
        int64 k = n - 1;
        while (k >= 0) {
            int64 its = 1;
            while (its <= 30) {
                boolean flag = true;
                int64 nm = 0;
                l = k;
                while (l >= 0) {
                    nm = l - 1;
                    if (LinAlg.absE<E>(rv1.get1(l)) + anorm == anorm) {
                        flag = false;
                        break;
                    }
                    if (LinAlg.absE<E>(w.get1(nm)) + anorm == anorm) {
                        break;
                    }
                    l = l - 1;
                }
                if (flag) {
                    // cancel rv1[l] against the zero w[nm]
                    E c = (E) 0;
                    E s = (E) 1;
                    i = l;
                    while (i <= k) {
                        E f = s * rv1.get1(i);
                        rv1.set1(i, c * rv1.get1(i));
                        if (LinAlg.absE<E>(f) + anorm == anorm) {
                            break;
                        }
                        g = w.get1(i);
                        E h = LinAlg.pythag<E>(f, g);
                        w.set1(i, h);
                        h = (E) 1 / h;
                        c = g * h;
                        s = (E) 0 - f * h;
                        int64 j = 0;
                        while (j < m) {
                            E y = u.get2(j, nm);
                            E z = u.get2(j, i);
                            u.flatSet(j * n + nm, y * c + z * s);
                            u.flatSet(j * n + i, z * c - y * s);
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                }
                E z = w.get1(k);
                if (l == k) {
                    if (z < (E) 0) {
                        w.set1(k, (E) 0 - z);
                        int64 j = 0;
                        while (j < n) {
                            v.flatSet(j * n + k, (E) 0 - v.get2(j, k));
                            j = j + 1;
                        }
                    }
                    break;
                }
                if (its == 30) {
                    throw heap LinAlgException("svd: no convergence in 30 iterations");
                }
                E x = w.get1(l);
                nm = k - 1;
                E y = w.get1(nm);
                g = rv1.get1(nm);
                E h = rv1.get1(k);
                E f = ((y - z) * (y + z) + (g - h) * (g + h)) / ((E) 2 * h * y);
                g = LinAlg.pythag<E>(f, (E) 1);
                E gs = LinAlg.absE<E>(g);
                if (f < (E) 0) { gs = (E) 0 - gs; }          // SIGN(g, f)
                f = ((x - z) * (x + z) + h * ((y / (f + gs)) - h)) / x;
                E c = (E) 1;
                E s = (E) 1;
                int64 j = l;
                while (j <= nm) {
                    i = j + 1;
                    g = rv1.get1(i);
                    y = w.get1(i);
                    h = s * g;
                    g = c * g;
                    z = LinAlg.pythag<E>(f, h);
                    rv1.set1(j, z);
                    c = f / z;
                    s = h / z;
                    f = x * c + g * s;
                    g = g * c - x * s;
                    h = y * s;
                    y = y * c;
                    int64 jj = 0;
                    while (jj < n) {
                        E xv = v.get2(jj, j);
                        E zv = v.get2(jj, i);
                        v.flatSet(jj * n + j, xv * c + zv * s);
                        v.flatSet(jj * n + i, zv * c - xv * s);
                        jj = jj + 1;
                    }
                    z = LinAlg.pythag<E>(f, h);
                    w.set1(j, z);
                    if (z != (E) 0) {
                        z = (E) 1 / z;
                        c = f * z;
                        s = h * z;
                    }
                    f = c * g + s * y;
                    x = c * y - s * g;
                    jj = 0;
                    while (jj < m) {
                        E yu = u.get2(jj, j);
                        E zu = u.get2(jj, i);
                        u.flatSet(jj * n + j, yu * c + zu * s);
                        u.flatSet(jj * n + i, zu * c - yu * s);
                        jj = jj + 1;
                    }
                    j = j + 1;
                }
                rv1.set1(l, (E) 0);
                rv1.set1(k, f);
                w.set1(k, x);
                its = its + 1;
            }
            k = k - 1;
        }
        // --- sort descending: swap w entries + U columns + V columns ---
        int64 sa = 0;
        while (sa < n) {
            int64 best = sa;
            int64 sb = sa + 1;
            while (sb < n) {
                if (w.get1(sb) > w.get1(best)) { best = sb; }
                sb = sb + 1;
            }
            if (best != sa) {
                E tw = w.get1(sa);
                w.set1(sa, w.get1(best));
                w.set1(best, tw);
                int64 rr = 0;
                while (rr < m) {
                    E tu = u.get2(rr, sa);
                    u.flatSet(rr * n + sa, u.get2(rr, best));
                    u.flatSet(rr * n + best, tu);
                    rr = rr + 1;
                }
                rr = 0;
                while (rr < n) {
                    E tv = v.get2(rr, sa);
                    v.flatSet(rr * n + sa, v.get2(rr, best));
                    v.flatSet(rr * n + best, tv);
                    rr = rr + 1;
                }
            }
            sa = sa + 1;
        }
        // --- pack [U, S, Vt] into fresh outputs (u/w/v are locals or borrows;
        // returned tensors must own their storage) ---
        int64[] ush = heap int64[2];
        ush[0] = m;
        ush[1] = n;
        Tensor<E>[] out = heap Tensor<E>[3];
        out[0] = Tensor.zeros<E>(ush);
        out[1] = Tensor.zeros<E>(vs);
        out[2] = Tensor.zeros<E>(vsh);
        int64 ui = 0;
        while (ui < m) {
            int64 uj = 0;
            while (uj < n) {
                out[0].flatSet(ui * n + uj, u.get2(ui, uj));
                uj = uj + 1;
            }
            ui = ui + 1;
        }
        int64 vi = 0;
        while (vi < n) {
            out[1].set1(vi, w.get1(vi));
            int64 vj = 0;
            while (vj < n) {
                out[2].flatSet(vi * n + vj, v.get2(vj, vi));
                vj = vj + 1;
            }
            vi = vi + 1;
        }
        return #out;
    }

    /**
     * Moore-Penrose pseudo-inverse (numpy `linalg.pinv`) of a `(m,n)` matrix:
     * `A⁺ = V·diag(1/σ)·Uᵀ` `(n,m)`, with singular values `σ ≤ tol` zeroed
     * (`tol = σmax·max(m,n)·ε`, numpy's lstsq/matrix_rank cutoff semantics — the
     * bidiagonal svd earns the tight tolerance the old Gram route could not).
     * Equals `inv` for a nonsingular square `A`; gives the least-squares
     * minimum-norm solution for rank-deficient or rectangular `A`.
     */
    public static #Tensor<E> pinv<E extends Floating>(Tensor<E> a) {
        if (a.ndim() != 2) {
            throw heap LinAlgException("pinv: a must be 2-D (m,n)");
        }
        int64 m = a.shapeAt(0);
        int64 n = a.shapeAt(1);
        int64 r = m;
        if (n < m) { r = n; }
        Tensor<E>[] sv = LinAlg.svd<E>(a);
        Tensor<E> u = sv[0];                      // (m,r)
        Tensor<E> s = sv[1];                      // (r,)
        Tensor<E> vt = sv[2];                     // (r,n)
        E smax = s.get1(0);                       // descending → [0] is largest
        E mx = (E) m;
        if (n > m) { mx = (E) n; }
        E tol = smax * mx * LinAlg.machEps<E>();
        int64[] sh = heap int64[2];
        sh[0] = n;
        sh[1] = m;
        Tensor<E> out = Tensor.zeros<E>(sh);
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < m) {
                E acc = (E) 0;
                int64 k = 0;
                while (k < r) {
                    E sk = s.get1(k);
                    if (sk > tol) {
                        // A⁺[i][j] = Σ_k V[i][k]·(1/σ_k)·Uᵀ[k][j] = Σ Vt[k][i]·(1/σ_k)·U[j][k]
                        acc = acc + vt.get2(k, i) * ((E) 1 / sk) * u.get2(j, k);
                    }
                    k = k + 1;
                }
                out.flatSet(i * m + j, acc);
                j = j + 1;
            }
            i = i + 1;
        }
        return #out;
    }

    /**
     * Least-squares solution of `A·x ≈ B` (numpy `linalg.lstsq`) for a full-rank
     * `(m,n)` design matrix, `m ≥ n`: Householder QR, `x = R⁻¹·(Qᵀ·B)` — the
     * numerically-correct regression path (sklearn's LinearRegression algorithm).
     * `B` is `(m,)` or `(m,k)` (multi-RHS); the result is `(n,)` / `(n,k)`. For a
     * nonsingular square `A` this equals `solve`. Rank-deficient input (any shape)
     * and the underdetermined case `m < n` take the svd minimum-norm path
     * (`x = A⁺·B`, numpy semantics); deficiency is detected on `diag(R)` at the
     * `rmax·max(m,n)·ε` scale.
     */
    public static #Tensor<E> lstsq<E extends Floating>(Tensor<E> a, Tensor<E> b) {
        if (a.ndim() != 2) {
            throw heap LinAlgException("lstsq: a must be 2-D (m,n)");
        }
        int64 m = a.shapeAt(0);
        int64 n = a.shapeAt(1);
        if (b.ndim() < 1 || b.ndim() > 2 || b.shapeAt(0) != m) {
            throw heap LinAlgException("lstsq: b must be (m,) or (m,k) with rows matching a");
        }
        int64 k = 1;
        if (b.ndim() == 2) { k = b.shapeAt(1); }
        boolean deficient = true;
        if (m >= n) {
            Tensor<E>[] f = LinAlg.qr<E>(a);
            Tensor<E> r = f[1];                // (n,n)
            E rmax = (E) 0;
            int64 d = 0;
            while (d < n) {
                E rv = LinAlg.absE<E>(r.get2(d, d));
                if (rv > rmax) { rmax = rv; }
                d = d + 1;
            }
            E mx = (E) m;
            E tol = rmax * mx * LinAlg.machEps<E>() * (E) 8;
            deficient = false;
            d = 0;
            while (d < n) {
                if (LinAlg.absE<E>(r.get2(d, d)) <= tol) { deficient = true; }
                d = d + 1;
            }
            if (!deficient) {
                Tensor<E> xq = LinAlg.lstsqQrPath<E>(f[0], r, b, m, n, k);
                return #xq;
            }
        }
        // svd minimum-norm path (rank-deficient or m < n): x = A⁺·B
        Tensor<E> pv = LinAlg.pinv<E>(a);      // (n,m)
        Tensor<E> bsrc2 = b.copy();
        int64[] xsh2 = heap int64[2];
        xsh2[0] = n;
        xsh2[1] = k;
        Tensor<E> xm = Tensor.zeros<E>(xsh2);
        int64 i2 = 0;
        while (i2 < n) {
            int64 c2i = 0;
            while (c2i < k) {
                E acc = (E) 0;
                int64 j2 = 0;
                while (j2 < m) {
                    acc = acc + pv.get2(i2, j2) * bsrc2.flatGet(j2 * k + c2i);
                    j2 = j2 + 1;
                }
                xm.flatSet(i2 * k + c2i, acc);
                c2i = c2i + 1;
            }
            i2 = i2 + 1;
        }
        if (b.ndim() == 1) {
            int64[] vs3 = heap int64[1];
            vs3[0] = n;
            Tensor<E> xv2 = Tensor.zeros<E>(vs3);
            int64 i4 = 0;
            while (i4 < n) {
                xv2.set1(i4, xm.get2(i4, 0));
                i4 = i4 + 1;
            }
            return #xv2;
        }
        return #xm;
    }

    /** The full-rank QR solve `x = R⁻¹(Qᵀ·B)` behind {@link #lstsq}. */
    private static #Tensor<E> lstsqQrPath<E extends Floating>(
            Tensor<E> q, Tensor<E> r, Tensor<E> b, int64 m, int64 n, int64 k) {
        // c = Qᵀ·B, computed as (n,k) regardless of b's rank
        Tensor<E> bsrc = b.copy();
        int64[] csh = heap int64[2];
        csh[0] = n;
        csh[1] = k;
        Tensor<E> c2 = Tensor.zeros<E>(csh);
        int64 i = 0;
        while (i < n) {
            int64 c = 0;
            while (c < k) {
                E acc = (E) 0;
                int64 rr = 0;
                while (rr < m) {
                    acc = acc + q.get2(rr, i) * bsrc.flatGet(rr * k + c);
                    rr = rr + 1;
                }
                c2.flatSet(i * k + c, acc);
                c = c + 1;
            }
            i = i + 1;
        }
        Tensor<E> x2 = LinAlg.solveTriangular<E>(r, c2, false, false, false);
        if (b.ndim() == 1) {
            int64[] vs2 = heap int64[1];
            vs2[0] = n;
            Tensor<E> xv = Tensor.zeros<E>(vs2);
            int64 i3 = 0;
            while (i3 < n) {
                xv.set1(i3, x2.get2(i3, 0));
                i3 = i3 + 1;
            }
            return #xv;
        }
        return #x2;
    }

    /**
     * Rank of a square `A` (numpy `linalg.matrix_rank`): the count of singular values
     * above `tol = σmax·1e-4`. Detects rank deficiency / singularity.
     */
    public static int64 matrixRank<E extends Floating>(Tensor<E> a) {
        int64 m = a.shapeAt(0);
        int64 n = a.shapeAt(1);
        int64 r = m;
        if (n < m) { r = n; }
        Tensor<E>[] sv = LinAlg.svd<E>(a);
        Tensor<E> s = sv[1];
        E smax = s.get1(0);
        E mx = (E) m;
        if (n > m) { mx = (E) n; }
        // numpy matrix_rank semantics: tol = σmax·max(m,n)·ε
        E tol = smax * mx * LinAlg.machEps<E>();
        int64 rank = 0;
        int64 k = 0;
        while (k < r) {
            E sk = s.get1(k);
            if (sk > tol) { rank = rank + 1; }
            k = k + 1;
        }
        return rank;
    }

    /**
     * 2-norm condition number (numpy `linalg.cond`): `σmax / σmin`. Large ⇒
     * ill-conditioned; infinite (very large here) for a singular matrix.
     */
    public static E cond<E extends Floating>(Tensor<E> a) {
        int64 m = a.shapeAt(0);
        int64 n = a.shapeAt(1);
        int64 r = m;
        if (n < m) { r = n; }
        Tensor<E>[] sv = LinAlg.svd<E>(a);
        Tensor<E> s = sv[1];
        E smax = s.get1(0);
        E smin = s.get1(r - 1);
        return smax / smin;
    }

    /**
     * Frobenius norm of a square `A` (numpy `linalg.norm` default for matrices):
     * `sqrt(Σ aᵢⱼ²)`. No factorization needed.
     */
    public static E normFro<E extends Floating>(Tensor<E> a) {
        int64 n = a.shapeAt(0);
        E acc = (E) 0;
        int64 i = 0;
        while (i < n) {
            int64 j = 0;
            while (j < n) {
                E v = a.get2(i, j);
                acc = acc + v * v;
                j = j + 1;
            }
            i = i + 1;
        }
        return Math.sqrt(acc);
    }

    /** Absolute value of a `Floating` scalar (local helper — `Math.abs` per `E`). */
    static E absE<E extends Floating>(E v) {
        if (v < (E) 0) { return (E) 0 - v; }
        return v;
    }

    /** Swap rows `r0` and `r1` of the contiguous `(n,n)` matrix `m` in place. */
    static void swapRows<E extends Floating>(Tensor<E> m, int64 n, int64 r0, int64 r1) {
        int64 c = 0;
        while (c < n) {
            E a = m.get2(r0, c);
            E b = m.get2(r1, c);
            m.flatSet(r0 * n + c, b);
            m.flatSet(r1 * n + c, a);
            c = c + 1;
        }
    }

    // ---- nonsymmetric eigenvalues (Phase 11 — general eig, complex spectra) ------
    // Francis double-shift QR (EISPACK/Numerical-Recipes `elmhes`+`hqr`). Complex
    // eigenvalues of a REAL matrix emerge as conjugate pairs from 2x2 Schur blocks using
    // only REAL arithmetic — so no complex-number tier is needed. Work matrix `h` is a
    // 1-indexed `float64[]` with row stride `s = n+1` (row 0 / col 0 unused), mirroring the
    // reference's 1-based indexing to avoid off-by-one translation bugs.

    static float64 fabsD(float64 x) {
        if (x < 0.0) { return 0.0 - x; }
        return x;
    }

    /** `|a|` with the sign of `b` (Numerical-Recipes `SIGN`). */
    static float64 signD(float64 a, float64 b) {
        float64 m = LinAlg.fabsD(a);
        if (b >= 0.0) { return m; }
        return 0.0 - m;
    }

    /** Reduce `h` (1-indexed, stride `s`, order `n`) to upper Hessenberg form in place. */
    static void elmhesD(float64[] h, int64 n, int64 s) {
        int64 m = 2;
        while (m < n) {
            float64 x = 0.0;
            int64 ip = m;
            int64 j = m;
            while (j <= n) {
                float64 hjm = h[j * s + (m - 1)];
                if (LinAlg.fabsD(hjm) > LinAlg.fabsD(x)) { x = hjm; ip = j; }
                j = j + 1;
            }
            if (ip != m) {
                j = m - 1;
                while (j <= n) {
                    float64 a = h[ip * s + j];
                    float64 b = h[m * s + j];
                    h[ip * s + j] = b;
                    h[m * s + j] = a;
                    j = j + 1;
                }
                j = 1;
                while (j <= n) {
                    float64 a = h[j * s + ip];
                    float64 b = h[j * s + m];
                    h[j * s + ip] = b;
                    h[j * s + m] = a;
                    j = j + 1;
                }
            }
            if (x != 0.0) {
                int64 i = m + 1;
                while (i <= n) {
                    float64 y = h[i * s + (m - 1)];
                    if (y != 0.0) {
                        y = y / x;
                        h[i * s + (m - 1)] = y;
                        j = m;
                        while (j <= n) {
                            h[i * s + j] = h[i * s + j] - y * h[m * s + j];
                            j = j + 1;
                        }
                        j = 1;
                        while (j <= n) {
                            h[j * s + m] = h[j * s + m] + y * h[j * s + i];
                            j = j + 1;
                        }
                    }
                    i = i + 1;
                }
            }
            m = m + 1;
        }
    }

    /** Francis double-shift QR eigenvalues of the Hessenberg `h` → `wr`/`wi` (1-indexed). */
    static void hqrD(float64[] h, int64 n, int64 s, float64[] wr, float64[] wi) {
        float64 anorm = 0.0;
        int64 i = 1;
        while (i <= n) {
            int64 jlo = i - 1;
            if (jlo < 1) { jlo = 1; }
            int64 j = jlo;
            while (j <= n) { anorm = anorm + LinAlg.fabsD(h[i * s + j]); j = j + 1; }
            i = i + 1;
        }
        int64 nn = n;
        float64 t = 0.0;
        float64 z = 0.0;  float64 y = 0.0;  float64 x = 0.0;  float64 w = 0.0;
        float64 v = 0.0;  float64 u = 0.0;  float64 p = 0.0;  float64 q = 0.0;  float64 rr = 0.0;
        while (nn >= 1) {
            int64 its = 0;
            boolean iterate = true;
            while (iterate) {
                int64 l = nn;                          // scan for a negligible subdiagonal
                while (l >= 2) {
                    float64 sd = LinAlg.fabsD(h[(l - 1) * s + (l - 1)]) + LinAlg.fabsD(h[l * s + l]);
                    if (sd == 0.0) { sd = anorm; }
                    if (LinAlg.fabsD(h[l * s + (l - 1)]) + sd == sd) { h[l * s + (l - 1)] = 0.0; break; }
                    l = l - 1;
                }
                x = h[nn * s + nn];
                if (l == nn) {                          // one real root
                    wr[nn] = x + t;
                    wi[nn] = 0.0;
                    nn = nn - 1;
                } else {
                    y = h[(nn - 1) * s + (nn - 1)];
                    w = h[nn * s + (nn - 1)] * h[(nn - 1) * s + nn];
                    if (l == nn - 1) {                  // two roots (a 2x2 block)
                        p = 0.5 * (y - x);
                        q = p * p + w;
                        z = Math.sqrt(LinAlg.fabsD(q));
                        x = x + t;
                        if (q >= 0.0) {                 // real pair
                            z = p + LinAlg.signD(z, p);
                            wr[nn - 1] = x + z;
                            wr[nn] = x + z;
                            if (z != 0.0) { wr[nn] = x - w / z; }
                            wi[nn - 1] = 0.0;
                            wi[nn] = 0.0;
                        } else {                        // complex conjugate pair
                            wr[nn - 1] = x + p;
                            wr[nn] = x + p;
                            wi[nn] = z;
                            wi[nn - 1] = 0.0 - z;
                        }
                        nn = nn - 2;
                    } else {                            // no roots yet — a QR sweep
                        if (its == 10 || its == 20) {   // exceptional shift
                            t = t + x;
                            int64 ii = 1;
                            while (ii <= nn) { h[ii * s + ii] = h[ii * s + ii] - x; ii = ii + 1; }
                            float64 se = LinAlg.fabsD(h[nn * s + (nn - 1)]) + LinAlg.fabsD(h[(nn - 1) * s + (nn - 2)]);
                            x = 0.75 * se;
                            y = x;
                            w = -0.4375 * se * se;
                        }
                        its = its + 1;
                        int64 m = nn - 2;               // find the start of the sweep
                        while (m >= l) {
                            z = h[m * s + m];
                            rr = x - z;
                            float64 sq = y - z;
                            p = (rr * sq - w) / h[(m + 1) * s + m] + h[m * s + (m + 1)];
                            q = h[(m + 1) * s + (m + 1)] - z - rr - sq;
                            rr = h[(m + 2) * s + (m + 1)];
                            float64 sm = LinAlg.fabsD(p) + LinAlg.fabsD(q) + LinAlg.fabsD(rr);
                            p = p / sm;
                            q = q / sm;
                            rr = rr / sm;
                            if (m == l) { break; }
                            u = LinAlg.fabsD(h[m * s + (m - 1)]) * (LinAlg.fabsD(q) + LinAlg.fabsD(rr));
                            v = LinAlg.fabsD(p) * (LinAlg.fabsD(h[(m - 1) * s + (m - 1)]) + LinAlg.fabsD(z) + LinAlg.fabsD(h[(m + 1) * s + (m + 1)]));
                            if (u + v == v) { break; }
                            m = m - 1;
                        }
                        int64 ic = m + 2;
                        while (ic <= nn) {
                            h[ic * s + (ic - 2)] = 0.0;
                            if (ic != m + 2) { h[ic * s + (ic - 3)] = 0.0; }
                            ic = ic + 1;
                        }
                        int64 k = m;                    // the double-QR sweep
                        while (k <= nn - 1) {
                            if (k != m) {
                                p = h[k * s + (k - 1)];
                                q = h[(k + 1) * s + (k - 1)];
                                rr = 0.0;
                                if (k != nn - 1) { rr = h[(k + 2) * s + (k - 1)]; }
                                x = LinAlg.fabsD(p) + LinAlg.fabsD(q) + LinAlg.fabsD(rr);
                                if (x != 0.0) { p = p / x; q = q / x; rr = rr / x; }
                            }
                            float64 sx = LinAlg.signD(Math.sqrt(p * p + q * q + rr * rr), p);
                            if (sx != 0.0) {
                                if (k == m) {
                                    if (l != m) { h[k * s + (k - 1)] = 0.0 - h[k * s + (k - 1)]; }
                                } else {
                                    h[k * s + (k - 1)] = 0.0 - sx * x;
                                }
                                p = p + sx;
                                x = p / sx;
                                y = q / sx;
                                z = rr / sx;
                                q = q / p;
                                rr = rr / p;
                                int64 j2 = k;           // row modification
                                while (j2 <= nn) {
                                    p = h[k * s + j2] + q * h[(k + 1) * s + j2];
                                    if (k != nn - 1) {
                                        p = p + rr * h[(k + 2) * s + j2];
                                        h[(k + 2) * s + j2] = h[(k + 2) * s + j2] - p * z;
                                    }
                                    h[(k + 1) * s + j2] = h[(k + 1) * s + j2] - p * y;
                                    h[k * s + j2] = h[k * s + j2] - p * x;
                                    j2 = j2 + 1;
                                }
                                int64 mmin = k + 3;     // column modification
                                if (nn < k + 3) { mmin = nn; }
                                int64 i2 = l;
                                while (i2 <= mmin) {
                                    p = x * h[i2 * s + k] + y * h[i2 * s + (k + 1)];
                                    if (k != nn - 1) {
                                        p = p + z * h[i2 * s + (k + 2)];
                                        h[i2 * s + (k + 2)] = h[i2 * s + (k + 2)] - p * rr;
                                    }
                                    h[i2 * s + (k + 1)] = h[i2 * s + (k + 1)] - p * q;
                                    h[i2 * s + k] = h[i2 * s + k] - p;
                                    i2 = i2 + 1;
                                }
                            }
                            k = k + 1;
                        }
                    }
                }
                iterate = (l < nn - 1);
                if (its > 100) { iterate = false; nn = 0; }   // anti-hang net (never hit for well-conditioned input)
            }
        }
    }

    /**
     * Eigenvalues of a general (non-symmetric) real square matrix (numpy `linalg.eigvals`),
     * as interleaved complex `float64`: a length-`2n` tensor with `[2k]` = real part and
     * `[2k+1]` = imaginary part of eigenvalue `k`. Complex eigenvalues appear as conjugate
     * pairs. Computed by Hessenberg reduction ({@link #elmhesD}) then the Francis
     * double-shift QR ({@link #hqrD}) — all real arithmetic, no complex-number tier needed.
     * Eigenvalue order is the QR deflation order (not sorted; compare as a set vs numpy).
     */
    public static #Tensor<float64> eigvals(Tensor<float64> a) {
        int64 n = a.shapeAt(0);
        int64 s = n + 1;
        float64[] h = heap float64[s * s];
        int64 r = 1;
        while (r <= n) {
            int64 c = 1;
            while (c <= n) { h[r * s + c] = a.get2(r - 1, c - 1); c = c + 1; }
            r = r + 1;
        }
        float64[] wr = heap float64[s];
        float64[] wi = heap float64[s];
        LinAlg.elmhesD(h, n, s);
        LinAlg.hqrD(h, n, s, wr, wi);
        int64[] osh = heap int64[1];
        osh[0] = 2 * n;
        Tensor<float64> out = Tensor.zeros<float64>(osh);
        int64 k = 1;
        while (k <= n) {
            out.flatSet(2 * (k - 1), wr[k]);
            out.flatSet(2 * (k - 1) + 1, wi[k]);
            k = k + 1;
        }
        return #out;
    }
}
