package cajeta.concurrent;

/**
 * The no-data RAII gate from docs/specification/concurrent/Concurrency.md § `Lock`. Wraps
 * the async-aware lock intrinsics (`Cajeta.lock*`). `acquire()` returns a
 * `#``LockGuard` whose drop releases the lock; `tryAcquire()` is
 * non-blocking (1 = acquired, 0 = already held). The underlying mutex is
 * destroyed by this class's synthesized drop wrapper at scope exit.
 *
 * Use a plain `Lock` to guard a critical region that protects state not
 * bundled into a single value; reach for `Mutex` instead when there is
 * one piece of data to fuse the lock with.
 *
 * ```cajeta
 * Lock gate = heap Lock();
 * {
 *     #LockGuard g = gate.acquire();   // held for this block
 *     // ... critical section ...
 * }                                    // g drops here -> auto release
 *
 * if (gate.tryAcquire() == 1) {        // non-blocking attempt
 *     gate.releaseLock();              // manual pairing with tryAcquire
 * }
 * ```
 *
 * Async behaviour (docs/specification/concurrent/AsyncStatus.md): on the single-carrier
 * cooperative scheduler a fiber that hits a held lock parks and yields to
 * the carrier rather than blocking the OS thread; the main thread blocks
 * on the lock's condvar.
 */
public class Lock {
    private pointer handle;

    /**
     * Create a fresh, unheld lock.
     *
     * ```cajeta
     * Lock gate = heap Lock();
     * ```
     */
    public Lock() { this.handle = Cajeta.lockNew(); }
    public ~Lock() { Cajeta.lockDestroy(this.handle); }

    /**
     * Block until the lock is held, then return a `#``LockGuard` that
     * releases it on drop. Bind the guard to a scope; do not discard it,
     * or the lock is released immediately.
     *
     * ```cajeta
     * #LockGuard g = gate.acquire();
     * // ... critical section runs while g is alive ...
     * // g drops at end of scope -> lock released
     * ```
     */
    public #LockGuard acquire() {
        Cajeta.lockAcquire(this.handle);
        return heap LockGuard(this.handle);
    }
    /**
     * Non-blocking acquire. Returns `1` if the lock was taken (the caller
     * now holds it and must `releaseLock()` itself — no `LockGuard` is
     * produced), or `0` if it was already held by someone else.
     *
     * ```cajeta
     * if (gate.tryAcquire() == 1) {
     *     // ... do work while holding the lock ...
     *     gate.releaseLock();
     * }
     * ```
     */
    public int32 tryAcquire() {
        return Cajeta.lockTryAcquire(this.handle);
    }

    /**
     * Manually release a lock taken via `tryAcquire()`. Pair each
     * successful `tryAcquire()` (return value `1`) with exactly one call.
     * Locks taken via `acquire()` are released by their `LockGuard` and
     * must not be released this way.
     */
    public void releaseLock() {
        Cajeta.lockRelease(this.handle);
    }
}
