{
    // cvm — the Cajeta Version Manager — built with the cajeta build
    // tool. Governed by plans/installer/installer-plan.md (D12). cvm is
    // written in Cajeta and compiled --emit=exe by the just-built
    // compiler (dogfooding); the release workflow ships its binary per
    // target. It is version-independent by contract: a 1.0 cvm installs
    // an 8.0 cajeta by resolving a stable release manifest — it bakes in
    // no knowledge of any cajeta version.
    //
    // Layout follows the standard project shape (see
    // samples/buildtool/basic and docs/BuildTool.md):
    //   cajeta.json                       ← this manifest
    //   src/main/cajeta/cvm/*.cajeta      ← sources (package `cvm`)
    //   build/cvm                         ← built binary (gitignored)
    //
    // Build + run from this directory:
    //   cajeta build     → build/cvm
    //   cajeta run       → build + execute (what run.sh does)
    //   cajeta clean     → wipe build/

    "details": {
        "name":                "cvm",
        "version":             "0.2.0",
        "description":         "Cajeta Version Manager — toolchain installer/switcher",
        "license":             "Apache-2.0",
        "authors":             ["Julian Klappenbach <jklappenbach@gmail.com>"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // cvm reads/writes ~/.cajeta (filesystem), reads the environment
        // (CAJETA_HOME / XDG_DATA_HOME / HOME / PATH), and — once Phase 1
        // lands — fetches the release manifest + toolchain over the
        // network. The network capability is declared now so the manifest
        // resolver can be wired without a manifest change.
        "capabilities": ["filesystem", "env", "network"],

        // Declared so resolution does not fall back to whatever is already
        // cached under ~/.olla. Without it a stale cache decides the build,
        // and `cajeta upgrade` refuses to run at all.
        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev", "priority": 0 }
        ],

        // The core stdlib is built into the toolchain — not declared or
        // fetched — and dead-code elimination links only what cvm uses.
        // HTTP left the stdlib for dev.cajeta.http, so that one library
        // is now a dependency. Version-independence is unaffected — the
        // contract is about CAJETA versions (a 1.0 cvm installs an 8.0
        // cajeta), not about what libraries cvm itself links.
        "dependencies": {
            // 0.3.0 is the release that made HTTP/2 return receive-window
            // credit. Against 0.2.0 a download stalled after one 65535-octet
            // window, which is what made `cvm install` take 3m49s on an asset
            // curl fetched in 6.85s. It also caps request bodies on h2 and
            // honours a read deadline on HTTPS.
            //
            // 0.3.1 is what lets cvm LINK anywhere but linux-x64, and that was
            // measured rather than assumed. http pegs dev.cajeta.codec, which
            // supplies zlib as a baked native archive. Listing the published
            // .cja files: codec 0.8.2 carries exactly one,
            // native/linux-x64/libcajeta_zlib.a, and codec 0.8.3 carries six,
            // adding linux-arm64, linux-riscv64, macos-arm64, macos-x64 and
            // windows-x64. http 0.3.0 resolves codec 0.8.2 and http 0.3.1
            // resolves codec 0.8.3, per Olla's own dependency records. So on
            // 0.3.0 every non-linux-x64 leg of the release matrix had no zlib
            // to link against, which is why those legs shipped no cvm.
            "dev.cajeta.http": "0.3.1"
        },

        "build": {
            // src/main/cajeta is the default source root; stated for
            // clarity. Entry is cvm.Cvm::main(String[]).
            "source-root":  "src/main/cajeta",
            "target":       "host",
            "entry-method": "cvm.Cvm::main"
        }
    },

    "tasks": {

        // output-path puts the binary at build/cvm rather than the
        // default build/exe/<name>: the project name `cvm` matches the
        // top-level package `cvm`, so the default build/exe/cvm/ would
        // collide with the object directory of the same name.
        "build": {
            "description": "Build cvm to a native binary (build/cvm)",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "output-path": "build/cvm", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "run": {
            "description": "Build cvm and run it",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "output-path": "build/cvm", "id": "art" },
                { "action": "exec", "command": "${art.path}" }
            ]
        },

        "release": {
            "description": "Optimized release build of cvm (shipped per target)",
            "actions": [
                { "action": "build", "flavor": "release",
                  "output-path": "build/cvm", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
