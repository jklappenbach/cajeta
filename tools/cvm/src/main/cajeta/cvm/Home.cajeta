package cvm;

import cajeta.lang.System;

// Resolves cvm's state directory — where it installs and switches cajeta
// toolchains. Per installer-plan.md (D12 / §2) cvm manages cajeta under
// ~/.cajeta, honoring $CAJETA_HOME / $XDG_DATA_HOME. Resolution order:
//
//   1. $CAJETA_HOME              — explicit override, used verbatim.
//   2. $XDG_DATA_HOME/cajeta     — XDG base-dir spec, when set.
//   3. $HOME/.cajeta             — the default.
//
// The layout under the resolved home (created lazily by Phase 1):
//   bin/cvm                  — the manager (only on PATH when shim-installed)
//   bin/cajeta               — shim → the active toolchain (on PATH)
//   versions/<version>/cajeta — each installed toolchain's binary
//   settings                 — default toolchain + config (key = value)
public final class Home {

    // True on Windows. The runtime publishes the host triple as
    // `cajeta.host.triple` and fixes it to x86_64-w64-mingw32 there; cvm
    // already resolves release assets by that key, so it is the platform
    // signal cvm has, and it needs no new runtime surface.
    public static boolean isWindows() {
        String triple = System.property.get("cajeta.host.triple");
        return triple != null && triple.contains("mingw32");
    }

    // The resolved ~/.cajeta directory, or null if no home can be determined
    // (a broken environment cvm can't recover from on its own).
    public static #String dir() {
        String explicit = System.env.get("CAJETA_HOME");
        if (explicit != null && !explicit.isEmpty()) {
            return explicit;
        }

        String xdg = System.env.get("XDG_DATA_HOME");
        if (xdg != null && !xdg.isEmpty()) {
            return xdg + "/cajeta";
        }

        String home = System.env.get("HOME");
        if (home != null && !home.isEmpty()) {
            return home + "/.cajeta";
        }

        // Windows sets USERPROFILE, not HOME — cmd.exe and PowerShell leave
        // HOME unset entirely, so without this cvm resolved NO home at all
        // there and could not install anything. (HOME is checked first because
        // an MSYS2/git-bash shell sets both, and honoring it keeps a cvm run
        // from that shell consistent with one from cmd.)
        String profile = System.env.get("USERPROFILE");
        if (profile != null && !profile.isEmpty()) {
            return profile + "/.cajeta";
        }

        return null;
    }

    // Convenience sub-paths under the resolved home.
    public static #String binDir(String home)      { return home + "/bin"; }
    public static #String versionsDir(String home) { return home + "/versions"; }
    public static #String settingsFile(String home){ return home + "/settings"; }

    // The active-toolchain shim — the `cajeta` that lands on PATH.
    //
    // On Windows it is bin/cajeta.cmd, not bin/cajeta: PE has no
    // elevation-free symlink (__cajeta_path_symlink returns -1 there
    // unconditionally), so the shim is a one-line batch wrapper instead, and
    // .cmd is in PATHEXT so typing `cajeta` still finds it.
    public static #String shimFile(String home) {
        if (isWindows()) {
            return home + "/bin/cajeta.cmd";
        }
        return home + "/bin/cajeta";
    }

    // A specific installed toolchain's directory and its binary. These
    // take two reference parameters and return a freshly built string, so
    // they must return ownership (`#String`): the borrow checker can't
    // attribute the result to a single parameter.
    public static #String versionDir(String home, String version) {
        return home + "/versions/" + version;
    }
    // Windows will not execute a file without an executable extension, so the
    // installed toolchain must be cajeta.exe there. Writing it extensionless
    // (as this did) produced an install that reported success and then could
    // not be run at all.
    public static #String versionBin(String home, String version) {
        if (isWindows()) {
            return home + "/versions/" + version + "/cajeta.exe";
        }
        return home + "/versions/" + version + "/cajeta";
    }
}
