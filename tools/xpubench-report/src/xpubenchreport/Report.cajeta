package xpubenchreport;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.codec.json.JsonWriter;
import cajeta.collection.ArrayList;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;

/**
 * xpubench-report — turns the harness's JSON rows into the tables of
 * specs/xpu-tile-scheduling-report.md (xpu-tile-scheduling plan 0.2.3).
 *
 *   xpubench-report baseline <rows.jsonl>...
 *       §3 rows: | Workload | Shape | Device | KPI | Median | Noise band |
 *       p95 | n | Note |, preceded by one identity line per distinct
 *       (device, backend, driver, compiler, power mode, date).
 *
 *   xpubench-report trial <before.jsonl> <after.jsonl> --id=T-001
 *       --unit="scheduling U1" --commit=<sha> [--date=ISO]
 *       §4 rows: one per (workload, shape, KPI, backend) present in both
 *       files, with delta, the before row's noise band, and a verdict:
 *       `keep` when the after median is inside the before band or better,
 *       `worse` when it is outside the band in the bad direction, `single`
 *       when the before row has no band (n < 2) — reported, not gated
 *       (Verdict.cajeta). Better is lower for durations and misses, higher
 *       for rates. Exit 1 when any row is `worse`.
 *
 * Numbers exist once, in the rows; this tool only formats.
 */
public final class Report {
    private Report() { }

    /** One parsed row. Fields mirror the harness's JSON. */
    public static final class Row {
        public String workload;
        public String shape;
        public String kpi;
        public String unit;
        public float64 median;
        public float64 lo;
        public float64 hi;
        public float64 p95;
        public int64 n;
        public String device;
        public String backend;
        public String driver;
        public String compiler;
        public String powerMode;
        public String date;
        public String arm;
        public String note;
        public int32 rounds;
        public float64 roundLo;
        public float64 roundHi;
        public float64 roundMean;

        public Row() {
            this.workload = "";
            this.shape = "";
            this.kpi = "";
            this.unit = "";
            this.median = 0.0;
            this.lo = 0.0;
            this.hi = 0.0;
            this.p95 = 0.0;
            this.n = 0;
            this.device = "";
            this.backend = "";
            this.driver = "";
            this.compiler = "";
            this.powerMode = "";
            this.date = "";
            this.arm = "";
            this.note = "";
            this.rounds = 1;
            this.roundLo = 0.0;
            this.roundHi = 0.0;
            this.roundMean = 0.0;
        }

        public #String identity() {
            return this.device + " | " + this.backend + " | " + this.driver + " | "
                + this.compiler + " | " + this.powerMode + " | " + this.date + " | " + this.arm;
        }

        public #String key() {
            return this.workload + "|" + this.shape + "|" + this.kpi + "|" + this.backend;
        }
    }

    static #String str(JsonObject o, String key) {
        JsonValue v = o.get(key);
        if (v == null || v.kind() != JsonValue.STRING) {
            return "" + "";
        }
        return v.asString();
    }

    static float64 num(JsonObject o, String key) {
        JsonValue v = o.get(key);
        if (v == null || v.kind() != JsonValue.NUMBER) {
            return 0.0;
        }
        return v.asFloat64();
    }

    /** Split `bytes` on newlines, parse each non-empty line as one row. */
    public static void load(ArrayList<Row> into, int8[] bytes, int32 len) {
        int32 start = 0;
        int32 i = 0;
        while (i <= len) {
            if (i == len || bytes[i] == 10) {
                int32 n = i - start;
                if (n > 1) {
                    int8[] copy = heap int8[n];
                    int32 j = 0;
                    while (j < n) {
                        copy[j] = bytes[start + j];
                        j = j + 1;
                    }
                    JsonValue v #= Json.parse(copy, (int64) n);
                    if (v != null && v.kind() == JsonValue.OBJECT) {
                        JsonObject o = v.object();
                        Row r = heap Row();
                        r.workload #= Report.str(o, "workload");
                        r.shape #= Report.str(o, "shape");
                        r.kpi #= Report.str(o, "kpi");
                        r.unit #= Report.str(o, "unit");
                        r.median = Report.num(o, "median");
                        r.lo = Report.num(o, "min");
                        r.hi = Report.num(o, "max");
                        r.p95 = Report.num(o, "p95");
                        r.n = (int64) Report.num(o, "n");
                        r.device #= Report.str(o, "device");
                        r.backend #= Report.str(o, "backend");
                        r.driver #= Report.str(o, "driver");
                        r.compiler #= Report.str(o, "compiler");
                        r.powerMode #= Report.str(o, "powerMode");
                        r.date #= Report.str(o, "date");
                        r.arm #= Report.str(o, "arm");
                        r.note #= Report.str(o, "note");
                        float64 rn = Report.num(o, "rounds");
                        if (rn > 1.0) {
                            r.rounds = (int32) rn;
                            r.roundLo = Report.num(o, "roundLo");
                            r.roundHi = Report.num(o, "roundHi");
                            r.roundMean = Report.num(o, "roundMean");
                        }
                        into.add(#r);
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    public static #ArrayList<Row> loadFile(String path) {
        ArrayList<Row> rows = heap ArrayList<Row>();
        int8[] b #= File.readAllBytes(path);
        if (b == null) {
            System.stderr.println("xpubench-report: cannot read " + path);
            return rows;
        }
        Report.load(rows, b, (int32) b.count());
        return rows;
    }

    /** A number for a table cell: integers as integers, small values with
     *  up to three decimals, nothing in exponent form. */
    public static #String fmt(float64 v) {
        // Format the magnitude, then restore the sign: an integer whole part
        // of 0 cannot carry a minus, so -0.395 came out as 0.395 once.
        float64 a = v < 0.0 ? 0.0 - v : v;
        String sign = v < 0.0 ? "-" : "";
        if (a >= 1000000.0) {
            int64 whole = (int64) a;
            return sign + whole;
        }
        if (a >= 100.0) {
            int64 tenths = (int64) (a * 10.0 + 0.5);
            int64 whole = tenths / 10;
            int64 frac = tenths - whole * 10;
            return sign + whole + "." + frac;
        }
        int64 thou = (int64) (a * 1000.0 + 0.5);
        int64 whole = thou / 1000;
        int64 frac = thou - whole * 1000;
        String pad = frac < 10 ? "00" : (frac < 100 ? "0" : "");
        if (frac == 0) {
            return sign + whole;
        }
        String s = sign + whole + "." + pad + frac;
        // trim trailing zeros
        int32 end = s.byteLength();
        while (end > 0 && s.byteAt(end - 1) == 48) {
            end = end - 1;
        }
        if (end > 0 && s.byteAt(end - 1) == 46) {
            end = end - 1;
        }
        return s.substring(0, end);
    }

    static #String cell(String s) {
        return s.replace("|", "/");
    }

    // Foreign-load thresholds above which a regression reads `contended` (0.1.5).
    static float64 contendedCpuPct = 10.0;
    static float64 contendedGpuPct = 5.0;

    /**
     * The rows of one arm, an arm's repeated rounds merged per key
     * (scheduling 0.1.3): the median of the round medians, the union band,
     * the summed n. `arm` empty keeps every row unmerged.
     */
    public static #ArrayList<Row> armRows(ArrayList<Row> all, String arm) {
        ArrayList<Row> out = heap ArrayList<Row>();
        int32 i = 0;
        while (i < all.count()) {
            Row r = all.get(i);
            i = i + 1;
            if (arm.byteLength() > 0 && !r.arm.equals(arm)) {
                continue;
            }
            String key #= r.key();
            boolean seen = false;
            int32 k = 0;
            while (k < out.count()) {
                String ko #= out.get(k).key();
                if (ko.equals(key)) {
                    seen = true;
                }
                k = k + 1;
            }
            if (seen && arm.byteLength() > 0) {
                continue;
            }
            out.add(#Report.mergeKey(all, arm, r));
        }
        return out;
    }

    /** Every measured row of `arm` with `first`'s key, merged into a fresh row. */
    static #Row mergeKey(ArrayList<Row> all, String arm, Row first) {
        Row m = heap Row();
        m.workload #= "" + first.workload;
        m.shape #= "" + first.shape;
        m.kpi #= "" + first.kpi;
        m.unit #= "" + first.unit;
        m.device #= "" + first.device;
        m.backend #= "" + first.backend;
        m.driver #= "" + first.driver;
        m.compiler #= "" + first.compiler;
        m.powerMode #= "" + first.powerMode;
        m.date #= "" + first.date;
        m.arm #= "" + first.arm;
        m.note #= "" + first.note;
        m.median = first.median;
        m.lo = first.lo;
        m.hi = first.hi;
        m.p95 = first.p95;
        m.n = first.n;
        m.rounds = first.rounds;
        m.roundLo = first.roundLo;
        m.roundHi = first.roundHi;
        m.roundMean = first.roundMean;
        if (arm.byteLength() == 0) {
            return m;
        }
        String key #= first.key();
        float64[] meds = heap float64[all.count()];
        int32 nm = 0;
        int64 n = 0L;
        float64 lo = 0.0;
        float64 hi = 0.0;
        int32 i = 0;
        while (i < all.count()) {
            Row r = all.get(i);
            i = i + 1;
            String kr #= r.key();
            if (!r.arm.equals(arm) || !kr.equals(key) || r.unit.equals("pending")) {
                continue;
            }
            if (nm == 0 || r.lo < lo) {
                lo = r.lo;
            }
            if (nm == 0 || r.hi > hi) {
                hi = r.hi;
            }
            meds[nm] = r.median;
            nm = nm + 1;
            n = n + r.n;
        }
        if (nm == 0) {
            return m;
        }
        Spans.sortValues(meds, nm);
        float64 med = meds[nm / 2];
        if (nm % 2 == 0) {
            med = (meds[nm / 2 - 1] + meds[nm / 2]) / 2.0;
        }
        float64 sum = 0.0;
        int32 q = 0;
        while (q < nm) {
            sum = sum + meds[q];
            q = q + 1;
        }
        m.median = med;
        m.lo = lo;
        m.hi = hi;
        m.n = n;
        if (nm == 1) {
            return m;
        }
        m.rounds = nm;
        m.roundLo = meds[0];
        m.roundHi = meds[nm - 1];
        m.roundMean = sum / (float64) nm;
        return m;
    }

    /** The harness block a row's workload ran in: `kernel.saxpy` in `kernels`, `llm.decode` in `llm`. */
    static #String blockOf(String workload) {
        if (workload.startsWith("kernel.")) {
            return "" + "kernels";
        }
        int64 dot = workload.indexOf(".");
        if (dot < 0L) {
            return "" + workload;
        }
        return workload.substring(0, (int32) dot);
    }

    /** The largest witness of `kpi` over `rows` for `block`, or -1 when none was recorded. */
    static float64 witness(ArrayList<Row> rows, String block, String kpi) {
        float64 w = 0.0 - 1.0;
        int32 i = 0;
        while (i < rows.count()) {
            Row r = rows.get(i);
            i = i + 1;
            if (r.workload.equals("witness") && r.shape.equals(block) && r.kpi.equals(kpi)
                && r.hi > w) {
                w = r.hi;
            }
        }
        return w;
    }

    /** The foreign GPU the gate saw on the idle box (scheduling 0.2.9), 0 when unrecorded. */
    static float64 idleGpu(ArrayList<Row> rows) {
        float64 g = Report.witness(rows, "gate", "foreign_gpu_pct");
        return g > 0.0 ? g : 0.0;
    }

    /** True when either side's witness for `block` was over a threshold, GPU above its idle level. */
    static boolean contendedBlock(ArrayList<Row> b, ArrayList<Row> af, String block) {
        return Report.witness(b, block, "foreign_cpu_pct") > Report.contendedCpuPct
            || Report.witness(af, block, "foreign_cpu_pct") > Report.contendedCpuPct
            || Report.witness(b, block, "foreign_gpu_pct") > Report.idleGpu(b) + Report.contendedGpuPct
            || Report.witness(af, block, "foreign_gpu_pct") > Report.idleGpu(af) + Report.contendedGpuPct;
    }

    /** Lower is better for durations, misses, slowdowns and device idle; higher for rates. */
    public static boolean lowerIsBetter(Row r) {
        String u = r.unit;
        if (u.equals("us") || u.equals("ms") || u.equals("bytes")) {
            return true;
        }
        if (r.kpi.contains("missed") || r.kpi.contains("slowdown") || r.kpi.contains("cost")
            || r.kpi.contains("queue_empty")) {
            return true;
        }
        return false;
    }

    public static int32 baseline(String[] args, int32 from) {
        ArrayList<Row> rows = heap ArrayList<Row>();
        int32 a = from;
        while (a < (int32) args.count()) {
            ArrayList<Row> part #= Report.loadFile(args[a]);
            rows.appendAll(part);
            a = a + 1;
        }
        // identity lines, deduplicated in order of first appearance
        ArrayList<String> seen = heap ArrayList<String>();
        int32 i = 0;
        while (i < rows.count()) {
            Row r = rows.get(i);
            String id #= r.identity();
            boolean dup = false;
            int32 k = 0;
            while (k < seen.count()) {
                if (seen.get(k).equals(id)) {
                    dup = true;
                }
                k = k + 1;
            }
            if (!dup) {
                System.stdout.println("Identity: " + id);
                seen.add(#id);
            }
            i = i + 1;
        }
        System.stdout.println("");
        System.stdout.println("| Workload | Shape | Device | KPI | Median | Noise band | p95 | n | Note |");
        System.stdout.println("|---|---|---|---|---|---|---|---|---|");
        i = 0;
        while (i < rows.count()) {
            Row r = rows.get(i);
            // `launches` is bookkeeping for the spans verb, not a KPI. A
            // pending row is superseded by a measured row with the same key
            // (the harness writes `pending` for what a later profiled pass
            // then fills), so the table shows the number, not both.
            if (r.kpi.equals("launches") || Report.superseded(rows, i)) {
                i = i + 1;
                continue;
            }
            if (r.unit.equals("pending")) {
                System.stdout.println("| " + r.workload + " | " + r.shape + " | " + r.backend
                    + " | " + r.kpi + " | pending | | | | " + Report.cell(r.note) + " |");
            } else {
                String med #= Report.fmt(r.median);
                String lo #= Report.fmt(r.lo);
                String hi #= Report.fmt(r.hi);
                String p95 #= r.p95 > 0.0 ? Report.fmt(r.p95) : "" + "";
                System.stdout.println("| " + r.workload + " | " + r.shape + " | " + r.backend
                    + " | " + r.kpi + " | " + med + " " + r.unit + " | [" + lo + ", " + hi
                    + "] | " + p95 + " | " + r.n + " | " + Report.cell(r.note) + " |");
            }
            i = i + 1;
        }
        return 0;
    }

    /**
     * True when a LATER row with `r`'s key carries a measurement, or `r` is
     * pending and any measured row does. A rows file is append-only — a
     * profiled pass rerun (`SPANS_ONLY=1`) adds newer rows after the ones it
     * replaces — so the last measured row for a key is the one that stands.
     */
    static boolean superseded(ArrayList<Row> rows, int32 at) {
        Row r = rows.get(at);
        String key #= r.key();
        boolean pending = r.unit.equals("pending");
        int32 j = 0;
        while (j < rows.count()) {
            Row o = rows.get(j);
            int32 here = j;
            j = j + 1;
            if (here == at || o.unit.equals("pending")) {
                continue;
            }
            if (!pending && here < at) {
                continue;
            }
            String ko #= o.key();
            if (ko.equals(key)) {
                return true;
            }
        }
        return false;
    }

    static #String opt(String[] args, String key, String dflt) {
        int32 i = 0;
        while (i < (int32) args.count()) {
            String a = args[i];
            if (a.startsWith(key)) {
                return a.substring(key.byteLength(), a.byteLength());
            }
            i = i + 1;
        }
        return "" + dflt;
    }

    public static int32 trial(String[] args) {
        // positional: trial <before> <after>; options after
        int32 pos = 0;
        String before = "";
        String after = "";
        int32 i = 1;
        while (i < (int32) args.count()) {
            String a = args[i];
            if (!a.startsWith("--")) {
                if (pos == 0) {
                    before = a;
                } else if (pos == 1) {
                    after = a;
                }
                pos = pos + 1;
            }
            i = i + 1;
        }
        if (pos < 2) {
            System.stderr.println("usage: xpubench-report trial <before.jsonl> <after.jsonl> --id=T-001 --unit=... --commit=... "
                + "[--bands=<rerun.jsonl>] [--before-arm=<arm> --after-arm=<arm>] [--contended-cpu=10 --contended-gpu=5]");
            return 2;
        }
        String id #= Report.opt(args, "--id=", "T-???");
        String unit #= Report.opt(args, "--unit=", "");
        String commit #= Report.opt(args, "--commit=", "");
        String date #= Report.opt(args, "--date=", "");
        String bandsPath #= Report.opt(args, "--bands=", "");
        String beforeArm #= Report.opt(args, "--before-arm=", "");
        String afterArm #= Report.opt(args, "--after-arm=", "");
        String cpuMax #= Report.opt(args, "--contended-cpu=", "10");
        String gpuMax #= Report.opt(args, "--contended-gpu=", "5");
        Report.contendedCpuPct = (float64) Long.parseLong(cpuMax);
        Report.contendedGpuPct = (float64) Long.parseLong(gpuMax);
        ArrayList<Row> b0 #= Report.loadFile(before);
        ArrayList<Row> b #= Report.armRows(b0, beforeArm);
        ArrayList<Row> a0 #= Report.loadFile(after);
        ArrayList<Row> af #= Report.armRows(a0, afterArm);
        ArrayList<Row> bands = heap ArrayList<Row>();
        if (bandsPath.byteLength() > 0) {
            ArrayList<Row> p0 #= Report.loadFile(bandsPath);
            ArrayList<Row> p #= Report.armRows(p0, beforeArm);
            bands.appendAll(p);
        }
        TrialResult res #= Report.trialRows(b, af, bands, id, unit, commit, date);
        if (res.refused) {
            return 2;
        }
        if (res.worse > 0) {
            return 1;
        }
        if (res.contended > 0) {
            return 3;
        }
        return 0;
    }

    /** Index of the last measured row in `rows` with `key`, or -1. (An index,
     *  not the row: a two-parameter function cannot return a borrow.) */
    static int32 lastMeasured(ArrayList<Row> rows, String key) {
        int32 found = 0 - 1;
        int32 j = 0;
        while (j < rows.count()) {
            Row o = rows.get(j);
            int32 here = j;
            j = j + 1;
            if (o.unit.equals("pending")) {
                continue;
            }
            String ko #= o.key();
            if (ko.equals(key)) {
                found = here;
            }
        }
        return found;
    }

    /**
     * The trial proper (scheduling 0.3.3): every measured before row is
     * paired with the last measured after row of the same key. With
     * `bands` — the day-apart rerun of the before code — a KPI's band is the
     * UNION of the two runs' bands and its n their sum, so a pair of
     * single-sample rows (a frame p99, a seam kernel_time) is banded by the
     * two runs' spread and a five-block KPI whose runs drift further than
     * one run's blocks widens to that drift; without a partner the row's own
     * band stands, and a single-sample row stays `single`.
     */
    public static #TrialResult trialRows(ArrayList<Row> b, ArrayList<Row> af, ArrayList<Row> bands,
                                         String id, String unit, String commit, String date) {
        TrialResult res = heap TrialResult();
        // The bands must come from a rerun of the BEFORE code. Handed the
        // after run itself, the union contains every after median and the
        // trial reads `keep` on every row — measured on 2026-09-06, 129 of
        // 129, before this check existed.
        if (bands.count() > 0 && af.count() > 0) {
            String ib #= bands.get(0).identity();
            String ia #= af.get(0).identity();
            if (ib.equals(ia)) {
                System.stderr.println("xpubench-report: --bands must be a rerun of the BEFORE code, "
                    + "not the after run (same identity: " + ia + "); refusing a trial whose "
                    + "every verdict would be keep by construction");
                res.refused = true;
                return res;
            }
        }
        System.stdout.println("| Trial | Date | Plan / unit | Workload | Device | KPI | Before | After | Delta | Noise band | Commit | Verdict | Note |");
        System.stdout.println("|---|---|---|---|---|---|---|---|---|---|---|---|---|");
        int32 x = 0;
        while (x < b.count()) {
            Row rb = b.get(x);
            int32 xb = x;
            x = x + 1;
            if (rb.unit.equals("pending") || rb.unit.equals("witness") || rb.kpi.equals("launches")
                || Report.superseded(b, xb)) {
                continue;
            }
            String key #= rb.key();
            int32 y = 0;
            while (y < af.count()) {
                Row ra = af.get(y);
                int32 ya = y;
                y = y + 1;
                String ka #= ra.key();
                if (!ka.equals(key) || ra.unit.equals("pending") || Report.superseded(af, ya)) {
                    continue;
                }
                float64 delta = ra.median - rb.median;
                float64 pct = rb.median != 0.0 ? delta / rb.median * 100.0 : 0.0;
                float64 lo0 = rb.lo;
                float64 hi0 = rb.hi;
                int64 n0 = rb.n;
                int32 pi = Report.lastMeasured(bands, key);
                if (pi >= 0) {
                    Row rp = bands.get(pi);
                    lo0 = rp.lo < lo0 ? rp.lo : lo0;
                    hi0 = rp.hi > hi0 ? rp.hi : hi0;
                    n0 = n0 + rp.n;
                    res.widened = res.widened + 1;
                }
                res.paired = res.paired + 1;
                int32 v = Verdict.of(Report.lowerIsBetter(rb), lo0, hi0, n0, ra.median);
                if (rb.rounds > 1 && ra.rounds > 1) {
                    int32 vr = Verdict.ofRounds(Report.lowerIsBetter(rb), rb.roundLo, rb.roundHi, rb.roundMean,
                                                ra.roundLo, ra.roundHi, ra.roundMean);
                    if (rb.rounds >= Verdict.ROUNDS_ALONE && ra.rounds >= Verdict.ROUNDS_ALONE) {
                        v = vr;
                    } else if (v == Verdict.WORSE && vr != Verdict.WORSE) {
                        v = Verdict.KEEP;
                    }
                    res.byRounds = res.byRounds + 1;
                }
                String verdict = Verdict.name(v);
                String block #= Report.blockOf(rb.workload);
                if (v == Verdict.WORSE && Report.contendedBlock(b, af, block)) {
                    verdict = "contended";
                    res.contended = res.contended + 1;
                } else if (v == Verdict.WORSE) {
                    res.worse = res.worse + 1;
                } else if (v == Verdict.SINGLE) {
                    res.single = res.single + 1;
                }
                String dateCell = date.byteLength() > 0 ? date : ra.date;
                String bm #= Report.fmt(rb.median);
                String am #= Report.fmt(ra.median);
                String dm #= Report.fmt(delta);
                String dp #= Report.fmt(pct);
                String lo #= Report.fmt(lo0);
                String hi #= Report.fmt(hi0);
                System.stdout.println("| " + id + " | " + dateCell + " | " + unit + " | "
                    + rb.workload + " [" + rb.shape + "] | " + rb.backend + " | " + rb.kpi
                    + " | " + bm + " " + rb.unit + " | " + am + " " + ra.unit + " | " + dm + " ("
                    + dp + "%) | [" + lo + ", " + hi + "] | " + commit + " | " + verdict
                    + " | " + Report.cell(ra.note) + " |");
            }
        }
        System.stdout.println("");
        String singles = "";
        if (res.single > 0) {
            singles = "; " + res.single + " single-sample KPI(s) carry no verdict (no noise band "
                + "and no day-apart partner: pass --bands=<rerun rows>)";
        }
        String bandsNote = "";
        if (res.widened > 0) {
            bandsNote = "; " + res.widened + " KPI(s) banded by the union of two runs (--bands)";
        }
        if (res.byRounds > 0) {
            bandsNote = bandsNote + "; " + res.byRounds + " KPI(s) judged by arm rounds (worse only when every "
                + "after round is past every before round by more than the round spread, and with fewer than "
                + Verdict.ROUNDS_ALONE + " rounds per arm only when the band rule agrees)";
        }
        if (res.contended > 0) {
            bandsNote = bandsNote + "; " + res.contended + " KPI(s) worse while a witness saw foreign load "
                + "over " + Report.contendedCpuPct + "% CPU or " + Report.contendedGpuPct
                + "% GPU above the gate's idle level: contended, rerun on a quiet box";
        }
        if (res.worse == 0) {
            System.stdout.println("not-worse: every paired KPI with a noise band is inside it or better"
                + " (" + res.paired + " paired)" + bandsNote + singles);
        } else {
            System.stdout.println("not-worse FAILED: " + res.worse
                + " KPI(s) regressed beyond the noise band (" + res.paired + " paired)" + bandsNote + singles);
        }
        return res;
    }

    /**
     * xpubench-report spans --csv=<summary.csv> --rows=<profiled-run rows>
     *     --out=<leg rows.jsonl> [--llm --shape=<shape> --wall-ms=<int>]
     * `--csv=` and `--rows=` take comma lists, one entry per repeated pass, in the same order.
     *
     * Device-span rows from one profiled pass (plan 0.2.4). The pass's own
     * rows give the identity, the `launches` rows (value = iterations, note
     * = kernel names with multiplicity) and, for the CG stand-in, the wall
     * per iteration; the CSV gives the spans (Spans). The rows are appended
     * to the leg's file so `baseline` and `trial` see them beside the
     * host-clocked ones, with the same identity. `--llm` derives the
     * cajeta-llm rows instead, from the profiled process's wall.
     */
    public static int32 spans(String[] args) {
        String csvPath #= Report.opt(args, "--csv=", "");
        String rowsPath #= Report.opt(args, "--rows=", "");
        String outPath #= Report.opt(args, "--out=", "");
        String shape #= Report.opt(args, "--shape=", "");
        String wallS #= Report.opt(args, "--wall-ms=", "0");
        String armOverride #= Report.opt(args, "--arm=", "");
        boolean llm = false;
        int32 a = 0;
        while (a < (int32) args.count()) {
            if (args[a].equals("--llm")) {
                llm = true;
            }
            a = a + 1;
        }
        if (csvPath.byteLength() == 0 || rowsPath.byteLength() == 0 || outPath.byteLength() == 0) {
            System.stderr.println("usage: xpubench-report spans --csv=<summary.csv> --rows=<profiled rows> "
                + "--out=<leg rows> [--llm --shape=<shape> --wall-ms=<int>]");
            return 2;
        }
        // A comma list of summaries: repeated profiled passes, banded (0.1.4).
        ArrayList<Spans> passes = heap ArrayList<Spans>();
        int64 dropped = 0L;
        int32 st = 0;
        int32 ci = 0;
        while (ci <= csvPath.byteLength()) {
            if (ci == csvPath.byteLength() || csvPath.byteAt(ci) == 44) {
                if (ci > st) {
                    String one #= csvPath.substring(st, ci);
                    int8[] cb #= File.readAllBytes(one);
                    if (cb == null) {
                        System.stderr.println("xpubench-report: cannot read " + one);
                        return 1;
                    }
                    String csv #= heap String(#cb, (int32) cb.count());
                    Spans one1 #= Spans.parse(csv);
                    if (one1.dropped > 0L) {
                        dropped = dropped + one1.dropped;
                    }
                    passes.add(#one1);
                }
                st = ci + 1;
            }
            ci = ci + 1;
        }
        if (passes.count() == 0) {
            System.stderr.println("xpubench-report: no summary in --csv=" + csvPath);
            return 1;
        }
        ArrayList<ArrayList<Row>> passRows = heap ArrayList<ArrayList<Row>>();
        int32 rs = 0;
        int32 ri = 0;
        while (ri <= rowsPath.byteLength()) {
            if (ri == rowsPath.byteLength() || rowsPath.byteAt(ri) == 44) {
                if (ri > rs) {
                    String onePath #= rowsPath.substring(rs, ri);
                    passRows.add(#Report.loadFile(onePath));
                }
                rs = ri + 1;
            }
            ri = ri + 1;
        }
        if (passRows.count() == 0 || passRows.get(0).count() == 0) {
            System.stderr.println("xpubench-report: no rows in " + rowsPath);
            return 1;
        }
        ArrayList<Row> rows = passRows.get(0);
        Row id = rows.get(0);
        if (armOverride.byteLength() > 0) {
            id.arm #= "" + armOverride;
        }
        ArrayList<Derived> all = heap ArrayList<Derived>();
        if (llm) {
            ArrayList<ArrayList<Derived>> per = heap ArrayList<ArrayList<Derived>>();
            int32 pi = 0;
            while (pi < passes.count()) {
                ArrayList<Derived> d #= Spans.deriveLlm(passes.get(pi), shape, (float64) Long.parseLong(wallS));
                per.add(#d);
                pi = pi + 1;
            }
            ArrayList<Derived> merged #= Spans.combine(per);
            all.appendAll(merged);
        } else {
            int32 i = 0;
            while (i < rows.count()) {
                Row r = rows.get(i);
                if (r.kpi.equals("launches") && !r.unit.equals("pending")) {
                    float64[] walls = heap float64[passes.count()];
                    int32 p = 0;
                    while (p < passes.count()) {
                        ArrayList<Row> pr = passRows.get(p < passRows.count() ? p : passRows.count() - 1);
                        int32 j = 0;
                        while (j < pr.count()) {
                            Row w = pr.get(j);
                            if (w.kpi.equals("wall_per_iteration") && w.workload.equals(r.workload)
                                && w.shape.equals(r.shape) && !w.unit.equals("pending")) {
                                walls[p] = w.median;
                            }
                            j = j + 1;
                        }
                        p = p + 1;
                    }
                    ArrayList<Derived> d #= Spans.deriveRepeated(passes, r.workload, r.shape, r.note,
                                                                 (int64) r.median, walls);
                    all.appendAll(d);
                }
                i = i + 1;
            }
        }
        int32 k = 0;
        while (k < all.count()) {
            Report.writeRow(outPath, id, all.get(k));
            k = k + 1;
        }
        System.stdout.println("xpubench-report: " + all.count() + " span row(s) appended to " + outPath
            + " from " + passes.count() + " pass(es)"
            + (dropped > (int64) 0 ? " (ring dropped " + dropped + " records)" : ""));
        return 0;
    }

    /** One derived row in the harness's row schema, with the pass's identity. */
    static void writeRow(String path, Row id, Derived d) {
        JsonWriter w = heap JsonWriter();
        w.beginObject();
        w.key("workload");  w.writeString(d.workload);
        w.key("shape");     w.writeString(d.shape);
        w.key("kpi");       w.writeString(d.kpi);
        w.key("unit");      w.writeString(d.unit);
        float64 lo = d.value;
        float64 hi = d.value;
        int64 n = d.pending ? (int64) 0 : (int64) 1;
        if (!d.pending && d.n > 0L) {
            lo = d.lo;
            hi = d.hi;
            n = d.n;
        }
        w.key("median");    w.writeNumber(d.value);
        w.key("min");       w.writeNumber(lo);
        w.key("max");       w.writeNumber(hi);
        w.key("p95");       w.writeNumber(0.0);
        w.key("n");         w.writeNumber(n);
        if (!d.pending && d.n > 1L) {
            w.key("rounds");    w.writeNumber(d.n);
            w.key("roundLo");   w.writeNumber(d.lo);
            w.key("roundHi");   w.writeNumber(d.hi);
            w.key("roundMean"); w.writeNumber(d.mean);
        }
        w.key("device");    w.writeString(id.device);
        w.key("backend");   w.writeString(id.backend);
        w.key("driver");    w.writeString(id.driver);
        w.key("compiler");  w.writeString(id.compiler);
        w.key("powerMode"); w.writeString(id.powerMode);
        w.key("date");      w.writeString(id.date);
        w.key("arm");       w.writeString(id.arm);
        w.key("note");      w.writeString(d.note);
        w.endObject();
        FileWriter f #= File.openWrite(path, OpenMode.APPEND);
        w.writeLineTo(f);
        f.close();
    }

    public static int32 main(String[] args) {
        if (args.count() < 2) {
            System.stderr.println("usage: xpubench-report baseline <rows.jsonl>... | trial <before> <after> "
                + "--id= --unit= --commit= | spans --csv= --rows= --out= [--llm --shape= --wall-ms=]");
            return 2;
        }
        String verb = args[0];
        if (verb.equals("baseline")) {
            return Report.baseline(args, 1);
        }
        if (verb.equals("trial")) {
            return Report.trial(args);
        }
        if (verb.equals("spans")) {
            return Report.spans(args);
        }
        System.stderr.println("xpubench-report: unknown verb " + verb);
        return 2;
    }
}
