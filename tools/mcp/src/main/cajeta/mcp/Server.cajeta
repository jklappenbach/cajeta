package mcp;

import cajeta.lang.String;
import cajeta.io.file.FileReader;
import cajeta.io.file.FileWriter;
import cajeta.codec.json.JsonReader;
import cajeta.codec.json.JsonValue;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonWriter;
import cajeta.codec.json.JsonParseException;
import cajeta.process.Command;
import cajeta.process.ProcessResult;

/**
 * cajeta-mcp — an MCP (Model Context Protocol) server written in cajeta.
 *
 * Speaks JSON-RPC 2.0 over stdio (one JSON object per line) and implements its
 * tools by shelling out to the `cajeta` compiler via `cajeta.process` (later
 * units). Built with the cajeta build tool: `cajeta build` -> `build/cajeta-mcp`.
 *
 * C1: the stdio JSON-RPC loop + lifecycle (initialize / tools.list / tools.call)
 * with the five tools registered as stubs.
 */
public class Server {

    /** Path to the `cajeta` compiler the tools shell out to. */
    public static String cajetaBin;

    public static int32 main(String[] args) {
        Server.cajetaBin = Server.resolveCajetaBin(args);
        FileReader in = heap FileReader(0);
        FileWriter out = heap FileWriter(1);

        // Pending-bytes buffer (grows on demand). Newline-delimited framing:
        // accumulate reads, dispatch each complete line, shift the rest down.
        int8[] buf = heap int8[65536];
        int32 cap = 65536;
        int32 buflen = 0;
        int8[] chunk = heap int8[65536];

        boolean running = true;
        while (running) {
            int32 nl = Server.findNewline(buf, buflen);
            if (nl < 0) {
                int32 n = in.read(chunk, 65536);
                if (n <= 0) {
                    running = false;
                } else {
                    if (buflen + n > cap) {
                        int32 newCap = cap * 2;
                        while (newCap < buflen + n) {
                            newCap = newCap * 2;
                        }
                        int8[] grown = heap int8[newCap];
                        int32 k = 0;
                        while (k < buflen) {
                            grown[k] = buf[k];
                            k = k + 1;
                        }
                        buf = #grown;
                        cap = newCap;
                    }
                    int32 i = 0;
                    while (i < n) {
                        buf[buflen + i] = chunk[i];
                        i = i + 1;
                    }
                    buflen = buflen + n;
                }
            } else {
                if (nl > 0) {
                    Server.handleLine(buf, nl, out);
                }
                int32 rem = buflen - (nl + 1);
                int32 s = 0;
                while (s < rem) {
                    buf[s] = buf[nl + 1 + s];
                    s = s + 1;
                }
                buflen = rem;
            }
        }
        return 0;
    }

    /** Index of the first '\n' in `buf[0..len)`, or -1. */
    public static int32 findNewline(int8[] buf, int32 len) {
        int32 i = 0;
        while (i < len) {
            if (((int32) buf[i]) == 10) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** Parse one JSON-RPC request (`bytes[0..len)`) and write its response. */
    public static void handleLine(int8[] bytes, int32 len, FileWriter out) {
        // Hand the reader a fresh, owned copy of the line — the persistent
        // input `buf` must survive across requests.
        int8[] lineCopy = heap int8[len];
        int32 c = 0;
        while (c < len) {
            lineCopy[c] = bytes[c];
            c = c + 1;
        }
        try {
            JsonReader r = heap JsonReader(#lineCopy, (int64) len);
            JsonValue req = r.readValue();
            Server.dispatch(req, out);
        } catch (JsonParseException e) {
            Server.writeError(out, null, -32700, "Parse error");
        }
    }

    /** Dispatch a parsed JSON-RPC request object to its method handler. */
    public static void dispatch(JsonValue req, FileWriter out) {
        if (req == null || req.kind() != JsonValue.OBJECT) {
            Server.writeError(out, null, -32600, "Invalid Request");
            return;
        }
        JsonObject obj = req.asObject();
        JsonValue id = obj.get("id");
        JsonValue methodV = obj.get("method");
        if (methodV == null || methodV.kind() != JsonValue.STRING) {
            Server.writeError(out, null, -32600, "Invalid Request");
            return;
        }
        String method = methodV.asString();
        if (method.equals("initialize")) {
            Server.writeInitialize(out, id);
        } else if (method.equals("notifications/initialized")
                || method.equals("initialized")) {
            // notification: no response
        } else if (method.equals("tools/list")) {
            Server.writeToolsList(out, id);
        } else if (method.equals("tools/call")) {
            Server.writeToolCall(out, obj, id);
        } else {
            if (id != null) {
                Server.writeError(out, id, -32601, "Method not found");
            }
        }
    }

    /** Write `{"jsonrpc":"2.0","id":<id|null>` onto `w` (object left open). */
    public static void writeHead(JsonWriter w, JsonValue id) {
        w.beginObject();
        w.key("jsonrpc");
        w.writeString("2.0");
        w.key("id");
        if (id == null) {
            w.writeNull();
        } else {
            w.writeValue(id);
        }
    }

    public static void writeError(FileWriter out, JsonValue id, int32 code,
                                  String message) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("error");
        w.beginObject();
        w.key("code");
        w.writeNumber((int64) code);
        w.key("message");
        w.writeString(message);
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    public static void writeInitialize(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("protocolVersion");
        w.writeString("2024-11-05");
        w.key("capabilities");
        w.beginObject();
        w.key("tools");
        w.beginObject();
        w.endObject();
        w.endObject();
        w.key("serverInfo");
        w.beginObject();
        w.key("name");
        w.writeString("cajeta-mcp");
        w.key("version");
        w.writeString("0.1.0");
        w.endObject();
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    /** One tool descriptor: {name, description, inputSchema:{type:object}}. */
    public static void writeToolDesc(JsonWriter w, String name, String desc) {
        w.beginObject();
        w.key("name");
        w.writeString(name);
        w.key("description");
        w.writeString(desc);
        w.key("inputSchema");
        w.beginObject();
        w.key("type");
        w.writeString("object");
        w.endObject();
        w.endObject();
    }

    public static void writeToolsList(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("tools");
        w.beginArray();
        Server.writeToolDesc(w, "searchSkills",
            "Search skills by canonical name (fuzzy, typo-tolerant).");
        Server.writeToolDesc(w, "listSkills",
            "List the available skills catalog.");
        Server.writeToolDesc(w, "getSkills",
            "Fetch skill payloads by cja-skill:// URI.");
        Server.writeToolDesc(w, "compile",
            "Compile a cajeta source file-map; return diagnostics + artifact.");
        Server.writeToolDesc(w, "jit_execute",
            "Compile and JIT-execute a source file-map (process-per-execute).");
        w.endArray();
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    /** Resolve the cajeta exe path from `--cajeta=PATH`, else "cajeta". */
    public static #String resolveCajetaBin(String[] args) {
        int32 i = 0;
        while (i < args.count()) {
            String a = args[i];
            if (a.startsWith("--cajeta=")) {
                return a.substring(9, (int32) a.count());
            }
            i = i + 1;
        }
        return "cajeta";
    }

    /** Run `cajeta <args[0..argc)>` with captured stdout/stderr. */
    public static #ProcessResult runCajeta(String[] args, int32 argc) {
        String[] argv = heap String[argc + 1];
        String bin = Server.cajetaBin;
        argv[0] = bin.substring(0, (int32) bin.count());
        int32 i = 0;
        while (i < argc) {
            String a = args[i];
            argv[i + 1] = a.substring(0, (int32) a.count());
            i = i + 1;
        }
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        cmd.captureStderr();
        return cmd.run();
    }

    /** Parse `bytes[0..len)` as JSON (owned copy for the reader); null on error. */
    public static #JsonValue parseJsonCopy(int8[] bytes, int32 len) {
        int8[] copy = heap int8[len];
        int32 i = 0;
        while (i < len) {
            copy[i] = bytes[i];
            i = i + 1;
        }
        try {
            JsonReader r = heap JsonReader(#copy, (int64) len);
            return r.readValue();
        } catch (JsonParseException e) {
            return null;
        }
    }

    /** Run a skill subcommand and wrap its parsed JSON array under `field`. */
    public static void runSkill(FileWriter out, JsonValue id, String[] args,
                                int32 argc, String field) {
        ProcessResult r = Server.runCajeta(args, argc);
        if (r.launched() == false) {
            Server.writeError(out, id, -32603, "failed to launch cajeta");
            return;
        }
        int8[] outBytes = r.stdout();
        JsonValue arr = null;
        if (outBytes != null && outBytes.count() > 0) {
            arr = Server.parseJsonCopy(outBytes, (int32) outBytes.count());
        }
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key(field);
        if (arr == null) {
            w.beginArray();
            w.endArray();
        } else {
            w.writeValue(arr);
        }
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    public static void writeToolCall(FileWriter out, JsonObject req, JsonValue id) {
        JsonValue params = req.get("params");
        if (params == null || params.kind() != JsonValue.OBJECT) {
            Server.writeError(out, id, -32602, "tools/call requires params");
            return;
        }
        JsonObject p = params.asObject();
        JsonValue nameV = p.get("name");
        if (nameV == null || nameV.kind() != JsonValue.STRING) {
            Server.writeError(out, id, -32602, "tools/call requires a name");
            return;
        }
        String name = nameV.asString();
        JsonValue argsV = p.get("arguments");
        JsonObject toolArgs = null;
        if (argsV != null && argsV.kind() == JsonValue.OBJECT) {
            toolArgs = argsV.asObject();
        }

        if (name.equals("searchSkills")) {
            if (toolArgs == null || toolArgs.containsKey("name") == false) {
                Server.writeError(out, id, -32602, "searchSkills requires 'name'");
                return;
            }
            JsonValue nv = toolArgs.get("name");
            if (nv == null || nv.kind() != JsonValue.STRING) {
                Server.writeError(out, id, -32602, "searchSkills 'name' must be a string");
                return;
            }
            String[] a = heap String[3];
            a[0] = "search-skill";
            a[1] = nv.asString();
            a[2] = "--json";
            Server.runSkill(out, id, a, 3, "results");
        } else if (name.equals("listSkills")) {
            String[] a = heap String[2];
            a[0] = "list-skills";
            a[1] = "--json";
            Server.runSkill(out, id, a, 2, "skills");
        } else if (name.equals("getSkills")) {
            if (toolArgs == null || toolArgs.containsKey("uris") == false) {
                Server.writeError(out, id, -32602, "getSkills requires 'uris'");
                return;
            }
            JsonValue uv = toolArgs.get("uris");
            if (uv == null || uv.kind() != JsonValue.ARRAY) {
                Server.writeError(out, id, -32602, "getSkills 'uris' must be an array");
                return;
            }
            String[] a = heap String[3];
            a[0] = "get-skills";
            a[1] = Server.joinUris(uv.asArray());
            a[2] = "--json";
            Server.runSkill(out, id, a, 3, "skills");
        } else {
            // compile (C3), jit_execute (C4): stub.
            Server.writeStub(out, id);
        }
    }

    /** Comma-join the string elements of `arr` into a single String. */
    public static #String joinUris(JsonArray arr) {
        int32 n = arr.count();
        int32 total = 0;
        int32 emitted = 0;
        int32 i = 0;
        while (i < n) {
            JsonValue e = arr.get(i);
            if (e.kind() == JsonValue.STRING) {
                if (emitted > 0) {
                    total = total + 1;
                }
                total = total + e.asBytesLength();
                emitted = emitted + 1;
            }
            i = i + 1;
        }
        int8[] buf = heap int8[total];
        int32 pos = 0;
        emitted = 0;
        i = 0;
        while (i < n) {
            JsonValue e = arr.get(i);
            if (e.kind() == JsonValue.STRING) {
                if (emitted > 0) {
                    buf[pos] = (int8) 44;
                    pos = pos + 1;
                }
                int8[] eb = e.asBytes();
                int32 el = e.asBytesLength();
                int32 k = 0;
                while (k < el) {
                    buf[pos] = eb[k];
                    pos = pos + 1;
                    k = k + 1;
                }
                emitted = emitted + 1;
            }
            i = i + 1;
        }
        return heap String(#buf, total);
    }

    public static void writeStub(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("content");
        w.beginArray();
        w.beginObject();
        w.key("type");
        w.writeString("text");
        w.key("text");
        w.writeString("not implemented");
        w.endObject();
        w.endArray();
        w.key("isError");
        w.writeBoolean(true);
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }
}
