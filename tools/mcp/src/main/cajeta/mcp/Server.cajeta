package mcp;

import cajeta.lang.String;
import cajeta.lang.Optional;
import cajeta.io.file.File;
import cajeta.io.file.FileReader;
import cajeta.io.file.FileWriter;
import cajeta.codec.Base64;
import cajeta.hash.Sha256;
import cajeta.codec.json.JsonReader;
import cajeta.codec.json.JsonValue;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonWriter;
import cajeta.codec.json.JsonParseException;
import cajeta.process.Command;
import cajeta.process.ProcessResult;

/**
 * cajeta-mcp — an MCP (Model Context Protocol) server written in cajeta.
 *
 * Speaks JSON-RPC 2.0 over stdio (one JSON object per line) and implements its
 * tools by shelling out to the `cajeta` compiler via `cajeta.process` (later
 * units). Built with the cajeta build tool: `cajeta build` -> `build/cajeta-mcp`.
 *
 * C1: the stdio JSON-RPC loop + lifecycle (initialize / tools.list / tools.call)
 * with the five tools registered as stubs.
 */
public class Server {

    /** Path to the `cajeta` compiler the tools shell out to. */
    public static String cajetaBin;

    /** Resolved execution-cache config (CLI > env > --config file > default). */
    public static boolean cacheEnabled;
    public static String cacheDir;
    public static int32 cacheTtl;
    public static int64 cacheMaxBytes;
    public static int32 cacheMaxEntries;

    /** Values parsed from the `--config` JSON `cache` object (set => present). */
    public static String fileDir;
    public static int64 fileTtl;
    public static boolean fileTtlSet;
    public static int64 fileMaxBytes;
    public static boolean fileMaxBytesSet;
    public static int64 fileMaxEntries;
    public static boolean fileMaxEntriesSet;
    public static boolean fileEnabled;
    public static boolean fileEnabledSet;

    public static int32 main(String[] args) {
        Server.cajetaBin = Server.resolveCajetaBin(args);
        Server.resolveConfig(args);
        if (Server.cacheEnabled) {
            Server.mkdirp(Server.cacheDir);
        }
        FileReader in = heap FileReader(0);
        FileWriter out = heap FileWriter(1);

        // Pending-bytes buffer (grows on demand). Newline-delimited framing:
        // accumulate reads, dispatch each complete line, shift the rest down.
        int8[] buf = heap int8[65536];
        int32 cap = 65536;
        int32 buflen = 0;
        int8[] chunk = heap int8[65536];

        boolean running = true;
        while (running) {
            int32 nl = Server.findNewline(buf, buflen);
            if (nl < 0) {
                int32 n = in.read(chunk, 65536);
                if (n <= 0) {
                    running = false;
                } else {
                    if (buflen + n > cap) {
                        int32 newCap = cap * 2;
                        while (newCap < buflen + n) {
                            newCap = newCap * 2;
                        }
                        int8[] grown = heap int8[newCap];
                        int32 k = 0;
                        while (k < buflen) {
                            grown[k] = buf[k];
                            k = k + 1;
                        }
                        buf = #grown;
                        cap = newCap;
                    }
                    int32 i = 0;
                    while (i < n) {
                        buf[buflen + i] = chunk[i];
                        i = i + 1;
                    }
                    buflen = buflen + n;
                }
            } else {
                if (nl > 0) {
                    Server.handleLine(buf, nl, out);
                }
                int32 rem = buflen - (nl + 1);
                int32 s = 0;
                while (s < rem) {
                    buf[s] = buf[nl + 1 + s];
                    s = s + 1;
                }
                buflen = rem;
            }
        }
        return 0;
    }

    /** Index of the first '\n' in `buf[0..len)`, or -1. */
    public static int32 findNewline(int8[] buf, int32 len) {
        int32 i = 0;
        while (i < len) {
            if (((int32) buf[i]) == 10) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** Parse one JSON-RPC request (`bytes[0..len)`) and write its response. */
    public static void handleLine(int8[] bytes, int32 len, FileWriter out) {
        // Hand the reader a fresh, owned copy of the line — the persistent
        // input `buf` must survive across requests.
        int8[] lineCopy = heap int8[len];
        int32 c = 0;
        while (c < len) {
            lineCopy[c] = bytes[c];
            c = c + 1;
        }
        try {
            JsonReader r = heap JsonReader(#lineCopy, (int64) len);
            JsonValue req = r.readValue();
            Server.dispatch(req, out);
        } catch (JsonParseException e) {
            Server.writeError(out, null, -32700, "Parse error");
        }
    }

    /** Dispatch a parsed JSON-RPC request object to its method handler. */
    public static void dispatch(JsonValue req, FileWriter out) {
        if (req == null || req.kind() != JsonValue.OBJECT) {
            Server.writeError(out, null, -32600, "Invalid Request");
            return;
        }
        JsonObject obj = req.asObject();
        JsonValue id = obj.get("id");
        JsonValue methodV = obj.get("method");
        if (methodV == null || methodV.kind() != JsonValue.STRING) {
            Server.writeError(out, null, -32600, "Invalid Request");
            return;
        }
        String method = methodV.asString();
        if (method.equals("initialize")) {
            Server.writeInitialize(out, id);
        } else if (method.equals("notifications/initialized")
                || method.equals("initialized")) {
            // notification: no response
        } else if (method.equals("tools/list")) {
            Server.writeToolsList(out, id);
        } else if (method.equals("tools/call")) {
            Server.writeToolCall(out, obj, id);
        } else {
            if (id != null) {
                Server.writeError(out, id, -32601, "Method not found");
            }
        }
    }

    /** Write `{"jsonrpc":"2.0","id":<id|null>` onto `w` (object left open). */
    public static void writeHead(JsonWriter w, JsonValue id) {
        w.beginObject();
        w.key("jsonrpc");
        w.writeString("2.0");
        w.key("id");
        if (id == null) {
            w.writeNull();
        } else {
            w.writeValue(id);
        }
    }

    public static void writeError(FileWriter out, JsonValue id, int32 code,
                                  String message) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("error");
        w.beginObject();
        w.key("code");
        w.writeNumber((int64) code);
        w.key("message");
        w.writeString(message);
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    public static void writeInitialize(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("protocolVersion");
        w.writeString("2024-11-05");
        w.key("capabilities");
        w.beginObject();
        w.key("tools");
        w.beginObject();
        w.endObject();
        w.endObject();
        w.key("serverInfo");
        w.beginObject();
        w.key("name");
        w.writeString("cajeta-mcp");
        w.key("version");
        w.writeString("0.1.0");
        w.endObject();
        w.key("cacheConfig");
        w.beginObject();
        w.key("enabled");
        w.writeBoolean(Server.cacheEnabled);
        w.key("dir");
        w.writeString(Server.cacheDir);
        w.key("ttl");
        w.writeNumber((int64) Server.cacheTtl);
        w.key("maxBytes");
        w.writeNumber(Server.cacheMaxBytes);
        w.key("maxEntries");
        w.writeNumber((int64) Server.cacheMaxEntries);
        w.endObject();
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    /** One tool descriptor: {name, description, inputSchema:{type:object}}. */
    public static void writeToolDesc(JsonWriter w, String name, String desc) {
        w.beginObject();
        w.key("name");
        w.writeString(name);
        w.key("description");
        w.writeString(desc);
        w.key("inputSchema");
        w.beginObject();
        w.key("type");
        w.writeString("object");
        w.endObject();
        w.endObject();
    }

    public static void writeToolsList(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("tools");
        w.beginArray();
        Server.writeToolDesc(w, "searchSkills",
            "Search skills by canonical name (fuzzy, typo-tolerant).");
        Server.writeToolDesc(w, "listSkills",
            "List the available skills catalog.");
        Server.writeToolDesc(w, "getSkills",
            "Fetch skill payloads by cja-skill:// URI.");
        Server.writeToolDesc(w, "compile",
            "Compile a cajeta source file-map; return diagnostics + artifact.");
        Server.writeToolDesc(w, "jit_execute",
            "Compile and JIT-execute a source file-map (process-per-execute).");
        w.endArray();
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    /** Resolve the cajeta exe path: `--cajeta=PATH` > `$CAJETA_BIN` > "cajeta". */
    public static #String resolveCajetaBin(String[] args) {
        int32 i = 0;
        while (i < args.count()) {
            String a = args[i];
            if (a.startsWith("--cajeta=")) {
                return a.substring(9, (int32) a.count());
            }
            i = i + 1;
        }
        String env = Server.getEnv("CAJETA_BIN");
        if (env != null) {
            return env;
        }
        return "cajeta";
    }

    // ---- C5: configuration (CLI > env > --config file > default) ----

    /** Value of the first arg starting with `prefix` (after it), or null. */
    public static #String flagValue(String[] args, String prefix) {
        int32 i = 0;
        while (i < args.count()) {
            String a = args[i];
            if (a.startsWith(prefix)) {
                return a.substring(prefix.byteLength, (int32) a.count());
            }
            i = i + 1;
        }
        return null;
    }

    /** True if `flag` appears verbatim in args. */
    public static boolean hasFlag(String[] args, String flag) {
        int32 i = 0;
        while (i < args.count()) {
            if (args[i].equals(flag)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /** Read env var `name` via `printenv` (cajeta exposes no getenv); null if unset. */
    public static #String getEnv(String name) {
        String[] argv = heap String[2];
        argv[0] = Server.dup("printenv");
        argv[1] = Server.dup(name);
        ProcessResult r = Server.runArgv(#argv);
        if (r.launched() == false || r.exitCode() != 0) {
            return null;
        }
        int8[] o = r.stdout();
        if (o == null) {
            return null;
        }
        int32 len = (int32) o.count();
        while (len > 0 && (((int32) o[len - 1]) == 10 || ((int32) o[len - 1]) == 13)) {
            len = len - 1;
        }
        if (len == 0) {
            return null;
        }
        return Server.rangeToString(o, 0, len);
    }

    /** Parse a decimal int64 from `s` (stops at the first non-digit). */
    public static int64 parseInt(String s) {
        int64 v = (int64) 0;
        int32 n = s.byteLength;
        int32 i = 0;
        boolean neg = false;
        if (n > 0 && ((int32) s.bytes[0]) == 45) {
            neg = true;
            i = 1;
        }
        boolean done = false;
        while (i < n && done == false) {
            int32 c = ((int32) s.bytes[i]) & 255;
            if (c < 48 || c > 57) {
                done = true;
            } else {
                v = v * (int64) 10 + (int64) (c - 48);
                i = i + 1;
            }
        }
        if (neg) {
            v = - v;
        }
        return v;
    }

    /** Decimal string for `v` (null-terminated). */
    public static #String intToStr(int64 v) {
        if (v == (int64) 0) {
            int8[] z = heap int8[2];
            z[0] = (int8) 48;
            z[1] = (int8) 0;
            return heap String(#z, 1);
        }
        boolean neg = false;
        if (v < (int64) 0) {
            neg = true;
            v = - v;
        }
        int8[] tmp = heap int8[24];
        int32 nd = 0;
        while (v > (int64) 0) {
            int64 d = v % (int64) 10;
            tmp[nd] = (int8) (d + (int64) 48);
            v = v / (int64) 10;
            nd = nd + 1;
        }
        int32 total = nd;
        if (neg) {
            total = total + 1;
        }
        int8[] buf = heap int8[total + 1];
        int32 o = 0;
        if (neg) {
            buf[o] = (int8) 45;
            o = o + 1;
        }
        int32 i = nd - 1;
        while (i >= 0) {
            buf[o] = tmp[i];
            o = o + 1;
            i = i - 1;
        }
        buf[total] = (int8) 0;
        return heap String(#buf, total);
    }

    /** Parse the `--config` JSON `cache` object into the file* statics. */
    public static void loadConfigFile(String[] args) {
        String cfgPath = Server.flagValue(args, "--config=");
        if (cfgPath == null) {
            return;
        }
        int8[] bytes = File.readAllBytes(cfgPath);
        if (bytes == null) {
            return;
        }
        JsonValue root = Server.parseJsonCopy(bytes, (int32) bytes.count());
        if (root == null || root.kind() != JsonValue.OBJECT) {
            return;
        }
        Optional<JsonObject> co = root.asObject().getObject("cache");
        if (co.isPresent() == false) {
            return;
        }
        JsonObject c = co.get();
        Optional<String> d = c.getString("dir");
        if (d.isPresent()) {
            Server.fileDir = Server.dup(d.get());
        }
        Optional<int64> t = c.getLong("ttl");
        if (t.isPresent()) {
            Server.fileTtl = t.get();
            Server.fileTtlSet = true;
        }
        Optional<int64> mb = c.getLong("maxBytes");
        if (mb.isPresent()) {
            Server.fileMaxBytes = mb.get();
            Server.fileMaxBytesSet = true;
        }
        Optional<int64> me = c.getLong("maxEntries");
        if (me.isPresent()) {
            Server.fileMaxEntries = me.get();
            Server.fileMaxEntriesSet = true;
        }
        Optional<boolean> en = c.getBoolean("enabled");
        if (en.isPresent()) {
            Server.fileEnabled = en.get();
            Server.fileEnabledSet = true;
        }
    }

    /** Resolve an int setting: CLI flag > env var > file key > default. */
    public static int64 resolveInt(String[] args, String cliPrefix, String envName,
                                   boolean fileSet, int64 fileVal, int64 dflt) {
        String cli = Server.flagValue(args, cliPrefix);
        if (cli != null) {
            return Server.parseInt(cli);
        }
        String env = Server.getEnv(envName);
        if (env != null) {
            return Server.parseInt(env);
        }
        if (fileSet) {
            return fileVal;
        }
        return dflt;
    }

    /** Resolve the cache directory: CLI > env > file > default. */
    public static #String resolveCacheDir(String[] args) {
        String cli = Server.flagValue(args, "--cache-dir=");
        if (cli != null) {
            return cli;
        }
        String env = Server.getEnv("CAJETA_MCP_CACHE_DIR");
        if (env != null) {
            return env;
        }
        if (Server.fileDir != null) {
            return Server.dup(Server.fileDir);
        }
        return Server.dup("/tmp/cajeta-mcp-cache");
    }

    /** Resolve cache enablement: CLI (--cache=/--no-cache) > env > file > default(on). */
    public static boolean resolveCacheEnabled(String[] args) {
        String cli = Server.flagValue(args, "--cache=");
        if (cli != null) {
            return cli.equals("on") || cli.equals("true") || cli.equals("1");
        }
        if (Server.hasFlag(args, "--no-cache")) {
            return false;
        }
        String env = Server.getEnv("CAJETA_MCP_CACHE_ENABLED");
        if (env != null) {
            return env.equals("1") || env.equals("true") || env.equals("on");
        }
        if (Server.fileEnabledSet) {
            return Server.fileEnabled;
        }
        return true;
    }

    /** Populate the resolved cache config statics from all sources. */
    public static void resolveConfig(String[] args) {
        Server.loadConfigFile(args);
        Server.cacheDir = Server.resolveCacheDir(args);
        Server.cacheTtl = (int32) Server.resolveInt(args, "--cache-ttl=",
            "CAJETA_MCP_CACHE_TTL", Server.fileTtlSet, Server.fileTtl, (int64) 3600);
        Server.cacheMaxBytes = Server.resolveInt(args, "--cache-max-bytes=",
            "CAJETA_MCP_CACHE_MAX_BYTES", Server.fileMaxBytesSet, Server.fileMaxBytes,
            (int64) 104857600);
        Server.cacheMaxEntries = (int32) Server.resolveInt(args, "--cache-max-entries=",
            "CAJETA_MCP_CACHE_MAX_ENTRIES", Server.fileMaxEntriesSet, Server.fileMaxEntries,
            (int64) 256);
        Server.cacheEnabled = Server.resolveCacheEnabled(args);
    }

    // ---- C5: on-disk execution cache (Sha256 key; TTL + LRU via shell) ----

    public static void hashStr(Sha256 h, String s) {
        int8[] b = s.bytes;
        int32 n = s.byteLength;
        h.update(b, (int64) n);
    }

    /** Feed a NUL field-separator into the hash (avoids boundary ambiguity). */
    public static void hashSep(Sha256 h) {
        int8[] s = heap int8[1];
        s[0] = (int8) 0;
        h.update(s, (int64) 1);
    }

    /** Cache key = Sha256(toolchain, tool, entry, each file path+content) hex. */
    public static #String computeKey(String tool, String entry, JsonObject files) {
        Sha256 h = heap Sha256();
        Server.hashStr(h, Server.cajetaBin);
        Server.hashSep(h);
        Server.hashStr(h, tool);
        Server.hashSep(h);
        Server.hashStr(h, entry);
        Server.hashSep(h);
        int32 fn = files.count();
        int32 i = 0;
        while (i < fn) {
            int8[] k = files.keyAt(i);
            int32 kl = files.keyLenAt(i);
            h.update(k, (int64) kl);
            Server.hashSep(h);
            JsonValue cv = files.valueAt(i);
            int8[] cb = cv.asBytes();
            if (cb != null) {
                int32 cl = cv.asBytesLength();
                h.update(cb, (int64) cl);
            }
            Server.hashSep(h);
            i = i + 1;
        }
        return h.hex();
    }

    /**
     * Look up `key` in the on-disk cache. The whole probe — existence, TTL
     * (now - mtime <= ttl), LRU touch, and read — is one `sh -c` so it stays
     * atomic-ish and needs no cajeta stat/time/dir API. Returns the cached
     * result-object bytes (owned copy) or null on miss/expiry.
     */
    public static #int8[] cacheGet(String key) {
        String path = Server.joinPath(Server.cacheDir, key);
        String ttlStr = Server.intToStr((int64) Server.cacheTtl);
        String[] argv = heap String[5];
        argv[0] = Server.dup("sh");
        argv[1] = Server.dup("-c");
        argv[2] = Server.dup("f=\"$0\"; t=\"$1\"; if [ -f \"$f\" ] && [ $(( $(date +%s) - $(stat -c %Y \"$f\") )) -le \"$t\" ]; then touch \"$f\"; cat \"$f\"; exit 0; fi; rm -f \"$f\"; exit 1");
        argv[3] = Server.dup(path);
        argv[4] = Server.dup(ttlStr);
        ProcessResult r = Server.runArgv(#argv);
        if (r.launched() == false || r.exitCode() != 0) {
            return null;
        }
        int8[] o = r.stdout();
        if (o == null) {
            return null;
        }
        int32 len = (int32) o.count();
        if (len == 0) {
            return null;
        }
        int8[] buf = heap int8[len];
        int32 i = 0;
        while (i < len) {
            buf[i] = o[i];
            i = i + 1;
        }
        return #buf;
    }

    /** Write `objBytes[0..len)` under `key`, then enforce entry/byte LRU caps. */
    public static void cachePut(String key, int8[] objBytes, int32 len) {
        String path = Server.joinPath(Server.cacheDir, key);
        File.writeAllBytes(path, objBytes, len);
        String me = Server.intToStr((int64) Server.cacheMaxEntries);
        String mb = Server.intToStr(Server.cacheMaxBytes);
        String[] argv = heap String[6];
        argv[0] = Server.dup("sh");
        argv[1] = Server.dup("-c");
        argv[2] = Server.dup("cd \"$0\" 2>/dev/null || exit 0; ls -1t 2>/dev/null | tail -n +$(( $1 + 1 )) | while IFS= read -r f; do rm -f -- \"$f\"; done; tot=0; ls -1t 2>/dev/null | while IFS= read -r f; do sz=$(stat -c %s -- \"$f\" 2>/dev/null || echo 0); tot=$((tot+sz)); [ \"$tot\" -gt \"$2\" ] && rm -f -- \"$f\"; done");
        argv[3] = Server.dup(Server.cacheDir);
        argv[4] = Server.dup(me);
        argv[5] = Server.dup(mb);
        ProcessResult r = Server.runArgv(#argv);
    }

    /**
     * Emit `{...,"id":id,"result":{<objBytes minus its closing brace>,
     * "cacheHit":<hit>}}`. `objBytes` is a result object built WITHOUT the
     * cacheHit field (the cached form); we splice cacheHit in here so one blob
     * serves both fresh and cached emits.
     */
    public static void emitResultLine(FileWriter out, JsonValue id, int8[] objBytes,
                                      boolean hit) {
        int32 len = (int32) objBytes.count();
        String suffix = ",\"cacheHit\":false}";
        if (hit) {
            suffix = ",\"cacheHit\":true}";
        }
        int32 slen = suffix.byteLength;
        int8[] full = heap int8[(len - 1) + slen];
        int32 o = 0;
        int32 i = 0;
        while (i < len - 1) {
            full[o] = objBytes[i];
            o = o + 1;
            i = i + 1;
        }
        int32 j = 0;
        while (j < slen) {
            full[o] = suffix.bytes[j];
            o = o + 1;
            j = j + 1;
        }
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.writeRaw(full, o);
        w.endObject();
        w.writeLineTo(out);
    }

    /** Run `cajeta <args[0..argc)>` with captured stdout/stderr. */
    public static #ProcessResult runCajeta(String[] args, int32 argc) {
        String[] argv = heap String[argc + 1];
        String bin = Server.cajetaBin;
        argv[0] = bin.substring(0, (int32) bin.count());
        int32 i = 0;
        while (i < argc) {
            String a = args[i];
            argv[i + 1] = a.substring(0, (int32) a.count());
            i = i + 1;
        }
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        cmd.captureStderr();
        return cmd.run();
    }

    /** Parse `bytes[0..len)` as JSON (owned copy for the reader); null on error. */
    public static #JsonValue parseJsonCopy(int8[] bytes, int32 len) {
        int8[] copy = heap int8[len];
        int32 i = 0;
        while (i < len) {
            copy[i] = bytes[i];
            i = i + 1;
        }
        try {
            JsonReader r = heap JsonReader(#copy, (int64) len);
            return r.readValue();
        } catch (JsonParseException e) {
            return null;
        }
    }

    /** Run a skill subcommand and wrap its parsed JSON array under `field`. */
    public static void runSkill(FileWriter out, JsonValue id, String[] args,
                                int32 argc, String field) {
        ProcessResult r = Server.runCajeta(args, argc);
        if (r.launched() == false) {
            Server.writeError(out, id, -32603, "failed to launch cajeta");
            return;
        }
        int8[] outBytes = r.stdout();
        JsonValue arr = null;
        if (outBytes != null && outBytes.count() > 0) {
            arr = Server.parseJsonCopy(outBytes, (int32) outBytes.count());
        }
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key(field);
        if (arr == null) {
            w.beginArray();
            w.endArray();
        } else {
            w.writeValue(arr);
        }
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }

    public static void writeToolCall(FileWriter out, JsonObject req, JsonValue id) {
        JsonValue params = req.get("params");
        if (params == null || params.kind() != JsonValue.OBJECT) {
            Server.writeError(out, id, -32602, "tools/call requires params");
            return;
        }
        JsonObject p = params.asObject();
        JsonValue nameV = p.get("name");
        if (nameV == null || nameV.kind() != JsonValue.STRING) {
            Server.writeError(out, id, -32602, "tools/call requires a name");
            return;
        }
        String name = nameV.asString();
        JsonValue argsV = p.get("arguments");
        JsonObject toolArgs = null;
        if (argsV != null && argsV.kind() == JsonValue.OBJECT) {
            toolArgs = argsV.asObject();
        }

        if (name.equals("searchSkills")) {
            if (toolArgs == null || toolArgs.containsKey("name") == false) {
                Server.writeError(out, id, -32602, "searchSkills requires 'name'");
                return;
            }
            JsonValue nv = toolArgs.get("name");
            if (nv == null || nv.kind() != JsonValue.STRING) {
                Server.writeError(out, id, -32602, "searchSkills 'name' must be a string");
                return;
            }
            String[] a = heap String[3];
            a[0] = "search-skill";
            a[1] = nv.asString();
            a[2] = "--json";
            Server.runSkill(out, id, a, 3, "results");
        } else if (name.equals("listSkills")) {
            String[] a = heap String[2];
            a[0] = "list-skills";
            a[1] = "--json";
            Server.runSkill(out, id, a, 2, "skills");
        } else if (name.equals("getSkills")) {
            if (toolArgs == null || toolArgs.containsKey("uris") == false) {
                Server.writeError(out, id, -32602, "getSkills requires 'uris'");
                return;
            }
            JsonValue uv = toolArgs.get("uris");
            if (uv == null || uv.kind() != JsonValue.ARRAY) {
                Server.writeError(out, id, -32602, "getSkills 'uris' must be an array");
                return;
            }
            String[] a = heap String[3];
            a[0] = "get-skills";
            a[1] = Server.joinUris(uv.asArray());
            a[2] = "--json";
            Server.runSkill(out, id, a, 3, "skills");
        } else if (name.equals("compile")) {
            Server.writeCompile(out, toolArgs, id);
        } else if (name.equals("jit_execute")) {
            Server.writeJitExecute(out, toolArgs, id);
        } else {
            Server.writeStub(out, id);
        }
    }

    /** Comma-join the string elements of `arr` into a single String. */
    public static #String joinUris(JsonArray arr) {
        int32 n = arr.count();
        int32 total = 0;
        int32 emitted = 0;
        int32 i = 0;
        while (i < n) {
            JsonValue e = arr.get(i);
            if (e.kind() == JsonValue.STRING) {
                if (emitted > 0) {
                    total = total + 1;
                }
                total = total + e.asBytesLength();
                emitted = emitted + 1;
            }
            i = i + 1;
        }
        int8[] buf = heap int8[total];
        int32 pos = 0;
        emitted = 0;
        i = 0;
        while (i < n) {
            JsonValue e = arr.get(i);
            if (e.kind() == JsonValue.STRING) {
                if (emitted > 0) {
                    buf[pos] = (int8) 44;
                    pos = pos + 1;
                }
                int8[] eb = e.asBytes();
                int32 el = e.asBytesLength();
                int32 k = 0;
                while (k < el) {
                    buf[pos] = eb[k];
                    pos = pos + 1;
                    k = k + 1;
                }
                emitted = emitted + 1;
            }
            i = i + 1;
        }
        return heap String(#buf, total);
    }

    // ---- C3: compile tool (filesystem ops shell out via cajeta.process) ----

    /** Owned copy of `s` (cajeta has no String concat / copy primitive). */
    public static #String dup(String s) {
        return s.substring(0, s.byteLength);
    }

    /**
     * Owned String from `b[start..end)`, null-terminated. Strings handed to
     * the `File.*` path intrinsics must be NUL-terminated (the runtime does
     * `strlen(path)`); only literals get that for free, so every path String
     * we build carries an explicit terminator past its `byteLength`.
     */
    public static #String rangeToString(int8[] b, int32 start, int32 end) {
        int32 len = end - start;
        int8[] buf = heap int8[len + 1];
        int32 i = 0;
        while (i < len) {
            buf[i] = b[start + i];
            i = i + 1;
        }
        buf[len] = (int8) 0;
        return heap String(#buf, len);
    }

    /** "a/b" (null-terminated). */
    public static #String joinPath(String a, String b) {
        int32 alen = a.byteLength;
        int32 blen = b.byteLength;
        int32 total = alen + 1 + blen;
        int8[] buf = heap int8[total + 1];
        int32 i = 0;
        while (i < alen) {
            buf[i] = a.bytes[i];
            i = i + 1;
        }
        buf[alen] = (int8) 47;
        int32 j = 0;
        while (j < blen) {
            buf[alen + 1 + j] = b.bytes[j];
            j = j + 1;
        }
        buf[total] = (int8) 0;
        return heap String(#buf, total);
    }

    /** "a"+"b" (null-terminated). */
    public static #String concat(String a, String b) {
        int32 alen = a.byteLength;
        int32 blen = b.byteLength;
        int32 total = alen + blen;
        int8[] buf = heap int8[total + 1];
        int32 i = 0;
        while (i < alen) {
            buf[i] = a.bytes[i];
            i = i + 1;
        }
        int32 j = 0;
        while (j < blen) {
            buf[alen + j] = b.bytes[j];
            j = j + 1;
        }
        buf[total] = (int8) 0;
        return heap String(#buf, total);
    }

    /** One hex digit's value, or -1. */
    public static int32 hexVal(int32 c) {
        if (c >= 48 && c <= 57) {
            return c - 48;
        }
        if (c >= 97 && c <= 102) {
            return c - 87;
        }
        if (c >= 65 && c <= 70) {
            return c - 55;
        }
        return -1;
    }

    /**
     * Decode a JSON string body `raw[0..len)` (escapes kept verbatim by the
     * cajeta reader) into its actual bytes. Handles \n \t \r \" \\ \/ \b \f
     * and \uXXXX (BMP, UTF-8 encoded). Decoded length never exceeds `len`.
     */
    public static #String decodeJsonString(int8[] raw, int32 len) {
        int8[] buf = heap int8[len + 1];
        int32 o = 0;
        int32 i = 0;
        while (i < len) {
            int32 c = ((int32) raw[i]) & 255;
            if (c == 92 && i + 1 < len) {
                int32 e = ((int32) raw[i + 1]) & 255;
                if (e == 110) { buf[o] = (int8) 10; o = o + 1; i = i + 2; }
                else if (e == 116) { buf[o] = (int8) 9; o = o + 1; i = i + 2; }
                else if (e == 114) { buf[o] = (int8) 13; o = o + 1; i = i + 2; }
                else if (e == 34) { buf[o] = (int8) 34; o = o + 1; i = i + 2; }
                else if (e == 92) { buf[o] = (int8) 92; o = o + 1; i = i + 2; }
                else if (e == 47) { buf[o] = (int8) 47; o = o + 1; i = i + 2; }
                else if (e == 98) { buf[o] = (int8) 8; o = o + 1; i = i + 2; }
                else if (e == 102) { buf[o] = (int8) 12; o = o + 1; i = i + 2; }
                else if (e == 117 && i + 5 < len) {
                    int32 h0 = Server.hexVal(((int32) raw[i + 2]) & 255);
                    int32 h1 = Server.hexVal(((int32) raw[i + 3]) & 255);
                    int32 h2 = Server.hexVal(((int32) raw[i + 4]) & 255);
                    int32 h3 = Server.hexVal(((int32) raw[i + 5]) & 255);
                    if (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0) {
                        buf[o] = raw[i]; o = o + 1; i = i + 1;
                    } else {
                        int32 cp = (h0 * 4096) + (h1 * 256) + (h2 * 16) + h3;
                        if (cp < 128) {
                            buf[o] = (int8) cp; o = o + 1;
                        } else if (cp < 2048) {
                            buf[o] = (int8) (192 + (cp / 64)); o = o + 1;
                            buf[o] = (int8) (128 + (cp & 63)); o = o + 1;
                        } else {
                            buf[o] = (int8) (224 + (cp / 4096)); o = o + 1;
                            buf[o] = (int8) (128 + ((cp / 64) & 63)); o = o + 1;
                            buf[o] = (int8) (128 + (cp & 63)); o = o + 1;
                        }
                        i = i + 6;
                    }
                } else {
                    buf[o] = raw[i]; o = o + 1; i = i + 1;
                }
            } else {
                buf[o] = raw[i]; o = o + 1; i = i + 1;
            }
        }
        buf[o] = (int8) 0;
        return heap String(#buf, o);
    }

    /** Run argv[0..] (PATH-resolved) capturing stdout+stderr. */
    public static #ProcessResult runArgv(#String[] argv) {
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        cmd.captureStderr();
        return cmd.run();
    }

    /** `mktemp -d` -> the new dir path, or null on failure. */
    public static #String makeTempDir() {
        String[] argv = heap String[2];
        argv[0] = Server.dup("mktemp");
        argv[1] = Server.dup("-d");
        ProcessResult r = Server.runArgv(#argv);
        if (r.launched() == false || r.exitCode() != 0) {
            return null;
        }
        int8[] o = r.stdout();
        if (o == null) {
            return null;
        }
        int32 len = (int32) o.count();
        while (len > 0 && ((int32) o[len - 1]) == 10) {
            len = len - 1;
        }
        return Server.rangeToString(o, 0, len);
    }

    /** `mkdir -p <dir>` (best-effort). */
    public static void mkdirp(String dir) {
        String[] argv = heap String[3];
        argv[0] = Server.dup("mkdir");
        argv[1] = Server.dup("-p");
        argv[2] = Server.dup(dir);
        ProcessResult r = Server.runArgv(#argv);
    }

    /** `rm -rf <dir>` (best-effort cleanup). */
    public static void rmrf(String dir) {
        String[] argv = heap String[3];
        argv[0] = Server.dup("rm");
        argv[1] = Server.dup("-rf");
        argv[2] = Server.dup(dir);
        ProcessResult r = Server.runArgv(#argv);
    }

    /** Directory component of `path` (before the last '/'), or "." if none. */
    public static #String parentDir(String path) {
        int32 n = path.byteLength;
        int32 slash = -1;
        int32 i = 0;
        while (i < n) {
            if (((int32) path.bytes[i]) == 47) {
                slash = i;
            }
            i = i + 1;
        }
        if (slash < 0) {
            return Server.dup(".");
        }
        return Server.rangeToString(path.bytes, 0, slash);
    }

    /** `pkg.Class.method` -> `Class.cja` (artifact filename for --emit=cja). */
    public static #String artifactName(String entry) {
        int32 n = entry.byteLength;
        int32 d1 = -1;
        int32 d2 = -1;
        int32 i = 0;
        while (i < n) {
            if (((int32) entry.bytes[i]) == 46) {
                d2 = d1;
                d1 = i;
            }
            i = i + 1;
        }
        int32 begin = 0;
        int32 end = n;
        if (d1 >= 0 && d2 < 0) {
            end = d1;
        } else if (d1 >= 0) {
            begin = d2 + 1;
            end = d1;
        }
        String simple = entry.substring(begin, end);
        return Server.concat(simple, ".cja");
    }

    /** Write each non-empty line of `bytes` (split on '\n') as a JSON string. */
    public static void writeLines(JsonWriter w, int8[] bytes) {
        if (bytes == null) {
            return;
        }
        int32 n = (int32) bytes.count();
        int32 start = 0;
        int32 i = 0;
        while (i < n) {
            if (((int32) bytes[i]) == 10) {
                if (i > start) {
                    String line = Server.rangeToString(bytes, start, i);
                    w.writeString(line);
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (n > start) {
            String line = Server.rangeToString(bytes, start, n);
            w.writeString(line);
        }
    }

    /**
     * `mktemp -d`, create `<tmp>/src`, and materialize each `files` entry
     * (path->content) under it (decoding JSON-string escapes, creating package
     * subdirs). Returns the temp root (caller runs the compiler against
     * `<tmp>/src` and cleans up with `rmrf`), or null if the temp dir failed.
     */
    public static #String materializeToTemp(JsonObject files) {
        String tmpRoot = Server.makeTempDir();
        if (tmpRoot == null) {
            return null;
        }
        String srcRoot = Server.joinPath(tmpRoot, "src");
        Server.mkdirp(srcRoot);
        int32 fn = files.count();
        int32 fi = 0;
        while (fi < fn) {
            String rel = Server.decodeJsonString(files.keyAt(fi), files.keyLenAt(fi));
            String full = Server.joinPath(srcRoot, rel);
            String parent = Server.parentDir(full);
            Server.mkdirp(parent);
            JsonValue cv = files.valueAt(fi);
            int8[] raw = cv.asBytes();
            if (raw == null) {
                int8[] empty = heap int8[0];
                File.writeAllBytes(full, empty, 0);
            } else {
                String decoded = Server.decodeJsonString(raw, cv.asBytesLength());
                // File.writeAllBytes' intrinsic lowering only loads alloca
                // (local) args — a struct field passed directly (decoded.bytes
                // / decoded.byteLength) reaches the runtime as a raw pointer,
                // so copy both into locals first.
                int8[] dbytes = decoded.bytes;
                int32 dlen = decoded.byteLength;
                File.writeAllBytes(full, dbytes, dlen);
            }
            fi = fi + 1;
        }
        return tmpRoot;
    }

    /** Lowercase hex digit for `v` in 0..15. */
    public static int32 hexDigit(int32 v) {
        if (v < 10) {
            return 48 + v;
        }
        return 87 + v;
    }

    /**
     * Build a fully JSON-escaped string token (with surrounding quotes) for
     * `bytes[0..n)`. The stdlib `JsonWriter.writeString` only escapes `"` and
     * `\` — NOT control bytes — so captured program output (which contains
     * newlines) must be escaped here and emitted via `writeRaw`.
     */
    public static #String jsonEscape(int8[] bytes, int32 n) {
        int8[] buf = heap int8[n * 6 + 2];
        int32 o = 0;
        buf[o] = (int8) 34;
        o = o + 1;
        int32 i = 0;
        while (i < n) {
            int32 c = ((int32) bytes[i]) & 255;
            if (c == 34) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 34; o = o + 1;
            } else if (c == 92) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 92; o = o + 1;
            } else if (c == 10) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 110; o = o + 1;
            } else if (c == 13) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 114; o = o + 1;
            } else if (c == 9) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 116; o = o + 1;
            } else if (c == 8) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 98; o = o + 1;
            } else if (c == 12) {
                buf[o] = (int8) 92; o = o + 1; buf[o] = (int8) 102; o = o + 1;
            } else if (c < 32) {
                buf[o] = (int8) 92; o = o + 1;
                buf[o] = (int8) 117; o = o + 1;
                buf[o] = (int8) 48; o = o + 1;
                buf[o] = (int8) 48; o = o + 1;
                buf[o] = (int8) Server.hexDigit(c / 16); o = o + 1;
                buf[o] = (int8) Server.hexDigit(c % 16); o = o + 1;
            } else {
                buf[o] = (int8) c; o = o + 1;
            }
            i = i + 1;
        }
        buf[o] = (int8) 34;
        o = o + 1;
        return heap String(#buf, o);
    }

    /** Emit `"<key>": "<JSON-escaped bytes>"` (handles control chars + null). */
    public static void writeStringField(JsonWriter w, String key, int8[] bytes) {
        w.key(key);
        int32 n = 0;
        if (bytes != null) {
            n = (int32) bytes.count();
        }
        String tok = Server.jsonEscape(bytes, n);
        int8[] tb = tok.bytes;
        int32 tl = tok.byteLength;
        w.writeRaw(tb, tl);
    }

    /**
     * compile: materialize a `files` map (path->content) under a temp source
     * root, run `cajeta --emit=cja <entry> <srcRoot> <outDir>`, and return
     * `{exitStatus, diagnostics:[stderr lines], artifact?}` (base64 .cja).
     */
    public static void writeCompile(FileWriter out, JsonObject toolArgs, JsonValue id) {
        if (toolArgs == null) {
            Server.writeError(out, id, -32602, "compile requires 'files'");
            return;
        }
        JsonValue filesV = toolArgs.get("files");
        if (filesV == null || filesV.kind() != JsonValue.OBJECT) {
            Server.writeError(out, id, -32602, "compile requires a 'files' object");
            return;
        }
        JsonObject files = filesV.asObject();
        if (files.count() == 0) {
            Server.writeError(out, id, -32602, "compile 'files' must be non-empty");
            return;
        }
        JsonValue entryV = toolArgs.get("entry");
        if (entryV == null || entryV.kind() != JsonValue.STRING) {
            Server.writeError(out, id, -32602, "compile requires an 'entry' string");
            return;
        }
        String entry = entryV.asString();

        String key = Server.computeKey("compile", entry, files);
        if (Server.cacheEnabled) {
            int8[] cached = Server.cacheGet(key);
            if (cached != null) {
                Server.emitResultLine(out, id, cached, true);
                return;
            }
        }

        String tmpRoot = Server.materializeToTemp(files);
        if (tmpRoot == null) {
            Server.writeError(out, id, -32603, "failed to create temp dir");
            return;
        }
        String srcRoot = Server.joinPath(tmpRoot, "src");
        String outDir = Server.joinPath(tmpRoot, "out");
        Server.mkdirp(outDir);

        String[] cargs = heap String[4];
        cargs[0] = "--emit=cja";
        cargs[1] = entry;
        cargs[2] = srcRoot;
        cargs[3] = outDir;
        ProcessResult r = Server.runCajeta(cargs, 4);
        if (r.launched() == false) {
            Server.rmrf(tmpRoot);
            Server.writeError(out, id, -32603, "failed to launch cajeta");
            return;
        }
        int32 code = r.exitCode();

        // Build the result object WITHOUT cacheHit (emitResultLine splices it).
        JsonWriter bw = heap JsonWriter();
        bw.beginObject();
        bw.key("exitStatus");
        bw.writeNumber((int64) code);
        bw.key("diagnostics");
        bw.beginArray();
        Server.writeLines(bw, r.stderr());
        bw.endArray();
        if (code == 0) {
            String aname = Server.artifactName(entry);
            String apath = Server.joinPath(outDir, aname);
            int8[] cja = File.readAllBytes(apath);
            if (cja != null) {
                String b64 = Base64.encode(cja, cja.count());
                bw.key("artifact");
                bw.writeString(b64);
            }
        }
        bw.endObject();
        int8[] obj = bw.toBytes();

        Server.rmrf(tmpRoot);

        if (Server.cacheEnabled) {
            Server.cachePut(key, obj, (int32) obj.count());
        }
        Server.emitResultLine(out, id, obj, false);
    }

    /**
     * jit_execute: materialize a `files` map, run `cajeta jit-run <srcRoot>
     * <entry>` (a fresh process each call), and return `{returnValue,
     * exitStatus, stdout, stderr, cacheHit:false}`. The entry's int32 return
     * becomes the process exit code; the program's stdout is clean (jit-run
     * chatter is on stderr).
     */
    public static void writeJitExecute(FileWriter out, JsonObject toolArgs, JsonValue id) {
        if (toolArgs == null) {
            Server.writeError(out, id, -32602, "jit_execute requires 'files'");
            return;
        }
        JsonValue filesV = toolArgs.get("files");
        if (filesV == null || filesV.kind() != JsonValue.OBJECT) {
            Server.writeError(out, id, -32602, "jit_execute requires a 'files' object");
            return;
        }
        JsonObject files = filesV.asObject();
        if (files.count() == 0) {
            Server.writeError(out, id, -32602, "jit_execute 'files' must be non-empty");
            return;
        }
        JsonValue entryV = toolArgs.get("entry");
        if (entryV == null || entryV.kind() != JsonValue.STRING) {
            Server.writeError(out, id, -32602, "jit_execute requires an 'entry' string");
            return;
        }
        String entry = entryV.asString();

        String key = Server.computeKey("jit_execute", entry, files);
        if (Server.cacheEnabled) {
            int8[] cached = Server.cacheGet(key);
            if (cached != null) {
                Server.emitResultLine(out, id, cached, true);
                return;
            }
        }

        String tmpRoot = Server.materializeToTemp(files);
        if (tmpRoot == null) {
            Server.writeError(out, id, -32603, "failed to create temp dir");
            return;
        }
        String srcRoot = Server.joinPath(tmpRoot, "src");

        String[] jargs = heap String[3];
        jargs[0] = "jit-run";
        jargs[1] = srcRoot;
        jargs[2] = entry;
        ProcessResult r = Server.runCajeta(jargs, 3);
        if (r.launched() == false) {
            Server.rmrf(tmpRoot);
            Server.writeError(out, id, -32603, "failed to launch cajeta");
            return;
        }
        int32 code = r.exitCode();

        // Build the result object WITHOUT cacheHit (emitResultLine splices it).
        JsonWriter bw = heap JsonWriter();
        bw.beginObject();
        bw.key("returnValue");
        bw.writeNumber((int64) code);
        bw.key("exitStatus");
        bw.writeNumber((int64) code);
        Server.writeStringField(bw, "stdout", r.stdout());
        Server.writeStringField(bw, "stderr", r.stderr());
        bw.endObject();
        int8[] obj = bw.toBytes();

        Server.rmrf(tmpRoot);

        if (Server.cacheEnabled) {
            Server.cachePut(key, obj, (int32) obj.count());
        }
        Server.emitResultLine(out, id, obj, false);
    }

    public static void writeStub(FileWriter out, JsonValue id) {
        JsonWriter w = heap JsonWriter();
        Server.writeHead(w, id);
        w.key("result");
        w.beginObject();
        w.key("content");
        w.beginArray();
        w.beginObject();
        w.key("type");
        w.writeString("text");
        w.key("text");
        w.writeString("not implemented");
        w.endObject();
        w.endArray();
        w.key("isError");
        w.writeBoolean(true);
        w.endObject();
        w.endObject();
        w.writeLineTo(out);
    }
}
