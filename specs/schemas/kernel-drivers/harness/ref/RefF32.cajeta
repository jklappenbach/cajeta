package ref;

import cajeta.lang.Math;
import cajeta.xpu.Group;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;
import cajeta.xpu.Wave;

/** cajeta-llm's float-activation wave decodes of Q8_0, Q4_0, Q5_0 and Q6_K and their store, lifted unchanged (llm 0730a8b); the f16 scale read is {@link RefCols}'s. */
public final class RefF32 {
    public RefF32() { return; }

    /**
     * Q8_0 x F32 activations, WAVE decomposition — the kernel the 72B's
     * ffn_down actually needed. The wave INTEGER route reads q8_K-packed
     * activations whose superblock is 256 elements, so it cannot serve
     * inDim % 256 != 0 (Qwen-72B's ffn_down is 29568, residue 128); the
     * one-item-per-row f32 kernels can, but measured in the ~100-140
     * GiB/s class where the wave kernels measure 130-190 — and ffn_down
     * is ~16 GiB of the 72B's ~45 GiB per decoded token. llama.cpp has
     * no such cliff anywhere: their mat-vec reads float activations, so
     * one design serves every width — measured 204.8 GiB/s on the 72B
     * and ~208 on the 8B, the SAME rate, which is what told us the gap
     * was our router and not a big-model technique of theirs.
     *
     * Geometry is the integer twin's: one wave per output row, one LANE
     * per 32-element block, 32 blocks in flight, subgroup reduce. Only
     * the activation side differs — f32 loads and fma, no quantization,
     * so no width constraint beyond cols % 32 == 0 and no q8_K
     * approximation either.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void q80F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff, uint32 accum) {
        // Wave-relative (xpu-kernel-adaptor Unit 9): the workgroup may carry
        // several rows, one per wave, and the kernel is correct at any wave
        // width; the literal 32 this assumed was one workgroup per row.
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 row = KernelThread.globalIdX() / wv;
        int64 prefix = ((blocksPerRow * 2L + 3L) / 4L) * 4L;
        int64 rowBytes = prefix + blocksPerRow * 32L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + prefix + wb * 32L;
                float32 d = RefCols.scaleAtDev(packed,
                    i * rowBytes / 2L + wb);
                int64 xo = xOff + wb * 32L;
                Vector<int8,16> q0 = packed.vload<16>(ro);
                Vector<int8,16> q1 = packed.vload<16>(ro + 16L);
                Vector<int16,8> W0 = q0.widenLo();
                Vector<int16,8> W1 = q0.widenHi();
                Vector<int16,8> W2 = q1.widenLo();
                Vector<int16,8> W3 = q1.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + d * (p[0] + p[1] + p[2] + p[3]);
                wb = wb + (int64) wv;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            RefF32.rowsStore(y, yOff + (int64) row, tot, accum);
        }
    }

    /** The Q4_0 member of the f32-wave family — see the Q8_0 twin. */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void q40F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        // Wave-relative (xpu-kernel-adaptor Unit 9): the workgroup may carry
        // several rows, one per wave, and the kernel is correct at any wave
        // width; the literal 32 this assumed was one workgroup per row.
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 row = KernelThread.globalIdX() / wv;
        int64 prefix = ((blocksPerRow * 2L + 3L) / 4L) * 4L;
        int64 rowBytes = prefix + blocksPerRow * 16L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + prefix + wb * 16L;
                float32 d = RefCols.scaleAtDev(packed, i * rowBytes / 2L + wb);
                int64 xo = xOff + wb * 32L;
                Vector<int8,16> q = packed.vload<16>(ro);
                Vector<int8,16> lo = (q & 15) - 8;
                Vector<int8,16> hi = ((q >> 4) & 15) - 8;
                Vector<int16,8> W0 = lo.widenLo();
                Vector<int16,8> W1 = lo.widenHi();
                Vector<int16,8> W2 = hi.widenLo();
                Vector<int16,8> W3 = hi.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                acc = acc + d * (p[0] + p[1] + p[2] + p[3]);
                wb = wb + (int64) wv;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    /** The Q5_0 member of the f32-wave family — see the Q8_0 twin for
     *  the geometry and the Q5_0 f32 one-item kernel for why the 5th
     *  bit rides a scalar fold over the activations. */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void q50F32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff) {
        // Wave-relative (xpu-kernel-adaptor Unit 9): the workgroup may carry
        // several rows, one per wave, and the kernel is correct at any wave
        // width; the literal 32 this assumed was one workgroup per row.
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 row = KernelThread.globalIdX() / wv;
        int64 prefix = ((blocksPerRow * 2L + 3L) / 4L) * 4L;
        int64 rowBytes = prefix + blocksPerRow * 20L;
        float32 acc = 0.0f;
        if (row < rows) {
            int64 i = (int64) row;
            int64 wb = (int64) lane;
            while (wb < blocksPerRow) {
                int64 ro = i * rowBytes + prefix + wb * 20L;
                float32 d = RefCols.scaleAtDev(packed, i * rowBytes / 2L + wb);
                int64 xo = xOff + wb * 32L;
                Vector<int8,4> qhb = packed.vload<4>(ro);
                int32 qh = ((int32) qhb[0] & 255)
                    | (((int32) qhb[1] & 255) << 8)
                    | (((int32) qhb[2] & 255) << 16)
                    | (((int32) qhb[3] & 255) << 24);
                Vector<int8,16> q = packed.vload<16>(ro + 4L);
                Vector<int8,16> lo = (q & 15) - 16;
                Vector<int8,16> hi = ((q >> 4) & 15) - 16;
                Vector<int16,8> W0 = lo.widenLo();
                Vector<int16,8> W1 = lo.widenHi();
                Vector<int16,8> W2 = hi.widenLo();
                Vector<int16,8> W3 = hi.widenHi();
                Vector<float32,4> p = W0.widenLo().toF32() * x.vload<4>(xo);
                p = p + W0.widenHi().toF32() * x.vload<4>(xo + 4L);
                p = p + W1.widenLo().toF32() * x.vload<4>(xo + 8L);
                p = p + W1.widenHi().toF32() * x.vload<4>(xo + 12L);
                p = p + W2.widenLo().toF32() * x.vload<4>(xo + 16L);
                p = p + W2.widenHi().toF32() * x.vload<4>(xo + 20L);
                p = p + W3.widenLo().toF32() * x.vload<4>(xo + 24L);
                p = p + W3.widenHi().toF32() * x.vload<4>(xo + 28L);
                float32 dot = p[0] + p[1] + p[2] + p[3];
                float32 hs = 0.0f;
                int32 j = 0;
                while (j < 16) {
                    hs = hs + (float32) ((qh >> j) & 1)
                        * x[xo + (int64) j];
                    hs = hs + (float32) ((qh >> (j + 16)) & 1)
                        * x[xo + (int64) (j + 16)];
                    j = j + 1;
                }
                acc = acc + d * (dot + 16.0f * hs);
                wb = wb + (int64) wv;
            }
        }
        float32 tot = Wave.reduceSumF32(acc);
        if (lane == 0 && row < rows) {
            y[yOff + (int64) row] = tot;
        }
    }

    /** `y[yi] = v`, or `y[yi] += v` when `accum` is set. */
    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    /**
     * `y[yOff + row] = W[row] . x` for Q6_K with f32 activations, on {@link #q6kQ8WaveMatVecKernel}'s
     * lane and slot geometry. `cols` is a multiple of 256, and `accum` adds into `y`.
     */
    @Kernel
    @Occupancy(maxThreads = 256)
    public static void q6kF32WaveMatVecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> packed, KernelBuffer<float32> x,
            uint32 rows, int64 blocksPerRow, int64 xOff, int64 yOff, uint32 accum) {
        uint32 wv = (uint32) Group.width();
        uint32 lane = KernelThread.x() % wv;
        uint32 wave = KernelThread.globalIdX() / wv;
        uint32 lpr = 4 * (uint32) blocksPerRow;
        uint32 rpw = 1;
        uint32 rl = lane;
        uint32 sub = 0;
        uint32 R = 4;
        if (lpr < wv) { rpw = wv / lpr; sub = lane / lpr; rl = lane - sub * lpr; R = 1; }
        uint32 row0 = wave * R * rpw + sub;
        uint32 prefix = (uint32) (((blocksPerRow * 2L + 3L) / 4L) * 4L);
        uint32 rowBytes = prefix + (uint32) blocksPerRow * 208;
        uint32 bpr = (uint32) blocksPerRow;
        float32 acc0 = 0.0f;
        float32 acc1 = 0.0f;
        float32 acc2 = 0.0f;
        float32 acc3 = 0.0f;
        if (sub < rpw && row0 < rows) {
            uint32 last = rows - 1;
            uint32 r1 = row0 + 1; if (r1 > last) { r1 = last; }
            uint32 r2 = row0 + 2; if (r2 > last) { r2 = last; }
            uint32 r3 = row0 + 3; if (r3 > last) { r3 = last; }
            float32 w1 = 0.0f; if (R > 1 && row0 + 1 < rows) { w1 = 1.0f; }
            float32 w2 = 0.0f; if (R > 1 && row0 + 2 < rows) { w2 = 1.0f; }
            float32 w3 = 0.0f; if (R > 1 && row0 + 3 < rows) { w3 = 1.0f; }
            uint32 rb0 = row0 * rowBytes;
            uint32 rb1 = r1 * rowBytes;
            uint32 rb2 = r2 * rowBytes;
            uint32 rb3 = r3 * rowBytes;
            int32 m = (int32) (rl % 4);
            int32 g = m / 2;
            int32 a = m - g * 2;
            uint32 b = rl / 4;
            while (b < bpr) {
                int64 xa = xOff + (int64) (b * 256) + (int64) (16 * (8 * g + a));
                Vector<float32,4> x0_0 = x.vload<4>(xa + 0L);
                Vector<float32,4> x0_1 = x.vload<4>(xa + 4L);
                Vector<float32,4> x0_2 = x.vload<4>(xa + 8L);
                Vector<float32,4> x0_3 = x.vload<4>(xa + 12L);
                Vector<float32,4> x1_0 = x.vload<4>(xa + 32L);
                Vector<float32,4> x1_1 = x.vload<4>(xa + 36L);
                Vector<float32,4> x1_2 = x.vload<4>(xa + 40L);
                Vector<float32,4> x1_3 = x.vload<4>(xa + 44L);
                Vector<float32,4> x2_0 = x.vload<4>(xa + 64L);
                Vector<float32,4> x2_1 = x.vload<4>(xa + 68L);
                Vector<float32,4> x2_2 = x.vload<4>(xa + 72L);
                Vector<float32,4> x2_3 = x.vload<4>(xa + 76L);
                Vector<float32,4> x3_0 = x.vload<4>(xa + 96L);
                Vector<float32,4> x3_1 = x.vload<4>(xa + 100L);
                Vector<float32,4> x3_2 = x.vload<4>(xa + 104L);
                Vector<float32,4> x3_3 = x.vload<4>(xa + 108L);
                uint32 ro0 = rb0 + prefix + b * 208;
                uint32 rqa0 = ro0 + (uint32) (64 * g + 16 * a);
                uint32 rqh0 = ro0 + (uint32) (32 * g + 16 * a);
                uint32 rsc0 = ro0 + (uint32) (8 * g);
                Vector<int8,16> qlA0 = packed.vload<16>((int64) rqa0);
                Vector<int8,16> qlB0 = packed.vload<16>((int64) rqa0 + 32L);
                Vector<int8,16> qh0 = packed.vload<16>((int64) rqh0 + 128L);
                Vector<int8,8> scv0 = packed.vload<8>((int64) rsc0 + 192L);
                float32 dsc0 = RefCols.scaleAtDev(packed,
                    (int64) rb0 / 2L + (int64) b);
                uint32 ro1 = rb1 + prefix + b * 208;
                uint32 rqa1 = ro1 + (uint32) (64 * g + 16 * a);
                uint32 rqh1 = ro1 + (uint32) (32 * g + 16 * a);
                uint32 rsc1 = ro1 + (uint32) (8 * g);
                Vector<int8,16> qlA1 = packed.vload<16>((int64) rqa1);
                Vector<int8,16> qlB1 = packed.vload<16>((int64) rqa1 + 32L);
                Vector<int8,16> qh1 = packed.vload<16>((int64) rqh1 + 128L);
                Vector<int8,8> scv1 = packed.vload<8>((int64) rsc1 + 192L);
                float32 dsc1 = RefCols.scaleAtDev(packed,
                    (int64) rb1 / 2L + (int64) b);
                uint32 ro2 = rb2 + prefix + b * 208;
                uint32 rqa2 = ro2 + (uint32) (64 * g + 16 * a);
                uint32 rqh2 = ro2 + (uint32) (32 * g + 16 * a);
                uint32 rsc2 = ro2 + (uint32) (8 * g);
                Vector<int8,16> qlA2 = packed.vload<16>((int64) rqa2);
                Vector<int8,16> qlB2 = packed.vload<16>((int64) rqa2 + 32L);
                Vector<int8,16> qh2 = packed.vload<16>((int64) rqh2 + 128L);
                Vector<int8,8> scv2 = packed.vload<8>((int64) rsc2 + 192L);
                float32 dsc2 = RefCols.scaleAtDev(packed,
                    (int64) rb2 / 2L + (int64) b);
                uint32 ro3 = rb3 + prefix + b * 208;
                uint32 rqa3 = ro3 + (uint32) (64 * g + 16 * a);
                uint32 rqh3 = ro3 + (uint32) (32 * g + 16 * a);
                uint32 rsc3 = ro3 + (uint32) (8 * g);
                Vector<int8,16> qlA3 = packed.vload<16>((int64) rqa3);
                Vector<int8,16> qlB3 = packed.vload<16>((int64) rqa3 + 32L);
                Vector<int8,16> qh3 = packed.vload<16>((int64) rqh3 + 128L);
                Vector<int8,8> scv3 = packed.vload<8>((int64) rsc3 + 192L);
                float32 dsc3 = RefCols.scaleAtDev(packed,
                    (int64) rb3 / 2L + (int64) b);
                Vector<float32,4> sv_0 = x0_0 + x0_1 + x0_2 + x0_3;
                float32 xs_0 = 32.0f * (sv_0[0] + sv_0[1] + sv_0[2] + sv_0[3]);
                Vector<float32,4> sv_1 = x1_0 + x1_1 + x1_2 + x1_3;
                float32 xs_1 = 32.0f * (sv_1[0] + sv_1[1] + sv_1[2] + sv_1[3]);
                Vector<float32,4> sv_2 = x2_0 + x2_1 + x2_2 + x2_3;
                float32 xs_2 = 32.0f * (sv_2[0] + sv_2[1] + sv_2[2] + sv_2[3]);
                Vector<float32,4> sv_3 = x3_0 + x3_1 + x3_2 + x3_3;
                float32 xs_3 = 32.0f * (sv_3[0] + sv_3[1] + sv_3[2] + sv_3[3]);
                int32 s0_0 = (int32) scv0[0];
                int32 s1_0 = (int32) scv0[2];
                int32 s2_0 = (int32) scv0[4];
                int32 s3_0 = (int32) scv0[6];
                if (a != 0) {
                    s0_0 = (int32) scv0[1];
                    s1_0 = (int32) scv0[3];
                    s2_0 = (int32) scv0[5];
                    s3_0 = (int32) scv0[7];
                }
                Vector<int32,4> wA0 = qlA0.asWords();
                Vector<int32,4> wB0 = qlB0.asWords();
                Vector<int32,4> wH0 = qh0.asWords();
                Vector<int32,4> q0_0 = (wA0 & 252645135) | ((wH0 << 4) & 808464432);
                Vector<int32,4> q1_0 = (wB0 & 252645135) | ((wH0 << 2) & 808464432);
                Vector<int32,4> q2_0 = ((wA0 >> 4) & 252645135) | (wH0 & 808464432);
                Vector<int32,4> q3_0 = ((wB0 >> 4) & 252645135) | ((wH0 >> 2) & 808464432);
                float32 p0_0_0 = Math.fma((float32) (q0_0[3] & 255), x0_3[0], Math.fma((float32) (q0_0[2] & 255), x0_2[0],
                    Math.fma((float32) (q0_0[1] & 255), x0_1[0], (float32) (q0_0[0] & 255) * x0_0[0])));
                float32 p0_0_1 = Math.fma((float32) ((q0_0[3] >> 8) & 255), x0_3[1], Math.fma((float32) ((q0_0[2] >> 8) & 255), x0_2[1],
                    Math.fma((float32) ((q0_0[1] >> 8) & 255), x0_1[1], (float32) ((q0_0[0] >> 8) & 255) * x0_0[1])));
                float32 p0_0_2 = Math.fma((float32) ((q0_0[3] >> 16) & 255), x0_3[2], Math.fma((float32) ((q0_0[2] >> 16) & 255), x0_2[2],
                    Math.fma((float32) ((q0_0[1] >> 16) & 255), x0_1[2], (float32) ((q0_0[0] >> 16) & 255) * x0_0[2])));
                float32 p0_0_3 = Math.fma((float32) ((q0_0[3] >> 24) & 255), x0_3[3], Math.fma((float32) ((q0_0[2] >> 24) & 255), x0_2[3],
                    Math.fma((float32) ((q0_0[1] >> 24) & 255), x0_1[3], (float32) ((q0_0[0] >> 24) & 255) * x0_0[3])));
                float32 t0_0 = (p0_0_0 + p0_0_1) + (p0_0_2 + p0_0_3) - xs_0;
                float32 p1_0_0 = Math.fma((float32) (q1_0[3] & 255), x1_3[0], Math.fma((float32) (q1_0[2] & 255), x1_2[0],
                    Math.fma((float32) (q1_0[1] & 255), x1_1[0], (float32) (q1_0[0] & 255) * x1_0[0])));
                float32 p1_0_1 = Math.fma((float32) ((q1_0[3] >> 8) & 255), x1_3[1], Math.fma((float32) ((q1_0[2] >> 8) & 255), x1_2[1],
                    Math.fma((float32) ((q1_0[1] >> 8) & 255), x1_1[1], (float32) ((q1_0[0] >> 8) & 255) * x1_0[1])));
                float32 p1_0_2 = Math.fma((float32) ((q1_0[3] >> 16) & 255), x1_3[2], Math.fma((float32) ((q1_0[2] >> 16) & 255), x1_2[2],
                    Math.fma((float32) ((q1_0[1] >> 16) & 255), x1_1[2], (float32) ((q1_0[0] >> 16) & 255) * x1_0[2])));
                float32 p1_0_3 = Math.fma((float32) ((q1_0[3] >> 24) & 255), x1_3[3], Math.fma((float32) ((q1_0[2] >> 24) & 255), x1_2[3],
                    Math.fma((float32) ((q1_0[1] >> 24) & 255), x1_1[3], (float32) ((q1_0[0] >> 24) & 255) * x1_0[3])));
                float32 t1_0 = (p1_0_0 + p1_0_1) + (p1_0_2 + p1_0_3) - xs_1;
                float32 p2_0_0 = Math.fma((float32) (q2_0[3] & 255), x2_3[0], Math.fma((float32) (q2_0[2] & 255), x2_2[0],
                    Math.fma((float32) (q2_0[1] & 255), x2_1[0], (float32) (q2_0[0] & 255) * x2_0[0])));
                float32 p2_0_1 = Math.fma((float32) ((q2_0[3] >> 8) & 255), x2_3[1], Math.fma((float32) ((q2_0[2] >> 8) & 255), x2_2[1],
                    Math.fma((float32) ((q2_0[1] >> 8) & 255), x2_1[1], (float32) ((q2_0[0] >> 8) & 255) * x2_0[1])));
                float32 p2_0_2 = Math.fma((float32) ((q2_0[3] >> 16) & 255), x2_3[2], Math.fma((float32) ((q2_0[2] >> 16) & 255), x2_2[2],
                    Math.fma((float32) ((q2_0[1] >> 16) & 255), x2_1[2], (float32) ((q2_0[0] >> 16) & 255) * x2_0[2])));
