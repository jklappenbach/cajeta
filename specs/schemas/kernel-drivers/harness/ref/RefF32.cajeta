                    Math.fma((float32) ((q2_3[1] >> 24) & 255), x2_1[3], (float32) ((q2_3[0] >> 24) & 255) * x2_0[3])));
                float32 t2_3 = (p2_3_0 + p2_3_1) + (p2_3_2 + p2_3_3) - xs_2;
                float32 p3_3_0 = Math.fma((float32) (q3_3[3] & 255), x3_3[0], Math.fma((float32) (q3_3[2] & 255), x3_2[0],
                    Math.fma((float32) (q3_3[1] & 255), x3_1[0], (float32) (q3_3[0] & 255) * x3_0[0])));
                float32 p3_3_1 = Math.fma((float32) ((q3_3[3] >> 8) & 255), x3_3[1], Math.fma((float32) ((q3_3[2] >> 8) & 255), x3_2[1],
                    Math.fma((float32) ((q3_3[1] >> 8) & 255), x3_1[1], (float32) ((q3_3[0] >> 8) & 255) * x3_0[1])));
                float32 p3_3_2 = Math.fma((float32) ((q3_3[3] >> 16) & 255), x3_3[2], Math.fma((float32) ((q3_3[2] >> 16) & 255), x3_2[2],
                    Math.fma((float32) ((q3_3[1] >> 16) & 255), x3_1[2], (float32) ((q3_3[0] >> 16) & 255) * x3_0[2])));
                float32 p3_3_3 = Math.fma((float32) ((q3_3[3] >> 24) & 255), x3_3[3], Math.fma((float32) ((q3_3[2] >> 24) & 255), x3_2[3],
                    Math.fma((float32) ((q3_3[1] >> 24) & 255), x3_1[3], (float32) ((q3_3[0] >> 24) & 255) * x3_0[3])));
                float32 t3_3 = (p3_3_0 + p3_3_1) + (p3_3_2 + p3_3_3) - xs_3;
                acc3 = acc3 + dsc3 * (float32) s0_3 * t0_3;
                acc3 = acc3 + dsc3 * (float32) s1_3 * t1_3;
                acc3 = acc3 + dsc3 * (float32) s2_3 * t2_3;
                acc3 = acc3 + dsc3 * (float32) s3_3 * t3_3;
                b = b + wv / 4;
            }
            acc1 = acc1 * w1;
            acc2 = acc2 * w2;
            acc3 = acc3 * w3;
        }
        if (R > 1) {
            float32 t0 = Wave.reduceSumF32(acc0);
            float32 t1 = Wave.reduceSumF32(acc1);
            float32 t2 = Wave.reduceSumF32(acc2);
            float32 t3 = Wave.reduceSumF32(acc3);
            if (lane == 0) {
                int64 o = yOff + (int64) row0;
                if (accum != 0) {
                    if (row0 < rows) { y[o] = y[o] + t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = y[o + 1L] + t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = y[o + 2L] + t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = y[o + 3L] + t3; }
                } else {
                    if (row0 < rows) { y[o] = t0; }
                    if (row0 + 1 < rows) { y[o + 1L] = t1; }
                    if (row0 + 2 < rows) { y[o + 2L] = t2; }
                    if (row0 + 3 < rows) { y[o + 3L] = t3; }
                }
            }
        } else {
            uint32 r = 0;
            while (r < rpw) {
                float32 part = 0.0f;
                if (sub == r) { part = acc0; }
                float32 tot = Wave.reduceSumF32(part);
                if (lane == 0 && wave * rpw + r < rows) {
                    int64 o1 = yOff + (int64) (wave * rpw + r);
                    if (accum != 0) {
                        y[o1] = y[o1] + tot;
                    } else {
                        y[o1] = tot;
                    }
                }
                r = r + 1;
            }
        }
    }

    /** llm's float decode of format `f` (0 Q8_0, 1 Q4_0, 2 Q5_0, 3 Q6_K with `nb` its 256-value blocks) on its resident layout, `wpb` waves a workgroup. */
    public static void run(int32 f, KernelBuffer<float32> y, KernelBuffer<int8> p, KernelBuffer<float32> x, int64 rows, int64 nb,
            int64 wpb, int64 wv) {
        KernelStream s #= KernelStream.current();
        uint32 g = (uint32) ((rows + wpb - 1L) / wpb);
        if (f == 0) {
            q80F32WaveMatVecKernel.launch(s, grid: [g], block: [(uint32) (wpb * wv)]) (y, p, x, (uint32) rows, nb, 0L, 0L, 0);
        } else if (f == 1) {
            q40F32WaveMatVecKernel.launch(s, grid: [g], block: [(uint32) (wpb * wv)]) (y, p, x, (uint32) rows, nb, 0L, 0L);
        } else if (f == 2) {
            q50F32WaveMatVecKernel.launch(s, grid: [g], block: [(uint32) (wpb * wv)]) (y, p, x, (uint32) rows, nb, 0L, 0L);
        } else {
            int64 rpw = 4L;
            if (4L * nb < wv) { rpw = wv / (4L * nb); }
            uint32 g6 = (uint32) (((rows + rpw - 1L) / rpw + wpb - 1L) / wpb);
            q6kF32WaveMatVecKernel.launch(s, grid: [g6], block: [(uint32) (wpb * wv)]) (y, p, x, (uint32) rows, nb, 0L, 0L, 0);
        }
    }
}
