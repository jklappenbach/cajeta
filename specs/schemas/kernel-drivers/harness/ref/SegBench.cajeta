package ref;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.kernels.gemm.BlockGemvWave;
import dev.cajeta.ml.kernels.quant.Q4kBlock;

/** kernel-drivers 9.1.8.4: the driver's three-weight column launch (`runCols3On`) against cajeta-llm's Seg Plain and Seg Pf kernels (`ref/RefSeg`), Q4_K, best launch against best, bitwise; `sep_ns` is the driver's three separate column launches. */
public class SegBench {
    static void drv(KernelStream s, KernelBuffer<float32> y0, KernelBuffer<float32> y1, KernelBuffer<float32> y2,
            KernelBuffer<int8> w0, KernelBuffer<int8> w1, KernelBuffer<int8> w2, KernelBuffer<int8> xp,
            int64 r0, int64 r1, int64 r2, int64 cols, int64 ncols, int64 xps, int64 wpb, int64 wv) {
        heap BlockGemvWave<Q4kBlock, 1, 0>().runCols3On(s, y0, y1, y2, w0, w1, w2, xp, r0, r1, r2, cols, ncols, r0, r1, r2, xps,
            false, wpb, wv);
    }

    static void sep(KernelStream s, KernelBuffer<float32> y0, KernelBuffer<float32> y1, KernelBuffer<float32> y2,
            KernelBuffer<int8> w0, KernelBuffer<int8> w1, KernelBuffer<int8> w2, KernelBuffer<int8> xp,
            int64 r0, int64 r1, int64 r2, int64 cols, int64 ncols, int64 xps, int64 wpb, int64 wv) {
        BlockGemvWave<Q4kBlock, 1, 0> m = heap BlockGemvWave<Q4kBlock, 1, 0>();
        m.runColsOn(s, y0, w0, xp, r0, cols, 0L, ncols, r0, xps, false, wpb, wv);
        m.runColsOn(s, y1, w1, xp, r1, cols, 0L, ncols, r1, xps, false, wpb, wv);
        if (r2 > 0L) { m.runColsOn(s, y2, w2, xp, r2, cols, 0L, ncols, r2, xps, false, wpb, wv); }
    }

    static #KernelBuffer<int8> up(int64 rows, int64 bpr) {
        int8[] f #= Bench.weight(rows * bpr);
        KernelBuffer<int8> w = heap KernelBuffer<int8>((uint64) f.count());
        w.upload(f);
        return #w;
    }

    static int64 diff(KernelBuffer<float32> a, KernelBuffer<float32> b, int64 n) {
        float32[] ga #= heap float32[n];
        float32[] gb #= heap float32[n];
        a.download(ga);
        b.download(gb);
        return WaveBench.bitDiff(ga, gb, n);
    }

    static int64 shape(String nm, int64 r0, int64 r1, int64 r2, int64 cols, int64 ncols, int64 reps) {
        int64 bpr = cols / 256L;
        int64 rc = r2 > 0L ? r2 : 1L;
        KernelBuffer<int8> w0 #= SegBench.up(r0, bpr);
        KernelBuffer<int8> w1 #= SegBench.up(r1, bpr);
        KernelBuffer<int8> w2 #= SegBench.up(rc, bpr);
        int8[] hx #= Bench6.acts(ncols * bpr);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (ncols * bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> a0 = heap KernelBuffer<float32>((uint64) (ncols * r0));
        KernelBuffer<float32> a1 = heap KernelBuffer<float32>((uint64) (ncols * r1));
        KernelBuffer<float32> a2 = heap KernelBuffer<float32>((uint64) (ncols * rc));
        KernelBuffer<float32> b0 = heap KernelBuffer<float32>((uint64) (ncols * r0));
        KernelBuffer<float32> b1 = heap KernelBuffer<float32>((uint64) (ncols * r1));
        KernelBuffer<float32> b2 = heap KernelBuffer<float32>((uint64) (ncols * rc));
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        int64 xps = bpr * 320L;
        KernelStream s #= KernelStream.current();
        RefSeg.run(0, a0, a1, a2, w0, w1, w2, xp, r0, r1, r2, bpr, ncols, xps, 1L, wv);
        SegBench.drv(s, b0, b1, b2, w0, w1, w2, xp, r0, r1, r2, cols, ncols, xps, 1L, wv);
        s.sync();
        int64 bits = SegBench.diff(a0, b0, ncols * r0) + SegBench.diff(a1, b1, ncols * r1);
        if (r2 > 0L) { bits = bits + SegBench.diff(a2, b2, ncols * r2); }
        int64 bestR = 9000000000000L;
        int64 bestN = 9000000000000L;
        int64 bestS = 9000000000000L;
        int64 round = 0L;
        while (round < 15L) {
            int64 wi = 0L;
            while (wi < 3L) {
                int64 wpb = wi == 0L ? 1L : (wi == 1L ? 2L : 4L);
                int32 v = 0;
                while (v < 2) {
                    int64 t0 = Clock.nanoTime();
                    int64 k = 0L;
                    while (k < reps) { RefSeg.run(v, a0, a1, a2, w0, w1, w2, xp, r0, r1, r2, bpr, ncols, xps, wpb, wv); k = k + 1L; }
                    s.sync();
                    int64 t1 = Clock.nanoTime();
                    if ((t1 - t0) / reps < bestR) { bestR = (t1 - t0) / reps; }
                    v = v + 1;
                }
                int64 t2 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { SegBench.drv(s, b0, b1, b2, w0, w1, w2, xp, r0, r1, r2, cols, ncols, xps, wpb, wv); k = k + 1L; }
                s.sync();
                int64 t3 = Clock.nanoTime();
                if ((t3 - t2) / reps < bestN) { bestN = (t3 - t2) / reps; }
                k = 0L;
                while (k < reps) { SegBench.sep(s, b0, b1, b2, w0, w1, w2, xp, r0, r1, r2, cols, ncols, xps, wpb, wv); k = k + 1L; }
                s.sync();
                int64 t4 = Clock.nanoTime();
                if ((t4 - t3) / reps < bestS) { bestS = (t4 - t3) / reps; }
                wi = wi + 1L;
            }
            round = round + 1L;
        }
        System.stdout.println(nm + " " + r0 + "+" + r1 + "+" + r2 + "x" + cols + " ncols " + ncols + " bitDiff " + bits + " ref_ns " + bestR
            + " drv_ns " + bestN + " sep_ns " + bestS + " ratio_pct " + (bestN * 100L / bestR));
        return bits == 0L ? 0L : 1L;
    }

    public static int32 main() {
        int64 bad = SegBench.shape("tiny", 37L, 20L, 11L, 2304L, 3L, 2L);
        int64 n = 2L;
        while (n <= 8L) {
            bad = bad + SegBench.shape("qkv", 4096L, 1024L, 1024L, 4096L, n, 20L);
            bad = bad + SegBench.shape("gateup", 14336L, 14336L, 0L, 4096L, n, 6L);
            bad = bad + SegBench.shape("qkv", 4096L, 1024L, 1024L, 2560L, n, 30L);
            bad = bad + SegBench.shape("gateup", 9728L, 9728L, 0L, 2560L, n, 10L);
            n = n * 2L;
        }
        System.stdout.println(bad == 0L ? "ALL EQUAL" : "DIFFERENT");
        return bad == 0L ? 0 : 1;
    }
}
