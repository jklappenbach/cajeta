                    Vector<int8,32> a1j0q1 = heap Vector<int32,8>(sa1j0q1, sa1j0q1, sa1j0q1, sa1j0q1, sa1j0q1, sa1j0q1, sa1j0q1, sa1j0q1).asBytes();
                    t1j0a = u0q1.dotAccum(a1j0q1, t1j0a);
                    Vector<uint8,32> u0q2 = ((rq02 >> 0) & 3) | (((hm2 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q2 = xp.vload<4>(x0 + xo + 8L).asWords();
                    int32 sa0j0q2 = wa0j0q2[0];
                    Vector<int8,32> a0j0q2 = heap Vector<int32,8>(sa0j0q2, sa0j0q2, sa0j0q2, sa0j0q2, sa0j0q2, sa0j0q2, sa0j0q2, sa0j0q2).asBytes();
                    t0j0a = u0q2.dotAccum(a0j0q2, t0j0a);
                    Vector<int32,1> wa1j0q2 = xp.vload<4>(x1 + xo + 8L).asWords();
                    int32 sa1j0q2 = wa1j0q2[0];
                    Vector<int8,32> a1j0q2 = heap Vector<int32,8>(sa1j0q2, sa1j0q2, sa1j0q2, sa1j0q2, sa1j0q2, sa1j0q2, sa1j0q2, sa1j0q2).asBytes();
                    t1j0a = u0q2.dotAccum(a1j0q2, t1j0a);
                    Vector<uint8,32> u0q3 = ((rq03 >> 0) & 3) | (((hm3 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q3 = xp.vload<4>(x0 + xo + 12L).asWords();
                    int32 sa0j0q3 = wa0j0q3[0];
                    Vector<int8,32> a0j0q3 = heap Vector<int32,8>(sa0j0q3, sa0j0q3, sa0j0q3, sa0j0q3, sa0j0q3, sa0j0q3, sa0j0q3, sa0j0q3).asBytes();
                    t0j0a = u0q3.dotAccum(a0j0q3, t0j0a);
                    Vector<int32,1> wa1j0q3 = xp.vload<4>(x1 + xo + 12L).asWords();
                    int32 sa1j0q3 = wa1j0q3[0];
                    Vector<int8,32> a1j0q3 = heap Vector<int32,8>(sa1j0q3, sa1j0q3, sa1j0q3, sa1j0q3, sa1j0q3, sa1j0q3, sa1j0q3, sa1j0q3).asBytes();
                    t1j0a = u0q3.dotAccum(a1j0q3, t1j0a);
                    Vector<uint8,32> u0q4 = ((rq04 >> 0) & 3) | (((hm4 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q4 = xp.vload<4>(x0 + xo + 16L).asWords();
                    int32 sa0j0q4 = wa0j0q4[0];
                    Vector<int8,32> a0j0q4 = heap Vector<int32,8>(sa0j0q4, sa0j0q4, sa0j0q4, sa0j0q4, sa0j0q4, sa0j0q4, sa0j0q4, sa0j0q4).asBytes();
                    t0j0b = u0q4.dotAccum(a0j0q4, t0j0b);
                    Vector<int32,1> wa1j0q4 = xp.vload<4>(x1 + xo + 16L).asWords();
                    int32 sa1j0q4 = wa1j0q4[0];
                    Vector<int8,32> a1j0q4 = heap Vector<int32,8>(sa1j0q4, sa1j0q4, sa1j0q4, sa1j0q4, sa1j0q4, sa1j0q4, sa1j0q4, sa1j0q4).asBytes();
                    t1j0b = u0q4.dotAccum(a1j0q4, t1j0b);
                    Vector<uint8,32> u0q5 = ((rq05 >> 0) & 3) | (((hm5 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q5 = xp.vload<4>(x0 + xo + 20L).asWords();
                    int32 sa0j0q5 = wa0j0q5[0];
                    Vector<int8,32> a0j0q5 = heap Vector<int32,8>(sa0j0q5, sa0j0q5, sa0j0q5, sa0j0q5, sa0j0q5, sa0j0q5, sa0j0q5, sa0j0q5).asBytes();
                    t0j0b = u0q5.dotAccum(a0j0q5, t0j0b);
                    Vector<int32,1> wa1j0q5 = xp.vload<4>(x1 + xo + 20L).asWords();
                    int32 sa1j0q5 = wa1j0q5[0];
                    Vector<int8,32> a1j0q5 = heap Vector<int32,8>(sa1j0q5, sa1j0q5, sa1j0q5, sa1j0q5, sa1j0q5, sa1j0q5, sa1j0q5, sa1j0q5).asBytes();
                    t1j0b = u0q5.dotAccum(a1j0q5, t1j0b);
                    Vector<uint8,32> u0q6 = ((rq06 >> 0) & 3) | (((hm6 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q6 = xp.vload<4>(x0 + xo + 24L).asWords();
                    int32 sa0j0q6 = wa0j0q6[0];
                    Vector<int8,32> a0j0q6 = heap Vector<int32,8>(sa0j0q6, sa0j0q6, sa0j0q6, sa0j0q6, sa0j0q6, sa0j0q6, sa0j0q6, sa0j0q6).asBytes();
                    t0j0b = u0q6.dotAccum(a0j0q6, t0j0b);
                    Vector<int32,1> wa1j0q6 = xp.vload<4>(x1 + xo + 24L).asWords();
                    int32 sa1j0q6 = wa1j0q6[0];
                    Vector<int8,32> a1j0q6 = heap Vector<int32,8>(sa1j0q6, sa1j0q6, sa1j0q6, sa1j0q6, sa1j0q6, sa1j0q6, sa1j0q6, sa1j0q6).asBytes();
                    t1j0b = u0q6.dotAccum(a1j0q6, t1j0b);
                    Vector<uint8,32> u0q7 = ((rq07 >> 0) & 3) | (((hm7 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q7 = xp.vload<4>(x0 + xo + 28L).asWords();
                    int32 sa0j0q7 = wa0j0q7[0];
                    Vector<int8,32> a0j0q7 = heap Vector<int32,8>(sa0j0q7, sa0j0q7, sa0j0q7, sa0j0q7, sa0j0q7, sa0j0q7, sa0j0q7, sa0j0q7).asBytes();
                    t0j0b = u0q7.dotAccum(a0j0q7, t0j0b);
                    Vector<int32,1> wa1j0q7 = xp.vload<4>(x1 + xo + 28L).asWords();
                    int32 sa1j0q7 = wa1j0q7[0];
                    Vector<int8,32> a1j0q7 = heap Vector<int32,8>(sa1j0q7, sa1j0q7, sa1j0q7, sa1j0q7, sa1j0q7, sa1j0q7, sa1j0q7, sa1j0q7).asBytes();
                    t1j0b = u0q7.dotAccum(a1j0q7, t1j0b);
                    tot0 = tot0 + t0j0a * sc0 + t0j0b * sc1;
                    tot1 = tot1 + t1j0a * sc0 + t1j0b * sc1;
                    Vector<int32,8> t0j1a = z8;
                    Vector<int32,8> t0j1b = z8;
                    Vector<int32,8> t1j1a = z8;
                    Vector<int32,8> t1j1b = z8;
                    Vector<uint8,32> u1q0 = ((rq00 >> 2) & 3) | (((hm0 >> 1) & 1) << 2);
                    Vector<int32,1> wa0j1q0 = xp.vload<4>(x0 + xo + 32L).asWords();
                    int32 sa0j1q0 = wa0j1q0[0];
