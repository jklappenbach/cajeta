                    int32 sa1j1q0 = wa1j1q0[0];
                    Vector<int8,32> a1j1q0 = heap Vector<int32,8>(sa1j1q0, sa1j1q0, sa1j1q0, sa1j1q0, sa1j1q0, sa1j1q0, sa1j1q0, sa1j1q0).asBytes();
