                    Vector<int8,32> a0j0q1 = heap Vector<int32,8>(sa0j0q1, sa0j0q1, sa0j0q1, sa0j0q1, sa0j0q1, sa0j0q1, sa0j0q1, sa0j0q1).asBytes();
                    t0j0a = u0q1.dotAccum(a0j0q1, t0j0a);
