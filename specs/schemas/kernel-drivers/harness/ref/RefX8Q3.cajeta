package ref;

import cajeta.lang.Cajeta;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;

/** cajeta-llm's cpu Q3_K prefill kernel, lifted unchanged. */
public final class RefX8Q3 {
    public RefX8Q3() { return; }

    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    /** Rows `r0 .. r0+7` of `v` to `y[yi ..)`, only those below `rows`, set or added. */
    @Device
    static void x8Store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0,
            uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        if (n > 0L) { RefX8Q3.rowsStore(y, yi, v[0], accum); }
        if (n > 1L) { RefX8Q3.rowsStore(y, yi + 1L, v[1], accum); }
        if (n > 2L) { RefX8Q3.rowsStore(y, yi + 2L, v[2], accum); }
        if (n > 3L) { RefX8Q3.rowsStore(y, yi + 3L, v[3], accum); }
        if (n > 4L) { RefX8Q3.rowsStore(y, yi + 4L, v[4], accum); }
        if (n > 5L) { RefX8Q3.rowsStore(y, yi + 5L, v[5], accum); }
        if (n > 6L) { RefX8Q3.rowsStore(y, yi + 6L, v[6], accum); }
    }

    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void q3kQ8X8RowsKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> w, KernelBuffer<int8> xp, KernelBuffer<int32> s16,
            uint32 rows, uint32 groups, uint32 gPad, int64 blocksPerRow, int64 nc, int64 chunk,
            int64 xpStride, int64 yStride, uint32 accum) {
        uint32 gi = KernelThread.globalIdX();
        uint32 gr = gi % gPad;
        int64 cBeg = (int64) (gi / gPad) * chunk;
        if (gr < groups && cBeg < nc) {
            int64 r0 = (int64) gr * 8L;
            int64 cEnd = cBeg + chunk < nc ? cBeg + chunk : nc;
            int64 wg = (int64) gr * blocksPerRow * 928L;
            int64 gs = blocksPerRow * 16L;
            Vector<int32,8> z8 = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            Vector<float32,8> zf = z8.toF32();
            int64 c = cBeg;
            while (c < cEnd) {
                int64 cc0 = c;
                int64 x0 = cc0 * xpStride;
                int64 g0 = cc0 * gs;
                Vector<float32,8> acc0 = zf;
                int64 cc1 = (c + 1L < cEnd ? c + 1L : cEnd - 1L);
                int64 x1 = cc1 * xpStride;
                int64 g1 = cc1 * gs;
                Vector<float32,8> acc1 = zf;
                int64 b = 0;
                while (b < blocksPerRow) {
                    int64 wo = wg + b * 928L;
                    int64 xo = b * 320L;
                    int64 go = b * 16L;
                    Vector<int32,8> dw = w.vload<32>(wo).asWords();
                    Vector<float32,8> dv = heap Vector<float32,8>(Cajeta.bitsToF32(dw[0]), Cajeta.bitsToF32(dw[1]), Cajeta.bitsToF32(dw[2]), Cajeta.bitsToF32(dw[3]), Cajeta.bitsToF32(dw[4]), Cajeta.bitsToF32(dw[5]), Cajeta.bitsToF32(dw[6]), Cajeta.bitsToF32(dw[7]));
                    Vector<int8,32> sq0 = w.vload<32>(wo + 32L);
                    Vector<int16,16> sh0a = sq0.widenLo();
                    Vector<int16,16> sh0b = sq0.widenHi();
                    Vector<int8,32> sq1 = w.vload<32>(wo + 64L);
                    Vector<int16,16> sh1a = sq1.widenLo();
                    Vector<int16,16> sh1b = sq1.widenHi();
                    Vector<int8,32> sq2 = w.vload<32>(wo + 96L);
                    Vector<int16,16> sh2a = sq2.widenLo();
                    Vector<int16,16> sh2b = sq2.widenHi();
                    Vector<int8,32> sq3 = w.vload<32>(wo + 128L);
                    Vector<int16,16> sh3a = sq3.widenLo();
                    Vector<int16,16> sh3b = sq3.widenHi();
                    Vector<int32,8> sc0 = sh0a.widenLo();
                    Vector<int32,8> sc1 = sh0a.widenHi();
                    Vector<int32,8> sc2 = sh0b.widenLo();
                    Vector<int32,8> sc3 = sh0b.widenHi();
                    Vector<int32,8> sc4 = sh1a.widenLo();
                    Vector<int32,8> sc5 = sh1a.widenHi();
                    Vector<int32,8> sc6 = sh1b.widenLo();
                    Vector<int32,8> sc7 = sh1b.widenHi();
                    Vector<int32,8> sc8 = sh2a.widenLo();
                    Vector<int32,8> sc9 = sh2a.widenHi();
                    Vector<int32,8> sc10 = sh2b.widenLo();
                    Vector<int32,8> sc11 = sh2b.widenHi();
                    Vector<int32,8> sc12 = sh3a.widenLo();
                    Vector<int32,8> sc13 = sh3a.widenHi();
                    Vector<int32,8> sc14 = sh3b.widenLo();
                    Vector<int32,8> sc15 = sh3b.widenHi();
                    Vector<int32,8> ga0 = s16.vload<8>(g0 + go);
                    Vector<int32,8> gb0 = s16.vload<8>(g0 + go + 8L);
                    Vector<int32,8> tot0 = z8 - (sc0 * ga0[0] + sc1 * ga0[1] + sc2 * ga0[2] + sc3 * ga0[3] + sc4 * ga0[4] + sc5 * ga0[5] + sc6 * ga0[6] + sc7 * ga0[7] + sc8 * gb0[0] + sc9 * gb0[1] + sc10 * gb0[2] + sc11 * gb0[3] + sc12 * gb0[4] + sc13 * gb0[5] + sc14 * gb0[6] + sc15 * gb0[7]) * 4;
                    Vector<int32,8> ga1 = s16.vload<8>(g1 + go);
                    Vector<int32,8> gb1 = s16.vload<8>(g1 + go + 8L);
                    Vector<int32,8> tot1 = z8 - (sc0 * ga1[0] + sc1 * ga1[1] + sc2 * ga1[2] + sc3 * ga1[3] + sc4 * ga1[4] + sc5 * ga1[5] + sc6 * ga1[6] + sc7 * ga1[7] + sc8 * gb1[0] + sc9 * gb1[1] + sc10 * gb1[2] + sc11 * gb1[3] + sc12 * gb1[4] + sc13 * gb1[5] + sc14 * gb1[6] + sc15 * gb1[7]) * 4;
                    Vector<uint8,32> hm0 = w.vload<32>(wo + 672L).asUnsigned();
                    Vector<uint8,32> hm1 = w.vload<32>(wo + 704L).asUnsigned();
                    Vector<uint8,32> hm2 = w.vload<32>(wo + 736L).asUnsigned();
                    Vector<uint8,32> hm3 = w.vload<32>(wo + 768L).asUnsigned();
                    Vector<uint8,32> hm4 = w.vload<32>(wo + 800L).asUnsigned();
                    Vector<uint8,32> hm5 = w.vload<32>(wo + 832L).asUnsigned();
                    Vector<uint8,32> hm6 = w.vload<32>(wo + 864L).asUnsigned();
                    Vector<uint8,32> hm7 = w.vload<32>(wo + 896L).asUnsigned();
                    Vector<uint8,32> rq00 = w.vload<32>(wo + 160L).asUnsigned();
                    Vector<uint8,32> rq01 = w.vload<32>(wo + 192L).asUnsigned();
                    Vector<uint8,32> rq02 = w.vload<32>(wo + 224L).asUnsigned();
                    Vector<uint8,32> rq03 = w.vload<32>(wo + 256L).asUnsigned();
                    Vector<uint8,32> rq04 = w.vload<32>(wo + 288L).asUnsigned();
                    Vector<uint8,32> rq05 = w.vload<32>(wo + 320L).asUnsigned();
                    Vector<uint8,32> rq06 = w.vload<32>(wo + 352L).asUnsigned();
                    Vector<uint8,32> rq07 = w.vload<32>(wo + 384L).asUnsigned();
                    Vector<int32,8> t0j0a = z8;
                    Vector<int32,8> t0j0b = z8;
                    Vector<int32,8> t1j0a = z8;
                    Vector<int32,8> t1j0b = z8;
                    Vector<uint8,32> u0q0 = ((rq00 >> 0) & 3) | (((hm0 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q0 = xp.vload<4>(x0 + xo + 0L).asWords();
                    int32 sa0j0q0 = wa0j0q0[0];
                    Vector<int8,32> a0j0q0 = heap Vector<int32,8>(sa0j0q0, sa0j0q0, sa0j0q0, sa0j0q0, sa0j0q0, sa0j0q0, sa0j0q0, sa0j0q0).asBytes();
                    t0j0a = u0q0.dotAccum(a0j0q0, t0j0a);
                    Vector<int32,1> wa1j0q0 = xp.vload<4>(x1 + xo + 0L).asWords();
                    int32 sa1j0q0 = wa1j0q0[0];
                    Vector<int8,32> a1j0q0 = heap Vector<int32,8>(sa1j0q0, sa1j0q0, sa1j0q0, sa1j0q0, sa1j0q0, sa1j0q0, sa1j0q0, sa1j0q0).asBytes();
                    t1j0a = u0q0.dotAccum(a1j0q0, t1j0a);
                    Vector<uint8,32> u0q1 = ((rq01 >> 0) & 3) | (((hm1 >> 0) & 1) << 2);
                    Vector<int32,1> wa0j0q1 = xp.vload<4>(x0 + xo + 4L).asWords();
