    @Kernel
    @Occupancy(maxThreads = 256)
    public static void q8kGroupSums16Kernel(KernelBuffer<int32> s16, KernelBuffer<int8> xp,
            uint32 blocks) {
        uint32 gi = KernelThread.globalIdX();
        if (gi < blocks) {
            int64 b = (int64) gi;
            int32 j = 0;
            while (j < 16) {
                int64 o = b * 320L + (int64) (16 * j);
                int32 t = 0;
                int32 e = 0;
                while (e < 16) { t = t + (int32) xp[o + (int64) e]; e = e + 1; }
                s16[b * 16L + (int64) j] = t;
                j = j + 1;
            }
        }
    }

    public static void sums(KernelBuffer<int32> s16, KernelBuffer<int8> xp, int64 blocks) {
        KernelStream s #= KernelStream.current();
        q8kGroupSums16Kernel.launch(s, grid: [(uint32) ((blocks + 255L) / 256L)], block: [256])(s16, xp, (uint32) blocks);
    }

    public static void launch(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp, KernelBuffer<int32> s16,
            int64 rows, int64 blocksPerRow, int64 nc, int64 xpStride, int64 yStride, boolean accum,
            int64 block, int64 chunk) {
        int64 groups = (rows + 7L) / 8L;
        int64 gBlocks = (groups + block - 1L) / block;
        int64 chunks = (nc + chunk - 1L) / chunk;
        KernelStream s #= KernelStream.current();
        q3kQ8X8RowsKernel.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
            (y, w, xp, s16, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), blocksPerRow, nc, chunk,
             xpStride, yStride, accum ? 1 : 0);
    }
