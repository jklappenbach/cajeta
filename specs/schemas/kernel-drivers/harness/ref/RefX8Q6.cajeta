/** cajeta-llm's cpu Q6_K prefill kernel, lifted unchanged. */
public final class RefX8Q6 {
    public RefX8Q6() { return; }

    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    /** Rows `r0 .. r0+7` of `v` to `y[yi ..)`, only those below `rows`, set or added. */
    @Device
    static void x8Store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0,
            uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        if (n > 0L) { RefX8Q6.rowsStore(y, yi, v[0], accum); }
        if (n > 1L) { RefX8Q6.rowsStore(y, yi + 1L, v[1], accum); }
        if (n > 2L) { RefX8Q6.rowsStore(y, yi + 2L, v[2], accum); }
        if (n > 3L) { RefX8Q6.rowsStore(y, yi + 3L, v[3], accum); }
        if (n > 4L) { RefX8Q6.rowsStore(y, yi + 4L, v[4], accum); }
        if (n > 5L) { RefX8Q6.rowsStore(y, yi + 5L, v[5], accum); }
        if (n > 6L) { RefX8Q6.rowsStore(y, yi + 6L, v[6], accum); }
    }

    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void q6kQ8X8RowsKernel(KernelBuffer<float32> y,
