package ref;

import cajeta.lang.Cajeta;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.kernels.gemm.BlockGemmRows8;
import dev.cajeta.ml.kernels.quant.Q4kBlock;

/** kernel-drivers 9.1.3: the row driver's fused three-output decode against cajeta-llm's q4kQ8X8Vec3Kernel on the same data. */
public class Vec3Bench {
    static #KernelBuffer<int8> packed(BlockGemmRows8<Q4kBlock> drv, int64 rows, int64 bpr, int64 seedShift) {
        int8[] file #= Bench.weight(rows * bpr + seedShift);
        int8[] p #= heap int8[drv.packedBytes(rows, bpr)];
        drv.pack(file, seedShift * 144L, rows, bpr, p, 0L);
        KernelBuffer<int8> w #= heap KernelBuffer<int8>((uint64) drv.packedBytes(rows, bpr));
        w.upload(p);
        return #w;
    }

    static int64 diff(KernelBuffer<float32> a, KernelBuffer<float32> b, int64 n) {
        float32[] ga #= heap float32[n];
        float32[] gb #= heap float32[n];
        a.download(ga);
        b.download(gb);
        int64 bad = 0L;
        int64 i = 0L;
        while (i < n) { if (Cajeta.f32ToBits(ga[i]) != Cajeta.f32ToBits(gb[i])) { bad = bad + 1L; } i = i + 1L; }
        return bad;
    }

    static int64 shape(int64 ra, int64 rb, int64 rc, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        BlockGemmRows8<Q4kBlock> drv = heap BlockGemmRows8<Q4kBlock>();
        KernelBuffer<int8> wA #= Vec3Bench.packed(drv, ra, bpr, 0L);
        KernelBuffer<int8> wB #= Vec3Bench.packed(drv, rb, bpr, 3L);
        KernelBuffer<int8> wC #= Vec3Bench.packed(drv, rc > 0L ? rc : 8L, bpr, 5L);
        int8[] hx #= Bench.acts(bpr);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> ra1 = heap KernelBuffer<float32>((uint64) ra);
        KernelBuffer<float32> rb1 = heap KernelBuffer<float32>((uint64) rb);
        KernelBuffer<float32> rc1 = heap KernelBuffer<float32>((uint64) (rc > 0L ? rc : 8L));
        KernelBuffer<float32> na = heap KernelBuffer<float32>((uint64) ra);
        KernelBuffer<float32> nb = heap KernelBuffer<float32>((uint64) rb);
        KernelBuffer<float32> nc = heap KernelBuffer<float32>((uint64) (rc > 0L ? rc : 8L));
        KernelBuffer<int8> wCo = rc > 0L ? wC : null;
        int64 blk = VecBench.evenBlock((ra + rb + rc + 7L) / 8L);
        KernelStream s #= KernelStream.current();
        RefVec3x.launch(ra1, rb1, rc1, wA, wB, wCo, xp, ra, rb, rc, bpr, blk);
        drv.run3(s, na, nb, nc, wA, wB, wCo, xp, ra, rb, rc, bpr, blk);
        s.sync();
        int64 bad = Vec3Bench.diff(ra1, na, ra) + Vec3Bench.diff(rb1, nb, rb);
        if (rc > 0L) { bad = bad + Vec3Bench.diff(rc1, nc, rc); }
        int64 bestR = 9000000000000L;
        int64 bestN = 9000000000000L;
        int64 round = 0L;
        while (round < 25L) {
            int64 t0 = Clock.nanoTime();
            int64 k = 0L;
            while (k < reps) { RefVec3x.launch(ra1, rb1, rc1, wA, wB, wCo, xp, ra, rb, rc, bpr, blk); k = k + 1L; }
            s.sync();
            int64 t1 = Clock.nanoTime();
            k = 0L;
            while (k < reps) { drv.run3(s, na, nb, nc, wA, wB, wCo, xp, ra, rb, rc, bpr, blk); k = k + 1L; }
            s.sync();
            int64 t2 = Clock.nanoTime();
            if ((t1 - t0) / reps < bestR) { bestR = (t1 - t0) / reps; }
            if ((t2 - t1) / reps < bestN) { bestN = (t2 - t1) / reps; }
            round = round + 1L;
        }
        System.stdout.println("Vec3 " + ra + "+" + rb + "+" + rc + "x" + cols + " valueDiff " + bad
            + " ref_us " + (bestR / 1000L) + " drv_us " + (bestN / 1000L) + " ratio_pct " + (bestN * 100L / bestR));
        return bad;
    }

    public static int32 main() {
        int64 bad = Vec3Bench.shape(13L, 21L, 9L, 512L, 2L);
        bad = bad + Vec3Bench.shape(4096L, 1024L, 1024L, 4096L, 40L);
        bad = bad + Vec3Bench.shape(14336L, 14336L, 0L, 4096L, 40L);
        bad = bad + Vec3Bench.shape(2048L, 1024L, 1024L, 2560L, 40L);
        bad = bad + Vec3Bench.shape(10240L, 10240L, 0L, 2560L, 40L);
        System.stdout.println(bad == 0L ? "ALL EQUAL" : "DIFFERENT");
        return bad == 0L ? 0 : 1;
    }
}
