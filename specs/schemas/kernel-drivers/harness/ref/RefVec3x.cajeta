        if (gi < gA) {
            RefVec3x.q4kX8VecGroup(yA, wA, xp, rowsA, gi, blocksPerRow, 0, 0L, 0L, 0L);
        } else if (gi < gA + gB) {
            RefVec3x.q4kX8VecGroup(yB, wB, xp, rowsB, gi - gA, blocksPerRow, 0, 0L, 0L, 0L);
        } else if (gi < gA + gB + gC) {
            RefVec3x.q4kX8VecGroup(yC, wC, xp, rowsC, gi - gA - gB, blocksPerRow, 0, 0L, 0L, 0L);
        }
    }

    public static void launch(KernelBuffer<float32> yA, KernelBuffer<float32> yB, KernelBuffer<float32> yC,
            KernelBuffer<int8> wA, KernelBuffer<int8> wB, KernelBuffer<int8> wC, KernelBuffer<int8> xp,
            int64 rowsA, int64 rowsB, int64 rowsC, int64 bpr, int64 block) {
        uint32 gA = (uint32) ((rowsA + 7L) / 8L);
        uint32 gB = (uint32) ((rowsB + 7L) / 8L);
        uint32 gC = wC == null ? 0 : (uint32) ((rowsC + 7L) / 8L);
        uint32 n = gA + gB + gC;
        KernelStream s #= KernelStream.current();
        q4kQ8X8Vec3Kernel.launch(s, grid: [(n + (uint32) block - 1) / (uint32) block], block: [(uint32) block])
            (yA, yB, wC == null ? yB : yC, wA, wB, wC == null ? wB : wC, xp, (uint32) rowsA, (uint32) rowsB,
             (uint32) rowsC, gA, gB, gC, bpr);
    }
}
