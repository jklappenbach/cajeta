package ref;

import cajeta.lang.Cajeta;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;

/** cajeta-llm's cpu Q8_0 and Q5_0 kernels and packs, lifted unchanged (llm 0730a8b). */
public final class RefQ80 {
    public RefQ80() { return; }

    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    @Device
    static void x8Store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0,
            uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        if (n > 0L) { RefQ80.rowsStore(y, yi, v[0], accum); }
        if (n > 1L) { RefQ80.rowsStore(y, yi + 1L, v[1], accum); }
        if (n > 2L) { RefQ80.rowsStore(y, yi + 2L, v[2], accum); }
        if (n > 3L) { RefQ80.rowsStore(y, yi + 3L, v[3], accum); }
        if (n > 4L) { RefQ80.rowsStore(y, yi + 4L, v[4], accum); }
        if (n > 5L) { RefQ80.rowsStore(y, yi + 5L, v[5], accum); }
        if (n > 6L) { RefQ80.rowsStore(y, yi + 6L, v[6], accum); }
    }

    @Kernel(targets = {"cpu"})
