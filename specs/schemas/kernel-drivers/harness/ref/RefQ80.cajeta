    public static void q80Interleave8Pad(int8[] packed, int64 srcOff, int64 rows, int64 nb,
            int8[] out, int64 outOff) {
        int64 sbpr = (nb + 7L) / 8L;
        int64 n = ((rows + 7L) / 8L) * sbpr * 2176L;
        if (rows % 8L != 0L) {
            int64 z = 0;
            while (z < n) { out[outOff + z] = (int8) 0; z = z + 1; }
        }
        int64 r = 0;
        while (r < rows) {
            int64 g8 = r / 8L;
            int64 lane = r % 8L;
            int64 b = 0;
            while (b < sbpr) {
                int64 wo = outOff + (g8 * sbpr + b) * 2176L;
                int64 j = 0;
                while (j < 8L) {
                    int64 blk = b * 8L + j;
                    boolean real = blk < nb;
                    int64 ro = srcOff + (r * nb + blk) * 34L;
                    out[wo + 16L * j + lane * 2L] = real ? packed[ro] : (int8) 0;
                    out[wo + 16L * j + lane * 2L + 1L] = real ? packed[ro + 1L] : (int8) 0;
                    int64 k = 0;
                    while (k < 32L) {
                        int32 q = real ? (int32) packed[ro + 2L + k] : 0;
                        out[wo + 128L + 32L * (8L * j + k / 4L) + 4L * lane + k % 4L] = (int8) (q ^ (0 - 128));
                        k = k + 1L;
                    }
                    j = j + 1L;
                }
                b = b + 1L;
            }
            r = r + 1L;
        }
    }

    public static void q50Interleave8Pad(int8[] packed, int64 srcOff, int64 rows, int64 nb,
            int8[] out, int64 outOff) {
        int64 sbpr = (nb + 7L) / 8L;
        int64 n = ((rows + 7L) / 8L) * sbpr * 1408L;
        int64 z = 0;
        while (z < n) { out[outOff + z] = (int8) 0; z = z + 1; }
        int64 r = 0;
        while (r < rows) {
            int64 g8 = r / 8L;
            int64 lane = r % 8L;
            int64 blk = 0;
            while (blk < nb) {
                int64 wo = outOff + (g8 * sbpr + blk / 8L) * 1408L;
                int64 j = blk % 8L;
                int64 ro = srcOff + (r * nb + blk) * 22L;
                out[wo + 16L * j + lane * 2L] = packed[ro];
                out[wo + 16L * j + lane * 2L + 1L] = packed[ro + 1L];
                int32 qh = RefQ80.u8(packed, ro + 2L) | (RefQ80.u8(packed, ro + 3L) << 8)
                    | (RefQ80.u8(packed, ro + 4L) << 16) | (RefQ80.u8(packed, ro + 5L) << 24);
                int64 k = 0;
                while (k < 4L) {
                    int32 hb = 0;
                    int64 q = 0;
                    while (q < 4L) {
                        out[wo + 128L + 128L * j + 32L * q + 4L * lane + k] = packed[ro + 6L + 4L * q + k];
                        hb = hb | (((qh >> (int32) (4L * q + k)) & 1) << (int32) (2L * q));
                        hb = hb | (((qh >> (int32) (16L + 4L * q + k)) & 1) << (int32) (2L * q + 1L));
                        q = q + 1L;
                    }
                    out[wo + 1152L + 32L * j + 4L * lane + k] = (int8) hb;
                    k = k + 1L;
                }
                blk = blk + 1L;
            }
            r = r + 1L;
        }
    }

    static int32 u8(int8[] raw, int64 at) { return (int32) raw[at] & 255; }

    /** llm's cpu launch of the Q8_0 kernels: the one-column kernel for one token; `block` groups a block, `chunk` tokens a work-item. */
    public static void q80(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float16> wh, KernelBuffer<int8> xp,
            int64 rows, int64 sbpr, int64 nc, int64 xpStride, int64 yStride, boolean accum, int64 sst, int64 block, int64 chunk) {
        int64 groups = (rows + 7L) / 8L;
        int64 gBlocks = (groups + block - 1L) / block;
        int64 chunks = (nc + chunk - 1L) / chunk;
        KernelStream s #= KernelStream.current();
        if (nc == 1L) {
            q80Q8X8VecKernel.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
                (y, w, wh, xp, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), sbpr, nc, chunk, xpStride, yStride, accum ? 1 : 0, sst);
        } else {
            q80Q8X8RowsKernel.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
                (y, w, wh, xp, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), sbpr, nc, chunk, xpStride, yStride, accum ? 1 : 0, sst);
        }
    }

    /** {@link #q80} for Q5_0. */
    public static void q50(KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<float16> wh, KernelBuffer<int8> xp,
            int64 rows, int64 sbpr, int64 nc, int64 xpStride, int64 yStride, boolean accum, int64 block, int64 chunk) {
        int64 groups = (rows + 7L) / 8L;
        int64 gBlocks = (groups + block - 1L) / block;
        int64 chunks = (nc + chunk - 1L) / chunk;
        KernelStream s #= KernelStream.current();
        if (nc == 1L) {
            q50Q8X8VecKernel.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
                (y, w, wh, xp, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), sbpr, nc, chunk, xpStride, yStride, accum ? 1 : 0);
        } else {
            q50Q8X8RowsKernel.launch(s, grid: [(uint32) (gBlocks * chunks)], block: [(uint32) block])
                (y, w, wh, xp, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), sbpr, nc, chunk, xpStride, yStride, accum ? 1 : 0);
        }
    }
