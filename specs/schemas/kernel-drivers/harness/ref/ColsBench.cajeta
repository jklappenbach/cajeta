package ref;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.kernels.gemm.Block32GemvWave;
import dev.cajeta.ml.kernels.gemm.BlockGemvWave;
import dev.cajeta.ml.kernels.quant.Q2kBlock;
import dev.cajeta.ml.kernels.quant.Q3kBlock;
import dev.cajeta.ml.kernels.quant.Q4kBlock;
import dev.cajeta.ml.kernels.quant.Q5kBlock;
import dev.cajeta.ml.kernels.quant.Q6kBlock;
import dev.cajeta.ml.kernels.quant.Q80Block;

/** kernel-drivers 9.1.8: the GPU batched decode (2, 4, 8 tokens) of both decode drivers against cajeta-llm's column kernels (`ref/RefCols`), every format, best launch against best on one weight buffer where the layouts match (every llm arm of Q4_K and Q6_K, `ref/RefColsR`); Q4_K, Q5_K and Q8_0 bitwise, the others by difference over the output scale (spec 7.6). */
public class ColsBench {
    /** Format `f`: 0 Q4_K, 1 Q5_K, 2 Q6_K, 3 Q3_K, 4 Q2_K, 5 Q8_0; member `r` 1 or 2 rows a wave (K formats). */
    static void drv(int32 f, int32 r, KernelStream s, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 ncols, int64 xps, int64 wpb, int64 wv) {
        if (r == 2) {
            if (f == 0) { heap BlockGemvWave<Q4kBlock, 2, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
            if (f == 1) { heap BlockGemvWave<Q5kBlock, 2, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
            if (f == 2) { heap BlockGemvWave<Q6kBlock, 2, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
            if (f == 3) { heap BlockGemvWave<Q3kBlock, 2, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
            if (f == 4) { heap BlockGemvWave<Q2kBlock, 2, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
            return;
        }
        if (f == 0) { heap BlockGemvWave<Q4kBlock, 1, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
        if (f == 1) { heap BlockGemvWave<Q5kBlock, 1, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
        if (f == 2) { heap BlockGemvWave<Q6kBlock, 1, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
        if (f == 3) { heap BlockGemvWave<Q3kBlock, 1, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
        if (f == 4) { heap BlockGemvWave<Q2kBlock, 1, 0>().runColsOn(s, y, w, xp, rows, cols, 0L, ncols, rows, xps, false, wpb, wv); }
        if (f == 5) { heap Block32GemvWave<Q80Block, 1>().runColsOn(s, y, w, xp, rows, cols / 32L, 0L, ncols, rows, xps, false, wpb, wv); }
    }

    /** llm's kernel `v` of format `f`: 0 plain, 1 Pf; Q4_K 2 two rows, 3 two rows four columns, 4 two-wave group, 5 four rows; Q6_K 2 two rows. */
    static void ref(int32 f, int32 v, KernelBuffer<float32> y, KernelBuffer<int8> w, KernelBuffer<int8> xp,
            int64 rows, int64 cols, int64 ncols, int64 xps, int64 wpb, int64 wv) {
        int64 bpr = cols / 256L;
        if (f == 0) {
            if (v == 0) { RefCols.run_0(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
            else if (v == 1) { RefCols.run_1(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
            else { RefColsR.runQ4(v - 2, y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
        }
        if (f == 1) { RefCols.run_2(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
        if (f == 2) {
            if (v == 0) { RefCols.run_3(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
            else if (v == 1) { RefCols.run_4(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
            else { RefColsR.runQ6(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
        }
        if (f == 3) { RefCols.run_5(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
        if (f == 4) { RefCols.run_6(y, w, xp, rows, bpr, ncols, rows, xps, wpb, wv); }
        if (f == 5) { RefCols.run_7(y, w, xp, rows, cols / 32L, ncols, rows, xps, wpb, wv); }
    }

    static #int8[] copy(int8[] a) {
        int8[] b #= heap int8[a.count()];
        int64 i = 0L;
        while (i < a.count()) { b[i] = a[i]; i = i + 1L; }
        return #b;
    }

    /** cajeta-llm's resident row: the block's f16 at `dAt` moved to a word-padded row prefix, the rest after it. */
    static #int8[] split(int8[] file, int64 rows, int64 bpr, int64 bb, int64 dAt) {
        int64 pb = bb - 2L;
        int64 prefix = ((bpr * 2L + 3L) / 4L) * 4L;
        int64 rowB = prefix + bpr * pb;
        int8[] res #= heap int8[rows * rowB];
        int64 r = 0L;
        while (r < rows) {
            int64 b = 0L;
            while (b < bpr) {
                int64 ro = (r * bpr + b) * bb;
                res[r * rowB + 2L * b] = file[ro + dAt];
                res[r * rowB + 2L * b + 1L] = file[ro + dAt + 1L];
                int64 k = 0L;
                int64 o = 0L;
                while (k < bb) {
                    if (k < dAt || k >= dAt + 2L) { res[r * rowB + prefix + b * pb + o] = file[ro + k]; o = o + 1L; }
                    k = k + 1L;
                }
                b = b + 1L;
            }
            r = r + 1L;
        }
        return #res;
    }

    static int64 shape(int32 f, int64 rows, int64 cols, int64 ncols, int64 reps) {
        int64 bpr = cols / 256L;
        int64 nb = cols / 32L;
        String nm = f == 0 ? "Q4_K" : (f == 1 ? "Q5_K" : (f == 2 ? "Q6_K" : (f == 3 ? "Q3_K" : (f == 4 ? "Q2_K" : "Q8_0"))));
        int8[] file #= heap int8[1];
        if (f == 0) { file #= Bench.weight(rows * bpr); }
        if (f == 1) { file #= Bench5.weight(rows * bpr); }
        if (f == 2) { file #= Bench6.weight(rows * bpr); }
        if (f == 3) { file #= Bench3.weight(rows * bpr); }
        if (f == 4) { file #= Bench2.weight(rows * bpr); }
        if (f == 5) { file #= Bench32.weight(rows * nb, 34L); }
        int8[] hx #= Bench6.acts(ncols * bpr);
        int8[] dw #= heap int8[1];
        int8[] rw #= heap int8[1];
        if (f == 5) {
            Block32GemvWave<Q80Block, 1> lay = heap Block32GemvWave<Q80Block, 1>();
            dw #= heap int8[rows * lay.rowBytes(nb)];
            lay.pack(file, 0L, rows, nb, dw, 0L);
            rw #= heap int8[rows * lay.rowBytes(nb)];
            RefWave32.split(file, rows, nb, 34L, rw);
        } else {
            dw #= ColsBench.copy(file);
            if (f == 2) { rw #= ColsBench.split(file, rows, bpr, 210L, 208L); }
            else if (f == 3) { rw #= ColsBench.split(file, rows, bpr, 110L, 108L); }
            else { rw #= ColsBench.copy(file); }
        }
        KernelBuffer<int8> wd = heap KernelBuffer<int8>((uint64) dw.count());
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) rw.count());
        wd.upload(dw);
        wr.upload(rw);
        KernelBuffer<int8> wl = wr;
        if (f == 0 || f == 1 || f == 4) { wl = wd; }
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (ncols * bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) (ncols * rows));
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) (ncols * rows));
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        int64 xps = bpr * 320L;
        KernelStream s #= KernelStream.current();
        float32[] gr #= heap float32[ncols * rows];
        float32[] gn #= heap float32[ncols * rows];
        ColsBench.ref(f, 0, yr, wl, xp, rows, cols, ncols, xps, 1L, wv);
        ColsBench.drv(f, 1, s, yn, wd, xp, rows, cols, ncols, xps, 1L, wv);
        s.sync();
        yr.download(gr);
        yn.download(gn);
        int64 bits = WaveBench.bitDiff(gr, gn, ncols * rows);
        float64 rel = WaveBench.normRel(gr, gn, ncols * rows);
        int64 bad = 0L;
        boolean exact = f == 0 || f == 1 || f == 5;
        if (exact && bits != 0L) { bad = 1L; }
        if (!exact && rel > 0.000001) { bad = 1L; }
        if (f != 5) {
            ColsBench.drv(f, 2, s, yn, wd, xp, rows, cols, ncols, xps, 1L, wv);
            s.sync();
            yn.download(gn);
            if (exact && WaveBench.bitDiff(gr, gn, ncols * rows) != 0L) { bad = 1L; }
            if (!exact && WaveBench.normRel(gr, gn, ncols * rows) > 0.000001) { bad = 1L; }
        }
        int32 variants = f == 0 ? (ncols <= 4L ? 6 : 3) : (f == 2 ? 3 : 1);
        int64 armBad = 0L;
        float32[] ga #= heap float32[ncols * rows];
        int32 va = 1;
        while (va < variants) {
            ColsBench.ref(f, va, yr, wl, xp, rows, cols, ncols, xps, 1L, wv);
            s.sync();
            yr.download(ga);
            if (WaveBench.normRel(gr, ga, ncols * rows) > 0.000001) { armBad = armBad + 1L; }
            va = va + 1;
        }
        if (armBad != 0L) { bad = 1L; }
        int32 bestV = 0;
        int32 bestD = 1;
        int64 bestR = 9000000000000L;
        int64 bestN = 9000000000000L;
        int64 round = 0L;
        while (round < 15L) {
            int64 wi = 0L;
            while (wi < 3L) {
                int64 wpb = wi == 0L ? 1L : (wi == 1L ? 2L : 4L);
                int32 v = 0;
                while (v < variants) {
                    int64 t0 = Clock.nanoTime();
                    int64 k = 0L;
                    while (k < reps) { ColsBench.ref(f, v, yr, wl, xp, rows, cols, ncols, xps, wpb, wv); k = k + 1L; }
                    s.sync();
                    int64 t1 = Clock.nanoTime();
                    if ((t1 - t0) / reps < bestR) { bestR = (t1 - t0) / reps; bestV = v; }
                    v = v + 1;
                }
                int32 dr = 1;
                while (dr <= (f == 5 ? 1 : 2)) {
                    int64 t2 = Clock.nanoTime();
                    int64 k = 0L;
                    while (k < reps) { ColsBench.drv(f, dr, s, yn, wd, xp, rows, cols, ncols, xps, wpb, wv); k = k + 1L; }
                    s.sync();
                    int64 t3 = Clock.nanoTime();
                    if ((t3 - t2) / reps < bestN) { bestN = (t3 - t2) / reps; bestD = dr; }
                    dr = dr + 1;
                }
                wi = wi + 1L;
            }
            round = round + 1L;
        }
        System.stdout.println(nm + " " + rows + "x" + cols + " ncols " + ncols + " bitDiff " + bits + " normRel " + rel + " ref_ns " + bestR
            + " drv_ns " + bestN + " drv_r " + bestD + " llm_arm " + bestV + " arm_bad " + armBad + " ratio_pct " + (bestN * 100L / bestR));
        return bad;
    }

    public static int32 main() {
        int64 bad = 0L;
        int32 f = 0;
        while (f < 6) {
            bad = bad + ColsBench.shape(f, 37L, 2304L, 3L, 2L);
            int64 n = 2L;
            while (n <= 8L) {
                bad = bad + ColsBench.shape(f, 4096L, 4096L, n, 40L);
                bad = bad + ColsBench.shape(f, 14336L, 4096L, n, 10L);
                bad = bad + ColsBench.shape(f, 4096L, 14336L, n, 10L);
                bad = bad + ColsBench.shape(f, 2048L, 2560L, n, 60L);
                bad = bad + ColsBench.shape(f, 10240L, 2560L, n, 20L);
                n = n * 2L;
            }
            f = f + 1;
        }
        System.stdout.println(bad == 0L ? "ALL EQUAL" : "DIFFERENT");
        return bad == 0L ? 0 : 1;
    }
}
