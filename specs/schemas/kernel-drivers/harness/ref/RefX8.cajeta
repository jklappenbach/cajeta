package ref;

import cajeta.lang.Cajeta;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;

/** cajeta-llm's cpu Q4_K prefill kernel, lifted unchanged (llm main a513c7b's tree). */
public final class RefX8 {
    public RefX8() { return; }

    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    /** Rows `r0 .. r0+7` of `v` to `y[yi ..)`, only those below `rows`, set or added. */
    @Device
    static void x8Store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0,
            uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        if (n > 0L) { RefX8.rowsStore(y, yi, v[0], accum); }
        if (n > 1L) { RefX8.rowsStore(y, yi + 1L, v[1], accum); }
        if (n > 2L) { RefX8.rowsStore(y, yi + 2L, v[2], accum); }
        if (n > 3L) { RefX8.rowsStore(y, yi + 3L, v[3], accum); }
        if (n > 4L) { RefX8.rowsStore(y, yi + 4L, v[4], accum); }
        if (n > 5L) { RefX8.rowsStore(y, yi + 5L, v[5], accum); }
        if (n > 6L) { RefX8.rowsStore(y, yi + 6L, v[6], accum); }
    }

    /** {@link #q4kQ8RowsKernel} on the 8-row interleave {@link Quant#q4kInterleave8} writes: lane r is row 8g + r, so a sub-block costs one scale multiply for eight rows and no horizontal sum. */
    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void q4kQ8X8RowsKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> w, KernelBuffer<int8> xp,
            uint32 rows, uint32 groups, uint32 gPad, int64 blocksPerRow, int64 nc, int64 chunk,
            int64 xpStride, int64 yStride, uint32 accum) {
        uint32 gi = KernelThread.globalIdX();
        uint32 gr = gi % gPad;
        int64 cBeg = (int64) (gi / gPad) * chunk;
        if (gr < groups && cBeg < nc) {
            int64 r0 = (int64) gr * 8L;
            int64 cEnd = cBeg + chunk < nc ? cBeg + chunk : nc;
            int64 wg = (int64) gr * blocksPerRow * 1216L;
            Vector<int32,8> z8 = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            Vector<float32,8> zf = z8.toF32();
            int64 c = cBeg;
            if (c < cEnd) {
                int64 x0 = c * xpStride;
                Vector<float32,8> acc0 = zf;
                int64 x1 = (c + 1L < cEnd ? c + 1L : cEnd - 1L) * xpStride;
                Vector<float32,8> acc1 = zf;
                int64 x2 = (c + 2L < cEnd ? c + 2L : cEnd - 1L) * xpStride;
                Vector<float32,8> acc2 = zf;
                int64 x3 = (c + 3L < cEnd ? c + 3L : cEnd - 1L) * xpStride;
                Vector<float32,8> acc3 = zf;
                int64 b = 0;
                while (b < blocksPerRow) {
                    int64 wo = wg + b * 1216L;
                    int64 xo = b * 320L;
                    if (b + 2L < blocksPerRow) {
                        int64 pl = 0;
                        while (pl < 19L) {
                            w.prefetch(wo + 2432L + pl * 64L);
                            pl = pl + 1L;
                        }
                    }
                    Vector<int32,8> dw = w.vload<32>(wo).asWords();
                    Vector<int32,8> mw = w.vload<32>(wo + 32L).asWords();
                    Vector<float32,8> dv = heap Vector<float32,8>(Cajeta.bitsToF32(dw[0]), Cajeta.bitsToF32(dw[1]), Cajeta.bitsToF32(dw[2]), Cajeta.bitsToF32(dw[3]), Cajeta.bitsToF32(dw[4]), Cajeta.bitsToF32(dw[5]), Cajeta.bitsToF32(dw[6]), Cajeta.bitsToF32(dw[7]));
                    Vector<float32,8> mv = heap Vector<float32,8>(Cajeta.bitsToF32(mw[0]), Cajeta.bitsToF32(mw[1]), Cajeta.bitsToF32(mw[2]), Cajeta.bitsToF32(mw[3]), Cajeta.bitsToF32(mw[4]), Cajeta.bitsToF32(mw[5]), Cajeta.bitsToF32(mw[6]), Cajeta.bitsToF32(mw[7]));
                    Vector<uint8,32> sA = w.vload<32>(wo + 64L).asUnsigned();
                    Vector<uint8,32> sB = w.vload<32>(wo + 96L).asUnsigned();
                    Vector<uint8,32> nA = w.vload<32>(wo + 128L).asUnsigned();
                    Vector<uint8,32> nB = w.vload<32>(wo + 160L).asUnsigned();
                    Vector<int32,8> si0 = z8;
                    Vector<int32,8> si1 = z8;
                    Vector<int32,8> si2 = z8;
                    Vector<int32,8> si3 = z8;
                    Vector<uint16,16> h0 = sA.widenLo();
                    Vector<int32,8> scl0 = h0.widenLo().asSigned();
                    Vector<int32,8> sch0 = h0.widenHi().asSigned();
                    Vector<int32,8> tl0g0 = z8;
                    Vector<int32,8> th0g0 = z8;
                    Vector<int32,8> tl1g0 = z8;
                    Vector<int32,8> th1g0 = z8;
                    Vector<int32,8> tl2g0 = z8;
                    Vector<int32,8> th2g0 = z8;
                    Vector<int32,8> tl3g0 = z8;
                    Vector<int32,8> th3g0 = z8;
                    Vector<uint8,32> rq00 = w.vload<32>(wo + 192L).asUnsigned();
                    Vector<uint8,32> lq00 = rq00 & 15;
                    Vector<uint8,32> hq00 = (rq00 >> 4) & 15;
                    Vector<int32,1> wal0g0q0 = xp.vload<4>(x0 + xo + 0L).asWords();
                    int32 sal0g0q0 = wal0g0q0[0];
                    Vector<int8,32> al0g0q0 = heap Vector<int32,8>(sal0g0q0, sal0g0q0, sal0g0q0, sal0g0q0, sal0g0q0, sal0g0q0, sal0g0q0, sal0g0q0).asBytes();
                    tl0g0 = lq00.dotAccum(al0g0q0, tl0g0);
                    Vector<int32,1> wah0g0q0 = xp.vload<4>(x0 + xo + 32L).asWords();
                    int32 sah0g0q0 = wah0g0q0[0];
                    Vector<int8,32> ah0g0q0 = heap Vector<int32,8>(sah0g0q0, sah0g0q0, sah0g0q0, sah0g0q0, sah0g0q0, sah0g0q0, sah0g0q0, sah0g0q0).asBytes();
                    th0g0 = hq00.dotAccum(ah0g0q0, th0g0);
                    Vector<int32,1> wal1g0q0 = xp.vload<4>(x1 + xo + 0L).asWords();
                    int32 sal1g0q0 = wal1g0q0[0];
                    Vector<int8,32> al1g0q0 = heap Vector<int32,8>(sal1g0q0, sal1g0q0, sal1g0q0, sal1g0q0, sal1g0q0, sal1g0q0, sal1g0q0, sal1g0q0).asBytes();
                    tl1g0 = lq00.dotAccum(al1g0q0, tl1g0);
                    Vector<int32,1> wah1g0q0 = xp.vload<4>(x1 + xo + 32L).asWords();
                    int32 sah1g0q0 = wah1g0q0[0];
                    Vector<int8,32> ah1g0q0 = heap Vector<int32,8>(sah1g0q0, sah1g0q0, sah1g0q0, sah1g0q0, sah1g0q0, sah1g0q0, sah1g0q0, sah1g0q0).asBytes();
                    th1g0 = hq00.dotAccum(ah1g0q0, th1g0);
                    Vector<int32,1> wal2g0q0 = xp.vload<4>(x2 + xo + 0L).asWords();
                    int32 sal2g0q0 = wal2g0q0[0];
                    Vector<int8,32> al2g0q0 = heap Vector<int32,8>(sal2g0q0, sal2g0q0, sal2g0q0, sal2g0q0, sal2g0q0, sal2g0q0, sal2g0q0, sal2g0q0).asBytes();
                    tl2g0 = lq00.dotAccum(al2g0q0, tl2g0);
                    Vector<int32,1> wah2g0q0 = xp.vload<4>(x2 + xo + 32L).asWords();
                    int32 sah2g0q0 = wah2g0q0[0];
                    Vector<int8,32> ah2g0q0 = heap Vector<int32,8>(sah2g0q0, sah2g0q0, sah2g0q0, sah2g0q0, sah2g0q0, sah2g0q0, sah2g0q0, sah2g0q0).asBytes();
                    th2g0 = hq00.dotAccum(ah2g0q0, th2g0);
                    Vector<int32,1> wal3g0q0 = xp.vload<4>(x3 + xo + 0L).asWords();
                    int32 sal3g0q0 = wal3g0q0[0];
                    Vector<int8,32> al3g0q0 = heap Vector<int32,8>(sal3g0q0, sal3g0q0, sal3g0q0, sal3g0q0, sal3g0q0, sal3g0q0, sal3g0q0, sal3g0q0).asBytes();
                    tl3g0 = lq00.dotAccum(al3g0q0, tl3g0);
                    Vector<int32,1> wah3g0q0 = xp.vload<4>(x3 + xo + 32L).asWords();
                    int32 sah3g0q0 = wah3g0q0[0];
                    Vector<int8,32> ah3g0q0 = heap Vector<int32,8>(sah3g0q0, sah3g0q0, sah3g0q0, sah3g0q0, sah3g0q0, sah3g0q0, sah3g0q0, sah3g0q0).asBytes();
                    th3g0 = hq00.dotAccum(ah3g0q0, th3g0);
                    Vector<uint8,32> rq01 = w.vload<32>(wo + 224L).asUnsigned();
                    Vector<uint8,32> lq01 = rq01 & 15;
                    Vector<uint8,32> hq01 = (rq01 >> 4) & 15;
                    Vector<int32,1> wal0g0q1 = xp.vload<4>(x0 + xo + 4L).asWords();
                    int32 sal0g0q1 = wal0g0q1[0];
                    Vector<int8,32> al0g0q1 = heap Vector<int32,8>(sal0g0q1, sal0g0q1, sal0g0q1, sal0g0q1, sal0g0q1, sal0g0q1, sal0g0q1, sal0g0q1).asBytes();
                    tl0g0 = lq01.dotAccum(al0g0q1, tl0g0);
                    Vector<int32,1> wah0g0q1 = xp.vload<4>(x0 + xo + 36L).asWords();
                    int32 sah0g0q1 = wah0g0q1[0];
                    Vector<int8,32> ah0g0q1 = heap Vector<int32,8>(sah0g0q1, sah0g0q1, sah0g0q1, sah0g0q1, sah0g0q1, sah0g0q1, sah0g0q1, sah0g0q1).asBytes();
                    th0g0 = hq01.dotAccum(ah0g0q1, th0g0);
                    Vector<int32,1> wal1g0q1 = xp.vload<4>(x1 + xo + 4L).asWords();
                    int32 sal1g0q1 = wal1g0q1[0];
                    Vector<int8,32> al1g0q1 = heap Vector<int32,8>(sal1g0q1, sal1g0q1, sal1g0q1, sal1g0q1, sal1g0q1, sal1g0q1, sal1g0q1, sal1g0q1).asBytes();
                    tl1g0 = lq01.dotAccum(al1g0q1, tl1g0);
                    Vector<int32,1> wah1g0q1 = xp.vload<4>(x1 + xo + 36L).asWords();
                    int32 sah1g0q1 = wah1g0q1[0];
                    Vector<int8,32> ah1g0q1 = heap Vector<int32,8>(sah1g0q1, sah1g0q1, sah1g0q1, sah1g0q1, sah1g0q1, sah1g0q1, sah1g0q1, sah1g0q1).asBytes();
                    th1g0 = hq01.dotAccum(ah1g0q1, th1g0);
                    Vector<int32,1> wal2g0q1 = xp.vload<4>(x2 + xo + 4L).asWords();
                    int32 sal2g0q1 = wal2g0q1[0];
                    Vector<int8,32> al2g0q1 = heap Vector<int32,8>(sal2g0q1, sal2g0q1, sal2g0q1, sal2g0q1, sal2g0q1, sal2g0q1, sal2g0q1, sal2g0q1).asBytes();
                    tl2g0 = lq01.dotAccum(al2g0q1, tl2g0);
                    Vector<int32,1> wah2g0q1 = xp.vload<4>(x2 + xo + 36L).asWords();
                    int32 sah2g0q1 = wah2g0q1[0];
                    Vector<int8,32> ah2g0q1 = heap Vector<int32,8>(sah2g0q1, sah2g0q1, sah2g0q1, sah2g0q1, sah2g0q1, sah2g0q1, sah2g0q1, sah2g0q1).asBytes();
                    th2g0 = hq01.dotAccum(ah2g0q1, th2g0);
                    Vector<int32,1> wal3g0q1 = xp.vload<4>(x3 + xo + 4L).asWords();
                    int32 sal3g0q1 = wal3g0q1[0];
                    Vector<int8,32> al3g0q1 = heap Vector<int32,8>(sal3g0q1, sal3g0q1, sal3g0q1, sal3g0q1, sal3g0q1, sal3g0q1, sal3g0q1, sal3g0q1).asBytes();
                    tl3g0 = lq01.dotAccum(al3g0q1, tl3g0);
                    Vector<int32,1> wah3g0q1 = xp.vload<4>(x3 + xo + 36L).asWords();
                    int32 sah3g0q1 = wah3g0q1[0];
                    Vector<int8,32> ah3g0q1 = heap Vector<int32,8>(sah3g0q1, sah3g0q1, sah3g0q1, sah3g0q1, sah3g0q1, sah3g0q1, sah3g0q1, sah3g0q1).asBytes();
                    th3g0 = hq01.dotAccum(ah3g0q1, th3g0);
                    Vector<uint8,32> rq02 = w.vload<32>(wo + 256L).asUnsigned();
                    Vector<uint8,32> lq02 = rq02 & 15;
                    Vector<uint8,32> hq02 = (rq02 >> 4) & 15;
                    Vector<int32,1> wal0g0q2 = xp.vload<4>(x0 + xo + 8L).asWords();
                    int32 sal0g0q2 = wal0g0q2[0];
                    Vector<int8,32> al0g0q2 = heap Vector<int32,8>(sal0g0q2, sal0g0q2, sal0g0q2, sal0g0q2, sal0g0q2, sal0g0q2, sal0g0q2, sal0g0q2).asBytes();
                    tl0g0 = lq02.dotAccum(al0g0q2, tl0g0);
                    Vector<int32,1> wah0g0q2 = xp.vload<4>(x0 + xo + 40L).asWords();
                    int32 sah0g0q2 = wah0g0q2[0];
                    Vector<int8,32> ah0g0q2 = heap Vector<int32,8>(sah0g0q2, sah0g0q2, sah0g0q2, sah0g0q2, sah0g0q2, sah0g0q2, sah0g0q2, sah0g0q2).asBytes();
                    th0g0 = hq02.dotAccum(ah0g0q2, th0g0);
                    Vector<int32,1> wal1g0q2 = xp.vload<4>(x1 + xo + 8L).asWords();
                    int32 sal1g0q2 = wal1g0q2[0];
                    Vector<int8,32> al1g0q2 = heap Vector<int32,8>(sal1g0q2, sal1g0q2, sal1g0q2, sal1g0q2, sal1g0q2, sal1g0q2, sal1g0q2, sal1g0q2).asBytes();
                    tl1g0 = lq02.dotAccum(al1g0q2, tl1g0);
                    Vector<int32,1> wah1g0q2 = xp.vload<4>(x1 + xo + 40L).asWords();
                    int32 sah1g0q2 = wah1g0q2[0];
                    Vector<int8,32> ah1g0q2 = heap Vector<int32,8>(sah1g0q2, sah1g0q2, sah1g0q2, sah1g0q2, sah1g0q2, sah1g0q2, sah1g0q2, sah1g0q2).asBytes();
                    th1g0 = hq02.dotAccum(ah1g0q2, th1g0);
                    Vector<int32,1> wal2g0q2 = xp.vload<4>(x2 + xo + 8L).asWords();
                    int32 sal2g0q2 = wal2g0q2[0];
                    Vector<int8,32> al2g0q2 = heap Vector<int32,8>(sal2g0q2, sal2g0q2, sal2g0q2, sal2g0q2, sal2g0q2, sal2g0q2, sal2g0q2, sal2g0q2).asBytes();
                    tl2g0 = lq02.dotAccum(al2g0q2, tl2g0);
                    Vector<int32,1> wah2g0q2 = xp.vload<4>(x2 + xo + 40L).asWords();
