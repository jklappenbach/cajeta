                    e7 = RefColsR.q6kColDot(e7, v7, a70, a71, a72, a73, q0B, q1B, q2B, q3B, s0B, s1B, s2B, s3B, dscB);
                }
                b = bn;
            }
        }
        RefCols.colsStore(y, row, rows, yOff, yStride, accum, ncols, lane,
            c0, c1, c2, c3, c4, c5, c6, c7);
        RefCols.colsStore(y, rowB, rows, yOff, yStride, accum, ncols, lane,
            e0, e1, e2, e3, e4, e5, e6, e7);
    }

    /** {@link #q4kColAcc} on an activation already loaded. */
    @Device
    /** One lane's 64-weight chunk of a Q4_K block against one packed q8_K column, added
     *  to `acc`: the two sub-block dots as chained dp4a (`dotSum`), the activation's
     *  sub-block sums `as0`, `as1` read from the pack (bytes 256..287 of its block) rather
     *  than recomputed, and its scale `xs` decoded once per column, not per row. The sum
     *  is the same integer the lane-wise form reached, so the float result is bit-identical
     *  (cajeta-llm 15.2.15.1: the lane-wise form spent a third of its dp4a on the sums and
     *  seven adds on every partial). */
    static float32 q4kColDot(float32 acc, Vector<int8,32> a0, Vector<int8,32> a1,
            float32 xs, int32 as0, int32 as1, Vector<uint8,32> lo, Vector<uint8,32> hi,
            int32 sc0, int32 sc1, int32 mn0, int32 mn1, float32 d, float32 dmin) {
        int32 sumi = lo.dotSum(a0, 0) * sc0 + hi.dotSum(a1, 0) * sc1;
        int32 dmins = as0 * mn0 + as1 * mn1;
        return acc + d * xs * (float32) sumi - dmin * xs * (float32) dmins;
    }

    /** One lane's 16-weight slice of a Q4_K sub-block against one packed q8_K column, added to `acc`:
     *  `q` the slice's nibbles, `a` the column's 16 activations, `asum` their sum, `xs` the column's
     *  scale, `sc`/`mn` the sub-block's scale and minimum (15.2.12.3.9.6.4). */
    @Device
    static float32 q4kSliceDot(float32 acc, Vector<uint8,16> q, Vector<int8,16> a, int32 asum,
            float32 xs, int32 sc, int32 mn, float32 d, float32 dmin) {
        int32 sumi = q.dotSum(a, 0) * sc;
        int32 dmins = asum * mn;
        return acc + d * xs * (float32) sumi - dmin * xs * (float32) dmins;
    }

    /** Store up to four reduced column sums for `row` from the calling thread (the two-wave kernel's store). */
    @Device
    static void colsStore4(KernelBuffer<float32> y, uint32 row, uint32 rows, int64 yOff, uint32 yStride,
            uint32 accum, uint32 ncols, float32 t0, float32 t1, float32 t2, float32 t3) {
        if (row < rows) {
            int64 o = yOff + (int64) row;
            int64 st = (int64) yStride;
            if (accum != 0) {
                y[o] = y[o] + t0;
                if (ncols > 1) { y[o + st] = y[o + st] + t1; }
                if (ncols > 2) { y[o + 2L * st] = y[o + 2L * st] + t2; }
                if (ncols > 3) { y[o + 3L * st] = y[o + 3L * st] + t3; }
            } else {
                y[o] = t0;
                if (ncols > 1) { y[o + st] = t1; }
                if (ncols > 2) { y[o + 2L * st] = t2; }
                if (ncols > 3) { y[o + 3L * st] = t3; }
            }
        }
    }

    /** Sub-block `s`'s 6-bit scale from a Q4_K header: words 1 (low scales) and 3 (the packed high
     *  bits); `sh0` selects the chunk's byte pair, `odd` the second sub-block of the pair, `upper`
     *  the sub-blocks 4..7 form. The one-column kernel's decode, one sub-block at a time. */
    @Device
    static int32 q4kSubScale(int32 scw, int32 hiw, int32 sh0, int32 odd, int32 upper) {
        int32 sh = sh0 + 8 * odd;
        int32 sA = (scw >> sh) & 255;
        int32 lo = sA & 63;
        int32 k = (hiw >> sh) & 255;
        int32 hi = (k & 15) | ((sA >> 2) & 48);
        return lo + (hi - lo) * upper;
    }

    /** Sub-block `s`'s 6-bit minimum from a Q4_K header, the twin of {@link #q4kSubScale} on word 2. */
    @Device
    static int32 q4kSubMin(int32 mnw, int32 hiw, int32 sh0, int32 odd, int32 upper) {
        int32 sh = sh0 + 8 * odd;
        int32 mC = (mnw >> sh) & 255;
        int32 lo = mC & 63;
        int32 k = (hiw >> sh) & 255;
        int32 hi = (k >> 4) | ((mC >> 2) & 48);
        return lo + (hi - lo) * upper;
    }

    /** {@link #q6kColAcc} on an activation already loaded. */
    @Device
    static float32 q6kColDot(float32 acc, Vector<int8,4> dvs, Vector<int8,16> a_0,
            Vector<int8,16> a_1, Vector<int8,16> a_2, Vector<int8,16> a_3, Vector<uint8,16> q0, Vector<uint8,16> q1,
            Vector<uint8,16> q2, Vector<uint8,16> q3, int32 s0, int32 s1,
            int32 s2, int32 s3, float32 dsc) {
        Vector<int32,4> z4 = heap Vector<int32,4>(0, 0, 0, 0);
        float32 xs = Cajeta.bitsToF32(((int32) dvs[0] & 255)
            | (((int32) dvs[1] & 255) << 8)
            | (((int32) dvs[2] & 255) << 16)
            | (((int32) dvs[3] & 255) << 24));
        Vector<uint8,16> one = (a_0 ^ a_0).asUnsigned() | 1;
        Vector<int32,4> sv_0 = one.dotAccum(a_0, z4);
        Vector<int32,4> sv_1 = one.dotAccum(a_1, z4);
        Vector<int32,4> sv_2 = one.dotAccum(a_2, z4);
        Vector<int32,4> sv_3 = one.dotAccum(a_3, z4);
        int32 as_0 = sv_0[0] + sv_0[1] + sv_0[2] + sv_0[3];
        int32 as_1 = sv_1[0] + sv_1[1] + sv_1[2] + sv_1[3];
        int32 as_2 = sv_2[0] + sv_2[1] + sv_2[2] + sv_2[3];
        int32 as_3 = sv_3[0] + sv_3[1] + sv_3[2] + sv_3[3];
        float32 d = dsc * xs;
        Vector<int32,4> dv0 = q0.dotAccum(a_0, z4);
        Vector<int32,4> dv1 = q1.dotAccum(a_1, z4);
        Vector<int32,4> dv2 = q2.dotAccum(a_2, z4);
        Vector<int32,4> dv3 = q3.dotAccum(a_3, z4);
        int32 t0 = dv0[0] + dv0[1] + dv0[2] + dv0[3] - 32 * as_0;
        int32 t1 = dv1[0] + dv1[1] + dv1[2] + dv1[3] - 32 * as_1;
        int32 t2 = dv2[0] + dv2[1] + dv2[2] + dv2[3] - 32 * as_2;
        int32 t3 = dv3[0] + dv3[1] + dv3[2] + dv3[3] - 32 * as_3;
        float32 r = acc + d * (float32) (s0 * t0);
        r = r + d * (float32) (s1 * t1);
        r = r + d * (float32) (s2 * t2);
        r = r + d * (float32) (s3 * t3);
        return r;
    }

    /** llm's Q4_K arm `v` (0 two rows, 1 two rows four columns, 2 two-wave group, 3 four rows; 1 to 3 serve up to four columns) with llm's grid. */
    public static void runQ4(int32 v, KernelBuffer<float32> y, KernelBuffer<int8> p, KernelBuffer<int8> xp, int64 rows, int64 bpr,
            int64 ncols, int64 yStride, int64 xpStride, int64 wpb, int64 wv) {
        KernelStream s #= KernelStream.current();
        if (v == 0) {
            q4kQ8WaveR2MatVecColsKernel.launch(s, grid: [(uint32) (((rows + 1L) / 2L + wpb - 1L) / wpb)], block: [(uint32) (wpb * wv)])
                (y, p, xp, (uint32) rows, bpr, 0L, 0, (uint32) ncols, (uint32) yStride, (uint32) xpStride);
        } else if (v == 1) {
            q4kQ8WaveR2C4MatVecColsKernel.launch(s, grid: [(uint32) (((rows + 1L) / 2L + wpb - 1L) / wpb)], block: [(uint32) (wpb * wv)])
                (y, p, xp, (uint32) rows, bpr, 0L, 0, (uint32) ncols, (uint32) yStride, (uint32) xpStride);
        } else if (v == 2) {
            q4kQ8WaveG2MatVecColsKernel.launch(s, grid: [(uint32) ((rows + 1L) / 2L)], block: [64])
                (y, p, xp, (uint32) rows, bpr, 0L, 0, (uint32) ncols, (uint32) yStride, (uint32) xpStride);
        } else {
            q4kQ8WaveR4MatVecColsKernel.launch(s, grid: [(uint32) (((rows + 3L) / 4L + wpb - 1L) / wpb)], block: [(uint32) (wpb * wv)])
                (y, p, xp, (uint32) rows, bpr, 0L, 0, (uint32) ncols, (uint32) yStride, (uint32) xpStride);
        }
    }

    /** llm's Q6_K two-row arm with llm's grid, on its split layout. */
    public static void runQ6(KernelBuffer<float32> y, KernelBuffer<int8> p, KernelBuffer<int8> xp, int64 rows, int64 bpr,
            int64 ncols, int64 yStride, int64 xpStride, int64 wpb, int64 wv) {
        KernelStream s #= KernelStream.current();
        q6kQ8WaveR2MatVecColsKernel.launch(s, grid: [(uint32) (((rows + 1L) / 2L + wpb - 1L) / wpb)], block: [(uint32) (wpb * wv)])
            (y, p, xp, (uint32) rows, bpr, 0L, 0, (uint32) ncols, (uint32) yStride, (uint32) xpStride);
    }
}
