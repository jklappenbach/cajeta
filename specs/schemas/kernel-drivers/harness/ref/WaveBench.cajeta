package ref;

import cajeta.lang.Cajeta;
import cajeta.lang.String;
import cajeta.lang.String;
import cajeta.lang.System;
import cajeta.time.Clock;
import cajeta.xpu.Device;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.ml.kernels.gemm.BlockGemvWave;
import dev.cajeta.ml.kernels.quant.Q2kBlock;
import dev.cajeta.ml.kernels.quant.Q3kBlock;
import dev.cajeta.ml.kernels.quant.Q4kBlock;
import dev.cajeta.ml.kernels.quant.Q5kBlock;
import dev.cajeta.ml.kernels.quant.Q6kBlock;

/** kernel-drivers 9.1.4: the GPU decode driver's members against cajeta-llm's GPU decode kernels, every K format, on the same data. */
public class WaveBench {
    static int64 bitDiff(float32[] a, float32[] b, int64 n) {
        int64 bad = 0L;
        int64 i = 0L;
        while (i < n) { if (Cajeta.f32ToBits(a[i]) != Cajeta.f32ToBits(b[i])) { bad = bad + 1L; } i = i + 1L; }
        return bad;
    }

    static float64 normRel(float32[] a, float32[] b, int64 n) {
        float64 m = 0.0;
        float64 big = 0.0;
        int64 i = 0L;
        while (i < n) {
            float64 d = (float64) a[i] - (float64) b[i];
            if (d < 0.0) { d = 0.0 - d; }
            float64 mag = (float64) a[i];
            if (mag < 0.0) { mag = 0.0 - mag; }
            if (d > m) { m = d; }
            if (mag > big) { big = mag; }
            i = i + 1L;
        }
        return m / (big + 1.0);
    }

    static int64 q4(int64 rows, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        int8[] file #= Bench.weight(rows * bpr);
        int8[] hx #= Bench.acts(bpr);
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) (rows * bpr * 144L));
        wr.upload(file);
        KernelBuffer<int8> wn = heap KernelBuffer<int8>((uint64) (rows * bpr * 144L));
        wn.upload(file);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) rows);
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        KernelStream s #= KernelStream.current();
        float32[] gn #= heap float32[rows];
        int64 bad = 0L;
        float64 worst = 0.0;
        int64 bestRef = 9000000000000L;
        int64 bestDrv = 9000000000000L;
        String bestRefName = "";
        String bestDrvName = "";
        float32[] gr0 #= heap float32[rows];
        {
            int64 waves = (rows + 4L - 1L) / 4L;
            RefWave.run_q4kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr0);
        }
        float32[] gr1 #= heap float32[rows];
        {
            int64 waves = (rows + 4L - 1L) / 4L;
            RefWave.run_q4kQ8WavePfMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr1);
        }
        float32[] gr2 #= heap float32[rows];
        {
            int64 waves = (rows + 2L - 1L) / 2L;
            RefWave.run_q4kQ8WavePf2MatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr2);
        }
        float32[] gr3 #= heap float32[rows];
        {
            int64 waves = (rows + 1L - 1L) / 1L;
            RefWave.run_q4kQ8WavePf1MatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr3);
        }
        {
            BlockGemvWave<Q4kBlock, 1, 0> d = heap BlockGemvWave<Q4kBlock, 1, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <1,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q4kBlock, 2, 0> d = heap BlockGemvWave<Q4kBlock, 2, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <2,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q4kBlock, 4, 0> d = heap BlockGemvWave<Q4kBlock, 4, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            if (WaveBench.bitDiff(gr0, gn, rows) != 0L) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <4,0> not bit-equal to q4kQ8WaveMatVecKernel"); }
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <4,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q4kBlock, 1, 1> d = heap BlockGemvWave<Q4kBlock, 1, 1>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            if (WaveBench.bitDiff(gr3, gn, rows) != 0L) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <1,1> not bit-equal to q4kQ8WavePf1MatVecKernel"); }
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <1,1> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q4kBlock, 2, 1> d = heap BlockGemvWave<Q4kBlock, 2, 1>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            if (WaveBench.bitDiff(gr2, gn, rows) != 0L) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <2,1> not bit-equal to q4kQ8WavePf2MatVecKernel"); }
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <2,1> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q4kBlock, 4, 1> d = heap BlockGemvWave<Q4kBlock, 4, 1>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            if (WaveBench.bitDiff(gr1, gn, rows) != 0L) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <4,1> not bit-equal to q4kQ8WavePfMatVecKernel"); }
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q4_K " + rows + "x" + cols + " <4,1> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        int64[] bestR #= heap int64[4];
        int64[] bestN #= heap int64[6];
        int64 q = 0L;
        while (q < 4L) { bestR[q] = 9000000000000L; q = q + 1L; }
        q = 0L;
        while (q < 6L) { bestN[q] = 9000000000000L; q = q + 1L; }
        BlockGemvWave<Q4kBlock, 1, 0> m0 = heap BlockGemvWave<Q4kBlock, 1, 0>();
        BlockGemvWave<Q4kBlock, 2, 0> m1 = heap BlockGemvWave<Q4kBlock, 2, 0>();
        BlockGemvWave<Q4kBlock, 4, 0> m2 = heap BlockGemvWave<Q4kBlock, 4, 0>();
        BlockGemvWave<Q4kBlock, 1, 1> m3 = heap BlockGemvWave<Q4kBlock, 1, 1>();
        BlockGemvWave<Q4kBlock, 2, 1> m4 = heap BlockGemvWave<Q4kBlock, 2, 1>();
        BlockGemvWave<Q4kBlock, 4, 1> m5 = heap BlockGemvWave<Q4kBlock, 4, 1>();
        int64 round = 0L;
        while (round < 15L) {
            {
                int64 waves = (rows + 4L - 1L) / 4L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q4kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[0L]) { bestR[0L] = (t1 - t0) / reps; }
            }
            {
                int64 waves = (rows + 4L - 1L) / 4L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q4kQ8WavePfMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[1L]) { bestR[1L] = (t1 - t0) / reps; }
            }
            {
                int64 waves = (rows + 2L - 1L) / 2L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q4kQ8WavePf2MatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[2L]) { bestR[2L] = (t1 - t0) / reps; }
            }
            {
                int64 waves = (rows + 1L - 1L) / 1L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q4kQ8WavePf1MatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[3L]) { bestR[3L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m0.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[0L]) { bestN[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m1.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[1L]) { bestN[1L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m2.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[2L]) { bestN[2L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m3.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[3L]) { bestN[3L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m4.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[4L]) { bestN[4L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m5.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[5L]) { bestN[5L] = (t1 - t0) / reps; }
            }
            round = round + 1L;
        }
        if (bestR[0L] < bestRef) { bestRef = bestR[0L]; bestRefName = "q4kQ8WaveMatVecKernel"; }
        if (bestR[1L] < bestRef) { bestRef = bestR[1L]; bestRefName = "q4kQ8WavePfMatVecKernel"; }
        if (bestR[2L] < bestRef) { bestRef = bestR[2L]; bestRefName = "q4kQ8WavePf2MatVecKernel"; }
        if (bestR[3L] < bestRef) { bestRef = bestR[3L]; bestRefName = "q4kQ8WavePf1MatVecKernel"; }
        if (bestN[0L] < bestDrv) { bestDrv = bestN[0L]; bestDrvName = "<1,0>"; }
        if (bestN[1L] < bestDrv) { bestDrv = bestN[1L]; bestDrvName = "<2,0>"; }
        if (bestN[2L] < bestDrv) { bestDrv = bestN[2L]; bestDrvName = "<4,0>"; }
        if (bestN[3L] < bestDrv) { bestDrv = bestN[3L]; bestDrvName = "<1,1>"; }
        if (bestN[4L] < bestDrv) { bestDrv = bestN[4L]; bestDrvName = "<2,1>"; }
        if (bestN[5L] < bestDrv) { bestDrv = bestN[5L]; bestDrvName = "<4,1>"; }
        System.stdout.println("Q4_K " + rows + "x" + cols + " llm " + bestRefName + " " + bestRef + " ns  drv " + bestDrvName + " " + bestDrv
            + " ns  ratio_pct " + (bestDrv * 100L / bestRef) + "  worst normRel " + worst);
        return bad;
    }

    static int64 q5(int64 rows, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        int8[] file #= Bench5.weight(rows * bpr);
        int8[] hx #= Bench5.acts(bpr);
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) (rows * bpr * 176L));
        wr.upload(file);
        KernelBuffer<int8> wn = heap KernelBuffer<int8>((uint64) (rows * bpr * 176L));
        wn.upload(file);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) rows);
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        KernelStream s #= KernelStream.current();
        float32[] gn #= heap float32[rows];
        int64 bad = 0L;
        float64 worst = 0.0;
        int64 bestRef = 9000000000000L;
        int64 bestDrv = 9000000000000L;
        String bestRefName = "";
        String bestDrvName = "";
        float32[] gr0 #= heap float32[rows];
        {
            int64 waves = (rows + 1L - 1L) / 1L;
            RefWave.run_q5kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr0);
        }
        {
            BlockGemvWave<Q5kBlock, 1, 0> d = heap BlockGemvWave<Q5kBlock, 1, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            if (WaveBench.bitDiff(gr0, gn, rows) != 0L) { bad = bad + 1L; System.stdout.println("Q5_K " + rows + "x" + cols + " <1,0> not bit-equal to q5kQ8WaveMatVecKernel"); }
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q5_K " + rows + "x" + cols + " <1,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q5kBlock, 2, 0> d = heap BlockGemvWave<Q5kBlock, 2, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q5_K " + rows + "x" + cols + " <2,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q5kBlock, 4, 0> d = heap BlockGemvWave<Q5kBlock, 4, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q5_K " + rows + "x" + cols + " <4,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        int64[] bestR #= heap int64[1];
        int64[] bestN #= heap int64[3];
        int64 q = 0L;
        while (q < 1L) { bestR[q] = 9000000000000L; q = q + 1L; }
        q = 0L;
        while (q < 3L) { bestN[q] = 9000000000000L; q = q + 1L; }
        BlockGemvWave<Q5kBlock, 1, 0> m0 = heap BlockGemvWave<Q5kBlock, 1, 0>();
        BlockGemvWave<Q5kBlock, 2, 0> m1 = heap BlockGemvWave<Q5kBlock, 2, 0>();
        BlockGemvWave<Q5kBlock, 4, 0> m2 = heap BlockGemvWave<Q5kBlock, 4, 0>();
        int64 round = 0L;
        while (round < 15L) {
            {
                int64 waves = (rows + 1L - 1L) / 1L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q5kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[0L]) { bestR[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m0.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[0L]) { bestN[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m1.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[1L]) { bestN[1L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m2.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[2L]) { bestN[2L] = (t1 - t0) / reps; }
            }
            round = round + 1L;
        }
        if (bestR[0L] < bestRef) { bestRef = bestR[0L]; bestRefName = "q5kQ8WaveMatVecKernel"; }
        if (bestN[0L] < bestDrv) { bestDrv = bestN[0L]; bestDrvName = "<1,0>"; }
        if (bestN[1L] < bestDrv) { bestDrv = bestN[1L]; bestDrvName = "<2,0>"; }
        if (bestN[2L] < bestDrv) { bestDrv = bestN[2L]; bestDrvName = "<4,0>"; }
        System.stdout.println("Q5_K " + rows + "x" + cols + " llm " + bestRefName + " " + bestRef + " ns  drv " + bestDrvName + " " + bestDrv
            + " ns  ratio_pct " + (bestDrv * 100L / bestRef) + "  worst normRel " + worst);
        return bad;
    }

    static int64 q6(int64 rows, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        int8[] file #= Bench6.weight(rows * bpr);
        int8[] hx #= Bench6.acts(bpr);
        int64 prefix = ((bpr * 2L + 3L) / 4L) * 4L;
        int64 resRow = prefix + bpr * 208L;
        int8[] res #= heap int8[rows * resRow];
        int64 rr = 0L;
        while (rr < rows) {
            int64 bq = 0L;
            while (bq < bpr) {
                int64 ro = (rr * bpr + bq) * 210L;
                res[rr * resRow + bq * 2L] = file[ro + 208L];
                res[rr * resRow + bq * 2L + 1L] = file[ro + 209L];
                int64 kk = 0L;
                while (kk < 208L) { res[rr * resRow + prefix + bq * 208L + kk] = file[ro + kk]; kk = kk + 1L; }
                bq = bq + 1L;
            }
            rr = rr + 1L;
        }
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) (rows * resRow));
        wr.upload(res);
        KernelBuffer<int8> wn = heap KernelBuffer<int8>((uint64) (rows * bpr * 210L));
        wn.upload(file);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) rows);
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        KernelStream s #= KernelStream.current();
        float32[] gn #= heap float32[rows];
        int64 bad = 0L;
        float64 worst = 0.0;
        int64 bestRef = 9000000000000L;
        int64 bestDrv = 9000000000000L;
        String bestRefName = "";
        String bestDrvName = "";
        float32[] gr0 #= heap float32[rows];
        {
            int64 waves = (rows + 4L - 1L) / 4L;
            RefWave.run_q6kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr0);
        }
        {
            BlockGemvWave<Q6kBlock, 1, 0> d = heap BlockGemvWave<Q6kBlock, 1, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q6_K " + rows + "x" + cols + " <1,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q6kBlock, 2, 0> d = heap BlockGemvWave<Q6kBlock, 2, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q6_K " + rows + "x" + cols + " <2,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q6kBlock, 4, 0> d = heap BlockGemvWave<Q6kBlock, 4, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q6_K " + rows + "x" + cols + " <4,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        int64[] bestR #= heap int64[1];
        int64[] bestN #= heap int64[3];
        int64 q = 0L;
        while (q < 1L) { bestR[q] = 9000000000000L; q = q + 1L; }
        q = 0L;
        while (q < 3L) { bestN[q] = 9000000000000L; q = q + 1L; }
        BlockGemvWave<Q6kBlock, 1, 0> m0 = heap BlockGemvWave<Q6kBlock, 1, 0>();
        BlockGemvWave<Q6kBlock, 2, 0> m1 = heap BlockGemvWave<Q6kBlock, 2, 0>();
        BlockGemvWave<Q6kBlock, 4, 0> m2 = heap BlockGemvWave<Q6kBlock, 4, 0>();
        int64 round = 0L;
        while (round < 15L) {
            {
                int64 waves = (rows + 4L - 1L) / 4L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q6kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[0L]) { bestR[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m0.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[0L]) { bestN[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m1.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[1L]) { bestN[1L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m2.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[2L]) { bestN[2L] = (t1 - t0) / reps; }
            }
            round = round + 1L;
        }
        if (bestR[0L] < bestRef) { bestRef = bestR[0L]; bestRefName = "q6kQ8WaveMatVecKernel"; }
        if (bestN[0L] < bestDrv) { bestDrv = bestN[0L]; bestDrvName = "<1,0>"; }
        if (bestN[1L] < bestDrv) { bestDrv = bestN[1L]; bestDrvName = "<2,0>"; }
        if (bestN[2L] < bestDrv) { bestDrv = bestN[2L]; bestDrvName = "<4,0>"; }
        System.stdout.println("Q6_K " + rows + "x" + cols + " llm " + bestRefName + " " + bestRef + " ns  drv " + bestDrvName + " " + bestDrv
            + " ns  ratio_pct " + (bestDrv * 100L / bestRef) + "  worst normRel " + worst);
        return bad;
    }

    static int64 q3(int64 rows, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        int8[] file #= Bench3.weight(rows * bpr);
        int8[] hx #= Bench3.acts(bpr);
        int64 prefix = ((bpr * 2L + 3L) / 4L) * 4L;
        int64 resRow = prefix + bpr * 108L;
        int8[] res #= heap int8[rows * resRow];
        int64 rr = 0L;
        while (rr < rows) {
            int64 bq = 0L;
            while (bq < bpr) {
                int64 ro = (rr * bpr + bq) * 110L;
                res[rr * resRow + bq * 2L] = file[ro + 108L];
                res[rr * resRow + bq * 2L + 1L] = file[ro + 109L];
                int64 kk = 0L;
                while (kk < 108L) { res[rr * resRow + prefix + bq * 108L + kk] = file[ro + kk]; kk = kk + 1L; }
                bq = bq + 1L;
            }
            rr = rr + 1L;
        }
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) (rows * resRow));
        wr.upload(res);
        KernelBuffer<int8> wn = heap KernelBuffer<int8>((uint64) (rows * bpr * 110L));
        wn.upload(file);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) rows);
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        KernelStream s #= KernelStream.current();
        float32[] gn #= heap float32[rows];
        int64 bad = 0L;
        float64 worst = 0.0;
        int64 bestRef = 9000000000000L;
        int64 bestDrv = 9000000000000L;
        String bestRefName = "";
        String bestDrvName = "";
        float32[] gr0 #= heap float32[rows];
        {
            int64 waves = (rows + 1L - 1L) / 1L;
            RefWave.run_q3kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr0);
        }
        {
            BlockGemvWave<Q3kBlock, 1, 0> d = heap BlockGemvWave<Q3kBlock, 1, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q3_K " + rows + "x" + cols + " <1,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q3kBlock, 2, 0> d = heap BlockGemvWave<Q3kBlock, 2, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q3_K " + rows + "x" + cols + " <2,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q3kBlock, 4, 0> d = heap BlockGemvWave<Q3kBlock, 4, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q3_K " + rows + "x" + cols + " <4,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        int64[] bestR #= heap int64[1];
        int64[] bestN #= heap int64[3];
        int64 q = 0L;
        while (q < 1L) { bestR[q] = 9000000000000L; q = q + 1L; }
        q = 0L;
        while (q < 3L) { bestN[q] = 9000000000000L; q = q + 1L; }
        BlockGemvWave<Q3kBlock, 1, 0> m0 = heap BlockGemvWave<Q3kBlock, 1, 0>();
        BlockGemvWave<Q3kBlock, 2, 0> m1 = heap BlockGemvWave<Q3kBlock, 2, 0>();
        BlockGemvWave<Q3kBlock, 4, 0> m2 = heap BlockGemvWave<Q3kBlock, 4, 0>();
        int64 round = 0L;
        while (round < 15L) {
            {
                int64 waves = (rows + 1L - 1L) / 1L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q3kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[0L]) { bestR[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m0.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[0L]) { bestN[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m1.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[1L]) { bestN[1L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m2.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[2L]) { bestN[2L] = (t1 - t0) / reps; }
            }
            round = round + 1L;
        }
        if (bestR[0L] < bestRef) { bestRef = bestR[0L]; bestRefName = "q3kQ8WaveMatVecKernel"; }
        if (bestN[0L] < bestDrv) { bestDrv = bestN[0L]; bestDrvName = "<1,0>"; }
        if (bestN[1L] < bestDrv) { bestDrv = bestN[1L]; bestDrvName = "<2,0>"; }
        if (bestN[2L] < bestDrv) { bestDrv = bestN[2L]; bestDrvName = "<4,0>"; }
        System.stdout.println("Q3_K " + rows + "x" + cols + " llm " + bestRefName + " " + bestRef + " ns  drv " + bestDrvName + " " + bestDrv
            + " ns  ratio_pct " + (bestDrv * 100L / bestRef) + "  worst normRel " + worst);
        return bad;
    }

    static int64 q2(int64 rows, int64 cols, int64 reps) {
        int64 bpr = cols / 256L;
        int8[] file #= Bench2.weight(rows * bpr);
        int8[] hx #= Bench2.acts(bpr);
        KernelBuffer<int8> wr = heap KernelBuffer<int8>((uint64) (rows * bpr * 84L));
        wr.upload(file);
        KernelBuffer<int8> wn = heap KernelBuffer<int8>((uint64) (rows * bpr * 84L));
        wn.upload(file);
        KernelBuffer<int8> xp = heap KernelBuffer<int8>((uint64) (bpr * 320L));
        xp.upload(hx);
        KernelBuffer<float32> yr = heap KernelBuffer<float32>((uint64) rows);
        KernelBuffer<float32> yn = heap KernelBuffer<float32>((uint64) rows);
        int64 wv = (int64) Device.waveSize();
        if (wv <= 0L) { wv = 32L; }
        KernelStream s #= KernelStream.current();
        float32[] gn #= heap float32[rows];
        int64 bad = 0L;
        float64 worst = 0.0;
        int64 bestRef = 9000000000000L;
        int64 bestDrv = 9000000000000L;
        String bestRefName = "";
        String bestDrvName = "";
        float32[] gr0 #= heap float32[rows];
        {
            int64 waves = (rows + 1L - 1L) / 1L;
            RefWave.run_q2kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv);
            s.sync();
            yr.download(gr0);
        }
        {
            BlockGemvWave<Q2kBlock, 1, 0> d = heap BlockGemvWave<Q2kBlock, 1, 0>();
