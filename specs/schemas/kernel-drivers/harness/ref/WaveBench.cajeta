            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q2_K " + rows + "x" + cols + " <2,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        {
            BlockGemvWave<Q2kBlock, 4, 0> d = heap BlockGemvWave<Q2kBlock, 4, 0>();
            d.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv);
            s.sync();
            yn.download(gn);
            float64 rel = WaveBench.normRel(gr0, gn, rows);
            if (rel > 0.000001) { bad = bad + 1L; System.stdout.println("Q2_K " + rows + "x" + cols + " <4,0> normRel " + rel); }
            if (rel > worst) { worst = rel; }
        }
        int64[] bestR #= heap int64[1];
        int64[] bestN #= heap int64[3];
        int64 q = 0L;
        while (q < 1L) { bestR[q] = 9000000000000L; q = q + 1L; }
        q = 0L;
        while (q < 3L) { bestN[q] = 9000000000000L; q = q + 1L; }
        BlockGemvWave<Q2kBlock, 1, 0> m0 = heap BlockGemvWave<Q2kBlock, 1, 0>();
        BlockGemvWave<Q2kBlock, 2, 0> m1 = heap BlockGemvWave<Q2kBlock, 2, 0>();
        BlockGemvWave<Q2kBlock, 4, 0> m2 = heap BlockGemvWave<Q2kBlock, 4, 0>();
        int64 round = 0L;
        while (round < 15L) {
            {
                int64 waves = (rows + 1L - 1L) / 1L;
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { RefWave.run_q2kQ8WaveMatVecKernel(yr, wr, xp, (uint32) rows, bpr, waves, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestR[0L]) { bestR[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m0.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[0L]) { bestN[0L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m1.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[1L]) { bestN[1L] = (t1 - t0) / reps; }
            }
            {
                int64 t0 = Clock.nanoTime();
                int64 k = 0L;
                while (k < reps) { m2.runOn(s, yn, wn, xp, rows, cols, 0L, false, 1L, wv); k = k + 1L; }
                s.sync();
                int64 t1 = Clock.nanoTime();
                if ((t1 - t0) / reps < bestN[2L]) { bestN[2L] = (t1 - t0) / reps; }
            }
            round = round + 1L;
        }
        if (bestR[0L] < bestRef) { bestRef = bestR[0L]; bestRefName = "q2kQ8WaveMatVecKernel"; }
        if (bestN[0L] < bestDrv) { bestDrv = bestN[0L]; bestDrvName = "<1,0>"; }
        if (bestN[1L] < bestDrv) { bestDrv = bestN[1L]; bestDrvName = "<2,0>"; }
        if (bestN[2L] < bestDrv) { bestDrv = bestN[2L]; bestDrvName = "<4,0>"; }
        System.stdout.println("Q2_K " + rows + "x" + cols + " llm " + bestRefName + " " + bestRef + " ns  drv " + bestDrvName + " " + bestDrv
            + " ns  ratio_pct " + (bestDrv * 100L / bestRef) + "  worst normRel " + worst);
        return bad;
    }

    public static int32 main() {
        int64 bad = 0L;
        int64[] rs #= heap int64[9];
        int64[] cs #= heap int64[9];
        rs[0] = 1024L; cs[0] = 4096L;
        rs[1] = 4096L; cs[1] = 4096L;
        rs[2] = 14336L; cs[2] = 4096L;
        rs[3] = 4096L; cs[3] = 14336L;
        rs[4] = 1024L; cs[4] = 2560L;
        rs[5] = 2048L; cs[5] = 2560L;
        rs[6] = 2560L; cs[6] = 2048L;
        rs[7] = 10240L; cs[7] = 2560L;
        rs[8] = 2560L; cs[8] = 10240L;
        int64 i = 0L;
        bad = bad + WaveBench.q4(37L, 2304L, 2L);
        i = 0L;
        while (i < 9L) { bad = bad + WaveBench.q4(rs[i], cs[i], 50L); i = i + 1L; }
        bad = bad + WaveBench.q5(37L, 2304L, 2L);
        i = 0L;
        while (i < 9L) { bad = bad + WaveBench.q5(rs[i], cs[i], 50L); i = i + 1L; }
        bad = bad + WaveBench.q6(37L, 2304L, 2L);
        i = 0L;
        while (i < 9L) { bad = bad + WaveBench.q6(rs[i], cs[i], 50L); i = i + 1L; }
        bad = bad + WaveBench.q3(37L, 2304L, 2L);
        i = 0L;
        while (i < 9L) { bad = bad + WaveBench.q3(rs[i], cs[i], 50L); i = i + 1L; }
        bad = bad + WaveBench.q2(37L, 2304L, 2L);
        i = 0L;
        while (i < 9L) { bad = bad + WaveBench.q2(rs[i], cs[i], 50L); i = i + 1L; }
        System.stdout.println(bad == 0L ? "ALL WITHIN" : "OUTSIDE");
        return bad == 0L ? 0 : 1;
    }
}
