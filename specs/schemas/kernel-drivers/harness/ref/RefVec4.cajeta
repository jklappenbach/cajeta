package ref;

import cajeta.lang.Cajeta;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Vector;

/** cajeta-llm's cpu Q4_K prefill kernel, lifted unchanged. */
public final class RefVec4 {
    public RefVec4() { return; }

    @Device
    static void rowsStore(KernelBuffer<float32> y, int64 yi, float32 v, uint32 accum) {
        if (accum != 0) { y[yi] = y[yi] + v; } else { y[yi] = v; }
    }

    /** Rows `r0 .. r0+7` of `v` to `y[yi ..)`, only those below `rows`, set or added. */
    @Device
    static void x8Store(KernelBuffer<float32> y, int64 yi, Vector<float32,8> v, uint32 rows, int64 r0,
            uint32 accum) {
        if (r0 + 8L <= (int64) rows) {
            if (accum != 0) { y.vstore(yi, y.vload<8>(yi) + v); } else { y.vstore(yi, v); }
            return;
        }
        int64 n = (int64) rows - r0;
        if (n > 0L) { RefVec4.rowsStore(y, yi, v[0], accum); }
        if (n > 1L) { RefVec4.rowsStore(y, yi + 1L, v[1], accum); }
        if (n > 2L) { RefVec4.rowsStore(y, yi + 2L, v[2], accum); }
        if (n > 3L) { RefVec4.rowsStore(y, yi + 3L, v[3], accum); }
        if (n > 4L) { RefVec4.rowsStore(y, yi + 4L, v[4], accum); }
        if (n > 5L) { RefVec4.rowsStore(y, yi + 5L, v[5], accum); }
        if (n > 6L) { RefVec4.rowsStore(y, yi + 6L, v[6], accum); }
    }

    @Kernel(targets = {"cpu"})
    @Occupancy(maxThreads = 256)
    public static void q4kQ8X8VecKernel(KernelBuffer<float32> y,
            KernelBuffer<int8> w, KernelBuffer<int8> xp,
            uint32 rows, uint32 groups, uint32 gPad, int64 blocksPerRow, int64 nc, int64 chunk,
            int64 xpStride, int64 yStride, uint32 accum) {
        uint32 gi = KernelThread.globalIdX();
        uint32 gr = gi % gPad;
        int64 cBeg = (int64) (gi / gPad) * chunk;
        if (gr < groups && cBeg < nc) {
            int64 r0 = (int64) gr * 8L;
            int64 cEnd = cBeg + chunk < nc ? cBeg + chunk : nc;
            int64 wg = (int64) gr * blocksPerRow * 1216L;
            Vector<int32,8> z8 = heap Vector<int32,8>(0, 0, 0, 0, 0, 0, 0, 0);
            Vector<float32,8> zf = z8.toF32();
            int64 c = cBeg;
            while (c < cEnd) {
                int64 x0 = c * xpStride;
                Vector<float32,8> acc0 = zf;
                int64 b = 0;
                while (b < blocksPerRow) {
