        KernelStream s #= KernelStream.current();
        q4kQ8X8VecKernel.launch(s, grid: [(uint32) gBlocks], block: [(uint32) block])
            (y, w, xp, (uint32) rows, (uint32) groups, (uint32) (gBlocks * block), blocksPerRow, 1L, 32L,
             xpStride, 1L, accum ? 1 : 0);
    }
}
