                    Vector<uint8,32> lq07 = rq07 & 15;
                    Vector<uint8,32> hq07 = (rq07 >> 4) & 15;
                    Vector<int32,1> wal0g0q7 = xp.vload<4>(x0 + xo + 28L).asWords();
