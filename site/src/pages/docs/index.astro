---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { getPermalink } from '~/utils/permalinks';

type DocFrontmatter = {
  title: string;
  description?: string;
  category?: string;
};

const docModules = import.meta.glob<{ frontmatter: DocFrontmatter }>('./*.md', { eager: true });

const docs = Object.entries(docModules).map(([path, mod]) => {
  const slug = path.replace(/^\.\//, '').replace(/\.md$/, '');
  return {
    slug,
    title: mod.frontmatter.title,
    description: mod.frontmatter.description ?? '',
    category: mod.frontmatter.category ?? 'Reference',
  };
});

const CATEGORY_ORDER = ['Language', 'Stdlib', 'Tooling', 'Process', 'Status', 'Reference'];

const CATEGORY_META: Record<string, { tagline: string; subtitle: string; icon: string }> = {
  Language: {
    tagline: 'Core language',
    subtitle: 'Type system, memory model, error handling, concurrency primitives.',
    icon: 'tabler:code',
  },
  Stdlib: {
    tagline: 'Standard library & first-party packages',
    subtitle: 'Collections, networking, ML, deep learning, reflection.',
    icon: 'tabler:package',
  },
  Tooling: {
    tagline: 'Toolchain',
    subtitle: 'Build, compile, debug, document.',
    icon: 'tabler:tools',
  },
  Process: {
    tagline: 'Project process',
    subtitle: 'How the compiler is tested, harnessed, and linted.',
    icon: 'tabler:checks',
  },
  Status: {
    tagline: 'Implementation status',
    subtitle: 'Where the rollout currently stands.',
    icon: 'tabler:progress',
  },
  Reference: {
    tagline: 'Reference',
    subtitle: 'Additional reference material.',
    icon: 'tabler:book',
  },
};

const grouped = CATEGORY_ORDER
  .map((cat) => ({
    category: cat,
    items: docs
      .filter((d) => d.category === cat)
      .sort((a, b) => a.title.localeCompare(b.title)),
  }))
  .filter((g) => g.items.length > 0);

const metadata = {
  title: 'Documentation',
  description: 'Cajeta language and toolchain documentation.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Cajeta documentation"
    title="The Cajeta language, library, and toolchain"
    subtitle="Specifications and implementation notes for the Cajeta compiler — a hybrid Java/C++/Rust-style language with a single-owner memory model, AoT aspect weaving, and a high-throughput async runtime."
  />

  {grouped.map(({ category, items }) => (
    <Features2
      id={category.toLowerCase()}
      tagline={CATEGORY_META[category].tagline}
      title={category}
      subtitle={CATEGORY_META[category].subtitle}
      columns={2}
      items={items.map((d) => ({
        title: d.title,
        description: d.description,
        icon: CATEGORY_META[category].icon,
        callToAction: {
          text: 'Read',
          href: getPermalink(`/docs/${d.slug}`),
        },
      }))}
    />
  ))}
</Layout>
