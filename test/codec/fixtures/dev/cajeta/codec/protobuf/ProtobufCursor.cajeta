package dev.cajeta.codec.protobuf;

/**
 * Lazy cursor over a protobuf message (Phase 2.2). Builds the structural index
 * once (`ProtobufIndex`), then decodes only the fields you ask for —
 * **projection**: reading two fields of a large message decodes only those two,
 * the rest are skipped (the index already holds every field's bounds, so the
 * skip is pure offset arithmetic). The eager typed bind (2.3) drives this for
 * `Protobuf.parse<T>`.
 *
 * Look up a field by number (`slotOf` / `has`), then decode its value by wire
 * type: `readVarint` (VARINT), `readBytes` (LEN payload), `readFixed32` /
 * `readFixed64` (I32 / I64, little-endian). `slotOf` returns the FIRST
 * occurrence; repeated fields are walked by their successive index slots.
 */
public final class ProtobufCursor {
    int8[] b;
    ProtobufIndex idx;

    public ProtobufCursor(int8[] b, int64 n) {
        this.b = b;
        ProtobufIndex ix = ProtobufIndex.build(b, n);
        this.idx = #ix;
    }

    /** Number of top-level fields. */
    public int32 fieldCount() {
        return this.idx.fieldCount();
    }

    /** Field number of the field at index slot `i`. */
    public int32 fieldNumberAt(int32 i) {
        return this.idx.fieldNumber(i);
    }

    /** Index slot of the FIRST field with number `fnum`, or -1 if absent. */
    public int32 slotOf(int32 fnum) {
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /** True iff the message has at least one field with number `fnum`. */
    public boolean has(int32 fnum) {
        return this.slotOf(fnum) >= 0;
    }

    /** Decode the VARINT value of the field at `slot` as int64. */
    public int64 readVarint(int32 slot) {
        return ProtobufWire.decodeVarint(this.b, this.idx.valueStart(slot));
    }

    /**
     * Decode the VARINT at `slot` as a zigzag-mapped signed value — protobuf
     * `sint32` / `sint64`. Zigzag is a value mapping over wire type VARINT, so
     * nothing on the wire distinguishes it: read the field the way its declared
     * type says, not the way the tag looks.
     */
    public int64 readZigzag(int32 slot) {
        return ProtobufWire.zigzagDecode(
            ProtobufWire.decodeVarint(this.b, this.idx.valueStart(slot)));
    }

    /** Copy the LEN payload bytes of the field at `slot` (caller owns them). */
    public #int8[] readBytes(int32 slot) {
        int8[] bb = this.b;
        int64 s = this.idx.valueStart(slot);
        int64 e = this.idx.valueEnd(slot);
        int32 len = (int32) (e - s);
        int8[] out = heap int8[len];
        int32 k = 0;
        while (k < len) {
            out[k] = bb[s + (int64) k];
            k = k + 1;
        }
        return #out;
    }

    // ---- repeated fields ----
    //
    // A repeated field may arrive in either of two forms, and a conforming
    // reader accepts both no matter which the schema declares: **unpacked** —
    // one tagged record per value — or **packed** — a single LEN record whose
    // payload is the values concatenated with no tags. The readers below walk
    // every slot carrying the field number and expand whichever form each one
    // is, concatenating in wire order. A message may legitimately mix the two.

    /** Number of slots carrying field number `fnum` (one per wire record). */
    public int32 repeatedCount(int32 fnum) {
        int32 n = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    /** Index slot of the `k`-th record carrying `fnum`, or -1 if there is none. */
    public int32 slotOfNth(int32 fnum, int32 k) {
        int32 seen = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                if (seen == k) { return i; }
                seen = seen + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    /**
     * Varints in the packed payload `[s, e)`, counted 16 bytes at a time.
     *
     * Every varint ends with exactly one byte whose continuation bit is clear,
     * so the element count is the number of such bytes — a popcount per block
     * rather than a walk per varint. This is the one part of protobuf that
     * vectorizes: a packed payload is a context-free run, unlike the tag walk,
     * where whether a byte begins a field depends on everything before it.
     *
     * `Vector` has no `splat`, so the 0x80 comparand is a constant array loaded
     * through `vload16`; `eqMask` after an `and` gives the continuation mask.
     *
     * A truncated tail is rejected **here**, not left to the decode pass. It
     * contributes no terminator, so counting would return one element fewer
     * than the walk goes on to produce, and the walk would run off the end of
     * the array it just sized — the array bounds check fires before the decode
     * call that would have raised. Count and walk have to agree on element
     * count for every input either of them accepts.
     *
     * An overlong varint needs no check here: it carries exactly one terminator
     * like any other, so the count stays right and the decode pass raises on it.
     */
    int32 countPackedVarints(int64 s, int64 e) {
        if (e > s) {
            int8 last = this.b[e - (int64) 1];
            if ((((int32) last) & 0x80) != 0) {
                // Walk back to the start of the incomplete varint so the
                // position matches what the scalar path would have reported.
                int64 st = e - (int64) 1;
                int64 floor = e - ProtobufWire.maxVarintBytes();
                if (floor < s) { floor = s; }
                boolean scanning = true;
                while (scanning && st > floor) {
                    int8 prev = this.b[st - (int64) 1];
                    if ((((int32) prev) & 0x80) == 0) {
                        scanning = false;
                    } else {
                        st = st - (int64) 1;
                    }
                }
                throw heap ProtobufParseException(
                    "truncated protobuf varint", st);
            }
        }
        int8[] hi = heap int8[16];
        int32 k = 0;
        while (k < 16) {
            hi[k] = (int8) 0x80;
            k = k + 1;
        }
        Vector<int8,16> hiV = Cajeta.vload16(hi, (int64) 0);

        int32 n = 0;
        int64 p = s;
        while (p + (int64) 16 <= e) {
            Vector<int8,16> v = Cajeta.vload16(this.b, p);
            Vector<int8,16> m = v & hiV;
            int32 cont = m.eqMask((int8) 0x80) & 0xFFFF;
            int32 term = (~cont) & 0xFFFF;
            n = n + (int32) Cajeta.popcount64((int64) term);
            p = p + (int64) 16;
        }
        // Tail: fewer than 16 bytes left, same rule one byte at a time.
        while (p < e) {
            int8 c = this.b[p];
            if ((((int32) c) & 0x80) == 0) { n = n + 1; }
            p = p + 1;
        }
        return n;
    }

    /** How many varint elements a repeated VARINT field yields, both forms. */
    public int32 repeatedVarintCount(int32 fnum) {
        int32 n = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                if (this.idx.wireType(i) == 2) {
                    n = n + this.countPackedVarints(
                        this.idx.valueStart(i), this.idx.valueEnd(i));
                } else {
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        return n;
    }

    /** Every value of a repeated VARINT field, in wire order (either form). */
    public #int64[] readRepeatedVarint(int32 fnum) {
        int32 n = this.repeatedVarintCount(fnum);
        int64[] out = heap int64[n];
        int32 w = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                if (this.idx.wireType(i) == 2) {
                    int64 p = this.idx.valueStart(i);
                    int64 e = this.idx.valueEnd(i);
                    while (p < e) {
                        out[w] = ProtobufWire.decodeVarint(this.b, p, e);
                        p = p + ProtobufWire.varintLen(this.b, p, e);
                        w = w + 1;
                    }
                } else {
                    out[w] = ProtobufWire.decodeVarint(
                        this.b, this.idx.valueStart(i));
                    w = w + 1;
                }
            }
            i = i + 1;
        }
        return #out;
    }

    /** Every value of a repeated zigzag (`sint32`/`sint64`) field. */
    public #int64[] readRepeatedZigzag(int32 fnum) {
        int64[] raw = this.readRepeatedVarint(fnum);
        int32 n = (int32) raw.count();
        int64[] out = heap int64[n];
        int32 i = 0;
        while (i < n) {
            int64 r = raw[i];
            out[i] = ProtobufWire.zigzagDecode(r);
            i = i + 1;
        }
        return #out;
    }

    /**
     * Every value of a repeated I32 field. A packed payload must be a whole
     * number of 4-byte elements — a ragged tail means the writer and reader
     * disagree about the element width, so it is rejected rather than silently
     * dropping the remainder.
     */
    public #int32[] readRepeatedFixed32(int32 fnum) {
        int32 n = this.countFixedElements(fnum, 4);
        int32[] out = heap int32[n];
        int32 w = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                int64 p = this.idx.valueStart(i);
                int64 e = this.idx.valueEnd(i);
                while (p < e) {
                    out[w] = this.fixed32At(p);
                    p = p + (int64) 4;
                    w = w + 1;
                }
            }
            i = i + 1;
        }
        return #out;
    }

    /** Every value of a repeated I64 field; same whole-element rule at 8 bytes. */
    public #int64[] readRepeatedFixed64(int32 fnum) {
        int32 n = this.countFixedElements(fnum, 8);
        int64[] out = heap int64[n];
        int32 w = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                int64 p = this.idx.valueStart(i);
                int64 e = this.idx.valueEnd(i);
                while (p < e) {
                    out[w] = this.fixed64At(p);
                    p = p + (int64) 8;
                    w = w + 1;
                }
            }
            i = i + 1;
        }
        return #out;
    }

    // Element count for a repeated fixed-width field, rejecting a payload that
    // is not a whole multiple of the element width. An unpacked record is
    // exactly one element wide and so divides trivially.
    int32 countFixedElements(int32 fnum, int64 width) {
        int32 n = 0;
        int32 c = this.idx.fieldCount();
        int32 i = 0;
        while (i < c) {
            if (this.idx.fieldNumber(i) == fnum) {
                int64 span = this.idx.valueEnd(i) - this.idx.valueStart(i);
                if (span % width != (int64) 0) {
                    throw heap ProtobufParseException(
                        "packed protobuf payload is not a whole number of "
                        + "fixed-width elements", this.idx.valueStart(i));
                }
                n = n + (int32) (span / width);
            }
            i = i + 1;
        }
        return n;
    }

    // Little-endian fixed32 at an absolute offset.
    int32 fixed32At(int64 pos) {
        int8[] bb = this.b;
        int64 p = pos;
        int32 b0 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b1 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b2 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b3 = ((int32) bb[p]) & 0xFF;
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    // Little-endian fixed64 at an absolute offset.
    int64 fixed64At(int64 pos) {
        int8[] bb = this.b;
        int64 p = pos;
        int64 v = (int64) 0;
        int32 i = 0;
        while (i < 8) {
            int64 byteVal = (int64) (((int32) bb[p]) & 0xFF);
            v = v | (byteVal << (i * 8));
            p = p + 1;
            i = i + 1;
        }
        return v;
    }

    /** Decode the I32 (fixed32) value of the field at `slot`, little-endian. */
    public int32 readFixed32(int32 slot) {
        int8[] bb = this.b;
        int64 p = this.idx.valueStart(slot);
        int32 b0 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b1 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b2 = ((int32) bb[p]) & 0xFF;
        p = p + 1;
        int32 b3 = ((int32) bb[p]) & 0xFF;
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    /** Decode the I64 (fixed64) value of the field at `slot`, little-endian. */
    public int64 readFixed64(int32 slot) {
        int8[] bb = this.b;
        int64 p = this.idx.valueStart(slot);
        int64 v = (int64) 0;
        int32 i = 0;
        while (i < 8) {
            int64 byteVal = (int64) (((int32) bb[p]) & 0xFF);
            v = v | (byteVal << (i * 8));
            p = p + 1;
            i = i + 1;
        }
        return v;
    }
}
