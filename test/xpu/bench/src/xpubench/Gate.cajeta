package xpubench;

import cajeta.collection.ArrayList;
import cajeta.io.file.File;
import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.process.Command;
import cajeta.process.ProcessResult;
import cajeta.time.Clock;
import cajeta.time.Duration;
import cajeta.concurrent.Fiber;
import cajeta.xpu.Scheduler;

/**
 * The idle gate (xpu-tile-scheduling plan 0.1.1): the harness refuses to
 * measure while another `cajeta_test`, bench, or known GPU client is alive.
 * Two concurrent sweeps fake timeouts in both, and a decaying background
 * load has faked a speedup before; a row taken on a busy box is not a row.
 *
 * Split in two so it can be tested both ways: {@link #offenders} is pure
 * (a list of command lines in, the offending ones out) and is what the
 * gtest drives with an injected list; {@link #liveOffenders} reads the real
 * process table through `pgrep -af` and is what the harness calls.
 */
public final class Gate {
    private Gate() { }

    /** Substrings of a command line that mark a process this harness must
     *  not measure beside. Lower-case; matching is case-insensitive. */
    public static #String[] patterns() {
        String[] p = heap String[7];
        p[0] = "cajeta_test";
        p[1] = "xpubench";
        p[2] = "gpuparity";
        p[3] = "schedthroughput";
        p[4] = "llama-bench";
        p[5] = "llama-completion";
        p[6] = "cajeta_llama";
        return p;
    }

    static #String lower(String s) {
        int32 n = s.byteLength();
        int8[] b = heap int8[n];
        int32 i = 0;
        while (i < n) {
            int8 c = s.byteAt(i);
            if (c >= 65 && c <= 90) {
                c = (int8) (c + 32);
            }
            b[i] = c;
            i = i + 1;
        }
        return heap String(#b, n);
    }

    /**
     * Which of `lines` (one `pid command...` line each) name a process the
     * gate refuses to run beside. `selfPid` is excluded so the harness does
     * not refuse itself; lines whose command is `pgrep` are excluded so the
     * probe does not see its own reflection.
     */
    public static #ArrayList<String> offenders(ArrayList<String> lines, int32 selfPid) {
        ArrayList<String> hits = heap ArrayList<String>();
        String[] pats #= Gate.patterns();
        String selfTag = "" + selfPid + " ";
        int32 i = 0;
        while (i < lines.count()) {
            String line = lines.get(i);
            i = i + 1;
            if (line.byteLength() == 0) {
                continue;
            }
            if (line.startsWith(selfTag)) {
                continue;
            }
            String lc #= Gate.lower(line);
            if (lc.contains("pgrep")) {
                continue;
            }
            int32 k = 0;
            boolean hit = false;
            while (k < (int32) pats.count()) {
                if (lc.contains(pats[k])) {
                    hit = true;
                }
                k = k + 1;
            }
            if (hit) {
                hits.add(line);
            }
        }
        return hits;
    }

    /** Split `text` on newlines into an owned list of lines. */
    public static #ArrayList<String> lines(int8[] bytes, int32 len) {
        ArrayList<String> out = heap ArrayList<String>();
        int32 start = 0;
        int32 i = 0;
        while (i <= len) {
            if (i == len || bytes[i] == 10) {
                int32 n = i - start;
                int8[] copy = heap int8[n];
                int32 j = 0;
                while (j < n) {
                    copy[j] = bytes[start + j];
                    j = j + 1;
                }
                out.add(heap String(#copy, n));
                start = i + 1;
            }
            i = i + 1;
        }
        return out;
    }

    /** This process's pid, read from /proc/self. 0 when unreadable. */
    public static int32 selfPid() {
        Path self #= Path.of("/proc/self");
        Path real #= self.canonical();
        String s #= real.name();
        if (s.byteLength() == 0) {
            return 0;
        }
        return Integer.parseInt(s);
    }

    /** Read a whole file through `cat`: procfs and sysfs report a zero size,
     *  so a size-driven read returns nothing for them. */
    public static #String catFile(String path) {
        String[] argv = heap String[2];
        argv[0] = "cat";
        argv[1] = path;
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        cmd.captureStderr();
        ProcessResult r #= cmd.run();
        if (!r.launched() || r.code() != 0) {
            return "" + "";
        }
        int8[] out = r.stdout();
        if (out == null) {
            return "" + "";
        }
        int32 n = (int32) out.count();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = out[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    /** The real process table, filtered: every process pgrep reports whose
     *  NAME matches a pattern, minus this process. Name, not command line:
     *  the shell that launched this harness carries `xpubench` in its own
     *  argument list and is not a competitor for the device. */
    public static #ArrayList<String> liveOffenders() {
        String[] argv = heap String[3];
        argv[0] = "pgrep";
        argv[1] = "-a";
        argv[2] = "cajeta_test|xpubench|gpuparity|[Ss]ched[Tt]hroughput|llama-bench|llama-completion|cajeta_llama";
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        ProcessResult r #= cmd.run();
        if (!r.launched()) {
            // No pgrep: the gate cannot see, and a gate that cannot see
            // reports that rather than passing.
            ArrayList<String> blind = heap ArrayList<String>();
            blind.add("(idle gate blind: pgrep not launchable)");
            return blind;
        }
        int8[] out = r.stdout();
        if (out == null) {
            return heap ArrayList<String>();
        }
        ArrayList<String> ls #= Gate.lines(out, (int32) out.count());
        return Gate.offenders(ls, Gate.selfPid());
    }

    /** The 1-minute load average, advisory only (printed beside the gate). */
    public static #String loadAverage() {
        String s #= Gate.catFile("/proc/loadavg");
        int32 n = s.byteLength();
        if (n == 0) {
            return "" + "?";
        }
        int32 i = 0;
        while (i < n && s.byteAt(i) != 32) {
            i = i + 1;
        }
        return s.substring(0, i);
    }
    // ---- the contention witness (xpu-tile-scheduling 0.1.5) ---------- //
    // A name-based gate cannot see a CPU process streaming memory, and on an
    // APU that traffic cost bandwidth-bound kernels 42% to 55% (report §4
    // T-006). The witness counts foreign CPU busy and other processes' GPU
    // engine time over a window.

    /** Space- and tab-separated tokens of `s`. */
    static #ArrayList<String> tokens(String s) {
        ArrayList<String> out = heap ArrayList<String>();
        int32 n = s.byteLength();
        int32 i = 0;
        while (i < n) {
            while (i < n && (s.byteAt(i) == 32 || s.byteAt(i) == 9)) {
                i = i + 1;
            }
            int32 st = i;
            while (i < n && s.byteAt(i) != 32 && s.byteAt(i) != 9) {
                i = i + 1;
            }
            if (i > st) {
                String t #= s.substring(st, i);
                out.add(#t);
            }
        }
        return out;
    }

    /** Busy and total jiffies from the aggregate `cpu` line of /proc/stat. */
    public static #int64[] statTicks(String line) {
        int64[] t = heap int64[2];
        ArrayList<String> tk #= Gate.tokens(line);
        if (tk.count() < 8) {
            return t;
        }
        int64 steal = 0L;
        if (tk.count() > 8) {
            steal = Long.parseLong(tk.get(8));
        }
        t[0] = Long.parseLong(tk.get(1)) + Long.parseLong(tk.get(2)) + Long.parseLong(tk.get(3))
            + Long.parseLong(tk.get(6)) + Long.parseLong(tk.get(7)) + steal;
        t[1] = t[0] + Long.parseLong(tk.get(4)) + Long.parseLong(tk.get(5));
        return t;
    }

    /** A process's own and waited-for children's jiffies (utime, stime, cutime, cstime) from its /proc/<pid>/stat line. */
    public static int64 procTicks(String line) {
        int32 p = line.byteLength() - 1;
        while (p >= 0 && line.byteAt(p) != 41) {
            p = p - 1;
        }
        if (p < 0) {
            return 0L;
        }
        String rest #= line.substring(p + 1, line.byteLength());
        ArrayList<String> tk #= Gate.tokens(rest);
        if (tk.count() < 15) {
            return 0L;
        }
        return Long.parseLong(tk.get(11)) + Long.parseLong(tk.get(12)) + Long.parseLong(tk.get(13))
            + Long.parseLong(tk.get(14));
    }

    /** The integer after `key` on `line`, or -1 when the key is absent. */
    static int64 valueAfter(String line, String key) {
        int64 at = line.indexOf(key);
        if (at < 0L) {
            return 0L - 1L;
        }
        String rest #= line.substring((int32) at + key.byteLength(), line.byteLength());
        ArrayList<String> tk #= Gate.tokens(rest);
        if (tk.count() == 0) {
            return 0L - 1L;
        }
        return Long.parseLong(tk.get(0));
    }

    /**
     * Graphics plus compute engine ns over DRM fdinfo text, one count per
     * client id, so a client open on several descriptors is counted once.
     */
    public static int64 engineNs(String text) {
        ArrayList<int64> ids = heap ArrayList<int64>();
        ArrayList<int64> gfx = heap ArrayList<int64>();
        ArrayList<int64> comp = heap ArrayList<int64>();
        int8[] b #= text.toBytes();
        ArrayList<String> ls #= Gate.lines(b, (int32) b.count());
        int32 slot = 0 - 1;
        int32 i = 0;
        while (i < ls.count()) {
            String l = ls.get(i);
            i = i + 1;
            int64 id = Gate.valueAfter(l, "drm-client-id:");
            if (id >= 0L) {
                slot = 0 - 1;
                int32 k = 0;
                while (k < ids.count()) {
                    if (ids.get(k) == id) {
                        slot = k;
                    }
                    k = k + 1;
                }
                if (slot < 0) {
                    ids.add(id);
                    gfx.add(0L);
                    comp.add(0L);
                    slot = ids.count() - 1;
                }
                continue;
            }
            int64 g = Gate.valueAfter(l, "drm-engine-gfx:");
            int64 c = Gate.valueAfter(l, "drm-engine-compute:");
            if (g < 0L && c < 0L) {
                continue;
            }
            if (slot < 0) {
                ids.add(0L - 2L - (int64) i);
                gfx.add(0L);
                comp.add(0L);
                slot = ids.count() - 1;
            }
            if (g >= 0L) {
                gfx.set(slot, g);
            }
            if (c >= 0L) {
                comp.set(slot, c);
            }
        }
        int64 sum = 0L;
        int32 j = 0;
        while (j < ids.count()) {
            sum = sum + gfx.get(j) + comp.get(j);
            j = j + 1;
        }
        return sum;
    }

    /** Foreign CPU busy % between two snapshots: busy minus this process's own ticks, over total. */
    public static float64 foreignCpuPct(int64 busy0, int64 total0, int64 self0,
                                        int64 busy1, int64 total1, int64 self1) {
        int64 dt = total1 - total0;
        if (dt <= 0L) {
            return 0.0;
        }
        float64 f = (float64) ((busy1 - busy0) - (self1 - self0)) * 100.0 / (float64) dt;
        if (f < 0.0) {
            return 0.0;
        }
        return f;
    }

    /** True when either foreign figure is over its threshold. */
    public static boolean contended(float64 cpuPct, float64 gpuPct, float64 cpuMax, float64 gpuMax) {
        return cpuPct > cpuMax || gpuPct > gpuMax;
    }

    /**
     * One reading of the box: [cpu busy, cpu total, own ticks, foreign GPU
     * engine ns, foreign KFD processes, monotonic ns, launches the
     * scheduler has seen]. Read through `sh`
     * since procfs files read empty through File.
     */
    public static #int64[] snapshot(int32 selfPid) {
        int64[] s = heap int64[7];
        s[6] = Scheduler.submissionCount();
        String[] argv = heap String[5];
        argv[0] = "sh";
        argv[1] = "-c";
        argv[2] = "head -1 /proc/stat; echo \"@self $(cat /proc/$1/stat)\"; "
            + "grep -sH -E '^drm-(client-id|engine-gfx|engine-compute):' /proc/[0-9]*/fdinfo/* "
            + "| grep -v \"^/proc/$1/\"; n=0; for p in /sys/class/kfd/kfd/proc/*; do "
            + "[ -e \"$p\" ] || continue; [ \"${p##*/}\" = \"$1\" ] && continue; n=$((n+1)); done; "
            + "echo \"@kfd $n\"";
        argv[3] = "sh";
        argv[4] = "" + selfPid;
        Command cmd = heap Command(#argv);
        cmd.captureStdout();
        cmd.captureStderr();
        s[5] = Clock.nanoTime();
        ProcessResult r #= cmd.run();
        if (!r.launched()) {
            return s;
        }
        int8[] out = r.stdout();
        if (out == null) {
            return s;
        }
        int32 n = (int32) out.count();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = out[i];
            i = i + 1;
        }
        String text = heap String(#copy, n);
        int8[] tb #= text.toBytes();
        ArrayList<String> ls #= Gate.lines(tb, (int32) tb.count());
        int32 k = 0;
        while (k < ls.count()) {
            String l = ls.get(k);
            k = k + 1;
            if (l.startsWith("cpu ")) {
                int64[] t #= Gate.statTicks(l);
                s[0] = t[0];
                s[1] = t[1];
            } else if (l.startsWith("@self ")) {
                String rest #= l.substring(6, l.byteLength());
                s[2] = Gate.procTicks(rest);
            } else if (l.startsWith("@kfd ")) {
                s[4] = Gate.valueAfter(l, "@kfd");
            }
        }
        s[3] = Gate.engineNs(text);
        return s;
    }

    /** [foreign CPU %, foreign GPU %, foreign KFD processes, scheduled launches] between two snapshots. */
    public static #float64[] between(int64[] a, int64[] b) {
        float64[] f = heap float64[4];
        f[3] = (float64) (b[6] - a[6]);
        f[0] = Gate.foreignCpuPct(a[0], a[1], a[2], b[0], b[1], b[2]);
        int64 wall = b[5] - a[5];
        if (wall > 0L) {
            float64 g = (float64) (b[3] - a[3]) * 100.0 / (float64) wall;
            if (g < 0.0) {
                g = 0.0;
            }
            f[1] = g;
        }
        f[2] = (float64) b[4];
        return f;
    }

    /** The box over a `ms` window: [foreign CPU %, foreign GPU %, foreign KFD processes]. */
    public static #float64[] window(int32 selfPid, int32 ms) {
        int64[] a #= Gate.snapshot(selfPid);
        Fiber.sleep(Duration.ofMillis((int64) ms));
        int64[] b #= Gate.snapshot(selfPid);
        return Gate.between(a, b);
    }

}
