# Research-paper PDFs are not tracked in git or LFS — each has a sibling
# <name>.pdf.txt (name/description/source url). Binaries stay on disk only.
*.pdf

.idea
.cmake
.ninja_deps
.ninja_log
build/
build-prebuilt/
build-cajeta/
build-release/
build-asan/
run-logs/
run-logs-nd/
run-logs*/
gen/
cajeta.cbp
Makefile
Testing
generated/
*.gch
*.tokens
test-quality/
__pycache__/
# Cajeta compiler output (per-source artifacts from cajetac)
*.cja
*.ll
# Vendored, hand-maintained fp128 soft-float builtin IR (NOT compiler output):
# linked into the embedded runtime bitcode so Apple arm64 (no __float128 /
# compiler-rt tf family) can resolve fp128 conversions. Must stay tracked.
!runtime/native/cajeta_fp128_builtins.ll
*.bc
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# GPU codegen artifacts (per CajetaGPU spec)
*.cubin
*.ptx
*.hsaco
*.spv
*.cajeta-*

.DS_Store

# Build/test run logs (transient diagnostics, never source). All log output
# belongs under logs/ — the dir is kept (.gitkeep), its contents ignored.
*.log
logs/*
!logs/.gitkeep

# Stray build artifacts that appear when cmake is accidentally invoked
# from the repo root or a source subdirectory (instead of /build).
# These are cmake-generated, never source.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
build.ninja
src/CMakeFiles/
src/cmake_install.cmake
src/libcajeta_lib.a
src/cajeta_runtime.bc
src/cajeta_runtime_embedded.cpp
test/CMakeFiles/
test/cmake_install.cmake
test/cajeta_test
test/cajeta_test*_include.cmake
test/cajeta_test*_tests.cmake
.claude/

# Generated cajetadoc API reference — regenerated on demand via `cajeta doc`
/site/docs/cajetadocs/

# Generated cajetadoc review dump (output of cajetadoc-pass.workflow.js)
tools/cajetadoc/flagged.json

# Internal plans / research / design docs — kept LOCAL (in agents/), out of the
# public repository. Specs are PUBLIC (tracked); only plans and the agents/
# working tree stay local.
agents/
*-plan.md

# Machine-specific LLVM toolchain pin (sourced by setup.sh) — local only.
scripts/llvm-env.local.sh
build-three/

# rocprof output artifacts (samples/profile)
samples/profile/.rocprofv3/
.rocprofv3/
tmp/
build-tsan/

# Test-duration metrics for weighted scheduling (cajeta_tests.sh)
.test-durations.tsv

# Per-project `.cajeta/` working directory — ALL of it is generated, never
# authored. Two writers today:
#   - skill-discovery cache: `cajeta search-skill` / `get-skills`
#   - build cache: `cajeta build` incremental state (cache/ir/*.obligations,
#     cache/artifact/<hash>/<binary>, cache-manifest.json)
# tools/mcp is one such workdir.
#
# This rule only helps files that were never committed: gitignore does not
# apply to anything already tracked. Four cache/ir/*.obligations files and a
# cache/artifact/ binary predated it and stayed tracked for months — untracked
# 2026-07-16. If a generated file shows up in `git status` under here again, the
# rule is not broken; something added it with `-f` or via `git add -A` before
# the rule existed. Untrack it (`git rm --cached`), don't add another pattern.
.cajeta/

# Per-plan throwaway regression manifest (template: test/regression_manifest.example.txt)
test/regression_manifest.txt

# Third-party course material — proprietary, local reference only. Never commit.
research/ml/course-material/
