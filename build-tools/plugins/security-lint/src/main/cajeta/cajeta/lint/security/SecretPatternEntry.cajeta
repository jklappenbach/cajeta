package cajeta.lint.security;

/**
 * One typed entry from `config.secret-patterns`.
 *
 * Stored as raw text:
 *
 *   - `id`       — stable slug used as the finding's rule id.
 *                  Operators rely on it for CI's "new findings
 *                  since last build" diff, so it has to stay
 *                  identical across runs even when the pattern's
 *                  details get tightened.
 *   - `pattern`  — regex source. Compiled lazily by
 *                  `SecretPatterns.matcher()` — keeping the raw
 *                  string here lets us preserve it verbatim in
 *                  findings.
 *   - `severity` — "error" | "warning" | "info". Drives the
 *                  finding's severity field directly; the lint
 *                  task decides whether to fail the build based on
 *                  its own `--fail-on-severity` flag.
 */
public class SecretPatternEntry {
    String id;
    String pattern;
    String severity;

    public SecretPatternEntry(String id, String pattern, String severity) {
        this.id       = id;
        this.pattern  = pattern;
        this.severity = severity;
    }

    public String id()       { return this.id;       }
    public String pattern()  { return this.pattern;  }
    public String severity() { return this.severity; }
}
