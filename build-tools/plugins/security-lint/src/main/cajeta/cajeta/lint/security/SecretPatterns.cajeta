package cajeta.lint.security;

import cajeta.buildtool.plugin.ActionContext;
import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.collection.ArrayList;
import cajeta.lint.security.internal.Regex;

/**
 * Parses + matches the secret-patterns list.
 *
 * Each entry compiles to a `Regex` once at parse time so the
 * per-line scan is fast (no per-line compile, no allocation in the
 * hot path). Compilation failures throw `LintConfigException`
 * citing both the array index and the regex error — operators
 * frequently fat-finger character classes, and the error message
 * needs to say *which* pattern was bad.
 */
public class SecretPatterns {

    public class CompiledPattern {
        SecretPatternEntry entry;
        Regex regex;

        public CompiledPattern(SecretPatternEntry entry, Regex regex) {
            this.entry = entry;
            this.regex = regex;
        }
        public SecretPatternEntry entry() { return this.entry; }
        public Regex regex() { return this.regex; }
    }

    ArrayList<CompiledPattern> compiled;

    public SecretPatterns(ArrayList<CompiledPattern> compiled) {
        this.compiled = compiled;
    }

    public int32 count() { return this.compiled.count(); }
    public ArrayList<CompiledPattern> patterns() { return this.compiled; }

    /**
     * Iterate the compiled patterns and yield (entry, matchStart,
     * matchEnd) for every match in `line`. Multiple patterns can
     * match the same line (e.g. an AWS key AND a private-key
     * header on the same row of a fixture); each gets its own
     * finding.
     */
    public class Hit {
        SecretPatternEntry entry;
        int32 startCol;
        int32 endCol;

        public Hit(SecretPatternEntry entry, int32 startCol, int32 endCol) {
            this.entry    = entry;
            this.startCol = startCol;
            this.endCol   = endCol;
        }
        public SecretPatternEntry entry() { return this.entry; }
        public int32 startCol() { return this.startCol; }
        public int32 endCol()   { return this.endCol;   }
    }

    public ArrayList<Hit> scanLine(String line) {
        ArrayList<Hit> hits #= heap ArrayList<Hit>();
        int32 i = 0;
        while (i < this.compiled.count()) {
            CompiledPattern cp = this.compiled.get(i);
            Optional<Regex.Match> m = cp.regex().find(line);
            if (m.isPresent()) {
                hits.add(#heap Hit(cp.entry(),
                                  m.get().start(),
                                  m.get().end()));
            }
            i = i + 1;
        }
        return hits;
    }

    public static SecretPatterns parse(
        ActionContext ctx, JsonArray arr) {
        ArrayList<CompiledPattern> out =
            #heap ArrayList<CompiledPattern>();
        if (arr == null) {
            return #heap SecretPatterns(out);
        }
        int32 i = 0;
        while (i < arr.count()) {
            JsonValue v = arr.get(i);
            if (v.kind() != JsonValue.OBJECT) {
                throw stack LintConfigException(
                    "secret-patterns[" + String.valueOf(i) +
                    "]: entry must be an object {id, pattern, severity}");
            }
            SecretPatternEntry entry = parseTypedEntry(v.asObject(), i);
            Optional<Regex> compiled = Regex.compile(entry.pattern());
            if (compiled.isEmpty()) {
                throw stack LintConfigException(
                    "secret-patterns[" + String.valueOf(i) +
                    "]: regex '" + entry.pattern() +
                    "' failed to compile");
            }
            out.add(#heap CompiledPattern(entry, compiled.get()));
            i = i + 1;
        }
        return #heap SecretPatterns(out);
    }

    static SecretPatternEntry parseTypedEntry(JsonObject obj, int32 idx) {
        String id       = requireString(obj, "id",       idx);
        String pattern  = requireString(obj, "pattern",  idx);
        String severity = optString(obj,    "severity", "warning");
        if (severity != "error" && severity != "warning" &&
            severity != "info") {
            throw stack LintConfigException(
                "secret-patterns[" + String.valueOf(idx) +
                "]: severity '" + severity +
                "' must be one of error / warning / info");
        }
        return #heap SecretPatternEntry(id, pattern, severity);
    }

    static String requireString(JsonObject obj, String key, int32 idx) {
        Optional<String> v = obj.getString(key);
        if (v.isEmpty()) {
            throw stack LintConfigException(
                "secret-patterns[" + String.valueOf(idx) +
                "]: '" + key + "' (string) is required");
        }
        String s = v.get();
        if (s.count() == 0) {
            throw stack LintConfigException(
                "secret-patterns[" + String.valueOf(idx) +
                "]: '" + key + "' must be non-empty");
        }
        return s;
    }

    static String optString(JsonObject obj, String key, String fallback) {
        return obj.getString(key).orElse(fallback);
    }
}
