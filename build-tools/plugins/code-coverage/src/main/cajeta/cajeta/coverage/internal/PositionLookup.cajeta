package cajeta.coverage.internal;

import cajeta.buildtool.plugin.ActionContext;
import cajeta.collection.HashMap;
import cajeta.coverage.CoverageMap;
import cajeta.io.file.File;
import cajeta.io.file.Path;

/**
 * Maps `(file, probe-id) → SourcePosition` by reading the compiler-
 * emitted coverage-map sidecars.
 *
 * One sidecar per source file, written next to the artifact at
 * `<artifact>.coverage-map/<source-path-encoded>.cmap`. Format
 * (binary, big-endian):
 *
 *   magic    : "CJCM"        (4 bytes)
 *   version  : u16           (currently 1)
 *   grain    : u8            (0=line, 1=branch, 2=region)
 *   reserved : u8
 *   nProbes  : u32
 *   for each probe:
 *       probe_id     : u32
 *       start_line   : u32
 *       start_column : u32
 *       end_line     : u32
 *       end_column   : u32
 *
 * Loaded lazily per-file: the report action's hot path is "for every
 * probe in this file, look up its position" — sequential, so we read
 * the whole file's table on first touch and cache it.
 */
public class PositionLookup {

    // path → (probe-id → position).
    HashMap<String, HashMap<int32, SourcePosition>> tables;
    ActionContext ctx;
    // The "no position" sentinel handed out on any miss — one owned
    // instance so `lookup` can always return a borrow.
    SourcePosition zero;

    PositionLookup(ActionContext ctx) {
        this.ctx = ctx;
        this.tables = heap HashMap<String, HashMap<int32, SourcePosition>>();
        this.zero #= heap SourcePosition(0, 0, 0, 0);
    }

    /**
     * Build an empty lookup. Sidecars are loaded lazily on the first
     * `.lookup(file, probe)` per file.
     */
    public static #PositionLookup load(ActionContext ctx, CoverageMap map) {
        return heap PositionLookup(ctx);
    }

    /**
     * Position for `(file, probeId)`. Returns the zero sentinel
     * (`line() == 0`) when the sidecar is missing — findings still
     * surface, they just lack a position citation.
     */
    public SourcePosition lookup(String file, int32 probeId) {
        Optional<HashMap<int32, SourcePosition>> existing =
            this.tables.get(file);
        if (existing.isEmpty()) {
            HashMap<int32, SourcePosition> fresh #= this.loadSidecar(file);
            this.tables.put(
                file.substring(0, (int32) file.count()), #fresh);
            existing = this.tables.get(file);
        }
        HashMap<int32, SourcePosition> table = existing.get();
        Optional<SourcePosition> pos = table.get(probeId);
        if (pos.isPresent()) {
            return pos.get();
        }
        return this.zero;
    }

    #HashMap<int32, SourcePosition> loadSidecar(String file) {
        HashMap<int32, SourcePosition> out #=
            heap HashMap<int32, SourcePosition>();
        Path sidecar = this.sidecarPathFor(file);
        if (!sidecar.isFile()) {
            return #out;
        }
        int8[] b = File.readAllBytes(sidecar.toString());
        int32 total = (int32) b.count();
        if (total < 12
                || ByteBuf.u8(b, 0) != 67 || ByteBuf.u8(b, 1) != 74
                || ByteBuf.u8(b, 2) != 67 || ByteBuf.u8(b, 3) != 77
                || ByteBuf.u16(b, 4) != 1) {
            // Missing/foreign sidecar → empty table; probes resolve to
            // the zero sentinel.
            return #out;
        }
        int32 nProbes = ByteBuf.u32(b, 8);
        int32 off = 12;
        int32 i = 0;
        while (i < nProbes && off + 20 <= total) {
            int32 pid = ByteBuf.u32(b, off);
            out.put(pid, heap SourcePosition(
                ByteBuf.u32(b, off + 4),  ByteBuf.u32(b, off + 8),
                ByteBuf.u32(b, off + 12), ByteBuf.u32(b, off + 16)));
            off = off + 20;
            i = i + 1;
        }
        return #out;
    }

    #Path sidecarPathFor(String file) {
        // Same encoding the compiler uses: source-path with `/` and
        // `:` replaced by `_`, suffixed `.cmap`. See compile-side
        // `CoverageMapEmitter::sidecarPathFor`.
        String encoded = file.replace("/", "_").replace(":", "_");
        return Path.of(this.ctx.workdir() + "/build/archive/" +
                       this.ctx.projectName() + "-" +
                       this.ctx.projectVersion() + ".cja.coverage-map/" +
                       encoded + ".cmap");
    }

    /**
     * Package name for a file (e.g. `com.example.foo` for
     * `src/main/cajeta/com/example/foo/Bar.cajeta`). Read from the
     * sidecar's header; falls back to the empty string when the
     * sidecar is missing, in which case package-kind excludes
     * simply don't match for this file.
     */
    public String packageFor(String file) {
        // TODO: read from the sidecar's header block once the format
        // grows a `package` string between `nProbes` and the first
        // probe record; empty keeps the ExcludeMatcher's package kind
        // a no-op rather than a wrong-match.
        return "";
    }

    /**
     * Qualified symbol name for `(file, probeId)` — the fully-
     * qualified declaration the probe lives inside. Same posture as
     * `packageFor`: empty until the sidecar format carries symbols.
     */
    public String symbolFor(String file, int32 probeId) {
        return "";
    }
}
