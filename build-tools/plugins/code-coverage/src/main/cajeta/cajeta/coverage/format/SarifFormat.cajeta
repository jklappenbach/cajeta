package cajeta.coverage.format;

import cajeta.buildtool.plugin.Finding;
import cajeta.collection.ArrayList;
import cajeta.coverage.CoverageMap;
import cajeta.io.file.File;
import cajeta.io.file.OpenMode;
import cajeta.io.file.FileWriter;
import cajeta.io.file.Path;

/**
 * SARIF 2.1.0 output (`coverage.sarif`). Spec:
 *   https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html
 *
 * SARIF was designed for static analyzers, not coverage tools, but
 * GitHub Code Scanning, Azure DevOps, and several IDE extensions
 * standardized on it for any tool that wants to land annotations on
 * a PR. Emitting findings as SARIF gets cajeta.coverage into those
 * surfaces for free — uncovered lines show up as inline PR comments
 * the same way a lint warning would.
 *
 * We emit a single `run` with one `tool` block and one `result`
 * per Finding. Severity is mapped:
 *   - severity == "error"   → SARIF `level: error`
 *   - severity == "warning" → SARIF `level: warning`
 *   - severity == "info"    → SARIF `level: note`  (cajeta.coverage
 *     emits all uncovered probes as `note` — uncovered code is a
 *     signal, not a bug, and PR reviewers want the choice of whether
 *     to act on it).
 */
public class SarifFormat {

    public static #String emit(
        Path outputDir, CoverageMap map, ArrayList<Finding> findings) {
        Path out = outputDir.resolve("coverage.sarif");
        FileWriter w = File.openWrite((out).toString(), OpenMode.WRITE);

        // Hand-built so we stay independent of a JSON-writer stdlib
        // surface that's still in flux. SARIF's required fields are
        // few enough that the structure stays readable.
        w.writeString("{\n");
        w.writeString("  \"version\": \"2.1.0\",\n");
        w.writeString("  \"$schema\": \"https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json\",\n");
        w.writeString("  \"runs\": [{\n");
        w.writeString("    \"tool\": {\n");
        w.writeString("      \"driver\": {\n");
        w.writeString("        \"name\": \"cajeta.coverage\",\n");
        w.writeString("        \"version\": \"1.0.0\",\n");
        w.writeString("        \"informationUri\": \"https://cajeta.org/plugins/coverage\",\n");
        w.writeString("        \"rules\": [{\n");
        w.writeString("          \"id\": \"uncovered\",\n");
        w.writeString("          \"name\": \"UncoveredCode\",\n");
        w.writeString("          \"shortDescription\": { \"text\": \"Code not exercised by tests.\" },\n");
        w.writeString("          \"defaultConfiguration\": { \"level\": \"note\" }\n");
        w.writeString("        }]\n");
        w.writeString("      }\n");
        w.writeString("    },\n");
        w.writeString("    \"results\": [\n");
        int32 i = 0;
        while (i < findings.count()) {
            Finding f = findings.get(i);
            if (i > 0) { w.writeString(",\n"); }
            w.writeString("      {\n");
            w.writeString("        \"ruleId\": \"" + escape(f.rule()) + "\",\n");
            w.writeString("        \"level\": \"" + sarifLevel(f.severity().toName()) + "\",\n");
            w.writeString("        \"message\": { \"text\": \"" + escape(f.message()) + "\" },\n");
            w.writeString("        \"locations\": [{\n");
            w.writeString("          \"physicalLocation\": {\n");
            w.writeString("            \"artifactLocation\": { \"uri\": \"" + escape(f.file()) + "\" },\n");
            w.writeString("            \"region\": { \"startLine\": " +
                       String.valueOf(f.line()) + " }\n");
            w.writeString("          }\n");
            w.writeString("        }]\n");
            w.writeString("      }");
            i = i + 1;
        }
        w.writeString("\n    ]\n");
        w.writeString("  }]\n");
        w.writeString("}\n");
        w.close();
        return out.toString();
    }

    static String sarifLevel(String severity) {
        if (severity == "error")   { return "error";   }
        if (severity == "warning") { return "warning"; }
        return "note";
    }

    /**
     * JSON string escape. v1 covers the cases coverage actually
     * produces (file paths, rule names, single-line messages).
     * General-purpose JSON output goes through
     * `cajeta.codec.json.JsonWriter` once stabilized.
     */
    static #String escape(String s) {
        StringBuilder b = stack StringBuilder();
        int32 i = 0;
        while (i < s.count()) {
            char c = s.charAt(i);
            if (c == '\\') { b.append("\\\\"); }
            else if (c == '"') { b.append("\\\""); }
            else if (c == '\n') { b.append("\\n"); }
            else if (c == '\r') { b.append("\\r"); }
            else if (c == '\t') { b.append("\\t"); }
            else { b.append(s.substring(i, i + 1)); }
            i = i + 1;
        }
        return b.toString();
    }
}
