package cajeta.coverage.internal;

import cajeta.collection.ArrayList;
import cajeta.coverage.CoverageMap;
import cajeta.lang.stream.Stream;

/**
 * Bottom-N file selection + citation formatting. Pulled out so the
 * Report action's threshold-gate path and console renderer agree on
 * which files to surface (and how to format them).
 *
 * "Bottom-N by coverage" is a partial sort — we only need the lowest
 * `n`, not a full ordering. v1 uses an insertion-sorted bucket swept
 * across all entries (`O(files * n)`); good enough for any plausible
 * project size.
 *
 * Buckets hold OWNED `FilteredCounts.FilteredEntry` snapshots (path
 * copy + counts, no probe bitset): an owning `ArrayList` cannot hold
 * borrows of the map's entries, and the snapshot is what both gate
 * messages and the console section need anyway.
 */
public class BottomN {

    /**
     * Pick the `n` files with the lowest percentage, ascending.
     * Returns fewer than `n` when the map has fewer files. Ties are
     * broken by lexicographic file path so the output is
     * deterministic across runs (matters for CI logs).
     */
    public static #ArrayList<FilteredCounts.FilteredEntry> select(
        CoverageMap map, int32 n) {
        ArrayList<FilteredCounts.FilteredEntry> result =
            heap ArrayList<FilteredCounts.FilteredEntry>();
        Stream<String> paths = map.files().keys();
        Optional<String> cur = paths.next();
        while (cur.isPresent()) {
            Optional<CoverageMap.FileEntry> eOpt = map.files().get(cur.get());
            CoverageMap.FileEntry e = eOpt.get();
            insertSortedAsc(result, snap(e), n);
            cur = paths.next();
        }
        return #result;
    }

    /**
     * All files strictly below `floorPercent`, ascending by percentage.
     * Used by the `min-per-file` gate.
     */
    public static #ArrayList<FilteredCounts.FilteredEntry> filesBelow(
        CoverageMap map, int32 floorPercent) {
        ArrayList<FilteredCounts.FilteredEntry> result =
            heap ArrayList<FilteredCounts.FilteredEntry>();
        Stream<String> paths = map.files().keys();
        Optional<String> cur = paths.next();
        while (cur.isPresent()) {
            Optional<CoverageMap.FileEntry> eOpt = map.files().get(cur.get());
            CoverageMap.FileEntry e = eOpt.get();
            if (e.percent() < floorPercent) {
                insertSortedAsc(result, snap(e), result.count() + 1);
            }
            cur = paths.next();
        }
        return #result;
    }

    /** Same citation as `FilteredCounts.cite` — one implementation. */
    public static #String cite(ArrayList<FilteredCounts.FilteredEntry> files) {
        return FilteredCounts.cite(files);
    }

    // Owned lightweight snapshot for the buckets: path copy + counts.
    static #FilteredCounts.FilteredEntry snap(CoverageMap.FileEntry e) {
        String p = e.path();
        FilteredCounts.FilteredEntry c #= heap FilteredCounts.FilteredEntry(
            p.substring(0, (int32) p.count()));
        c.totalProbes = e.totalProbes();
        c.hitProbes = e.hitProbes();
        return #c;
    }

    // Insert `e` in ascending percent order, truncating to capacity `n`.
    // Consumes `e`: a not-inserted entry drops with the formal; a
    // truncated-out entry drops when the discarded removeAt fires.
    static void insertSortedAsc(
        ArrayList<FilteredCounts.FilteredEntry> bucket,
        #FilteredCounts.FilteredEntry e,
        int32 n) {
        // Trivially full and worse than the current worst → drop.
        if (bucket.count() >= n &&
            e.percent() >= bucket.get(bucket.count() - 1).percent()) {
            return;
        }
        // Linear scan to find the insertion point. Stable on equal
        // percents (uses path order for deterministic tie-break).
        int32 i = 0;
        while (i < bucket.count()) {
            FilteredCounts.FilteredEntry cur = bucket.get(i);
            if (e.percent() < cur.percent()) { break; }
            if (e.percent() == cur.percent() &&
                e.path().compareTo(cur.path()) < 0) {
                break;
            }
            i = i + 1;
        }
        bucket.insert(i, #e);
        while (bucket.count() > n) {
            bucket.removeAt(bucket.count() - 1);
        }
    }
}
