package cajeta.coverage;

import cajeta.buildtool.plugin.ActionContext;
import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.collection.ArrayList;
import cajeta.collection.HashSet;

/**
 * Parse `plugins.cajeta.coverage.config.exclude` into a list of
 * typed `Exclude` records.
 *
 * Two on-disk shapes for each entry:
 *
 *   1. Typed object:  `{ "kind": "<k>", "pattern": "<p>", "reason": "<r>" }`
 *   2. Back-compat:   `"<glob>"`  → treated as `kind=FILE`,
 *                                   `pattern=<glob>`, `reason=""`.
 *      Emits a one-time warning per parse, pointing the author at
 *      the typed form. We don't auto-migrate — the warning gives
 *      the consumer time to land the change in the PR they choose.
 *
 * Validation:
 *   - `kind` must parse via `ExcludeKind.parse`.
 *   - `pattern` must be non-empty.
 *   - `reason` must be non-empty AND non-generic (the discipline
 *     that earned the typed-shape redesign — see plan/coverage-
 *     exclude-and-cli.md "Generic-reason list").
 *
 * Bad entries surface as exceptions with a citation describing the
 * offending index in the source array so the author can find it
 * fast.
 */
public class ExcludeParser {

    /**
     * Generic-reason blocklist. Matches the CLI's blocklist in
     * `cajeta coverage ignore` — keeping the two in sync is the
     * design's guarantee that a reason rejected at the CLI also
     * fails at parse time. (The CLI is defense-in-depth; this is
     * the spec.)
     */
    static final String[] GENERIC_REASONS = [
        "wip", "todo", "skip", "fixme", "tbd"
    ];

    /**
     * Parse the array. `ctx` is used only for warning emission (the
     * back-compat path); failures throw `ExcludeConfigException`.
     */
    public static ArrayList<Exclude> parse(
        ActionContext ctx, JsonArray excludeArr) {
        ArrayList<Exclude> out #= heap ArrayList<Exclude>();
        if (excludeArr == null) {
            return out;
        }
        int32 backCompatCount = 0;
        int32 i = 0;
        while (i < excludeArr.count()) {
            JsonValue entry = excludeArr.get(i);
            if (entry.kind() == JsonValue.OBJECT) {
                out.add(#parseTypedEntry(entry.asObject(), i));
            } else if (entry.kind() == JsonValue.STRING) {
                // Back-compat: bare string is implicitly file-kind.
                String pat = entry.asString();
                if (pat.count() == 0) {
                    throw stack ExcludeConfigException(
                        "exclude[" + String.valueOf(i) +
                        "]: empty string entry");
                }
                out.add(#heap Exclude(ExcludeKind.FILE, pat, ""));
                backCompatCount = backCompatCount + 1;
            } else {
                throw stack ExcludeConfigException(
                    "exclude[" + String.valueOf(i) +
                    "]: entry must be an object (typed form) or " +
                    "a string (legacy file-glob)");
            }
            i = i + 1;
        }
        if (backCompatCount > 0) {
            ctx.warn(
                "cajeta.coverage: " + String.valueOf(backCompatCount) +
                " legacy string-form exclude(s) — migrate to typed " +
                "form { \"kind\": \"file\", \"pattern\": \"...\", " +
                "\"reason\": \"...\" } so the reason shows up on " +
                "future PR diffs");
        }
        return out;
    }

    static Exclude parseTypedEntry(JsonObject obj, int32 idx) {
        String kindStr    = requireString(obj, "kind",    idx);
        String pattern    = requireString(obj, "pattern", idx);
        String reason     = requireString(obj, "reason",  idx);

        Optional<ExcludeKind> maybeKind = ExcludeKind.parse(kindStr);
        if (maybeKind.isEmpty()) {
            throw stack ExcludeConfigException(
                "exclude[" + String.valueOf(idx) +
                "]: unknown kind '" + kindStr +
                "' (expected one of: file, package, symbol)");
        }
        if (pattern.count() == 0) {
            throw stack ExcludeConfigException(
                "exclude[" + String.valueOf(idx) +
                "]: pattern must be non-empty");
        }
        if (isGeneric(reason)) {
            throw stack ExcludeConfigException(
                "exclude[" + String.valueOf(idx) +
                "]: '" + reason + "' is too generic; provide a " +
                "specific justification (the reason shows up on " +
                "every PR diff)");
        }
        return #heap Exclude(maybeKind.get(), pattern, reason);
    }

    static String requireString(JsonObject obj, String key, int32 idx) {
        Optional<String> v = obj.getString(key);
        if (v.isEmpty()) {
            if (!obj.containsKey(key)) {
                throw stack ExcludeConfigException(
                    "exclude[" + String.valueOf(idx) +
                    "]: missing required '" + key + "'");
            }
            throw stack ExcludeConfigException(
                "exclude[" + String.valueOf(idx) +
                "]: '" + key + "' must be a string");
        }
        return v.get();
    }

    /**
     * Generic-reason check. Lowercase + whitespace-trimmed +
     * exact-match against the blocklist. Same predicate as the
     * CLI's `isGenericCoverageReason` — kept here as the canonical
     * implementation.
     */
    public static boolean isGeneric(String reason) {
        String trimmed = reason.trim().toLowerCase();
        if (trimmed.count() == 0) { return true; }
        int32 i = 0;
        while (i < GENERIC_REASONS.count) {
            if (trimmed == GENERIC_REASONS[i]) { return true; }
            i = i + 1;
        }
        return false;
    }
}
