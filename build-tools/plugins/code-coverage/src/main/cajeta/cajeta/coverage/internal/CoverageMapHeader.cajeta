package cajeta.coverage.internal;

import cajeta.io.file.File;
import cajeta.io.file.Path;

/**
 * Header-only inspection of a compiler-emitted coverage-map sidecar
 * ("CJCM"): magic(4) version:u16 grain:u8 reserved:u8 nProbes:u32.
 * Used by the `cajeta.coverage.instrument` action to surface
 * `probe-count` without paying for a full sidecar load, and by the
 * merger for per-file probe totals.
 */
public class CoverageMapHeader {

    /**
     * Probe-count from the sidecar header. Returns 0 when the file
     * is missing or malformed — `instrument` treats missing telemetry
     * as a soft failure (the build succeeded; we just couldn't count
     * probes).
     */
    public static int32 readProbeCount(Path path) {
        if (!path.isFile()) {
            return 0;
        }
        int8[] b = File.readAllBytes(path.toString());
        if (b.count() < 12) {
            return 0;
        }
        // magic "CJCM"
        if (ByteBuf.u8(b, 0) != 67 || ByteBuf.u8(b, 1) != 74
                || ByteBuf.u8(b, 2) != 67 || ByteBuf.u8(b, 3) != 77) {
            return 0;
        }
        if (ByteBuf.u16(b, 4) != 1) {
            return 0;
        }
        // bytes 6 (grain) and 7 (reserved) are skipped.
        return ByteBuf.u32(b, 8);
    }
}
