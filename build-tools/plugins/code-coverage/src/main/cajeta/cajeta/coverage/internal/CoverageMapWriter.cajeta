package cajeta.coverage.internal;

import cajeta.coverage.CoverageMap;
import cajeta.coverage.Grain;
import cajeta.io.file.File;
import cajeta.io.file.Path;
import cajeta.lang.stream.Stream;

/**
 * Write the merged `CoverageMap` to disk.
 *
 * On-disk format (binary, big-endian) — kept stable; the reader
 * rejects unknown versions so a future schema change can't silently
 * corrupt a CI run's gate:
 *
 *   magic        : "CJCV"   (4 bytes)
 *   version      : u16      (currently 1)
 *   grain        : u8       (0=line, 1=branch, 2=region)
 *   reserved     : u8
 *   nFiles       : u32
 *   for each file:
 *       pathLen      : u32
 *       path         : utf-8 bytes
 *       totalProbes  : u32
 *       hitProbes    : u32
 *       covered      : bitset of totalProbes bits, byte-packed
 *
 * The format is internal to the plugin — the consumer's contract is
 * with the `cajeta.coverage.report` action's outputs/findings, not
 * with the on-disk shape.
 */
public class CoverageMapWriter {

    /**
     * Write `map` to `path` — packed into one `ByteBuf`, flushed with
     * a single `writeAllBytes`. Parent directories must exist (the
     * caller creates them — see `Collect.run`).
     */
    public static void write(Path path, CoverageMap map) {
        ByteBuf out = heap ByteBuf(4096);
        out.putString("CJCV");
        out.putU16BE(1);
        out.putU8(grainToByte(map.grain()));
        out.putU8(0);  // reserved
        out.putU32BE((int32) map.files().count());
        Stream<String> paths = map.files().keys();
        Optional<String> cur = paths.next();
        while (cur.isPresent()) {
            String fpath = cur.get();
            Optional<CoverageMap.FileEntry> eOpt = map.files().get(fpath);
            CoverageMap.FileEntry e = eOpt.get();
            out.putU32BE(fpath.byteLength());
            out.putString(fpath);
            out.putU32BE(e.totalProbes());
            out.putU32BE(e.hitProbes());
            putBitset(out, e);
            cur = paths.next();
        }
        File.writeAllBytes(path.toString(), out.data, out.len);
    }

    static int32 grainToByte(Grain g) {
        if (g == Grain.LINE)   { return 0; }
        if (g == Grain.BRANCH) { return 1; }
        return 2;
    }

    static void putBitset(ByteBuf out, CoverageMap.FileEntry e) {
        int32 nBytes = (e.totalProbes() + 7) / 8;
        int8[] packed = heap int8[nBytes];
        int32 pid = 0;
        while (pid < e.totalProbes()) {
            if (e.wasHit(pid)) {
                int32 byteIdx = pid / 8;
                int32 bitIdx  = pid - (byteIdx * 8);
                packed[byteIdx] = (int8) (packed[byteIdx] | (1 << bitIdx));
            }
            pid = pid + 1;
        }
        out.putRaw(packed, nBytes);
    }
}
