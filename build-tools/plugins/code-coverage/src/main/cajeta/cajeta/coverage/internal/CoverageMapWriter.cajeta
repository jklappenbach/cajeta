package cajeta.coverage.internal;

import cajeta.collection.ArrayList;
import cajeta.coverage.CoverageMap;
import cajeta.coverage.Grain;
import cajeta.io.file.FileReader;
import cajeta.io.file.FileWriter;
import cajeta.io.file.Path;

/**
 * Read/write the merged `CoverageMap` to disk.
 *
 * On-disk format (binary, big-endian) — kept stable; reader rejects
 * unknown versions so a future schema change can't silently corrupt
 * a CI run's gate:
 *
 *   magic        : "CJCV"   (4 bytes)
 *   version      : u16      (currently 1)
 *   grain        : u8       (0=line, 1=branch, 2=region)
 *   reserved     : u8
 *   nFiles       : u32
 *   for each file:
 *       pathLen      : u32
 *       path         : utf-8 bytes
 *       totalProbes  : u32
 *       hitProbes    : u32
 *       covered      : bitset of totalProbes bits, byte-packed
 *
 * The format is internal to the plugin — the consumer's contract is
 * with the `cajeta.coverage.report` action's outputs/findings, not
 * with the on-disk shape. We're free to bump the version when the
 * plugin's own schema needs to grow.
 */
public class CoverageMapWriter {

    /**
     * Write `map` to `path`. Parent directories must exist (the
     * caller creates them — see `Collect.run`).
     */
    public static void write(Path path, CoverageMap map) {
        FileWriter w = FileWriter.openTruncate(path);
        // Header
        w.writeBytes("CJCV".bytes());
        w.writeU16BE(1);
        w.writeU8(grainToByte(map.grain()));
        w.writeU8(0);  // reserved
        ArrayList<String> paths = map.files().keys();
        w.writeU32BE(paths.count());
        // Files
        int32 i = 0;
        while (i < paths.count()) {
            String fpath = paths.get(i);
            CoverageMap.FileEntry e = map.files().get(fpath).get();
            byte[] pathBytes = fpath.bytes();
            w.writeU32BE(pathBytes.count);
            w.writeBytes(pathBytes);
            w.writeU32BE(e.totalProbes());
            w.writeU32BE(e.hitProbes());
            writeBitset(w, e);
            i = i + 1;
        }
        w.close();
    }

    static int32 grainToByte(Grain g) {
        if (g == Grain.LINE)   { return 0; }
        if (g == Grain.BRANCH) { return 1; }
        return 2;
    }

    static void writeBitset(FileWriter w, CoverageMap.FileEntry e) {
        int32 nBytes = (e.totalProbes() + 7) / 8;
        byte[] packed #= heap byte[nBytes];
        int32 pid = 0;
        while (pid < e.totalProbes()) {
            if (e.wasHit(pid)) {
                int32 byteIdx = pid / 8;
                int32 bitIdx  = pid - (byteIdx * 8);
                packed[byteIdx] = packed[byteIdx] | (1 << bitIdx);
            }
            pid = pid + 1;
        }
        w.writeBytes(packed);
    }
}
