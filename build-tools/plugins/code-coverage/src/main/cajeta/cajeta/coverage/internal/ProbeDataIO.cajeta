package cajeta.coverage.internal;

import cajeta.buildtool.plugin.ActionContext;
import cajeta.coverage.CoverageMap;
import cajeta.coverage.Grain;
import cajeta.coverage.ProbeData;
import cajeta.collection.HashMap;
import cajeta.io.file.File;
import cajeta.io.file.Path;
import cajeta.lang.stream.Stream;

/**
 * Reader + merger for raw per-test probe-data dumps.
 *
 * Format (text — chosen for ease of debugging an individual test's
 * dump from the shell; the merged map switches to binary):
 *
 *   cajeta-coverage v1
 *   grain: <line|branch|region>
 *   emitted-by: <abs-path-to-test-binary>
 *   file: <abs-path-to-source>
 *       <probe-id>\t<hit-count>
 *       <probe-id>\t<hit-count>
 *   file: <abs-path-to-source>
 *       ...
 *
 * Whitespace before probe-id rows is significant (tab) — lets the
 * parser distinguish header lines from probe rows in one pass. The
 * whole file is slurped once and split on '\n' here.
 */
public class ProbeDataReader {

    public static #ProbeData read(Path path) {
        int8[] raw = File.readAllBytes(path.toString());
        int32 total = (int32) raw.count();

        // Header lines 1-3, then the body walk. `lineAt` copies one
        // line out per call; the body loop re-walks offsets directly.
        int32 off = 0;
        String l0 = nextLine(raw, total, off);
        off = advance(raw, total, off);
        String l1 = nextLine(raw, total, off);
        off = advance(raw, total, off);
        String l2 = nextLine(raw, total, off);
        off = advance(raw, total, off);
        if (l2.byteLength() == 0 && off >= total) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() + " too short to be valid");
        }
        if (!l0.equals("cajeta-coverage v1")) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": unexpected header line '" + l0 + "'");
        }
        Grain  grain     = parseGrainLine(l1, path);
        ProbeData dump #= heap ProbeData(grain, parseEmittedByLine(l2, path));

        // Probe rows. The current-file pointer advances on every
        // "file:" line so subsequent rows attribute correctly.
        String currentFile = "";
        int32 lineNo = 4;
        while (off < total) {
            String line = nextLine(raw, total, off);
            off = advance(raw, total, off);
            if (line.startsWith("file: ")) {
                currentFile = line.substring(6, line.byteLength());
            } else if (line.startsWith("\t")) {
                if (currentFile.byteLength() == 0) {
                    throw stack ProbeDataFormatException(
                        "probe dump " + path.toString() +
                        ": probe row before any `file:` line at line " +
                        String.valueOf(lineNo));
                }
                addProbeRow(dump, currentFile, line, path, lineNo);
            }
            // Blank lines and unknown leading-non-tab content are
            // ignored — the format may grow header fields without
            // breaking older readers.
            lineNo = lineNo + 1;
        }
        return #dump;
    }

    // The line starting at `off` (bytes up to, excluding, '\n' / EOF).
    static #String nextLine(int8[] raw, int32 total, int32 off) {
        int32 end = off;
        while (end < total && raw[end] != (int8) 10) {
            end = end + 1;
        }
        int32 n = end - off;
        int8[] lb = heap int8[n];
        int32 i = 0;
        while (i < n) {
            lb[i] = raw[off + i];
            i = i + 1;
        }
        return heap String(#lb, n);
    }

    // Offset just past the current line's '\n' (or EOF).
    static int32 advance(int8[] raw, int32 total, int32 off) {
        while (off < total && raw[off] != (int8) 10) {
            off = off + 1;
        }
        return off + 1 > total ? total : off + 1;
    }

    static #Grain parseGrainLine(String line, Path path) {
        if (!line.startsWith("grain: ")) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": expected 'grain:' on line 2, got '" + line + "'");
        }
        Optional<Grain> g = Grain.parse(line.substring(7, line.byteLength()));
        if (g.isEmpty()) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": unknown grain '" + line.substring(7, line.byteLength()) + "'");
        }
        return g.get();
    }

    static #String parseEmittedByLine(String line, Path path) {
        if (!line.startsWith("emitted-by: ")) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": expected 'emitted-by:' on line 3, got '" + line + "'");
        }
        return line.substring(12, line.byteLength());
    }

    // One "\t<probe-id>\t<hit-count>" row into the dump. Tab or space
    // separates the two numbers — a few editors auto-convert tabs and
    // we'd rather be lenient than fail a CI gate on whitespace.
    static void addProbeRow(ProbeData dump, String file, String line,
                            Path path, int32 lineNo) {
        String trimmed = line.trim();
        int32 sep = (int32) trimmed.indexOf("\t");
        if (sep <= 0) {
            sep = (int32) trimmed.indexOf(" ");
        }
        if (sep <= 0) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": probe row at line " + String.valueOf(lineNo) +
                " missing separator");
        }
        int64 probeId  = parseDigits(trimmed.substring(0, sep), path, lineNo);
        int64 hitCount = parseDigits(
            trimmed.substring(sep + 1, trimmed.byteLength()).trim(),
            path, lineNo);
        dump.addHit(file, (int32) probeId, hitCount);
    }

    // Non-negative decimal parse (the stdlib has no parseInt yet —
    // spec collections-overhaul 2.4.3 notes the gap).
    static int64 parseDigits(String s, Path path, int32 lineNo) {
        int32 n = s.byteLength();
        if (n == 0) {
            throw stack ProbeDataFormatException(
                "probe dump " + path.toString() +
                ": empty number at line " + String.valueOf(lineNo));
        }
        int64 v = 0;
        int32 i = 0;
        while (i < n) {
            int32 d = ((int32) s.byteAt(i)) - 48;
            if (d < 0 || d > 9) {
                throw stack ProbeDataFormatException(
                    "probe dump " + path.toString() +
                    ": non-digit in number at line " + String.valueOf(lineNo));
            }
            v = v * 10 + d;
            i = i + 1;
        }
        return v;
    }
}

/**
 * Folds a ProbeData dump into the in-progress CoverageMap. The
 * coverage-map's total-probes value for each file is set the first
 * time we touch it — from the compiler-emitted sidecar — so the
 * merger only needs to mark hits.
 */
public class ProbeMerger {

    public static void mergeInto(
        CoverageMap map, ProbeData dump, ActionContext ctx) {
        Stream<String> files = dump.getHits().keys();
        Optional<String> cur = files.next();
        while (cur.isPresent()) {
            String fpath = cur.get();
            int32 totalProbes = lookupTotalProbes(ctx, fpath);
            CoverageMap.FileEntry entry = map.getOrCreate(fpath, totalProbes);
            Optional<HashMap<int32, int64>> perFileOpt =
                dump.getHits().get(fpath);
            HashMap<int32, int64> perFile = perFileOpt.get();
            Stream<int32> probeIds = perFile.keys();
            Optional<int32> pidOpt = probeIds.next();
            while (pidOpt.isPresent()) {
                int32 pid = pidOpt.get();
                Optional<int64> hitsOpt = perFile.get(pid);
                int64 hits = hitsOpt.get();
                if (hits > 0) {
                    entry.markCovered(pid);
                }
                pidOpt = probeIds.next();
            }
            cur = files.next();
        }
    }

    /**
     * Number of probes the compiler emitted for `file`. Read from
     * the per-source sidecar's header — same data PositionLookup
     * consumes, but we only need the count here.
     */
    static int32 lookupTotalProbes(ActionContext ctx, String file) {
        Path sidecar = sidecarPathFor(ctx, file);
        return CoverageMapHeader.readProbeCount(sidecar);
    }

    static #Path sidecarPathFor(ActionContext ctx, String file) {
        String encoded = file.replace("/", "_").replace(":", "_");
        return Path.of(ctx.workdir() + "/build/archive/" +
                       ctx.projectName() + "-" +
                       ctx.projectVersion() + ".cja.coverage-map/" +
                       encoded + ".cmap");
    }
}
