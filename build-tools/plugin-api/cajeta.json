{
    // cajeta.buildtool.plugin — the plugin-author API.
    //
    // Every cajeta build-tool plugin imports types from this
    // package: ActionContext (passed to action entries),
    // ActionResult (returned from entries), Finding (one structured
    // result row), Severity (error/warning/info tag).
    //
    // JSON values that the runtime hands plugins (action params,
    // resolved config) use the stdlib types from cajeta.codec.json
    // (JsonObject + JsonArray + JsonValue + Optional-returning
    // typed getters). The plugin API doesn't re-export them — one
    // canonical JSON model in stdlib, no parallel hierarchy here.
    //
    // This package is shipped + versioned with the build tool. A
    // plugin pinning `"cajeta.buildtool.plugin": "1.0.*"` gets the
    // surface frozen for the lifetime of the 1.x build tool series.

    "details": {
        "name":               "cajeta.buildtool.plugin",
        "version":            "1.0.0",
        "description":        "Plugin-author API for cajeta build-tool plugins",
        "license":            "Apache-2.0",
        "authors":            ["cajeta"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The API itself is pure types — no I/O, no process spawn,
        // no network. The runtime grants no capabilities to this
        // module; plugin code that needs them declares them on its
        // own manifest.
        "capabilities": [],

        "dependencies": {
            "cajeta.lang":       "1.0.*",
            "cajeta.collection": "1.0.*",
            "cajeta.codec.json": "1.0.*"
        },

        "build": {
            "target": "host",
            // The API ships as a library — no main(), no actions.
            // Plugins compile against it; the build tool's runtime
            // provides the implementations of ActionContext and
            // ActionResult at dispatch time.
            "kind":   "library"
        }
    },

    "tasks": {
        "build": {
            "description": "Build the plugin API",
            "actions": [
                { "action":  "build",
                  "flavor":  "release",
                  "profile": "release",
                  "id":      "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },
        "test": {
            "description": "API unit tests",
            "actions": [
                { "action":  "build",
                  "flavor":  "debug",
                  "profile": "test",
                  "id":      "art" },
                { "action": "test", "input": "${art.path}", "id": "tr" }
            ],
            "outputs": { "passed": "${tr.passed}", "failed": "${tr.failed}" }
        },
        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
