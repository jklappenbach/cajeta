package cajeta.buildtool.plugin;

/**
 * Context object the runtime passes to every plugin action entry.
 *
 * Exposes the parts of the build environment a plugin needs to do
 * its job without forcing each plugin to re-resolve the workspace
 * + manifest details:
 *
 *   - **`workdir()`** — absolute path of the project root (the
 *     directory containing the consumer's `cajeta.json`). Plugins
 *     resolve relative paths against this.
 *
 *   - **`projectName()`** — value of `details.name` from the
 *     consumer's manifest. Used by cajeta.coverage to find the
 *     instrumented artifact at the conventional path; other
 *     plugins use it in their report headers.
 *
 *   - **`projectVersion()`** — value of `details.version`.
 *     Same uses as `projectName()`.
 *
 *   - **`write(String)`** — write text to the build tool's stdout
 *     stream. Used by formats that have a "console" mode
 *     (cajeta.coverage's overall % summary, ConsoleFormat output).
 *     Never write directly to STDOUT_FILENO from plugin code —
 *     the runtime may be capturing or redirecting output for
 *     structured logging.
 *
 *   - **`warn(String)`** — surface a one-line warning to the user.
 *     Severity-tagged on the runtime side (the build tool's
 *     standard yellow). Use for non-fatal config issues like the
 *     back-compat exclude entries warning.
 *
 *   - **`log(String)`** — informational log line. Only shown when
 *     the build tool runs at `--verbose`; suppressed otherwise.
 *
 * `ActionContext` is an **interface**, not a class — the runtime
 * provides the implementation when dispatching an action. v1's
 * implementation is the subprocess host that bridges these calls
 * to the runtime's structured logging channel; the in-process
 * variant lands when the runtime gains JIT execution.
 */
public interface ActionContext {

    /** Absolute path of the project root. */
    String workdir();

    /** Consumer's `details.name`. */
    String projectName();

    /** Consumer's `details.version`. */
    String projectVersion();

    /**
     * Write text to the build tool's stdout stream. Trailing
     * newline NOT appended automatically — call with `"...\n"`
     * when you want a line break (matches `print` rather than
     * `println` convention; per-write line breaks let plugins
     * stream partial lines if they want).
     */
    void write(String text);

    /**
     * Emit a warning. Surfaced as one line on stderr with the
     * build tool's warning prefix. Use for non-fatal config
     * issues; for fatal config errors, return `ActionResult.error`.
     */
    void warn(String message);

    /** Verbose-mode informational log. Suppressed by default. */
    void log(String message);
}
