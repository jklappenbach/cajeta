package cajeta.buildtool.plugin;

import cajeta.collection.ArrayList;
import cajeta.collection.HashMap;

/**
 * What a plugin action's entry symbol returns to the runtime.
 *
 * Three pieces of state:
 *
 *   - **outputs**: `Map<String, String>` published under the
 *     invocation's `id`. Consumed by downstream actions via
 *     `${id.<field>}` substitution. Always strings — the build
 *     tool's substitution surface is string-typed.
 *
 *   - **findings**: `ArrayList<Finding>`. Aggregated by the
 *     native `lint` action when wired via `include-findings`.
 *     Empty by default for actions that don't emit findings
 *     (cajeta.coverage.collect, etc.).
 *
 *   - **errorMessage**: optional string. When non-empty, the
 *     runtime treats the action as failed — the task aborts and
 *     the error surfaces in the build tool's output. Outputs +
 *     findings are still published before the abort, so a
 *     failing coverage report still emits its findings stream
 *     for the IDE / SARIF consumer to see.
 *
 * Builder shape:
 *
 *     ActionResult r #= heap ActionResult();
 *     r.output("path", artifact.toString());
 *     r.findings(#findings);
 *     return r.error(  // fluent fail path
 *         "coverage 73.5% < min 80%");
 *
 *     // ... or just success:
 *     return #r;
 *
 * The `error(...)` instance method returns the same result so the
 * caller can `return r.error(...)` in one line. The static
 * `ActionResult.error(msg)` factory is for "I detected the failure
 * before building any outputs" — common in param-validation paths.
 */
public class ActionResult {

    HashMap<String, String> outputsMap;
    ArrayList<Finding>      findingsList;
    String                  errorMessage;

    public ActionResult() {
        this.outputsMap   #= heap HashMap<String, String>();
        this.findingsList #= heap ArrayList<Finding>();
        this.errorMessage = "";
    }

    /** Add an output. Replaces any prior value for the same key. */
    public void output(String key, String value) {
        this.outputsMap.put(key, value);
    }

    /** Replace the finding list. Pass `#heap ArrayList<Finding>()` to clear. */
    public void findings(ArrayList<Finding> findings) {
        this.findingsList = findings;
    }

    /** Append one finding (convenience when emitting incrementally). */
    public void addFinding(Finding f) {
        this.findingsList.add(f);
    }

    /**
     * Mark this result as failed and return it for `return r.error(...)`.
     * Idempotent — calling `error()` twice keeps the first message
     * (the action's first detected failure is the truthful one;
     * a later "follow-up" error usually shadows the real cause).
     */
    public ActionResult error(String message) {
        if (this.errorMessage.count() == 0) {
            this.errorMessage = message;
        }
        return this;
    }

    public boolean isError()       { return this.errorMessage.count() > 0; }
    public String  errorMessage()  { return this.errorMessage; }
    public HashMap<String, String> outputs()  { return this.outputsMap;   }
    public ArrayList<Finding>      findings() { return this.findingsList; }

    /**
     * Static fail-fast factory. Equivalent to
     * `heap ActionResult().error(message)` — provided so param-
     * validation paths read as `return ActionResult.error("...");`
     * without the temporary.
     */
    public static ActionResult error(String message) {
        ActionResult r #= heap ActionResult();
        r.errorMessage = message;
        return #r;
    }
}
