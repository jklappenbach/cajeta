{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cajeta.org/specs/manifest-v1.json",
  "title": "Cajeta manifest (cajeta.json) — v1",
  "description": "Declarative project manifest consumed by the cajeta build tool. Authoritative C++ loader: src/cajeta/buildtool/Manifest.cpp. Spec narrative: docs/BuildTool.md. Six required top-level blocks for source packages: details, properties, settings, actions, plugins, tasks. Melt packages declare 'melt' in place of 'tasks' + 'workspace'. Workspace roots declare 'workspace' in addition to (or instead of) per-member 'tasks'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["details"],
  "properties": {
    "details": { "$ref": "#/$defs/details" },
    "properties": { "$ref": "#/$defs/properties" },
    "settings": { "$ref": "#/$defs/settings" },
    "actions": { "$ref": "#/$defs/actions" },
    "plugins": { "$ref": "#/$defs/plugins" },
    "tasks": { "$ref": "#/$defs/tasks" },
    "workspace": { "$ref": "#/$defs/workspace" },
    "melt": { "$ref": "#/$defs/melt" }
  },
  "allOf": [
    {
      "description": "Melt packages cannot also declare tasks or workspace (enforced by Manifest.cpp + ManifestTests.errorsWhenMeltDeclaredAlongsideTasks/Workspace).",
      "if": { "required": ["melt"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["tasks"] },
            { "required": ["workspace"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Fully-qualified package name; dotted segments. The last segment is the library name, everything before is the group."
        },
        "version": {
          "type": "string",
          "description": "Semver string. May carry a pre-release suffix (e.g. 1.0.0-rc1). Exact-version matchers (`1.2.3`) do not match pre-releases."
        },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "repository-url": { "type": "string", "format": "uri" },
        "cajeta-lang-version": {
          "type": "string",
          "description": "Toolchain compatibility hint (N±k window — open decision)."
        },
        "plugin": {
          "type": "object",
          "description": "Present only on plugin sidecars. Shape owned by the plugin protocol, not the manifest schema.",
          "additionalProperties": true
        }
      }
    },
    "properties": {
      "type": "object",
      "description": "User-defined ${PROPERTY} substitution table. Built-ins (details.*, env.*, flavor, profile, target, workspace.root, cajeta.version) cannot be redefined.",
      "additionalProperties": { "type": "string" }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "build": { "$ref": "#/$defs/settingsBuild" },
        "repositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/repository" }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/dependencyObject" }
            ]
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/overrideObject" }
            ]
          }
        },
        "melts": {
          "type": "array",
          "items": { "type": "string", "description": "name@version" }
        },
        "plugins-allowed-capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityName" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityName" }
        },
        "toolchain": { "$ref": "#/$defs/toolchainPin" },
        "install": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "require-attestation": { "enum": ["off", "warn", "strict"] }
          }
        },
        "source-date-epoch": {
          "oneOf": [ { "type": "integer" }, { "type": "string", "pattern": "^[0-9]+$" } ],
          "description": "Reproducible-builds standard. Precedence below CAJETA_SOURCE_DATE_EPOCH / SOURCE_DATE_EPOCH env vars."
        }
      }
    },
    "settingsBuild": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry-method": { "type": "string" },
        "target": { "type": "string" },
        "source-root": { "type": "string" },
        "output-dir": { "type": "string" },
        "binaries": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["entry-method"],
            "additionalProperties": false,
            "properties": {
              "entry-method": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "custom-flavors": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/flavorObject" }
            ]
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max-bytes": { "type": "integer", "minimum": 0 },
            "max-age": { "type": "string", "description": "Duration string e.g. '7d', '12h'." }
          }
        }
      }
    },
    "flavorObject": {
      "type": "object",
      "description": "Inline flavor composition: { base, key/value overrides from the flavor vocabulary }.",
      "additionalProperties": false,
      "properties": {
        "base": { "enum": ["release", "debug"] },
        "opt": { "enum": ["0", "1", "2", "3", "s", "z"] },
        "lto": { "enum": ["none", "thin", "full"] },
        "debug-info": { "enum": ["none", "minimal", "full"] },
        "strip-symbols": { "type": "boolean" },
        "bounds-check": { "type": "boolean" },
        "null-checks": { "type": "boolean" },
        "overflow-checks": { "type": "boolean" },
        "asan": { "type": "boolean" },
        "tsan": { "type": "boolean" },
        "msan": { "type": "boolean" },
        "ubsan": { "type": "boolean" },
        "analytics": { "type": "boolean" },
        "source-tags": { "type": "boolean" }
      }
    },
    "repository": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["filesystem", "http", "git", "maven-compat"] },
        "path": { "type": "string", "description": "filesystem driver" },
        "url": { "type": "string", "format": "uri", "description": "http / git driver" },
        "priority": { "type": "integer", "default": 0 },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["bearer", "mtls"] },
            "token-env": { "type": "string" },
            "cert-path": { "type": "string" },
            "key-path": { "type": "string" }
          }
        },
        "branch": { "type": "string", "description": "git driver" },
        "tag":    { "type": "string", "description": "git driver" },
        "rev":    { "type": "string", "description": "git driver" },
        "subdir": { "type": "string", "description": "git driver" }
      }
    },
    "dependencyObject": {
      "oneOf": [
        {
          "type": "object",
          "required": ["version"],
          "properties": {
            "version": { "type": "string" },
            "from":    { "type": "string", "description": "Repository name (pin)." },
            "capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/capabilityName" }
            }
          }
        },
        {
          "type": "object",
          "required": ["git"],
          "properties": {
            "git":    { "type": "string", "format": "uri" },
            "branch": { "type": "string" },
            "tag":    { "type": "string" },
            "rev":    { "type": "string" },
            "subdir": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" }
          }
        }
      ]
    },
    "overrideObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "path":    { "type": "string" },
        "git":     { "type": "string", "format": "uri" },
        "branch":  { "type": "string" },
        "tag":     { "type": "string" },
        "rev":     { "type": "string" },
        "allow-major-downgrade": { "type": "boolean" }
      }
    },
    "capabilityName": {
      "type": "string",
      "description": "Canonical capability key. See capabilities-v1.json.",
      "enum": ["filesystem", "process", "network", "env"]
    },
    "toolchainPin": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version":      { "type": "string" },
        "distribution": { "type": "string", "default": "official" },
        "channel":      { "type": "string" },
        "sha256":       { "type": "string", "pattern": "^([0-9a-f]{64}|sha256:[0-9a-f]{64})$" },
        "fetch":        { "enum": ["auto", "warn", "error", "off"], "default": "auto" },
        "from":         { "type": "string", "description": "Toolchain repository name." }
      }
    },
    "actions": {
      "type": "object",
      "description": "Named action-parameter presets reusable across tasks. Keys are preset names, values are action params merged in at task-action invocation time.",
      "additionalProperties": { "type": "object", "additionalProperties": true }
    },
    "plugins": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "description": "name@version" },
          {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
              "name":    { "type": "string" },
              "version": { "type": "string" },
              "from":    { "type": "string" }
            }
          }
        ]
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "depends-on":  { "type": "array", "items": { "type": "string" } },
        "params":      { "type": "object", "additionalProperties": true },
        "actions":     { "type": "array", "items": { "$ref": "#/$defs/actionEntry" } },
        "outputs":     { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "actionEntry": {
      "type": "object",
      "description": "Exactly one of `action` / `parallel` / `run-task` is required.",
      "additionalProperties": true,
      "properties": {
        "id":       { "type": "string" },
        "when":     { "type": "string" },
        "skip-when":{ "type": "string" },
        "action":   { "type": "string", "description": "Native or plugin action name." },
        "parallel": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionEntry" }
        },
        "run-task": { "type": "string" },
        "params":   { "type": "object", "additionalProperties": true }
      },
      "oneOf": [
        { "required": ["action"] },
        { "required": ["parallel"] },
        { "required": ["run-task"] }
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "items": { "type": "string", "description": "Relative path to a member's directory." }
        },
        "shared-dependencies": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/dependencyObject" }
            ]
          }
        }
      }
    },
    "melt": {
      "type": "object",
      "description": "Melt packages export curated configuration with no source. The presence of this block makes the package a melt; `tasks` and `workspace` are forbidden.",
      "additionalProperties": false,
      "properties": {
        "properties":   { "type": "object", "additionalProperties": { "type": "string" } },
        "actions":      { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": true } },
        "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/dependencyObject" }
            ]
          }
        },
        "melts": {
          "type": "array",
          "items": { "type": "string", "description": "name@version (transitive melt import)" }
        }
      }
    }
  }
}
