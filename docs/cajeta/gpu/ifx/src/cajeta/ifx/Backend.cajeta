package cajeta.ifx;

/**
 * The ifx service-provider seam. Backends (cajeta-ifx-* and cajeta-ifx-harness) IMPLEMENT these
 * interfaces and register themselves; ifx (this package) depends on NO backend (dependency
 * inversion). Each interface is one domain (window / audio / input).
 *
 * Every backend exposes probe() + priority() so the registry can pick the best viable one at
 * launch (Wayland vs X11, PipeWire vs ALSA) — the same registry+probe+dispatch pattern as the GPU
 * backend dispatcher, with CAJETA_IFX_{WINDOW,AUDIO,INPUT} env overrides. A built-in NullBackend
 * is the always-present lowest-priority floor (silent/headless); the loud-error rule when an
 * interactive surface is requested with only the floor present lives in the registry.
 * See documents/cajeta-gfx/cajeta-gfx-spec.md §9.4.
 */
public interface Backend {
    boolean probe();     // viable in this environment?
    int32   priority();  // higher wins among viable backends
    String  name();      // "win32" | "wayland" | "cocoa" | "harness" | "null" ...
}

/** Window/surface/event provider. Produces the opaque Surface the gfx swapchain consumes. */
public interface WindowBackend extends Backend {
    Window  createWindow(String title, uint32 width, uint32 height);
    Surface surfaceOf(Window w);
    WindowEvent[] poll(Window w);
    void    destroy(Window w);
}

/** Audio output/capture provider (WASAPI / CoreAudio / PipeWire / AAudio / harness / null). */
public interface AudioBackend extends Backend {
    AudioStream openOutput(uint32 sampleRate, uint32 channels);
    void submit(AudioStream s, float32[] frames);
    void close(AudioStream s);
}

/** Extended input provider (gamepads); keyboard/mouse arrive via WindowEvent from the window. */
public interface InputBackend extends Backend {
    int32 gamepadCount();
    InputDevice gamepad(int32 index);
    boolean buttonDown(InputDevice d, int32 button);
    float32 axis(InputDevice d, int32 axis);
}
